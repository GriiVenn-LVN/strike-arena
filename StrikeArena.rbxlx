  <Item class="ReplicatedStorage" referent="3">
    <Properties>
      <string name="Name">ReplicatedStorage</string>
    </Properties>
    <Item class="Folder" referent="4">
      <Properties>
        <string name="Name">Shared</string>
      </Properties>
      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">ArsenalPanels</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ArsenalPanels (ModuleScript, côté client)
-- Les panneaux « Arsenal › Armes » et « Arsenal › Viseurs » du jeu web, à l'identique :
--   arms(parent)   : liste des armes (icônes 3D), aperçu 3D qui tourne (rendu réaliste / schéma 3D / vue éclatée,
--                    clique-glisse pour tourner), nom, 10 statistiques avec comparaison ▲▼ au survol, ARMURIER
--                    (6 emplacements, options avec cadenas et conditions de déblocage), skins + « Équiper au départ »
--                    (src/85_menu.js, 88_blueprint.js, 64b_gunsmith.js)
--   sights(parent) : armes par catégorie, aperçu du stand de tir vu à travers le viseur, liste des viseurs avec
--                    grossissement, forme + couleur du réticule, « mettre ce viseur sur toutes les armes » (64c_sights.js)
-- Chaque fonction construit tout dans le cadre donné et renvoie { destroy = fn, refresh = fn }.
-- Les choix passent par le serveur (RemoteFunction « Armory », ArmoryService) qui vérifie et sauvegarde.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local A = require(ReplicatedStorage.Shared.Attachments)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local ReticleGui = require(ReplicatedStorage.Shared.ReticleGui)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local P = {}

-- ---------- palette et outils (CSS du web) ----------
local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local C = {
	bg = rgb(0x0b1018), panel = rgb(0x0d121d), card = rgb(0x121b2b), card2 = rgb(0x141c2c), line = rgb(0x2a3750), text = rgb(0xe8eef9), white = Color3.new(1, 1, 1),
	dim = rgb(0x8da0bd), dim2 = rgb(0x6f819e), soft = rgb(0xb8c5da), opt = rgb(0xdfe8f5), accent = rgb(0xff4655), orange = rgb(0xff9a3c), orangeT = rgb(0xffb35c),
	green = rgb(0x5dff8a), greenBg = rgb(0x142619), red = rgb(0xff5a5a), gold = rgb(0xffd75e), slotOn = rgb(0x1d1a17), dark = rgb(0x16191e),
}
local RARITY = { rgb(0x9aa6b8), rgb(0x4aa3ff), rgb(0xb36bff), rgb(0xffb938), rgb(0xff3df0) }
local function spaced(s: string, n: number?): string
	local gap = if (n or 1) >= 2 then "\u{2009}" else "\u{200A}"   -- espaces fines
	local out = {}
	for _, cp in utf8.codes(s) do table.insert(out, utf8.char(cp)) end
	return table.concat(out, gap)
end
local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if class == "TextLabel" or class == "TextButton" then
		o.Font = Enum.Font.GothamBold; o.TextColor3 = C.text; o.BorderSizePixel = 0; o.TextSize = 13
		if class == "TextLabel" then o.BackgroundTransparency = 1 end
		if class == "TextButton" then o.AutoButtonColor = false end
	elseif class == "Frame" or class == "ScrollingFrame" then o.BorderSizePixel = 0 end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function stroke(o: Instance, col: Color3, t: number?, tr: number?): UIStroke
	return make("UIStroke", { Color = col, Thickness = t or 1, Transparency = tr or 0, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function pad(o: Instance, p: number) make("UIPadding", { PaddingLeft = UDim.new(0, p), PaddingRight = UDim.new(0, p), PaddingTop = UDim.new(0, p), PaddingBottom = UDim.new(0, p) }, o) end
local function vlist(o: Instance, gap: number) return make("UIListLayout", { Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, o) end
local function clear(o: Instance) for _, c in ipairs(o:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
local function sfx(name: string, vol: number?) pcall(Sfx.play, name, nil, vol) end
-- puce (.chip du web)
local function chip(parent: Instance, text: string, on: boolean, order: number?): TextButton
	local b = make("TextButton", { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), Text = text, TextSize = 12, LayoutOrder = order or 0,
		BackgroundColor3 = if on then C.accent else C.card2, TextColor3 = C.white }, parent)
	pad(b, 0); make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10) }, b)
	corner(b, 4); stroke(b, if on then C.accent else C.line, 1, if on then 0 else .2)
	return b
end
local function hflow(o: Instance, gap: number) return make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Wraps = true, Padding = UDim.new(0, gap), SortOrder = Enum.SortOrder.LayoutOrder }, o) end
local function header(parent: Instance, text: string, order: number, col: Color3?): TextLabel
	return make("TextLabel", { Size = UDim2.new(1, 0, 0, 22), Text = spaced(string.upper(text), 2), TextSize = 10, TextColor3 = col or C.dim,
		TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Bottom, LayoutOrder = order }, parent)
end

-- ---------- données partagées (profil côté serveur) ----------
local D = { att = {} :: { [string]: A.Sel }, ret = {} :: { [string]: string }, prog = { level = 1, kills = {} } :: A.Prog, profile = nil :: any, loaded = false }
local changed = Instance.new("BindableEvent")
local armory: RemoteFunction? = nil
local function remote(): RemoteFunction?
	if not armory then armory = ReplicatedStorage:WaitForChild("Armory", 10) :: RemoteFunction? end
	return armory
end
local function load()
	local r = remote()
	if r then
		local ok, data = pcall(r.InvokeServer, r, "get")
		if ok and typeof(data) == "table" then
			D.att = data.att or {}; D.ret = data.ret or {}; D.prog = { level = data.level or 1, kills = data.kills or {} }
		end
	end
	local gp = ReplicatedStorage:FindFirstChild("GetProfile") :: RemoteFunction?
	if gp then
		local ok, data = pcall(gp.InvokeServer, gp)
		if ok and typeof(data) == "table" then D.profile = data.profile end
	end
	D.loaded = true
	changed:Fire()
end
local function selOf(k: string): A.Sel return D.att[k] or {} end
local function retOf(o: string): (string, string)
	local d = A.RET_DEF[o] or A.RET_DEF.reddot
	local raw = D.ret[o]
	if typeof(raw) == "string" then
		local s, c = string.match(raw, "^(%w+)|(#%x+)$")
		if s and c then return s, c end
	end
	return d.s, d.c
end

-- toast en bas du panneau (uiToast du web)
local function toaster(root: GuiObject): (string) -> ()
	local t = make("TextLabel", { AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -10), Size = UDim2.fromOffset(0, 34), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = rgb(0x161f33), BackgroundTransparency = 0, Text = "", TextSize = 13, TextColor3 = C.white, Visible = false, ZIndex = 30 }, root)
	make("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, t); stroke(t, C.gold); corner(t, 4)
	local id = 0
	return function(msg: string)
		id += 1
		local my = id
		t.Text = msg; t.Visible = true
		task.delay(2.4, function() if id == my then t.Visible = false end end)
	end
end

local CATS: { { any } } = {
	{ "Couteau", { "knife" } }, { "Pistolets", { "glock", "usp", "p250", "fiveseven", "deagle" } }, { "SMG", { "mac10", "mp9", "ump", "p90" } },
	{ "Pompes", { "nova", "sawedoff", "xm" } }, { "Fusils", { "galil", "famas", "ak", "m4", "sg553", "aug" } }, { "Snipers", { "ssg", "awp", "scar" } },
	{ "Lourd", { "negev", "m249" } },
}
local SIGHT_CATS = { { "pistol", "Pistolets" }, { "smg", "Mitraillettes" }, { "shotgun", "Pompes" }, { "rifle", "Fusils" }, { "lmg", "Mitrailleuses" }, { "sniper", "Snipers" } }
local SIGHT_WEAPONS: { [string]: { string } } = {}
for _, c in ipairs(CATS) do
	for _, k in ipairs(c[2]) do
		local w = Config.WEAPONS[k]
		if w and A.allowed(k).optic then SIGHT_WEAPONS[w.cat] = SIGHT_WEAPONS[w.cat] or {}; table.insert(SIGHT_WEAPONS[w.cat], k) end
	end
end
local current = { key = nil :: string? }
local function defaultKey(): string
	if current.key and Config.WEAPONS[current.key] then return current.key end
	local p = player:GetAttribute("Primary")
	return if typeof(p) == "string" and Config.WEAPONS[p] then p else "ak"
end

-- icône 3D d'une arme (vue de côté, comme weaponIcon du web)
local function weaponIcon(parent: Instance, key: string, size: Vector2, pos: UDim2?): ViewportFrame
	local vf = make("ViewportFrame", { Size = UDim2.fromOffset(size.X, size.Y), Position = pos or UDim2.new(), BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 175, 190), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(.4, -1, .3) }, parent)
	task.spawn(function()
		local ok, m = pcall(WeaponModels.build, key, 1)
		if not ok or not m or not vf.Parent then if ok and m then (m :: Model):Destroy() end return end
		local model = m :: Model
		SkinPaint.apply(model, player:GetAttribute("Skin_" .. key) :: number?, player:GetAttribute("Camo_" .. key) :: string?)
		model.Parent = vf
		local cf, ext = model:GetBoundingBox()
		local cam = Instance.new("Camera"); cam.FieldOfView = 16
		local tv = math.tan(math.rad(8))
		local dist = math.max(ext.Y / 2 / tv, ext.Z / 2 / (tv * size.X / size.Y)) * 1.12 + ext.X
		cam.CFrame = CFrame.lookAt(cf.Position - Vector3.new(dist, 0, 0), cf.Position)
		cam.Parent = vf; vf.CurrentCamera = cam
	end)
	return vf
end

-- =====================================================================================
-- ARSENAL › ARMES (+ ARMURIER)
-- =====================================================================================
function P.arms(parent: Frame): { destroy: () -> (), refresh: () -> () }
	local root = make("Frame", { Name = "ArsenalArms", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
	local toast = toaster(root)
	local conns: { RBXScriptConnection } = {}
	-- colonnes : liste (210) | aperçu + stats + armurier | skins (240)
	local wl = make("ScrollingFrame", { Size = UDim2.new(0, 200, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 4, ScrollBarImageColor3 = C.line,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, root)
	vlist(wl, 4)
	local mid = make("ScrollingFrame", { Position = UDim2.fromOffset(216, 0), Size = UDim2.new(1, -216 - 256, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 4,
		ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, root)
	vlist(mid, 8)
	local skl = make("ScrollingFrame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 240, 1, 0), BackgroundTransparency = 1,
		ScrollBarThickness = 4, ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, root)
	vlist(skl, 6)

	local st = { key = defaultKey(), prev = nil :: A.Sel?, slot = "muzzle", mode = "real", spin = true, rx = 0, ry = math.pi * .55, drag = nil :: Vector2?, token = 0 }
	local chips: { [string]: TextButton } = {}

	-- ----- aperçu 3D -----
	local pvBox = make("Frame", { Size = UDim2.new(1, 0, 0, 300), BackgroundColor3 = Color3.new(1, 1, 1), LayoutOrder = 1 }, mid)
	corner(pvBox, 4)
	local pvGrad = make("UIGradient", { Rotation = 90, Color = ColorSequence.new(rgb(0x16233b), rgb(0x2d4a72)) }, pvBox)
	local vp = make("ViewportFrame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Ambient = Color3.fromRGB(120, 130, 150),
		LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(-.5, -1, -.4) }, pvBox)
	local cam = Instance.new("Camera"); cam.FieldOfView = 30; cam.Parent = vp; vp.CurrentCamera = cam
	local floor = make("Part", { Shape = Enum.PartType.Cylinder, Size = Vector3.new(.02, 2.6, 2.6), Color = rgb(0x1a2438), Material = Enum.Material.Metal, Anchored = true,
		CFrame = CFrame.new(0, -.36, 0) * CFrame.Angles(0, 0, math.rad(90)) }, vp)
	local _ = floor
	local pv = { model = nil :: Model?, center = Vector3.zero, size = 1, parts = {} :: { { p: BasePart, off: Vector3 } } }

	local modeBar = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundTransparency = 1, LayoutOrder = 2 }, mid)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 6) }, modeBar)
	make("TextLabel", { Size = UDim2.new(1, 0, 0, 14), Text = "Clique-glisse sur l'arme pour la tourner", TextSize = 11, Font = Enum.Font.Gotham, TextColor3 = C.dim2, LayoutOrder = 3 }, mid)
	local nameL = make("TextLabel", { Size = UDim2.new(1, 0, 0, 34), Text = "", TextSize = 26, Font = Enum.Font.GothamBlack, TextColor3 = C.white, LayoutOrder = 4 }, mid)
	local statsBox = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 5 }, mid)
	make("UIGridLayout", { CellSize = UDim2.new(.2, -5, 0, 54), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, statsBox)
	local gs = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundColor3 = rgb(0x0b1220), BackgroundTransparency = .2, LayoutOrder = 6 }, mid)
	corner(gs, 10); stroke(gs, C.white, 1, .9); pad(gs, 10); vlist(gs, 8)

	local function curList(k: string, sel: A.Sel?): { string } return A.list(k, sel or selOf(k), D.prog) end

	local function applyMode()
		local m = pv.model
		if not m then return end
		local schem = st.mode == "schema"
		for _, c in ipairs(m:GetDescendants()) do
			if c:IsA("BasePart") then
				if c:GetAttribute("C0") == nil then c:SetAttribute("C0", c.Color); c:SetAttribute("M0", c.Material.Name); c:SetAttribute("T0", c.Transparency) end
				if schem then c.Color = rgb(0x9fe3ff); c.Material = Enum.Material.SmoothPlastic; c.Transparency = .72
				else c.Color = c:GetAttribute("C0") :: Color3; c.Material = (Enum.Material :: any)[c:GetAttribute("M0") :: string]; c.Transparency = c:GetAttribute("T0") :: number end
			end
		end
		pvGrad.Color = if schem then ColorSequence.new(rgb(0x0a2a4d)) else ColorSequence.new(rgb(0x16233b), rgb(0x2d4a72))
		floor.Transparency = if schem then 1 else 0
	end
	local function drawModes()
		clear(modeBar)
		for i, mdef in ipairs({ { "real", "Rendu réaliste" }, { "schema", "Schéma 3D" }, { "explode", "Vue éclatée" } }) do
			local b = chip(modeBar, mdef[2], st.mode == mdef[1], i)
			b.MouseButton1Click:Connect(function() sfx("ui"); st.mode = mdef[1]; applyMode(); drawModes() end)
		end
		local r = chip(modeBar, if st.spin then "🔄 Rotation auto" else "🔄 Rotation fixe", st.spin, 9)
		r.MouseButton1Click:Connect(function() sfx("ui"); st.spin = not st.spin; drawModes() end)
	end

	local function setPreview()
		st.token += 1
		local my, k = st.token, st.key
		local sel = st.prev or selOf(k)
		task.spawn(function()
			local list = curList(k, sel)
			local ok, m = pcall(WeaponModels.build, k, 1, list, { preview = true, ret = retOf })
			if my ~= st.token or not root.Parent then if ok and m then (m :: Model):Destroy() end return end
			if not ok or not m then warn("[Arsenal]", m) return end
			if pv.model then pv.model:Destroy() end
			local model = m :: Model
			SkinPaint.apply(model, player:GetAttribute("Skin_" .. k) :: number?, player:GetAttribute("Camo_" .. k) :: string?)
			WeaponModels.place(model, CFrame.identity)
			local cf, ext = model:GetBoundingBox()
			pv.center = cf.Position; pv.size = math.max(ext.X, ext.Z, .3)
			pv.parts = {}
			for _, c in ipairs(model:GetDescendants()) do
				if c:IsA("BasePart") then table.insert(pv.parts, { p = c, off = c.Position - pv.center }) end
			end
			model.Parent = vp
			pv.model = model
			applyMode()
		end)
	end

	-- ----- statistiques (gsStatsHTML) -----
	local function drawStats()
		clear(statsBox)
		local k = st.key
		local w = Config.WEAPONS[k]
		local cur = A.modsOf(curList(k))
		local nw = A.modsOf(curList(k, st.prev or selOf(k)))
		local rows = if w.melee then { A.statRows(k)[1] } else A.statRows(k)
		for i, r in ipairs(rows) do
			local label: string, f: (A.Mods) -> number, mx: number, fmt: (number) -> string, dir: number = (r :: any)[1], (r :: any)[2], (r :: any)[3], (r :: any)[4], (r :: any)[5]
			local v0, v1 = f(cur), f(nw)
			if w.melee then v0 = w.dmg; v1 = w.dmg; mx = 120 end
			local diff = v1 - v0
			local good: boolean? = nil
			if dir ~= 0 and math.abs(diff) > 1e-6 then good = diff * dir > 0 end
			local a = math.clamp(math.min(v0, v1) / mx * 100, 2, 100)
			local b = math.clamp(math.max(v0, v1) / mx * 100, 2, 100)
			local col = if good == nil then C.white elseif good then C.green else C.red
			local box = make("Frame", { BackgroundColor3 = C.panel, BackgroundTransparency = .1, LayoutOrder = i }, statsBox)
			stroke(box, C.line, 1, .3)
			make("TextLabel", { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 12), Text = spaced(label, 1), TextSize = 9, TextColor3 = C.dim }, box)
			make("TextLabel", { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 20), Text = fmt(v1) .. (if good == nil then "" elseif good then " ▲" else " ▼"),
				TextSize = 17, Font = Enum.Font.GothamBlack, TextColor3 = col }, box)
			local bar = make("Frame", { AnchorPoint = Vector2.new(.5, 1), Position = UDim2.new(.5, 0, 1, -6), Size = UDim2.new(1, -12, 0, 3), BackgroundColor3 = rgb(0x1c2538) }, box)
			make("Frame", { Size = UDim2.fromScale(a / 100, 1), BackgroundColor3 = C.accent }, bar)
			if good ~= nil then make("Frame", { Position = UDim2.fromScale(a / 100, 0), Size = UDim2.fromScale((b - a) / 100, 1), BackgroundColor3 = col }, bar) end
		end
	end

	-- ----- armurier (gsDraw) -----
	local drawGs: () -> ()
	local function equip(k: string, slot: string, a: string?)
		local r = remote()
		if not r then return end
		local ok, res = pcall(r.InvokeServer, r, "set", k, slot, a or "")
		if ok and typeof(res) == "table" then
			if res.att then D.att = res.att end
			if res.ok then sfx("reload", .35) else sfx("ui"); if res.msg then toast(res.msg) end end
		end
		st.prev = nil
		changed:Fire()
	end
	drawGs = function()
		clear(gs)
		local k = st.key
		local ok = A.allowed(k)
		local sel = selOf(k)
		local any = false
		for _ in pairs(ok) do any = true end
		local head = make("Frame", { Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, LayoutOrder = 1 }, gs)
		make("TextLabel", { Size = UDim2.fromScale(.4, 1), Text = spaced("ARMURIER", 2), TextSize = 12, Font = Enum.Font.GothamBlack, TextColor3 = C.orange, TextXAlignment = Enum.TextXAlignment.Left }, head)
		if not any then
			make("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Text = "Pas d'accessoires pour cette arme.", TextSize = 12, Font = Enum.Font.Gotham, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 2 }, gs)
			return
		end
		if not ok[st.slot] then for _, s in ipairs(A.SLOTS) do if ok[s.id] then st.slot = s.id; break end end end
		make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromScale(.6, 1), TextXAlignment = Enum.TextXAlignment.Right,
			Text = A.count(sel) .. " / " .. A.MAX .. " accessoires · survole pour comparer, clique pour équiper", TextSize = 11, TextColor3 = C.dim }, head)
		-- emplacements
		local slots = make("Frame", { Size = UDim2.new(1, 0, 0, 50), BackgroundTransparency = 1, LayoutOrder = 2 }, gs)
		make("UIGridLayout", { CellSize = UDim2.new(1 / 6, -5, 0, 50), CellPadding = UDim2.fromOffset(6, 0), SortOrder = Enum.SortOrder.LayoutOrder }, slots)
		for i, s in ipairs(A.SLOTS) do
			local a = sel[s.id]
			local has = a ~= nil and A.ATTS[a] ~= nil
			local on, avail = st.slot == s.id, ok[s.id] ~= nil
			local b = make("TextButton", { Text = "", BackgroundColor3 = if on then C.slotOn else C.card, BackgroundTransparency = if avail then 0 else .7, LayoutOrder = i }, slots)
			corner(b, 8); stroke(b, if on then C.orange else C.white, if on then 2 else 1, if on then 0 else .87)
			make("TextLabel", { Position = UDim2.fromOffset(7, 6), Size = UDim2.new(1, -12, 0, 12), Text = s.ic .. " " .. spaced(string.upper(s.n), 1), TextSize = 9,
				TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = if avail then 0 else .6 }, b)
			make("TextLabel", { Position = UDim2.fromOffset(7, 22), Size = UDim2.new(1, -12, 0, 18), TextTruncate = Enum.TextTruncate.AtEnd,
				Text = if has then A.ATTS[a].n elseif avail then "—" else "Indisponible", TextSize = 12, TextColor3 = if has then C.orangeT else C.white,
				TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = if avail then 0 else .6 }, b)
			b.MouseButton1Click:Connect(function() if not avail then return end sfx("ui"); st.slot = s.id; drawGs() end)
		end
		-- options
		local opts = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 3 }, gs)
		make("UIGridLayout", { CellSize = UDim2.new(.2, -5, 0, 118), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, opts)
		local cur = sel[st.slot]
		local function option(order: number, a: string?, title: string, desc: string, lock: boolean)
			local on = (a == nil and cur == nil) or (a ~= nil and cur == a)
			local b = make("TextButton", { Text = "", BackgroundColor3 = if on then C.greenBg else C.card, BackgroundTransparency = if lock then .55 else 0, LayoutOrder = order }, opts)
			corner(b, 8); stroke(b, if on then C.green else C.white, 1, if on then 0 else .87)
			make("TextLabel", { Position = UDim2.fromOffset(9, 8), Size = UDim2.new(1, -16, 0, 16), Text = title .. (if lock then " 🔒" else ""), TextSize = 12,
				TextColor3 = C.opt, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = if lock then .5 else 0, TextTruncate = Enum.TextTruncate.AtEnd }, b)
			make("TextLabel", { Position = UDim2.fromOffset(9, 26), Size = UDim2.new(1, -16, 1, -30), Text = desc, TextSize = 10, Font = Enum.Font.Gotham, TextWrapped = true,
				TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextTransparency = if lock then .4 else 0 }, b)
			local function trial(): A.Sel
				local s2: A.Sel = table.clone(selOf(k))
				s2[st.slot :: string] = a :: string
				return s2
			end
			b.MouseEnter:Connect(function() if lock then return end st.prev = trial(); setPreview(); drawStats() end)
			b.MouseLeave:Connect(function() if not st.prev then return end st.prev = nil; setPreview(); drawStats() end)
			b.MouseButton1Click:Connect(function()
				if lock and a then sfx("ui"); toast(A.lockText(k, a, D.prog)) return end
				if A.count(trial()) > A.MAX then sfx("ui"); toast("Maximum " .. A.MAX .. " accessoires : retire-en un d'abord") return end
				equip(k, st.slot, a)
			end)
		end
		option(0, nil, if st.slot == "optic" then A.opticNone(k) else "Aucun", if st.slot == "optic" then "Viseur de base de l'arme" else "Retirer l'accessoire", false)
		for i, a in ipairs(ok[st.slot] or {}) do
			local d = A.ATTS[a]
			local lock = not A.isOpen(k, a, D.prog)
			option(i, a, d.n, (if lock then A.lockText(k, a, D.prog) .. ". " else "") .. d.d, lock)
		end
	end

	-- ----- skins + équiper au départ -----
	local function drawSkins()
		clear(skl)
		header(skl, "Skin", 0)
		local grid = make("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 1 }, skl)
		make("UIGridLayout", { CellSize = UDim2.new(.5, -4, 0, 36), CellPadding = UDim2.fromOffset(6, 6), SortOrder = Enum.SortOrder.LayoutOrder }, grid)
		local k = st.key
		local prof = D.profile
		local eq = (prof and prof.equippedSkins and prof.equippedSkins[k]) or 1
		for i, s in ipairs(Config.SKINS) do
			local own = s.rarity == 1 or (prof ~= nil and prof.inv and prof.inv.skins and prof.inv.skins[k] ~= nil and table.find(prof.inv.skins[k], i) ~= nil)
			local on = i == eq
			local b = make("TextButton", { Text = "", BackgroundColor3 = C.card, BackgroundTransparency = if own then .05 else .4, LayoutOrder = i }, grid)
			stroke(b, if on then C.accent else C.white, if on then 2 else 1, if on then 0 else .9)
			make("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundColor3 = RARITY[s.rarity] or C.dim }, b)
			make("TextLabel", { Position = UDim2.fromOffset(10, 0), Size = UDim2.new(1, -14, 1, 0), Text = s.name .. (if own then "" else " 🔒"), TextSize = 11, TextWrapped = true,
				TextColor3 = if own then C.text else C.dim, TextXAlignment = Enum.TextXAlignment.Left }, b)
			b.MouseButton1Click:Connect(function()
				if not own then sfx("ui"); toast("Skin verrouillé : trouve-le dans les caisses !") return end
				local r = ReplicatedStorage:FindFirstChild("EquipSkin") :: RemoteFunction?
				if r and pcall(r.InvokeServer, r, k, i) then
					if prof then prof.equippedSkins = prof.equippedSkins or {}; prof.equippedSkins[k] = i end
					sfx("ui"); drawSkins(); task.delay(.3, setPreview)
				end
			end)
		end
		local w = Config.WEAPONS[k]
		if w.slot == 0 or w.slot == 1 then
			local attr = player:GetAttribute(if w.slot == 0 then "Primary" else "Secondary")
			local cur = attr == k
			local b = chip(skl, if cur then "✔ Équipée au départ" else "Équiper au départ", cur, 2)
			b.MouseButton1Click:Connect(function()
				local r = ReplicatedStorage:FindFirstChild("SetLoadout") :: RemoteFunction?
				if not r then toast("Choix de l'arme indisponible ici") return end
				local ok, res = pcall(r.InvokeServer, r, k)
				sfx("ui")
				if ok and res then task.delay(.2, drawSkins) else toast("Cette arme n'est pas encore débloquée.") end
			end)
		end
		make("TextLabel", { Size = UDim2.new(1, -6, 0, 30), Text = if w.slot == 0 then "Arme principale de départ (Match à mort)." elseif w.slot == 1 then "Pistolet de départ." else "Le skin du couteau est visible en jeu.",
			TextSize = 10, Font = Enum.Font.Gotham, TextWrapped = true, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 3 }, skl)
	end

	local function refreshAll()
		for k2, c in pairs(chips) do
			local on = k2 == st.key
			c.BackgroundColor3 = if on then rgb(0x3a1a22) else C.panel
			local s = c:FindFirstChildOfClass("UIStroke"); if s then s.Color = if on then C.accent else C.line end
		end
		nameL.Text = spaced(string.upper(Config.WEAPONS[st.key].name), 2)
		drawStats(); drawGs(); drawSkins(); setPreview()
	end

	-- ----- liste des armes -----
	local order = 0
	for _, cat in ipairs(CATS) do
		order += 1; header(wl, cat[1], order)
		for _, k in ipairs(cat[2]) do
			if Config.WEAPONS[k] then
				order += 1
				local b = make("TextButton", { Size = UDim2.new(1, -8, 0, 30), Text = "", BackgroundColor3 = C.panel, LayoutOrder = order }, wl)
				stroke(b, C.line, 1, .2)
				weaponIcon(b, k, Vector2.new(46, 18), UDim2.fromOffset(8, 6))
				make("TextLabel", { Position = UDim2.fromOffset(62, 0), Size = UDim2.new(1, -66, 1, 0), Text = Config.WEAPONS[k].name, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Left }, b)
				b.MouseButton1Click:Connect(function() sfx("ui"); st.key = k; current.key = k; st.prev = nil; refreshAll() end)
				chips[k] = b
			end
		end
	end

	-- rotation : auto ou à la souris
	table.insert(conns, vp.InputBegan:Connect(function(i: InputObject)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then st.drag = Vector2.new(i.Position.X, i.Position.Y) end
	end))
	table.insert(conns, UserInputService.InputChanged:Connect(function(i: InputObject)
		if st.drag and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then
			local p = Vector2.new(i.Position.X, i.Position.Y)
			local d = p - (st.drag :: Vector2)
			st.ry += d.X * .01; st.rx = math.clamp(st.rx + d.Y * .006, -.6, .6); st.drag = p
		end
	end))
	table.insert(conns, UserInputService.InputEnded:Connect(function(i: InputObject)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then st.drag = nil end
	end))
	local explode = 0
	table.insert(conns, RunService.RenderStepped:Connect(function(dt: number)
		if not root.Visible or not pv.model then return end
		if st.spin and not st.drag then st.ry += dt * .5 end
		explode += ((if st.mode == "explode" then 1 else 0) - explode) * math.min(1, dt * 6)
		local rot = CFrame.Angles(st.rx, st.ry, 0)
		for _, e in ipairs(pv.parts) do
			if e.p.Parent then
				local off = e.off * (1 + explode * .9) + Vector3.new(0, 0, 0)
				local base = e.p:GetAttribute("Offset")
				local localRot = if typeof(base) == "CFrame" then base.Rotation else CFrame.identity
				e.p.CFrame = rot * CFrame.new(off) * localRot
			end
		end
		-- caméra du web : (0, .28, 2.6) vers l'origine, arme ramenée à 1,9 de large
		local k = pv.size / 1.9
		cam.CFrame = CFrame.lookAt(Vector3.new(0, .28, 2.6) * k, Vector3.zero)
		floor.CFrame = CFrame.new(0, -.36 * k, 0) * CFrame.Angles(0, 0, math.rad(90)); floor.Size = Vector3.new(.02, 2.6 * k, 2.6 * k)
	end))
	table.insert(conns, changed.Event:Connect(function() if root.Parent then refreshAll() end end))

	drawModes()
	refreshAll()
	if not D.loaded then task.spawn(load) end
	return {
		destroy = function() for _, c in ipairs(conns) do c:Disconnect() end root:Destroy() end,
		refresh = function() task.spawn(load) end,
	}
end

-- =====================================================================================
-- ARSENAL › VISEURS
-- =====================================================================================
local function curOpt(k: string): string?
	local o = selOf(k).optic
	local l = A.allowed(k).optic or {}
	return if o and table.find(l, o) then o else nil
end

-- aperçu : petite scène de stand de tir vue à travers le viseur (svScene + svPreview du web)
local function drawScene(host: Frame, z: number)
	local world = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .5), Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, host)
	make("UIScale", { Scale = z }, world)
	local function rect(x: number, y: number, w: number, h: number, col: Color3, edge: boolean?): Frame
		local f = make("Frame", { Position = UDim2.fromScale(x, y), Size = UDim2.fromScale(w, h), BackgroundColor3 = col }, world)
		if edge then stroke(f, Color3.new(), 1, .75) end
		return f
	end
	local sky = rect(-1, -1, 3, 1.55, Color3.new(1, 1, 1))
	make("UIGradient", { Rotation = 90, Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, rgb(0x5d7ea6)), ColorSequenceKeypoint.new(.64, rgb(0x5d7ea6)), ColorSequenceKeypoint.new(1, rgb(0xb9c9d8)) }) }, sky)
	rect(-1, .55, 3, 2, rgb(0x6d6250))
	-- lignes du sol qui fuient vers l'horizon
	for i = -6, 11 do
		local x0, x1 = .5 + i * 90 / 640, .5 + i * 260 / 640
		local f = make("Frame", { AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale((x0 + x1) / 2, .55), Size = UDim2.new(0, 3, 1.45, 0), BackgroundColor3 = rgb(0x857a66),
			Rotation = -math.deg(math.atan2((x1 - x0) * 640, 1.45 * 400)) }, world)
		local _ = f
	end
	rect(.08, .42, .12, .16, rgb(0x8a6a42), true); rect(.78, .4, .14, .18, rgb(0x8a6a42), true); rect(.3, .47, .06, .09, rgb(0x7a5d3a), true)
	-- cible au centre
	make("Frame", { AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, .5), Size = UDim2.new(0, 3, .06, 0), BackgroundColor3 = rgb(0x2b2f36) }, world)
	local head = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .465), Size = UDim2.fromScale(.0875, .056), BackgroundColor3 = rgb(0xe9e3d4) }, world)
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, head); corner(head, 999)
	make("Frame", { AnchorPoint = Vector2.new(.5, 0), Position = UDim2.fromScale(.5, .49), Size = UDim2.fromScale(.0375, .07), BackgroundColor3 = rgb(0xe9e3d4) }, world)
	local ringF = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromScale(.5, .52), Size = UDim2.fromScale(.056, .036), BackgroundTransparency = 1 }, world)
	make("UIAspectRatioConstraint", { AspectRatio = 1 }, ringF); corner(ringF, 999); stroke(ringF, rgb(0xc23b3b), 1.5)
end

local function drawSightPreview(host: Frame, k: string)
	clear(host)
	local W, H = host.AbsoluteSize.X, host.AbsoluteSize.Y
	if W < 10 or H < 10 then return end
	local o = curOpt(k)
	local w = Config.WEAPONS[k]
	local ov = if o then A.ATTS[o].ov == true else w.cat == "sniper"
	local z = if ov then (if o then A.ATTS[o].m.zoom else w.zoom) * .8 elseif o == "acog" then 2 else 1.15
	drawScene(host, z)
	local cx, cy = W / 2, H / 2
	local dk = C.dark
	local layer = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 3 }, host)
	local function rectPx(x: number, y: number, ww: number, hh: number, col: Color3, tr: number?)
		make("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(ww, hh), BackgroundColor3 = col, BackgroundTransparency = tr or 0, ZIndex = 3 }, layer)
	end
	-- trou circulaire : anneau à bord énorme (même astuce que la lunette du viewmodel)
	local function hole(R: number, ringCol: Color3?, ringW: number?)
		local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(R * 2, R * 2), BackgroundTransparency = 1, ZIndex = 3 }, layer)
		corner(f, 9999); make("UIStroke", { Thickness = math.max(W, H), Color = Color3.new() }, f)
		if ringCol then
			local r2 = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(R * 2 + 10, R * 2 + 10), BackgroundTransparency = 1, ZIndex = 4 }, layer)
			corner(r2, 9999); make("UIStroke", { Thickness = ringW or 10, Color = ringCol }, r2)
		end
	end
	if ov then
		local R = H * .44
		hole(R)
		local s, c = retOf(o or "scope")
		ReticleGui.draw(layer, cx, cy, R, s, c, true, 5)
		return
	end
	if not o then               -- mires : guidon + cran de mire
		rectPx(cx - 3, cy, 6, H * .2, dk); rectPx(cx - 80, cy + H * .1, 62, H * .4, dk); rectPx(cx + 18, cy + H * .1, 62, H * .4, dk)
		rectPx(cx - 18, cy + H * .16, 36, H * .4, dk)
		return
	end
	local s, c = retOf(o)
	if o == "acog" then
		local R = H * .36
		hole(R, rgb(0x2c3138), 10)
		ReticleGui.draw(layer, cx, cy, R * .55, s, c, false, 5)
		return
	end
	local frameCol = rgb(0x2c3138)
	if o == "reddot" then
		local R = H * .3
		local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(R * 2, R * 2), BackgroundTransparency = 1, ZIndex = 3 }, layer)
		corner(f, 9999); make("UIStroke", { Thickness = 16, Color = frameCol }, f)
		rectPx(cx - R * .7, cy + R + 4, R * 1.4, H, dk)
	elseif o == "holo" then
		local ww, hh = H * .62, H * .44
		local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(ww, hh), BackgroundTransparency = 1, ZIndex = 3 }, layer)
		make("UIStroke", { Thickness = 14, Color = frameCol }, f)
		rectPx(cx - ww / 2 - 7, cy + hh / 2, ww + 14, H, dk)
	else
		local ww, hh = H * .38, H * .3
		local f = make("Frame", { AnchorPoint = Vector2.new(.5, .5), Position = UDim2.fromOffset(cx, cy), Size = UDim2.fromOffset(ww, hh), BackgroundTransparency = 1, ZIndex = 3 }, layer)
		make("UIStroke", { Thickness = 9, Color = frameCol }, f)
		rectPx(cx - ww / 2 - 5, cy + hh / 2, ww + 10, H, dk)
	end
	rectPx(0, 0, W, H, rgb(0x7fd8ff), .94)
	ReticleGui.draw(layer, cx, cy, if o == "holo" then H * .1 else H * .08, s, c, false, 5)
end

function P.sights(parent: Frame): { destroy: () -> (), refresh: () -> () }
	local root = make("Frame", { Name = "ArsenalSights", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ClipsDescendants = true }, parent)
	local toast = toaster(root)
	local conns: { RBXScriptConnection } = {}
	local left = make("ScrollingFrame", { Size = UDim2.new(0, 230, 1, 0), BackgroundTransparency = 1, ScrollBarThickness = 4, ScrollBarImageColor3 = C.line,
		AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, root)
	vlist(left, 4)
	local mid = make("Frame", { Position = UDim2.fromOffset(252, 0), Size = UDim2.new(1, -252 - 352, 1, 0), BackgroundTransparency = 1 }, root)
	local prev = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = rgb(0x0b1220), ClipsDescendants = true }, mid)
	make("UIAspectRatioConstraint", { AspectRatio = 1.6 }, prev); corner(prev, 10)
	local info = make("TextLabel", { Position = UDim2.new(0, 0, 0, 0), Size = UDim2.new(1, 0, 0, 60), Text = "", RichText = true, TextSize = 13, Font = Enum.Font.Gotham,
		TextColor3 = C.soft, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, mid)
	local right = make("ScrollingFrame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 330, 1, 0), BackgroundTransparency = 1,
		ScrollBarThickness = 4, ScrollBarImageColor3 = C.line, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new() }, root)
	vlist(right, 6)

	local st = { key = nil :: string? }
	local draw: () -> ()
	local function setOpt(k: string, a: string?): boolean
		local s2: A.Sel = table.clone(selOf(k))
		s2.optic = a :: any
		if A.count(s2) > A.MAX then sfx("ui"); toast("Maximum " .. A.MAX .. " accessoires : retire-en un dans l'armurier") return false end
		local r = remote()
		if not r then return false end
		local ok, res = pcall(r.InvokeServer, r, "set", k, "optic", a or "")
		if ok and typeof(res) == "table" then
			if res.att then D.att = res.att end
			if not res.ok then if res.msg then toast(res.msg) end return false end
		end
		return true
	end
	local function setRet(o: string, shape: string?, col: string?)
		local s0, c0 = retOf(o)
		local r = remote()
		if not r then return end
		local ok, res = pcall(r.InvokeServer, r, "ret", o, shape or s0, col or c0)
		if ok and typeof(res) == "table" and res.ret then D.ret = res.ret end
		changed:Fire()
	end

	draw = function()
		local k = st.key
		if not k or not Config.WEAPONS[k] or not A.allowed(k).optic then
			local pk = current.key
			st.key = if pk and Config.WEAPONS[pk] and A.allowed(pk).optic then pk else (SIGHT_WEAPONS.rifle or SIGHT_WEAPONS.smg)[1]
			k = st.key
		end
		local key = k :: string
		-- armes
		clear(left)
		local order = 0
		for _, c in ipairs(SIGHT_CATS) do
			local l = SIGHT_WEAPONS[c[1]]
			if l then
				order += 1; header(left, c[2], order)
				order += 1
				local box = make("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, left)
				hflow(box, 5)
				for i, kk in ipairs(l) do
					local o = curOpt(kk)
					local b = chip(box, Config.WEAPONS[kk].name .. (if o then "  ◎" else ""), kk == key, i)
					b.MouseButton1Click:Connect(function() sfx("ui"); st.key = kk; current.key = kk; draw() end)
				end
			end
		end
		-- viseurs
		clear(right)
		local cur = curOpt(key)
		header(right, "Viseur — " .. Config.WEAPONS[key].name, 1)
		local function row(order2: number, a: string?, title: string, small: string, zoom: string, lock: boolean)
			local on = a == cur
			local b = make("TextButton", { Size = UDim2.new(1, -6, 0, 48), Text = "", BackgroundColor3 = if on then C.greenBg else C.card, BackgroundTransparency = if lock then .55 else 0, LayoutOrder = order2 }, right)
			corner(b, 8); stroke(b, if on then C.green else C.white, 1, if on then 0 else .87)
			make("TextLabel", { Position = UDim2.fromOffset(11, 7), Size = UDim2.new(1, -70, 0, 16), Text = title .. (if lock then " 🔒" else ""), TextSize = 13, TextColor3 = C.opt,
				TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = if lock then .45 else 0 }, b)
			make("TextLabel", { Position = UDim2.fromOffset(11, 25), Size = UDim2.new(1, -70, 0, 16), Text = small, TextSize = 10, Font = Enum.Font.Gotham, TextColor3 = C.dim,
				TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, TextTransparency = if lock then .4 else 0 }, b)
			make("TextLabel", { AnchorPoint = Vector2.new(1, .5), Position = UDim2.new(1, -11, .5, 0), Size = UDim2.fromOffset(50, 16), Text = zoom, TextSize = 11, TextColor3 = C.orangeT,
				TextXAlignment = Enum.TextXAlignment.Right }, b)
			b.MouseButton1Click:Connect(function()
				if lock and a then sfx("ui"); toast(A.lockText(key, a, D.prog)) return end
				if setOpt(key, a) then sfx("reload", .3) end
				changed:Fire()
			end)
		end
		row(2, nil, A.opticNone(key), "Viseur de base de l'arme", A.zoomText(key, nil), false)
		for i, a in ipairs(A.allowed(key).optic) do
			local d = A.ATTS[a]
			local lock = not A.isOpen(key, a, D.prog)
			local small = if lock then string.gsub(A.lockText(key, a, D.prog), "Requis : ", "") else (string.split(string.split(d.d, ":")[1], ".")[1])
			row(2 + i, a, d.n, small, A.zoomText(key, a), lock)
		end
		-- réticule
		local o = cur or (if Config.WEAPONS[key].cat == "sniper" then "scope" else nil)
		if not o then
			header(right, "Réticule", 20)
			make("TextLabel", { Size = UDim2.new(1, -6, 0, 40), Text = "Les mires d'origine n'ont pas de réticule réglable. Choisis un viseur pour personnaliser son réticule.",
				TextSize = 12, Font = Enum.Font.Gotham, TextWrapped = true, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 21 }, right)
		else
			local s0, c0 = retOf(o)
			header(right, "Forme du réticule", 20)
			local shapes = make("Frame", { Size = UDim2.new(1, -6, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = 21 }, right)
			hflow(shapes, 5)
			for i, r in ipairs(A.RET_SHAPES) do
				local b = chip(shapes, r[2], s0 == r[1], i)
				b.MouseButton1Click:Connect(function() sfx("ui"); setRet(o :: string, r[1], nil) end)
			end
			header(right, "Couleur", 22)
			local sw = make("Frame", { Size = UDim2.new(1, -6, 0, 30), BackgroundTransparency = 1, LayoutOrder = 23 }, right)
			make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 7) }, sw)
			for i, col in ipairs(A.RET_COLS) do
				local b = make("TextButton", { Size = UDim2.fromOffset(26, 26), Text = "", BackgroundColor3 = ReticleGui.hex(col), LayoutOrder = i }, sw)
				corner(b, 13); stroke(b, if col == c0 then C.white else C.white, 2, if col == c0 then 0 else .8)
				b.MouseButton1Click:Connect(function() sfx("ui"); setRet(o :: string, nil, col) end)
			end
			if cur then
				local all = chip(right, "Mettre ce viseur sur toutes les armes compatibles", false, 24)
				all.Size = UDim2.new(1, -6, 0, 32); all.AutomaticSize = Enum.AutomaticSize.None
				all.MouseButton1Click:Connect(function()
					sfx("ui")
					local r = remote()
					if not r then return end
					local ok, res = pcall(r.InvokeServer, r, "all", key)
					if ok and typeof(res) == "table" and res.ok then
						if res.att then D.att = res.att end
						local n = res.n or 0
						toast(A.ATTS[cur].n .. " posé sur " .. n .. " autre" .. (if n > 1 then "s" else "") .. " arme" .. (if n > 1 then "s" else ""))
					end
					changed:Fire()
				end)
			end
		end
		info.Text = "<b><font color=\"#ffffff\">" .. spaced(string.upper(if cur then A.ATTS[cur].n else A.opticNone(key)), 1) .. "</font></b>\n"
			.. (if cur then A.ATTS[cur].d elseif Config.WEAPONS[key].cat == "sniper" then "Lunette montée d'usine. Choisis un autre grossissement à droite." else "Visée par les organes de visée de l'arme.")
		info.Position = UDim2.fromOffset(0, prev.AbsoluteSize.Y + 10)
		drawSightPreview(prev, key)
	end

	table.insert(conns, prev:GetPropertyChangedSignal("AbsoluteSize"):Connect(function() if st.key then info.Position = UDim2.fromOffset(0, prev.AbsoluteSize.Y + 10); drawSightPreview(prev, st.key) end end))
	table.insert(conns, changed.Event:Connect(function() if root.Parent then draw() end end))
	draw()
	if not D.loaded then task.spawn(load) end
	return {
		destroy = function() for _, c in ipairs(conns) do c:Disconnect() end root:Destroy() end,
		refresh = function() task.spawn(load) end,
	}
end

-- recharge les données (après un gain de niveau, une fin de partie…)
P.reload = function() task.spawn(load) end
P.changed = changed.Event

return P
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">AttachmentModels</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/AttachmentModels (ModuleScript, côté client)
-- Pose les accessoires de l'armurier sur une arme fabriquée par WeaponModels, comme attBuild() du web
-- (src/64b_gunsmith.js) : silencieux, compensateur, frein, cache-flamme, canons, poignées, laser, chargeurs, crosses,
-- et les viseurs en 3D faits dans Blender (OpticMeshes, src/64d_optics3d.js) avec leur lentille et le réticule choisi.
-- Met à jour la ligne de visée (attribut SightY), le bout du canon (Muzzle) et la main gauche (LeftHand, autour de la
-- poignée verticale) : le viewmodel, les tracés et la vue à la 3e personne suivent sans rien changer.
-- Tout est calculé en mètres dans le repère de l'arme (poignée en 0, canon vers -Z), puis multiplié par l'échelle.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Info = require(ReplicatedStorage.Shared.WeaponInfo)
local InfoReal = require(ReplicatedStorage.Shared.WeaponInfoReal) :: { [string]: any }
local A = require(ReplicatedStorage.Shared.Attachments)
local ReticleGui = require(ReplicatedStorage.Shared.ReticleGui)
local decode = require(ReplicatedStorage.Shared.Base64)
local MeshStore = require(ReplicatedStorage.Shared.MeshStore)

local AM = {}
AM.optics3d = true                      -- false : viseurs simples (géométrie de base), comme cfg.optics3d = 0 sur le web

local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local MAT: { [string]: { any } } = {
	blk = { rgb(0x17191d), Enum.Material.Metal }, dark = { rgb(0x2b3037), Enum.Material.Metal }, tan = { rgb(0x6b6150), Enum.Material.SmoothPlastic },
	rub = { rgb(0x101114), Enum.Material.SmoothPlastic }, tape = { rgb(0x2d2d24), Enum.Material.Fabric }, red = { rgb(0xff2030), Enum.Material.Neon },
	tube = { rgb(0x15171b), Enum.Material.Metal }, wood = { rgb(0x8a7a5a), Enum.Material.Wood },
}
-- matériaux des viseurs Blender (OPT3D_MAT du web)
local OMAT: { [string]: { any } } = {
	body = { rgb(0x17191c), Enum.Material.Metal }, dark = { rgb(0x2a2e34), Enum.Material.Metal }, rubber = { rgb(0x0d0d0f), Enum.Material.SmoothPlastic },
	metal = { rgb(0x9a9ca2), Enum.Material.Metal }, tan = { rgb(0x7a6a4c), Enum.Material.SmoothPlastic },
	emit_red = { rgb(0xff2010), Enum.Material.Neon }, emit_fiber = { rgb(0xff4a10), Enum.Material.Neon },
}
local OPT3D_KEY = { reddot = "reddot", holo = "holo", mini = "mini", acog = "acog", sc4 = "scope", sc6 = "scope", sc8 = "scope", sc10 = "scope" }

-- ---------- profil de l'arme (hauteur du dessus / du dessous le long du canon), gunProfile() du web ----------
type Prof = { z0: number, z1: number, NB: number, top: { number }, bot: { number }, pts: { Vector3 }, bore: number }
local PROF: { [string]: Prof } = {}
local NB = 160

-- real : arme réaliste (WeaponReal) : points du profil précalculés (WeaponInfoReal.pts, sans le viseur intégré)
local function profileOf(key: string, real: boolean?): Prof?
	local pid = (if real then "r:" else "") .. key
	if PROF[pid] then return PROF[pid] end
	local folder = ReplicatedStorage.Shared:FindFirstChild("WeaponMeshes")
	local src = if real then nil else folder and folder:FindFirstChild(key)
	local inf: any = if real then InfoReal[key] else Info[key]
	if not inf then return nil end
	local pts: { Vector3 } = {}
	if real and inf.pts then
		local raw = decode(inf.pts)
		for i = 0, buffer.len(raw) // 6 - 1 do
			table.insert(pts, Vector3.new(buffer.readi16(raw, i * 6), buffer.readi16(raw, i * 6 + 2), buffer.readi16(raw, i * 6 + 4)) / 20000)
		end
	end
	if src then
		local ok = pcall(function()
			local groups = require(src :: ModuleScript) :: any
			for _, g in ipairs(groups) do
				local raw = decode(g.data)
				local st = math.max(1, g.nv // 4000)
				for i = 0, g.nv - 1, st do
					table.insert(pts, Vector3.new(buffer.readi16(raw, i * 6), buffer.readi16(raw, i * 6 + 2), buffer.readi16(raw, i * 6 + 4)) / 30000)
				end
			end
		end)
		if not ok then pts = {} end
	end
	if #pts == 0 then     -- pas de maillage : boîte d'après WeaponInfo
		for _, z in ipairs({ inf.max[3], inf.min[3] }) do
			table.insert(pts, Vector3.new(0, inf.sight, z)); table.insert(pts, Vector3.new(0, inf.min[2] * 0.4, z))
		end
	end
	local z0, z1 = math.huge, -math.huge
	for _, p in ipairs(pts) do z0 = math.min(z0, p.Z); z1 = math.max(z1, p.Z) end
	local top, bot = table.create(NB, -1e9), table.create(NB, 1e9)
	local function bin(z: number): number return math.clamp(math.floor((z - z0) / (z1 - z0 + 1e-6) * NB), 0, NB - 1) + 1 end
	for _, p in ipairs(pts) do local b = bin(p.Z); top[b] = math.max(top[b], p.Y); bot[b] = math.min(bot[b], p.Y) end
	-- âme du canon : milieu de la section à la bouche
	local mz = inf.muzzle
	local ty, by = -1e9, 1e9
	for _, p in ipairs(pts) do if p.Z < mz + .012 then ty = math.max(ty, p.Y); by = math.min(by, p.Y) end end
	local pr: Prof = { z0 = z0, z1 = z1, NB = NB, top = top, bot = bot, pts = pts, bore = 0 }
	PROF[pid] = pr
	local function at(arr: { number }, z: number): number
		local b = bin(z)
		local r = arr[b]
		local d = 1
		while math.abs(r) > 1e8 do
			if d > NB then return 0 end
			r = arr[math.clamp(b - d, 1, NB)]
			if math.abs(r) > 1e8 then r = arr[math.clamp(b + d, 1, NB)] end
			d += 1
		end
		return r
	end
	;(pr :: any).at = at
	pr.bore = if ty > -1e8 then (ty + by) / 2 else (at(top, mz + .01) + at(bot, mz + .01)) / 2
	return pr
end
local function at(pr: Prof, arr: { number }, z: number): number return ((pr :: any).at)(arr, z) end
local function topR(pr: Prof, za: number, zb: number): number
	local m = -1e9
	local z = za
	while z <= zb do m = math.max(m, at(pr, pr.top, z)); z += .01 end
	return m
end
-- dessous du garde-main à z (ignore chargeur, pontet, poignée : points trop bas sous le canon)
local function under(pr: Prof, z: number, depth: number?): number
	local m = 1e9
	local lo = pr.bore - (depth or .08)
	for _, p in ipairs(pr.pts) do if math.abs(p.Z - z) < .015 and p.Y > lo and p.Y < pr.bore then m = math.min(m, p.Y) end end
	return if m < 1e8 then m else at(pr, pr.bot, z)
end
local function slice(pr: Prof, za: number, zb: number): (number?, number?)
	local t, b = -1e9, 1e9
	for _, p in ipairs(pr.pts) do if p.Z >= za and p.Z <= zb then t = math.max(t, p.Y); b = math.min(b, p.Y) end end
	if t > -1e8 then return t, b end
	return nil, nil
end

-- ---------- fabrication des pièces ----------
type Ctx = { model: Model, sc: number, grip: BasePart }
local function piece(ctx: Ctx, name: string, size: Vector3, pos: Vector3, mat: { any }, rot: CFrame?, shape: Enum.PartType?, piece: string?): Part
	local p = Instance.new("Part"); p.Name = "Att_" .. name
	p.Size = Vector3.new(math.max(size.X, .0005), math.max(size.Y, .0005), math.max(size.Z, .0005)) * ctx.sc
	p.Color = mat[1]; p.Material = mat[2]
	if shape then p.Shape = shape end
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false
	local off = CFrame.new(pos * ctx.sc) * (rot or CFrame.identity)
	p:SetAttribute("Piece", piece or "body"); p:SetAttribute("Role", "att"); p:SetAttribute("Offset", off)
	p.CFrame = ctx.grip.CFrame * off
	p.Parent = ctx.model
	return p
end
local ROT_Z = CFrame.Angles(0, math.rad(90), 0)        -- cylindre Roblox (axe X) couché le long du canon
local ROT_Y = CFrame.Angles(0, 0, math.rad(90))        -- cylindre debout
local function box(ctx: Ctx, n: string, w: number, h: number, d: number, mat: { any }, x: number, y: number, z: number, rot: CFrame?): Part
	return piece(ctx, n, Vector3.new(w, h, d), Vector3.new(x, y, z), mat, rot)
end
local function cylZ(ctx: Ctx, n: string, r: number, L: number, mat: { any }, x: number, y: number, z: number): Part
	return piece(ctx, n, Vector3.new(L, r * 2, r * 2), Vector3.new(x, y, z), mat, ROT_Z, Enum.PartType.Cylinder)
end
-- tube ouvert (on vise au travers) : couronne de lattes
local function tubeZ(ctx: Ctx, n: string, r: number, L: number, mat: { any }, y: number, z: number)
	local seg = 12
	for i = 0, seg - 1 do
		local a = i / seg * math.pi * 2
		local w = 2 * r * math.tan(math.pi / seg) + .001
		box(ctx, n, w, .003, L, mat, math.cos(a) * r, y + math.sin(a) * r, z, CFrame.Angles(0, 0, a + math.pi / 2))
	end
end

-- lentille + réticule (texture du web remplacée par une SurfaceGui)
local function lens(ctx: Ctx, w: number, h: number, pos: Vector3, round: boolean)
	local p = piece(ctx, "Lens", Vector3.new(w, h, .0004), pos, { rgb(0x7fd8ff), Enum.Material.Glass })
	p.Transparency = .88
	if round then p.Shape = Enum.PartType.Cylinder; p.Size = Vector3.new(.0004, h, w) * ctx.sc; p:SetAttribute("Offset", (p:GetAttribute("Offset") :: CFrame) * ROT_Z); p.CFrame = ctx.grip.CFrame * (p:GetAttribute("Offset") :: CFrame) end
end
local function reticle(ctx: Ctx, size: number, pos: Vector3, shape: string, col: string)
	local p = piece(ctx, "Reticle", Vector3.new(size, size, .0002), pos, { Color3.new(), Enum.Material.SmoothPlastic })
	p.Transparency = 1
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Back; sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
	sg.CanvasSize = Vector2.new(128, 128); sg.LightInfluence = 0; sg.Brightness = 2.5; sg.ClipsDescendants = true
	local holder = Instance.new("Frame"); holder.Size = UDim2.fromScale(1, 1); holder.BackgroundTransparency = 1; holder.Parent = sg
	ReticleGui.draw(holder, 64, 64, 58, shape, col, false)
	sg.Parent = p
end

-- maillage d'un viseur Blender ; f = transformation (mètres, repère de l'arme : échelle uniforme + décalage)
-- chaque groupe est construit une fois à sa taille d'origine (MeshStore : asset envoyé, sinon EditableMesh) puis copié et agrandi
local opticCache: { [string]: { mp: MeshPart, center: Vector3, size: Vector3 } } = {}
local function opticBase(key: string, gi: number, g: any): { mp: MeshPart, center: Vector3, size: Vector3 }
	local id = key .. "#" .. gi
	if opticCache[id] then return opticCache[id] end
	local raw = decode(g.data)
	local pos, nrm = table.create(g.nv), table.create(g.nv)
	local lo, hi = Vector3.one * math.huge, -Vector3.one * math.huge
	for i = 0, g.nv - 1 do
		local o = i * 9
		local v = Vector3.new(buffer.readi16(raw, o), buffer.readi16(raw, o + 2), buffer.readi16(raw, o + 4)) / 100000
		pos[i + 1] = v; lo = lo:Min(v); hi = hi:Max(v)
		nrm[i + 1] = Vector3.new(buffer.readi8(raw, o + 6), buffer.readi8(raw, o + 7), buffer.readi8(raw, o + 8)) / 127
	end
	local center = (lo + hi) / 2
	local mp = MeshStore.meshPart("o:" .. id .. "/" .. g.nv .. "/" .. g.nt, function()
		local em = AssetService:CreateEditableMesh({ FixedSize = false })
		if not em then error("mémoire des maillages pleine") end
		local vid, nid = table.create(g.nv), table.create(g.nv)
		for i = 1, g.nv do vid[i] = em:AddVertex(pos[i] - center); nid[i] = em:AddNormal(if nrm[i].Magnitude > 1e-3 then nrm[i].Unit else Vector3.yAxis) end
		local base = g.nv * 9
		for t = 0, g.nt - 1 do
			local a = buffer.readu16(raw, base + t * 6) + 1
			local b = buffer.readu16(raw, base + t * 6 + 2) + 1
			local c = buffer.readu16(raw, base + t * 6 + 4) + 1
			local face = em:AddTriangle(vid[a], vid[b], vid[c])
			em:SetFaceNormals(face, { nid[a], nid[b], nid[c] })
		end
		return em
	end, MeshStore.PRECISE)                -- maillage complet même de loin (comme les armes, voir MeshStore)
	pcall(function() (mp :: any).DoubleSided = true end)
	local e = { mp = mp, center = center, size = hi - lo }
	opticCache[id] = e
	return e
end
AM.opticBase = opticBase

local function opticMesh(ctx: Ctx, key: string, f: (Vector3) -> Vector3): boolean
	if not AM.optics3d then return false end
	local folder = ReplicatedStorage.Shared:FindFirstChild("OpticMeshes")
	local src = folder and folder:FindFirstChild(key)
	if not src then return false end
	local made: { Instance } = {}
	local f0 = f(Vector3.zero)
	local k = (f(Vector3.xAxis) - f0).Magnitude * ctx.sc
	local ok = pcall(function()
		local data = require(src :: ModuleScript) :: any
		for gi, g in ipairs(data.groups) do
			local base = opticBase(key, gi, g)
			local mp = base.mp:Clone()
			mp.Size = (base.size * k):Max(Vector3.one * 0.001)   -- taille d'après les sommets (voir WeaponModels)
			local m = OMAT[g.mat] or OMAT.body
			mp.Name = "Att_optic_" .. g.mat; mp.Color = m[1]; mp.Material = m[2]
			mp:SetAttribute("OMat", g.mat)          -- WeaponMaterials : anodisé, caoutchouc, métal (dans le monde)
			mp.Anchored = true; mp.CanCollide = false; mp.CanQuery = false; mp.CanTouch = false; mp.Massless = true; mp.CastShadow = false
			local off = CFrame.new(f(base.center) * ctx.sc)
			mp:SetAttribute("Piece", "body"); mp:SetAttribute("Role", "att"); mp:SetAttribute("Offset", off)
			mp.CFrame = ctx.grip.CFrame * off
			table.insert(made, mp)
		end
	end)
	if not ok then for _, m in ipairs(made) do m:Destroy() end return false end
	for _, m in ipairs(made) do m.Parent = ctx.model end
	return true
end
function AM.opticInfo(key: string): any
	local folder = ReplicatedStorage.Shared:FindFirstChild("OpticMeshes")
	local src = folder and folder:FindFirstChild(key)
	if not src then return nil end
	local ok, data = pcall(require, src :: ModuleScript)
	return if ok then (data :: any).info else nil
end

-- ---------- pose des accessoires ----------
-- opts.preview : laser court (aperçu de l'Arsenal) ; opts.ret(optique) -> (forme, couleur) du réticule
export type Opts = { preview: boolean?, ret: ((string) -> (string, string))? }
function AM.apply(model: Model, key: string, list: { string }, sc: number, opts: Opts?)
	local w = Config.WEAPONS[key]
	-- arme réaliste : ses propres dimensions et son profil ; une optique montée remplace le viseur intégré (M4)
	local real = model:GetAttribute("Real") == true
	local inf: any = if real then InfoReal[key] else Info[key]
	local grip = model.PrimaryPart
	if not w or w.melee or not inf or not grip or #list == 0 then return end
	local pr = profileOf(key, real)
	if not pr then return end
	local slot = if real then inf.optSlot else nil
	local o: Opts = opts or ({} :: Opts)
	local ctx: Ctx = { model = model, sc = sc, grip = grip }
	local pistol = w.cat == "pistol"
	local S = if pistol then .7 else 1
	local bore = pr.bore
	local muzzle = inf.muzzle
	local sight: number? = nil
	local left = if pistol then Vector3.new(-.012, -.04, .02) else Vector3.new(inf.left[1], inf.left[2] - .012, inf.left[3])
	local leftZ: number? = if pistol then nil else inf.left[3]
	local leftV = false
	local function retOf(a: string): (string, string)
		if o.ret then return o.ret(a) end
		return A.retOf(a, nil)
	end
	local ORD = { barrel = 1, muzzle = 2, optic = 3, under = 4, mag = 5, stock = 6 }
	local todo = table.clone(list)
	table.sort(todo, function(a, b) return ORD[A.ATTS[a].s] < ORD[A.ATTS[b].s] end)
	local mags: { BasePart } = {}
	for _, c in ipairs(model:GetChildren()) do if c:IsA("BasePart") and c:GetAttribute("Piece") == "mag" then table.insert(mags, c) end end

	-- viseur : pièces dans un repère (base, z), réduit ×0,62 sur pistolet, rehaussé si une pièce gêne la vue
	local function optic(a: string, z: number, base: number, cy0: number, zb: number, build: (add: (n: string, w: number, h: number, d: number, m: { any }, x: number, y: number, z: number, cyl: string?, r: CFrame?) -> ()) -> (), lensList: { any }, retSize: number?, retZ: number?)
		local k = if pistol then .62 else 1
		local dy = 0
		local cy = base + (cy0 - base) * k
		if not pistol then
			local occ = topR(pr, zb, .27)
			if occ > cy - .008 then dy = occ + .014 - cy
				box(ctx, "riser", .022, dy + .004, .04, MAT.dark, 0, base + dy / 2, z)
				cy += dy
			end
		end
		local function T(p: Vector3): Vector3 return Vector3.new(p.X * k, base + (p.Y - base) * k + dy, z + (p.Z - z) * k) end
		-- centre de la lentille (là où passe la ligne de visée)
		local c = Vector3.zero
		for _, l in ipairs(lensList) do c += l.p end
		c /= math.max(1, #lensList)
		local mkey = OPT3D_KEY[a]
		local info = mkey and AM.opticInfo(mkey)
		local done = false
		if info then
			local s = if mkey == "scope" then (if a == "sc4" then .88 else 1) else 1
			local mpos = Vector3.new(0, c.Y - info.cy * s, c.Z + info.lensY * s)
			done = opticMesh(ctx, mkey, function(v: Vector3) return T(v * s + mpos) end)
		end
		if not done then
			build(function(n, ww, hh, dd, m, x, y, zz, cyl, r)
				local p = T(Vector3.new(x, y, zz))
				if cyl == "z" then cylZ(ctx, n, ww * k, dd * k, m, p.X, p.Y, p.Z)
				elseif cyl == "tube" then tubeZ(ctx, n, ww * k, dd * k, m, p.Y, p.Z)
				elseif cyl == "y" then piece(ctx, n, Vector3.new(hh, ww, ww) * k, p, m, ROT_Y, Enum.PartType.Cylinder)
				else box(ctx, n, ww * k, hh * k, dd * k, m, p.X, p.Y, p.Z, r) end
			end)
		end
		for _, l in ipairs(lensList) do lens(ctx, l.w * k, l.h * k, T(l.p), l.round) end
		if retSize and retZ then
			local s2, c2 = retOf(a)
			reticle(ctx, retSize * k, T(Vector3.new(0, c.Y, retZ)), s2, c2)
		end
		sight = cy
	end

	for _, a in ipairs(todo) do
		if a == "sil" then
			local L, r = if pistol then .13 else .19, if pistol then .017 else .022
			local z = muzzle - L / 2 + .01
			cylZ(ctx, a, r, L, MAT.blk, 0, bore, z)
			cylZ(ctx, a, r * 1.08, .012, MAT.dark, 0, bore, z - L / 2 + .006); cylZ(ctx, a, r * 1.08, .012, MAT.dark, 0, bore, z + L / 2 - .006)
			for i = 0, 2 do cylZ(ctx, a, r * 1.03, .004, MAT.dark, 0, bore, z - L / 4 + i * L / 4) end
			muzzle -= L - .01
		elseif a == "comp" then
			local L, r = .05 * S, .016 * S
			local z = muzzle - L / 2 + .005
			cylZ(ctx, a, r, L, MAT.dark, 0, bore, z)
			for i = 0, 2 do box(ctx, a, r * .9, .004, .006, MAT.blk, 0, bore + r * .95, z - L / 2 + .01 + i * .014) end
			muzzle -= L - .005
		elseif a == "brake" then
			local L, r = .065 * S, .019 * S
			local z = muzzle - L / 2 + .005
			box(ctx, a, r * 2.2, r * 1.6, L, MAT.dark, 0, bore, z)
			for i = 0, 2 do box(ctx, a, r * 2.4, r * .5, .008, MAT.blk, 0, bore, z - L / 2 + .012 + i * .018) end
			muzzle -= L - .005
		elseif a == "flash" then
			local L, r = .045 * S, .014 * S
			local z = muzzle - L / 2 + .005
			cylZ(ctx, a, r * .95, L * .5, MAT.blk, 0, bore, z + L * .25)
			for i = 0, 3 do
				local an = i * math.pi / 2 + math.pi / 4
				box(ctx, a, .005, .005, L * .6, MAT.blk, math.cos(an) * r * .8, bore + math.sin(an) * r * .8, z - L * .2)
			end
			muzzle -= L - .005
		elseif a == "long" then
			local L, r = .09 * S, .012 * S
			local z = muzzle - L / 2 + .005
			cylZ(ctx, a, r, L, MAT.blk, 0, bore, z); cylZ(ctx, a, r * 1.5, .025, MAT.dark, 0, bore, z + L / 2 - .012)
			muzzle -= L - .005
		elseif a == "heavy" then
			local L, r = .07 * S, .016 * S
			local z = muzzle - L / 2 + .005
			cylZ(ctx, a, r, L, MAT.dark, 0, bore, z)
			for i = 0, 3 do cylZ(ctx, a, r * 1.15, .006, MAT.blk, 0, bore, z - L / 2 + .01 + i * .016) end
			muzzle -= L - .005
		elseif a == "reddot" then
			local z = if slot then slot.z else math.clamp(muzzle * .28, -.2, -.03)
			local base = if slot then slot.y else topR(pr, z - .04, z + .04) - .002
			local cy = base + .034
			optic(a, z, base, cy, z + .03, function(add)
				add(a, .03, .012, .07, MAT.dark, 0, base + .006, z)
				add(a, .012, .024, .05, MAT.blk, 0, base + .018, z)
				add(a, .024, 0, .05, MAT.blk, 0, cy, z, "tube")
				add(a, .026, 0, .008, MAT.blk, 0, cy, z - .025, "tube"); add(a, .026, 0, .008, MAT.blk, 0, cy, z + .025, "tube")
			end, { { p = Vector3.new(0, cy, z - .024), w = .045, h = .045, round = true }, { p = Vector3.new(0, cy, z - .023), w = 0, h = 0 } }, .018, z - .023)
		elseif a == "mini" then
			local z = if slot then slot.z else math.clamp(muzzle * (if pistol then .2 else .26), -.18, -.02)
			local base = if slot then slot.y else topR(pr, z - .03, z + .03) - .002
			local cy = base + .02
			optic(a, z, base, cy, z + .02, function(add)
				add(a, .026, .008, .04, MAT.dark, 0, base + .004, z + .004)
				add(a, .004, .026, .012, MAT.blk, -.013, cy - .002, z - .01); add(a, .004, .026, .012, MAT.blk, .013, cy - .002, z - .01)
				add(a, .03, .004, .014, MAT.blk, 0, cy + .012, z - .01)
			end, { { p = Vector3.new(0, cy, z - .016), w = .022, h = .022 }, { p = Vector3.new(0, cy, z - .017), w = 0, h = 0 } }, .012, z - .017)
		elseif a == "holo" then
			local z = if slot then slot.z else math.clamp(muzzle * .3, -.22, -.05)
			local base = if slot then slot.y else topR(pr, z - .05, z + .05)
			local h, cy = .04, base + .026
			optic(a, z, base, cy, z + .045, function(add)
				add(a, .034, .012, .085, MAT.dark, 0, base + .006, z)
				add(a, .005, h, .05, MAT.blk, -.02, cy + .003, z); add(a, .005, h, .05, MAT.blk, .02, cy + .003, z)
				add(a, .045, .006, .054, MAT.blk, 0, cy + h / 2 + .003, z)
				add(a, .045, .006, .034, MAT.dark, 0, base + .012, z + .016)
			end, { { p = Vector3.new(0, cy, z - .023), w = .035, h = .034 }, { p = Vector3.new(0, cy, z - .024), w = 0, h = 0 } }, .017, z - .024)
		elseif a == "acog" then
			local z = if slot then slot.z else math.clamp(muzzle * .3, -.24, -.06)
			local base = if slot then slot.y else topR(pr, z - .06, z + .06)
			local r, cy = .021, base + .036
			optic(a, z, base, cy, z + .075, function(add)
				add(a, .028, .016, .07, MAT.dark, 0, base + .008, z)
				add(a, r, 0, .12, MAT.tube, 0, cy, z, "tube")
				add(a, r * 1.2, 0, .03, MAT.blk, 0, cy, z - .07, "tube"); add(a, r * 1.08, 0, .02, MAT.blk, 0, cy, z + .065, "tube")
				add(a, .014, .014, .02, MAT.blk, 0, cy + r + .004, z); add(a, .014, .014, .02, MAT.blk, r + .004, cy, z)
			end, { { p = Vector3.new(0, cy, z - .05), w = r * 1.9, h = r * 1.9, round = true }, { p = Vector3.new(0, cy, z - .051), w = 0, h = 0 } }, .022, z - .051)
		elseif a == "sc4" or a == "sc6" or a == "sc8" or a == "sc10" then
			if w.cat ~= "sniper" then          -- le sniper garde sa lunette : seul le grossissement change
				local L, r = if a == "sc4" then .17 else .21, if a == "sc4" then .019 else .022
				local z = if slot then slot.z else math.clamp(muzzle * .32, -.26, -.08)
				local base = if slot then slot.y else topR(pr, z - L / 2, z + L / 2)
				local cy = base + r + .022
				optic(a, z, base, cy, z + L / 2 + .03, function(add)
					add(a, r * .8, 0, L, MAT.tube, 0, cy, z, "tube")
					add(a, r * 1.05, 0, .045, MAT.tube, 0, cy, z - L / 2 - .012, "tube"); add(a, r, 0, .035, MAT.tube, 0, cy, z + L / 2 + .01, "tube")
					add(a, r * .95, .03, 0, MAT.blk, 0, cy + r * .95, z, "y")
					add(a, .03, r * 1.9, r * 1.9, MAT.blk, r * .95, cy, z)
					for _, dz in ipairs({ -L * .28, L * .28 }) do add(a, .012, cy - base, .016, MAT.dark, 0, base + (cy - base) / 2, z + dz) end
				end, { { p = Vector3.new(0, cy, z - L / 2 - .034), w = r * 2.4, h = r * 2.4, round = true } })
			end
		elseif a == "grip" then
			local z = leftZ or -.25
			local b = under(pr, z)
			box(ctx, a, .022, .012, .04, MAT.dark, 0, b - .004, z)
			piece(ctx, a, Vector3.new(.075, .024, .024), Vector3.new(0, b - .045, z), MAT.rub, ROT_Y, Enum.PartType.Cylinder)
			left = Vector3.new(left.X, b - .012, z); leftV = true          -- main gauche autour de la poignée verticale
		elseif a == "angled" then
			local z = leftZ or -.25
			local b = under(pr, z)
			box(ctx, a, .02, .03, .07, MAT.dark, 0, b - .016, z + .005, CFrame.Angles(-.5, 0, 0))
			box(ctx, a, .022, .008, .075, MAT.blk, 0, b - .002, z)
			left = Vector3.new(left.X, b - .03, z + .01)
		elseif a == "laser" then
			local z = if pistol then math.clamp(muzzle * .55, -.12, -.03) elseif leftZ then leftZ - .06 else -.3
			local b = if pistol then under(pr, z, .06) else (under(pr, z) + bore) / 2
			local x = if pistol then 0 else .024
			local y = if pistol then b - .01 else b
			box(ctx, a, if pistol then .022 else .016, if pistol then .018 else .022, if pistol then .045 else .06, MAT.blk, x, y, z)
			local dz = if pistol then .023 else .031
			piece(ctx, "laserdot", Vector3.new(.0005, .008, .008), Vector3.new(x, y, z - dz), MAT.red, ROT_Z, Enum.PartType.Cylinder)
			local BL = if o.preview then .3 else 6
			local beam = cylZ(ctx, "beam", .0012, BL, MAT.red, x, y, z - .03 - BL / 2)
			beam.Transparency = .45; beam.Name = "Att_beam"
		elseif a == "ext" then
			if #mags > 0 then
				for _, m in ipairs(mags) do
					local off = m:GetAttribute("Offset") :: CFrame
					local h = m.Size.Y
					m.Size = Vector3.new(m.Size.X, h * 1.28, m.Size.Z)
					m:SetAttribute("Offset", off * CFrame.new(0, -h * .14, 0))
					m:SetAttribute("ExtMag", true)
				end
			elseif pistol then           -- pas de chargeur séparé : talon allongé sous la crosse du pistolet
				local zb, yb = 0, 1e9
				local z = -.03
				while z <= .06 do local bb = at(pr, pr.bot, z); if bb < yb then yb = bb; zb = z end; z += .005 end
				box(ctx, a, .03, .018, .05, MAT.dark, 0, yb - .007, zb)
			end
		elseif a == "fast" then
			if #mags > 0 then
				local c = Vector3.zero
				for _, m in ipairs(mags) do
					local tw = m:Clone()
					tw:SetAttribute("Offset", CFrame.new(Vector3.new(.03, .012, 0) * sc) * (m:GetAttribute("Offset") :: CFrame))
					tw:SetAttribute("Piece", "body"); tw.Name = "Att_twinmag"; tw.Parent = model
					c += (m:GetAttribute("Offset") :: CFrame).Position / sc
				end
				c /= #mags
				box(ctx, a, .05, .018, .04, MAT.tape, c.X + .015, c.Y, c.Z)
			end
		elseif a == "light" or a == "tac" then
			if not pistol then
				local z = pr.z1 - .012
				local t, b = at(pr, pr.top, z), at(pr, pr.bot, z)
				local y = (t + b) / 2
				if pr.z1 > .12 then          -- l'arme a déjà une crosse : on l'habille (plaque de couche, busc)
					local et, eb = slice(pr, pr.z1 - .015, pr.z1)
					local endT, endB = et or t, eb or b
					local ct = slice(pr, pr.z1 - .11, pr.z1 - .05)
					if a == "tac" then
						box(ctx, a, .036, endT - endB + .008, .026, MAT.rub, 0, (endT + endB) / 2, pr.z1 + .011)
						if ct then box(ctx, a, .028, .016, .06, MAT.tape, 0, ct + .006, pr.z1 - .08) end
					else
						box(ctx, a, .032, endT - endB + .004, .012, MAT.wood, 0, (endT + endB) / 2, pr.z1 + .005)
					end
				elseif a == "light" then
					box(ctx, a, .008, .008, .16, MAT.blk, 0, y + .02, z + .08); box(ctx, a, .008, .008, .17, MAT.blk, 0, y - .035, z + .085)
					box(ctx, a, .01, .075, .012, MAT.blk, 0, y - .006, z + .165); box(ctx, a, .014, .08, .02, MAT.rub, 0, y - .006, z + .18)
				else
					box(ctx, a, .03, .05, .14, MAT.dark, 0, y, z + .07); box(ctx, a, .034, .085, .03, MAT.rub, 0, y - .01, z + .15)
					box(ctx, a, .026, .012, .09, MAT.blk, 0, y + .03, z + .07)
				end
			end
		end
	end

	-- viseur intégré du modèle réaliste (holo du M4) : retiré quand une optique est montée (web : builtinOptic.visible)
	if real and A.optOf(list) then
		for _, c in ipairs(model:GetChildren()) do if c:GetAttribute("BuiltinOptic") then c:Destroy() end end
	end
	-- repères mis à jour : bout du canon, ligne de visée, main gauche
	local m = A.modsOf(list)
	local mz = grip:FindFirstChild("Muzzle") :: Attachment?
	if mz then mz.Position = Vector3.new(mz.Position.X, mz.Position.Y, muzzle * sc) end
	if sight then model:SetAttribute("SightY", sight * sc) end
	local lh = grip:FindFirstChild("LeftHand") :: Attachment?
	if lh and not pistol then lh.Position = left * sc end
	model:SetAttribute("LeftV", leftV)
	model:SetAttribute("NoFlash", m.noFlash)
	model:SetAttribute("Sil", m.sil)
	model:SetAttribute("Optic", A.optOf(list))
	model:SetAttribute("Attachments", table.concat(list, ","))
end

return AM
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">Attachments</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Attachments (ModuleScript, client + serveur)
-- Armurier façon Gunsmith (src/64b_gunsmith.js) et viseurs (src/64c_sights.js) du jeu web, à l'identique :
-- 6 emplacements, 5 accessoires max, déblocage par niveau ET éliminations avec l'arme, effets réels (multiplicateurs).
-- Sélection d'une arme : sel = { muzzle = "sil", optic = "reddot", ... } ; le serveur ne recopie dans l'attribut
-- Att_<arme> du joueur que les accessoires réellement débloqués (format « muzzle=sil,optic=reddot »).
local A = {}

A.MAX = 5
A.SLOTS = {
	{ id = "muzzle", n = "Bouche", ic = "◉" }, { id = "optic", n = "Optique", ic = "◎" }, { id = "barrel", n = "Canon", ic = "▬" },
	{ id = "under", n = "Sous-canon", ic = "▼" }, { id = "mag", n = "Chargeur", ic = "▮" }, { id = "stock", n = "Crosse", ic = "◣" },
}

-- m : multiplicateurs. rec = recul vertical, recH = horizontal, adsSpr = dispersion en visée, hip = à la hanche,
-- mob = vitesse de déplacement, ads = vitesse de visée, rng = portée efficace, rel = rechargement, mag = chargeur, snd = volume du tir
export type Att = { s: string, n: string, lv: number, d: string, m: { [string]: number }, sil: boolean?, noFlash: boolean?, ov: boolean? }
A.ATTS = {
	sil = { s = "muzzle", n = "Silencieux", lv = 1, d = "Tir discret : son très réduit, les ennemis vous entendent de moins loin, pas de flamme.", m = { snd = .35, rng = .9, ads = .95, dmg = .95 }, sil = true, noFlash = true },
	comp = { s = "muzzle", n = "Compensateur", lv = 2, d = "Canalise les gaz vers le haut : recul vertical réduit.", m = { rec = .85, ads = .97 } },
	brake = { s = "muzzle", n = "Frein de bouche", lv = 3, d = "Gaz sur les côtés : recul horizontal fortement réduit, tir plus bruyant.", m = { recH = .68, snd = 1.15 } },
	flash = { s = "muzzle", n = "Cache-flamme", lv = 1, d = "Masque la flamme de bouche, léger gain de stabilité.", m = { rec = .95 }, noFlash = true },
	reddot = { s = "optic", n = "Point rouge", lv = 1, d = "Visée nette et dégagée : dispersion en visée -25 %.", m = { adsSpr = .75, zoom = 1.55 } },
	holo = { s = "optic", n = "Holographique", lv = 2, d = "Réticule cerclé, grande fenêtre : dispersion en visée -20 %, visée plus rapide.", m = { adsSpr = .8, ads = 1.05, zoom = 1.5 } },
	mini = { s = "optic", n = "Mini réflex", lv = 1, d = "Petit viseur ouvert, très léger : visée plus rapide, dispersion en visée -15 %.", m = { adsSpr = .85, ads = 1.08, zoom = 1.42 } },
	acog = { s = "optic", n = "Lunette ×2,5", lv = 4, d = "Grossissement ×2,5 pour la moyenne distance. Visée plus lente.", m = { adsSpr = .7, ads = .85, zoom = 1.9 } },
	sc4 = { s = "optic", n = "Lunette ×4", lv = 3, d = "Lunette de précision ×4 : vue plein écran en visée, idéale à longue distance. Visée lente.", m = { adsSpr = .6, ads = .78, mob = .97, zoom = 2.4 }, ov = true },
	sc6 = { s = "optic", n = "Lunette ×6", lv = 5, d = "Grossissement ×6 : pour tenir une longue ligne. Visée lente.", m = { adsSpr = .55, ads = .72, mob = .96, zoom = 3.1 }, ov = true },
	sc8 = { s = "optic", n = "Lunette ×8", lv = 6, d = "Grossissement ×8 pour les très longues distances.", m = { ads = .95, zoom = 3.8 }, ov = true },
	sc10 = { s = "optic", n = "Lunette ×10", lv = 8, d = "Grossissement maximal ×10. Visée plus lente, champ de vision très étroit.", m = { ads = .88, zoom = 4.8 }, ov = true },
	long = { s = "barrel", n = "Canon long", lv = 3, d = "Portée efficace +30 %, balles plus précises. Arme plus lourde.", m = { rng = 1.3, hip = .92, adsSpr = .92, mob = .96, ads = .92 } },
	heavy = { s = "barrel", n = "Canon lourd", lv = 5, d = "Recul -12 %, portée +10 %. Mobilité réduite.", m = { rec = .88, recH = .9, rng = 1.1, mob = .93, ads = .9 } },
	grip = { s = "under", n = "Poignée verticale", lv = 2, d = "Meilleure tenue : recul -18 %.", m = { rec = .82, recH = .85, ads = .96 } },
	angled = { s = "under", n = "Poignée inclinée", lv = 3, d = "Épaulement rapide : vitesse de visée +20 %.", m = { ads = 1.2, rec = .94 } },
	laser = { s = "under", n = "Laser tactique", lv = 4, d = "Précision à la hanche +30 %, visée plus rapide. Le laser est visible.", m = { hip = .7, ads = 1.06 } },
	ext = { s = "mag", n = "Chargeur étendu", lv = 2, d = "+30 % de munitions par chargeur. Rechargement un peu plus lent.", m = { mag = 1.3, rel = 1.12, mob = .98 } },
	fast = { s = "mag", n = "Chargeurs jumelés", lv = 3, d = "Deux chargeurs scotchés : rechargement -30 %.", m = { rel = .7 } },
	light = { s = "stock", n = "Crosse squelette", lv = 4, d = "Mobilité +7 %, visée plus rapide. Un peu plus de recul.", m = { mob = 1.07, ads = 1.08, rec = 1.08 } },
	tac = { s = "stock", n = "Crosse tactique", lv = 5, d = "Crosse rembourrée : recul -10 %. Mobilité réduite.", m = { rec = .9, recH = .92, mob = .96 } },
} :: { [string]: Att }
-- ordre d'affichage (le web suit l'ordre de déclaration de ATTS)
A.ORDER = { "sil", "comp", "brake", "flash", "reddot", "holo", "mini", "acog", "sc4", "sc6", "sc8", "sc10", "long", "heavy", "grip", "angled", "laser", "ext", "fast", "light", "tac" }

-- emplacements autorisés par catégorie (nil = tous les accessoires de l'emplacement)
A.CAT = {
	pistol = { muzzle = { "sil", "comp", "flash" }, optic = { "reddot" }, under = { "laser" }, mag = { "ext", "fast" } },
	shotgun = { muzzle = { "brake", "flash" }, optic = { "reddot", "holo" }, barrel = { "long" }, under = { "grip", "laser" }, mag = { "ext", "fast" }, stock = { "light", "tac" } },
	sniper = { muzzle = { "sil", "brake", "flash" }, barrel = { "long", "heavy" }, under = { "grip", "laser" }, mag = { "ext", "fast" }, stock = { "light", "tac" } },
} :: { [string]: { [string]: { string } } }
-- viseurs proposés par catégorie (« aucun » = mires d'origine, ou lunette d'origine des snipers)
A.OPTIC_CAT = {
	pistol = { "mini", "reddot", "holo" }, smg = { "mini", "reddot", "holo", "acog" }, shotgun = { "mini", "reddot", "holo" },
	rifle = { "reddot", "holo", "acog", "sc4", "sc6" }, lmg = { "reddot", "holo", "acog", "sc4" }, sniper = { "sc4", "sc6", "sc8", "sc10" },
} :: { [string]: { string } }

-- déblocage réaliste : niveau du joueur ET éliminations avec CETTE arme
local REQ = { [1] = { 3, 15 }, [2] = { 6, 40 }, [3] = { 9, 80 }, [4] = { 12, 130 }, [5] = { 15, 200 }, [6] = { 18, 280 }, [8] = { 24, 450 } }
function A.req(a: string): (number, number)
	local d = A.ATTS[a]
	local r = REQ[d.lv]
	if r then return r[1], r[2] end
	return d.lv * 3, d.lv * 55
end

-- web : W[k] (stats de l'arme) ; données qui manquent à Config.WEAPONS : chute des dégâts (fo, fr, fmin)
A.FALLOFF = {
	glock = { 15, .012 }, usp = { 15, .012 }, p250 = { 15, .012 }, fiveseven = { 18, .011 }, deagle = { 20, .01 },
	mac10 = { 10, .014 }, mp9 = { 12, .012 }, ump = { 15, .011 }, p90 = { 14, .012 },
	nova = { 5, .07, .1 }, sawedoff = { 4, .09, .08 }, xm = { 5, .07, .1 },
	galil = { 40, .004 }, famas = { 40, .004 }, ak = { 50, .003 }, m4 = { 50, .003 }, sg553 = { 50, .003 }, aug = { 50, .003 },
	ssg = { 90, .001 }, awp = { 120, .001 }, scar = { 90, .001 }, negev = { 40, .004 }, m249 = { 45, .003 },
} :: { [string]: { number } }
A.RUN = 5.2                                         -- vitesse de course du web (m/s)
A.ADS_ZOOM = { pistol = 1.2, smg = 1.3, shotgun = 1.18, rifle = 1.4, lmg = 1.3, sniper = 1, melee = 1 } :: { [string]: number }

local Config = require(script.Parent.Config)
local function W(k: string): any return Config.WEAPONS[k] end

export type Sel = { [string]: string }

function A.allowed(k: string): { [string]: { string } }
	local w = W(k)
	local out = {}
	if not w or w.melee then return out end
	local lim = A.CAT[w.cat]
	for _, s in ipairs(A.SLOTS) do
		local l: { string }
		if s.id == "optic" and A.OPTIC_CAT[w.cat] then l = A.OPTIC_CAT[w.cat]
		elseif lim == nil then
			l = {}
			for _, a in ipairs(A.ORDER) do if A.ATTS[a].s == s.id then table.insert(l, a) end end
		else l = lim[s.id] or {} end
		if #l > 0 then out[s.id] = l end
	end
	return out
end

-- progression : { level = n, kills = { [arme] = n } } (profil côté serveur, GetProfile côté client)
export type Prog = { level: number, kills: { [string]: number } }
function A.isOpen(k: string, a: string, p: Prog?): boolean
	if not p then return false end
	local lv, n = A.req(a)
	return p.level >= lv and (p.kills[k] or 0) >= n
end
function A.lockText(k: string, a: string, p: Prog?): string
	local lv, n = A.req(a)
	local have = p and (p.kills[k] or 0) or 0
	local o = {}
	if not p or p.level < lv then table.insert(o, "niveau " .. lv) end
	if have < n then table.insert(o, n .. " éliminations avec cette arme (" .. have .. "/" .. n .. ")") end
	return if #o > 0 then "Requis : " .. table.concat(o, " + ") else ""
end

-- accessoires actifs (respecte la catégorie ; p = nil : pas de contrôle du déblocage, déjà fait par le serveur)
function A.list(k: string, sel: Sel?, p: Prog?, skipLock: boolean?): { string }
	local ok, out = A.allowed(k), {}
	if not sel then return out end
	for _, s in ipairs(A.SLOTS) do
		local a = sel[s.id]
		if a and A.ATTS[a] and A.ATTS[a].s == s.id and ok[s.id] and table.find(ok[s.id], a) and (skipLock or A.isOpen(k, a, p)) then table.insert(out, a) end
	end
	return out
end
function A.count(sel: Sel): number
	local n = 0
	for _ in pairs(sel) do n += 1 end
	return n
end

export type Mods = { dmg: number, rec: number, recH: number, adsSpr: number, hip: number, mob: number, ads: number, rng: number, rel: number, mag: number, snd: number, zoom: number, sil: boolean, noFlash: boolean }
function A.neutral(): Mods
	return { dmg = 1, rec = 1, recH = 1, adsSpr = 1, hip = 1, mob = 1, ads = 1, rng = 1, rel = 1, mag = 1, snd = 1, zoom = 0, sil = false, noFlash = false }
end
function A.modsOf(list: { string }): Mods
	local r: any = A.neutral()
	for _, a in ipairs(list) do
		local d = A.ATTS[a]
		if d then
			for x, v in pairs(d.m) do if x == "zoom" then r.zoom = v else r[x] *= v end end
			if d.sil then r.sil = true end
			if d.noFlash then r.noFlash = true end
		end
	end
	return r
end

-- ---------- attributs Att_<arme> ----------
function A.encode(sel: Sel): string
	local o = {}
	for _, s in ipairs(A.SLOTS) do if sel[s.id] then table.insert(o, s.id .. "=" .. sel[s.id]) end end
	return table.concat(o, ",")
end
function A.decode(str: any): Sel
	local sel: Sel = {}
	if typeof(str) ~= "string" then return sel end
	for slot, a in string.gmatch(str, "(%w+)=(%w+)") do sel[slot :: string] = a :: string end
	return sel
end
-- accessoires actifs d'un joueur (ou d'une poignée HeldWeapon) d'après son attribut, déjà filtré par le serveur
function A.activeOf(inst: Instance?, k: string): { string }
	if not inst then return {} end
	return A.list(k, A.decode(inst:GetAttribute("Att_" .. k)), nil, true)
end
function A.optOf(list: { string }): string?
	for _, a in ipairs(list) do if A.ATTS[a].s == "optic" then return a end end
	return nil
end

-- ---------- viseurs ----------
-- visée plein écran ? (lunettes, ou sniper sans optique)
function A.sightOv(k: string, list: { string }): boolean
	local o = A.optOf(list)
	if o then return A.ATTS[o].ov == true end
	local w = W(k)
	return w ~= nil and w.cat == "sniper"
end
function A.sightZoom(k: string, m: Mods): number
	local w = W(k)
	if m.zoom > 0 then return m.zoom end
	if w and (w.zoom or 0) > 0 then return w.zoom end
	return A.ADS_ZOOM[w and w.cat or "rifle"] or 1.1
end
function A.opticNone(k: string): string
	local w = W(k)
	return if w and w.cat == "sniper" then "Lunette d'origine" else "Mires d'origine"
end
function A.zoomText(k: string, o: string?): string
	if o then
		if o:sub(1, 2) == "sc" then return "×" .. o:sub(3) end
		return if o == "acog" then "×2,5" else ""
	end
	local w = W(k)
	return if w and w.cat == "sniper" then "×" .. math.floor(w.zoom * 2 + 0.5) else ""
end

A.RET_SHAPES = { { "dot", "Point" }, { "circle", "Cercle" }, { "cross", "Croix" }, { "chevron", "Chevron" }, { "duplex", "Duplex" }, { "mildot", "Mil-dot" } }
A.RET_COLS = { "#ff2a3a", "#3dff6e", "#33e0ff", "#ffe03a", "#ff4fd8", "#ffffff", "#101010" }
-- « scope » = lunette d'origine des snipers
A.RET_DEF = {
	reddot = { s = "dot", c = "#ff2a3a" }, mini = { s = "dot", c = "#ff2a3a" }, holo = { s = "circle", c = "#ff2a3a" }, acog = { s = "chevron", c = "#ff3a2a" },
	sc4 = { s = "duplex", c = "#101010" }, sc6 = { s = "duplex", c = "#101010" }, sc8 = { s = "mildot", c = "#101010" }, sc10 = { s = "mildot", c = "#101010" },
	scope = { s = "cross", c = "#101010" },
} :: { [string]: { s: string, c: string } }
-- réticule choisi : attribut Ret_<optique> = "forme|#couleur" sur le joueur
function A.retOf(o: string, inst: Instance?): (string, string)
	local d = A.RET_DEF[o] or A.RET_DEF.reddot
	local s, c = d.s, d.c
	local raw = inst and inst:GetAttribute("Ret_" .. o)
	if typeof(raw) == "string" then
		local s2, c2 = string.match(raw, "^(%w+)|(#%x+)$")
		if s2 then s = s2 end
		if c2 then c = c2 end
	end
	return s, c
end
function A.validRet(shape: any, col: any): boolean
	local okS = false
	for _, r in ipairs(A.RET_SHAPES) do if r[1] == shape then okS = true end end
	return okS and typeof(col) == "string" and table.find(A.RET_COLS, col) ~= nil
end

-- ---------- statistiques de l'armurier (gsStatsHTML du web) ----------
-- renvoie { libellé, fonction(mods) -> valeur, max, format, sens } ; sens 1 = plus c'est mieux, -1 = moins, 0 = neutre
function A.statRows(k: string): { { any } }
	local w = W(k)
	local fo = A.FALLOFF[k] and A.FALLOFF[k][1] or 40
	local overlay = w.cat == "sniper"
	local function cl(x: number): number return math.clamp(x, 0, 100) end
	local function pct(v: number) return math.floor(v + 0.5) .. "%" end
	local rows: { { any } } = {
		{ "DÉGÂTS", function(m: Mods) return w.dmg * (w.pellets or 1) * m.dmg end, 150, function(v: number) return math.floor(v + 0.5) .. (if (w.pellets or 1) > 1 then "×" else "") end, 1 },
		{ "CADENCE", function(_m: Mods) return w.rpm end, 1000, function(v: number) return tostring(math.floor(v + 0.5)) end, 1 },
		{ "CHARGEUR", function(m: Mods) return math.ceil(w.mag * m.mag) end, 150, function(v: number) return tostring(v) end, 1 },
		{ "PRÉCISION", function(m: Mods) return cl(100 - w.spread * 14 * m.hip) end, 100, pct, 1 },
		{ "VISÉE", function(m: Mods) return cl(100 - (w.spread * 14 * m.adsSpr * .6) - (1 - m.ads) * 30 - (if overlay then 15 else 0)) end, 100, pct, 1 },
		{ "CONTRÔLE", function(m: Mods) return cl(100 - w.recoil * 40 * (m.rec * .7 + m.recH * .3)) end, 100, pct, 1 },
		{ "PORTÉE", function(m: Mods) return fo * m.rng * 1.2 end, 120, function(v: number) return math.floor(v + 0.5) .. " m" end, 1 },
		{ "MOBILITÉ", function(m: Mods) return A.RUN * w.speed * m.mob end, 6.5, function(v: number) return string.format("%.1f m/s", v) end, 1 },
		{ "RECHARGEMENT", function(m: Mods) return w.reload * m.rel end, 5, function(v: number) return string.format("%.1f s", v) end, -1 },
		{ "PRIX", function(_m: Mods) return w.price end, 5200, function(v: number) return "$" .. v end, 0 },
	}
	return rows
end

return A
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="8">
        <Properties>
          <string name="Name">Base64</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Base64 (ModuleScript)
-- Décode le base64 des données générées par les outils (armes 3D, peintures des skins) en buffer.
local B64: { [number]: number } = {}
do
	local chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
	for i = 1, #chars do B64[string.byte(chars, i)] = i - 1 end
end

return function(s: string): buffer
	local n = #s
	local pad = (if string.sub(s, -2) == "==" then 2 elseif string.sub(s, -1) == "=" then 1 else 0)
	local out = buffer.create(n // 4 * 3 - pad)
	local len = buffer.len(out)
	local o = 0
	for i = 1, n, 4 do
		local a, b, c, d = string.byte(s, i, i + 3)
		local v = bit32.bor(bit32.lshift(B64[a], 18), bit32.lshift(B64[b], 12), bit32.lshift(B64[c] or 0, 6), B64[d] or 0)
		buffer.writeu8(out, o, bit32.rshift(v, 16)); o += 1
		if o < len then buffer.writeu8(out, o, bit32.band(bit32.rshift(v, 8), 255)); o += 1 end
		if o < len then buffer.writeu8(out, o, bit32.band(v, 255)); o += 1 end
	end
	return out
end
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="9">
        <Properties>
          <string name="Name">ClientState</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ClientState (ModuleScript, côté client)
-- État partagé entre les LocalScripts d'un même joueur (arme, déplacements, viewmodel) : chaque script qui fait
-- require reçoit la même table. Rien ici ne part au serveur.
local shot = Instance.new("BindableEvent")
local draw = Instance.new("BindableEvent")
local reload = Instance.new("BindableEvent")

return {
	-- arme (écrit par WeaponController)
	weapon = nil :: string?, firing = false, mag = 0, reserve = 0, aiming = false, reloading = false, reloadStart = 0, reloadEmpty = false,
	reloadDur = 0,                           -- durée réelle de la recharge en cours (serveur : accessoires et atouts compris)
	inspectStart = -1,                       -- os.clock() du début de l'inspection (touche V), -1 = pas d'inspection
	throwStart = -9,                         -- os.clock() du dernier lancer de grenade / pose de mine (GrenadeController)
	adsT = 0,                                -- visée lissée 0..1 (WeaponController, vitesse de visée de l'armurier)
	shot = shot, onShot = shot.Event,        -- (clé) à chaque tir local
	draw = draw, onDraw = draw.Event,        -- (clé) arme sortie
	reload = reload, onReload = reload.Event,-- (clé, à vide) début de recharge
	-- déplacements (écrit par MovementController)
	sprint = false, tactical = false, slide = false, crouch = false, mantle = false,
	mantleT = 0, mantleDur = 0, mantleHigh = false,  -- escalade : os.clock() du début, durée, rebord haut (grimper) ou bas (enjamber)
	tacE = 1,                                -- jauge du sprint tactique 0..1
	fireBlockedUntil = 0,                    -- sortie de sprint : on ne tire pas tout de suite (comme sur le web)
	drinkUntil = 0, drinkHideUntil = 0,      -- boisson d'atout (PerkDrinkController) : ni tir ni visée / arme rangée jusqu'à ces os.clock()
	speed = 0, grounded = true, vy = 0,
	stepAt = 0,                              -- os.clock() de notre dernier pas entendu (AmbienceController) : l'arme et la tête s'y calent
	muzzle = nil :: Vector3?,                -- bout du canon du viewmodel (point de départ des traceurs)
	-- kill-cam (écrit par KillcamController) : { key, skin, camo } de l'arme du tueur, nil hors kill-cam
	kc = nil :: any,
	spectate = nil :: Model?,                -- soldat suivi en spectateur (SpectateController), nil sinon
	onSkin = nil :: (() -> ())?,             -- repeint l'arme du viewmodel (ViewmodelController)
	-- menu principal (MainMenu) : réglages lus par WeaponController, fenêtres des autres interfaces
	opt = { fov = 70, sens = 1, aimSens = 1, wsens = 1,  -- champ de vision, sensibilité, multiplicateur en visée, réglage par arme
		invertY = false,                     -- axe vertical inversé (à lire par la caméra : WeaponController)
		xhColor = Color3.new(1, 1, 1),       -- couleur du viseur (à lire par HudController)
		xhStyle = "dot",                     -- forme du viseur : "dot", "cross", "circle", "none" (à lire par HudController)
		showFps = false, showPing = false,   -- compteurs en haut à droite (PauseMenu)
		realGuns = true,                     -- armes réalistes sans skin (à lire par WeaponModels.realAllowed)
	},
	menuOpen = false,
	panels = {} :: { [string]: () -> () },   -- ouvre la fenêtre d'une autre interface (shop, gifts, vip, codes, group, loadout)
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CommunityConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/CommunityConfig (ModuleScript)
-- Réglages des ajouts « façon Roblox » : lobby jouable, duels 1v1 / 2v2, classement géant, groupe Roblox.
-- Partagé client / serveur. Les CODES PROMO ne sont PAS ici (le client pourrait les lire) : voir ServerScriptService/CodeList.
local CommunityConfig = {}

-- ---------- Lobby ----------
-- true = les joueurs arrivent dans le lobby et rejoignent le match à mort par le portail (ou le bouton « Jouer »).
-- false = ancien fonctionnement : tout le monde va directement dans le match.
CommunityConfig.LOBBY_ENABLED = true

CommunityConfig.LOBBY = {
	origin = Vector3.new(0, 0, -700),   -- loin de la carte (les bots ne voient qu'à 160 studs)
	size = 240,                         -- côté du sol en studs
	-- armes prêtées dans le lobby pour le stand de tir (personne ne peut blesser personne dans le lobby)
	loadout = { "galil", "glock", "knife" },
	range = {
		duration = 30,                  -- défi « 30 secondes » au stand de tir
		visibleTargets = 3,
		firstReward = 20,               -- cibles à toucher pour la récompense (une seule fois)
		rewardCoins = 50,
	},
	parkour = {
		rewardCoins = 75,               -- premier parcours terminé (une seule fois)
	},
}

-- ---------- Duels façon Rivals ----------
CommunityConfig.DUEL = {
	roundsToWin = 5,                    -- premier à 5 manches
	roundTime = 60,                     -- au-delà, l'équipe qui a le plus de vie gagne la manche
	countdown = 3,
	-- arme principale : celle choisie au menu de chargement si elle existe, sinon celle-ci
	defaultPrimary = "galil",
	secondary = "deagle",
	startElo = 1000,
	eloK = 32,
	-- plateformes dans le lobby : chacune lance un duel quand elle est pleine
	pads = {
		{ id = "1v1", size = 1, stake = 0, name = "Duel 1v1" },
		{ id = "1v1s", size = 1, stake = 100, name = "Duel 1v1 · mise" },
		{ id = "2v2", size = 2, stake = 0, name = "Duel 2v2" },
		{ id = "2v2s", size = 2, stake = 100, name = "Duel 2v2 · mise" },
	},
	arenaOrigin = Vector3.new(2000, 0, 2000),   -- les arènes sont construites ici, espacées de 400 studs
}

-- Rangs de duel (affichés à côté du classement)
CommunityConfig.DUEL_RANKS = {
	{ elo = 0, name = "Bronze", color = Color3.fromRGB(205, 127, 50) },
	{ elo = 1100, name = "Argent", color = Color3.fromRGB(200, 205, 215) },
	{ elo = 1250, name = "Or", color = Color3.fromRGB(255, 200, 60) },
	{ elo = 1400, name = "Platine", color = Color3.fromRGB(90, 220, 220) },
	{ elo = 1600, name = "Diamant", color = Color3.fromRGB(120, 160, 255) },
	{ elo = 1850, name = "Champion", color = Color3.fromRGB(255, 80, 120) },
}
function CommunityConfig.duelRank(elo: number)
	local best = CommunityConfig.DUEL_RANKS[1]
	for _, r in ipairs(CommunityConfig.DUEL_RANKS) do if elo >= r.elo then best = r end end
	return best
end

-- ---------- Classement géant ----------
CommunityConfig.LEADERBOARD = {
	refresh = 120,                      -- secondes entre deux mises à jour du panneau
	top = 10,
}
-- Semaine courante (lundi 00:00 UTC) : sert de nom au classement hebdomadaire
function CommunityConfig.weekId(t: number?): number
	return math.floor(((t or os.time()) - 4 * 86400) / 604800)   -- le 1er janvier 1970 était un jeudi
end
function CommunityConfig.secondsToNextWeek(t: number?): number
	local now = t or os.time()
	return (CommunityConfig.weekId(now) + 1) * 604800 + 4 * 86400 - now
end

-- ---------- Groupe Roblox ----------
-- Crée le groupe sur roblox.com puis colle son identifiant ici (0 = groupe pas encore créé, bouton désactivé).
CommunityConfig.GROUP = {
	id = 0,
	reward = { coins = 200, killfx = "spirit" },   -- donné une seule fois
	-- rappel du « J'aime » : Roblox ne donne aucun moyen de vérifier qu'un joueur a mis un like,
	-- on se contente donc d'un petit rappel, sans récompense (impossible à contrôler, donc facile à tricher).
	likeReminderAfter = 600,            -- secondes de jeu avant le rappel (une fois par session)
}

return CommunityConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">Config</string>
          <string name="Source"><![CDATA[--!strict
-- Config partagée client + serveur (ReplicatedStorage/Shared/Config)
-- Reprend exactement les valeurs du prototype web pour garder le même "feeling".
local Config = {}

Config.STUDS_PER_METER = 3.571      -- 1 stud ≈ 0.28 m
Config.CELL = 2                     -- 1 case de la grille = 2 mètres
Config.TEAM_SIZE = 5                -- 5 contre 5
Config.ROUND_TIME = 100
Config.FREEZE_TIME = 12
Config.BOMB_TIME = 40
Config.PLANT_TIME = 3.2
Config.DEFUSE_TIME = 5
Config.WIN_ROUNDS = 7
Config.START_MONEY = 800
Config.MAX_MONEY = 16000
Config.SHIELD_MAX = 50

Config.RARITY = {
	{ id = "common", name = "Commun", color = Color3.fromRGB(154, 166, 184) },
	{ id = "rare", name = "Rare", color = Color3.fromRGB(74, 163, 255) },
	{ id = "epic", name = "Épique", color = Color3.fromRGB(179, 107, 255) },
	{ id = "legend", name = "Légendaire", color = Color3.fromRGB(255, 185, 56) },
	{ id = "excl", name = "Exclusif", color = Color3.fromRGB(255, 61, 240) },   -- objets payants en Robux, jamais dans les caisses
}

-- Probabilités affichées au joueur (obligatoire pour les objets aléatoires payants sur Roblox)
Config.BOXES = {
	std = { name = "Caisse Standard", coins = 1200, weights = { 70, 24, 5, 1 } },
	prem = { name = "Caisse Premium", coins = 3500, weights = { 30, 45, 20, 5 } },
}
Config.PITY = { epic = 10, legend = 60 }          -- Épique garanti toutes les 10 ouvertures, Légendaire toutes les 60
Config.DUPLICATE_VALUE = { 0, 40, 120, 350 }       -- pièces rendues pour un doublon, par rareté

Config.DAILY = {                                  -- série de 7 jours
	{ coins = 40 }, { coins = 60 }, { coins = 80 }, { dance = "disco", coins = 40 },
	{ coins = 120 }, { coins = 150 }, { box = "std", coins = 200 },
}

Config.DANCES = {                                 -- remplace animationId par tes propres animations (Animation Editor)
	wave = { name = "Salut", rarity = 1, animationId = "rbxassetid://0", length = 3 },
	clap = { name = "Applaudissements", rarity = 1, animationId = "rbxassetid://0", length = 3.4 },
	disco = { name = "Disco", rarity = 2, animationId = "rbxassetid://0", length = 4 },
	robot = { name = "Robot", rarity = 2, animationId = "rbxassetid://0", length = 4 },
	floss = { name = "Floss", rarity = 3, animationId = "rbxassetid://0", length = 4 },
	twist = { name = "Toupie", rarity = 3, animationId = "rbxassetid://0", length = 3.4 },
	moonwalk = { name = "Moonwalk", rarity = 4, animationId = "rbxassetid://0", length = 4.2 },
	break_ = { name = "Breakdance", rarity = 4, animationId = "rbxassetid://0", length = 4 },
}

Config.SKINS = {                                  -- rarity 1..4 ; rarity 1 = gratuit pour toutes les armes ; pattern = nom de la peinture du prototype
	{ name = "Défaut", rarity = 1, pattern = "" },
	{ name = "Noir mat", rarity = 1, pattern = "" },
	{ name = "Or royal", rarity = 4, pattern = "goldleaf" },
	{ name = "Rouge sang", rarity = 2, pattern = "bloodfade" },
	{ name = "Bleu néon", rarity = 3, pattern = "neonlines" },
	{ name = "Arctique", rarity = 1, pattern = "frost" },
	{ name = "Violet nacré", rarity = 3, pattern = "pearl" },
	{ name = "Cœurs", rarity = 2, pattern = "hearts" },
	{ name = "Camo forêt", rarity = 1, pattern = "camoForest" },
	{ name = "Camo désert", rarity = 1, pattern = "camoDesert" },
	{ name = "Carbone", rarity = 2, pattern = "hex" },
	{ name = "Vapeur", rarity = 2, pattern = "brass" },
	{ name = "Dragon", rarity = 3, pattern = "flame" },
	{ name = "Galaxie", rarity = 4, pattern = "galaxy" },
	{ name = "Tigre", rarity = 2, pattern = "tiger" },
	{ name = "Toxique", rarity = 3, pattern = "toxic" },
	{ name = "Circuit", rarity = 3, pattern = "circuit" },
	{ name = "Marbre", rarity = 3, pattern = "marble" },
	{ name = "Damas", rarity = 2, pattern = "damascus" },
	{ name = "Bois précieux", rarity = 2, pattern = "burl" },
	{ name = "Coucher de soleil", rarity = 2, pattern = "sunset" },
	{ name = "Course", rarity = 2, pattern = "racing" },
	{ name = "Danger", rarity = 1, pattern = "hazard" },
