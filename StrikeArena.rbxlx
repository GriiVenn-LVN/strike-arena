	[39] = { name = "Arcade", tex = "pixel8", fin = "gloss", a = "#0a0612", b = nil, tint = nil, glow = true },  -- web 38
	[40] = { name = "Orbite", tex = "cs_orbit", fin = "gloss", a = "#1b1b1f", b = nil, tint = nil, glow = false },  -- web 39
