	[46] = { name = "Trempe", tex = "cs_hardened", fin = "anod", a = "#3a3a40", b = nil, tint = nil, glow = false },  -- web 45
	[47] = { name = "Doppler", tex = "cs_doppler", fin = "chrome", a = "#140818", b = nil, tint = nil, glow = false },  -- web 46
