      <Item class="ModuleScript" referent="409">
        <Properties>
          <string name="Name">WeaponModels</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/WeaponModels (ModuleScript, côté client)
-- Fabrique les vraies armes du jeu web (modèles Low-Poly de TastyTony, CC BY) à partir des données de WeaponMeshes,
-- avec l'API EditableMesh : aucun fichier à importer dans Studio.
-- Il faut cocher « Allow Mesh / Image APIs » (Game Settings → Security) ; sinon une silhouette en blocs est utilisée.
--
-- build(clé, échelle) renvoie un Model :
--   PrimaryPart « Grip » = la poignée (main droite), l'arme pointe vers -Z, le haut vers +Y ;
--   chaque pièce porte l'attribut Piece = "body" | "bolt" | "mag" (le chargeur et la culasse bougent dans les animations) ;
--   attachments « Muzzle » (bout du canon) et « LeftHand » (main gauche) sur Grip.
-- Armes réalistes (AK, M4, AWP, Desert Eagle : WeaponReal) : même repère, mêmes attributs (Piece, Role = "real",
-- Offset) ; setVariant(modèle, réaliste) échange les pièces d'un modèle déjà fabriqué (SkinPaint.apply : sans skin,
-- réaliste si Réglages › Armes = Réalistes et si les assets sont envoyés ; avec un skin, stylisé).
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Info = require(ReplicatedStorage.Shared.WeaponInfo)

local WeaponModels = {}
WeaponModels.meshApi = true            -- passe à false si Roblox refuse EditableMesh (réglage non coché)
WeaponModels.Q = 30000                 -- doit correspondre à tools/export_weapons_lua.py

-- apparence par rôle de matériau (même découpage que glbRole() du jeu web)
local LOOK = {
	body = { color = Color3.fromRGB(38, 40, 45), material = Enum.Material.Metal },
	acc = { color = Color3.fromRGB(62, 64, 69), material = Enum.Material.SmoothPlastic },
	steel = { color = Color3.fromRGB(150, 153, 160), material = Enum.Material.Metal },
	wood = { color = Color3.fromRGB(122, 74, 42), material = Enum.Material.Wood },
}

local decode = require(ReplicatedStorage.Shared.Base64)
local MeshStore = require(ReplicatedStorage.Shared.MeshStore)

-- répétitions de la peinture par mètre d'arme (web : 1/0,78 × 1,35)
local UV_SCALE = 1.35 / 0.78

local function plain(name: string, size: Vector3, color: Color3, material: Enum.Material, shape: Enum.PartType?): Part
	local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = color; p.Material = material
	if shape then p.Shape = shape end
	p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false; p.Anchored = true
	return p
end

-- ---------- une pièce en EditableMesh ----------
-- chaque pièce est construite une seule fois (taille 1) puis copiée et agrandie : bien moins de mémoire
-- (Roblox limite fortement la mémoire des EditableMesh côté joueur)
-- La taille finale vient de la boîte englobante des sommets (size), pas de mp.Size : si Roblox a arrondi ou borné
-- la taille du MeshPart à sa création (axe très fin), la pièce n'est plus écrasée ni étirée sur cet axe.
local MIN_SIZE = 0.001                 -- plus petite taille de pièce acceptée par Roblox, par axe
local pieceCache: { [string]: { mp: MeshPart, center: Vector3, size: Vector3 } } = {}
local buildPiece: (g: any, id: string) -> (MeshPart?, Vector3, Vector3)
local function meshPiece(g: any, id: string, scale: number): (MeshPart?, Vector3)
	local c = pieceCache[id]
	if not c then
		local mp0, center0, size0 = buildPiece(g, id)
		if not mp0 then return nil, Vector3.zero end
		-- faces visibles des deux côtés (pièces fines à une seule face, normales mal orientées dans le modèle d'origine)
		pcall(function() (mp0 :: any).DoubleSided = true end)
		c = { mp = mp0, center = center0, size = size0 }
		pieceCache[id] = c
	end
	local mp = c.mp:Clone()
	mp.Size = (c.size * scale):Max(Vector3.one * MIN_SIZE)
	return mp, c.center * scale
end
buildPiece = function(g: any, id: string): (MeshPart?, Vector3, Vector3)
	local raw = decode(g.data)
	local k = 1 / WeaponModels.Q
	local uvK = UV_SCALE                           -- studs -> mètres -> répétitions de la peinture
	local pos = table.create(g.nv)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for i = 0, g.nv - 1 do
		local v = Vector3.new(buffer.readi16(raw, i * 6), buffer.readi16(raw, i * 6 + 2), buffer.readi16(raw, i * 6 + 4)) * k
		pos[i + 1] = v; lo = lo:Min(v); hi = hi:Max(v)
	end
	local center = (lo + hi) / 2
	local mp = MeshStore.meshPart("w:" .. id .. "/" .. g.nv .. "/" .. g.nt, function()
		local em = AssetService:CreateEditableMesh({ FixedSize = false })
		if not em then error("mémoire des maillages pleine (CreateEditableMesh a renvoyé nil)") end
		local ids = table.create(g.nv)
		for i, v in ipairs(pos) do ids[i] = em:AddVertex(v - center) end
		local base = g.nv * 6
		for t = 0, g.nt - 1 do
			local a = buffer.readu16(raw, base + t * 6) + 1
			local b = buffer.readu16(raw, base + t * 6 + 2) + 1
			local c = buffer.readu16(raw, base + t * 6 + 4) + 1
			local face = em:AddTriangle(ids[a], ids[b], ids[c])
			local n = (pos[b] - pos[a]):Cross(pos[c] - pos[a])
			if n.Magnitude > 1e-9 then
				local nid = em:AddNormal(n.Unit)
				em:SetFaceNormals(face, { nid, nid, nid })      -- normales par face : rendu « low-poly » net comme sur le web
			end
			-- coordonnées de texture pour les skins : projection continue sur toute l'arme, comme applyPlanarUV() du web
			-- (côtés en z-y, dessus et dessous en z-x, avant et arrière en x-y)
			local ax, ay, az = math.abs(n.X), math.abs(n.Y), math.abs(n.Z)
			local uvs = table.create(3)
			for j, v in ipairs({ pos[a], pos[b], pos[c] }) do
				local m = v * uvK
				local u, w
				if ax >= ay and ax >= az then u, w = -m.Z, m.Y
				elseif ay >= az then u, w = -m.Z, m.X + 0.37 * UV_SCALE
				else u, w = m.X, m.Y end
				uvs[j] = em:AddUV(Vector2.new(u + 0.5, 0.5 - w))
			end
			em:SetFaceUVs(face, uvs)
		end
		return em
	end, MeshStore.PRECISE)
	return mp, center, hi - lo
end

-- ---------- silhouette en blocs (si EditableMesh est refusé) ----------
local function blockGun(model: Model, grip: BasePart, key: string, scale: number)
	local inf = Info[key]
	local w = Config.WEAPONS[key]
	local back, front = inf.min[3] * scale, inf.muzzle * scale
	local h = math.max(inf.sight, 0.04) * scale
	local dark = LOOK.body.color
	local function add(name: string, piece: string, size: Vector3, at: Vector3, color: Color3?, shape: Enum.PartType?)
		local p = plain(name, size, color or dark, Enum.Material.Metal, shape)
		p:SetAttribute("Piece", piece); p:SetAttribute("Offset", CFrame.new(at))
		p:SetAttribute("Role", if color == LOOK.steel.color then "steel" elseif color == LOOK.wood.color then "wood" else "body")
		p.CFrame = grip.CFrame * CFrame.new(at); p.Parent = model
	end
	local recvLen = (back - front) * 0.55
	add("Receiver", "body", Vector3.new(0.05 * scale, h * 1.1, recvLen), Vector3.new(0, h * 0.35, back - recvLen / 2))
	local barrelLen = math.max(0.05, (back - front) - recvLen)
	add("Barrel", "body", Vector3.new(barrelLen, 0.022 * scale, 0.022 * scale), Vector3.new(0, h * 0.55, front + barrelLen / 2), LOOK.steel.color)
	local barrel = model:FindFirstChild("Barrel") :: BasePart
	barrel:SetAttribute("Offset", CFrame.new(0, h * 0.55, front + barrelLen / 2) * CFrame.Angles(0, math.rad(90), 0))
	add("Grip", "body", Vector3.new(0.035 * scale, 0.1 * scale, 0.045 * scale), Vector3.new(0, -0.04 * scale, 0.01 * scale))
	if not w.melee and w.cat ~= "pistol" then
		add("Mag", "mag", Vector3.new(0.03 * scale, 0.12 * scale, 0.05 * scale), Vector3.new(0, -0.05 * scale, inf.left[3] * scale * 0.5))
		add("Stock", "body", Vector3.new(0.04 * scale, h * 1.2, math.max(0.02, inf.min[3] * scale * 0.9)), Vector3.new(0, 0, inf.min[3] * scale * 0.5),
			if w.cat == "rifle" and key == "ak" or key == "galil" then LOOK.wood.color else nil)
	end
end

local function knife(model: Model, grip: BasePart, scale: number)
	local function add(name: string, size: Vector3, at: CFrame, color: Color3, mat: Enum.Material, role: string)
		local p = plain(name, size, color, mat); p:SetAttribute("Piece", "body"); p:SetAttribute("Role", role); p:SetAttribute("Offset", at)
		p.CFrame = grip.CFrame * at; p.Parent = model
	end
	-- web (buildKnife) : seule la lame prend le skin ; poignée noire (M.blk) et garde sombre (M.dark) restent nues
	add("Handle", Vector3.new(0.03, 0.035, 0.12) * scale, CFrame.new(0, 0, 0.03 * scale), Color3.fromRGB(30, 31, 34), Enum.Material.SmoothPlastic, "grip")
	add("Guard", Vector3.new(0.035, 0.06, 0.012) * scale, CFrame.new(0, 0, -0.035 * scale), Color3.fromRGB(80, 82, 88), Enum.Material.Metal, "steel")
	add("Blade", Vector3.new(0.006, 0.035, 0.16) * scale, CFrame.new(0, 0.004 * scale, -0.12 * scale), Color3.fromRGB(200, 205, 212), Enum.Material.Metal, "body")   -- le skin couvre aussi la lame
	-- pointe en WedgePart (même forme que l'ancien SpecialMesh « Wedge ») : elle accepte les Texture du skin
	local tip = Instance.new("WedgePart"); tip.Name = "Tip"; tip.Size = Vector3.new(0.006, 0.035, 0.03) * scale
	tip.Color = Color3.fromRGB(200, 205, 212); tip.Material = Enum.Material.Metal
	tip.CanCollide = false; tip.CanQuery = false; tip.CanTouch = false; tip.Massless = true; tip.CastShadow = false; tip.Anchored = true
	local at = CFrame.new(0, 0.004 * scale, -0.215 * scale) * CFrame.Angles(0, math.rad(180), 0)
	tip:SetAttribute("Piece", "body"); tip:SetAttribute("Role", "body"); tip:SetAttribute("Offset", at); tip.CFrame = grip.CFrame * at; tip.Parent = model
end

-- ---------- fabrication + cache ----------
local cache: { [string]: Model } = {}

local WeaponReal = require(ReplicatedStorage.Shared.WeaponReal)

local function make(key: string, scale: number, real: boolean?, retOf: ((string) -> (string, string))?): Model
	local model = Instance.new("Model"); model.Name = "Weapon_" .. key
	local grip = plain("Grip", Vector3.new(0.05, 0.05, 0.05), Color3.new(), Enum.Material.SmoothPlastic)
	grip.Transparency = 1; grip.Parent = model; model.PrimaryPart = grip
	model:SetAttribute("WeaponKey", key)
	local w = Config.WEAPONS[key]
	local inf: any = if real then WeaponReal.Info[key] else Info[key]
	local muzzleZ = if inf then inf.muzzle * scale else -0.3 * scale
	local sightY = if inf then inf.sight * scale else 0.05 * scale
	if real then
		-- arme réaliste : pièces et textures envoyées (WeaponReal) ; viseur holographique intégré sur le M4
		sightY = WeaponReal.build(model, grip, key, scale, retOf)
		model:SetAttribute("Real", true)
	elseif w and w.melee then
		knife(model, grip, scale); muzzleZ = -0.23 * scale
	else
		local ok = false
		local folder = ReplicatedStorage.Shared:FindFirstChild("WeaponMeshes")
		-- armes spéciales des zombies (look = arme de base) : même maillage et même clé MeshAssets que l'arme de base.
		-- Avec leur propre clé (« w:winter#1/… »), jamais envoyée par MeshUploader (en mode Edit elles n'existent pas),
		-- chaque pièce retombait sur un EditableMesh côté joueur et saturait sa mémoire de maillages.
		local wa = w :: any
		local meshKey = if wa and type(wa.look) == "string" and folder and folder:FindFirstChild(wa.look) then wa.look :: string else key
		local src = folder and folder:FindFirstChild(meshKey)
		if src and (WeaponModels.meshApi or MeshStore.count() > 0) then
			local err
			ok, err = pcall(function()
				local groups = require(src :: ModuleScript) :: any
				for gi, g in ipairs(groups) do
					local mp, center = meshPiece(g, meshKey .. "#" .. gi, scale)
					if mp then
						local look = LOOK[g.role]
						mp.Name = g.part .. "_" .. g.role
						mp.Color = if look then look.color else Color3.fromRGB(g.color[1], g.color[2], g.color[3])
						mp.Material = if look then look.material else Enum.Material.Metal
						mp.Anchored = true; mp.CanCollide = false; mp.CanQuery = false; mp.CanTouch = false; mp.Massless = true; mp.CastShadow = false
						mp:SetAttribute("Piece", g.part); mp:SetAttribute("Role", g.role); mp:SetAttribute("Offset", CFrame.new(center))
						mp.CFrame = grip.CFrame * CFrame.new(center)
						mp.Parent = model
					end
				end
			end)
			if not ok then
				-- seul le refus de Roblox (réglage non coché) coupe tout ; une autre erreur ne touche que cette arme
				local msg = tostring(err)
				if string.find(string.lower(msg), "permission") or string.find(string.lower(msg), "not enabled") or string.find(msg, "API") then
					WeaponModels.meshApi = false
				end
				warn("[WeaponModels] arme « " .. key .. " » en blocs : " .. msg
					.. " (si ça parle de permission : Paramètres du jeu → Sécurité → coche « Allow Mesh / Image APIs »)")
				for _, c in ipairs(model:GetChildren()) do if c ~= grip then c:Destroy() end end
			end
		end
		if not ok and inf then blockGun(model, grip, key, scale) end
		-- armes spéciales : teinte propre (web : col) sur la carcasse, pour ne pas ressembler à l'arme de base
		local wc = (w :: any) and (w :: any).color
		if wc and typeof(wc) == "Color3" and (w :: any).cat == "wonder" then
			for _, c in ipairs(model:GetChildren()) do
				if c:IsA("BasePart") and c ~= grip and c:GetAttribute("Role") == "body" then c.Color = wc end
			end
		end
	end
	local muzzle = Instance.new("Attachment"); muzzle.Name = "Muzzle"; muzzle.Position = Vector3.new(0, if real and inf.bore then inf.bore * scale else sightY * 0.6, muzzleZ); muzzle.Parent = grip
	local left = Instance.new("Attachment"); left.Name = "LeftHand"
	left.Position = if inf then Vector3.new(inf.left[1], inf.left[2], inf.left[3]) * scale else Vector3.new()
	left.Parent = grip
	model:SetAttribute("SightY", sightY)
	model:SetAttribute("Scale", scale)          -- SkinPaint : taille de la peinture sur les pièces simples (Texture)
	return model
end

-- options de fabrication de chaque modèle rendu (réticules, aperçu) : setVariant refabrique l'autre version à l'identique
local optsOf: { [Instance]: any } = setmetatable({}, { __mode = "k" }) :: any

-- att : accessoires de l'armurier (liste d'Attachments) ; opts.ret(optique) -> (forme, couleur) du réticule, opts.preview
-- real : version réaliste (WeaponReal), seulement si WeaponModels.realAllowed(key)
function WeaponModels.build(key: string, scale: number, att: { string }?, opts: any?, real: boolean?): Model
	local id = key .. "@" .. scale .. (if real then "r" else "")
	local holoRet = ""
	if real and WeaponReal.Info[key] and WeaponReal.Info[key].optic and opts and opts.ret then
		local s2, c2 = opts.ret("holo"); holoRet = s2 .. c2; id ..= "|" .. holoRet     -- réticule du holo intégré
	end
	if not cache[id] then cache[id] = make(key, scale, real, opts and opts.ret) end
	local out: Model
	if not att or #att == 0 then out = cache[id]:Clone() else
		local rk = ""
		if opts and opts.ret then
			for _, a in ipairs(att) do local s2, c2 = opts.ret(a); rk ..= s2 .. c2 end
		end
		local aid = id .. "|" .. table.concat(att, ",") .. "|" .. rk .. (if opts and opts.preview then "p" else "")
		if not cache[aid] then
			local m = cache[id]:Clone()
			local AttachmentModels = require(script.Parent.AttachmentModels) :: any
			local ok, err = pcall(AttachmentModels.apply, m, key, att, scale, opts)
			if not ok then warn("[WeaponModels] accessoires", key, err) end
			cache[aid] = m
		end
		out = cache[aid]:Clone()
	end
	optsOf[out] = opts or false
	return out
end

-- ---------- version réaliste ou stylisée ----------
-- Réglages › Armes (ClientState.opt.realGuns, Menu/Options) ; assets envoyés ; pas les armes spéciales des zombies
function WeaponModels.realAllowed(key: string): boolean
	if not WeaponReal.Info[key] or not WeaponReal.ready(key) then return false end
	local w = Config.WEAPONS[key] :: any
	if not w or w.cat == "wonder" or w.melee then return false end
	local okS, S = pcall(require, ReplicatedStorage.Shared.ClientState)
	if okS and type(S) == "table" and type((S :: any).opt) == "table" and (S :: any).opt.realGuns == false then return false end
	return true
end

-- Remplace les pièces d'un modèle fabriqué par build() par celles de l'autre version (mêmes accessoires, même échelle).
-- Les pièces suivent la poignée (ancrées comme elle, soudées comme elle par weldTo) ; repères et attributs copiés.
-- Renvoie true si le modèle a changé (le viewmodel relit alors ses pièces).
function WeaponModels.setVariant(model: Instance, wantReal: boolean): boolean
	if not model:IsA("Model") then return false end
	local key, scale = model:GetAttribute("WeaponKey"), model:GetAttribute("Scale")
	if type(key) ~= "string" or type(scale) ~= "number" then return false end
	local want = wantReal and WeaponModels.realAllowed(key)
	if (model:GetAttribute("Real") == true) == want then return false end
	local grip = model.PrimaryPart
	if not grip then return false end
	local attStr = model:GetAttribute("Attachments")
	local att = if type(attStr) == "string" and attStr ~= "" then string.split(attStr, ",") else nil
	local o = optsOf[model]
	local ok, other = pcall(WeaponModels.build, key, scale, att, if o then o else nil, want)
	if not ok or not other then warn("[WeaponModels] version " .. (if want then "réaliste" else "stylisée") .. " de " .. key .. " : " .. tostring(other)); return false end
	local og = other.PrimaryPart :: BasePart
	local weld = grip:FindFirstChildOfClass("WeldConstraint")
	for _, c in ipairs(model:GetChildren()) do if c:IsA("BasePart") and c ~= grip then c:Destroy() end end
	for _, c in ipairs(other:GetChildren()) do
		if c:IsA("BasePart") and c ~= og then
			local off = c:GetAttribute("Offset")
			c.CFrame = grip.CFrame * (if typeof(off) == "CFrame" then off else CFrame.identity)
			c.Anchored = grip.Anchored
			c.Parent = model
			if weld then
				local wc = Instance.new("WeldConstraint"); wc.Part0 = weld.Part0; wc.Part1 = c; wc.Parent = c
			end
		end
	end
	for _, a in ipairs(og:GetChildren()) do
		local mine = grip:FindFirstChild(a.Name)
		if a:IsA("Attachment") and mine and mine:IsA("Attachment") then mine.Position = a.Position end
	end
	for k in pairs(model:GetAttributes()) do if other:GetAttribute(k) == nil then model:SetAttribute(k, nil) end end
	for k, v in pairs(other:GetAttributes()) do model:SetAttribute(k, v) end
	other:Destroy()
	return true
end

-- Recalcule la position de chaque pièce d'après Grip ; pieceCF[piece] = décalage d'animation (chargeur, culasse).
function WeaponModels.place(model: Model, gripCF: CFrame, pieceCF: { [string]: CFrame }?)
	local parts, cfs = {}, {}
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("BasePart") then
			local off = c:GetAttribute("Offset")
			local anim = pieceCF and pieceCF[c:GetAttribute("Piece") :: string] or nil
			table.insert(parts, c)
			table.insert(cfs, if typeof(off) == "CFrame" then (if anim then gripCF * anim * off else gripCF * off) else gripCF)
		end
	end
	if model:IsDescendantOf(workspace) then
		workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
	else
		for i, p in ipairs(parts) do (p :: BasePart).CFrame = cfs[i] end
	end
end

-- Arme tenue par un personnage (3e personne) : soudée à la poignée, pièces non ancrées.
function WeaponModels.weldTo(model: Model, handle: BasePart, gripCF: CFrame)
	WeaponModels.place(model, gripCF)
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("BasePart") then
			local wc = Instance.new("WeldConstraint"); wc.Part0 = handle; wc.Part1 = c; wc.Parent = c
			c.Anchored = false
		end
	end
end

return WeaponModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="410">
        <Properties>
          <string name="Name">WeaponReal</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/WeaponReal (ModuleScript, client + Studio)
-- Armes réalistes du jeu web (models/weapons_real : AK, M4 avec son viseur holographique, AWP, Desert Eagle ; Sketchfab,
-- CC BY, voir credits_real.json) : maillages lissés et textures d'origine (couleur, normales, métal, rugosité).
-- Comme sur le web (src/46_glb.js useRealGun), le modèle réaliste ne sert qu'avec la finition d'usine : un skin repasse
-- sur le modèle stylisé, qu'il sait peindre (WeaponModels.setVariant, appelé par SkinPaint.apply).
-- Chez le joueur, tout vient des assets envoyés une fois par ServerStorage/MeshUploader (étape « armes réalistes ») :
--   maillages « w:real:<arme>#<pièce>/<nv>/<nt> », images « i:wr:<arme>:<matériau>:c|n|m|r ».
-- Tant qu'une seule de ces clés manque dans MeshAssets, ready() répond false et l'arme stylisée reste en place.
-- Les données brutes (ServerStorage/WeaponRealData, tools/export_weapons_real_lua.py) ne sont lues que dans Studio.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local Info = require(ReplicatedStorage.Shared.WeaponInfoReal) :: { [string]: any }
local MeshStore = require(ReplicatedStorage.Shared.MeshStore)
local decode = require(ReplicatedStorage.Shared.Base64)

local WeaponReal = {}
WeaponReal.Info = Info
local Q, NQ, UVQ = 20000, 127, 8192            -- doivent correspondre à tools/export_weapons_real_lua.py
local KINDS = { "c", "n", "m", "r" }

function WeaponReal.meshKey(key: string, gi: number): string
	local g = Info[key].groups[gi]
	return "w:real:" .. key .. "#" .. gi .. "/" .. g.nv .. "/" .. g.nt
end
-- clé passée à MeshStore.image (qui ajoute « i: »)
function WeaponReal.imageKey(key: string, mi: number, kind: string): string
	return "wr:" .. key .. ":" .. mi .. ":" .. kind
end

-- toutes les clés de l'arme sont envoyées
local readyCache: { [string]: boolean } = {}
function WeaponReal.ready(key: string): boolean
	local inf = Info[key]
	if not inf then return false end
	if MeshStore.uploader then return false end
	local r = readyCache[key]
	if r ~= nil then return r end
	r = true
	for gi in ipairs(inf.groups) do if not MeshStore.ids[WeaponReal.meshKey(key, gi)] then r = false end end
	for mi in ipairs(inf.mats) do
		for _, k in ipairs(KINDS) do if not MeshStore.ids["i:" .. WeaponReal.imageKey(key, mi, k)] then r = false end end
	end
	if r then readyCache[key] = true end        -- « non » n'est pas gardé : un envoi en cours peut compléter MeshAssets
	return r
end

-- ---------- données brutes (Studio : envoi) ----------
type Raw = { info: any, blob: buffer }
local rawCache: { [string]: Raw | false } = {}
local function raw(key: string): Raw?
	local c = rawCache[key]
	if c ~= nil then return if c then c :: Raw else nil end
	local folder = ServerStorage:FindFirstChild("WeaponRealData")
	local f = folder and folder:FindFirstChild(key)
	local got: Raw | false = false
	if f then
		local info = require(f:FindFirstChild("Info") :: ModuleScript) :: any
		local parts = table.create(info.chunks)
		for i = 1, info.chunks do parts[i] = require(f:FindFirstChild("D" .. i) :: ModuleScript) :: any end
		got = { info = info, blob = decode(table.concat(parts)) }
	end
	rawCache[key] = got
	return if got then got :: Raw else nil
end

local function fillMesh(key: string, gi: number, center: Vector3): EditableMesh
	local r = raw(key)
	if not r then error("données de l'arme réaliste absentes (ServerStorage/WeaponRealData/" .. key .. ")") end
	local g = r.info.groups[gi]
	local b, o0 = r.blob, g.at[1]
	local em = AssetService:CreateEditableMesh({ FixedSize = false })
	if not em then error("mémoire des maillages pleine (CreateEditableMesh a renvoyé nil)") end
	local vid, nid, uid = table.create(g.nv), table.create(g.nv), table.create(g.nv)
	for i = 0, g.nv - 1 do
		local o = o0 + i * 14
		local p = Vector3.new(buffer.readi16(b, o), buffer.readi16(b, o + 2), buffer.readi16(b, o + 4)) / Q
		local n = Vector3.new(buffer.readi8(b, o + 6), buffer.readi8(b, o + 7), buffer.readi8(b, o + 8)) / NQ
		vid[i + 1] = em:AddVertex(p - center)
		nid[i + 1] = em:AddNormal(if n.Magnitude > 1e-3 then n.Unit else Vector3.yAxis)
		-- glTF et Roblox : (0, 0) = coin haut gauche de l'image, aucune inversion
		uid[i + 1] = em:AddUV(Vector2.new(buffer.readi16(b, o + 10) / UVQ, buffer.readi16(b, o + 12) / UVQ))
	end
	local t0 = o0 + g.nv * 14
	for t = 0, g.nt - 1 do
		local a = buffer.readu16(b, t0 + t * 6) + 1
		local c = buffer.readu16(b, t0 + t * 6 + 2) + 1
		local d = buffer.readu16(b, t0 + t * 6 + 4) + 1
		local f = em:AddTriangle(vid[a], vid[c], vid[d])
		em:SetFaceNormals(f, { nid[a], nid[c], nid[d] })      -- normales lissées du modèle (pas de facettes)
		em:SetFaceUVs(f, { uid[a], uid[c], uid[d] })
	end
	return em
end

-- image d'un matériau : JPEG décodé (ServerStorage/JpegDecode) ; carte de métal / rugosité en niveaux de gris
local function fillImage(key: string, mi: number, kind: string): EditableImage?
	local r = raw(key)
	local dec = ServerStorage:FindFirstChild("JpegDecode")
	if not r or not dec then return nil end
	local jpeg = require(dec :: ModuleScript) :: any
	local at = r.info.mats[mi][kind]
	local w, h, px = jpeg(r.blob, at[1], at[2])
	local e = AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
	e:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), px)
	return e
end

local images: { [string]: Content | false } = {}
function WeaponReal.image(key: string, mi: number, kind: string): Content?
	local k = WeaponReal.imageKey(key, mi, kind)
	local c = images[k]
	if c ~= nil then return if c then c :: Content else nil end
	if MeshStore.uploader and MeshStore.ids["i:" .. k] then return nil end      -- déjà envoyée : pas de décodage
	local ok, got, img = pcall(function() return MeshStore.image(k, function() return fillImage(key, mi, kind) end) end)
	if not ok and string.find(tostring(got), "trop d'échecs") then error(got) end      -- MeshUploader s'arrête
	-- pendant l'envoi : l'image est partie, on libère sa mémoire (EditableImage de 4 Mo)
	if MeshStore.uploader and ok and img then pcall(function() (img :: any):Destroy() end); got = nil end
	local res: Content | false = if ok and got then got :: Content else false
	if not MeshStore.uploader then images[k] = res end
	return if res then res :: Content else nil
end

-- ---------- pièces ----------
local pieceCache: { [string]: MeshPart } = {}
local function piece(key: string, gi: number): MeshPart
	local id = key .. "#" .. gi
	local mp = pieceCache[id]
	if mp then return mp end
	local g = Info[key].groups[gi]
	local center = Vector3.new(g.center[1], g.center[2], g.center[3])
	local made = MeshStore.meshPart(WeaponReal.meshKey(key, gi), function() return fillMesh(key, gi, center) end, MeshStore.PRECISE)
	pcall(function() (made :: any).DoubleSided = Info[key].mats[g.mat].double end)
	pieceCache[id] = made
	return made
end

-- Pièces de l'arme dans model (repère de la poignée Grip, échelle scale) ; opts.ret(optique) -> réticule du holo intégré
-- Renvoie la hauteur de la ligne de visée (mètres × échelle).
function WeaponReal.build(model: Model, grip: BasePart, key: string, scale: number, retOf: ((string) -> (string, string))?): number
	local inf = Info[key]
	for gi, g in ipairs(inf.groups) do
		local mp = piece(key, gi):Clone()
		mp.Size = (Vector3.new(g.size[1], g.size[2], g.size[3]) * scale):Max(Vector3.one * 0.001)
		local m = inf.mats[g.mat]
		mp.Name = "Real_" .. g.part .. "_" .. gi
		mp.Color = Color3.fromRGB(m.avg[1], m.avg[2], m.avg[3])
		mp.Material = if m.metal > 0.5 then Enum.Material.Metal else Enum.Material.SmoothPlastic
		-- couleur toujours posée (aperçus en ViewportFrame) ; normales, métal et rugosité dans le monde (WeaponMaterials)
		local col = WeaponReal.image(key, g.mat, "c")
		if col then mp.TextureContent = col end
		mp.Anchored = true; mp.CanCollide = false; mp.CanQuery = false; mp.CanTouch = false; mp.Massless = true; mp.CastShadow = false
		local off = CFrame.new(Vector3.new(g.center[1], g.center[2], g.center[3]) * scale)
		mp:SetAttribute("Piece", g.part); mp:SetAttribute("Role", "real"); mp:SetAttribute("RealMat", g.mat)
		mp:SetAttribute("Offset", off)
		if g.optic then mp:SetAttribute("BuiltinOptic", true) end
		mp.CFrame = grip.CFrame * off
		mp.Parent = model
	end
	-- viseur holographique intégré (M4) : réticule du holo (forme et couleur d'Arsenal › Viseurs) au milieu de la fenêtre
	if inf.optic then
		local shape, color = "dot", "red"
		if retOf then shape, color = retOf("holo") else
			local okA, A = pcall(require, ReplicatedStorage.Shared.Attachments)
			if okA then shape, color = (A :: any).retOf("holo", nil) end
		end
		local s = 0.015 * scale
		local p = Instance.new("Part"); p.Name = "Real_reticle"; p.Size = Vector3.new(s, s, 0.0002 * scale)
		p.Transparency = 1; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Massless = true; p.CastShadow = false
		local off = CFrame.new(Vector3.new(0, inf.sight, (inf.optic[1] + inf.optic[2]) / 2 + 0.01) * scale)
		p:SetAttribute("Piece", "body"); p:SetAttribute("Role", "att"); p:SetAttribute("Offset", off); p:SetAttribute("BuiltinOptic", true)
		p.CFrame = grip.CFrame * off
		local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Back; sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize
		sg.CanvasSize = Vector2.new(128, 128); sg.LightInfluence = 0; sg.Brightness = 2.5; sg.ClipsDescendants = true
		local holder = Instance.new("Frame"); holder.Size = UDim2.fromScale(1, 1); holder.BackgroundTransparency = 1; holder.Parent = sg
		local okR, RG = pcall(require, ReplicatedStorage.Shared.ReticleGui)
		if okR then pcall((RG :: any).draw, holder, 64, 64, 58, shape, color, false) end
		sg.Parent = p
		p.Parent = model
	end
	return inf.sight * scale
end

-- envoi depuis Studio (MeshUploader) : maillages et les quatre cartes de chaque matériau
function WeaponReal.uploadAll()
	for key, inf in pairs(Info) do
		for gi in ipairs(inf.groups) do piece(key, gi) end
		for mi in ipairs(inf.mats) do for _, k in ipairs(KINDS) do WeaponReal.image(key, mi, k) end end
	end
end

return WeaponReal
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="411">
        <Properties>
          <string name="Name">ZombieConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ZombieConfig (ModuleScript, client + serveur)
-- Données des modes Zombies et Bataille royale du jeu web :
--   src/69_zombies.js (armes prodiges, atouts, armes murales, boîte mystère, Forge Arcane, bonus),
--   src/69z_extra.js (portes, manches spéciales, boss), src/8K_zammo.js (porteurs de munitions),
--   src/8L_zdiff.js (difficulté des zombies), src/61_variants.js + src/8G_rounds.js (vagues, zone de la bataille royale, butin).
-- registerWeapons() ajoute les armes prodiges à Config.WEAPONS (emplacement 3 : jamais proposées dans les menus).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Z = {}

local function rgb(hex: number): Color3
	return Color3.fromRGB(bit32.rshift(hex, 16), bit32.band(bit32.rshift(hex, 8), 255), bit32.band(hex, 255))
end
Z.rgb = rgb

-- ---------- armes prodiges (W.raygun / thunder / winter du web) ----------
-- look = arme du jeu dont on reprend le modèle 3D
Z.WONDERS = {
	raygun = { name = "Rayon X", slot = 3, cat = "wonder", wonder = "ray", price = 0, dmg = 300, pellets = 1, hs = 1, rpm = 180, auto = false, mag = 8, reserve = 24,
		reload = 2.6, spread = 0.3, recoil = 1.2, speed = 1, kill = 10, armorPen = 1, zoom = 0, melee = false, look = "deagle", color = rgb(0xc0392b) },
	thunder = { name = "Canon Tonnerre", slot = 3, cat = "wonder", wonder = "thunder", price = 0, dmg = 2000, pellets = 1, hs = 1, rpm = 40, auto = false, mag = 2, reserve = 6,
		reload = 4, spread = 0, recoil = 6, speed = 0.92, kill = 10, armorPen = 1, zoom = 0, melee = false, look = "nova", color = rgb(0x8a6a3a) },
	winter = { name = "Souffle Givré", slot = 3, cat = "wonder", wonder = "ice", price = 0, dmg = 140, pellets = 1, hs = 1, rpm = 120, auto = true, mag = 6, reserve = 18,
		reload = 3, spread = 0, recoil = 2, speed = 0.95, kill = 10, armorPen = 1, zoom = 0, melee = false, look = "p90", color = rgb(0x6ed6ff) },
}

local registered = false
function Z.registerWeapons()
	if registered then return end
	registered = true
	local Config = require(ReplicatedStorage.Shared.Config) :: any
	local okI, Info = pcall(require, ReplicatedStorage.Shared.WeaponInfo)
	for k, w in pairs(Z.WONDERS) do
		if not Config.WEAPONS[k] then Config.WEAPONS[k] = w end
		if okI and typeof(Info) == "table" and not (Info :: any)[k] then (Info :: any)[k] = (Info :: any)[w.look] end
		-- modèle 3D : copie du modèle de l'arme de base (faite par le serveur, elle est répliquée à tout le monde)
		if RunService:IsServer() then
			local folder = ReplicatedStorage.Shared:FindFirstChild("WeaponMeshes")
			local src = folder and folder:FindFirstChild(w.look)
			if folder and src and not folder:FindFirstChild(k) then
				local c = src:Clone(); c.Name = k; c.Parent = folder
			end
		end
	end
end
function Z.isWonder(key: string?): boolean return key ~= nil and Z.WONDERS[key] ~= nil end

-- ---------- atouts ----------
Z.PERK_ORDER = { "jugg", "speed", "dtap", "revive", "stamin" }
Z.PERKS = {
	jugg = { n = "Mastodonte", price = 2500, c = rgb(0xe0383e), ic = "❤️", d = "Encaisse 2× plus de coups" },
	speed = { n = "Turbo Cola", price = 3000, c = rgb(0x33d17a), ic = "🔄", d = "Rechargement 2× plus rapide" },
	dtap = { n = "Double Détente", price = 2000, c = rgb(0xf5c542), ic = "II", d = "+33 % cadence, +50 % dégâts" },
	revive = { n = "Second Souffle", price = 1500, c = rgb(0x4aa3ff), ic = "♥", d = "Te relève une fois quand tu tombes" },
	stamin = { n = "Pas de Course", price = 2000, c = rgb(0xff9a3a), ic = "»", d = "Course 18 % plus rapide" },
}

Z.START_PTS = 500
Z.START_RES = 104            -- réserve du pistolet de départ (8 chargeurs de P250)
Z.WALLBUYS = { { "mac10", 500 }, { "mp9", 1000 }, { "ump", 1200 }, { "nova", 900 }, { "famas", 1500 }, { "galil", 1400 }, { "m4", 2000 }, { "xm", 1800 }, { "deagle", 800 } } :: { { any } }
Z.BOXPOOL = { "mac10", "mp9", "ump", "p90", "nova", "xm", "sawedoff", "galil", "famas", "ak", "m4", "sg553", "aug", "ssg", "awp", "scar", "negev", "m249", "deagle",
	"fiveseven", "raygun", "raygun", "thunder", "winter", "winter" }
Z.BOX_PRICE = 950
Z.PAP_PRICE = 5000
Z.DOOR_PRICES = { 750, 1000, 1250, 1500 }

-- bonus lâchés par les zombies
Z.DROP_ORDER = { "ammo", "insta", "dbl", "nuke", "fire" }
Z.DROPS = {
	ammo = { n = "MUNITIONS MAX", c = rgb(0x7dff6a), ic = "📦" },
	insta = { n = "MORT INSTANTANÉE", c = rgb(0xff3a3a), ic = "☠" },
	dbl = { n = "POINTS DOUBLES", c = rgb(0xffd23a), ic = "×2" },
	nuke = { n = "BOMBE", c = rgb(0xff9a3a), ic = "☢" },
	fire = { n = "VENTE DE FEU", c = rgb(0x7fe0ff), ic = "$" },
}

-- difficulté appliquée aux zombies (src/8L_zdiff.js), dans l'ordre de Modes.DIFFS
Z.ZDIFF = {
	{ hp = 0.6, spd = 0.78, dmg = 0.5, atk = 1.3, n = 0.6 },
	{ hp = 0.8, spd = 0.88, dmg = 0.7, atk = 1.05, n = 0.8 },
	{ hp = 1, spd = 1, dmg = 1, atk = 0.85, n = 1 },
	{ hp = 1.15, spd = 1.05, dmg = 1.2, atk = 0.75, n = 1.15 },
	{ hp = 1.3, spd = 1.1, dmg = 1.4, atk = 0.65, n = 1.3 },
}
Z.ZSLOW = 0.88
Z.RUN = 5.2                  -- vitesse de course du web (m/s) ; un joueur Roblox court à 16 studs/s

-- I, II, III, IIII, IIIII puis chiffres (compteur de manche « Black Ops »)
function Z.tally(n: number): string
	if n > 5 then return tostring(n) end
	return ({ "I", "II", "III", "IIII", "IIIII" })[n] or tostring(n)
end

-- ---------- Bataille royale ----------
-- phases de la zone (src/61_variants.js BR_PHASES), étirées pour que la zone se ferme vers 80 % du chrono (src/8G_rounds.js)
Z.BR_TIME = 300              -- durée maximale par défaut du web (5 min)
local BR_BASE = { { wait = 45, shrink = 30, r = 44, dmg = 2 }, { wait = 30, shrink = 25, r = 26, dmg = 4 }, { wait = 25, shrink = 20, r = 12, dmg = 7 }, { wait = 15, shrink = 20, r = 0, dmg = 12 } }
function Z.brPhases(total: number): { { wait: number, shrink: number, r: number, dmg: number } }
	local base = 0
	for _, p in ipairs(BR_BASE) do base += p.wait + p.shrink end
	local k = total * 0.8 / base
	local out = {}
	for i, p in ipairs(BR_BASE) do
		out[i] = { wait = math.floor(p.wait * k + 0.5), shrink = math.floor(p.shrink * k + 0.5), r = p.r, dmg = p.dmg }
	end
	return out
end
Z.BR_START_R = 64            -- rayon de départ (m), centre de la carte (40 m, 40 m)
Z.BR_TIERS = {
	{ "glock", "usp", "p250", "fiveseven", "deagle" },
	{ "mac10", "mp9", "ump", "nova", "sawedoff", "galil", "famas" },
	{ "ak", "m4", "sg553", "aug", "xm", "p90", "ssg", "negev" },
	{ "awp", "scar", "m249" },
}
-- couleur du halo d'une arme posée au sol (makeWeaponPickup du web)
function Z.lootColor(cat: string?): Color3
	if cat == "smg" or cat == "shotgun" then return rgb(0x4aa3ff) end
	if cat == "rifle" then return rgb(0xb36bff) end
	if cat == "sniper" or cat == "lmg" then return rgb(0xffb938) end
	return rgb(0x9aa6b8)
end
Z.ZONE_COLOR = rgb(0x35d6ff)

return Z
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="ServerScriptService" referent="412">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="ModuleScript" referent="413">
      <Properties>
        <string name="Name">AdminConfig</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/AdminConfig (ModuleScript, serveur seulement : jamais envoyé aux joueurs)
-- Qui peut ouvrir le panneau admin (AdminService) :
--   1) le propriétaire du jeu (créateur de l'expérience, ou propriétaire du groupe qui la publie : rang 255),
--      ou un identifiant listé dans USER_IDS ;
--   2) ET il doit taper le code ci-dessous (16 caractères, tirets facultatifs), comme le code admin du web.
-- Un joueur normal ne voit jamais le panneau : la touche Inser / F2 ne fait rien pour lui et le serveur refuse tout.
-- ⚠ Change CODE avant de publier (le dépôt est public). Ce fichier reste sur le serveur.
local AdminConfig = {}

AdminConfig.CODE = "CHANGE-MOI-AVANT-PUBLI"   -- remplace par ton propre code (lettres et chiffres, 16 caractères conseillés)
AdminConfig.USER_IDS = {} :: { number }       -- autres comptes autorisés (en plus du propriétaire), ex. { 12345678 }
AdminConfig.STUDIO = true                     -- en test dans Studio, la personne qui teste compte comme propriétaire
AdminConfig.MAX_TRIES = 5                     -- essais de code par minute

return AdminConfig
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="414">
      <Properties>
        <string name="Name">AdminService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/AdminService (ModuleScript, requis par Main)
-- Panneau admin du jeu web (src/8M_admin.js, PR #14 / #22 / #26), version Roblox :
--   • Accès : seulement le propriétaire du jeu (créateur, ou propriétaire du groupe qui publie le jeu) ou un compte de
--     AdminConfig.USER_IDS, ET après avoir tapé le code d'AdminConfig.CODE. Tout est vérifié ici, sur le serveur :
--     un joueur normal ne peut rien faire, même en trafiquant son client. Attributs du joueur : AdminEligible (le client
--     peut proposer la saisie du code), AdminUnlocked (code accepté).
--   • Joueurs : expulser, bannir (jusqu'à la fermeture du serveur), rendre muet, tuer, soigner, faire réapparaître,
--     changer d'équipe, geler, ajouter / retirer des bots, figer les bots.
--   • Partie : terminer, +1 minute, annonce à tous.
--   • Donner (son propre profil) : tout débloquer, pièces, niveaux, caisses.
--   • Triche : immortel, balles et grenades infinies, prendre une arme. Vision à travers les murs et visée auto (côté
--     client, AdminController). Comme sur le web, tout cela est COUPÉ dès que des joueurs humains sont en face (en
--     ligne contre d'autres joueurs) ; la vision reste permise en spectateur (admin éliminé).
--   • Journal : arrivées, départs, éliminations, discussion, actions admin.
-- Remote : AdminRequest (RemoteFunction) : (action, a, b) -> résultat.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TextChatService = game:GetService("TextChatService")

local Config = require(ReplicatedStorage.Shared.Config)
local AdminConfig = require(script.Parent.AdminConfig)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local WeaponService = require(script.Parent.WeaponService)
local BotService = require(script.Parent.BotService)
local MatchService = require(script.Parent.MatchService)
local NetService = require(script.Parent.NetService)

local AdminService = {}

local request = Instance.new("RemoteFunction"); request.Name = "AdminRequest"; request.Parent = ReplicatedStorage

type Flags = { god: boolean, ammo: boolean, nades: boolean }
local unlocked: { [Player]: boolean } = {}
local flags: { [Player]: Flags } = {}
local tries: { [Player]: { number } } = {}
local banned: { [number]: string } = {}
local muted: { [number]: boolean } = {}
local frozen: { [number]: boolean } = {}
local botsFrozen: { [number]: boolean } = {}
local log: { { t: string, txt: string, col: string } } = {}

local function addLog(txt: string, col: string?)
	table.insert(log, { t = os.date("%H:%M:%S") :: string, txt = txt, col = col or "" })
	while #log > 150 do table.remove(log, 1) end
end
AdminService.log = addLog

-- ---------- droits ----------
local ownerCache: { [Player]: boolean } = {}
function AdminService.isEligible(p: Player): boolean
	if ownerCache[p] ~= nil then return ownerCache[p] end
	local ok = false
	if table.find(AdminConfig.USER_IDS, p.UserId) then ok = true
	elseif game.CreatorType == Enum.CreatorType.User then ok = game.CreatorId ~= 0 and p.UserId == game.CreatorId
	elseif game.CreatorType == Enum.CreatorType.Group then
		local s, rank = pcall(function() return p:GetRankInGroup(game.CreatorId) end)
		ok = s and rank == 255
	end
	if not ok and AdminConfig.STUDIO and RunService:IsStudio() then ok = true end
	ownerCache[p] = ok
	return ok
end
local function isAdmin(p: Player): boolean
	return unlocked[p] == true and AdminService.isEligible(p)
end
AdminService.isAdmin = isAdmin

local function norm(code: string): string
	return (string.gsub(string.upper(code), "[^A-Z0-9]", ""))
end

-- des joueurs humains sont-ils en face ? (admHumansFacing du web)
local function humansFacing(p: Player): boolean
	if p:GetAttribute("Zone") == "duel" then return true end
	local m = MatchService.matchOf(p)
	if not m then return false end
	local mine = WeaponService.teamOf(p)
	for q in pairs(m.players) do
		if q ~= p and (not m.teams or WeaponService.teamOf(q) ~= mine) then return true end
	end
	return false
end
local function aliveChar(c: any): Model? return MatchService.aliveChar(c) end
-- '' = triche permise, sinon la raison (admCheatWhy / admVisionWhy / admAimWhy du web)
local function cheatWhy(p: Player): string
	if not MatchService.matchOf(p) then return "Lance une partie pour l'utiliser" end
	if humansFacing(p) then return "Des joueurs humains sont en face : coupé pour ne pas fausser leur partie" end
	return ""
end
local function visionWhy(p: Player): string
	if not MatchService.matchOf(p) then return "Lance une partie pour l'utiliser" end
	if not aliveChar(p) then return "" end
	if humansFacing(p) then return "Des joueurs humains sont en face : la vision ne marche qu'en spectateur (quand tu es éliminé)" end
	return ""
end
local function aimWhy(p: Player): string
	if not MatchService.matchOf(p) then return "Lance une partie pour l'utiliser" end
	if not aliveChar(p) then return "Tu es éliminé" end
	if humansFacing(p) then return "Des joueurs humains sont en face : la visée auto est coupée pour ne pas fausser leur partie" end
	return ""
end
AdminService.cheatWhy = cheatWhy

-- ---------- immortel, gel (filtre de dégâts et de grenades de WeaponService) ----------
local prevFilter = (WeaponService :: any).damageFilter
;(WeaponService :: any).damageFilter = function(attacker: any, victimChar: Model, raw: number, headshot: boolean, key: string): number?
	if typeof(attacker) == "Instance" and attacker:IsA("Player") and frozen[attacker.UserId] then return nil end
	local vp = Players:GetPlayerFromCharacter(victimChar)
	if vp and isAdmin(vp) and flags[vp] and flags[vp].god and cheatWhy(vp) == "" then return nil end
	if prevFilter then return prevFilter(attacker, victimChar, raw, headshot, key) end
	return raw
end
local prevThrow = (WeaponService :: any).throwBlocked
;(WeaponService :: any).throwBlocked = function(c: any): boolean
	if typeof(c) == "Instance" and c:IsA("Player") and frozen[c.UserId] then return true end
	return if prevThrow then prevThrow(c) else false
end

local function applyFreeze(p: Player)
	local ch = p.Character
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	local on = frozen[p.UserId] == true
	if ch then ch:SetAttribute("AdminFrozen", if on then true else nil) end
	if root then root.Anchored = on end
end

-- ---------- muet (TextChatService) ----------
local function applyMute(p: Player)
	local on = muted[p.UserId] == true
	pcall(function()
		for _, ch in ipairs(TextChatService:GetDescendants()) do
			if ch:IsA("TextChannel") then
				local src = ch:FindFirstChild(p.Name)
				if src and src:IsA("TextSource") then src.CanSend = not on end
			end
		end
	end)
end

-- ---------- combattants de la partie de l'admin ----------
local function keyOfC(c: any): string
	if typeof(c) == "Instance" and c:IsA("Player") then return "p:" .. c.UserId end
	return "b:" .. c.Name
end
local function findC(m: any, key: any): any
	if typeof(key) ~= "string" then return nil end
	for _, c in ipairs(MatchService.combatants(m)) do if keyOfC(c) == key then return c end end
	return nil
end

local function rows(admin: Player): { any }
	local list = {}
	local m = MatchService.matchOf(admin)
	if m then
		for _, c in ipairs(MatchService.combatants(m)) do
			local s = MatchService.statOf(m, c)
			local ch = aliveChar(c)
			local h = ch and ch:FindFirstChildOfClass("Humanoid")
			local isP = typeof(c) == "Instance" and c:IsA("Player")
			table.insert(list, { key = keyOfC(c), name = WeaponService.nameOf(c), kind = if c == admin then "me" elseif isP then "player" else "bot",
				team = WeaponService.teamOf(c) or "", k = s and s.k or 0, d = s and s.d or 0, hp = if h then math.floor(h.Health + 0.5) else 0, alive = h ~= nil,
				ping = if isP then math.floor(NetService.pingOf(c) * 1000) else nil, userId = if isP then c.UserId else nil,
				frozen = if isP then frozen[c.UserId] == true else c:GetAttribute("Frozen") == true, muted = isP and muted[c.UserId] == true })
		end
	else
		for _, q in ipairs(Players:GetPlayers()) do
			table.insert(list, { key = "p:" .. q.UserId, name = q.DisplayName, kind = if q == admin then "me" else "player", team = "", k = 0, d = 0, hp = 0, alive = false,
				ping = math.floor(NetService.pingOf(q) * 1000), userId = q.UserId, frozen = frozen[q.UserId] == true, muted = muted[q.UserId] == true, zone = q:GetAttribute("Zone") })
		end
	end
	return list
end

local function gameInfo(admin: Player): any
	local m = MatchService.matchOf(admin)
	if not m then return nil end
	local humans = 0
	for _ in pairs(m.players) do humans += 1 end
	return { mode = m.def.n, map = m.map and m.map.data.name or m.settings.map, state = m.state, team = m.teams ~= nil, score = m.score, teams = m.teams,
		limit = m.limit, timeLeft = if m.timed then math.max(0, math.floor(m.endsAt - os.clock())) else -1, humans = humans, botsFrozen = botsFrozen[m.id] == true,
		phase = m.data and m.data.phase, round = m.data and m.data.round }
end

local function profileInfo(p: Player): any
	local profile = DataService.get(p)
	if not profile then return nil end
	local level = RewardService.levelInfo(profile)
	return { level = level, coins = profile.coins, boxes = (profile.boxes.std or 0) + (profile.boxes.prem or 0) }
end

-- ---------- donner (profil de l'admin seulement) ----------
local function giveAll(p: Player): string
	local profile = DataService.get(p)
	if not profile then return "Profil pas chargé" end
	local n = 0
	for w in pairs(Config.WEAPONS) do
		local owned = profile.inv.skins[w] or {}
		for i = 2, #Config.SKINS do if not table.find(owned, i) then table.insert(owned, i); n += 1 end end
		profile.inv.skins[w] = owned
	end
	profile.inv.outfits = profile.inv.outfits or {}
	for i = 2, #Config.OUTFITS do if not table.find(profile.inv.outfits, i) then table.insert(profile.inv.outfits, i); n += 1 end end
	for id in pairs(Config.DANCES) do if not table.find(profile.inv.dances, id) then table.insert(profile.inv.dances, id); n += 1 end end
	local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
	profile.inv.killfx = profile.inv.killfx or {}
	for _, f in ipairs(KillFxConfig.LIST) do if f.id ~= "none" and not table.find(profile.inv.killfx, f.id) then table.insert(profile.inv.killfx, f.id); n += 1 end end
	local okP, ProgressService = pcall(require, script.Parent.ProgressService)
	if okP then
		local X = require(ReplicatedStorage.Shared.ConfigExtra)
		ProgressService.ensure(profile)
		profile.bp.premium = true
		profile.bp.xp = math.max(profile.bp.xp, X.SEASON.tiers * X.SEASON.xpPerTier)
	end
	profile.adminAll = true
	DataService.syncSkins(p)
	return "Tout débloqué (" .. n .. " objets, passe de combat premium au max)"
end
local function giveLevels(p: Player, n: number): string
	local profile = DataService.get(p)
	if not profile then return "Profil pas chargé" end
	local level, cur, need = RewardService.levelInfo(profile)
	local x = need - cur
	for l = level + 1, level + n - 1 do x += Config.xpNeeded(l) end
	RewardService.addXP(p, x)
	return "+" .. n .. " niveau" .. (if n > 1 then "x" else "") .. " (niveau " .. (RewardService.levelInfo(profile)) .. ")"
end

-- ---------- actions ----------
local function targetPlayer(a: any): Player?
	local id = tonumber(a)
	return if id then Players:GetPlayerByUserId(id) else nil
end

local ACTIONS: { [string]: (Player, any, any) -> any } = {}

ACTIONS.state = function(p, withLog)
	local f = flags[p] or { god = false, ammo = false, nades = false }
	local bl = {}
	for id, name in pairs(banned) do table.insert(bl, { userId = id, name = name }) end
	return { players = rows(p), game = gameInfo(p), flags = f, cheatWhy = cheatWhy(p), visionWhy = visionWhy(p), aimWhy = aimWhy(p),
		banned = bl, profile = profileInfo(p), log = if withLog then log else nil, inMatch = MatchService.matchOf(p) ~= nil }
end
ACTIONS.lock = function(p)
	unlocked[p] = nil; flags[p] = nil
	p:SetAttribute("AdminUnlocked", nil)
	return true
end
-- modération
ACTIONS.kick = function(p, a)
	local q = targetPlayer(a)
	if not q or q == p then return false end
	addLog(q.Name .. " expulsé", "#ff6b6b")
	q:Kick("L'administrateur t'a expulsé du serveur")
	return true
end
ACTIONS.ban = function(p, a)
	local q = targetPlayer(a)
	if not q or q == p then return false end
	banned[q.UserId] = q.Name
	addLog(q.Name .. " banni", "#ff6b6b")
	q:Kick("L'administrateur t'a banni de ce serveur")
	return true
end
ACTIONS.unban = function(_p, a)
	local id = tonumber(a)
	if not id or not banned[id] then return false end
	addLog(banned[id] .. " débanni")
	banned[id] = nil
	return true
end
ACTIONS.mute = function(_p, a)
	local q = targetPlayer(a)
	if not q then return false end
	muted[q.UserId] = not muted[q.UserId]
	applyMute(q)
	addLog(q.Name .. (if muted[q.UserId] then " rendu muet" else " peut de nouveau écrire"), "#ffb36b")
	return true
end
-- personnages de la partie
ACTIONS.kill = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	local ch = c and aliveChar(c)
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not h or not ch then return false end
	ch:SetAttribute("ProtectedUntil", 0)
	WeaponService.applyDamage(nil, ch, 1e6, false, "knife", 1)
	if h.Health > 0 then h.Health = 0 end
	addLog(WeaponService.nameOf(c) .. " éliminé par l'admin", "#ffb36b")
	return true
end
ACTIONS.heal = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	local ch = c and aliveChar(c)
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not h then return false end
	h.Health = h.MaxHealth
	WeaponService.setArmor(c, 100)
	addLog(WeaponService.nameOf(c) .. " soigné")
	return true
end
ACTIONS.revive = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	if not m or not c or aliveChar(c) then return false end
	if typeof(c) == "Instance" and c:IsA("Player") then MatchService.respawn(m, c); addLog(c.Name .. " réapparu"); return true end
	return false
end
ACTIONS.team = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	if not m or not c or not m.teams then return false end
	local cur = WeaponService.teamOf(c)
	local other = if cur == m.teams[1] then m.teams[2] else m.teams[1]
	MatchService.setTeam(m, c, other)
	if typeof(c) == "Instance" and c:IsA("Player") then
		MatchService.respawn(m, c)
	else
		c:SetAttribute("Look", other)
		local h = c:FindFirstChildOfClass("Humanoid"); if h then h.Health = 0 end   -- réapparaît dans sa nouvelle équipe
	end
	addLog(WeaponService.nameOf(c) .. " passe chez les " .. other)
	return true
end
ACTIONS.freeze1 = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	if not c or c == p then return false end
	if typeof(c) == "Instance" and c:IsA("Player") then
		frozen[c.UserId] = not frozen[c.UserId]
		applyFreeze(c)
		addLog(c.Name .. (if frozen[c.UserId] then " gelé" else " dégelé"), "#9fe3ff")
	else
		local on = not c:GetAttribute("Frozen")
		c:SetAttribute("Frozen", if on then true else nil)
		local h = c:FindFirstChildOfClass("Humanoid"); if h then h:Move(Vector3.zero); h.WalkSpeed = if on then 0 else 15 end
		addLog(c.Name .. (if on then " gelé" else " dégelé"), "#9fe3ff")
	end
	return true
end
ACTIONS.rmbot = function(p, key)
	local m = MatchService.matchOf(p); local c = m and findC(m, key)
	if not m or not c or not BotService.isBot(c) then return false end
	local team = WeaponService.teamOf(c)
	local group = if m.teams then team or "solo" else "solo"
	m.botCount[group] = math.max(0, (m.botCount[group] or 1) - 1)
	m.stats["bot:" .. c.Name] = nil
	addLog("Bot " .. c.Name .. " retiré")
	BotService.remove(c)
	return true
end
ACTIONS.addbot = function(p, team)
	local m = MatchService.matchOf(p)
	if not m or (m.state ~= "live" and m.state ~= "warmup") then return false end
	local t = if m.teams then (if team == m.teams[2] then m.teams[2] else m.teams[1]) else "solo"
	local group = if m.teams then t else "solo"
	m.botCount[group] = (m.botCount[group] or 0) + 1
	local b = MatchService.spawnBot(m, t)
	if botsFrozen[m.id] then BotService.freezeMatch(m.id, true) end
	addLog("Bot " .. b.Name .. " ajouté" .. (if m.teams then " (" .. t .. ")" else ""))
	return true
end
ACTIONS.freeze = function(p)
	local m = MatchService.matchOf(p)
	if not m then return false end
	botsFrozen[m.id] = not botsFrozen[m.id]
	BotService.freezeMatch(m.id, botsFrozen[m.id] == true)
	addLog(if botsFrozen[m.id] then "Bots figés" else "Bots libérés")
	return true
end
-- partie
ACTIONS.endmatch = function(p)
	local m = MatchService.matchOf(p)
	if not m then return false end
	MatchService.forceEnd(m)
	addLog("Partie terminée par l'admin", "#ffb36b")
	return true
end
ACTIONS.time = function(p)
	local m = MatchService.matchOf(p)
	if not m then return false end
	if m.timed then m.endsAt += 60 end
	if m.data and typeof(m.data.phaseEnd) == "number" and m.data.phaseEnd < math.huge then m.data.phaseEnd += 60 end
	addLog("+1 minute")
	return true
end
ACTIONS.announce = function(_p, txt)
	if typeof(txt) ~= "string" then return false end
	local t = string.sub((string.gsub(txt, "^%s+", "")), 1, 90)
	if t == "" then return false end
	local ann = ReplicatedStorage:FindFirstChild("MatchAnnounce") :: RemoteEvent?
	if ann then ann:FireAllClients("ANNONCE", t, Color3.fromRGB(255, 215, 94)) end
	addLog("Annonce : " .. t, "#ffd75e")
	return true
end
-- donner
ACTIONS.giveall = function(p) local r = giveAll(p); addLog(r, "#7dff9f"); return r end
ACTIONS.coins = function(p, n)
	local v = tonumber(n)
	local profile = DataService.get(p)
	if not v or v ~= v or not profile or v <= 0 or v > 1e6 then return false end   -- NaN : profil impossible à sauvegarder
	profile.coins += math.floor(v)
	addLog("+" .. math.floor(v) .. " pièces", "#7dff9f")
	return "+" .. math.floor(v) .. " pièces"
end
ACTIONS.lvl = function(p, n)
	local v = tonumber(n)
	if not v or v ~= v or v < 1 or v > 100 then return false end
	local r = giveLevels(p, math.floor(v)); addLog(r, "#7dff9f"); return r
end
ACTIONS.boxes = function(p)
	local profile = DataService.get(p)
	if not profile then return false end
	profile.boxes.std = (profile.boxes.std or 0) + 5; profile.boxes.prem = (profile.boxes.prem or 0) + 5
	addLog("+5 caisses standard et +5 premium", "#7dff9f")
	return "+5 caisses standard et +5 premium"
end
-- triches (coupées contre des humains)
local function toggle(name: string)
	return function(p: Player)
		local f = flags[p] or { god = false, ammo = false, nades = false }
		flags[p] = f
		local ff = f :: any
		ff[name] = not ff[name]
		addLog(({ god = "Immortel", ammo = "Balles infinies", nades = "Grenades infinies" } :: any)[name] .. (if ff[name] then " activé" else " coupé"))
		return true
	end
end
ACTIONS.god = toggle("god")
ACTIONS.ammo = toggle("ammo")
ACTIONS.nades = toggle("nades")
ACTIONS.weapon = function(p, key)
	if typeof(key) ~= "string" or cheatWhy(p) ~= "" or not aliveChar(p) then return false end
	local w = Config.WEAPONS[key]
	if not w or w.melee or (w.slot ~= 0 and w.slot ~= 1) then return false end
	local prim = p:GetAttribute("Primary"); local sec = p:GetAttribute("Secondary")
	local keys = if w.slot == 0 then { key, if typeof(sec) == "string" then sec else "glock", "knife" } else { if typeof(prim) == "string" then prim else "ak", key, "knife" }
	WeaponService.giveLoadout(p, keys)
	addLog("Arme prise : " .. w.name)
	return true
end
ACTIONS.clearlog = function() table.clear(log); return true end

request.OnServerInvoke = function(p: Player, action: any, a: any, b: any): any
	if typeof(action) ~= "string" then return nil end
	if not AdminService.isEligible(p) then return nil end            -- joueur normal : rien, jamais
	if action == "unlock" then
		local now = os.clock()
		local list = tries[p] or {}; tries[p] = list
		while list[1] and now - list[1] > 60 do table.remove(list, 1) end
		if #list >= AdminConfig.MAX_TRIES then return { ok = false, err = "Trop d'essais : réessaie dans une minute" } end
		table.insert(list, now)
		if typeof(a) ~= "string" or norm(a) == "" or norm(a) ~= norm(AdminConfig.CODE) then return { ok = false, err = "Code incorrect" } end
		unlocked[p] = true
		p:SetAttribute("AdminUnlocked", true)
		addLog("Accès admin ouvert par " .. p.Name, "#7dff9f")
		return { ok = true }
	end
	if not isAdmin(p) then return nil end
	local fn = ACTIONS[action]
	if not fn then return nil end
	local ok, res = pcall(fn, p, a, b)
	if not ok then warn("[AdminService]", action, res); return nil end
	return res
end

-- ---------- boucle : balles / grenades infinies, immortel ----------
task.spawn(function()
	while true do
		task.wait(0.4)
		for p, f in pairs(flags) do
			if p.Parent and isAdmin(p) and aliveChar(p) and cheatWhy(p) == "" then
				if f.ammo then WeaponService.fillMags(p) end
				if f.nades then for _, k in ipairs({ "frag", "flash", "smoke", "mine" }) do WeaponService.refillGrenade(p, k) end end
				if f.god then
					local h = (aliveChar(p) :: Model):FindFirstChildOfClass("Humanoid")
					if h and h.Health < 100 then h.Health = math.max(h.Health, math.min(100, h.MaxHealth)) end
				end
			end
		end
	end
end)

-- ---------- journal ----------
local function hookPlayer(p: Player)
	if banned[p.UserId] then p:Kick("Tu es banni de ce serveur"); addLog(p.Name .. " (banni) a essayé de revenir", "#ff6b6b"); return end
	addLog(p.Name .. " a rejoint le serveur", "#7dff9f")
	if AdminService.isEligible(p) then p:SetAttribute("AdminEligible", true) end
	p.Chatted:Connect(function(msg) table.insert(log, { t = "💬", txt = p.Name .. " : " .. msg, col = "#9fe3ff" }); while #log > 150 do table.remove(log, 1) end end)
	p.CharacterAdded:Connect(function()
		task.defer(function() applyFreeze(p); applyMute(p) end)
	end)
end
Players.PlayerAdded:Connect(hookPlayer)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(hookPlayer, p) end
Players.PlayerRemoving:Connect(function(p: Player)
	addLog(p.Name .. " a quitté le serveur", "#ffb36b")
	unlocked[p] = nil; flags[p] = nil; tries[p] = nil; ownerCache[p] = nil
end)
WeaponService.Killed:Connect(function(killer, victim, key: string, headshot: boolean)
	if not MatchService.matchOf(victim) then return end
	local vn = WeaponService.nameOf(victim)
	if killer == nil or killer == victim then addLog(vn .. " est mort"); return end
	addLog(WeaponService.nameOf(killer) .. " → " .. vn .. " (" .. MatchService.weaponName(key) .. (if headshot then ", tête" else "") .. ")")
end)
pcall(function()
	TextChatService.DescendantAdded:Connect(function(d)
		if d:IsA("TextSource") then
			local q = Players:GetPlayerByUserId(d.UserId)
			if q and muted[q.UserId] then d.CanSend = false end
		end
	end)
end)

return AdminService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="415">
      <Properties>
        <string name="Name">ArmoryService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ArmoryService (ModuleScript, requis par WeaponService)
-- Armurier + viseurs du jeu web (src/64b_gunsmith.js, 64c_sights.js) : choix des accessoires par arme et des réticules,
-- gardés dans le profil (profile.att[arme] = { emplacement = accessoire }, profile.ret[optique] = "forme|#couleur").
-- Le serveur vérifie tout (catégorie, niveau + éliminations avec l'arme, 5 accessoires max) puis recopie le résultat
-- en attributs du joueur, comme DataService.syncSkins : Att_<arme> = "muzzle=sil,optic=reddot", Ret_<optique>.
-- Tout le monde voit donc les accessoires (arme en 3e personne) et WeaponService applique leurs effets.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local A = require(ReplicatedStorage.Shared.Attachments)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)

local ArmoryService = {}

local function progOf(profile: any): A.Prog
	local level = RewardService.levelInfo(profile)
	local kills: { [string]: number } = {}
	local a = profile.weaponKills or {}
	local b = profile.stats and profile.stats.byWeapon or {}
	for k in pairs(Config.WEAPONS) do kills[k] = math.max(a[k] or 0, b[k] or 0) end
	return { level = level, kills = kills }
end
ArmoryService.progOf = progOf

local function ensure(profile: any)
	if typeof(profile.att) ~= "table" then profile.att = {} end
	if typeof(profile.ret) ~= "table" then profile.ret = {} end
end

-- recopie les choix (seulement ce qui est débloqué) en attributs du joueur
function ArmoryService.sync(player: Player)
	local profile = DataService.get(player)
	if not profile then return end
	ensure(profile)
	local p = progOf(profile)
	for k in pairs(Config.WEAPONS) do
		local sel = profile.att[k]
		local out: A.Sel = {}
		for _, a in ipairs(A.list(k, if typeof(sel) == "table" then sel else nil, p)) do out[A.ATTS[a].s] = a end
		local s = A.encode(out)
		player:SetAttribute("Att_" .. k, if s ~= "" then s else nil)
	end
	for o in pairs(A.RET_DEF) do
		local r = profile.ret[o]
		player:SetAttribute("Ret_" .. o, if typeof(r) == "string" then r else nil)
	end
end

local function setSlot(profile: any, k: string, slot: string, a: string?, skipLock: boolean?): (boolean, string?)
	local ok = A.allowed(k)
	if not ok[slot] then return false, "Emplacement indisponible" end
	local sel: A.Sel = table.clone(if typeof(profile.att[k]) == "table" then profile.att[k] else {})
	if a then
		if not table.find(ok[slot], a) then return false, "Accessoire incompatible" end
		if not skipLock and not A.isOpen(k, a, progOf(profile)) then return false, A.lockText(k, a, progOf(profile)) end
		sel[slot] = a
	else sel[slot] = nil end
	if A.count(sel) > A.MAX then return false, "Maximum " .. A.MAX .. " accessoires : retire-en un d'abord" end
	profile.att[k] = sel
	return true, nil
end

local fn = Instance.new("RemoteFunction"); fn.Name = "Armory"; fn.Parent = ReplicatedStorage
fn.OnServerInvoke = function(player: Player, action: any, a1: any, a2: any, a3: any): any
	local profile = DataService.get(player)
	if not profile then return nil end
	ensure(profile)
	if action == "get" then
		local p = progOf(profile)
		return { att = profile.att, ret = profile.ret, level = p.level, kills = p.kills }
	elseif action == "set" then                           -- (arme, emplacement, accessoire | "")
		if typeof(a1) ~= "string" or not Config.WEAPONS[a1] or typeof(a2) ~= "string" then return { ok = false } end
		local att = if typeof(a3) == "string" and a3 ~= "" then a3 else nil
		local ok, msg = setSlot(profile, a1, a2, att)
		if ok then ArmoryService.sync(player) end
		return { ok = ok, msg = msg, att = profile.att }
	elseif action == "ret" then                           -- (optique, forme, couleur)
		if typeof(a1) ~= "string" or not A.RET_DEF[a1] or not A.validRet(a2, a3) then return { ok = false } end
		profile.ret[a1] = a2 .. "|" .. a3
		ArmoryService.sync(player)
		return { ok = true, ret = profile.ret }
	elseif action == "all" then                           -- (arme) : même viseur sur toutes les armes compatibles
		if typeof(a1) ~= "string" or not Config.WEAPONS[a1] then return { ok = false } end
		local cur = profile.att[a1] and profile.att[a1].optic
		if typeof(cur) ~= "string" then return { ok = false } end
		local n = 0
		for k in pairs(Config.WEAPONS) do
			local opts = A.allowed(k).optic
			if k ~= a1 and opts and table.find(opts, cur) and setSlot(profile, k, "optic", cur, true) then n += 1 end   -- comme le web : verrouillé = ignoré en jeu
		end
		ArmoryService.sync(player)
		return { ok = true, n = n, att = profile.att }
	end
	return nil
end

-- synchronisation à l'arrivée (le profil se charge en tâche de fond) et à chaque apparition (niveau gagné entre-temps)
local function watch(player: Player)
	task.spawn(function()
		for _ = 1, 60 do
			if DataService.get(player) then break end
			task.wait(0.5)
		end
		ArmoryService.sync(player)
	end)
	player.CharacterAdded:Connect(function() ArmoryService.sync(player) end)
end
Players.PlayerAdded:Connect(watch)
for _, p in ipairs(Players:GetPlayers()) do watch(p) end

return ArmoryService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="416">
      <Properties>
        <string name="Name">ArrivalService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ArrivalService (ModuleScript, appelé par MatchService)
-- Arrivée en hélicoptère ou en véhicule au début d'une partie en équipe, comme le web (src/61_variants.js :
-- startCine() quand le mode se joue en équipe, hors Entraînement ; src/65_cine.js, src/65b_car.js).
-- La scène se joue chez chaque joueur (StarterPlayerScripts/CinematicController) pendant « PRÉPAREZ-VOUS » :
-- tout le monde est déjà à son point de départ, immobile (joueurs à vitesse 0, bots gelés par MatchService).
-- play() attend que chacun ait fini ou passé sa scène (au plus MAX_WAIT secondes), puis rend la main à MatchService
-- qui relance son compte à rebours.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ArrivalService = {}

local MAX_WAIT = 14         -- scène la plus longue (hélicoptère, 11,6 s) + chargement du véhicule
local CHAR_WAIT = 3         -- personnages encore en train d'apparaître

local remote = Instance.new("RemoteEvent")
remote.Name = "ArrivalCinematic"      -- serveur -> joueur : jouer la scène ; joueur -> serveur : "done" (finie ou passée)
remote.Parent = ReplicatedStorage

local pending: { [Player]: number } = {}   -- joueur -> partie dont il regarde l'arrivée

remote.OnServerEvent:Connect(function(p: Player, what: any)
	if what == "done" then pending[p] = nil end
end)

-- m : partie de MatchService ; warmup : durée du « PRÉPAREZ-VOUS » qui suit ; tick : envoi de l'état (toutes les 0,5 s)
-- Renvoie true si une scène a été jouée (le compte à rebours repart alors de warmup).
function ArrivalService.play(m: any, warmup: number, tick: () -> ()): boolean
	if not m.def.team or m.mode == "train" then return false end
	-- les personnages viennent d'être lancés (MatchService.spawnPlayer) : on leur laisse le temps d'arriver
	local t0 = os.clock()
	while os.clock() - t0 < CHAR_WAIT do
		local ready = true
		for p in pairs(m.players) do
			local c = p.Character
			if p.Parent and not (c and c:FindFirstChild("HumanoidRootPart") and c:GetAttribute("MatchId") == m.id) then ready = false end
		end
		if ready then break end
		task.wait(0.1)
	end
	local any = false
	for p in pairs(m.players) do
		if p.Parent and p.Character then
			pending[p] = m.id; any = true
			remote:FireClient(p, { limit = m.limit or 0, mode = m.mode })
		end
	end
	if not any then return false end
	local deadline = os.clock() + MAX_WAIT
	local nextTick = 0
	while os.clock() < deadline and not m.closed do
		local waiting = false
		for p, id in pairs(pending) do
			if id == m.id then
				if not p.Parent or not m.players[p] then pending[p] = nil else waiting = true end
			end
		end
		if not waiting then break end
		m.endsAt = deadline + warmup
		if os.clock() >= nextTick then nextTick = os.clock() + 0.5; pcall(tick) end
		task.wait(0.1)
	end
	for p, id in pairs(pending) do if id == m.id then pending[p] = nil end end
	m.endsAt = os.clock() + warmup
	return true
end

return ArrivalService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="417">
      <Properties>
        <string name="Name">BotService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/BotService (ModuleScript, requis par MatchService)
-- Bots R15 qui complètent les équipes : patrouille sur les points de passage de la carte (PathfindingService),
-- repérage des ennemis (champ de vision + rayon), temps de réaction, rafales et imprécision réglables (ModeConfig.BOT).
-- Ils tirent avec WeaponService.fire, exactement comme les joueurs.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local WeaponService = require(script.Parent.WeaponService)

local BOT = ModeConfig.BOT
local BotService = {}
BotService.extraTargets = nil :: ((string, number) -> { Model })?

type Brain = {
	model: Model, hum: Humanoid, root: BasePart, team: string,
	roam: { Vector3 }, waypoints: { PathWaypoint }, wpIndex: number, goal: Vector3?, repathAt: number,
	target: Model?, seenAt: number, lastSeen: Vector3?, lastSeenAt: number, burstLeft: number, nextBurst: number, alive: boolean,
	match: number?, diff: any, goalFn: ((Model) -> Vector3?)?,
	nades: boolean, nadeT: number, mineT: number,
}
-- Réglages d'une apparition (MatchService) : partie, niveau (Modes.DIFFS), armes, but de déplacement imposé par le mode
-- nades = grenades et mines lancées par BotService lui-même (modes à mort ; les modes à manches ont les leurs)
export type SpawnOpts = { match: number?, diff: any?, loadout: { string }?, goal: ((Model) -> Vector3?)?, nades: boolean? }
local brains: { [Model]: Brain } = {}
local usedNames: { [string]: boolean } = {}
local folder: Folder? = nil
local paused = false

local TEAM_COLORS = {
	Attaquants = { torso = Color3.fromRGB(196, 110, 52), legs = Color3.fromRGB(92, 70, 52) },
	["Défenseurs"] = { torso = Color3.fromRGB(58, 96, 168), legs = Color3.fromRGB(44, 52, 70) },
}

local function pickName(): string
	for _ = 1, 20 do
		local n = BOT.names[math.random(#BOT.names)]
		if not usedNames[n] then usedNames[n] = true; return n end
	end
	local n = BOT.names[math.random(#BOT.names)] .. " " .. math.random(10, 99)
	usedNames[n] = true
	return n
end

local function getFolder(): Folder
	if folder and folder.Parent then return folder end
	local f = Instance.new("Folder"); f.Name = "Bots"; f.Parent = workspace
	folder = f
	return f
end

-- Toutes les cibles possibles : joueurs vivants + autres bots vivants
-- (seulement ceux de la même partie : plusieurs parties tournent en même temps sur le serveur)
local function enemiesOf(team: string, match: number?): { Model }
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		local h = c and c:FindFirstChildOfClass("Humanoid")
		local pt = WeaponService.teamOf(p)
		if c and h and h.Health > 0 and pt and pt ~= team and p:GetAttribute("MatchId") == match then table.insert(list, c) end
	end
	for m, b in pairs(brains) do
		if b.alive and b.team ~= team and b.match == match then table.insert(list, m) end
	end
	-- cibles en plus fournies par un mode (Zombies : les zombies de la partie)
	if BotService.extraTargets and match then
		local ok, more = pcall(BotService.extraTargets :: any, team, match)
		if ok and typeof(more) == "table" then for _, e in ipairs(more) do table.insert(list, e) end end
	end
	return list
end

local function canSee(b: Brain, target: Model): (boolean, Vector3?)
	local head = target:FindFirstChild("Head") :: BasePart?
	local myHead = b.model:FindFirstChild("Head") :: BasePart?
	if not head or not myHead then return false, nil end
	local to = head.Position - myHead.Position
	local sight = if b.diff then b.diff.sight * Config.STUDS_PER_METER else BOT.viewDistance
	if to.Magnitude > sight then return false, nil end
	if b.root.CFrame.LookVector:Dot(to.Unit) < BOT.fov and to.Magnitude > 14 then return false, nil end
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { b.model }
	local r = workspace:Raycast(myHead.Position, to, params)
	if r and not r.Instance:IsDescendantOf(target) then return false, nil end
	if WeaponService.smokeBlocks(myHead.Position, head.Position) then return false, nil end   -- la fumée coupe la vue (web : smokeBlocks)
	-- vise le torse la plupart du temps, la tête de temps en temps
	local torso = (target:FindFirstChild("UpperTorso") or target:FindFirstChild("HumanoidRootPart")) :: BasePart?
	local headRate = if b.diff then 0.1 + b.diff.aimHead else 0.25
	return true, if math.random() < headRate or not torso then head.Position else torso.Position
end

local function pathTo(b: Brain, goal: Vector3)
	b.goal = goal; b.waypoints = {}; b.wpIndex = 1
	b.repathAt = os.clock() + 4
	task.spawn(function()
		local path = PathfindingService:CreatePath({ AgentRadius = 2, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 6 })
		local ok = pcall(function() path:ComputeAsync(b.root.Position, goal) end)
		if ok and path.Status == Enum.PathStatus.Success and b.goal == goal then
			b.waypoints = path:GetWaypoints(); b.wpIndex = 2
		end
	end)
end

local function aimError(b: Brain, dir: Vector3): Vector3
	local e = math.rad(if b.diff then b.diff.spread else BOT.aimErrorDeg)
	return (CFrame.lookAlong(Vector3.zero, dir.Unit) * CFrame.Angles((math.random() - 0.5) * 2 * e, (math.random() - 0.5) * 2 * e, 0)).LookVector
end

-- Grenades et mines d'un bot, aux mêmes moments que le web (src/70_ai.js botUpdate, src/63_agents.js agentBot) et que
-- Modes/rounds (botNades) : en combat, flash entre 9 et 24 m, fumigène quand il est blessé ; hors combat, frag sur la
-- dernière position vue (moins de 4 s, entre 9 et 26 m) ; de temps en temps, une mine quand il ne se bat pas.
-- timers = { nadeT, mineT } (prochain lancer, prochain essai de mine) ; mineChance : 0,12 (modes à mort), 0,18 (bombe)
function BotService.nadeStep(bot: Model, dt: number, nadeSkill: number, mineChance: number, timers: { nadeT: number, mineT: number })
	local b = brains[bot]
	if not b or not b.alive or bot:GetAttribute("Frozen") then return end
	local stock = WeaponService.grenadesOf(bot)
	if not stock then return end
	local t = os.clock()
	local r = b.root
	local target, seen, ago = b.target, b.lastSeen, t - b.lastSeenAt
	local tr = target and target:FindFirstChild("HumanoidRootPart") :: BasePart?
	local function flat(a: Vector3, c: Vector3): number return Vector3.new(a.X - c.X, 0, a.Z - c.Z).Magnitude / Config.STUDS_PER_METER end
	if t > timers.nadeT then
		if tr then
			local dist = flat(tr.Position, r.Position)
			if stock.flash > 0 and dist > 9 and dist < 24 and math.random() < dt * 0.5 * nadeSkill then
				timers.nadeT = t + 4; WeaponService.throwGrenade(bot, "flash", false, tr.Position)
			elseif stock.smoke > 0 and b.hum.Health < 40 and dist > 6 and math.random() < dt * 1.2 * nadeSkill then
				timers.nadeT = t + 6; WeaponService.throwGrenade(bot, "smoke", false, r.Position:Lerp(tr.Position, 0.35))
			end
		elseif stock.frag > 0 and seen and ago < 4 then
			local dd = flat(seen, r.Position)
			if dd > 9 and dd < 26 and math.random() < dt * 0.8 * nadeSkill then
				timers.nadeT = t + 5; WeaponService.throwGrenade(bot, "frag", false, seen)
			end
		end
	end
	timers.mineT -= dt
	if timers.mineT <= 0 then
		timers.mineT = 1.5 + math.random() * 2
		if not target and stock.mine > 0 and math.random() < mineChance then WeaponService.placeMine(bot) end
	end
end

local function think(b: Brain)
	if not b.alive or b.model:GetAttribute("Frozen") then return end
	local t = os.clock()
	-- aveuglé par une flash (GrenadeService : attribut BlindUntil) : il perd sa cible et ralentit
	local blind = b.model:GetAttribute("BlindUntil")
	if typeof(blind) == "number" and blind > workspace:GetServerTimeNow() then
		b.target = nil
		b.hum:Move(Vector3.zero)
		return
	end
	b.team = (b.model:GetAttribute("Team") :: string?) or b.team    -- le mode peut changer l'équipe (Infecté)
	-- 1) chercher l'ennemi visible le plus proche
	local best, bestPos, bestD = nil, nil, math.huge
	for _, e in ipairs(enemiesOf(b.team, b.match)) do
		local er = e:FindFirstChild("HumanoidRootPart") :: BasePart?
		if er then
			local d = (er.Position - b.root.Position).Magnitude
			if d < bestD then
				local ok, aimAt = canSee(b, e)
				if ok then best, bestPos, bestD = e, aimAt, d end
			end
		end
	end
	if best ~= b.target then b.target = best; b.seenAt = t end
	if best then local br = best:FindFirstChild("HumanoidRootPart") :: BasePart?; if br then b.lastSeen = br.Position; b.lastSeenAt = t end end
	-- occupé par l'objectif du mode (pose / désamorçage de la bombe) : il reste sur place tant qu'aucun ennemi n'est en vue
	if not best and b.model:GetAttribute("Busy") then b.hum:Move(Vector3.zero); b.goal = nil; return end

	local key, mag = WeaponService.current(b.model)
	if key and mag <= 0 and not Config.WEAPONS[key].melee then WeaponService.reload(b.model) end

	if best and bestPos then
		-- 2) combat : se tourner, s'arrêter un peu, tirer après le temps de réaction
		local flat = Vector3.new(bestPos.X, b.root.Position.Y, bestPos.Z)
		b.root.CFrame = CFrame.lookAt(b.root.Position, flat)
		b.hum:Move(Vector3.zero)
		if t - b.seenAt >= (if b.diff then b.diff.react else BOT.reaction) and t >= b.nextBurst then
			local head = b.model:FindFirstChild("Head") :: BasePart?
			if head and key then
				local w = Config.WEAPONS[key]
				-- inclinaison du regard, pour la kill-cam (vue par les yeux du bot)
				b.model:SetAttribute("Pitch", math.asin(math.clamp((bestPos - head.Position).Unit.Y, -1, 1)))
				if w.melee and bestD > 9 then
					b.hum:MoveTo(bestPos)
				elseif WeaponService.fire(b.model, head.Position, aimError(b, bestPos - head.Position)) then
					if w.auto then
						b.burstLeft -= 1
						if b.burstLeft <= 0 then
							b.burstLeft = if b.diff then math.random(b.diff.bmin, b.diff.bmax) else math.random(BOT.burst[1], BOT.burst[2])
							b.nextBurst = t + 0.25 + math.random() * 0.3
						end
					else
						b.nextBurst = t + 60 / w.rpm + 0.1 + math.random() * 0.25
					end
				end
			end
		end
		b.goal = nil
		return
	end

	-- 3) objectif du mode (zone, drapeau, Mastodonte…) sinon patrouille : point de passage au hasard (PathfindingService)
	local want = if b.goalFn then b.goalFn(b.model) else nil
	if want and (not b.goal or (b.goal - want).Magnitude > 12) then
		pathTo(b, want)
		return
	end
	if not b.goal or t > b.repathAt + 8 then
		if #b.roam > 0 then pathTo(b, b.roam[math.random(#b.roam)]) end
		return
	end
	local wp = b.waypoints[b.wpIndex]
	if wp then
		if wp.Action == Enum.PathWaypointAction.Jump then b.hum.Jump = true end
		b.hum:MoveTo(wp.Position)
		local flatD = (Vector3.new(wp.Position.X, 0, wp.Position.Z) - Vector3.new(b.root.Position.X, 0, b.root.Position.Z)).Magnitude
		if flatD < 3 then b.wpIndex += 1 end
	elseif b.goal and (b.goal - b.root.Position).Magnitude < 8 then
		b.goal = nil
	elseif t > b.repathAt and b.goal then
		pathTo(b, b.goal)
	end
end

-- Crée un bot de l'équipe donnée à la position donnée, armé. Renvoie son Model (= le « combattant »).
function BotService.spawn(team: string, at: Vector3, roam: { Vector3 }, name: string?, opts: SpawnOpts?): Model
	local desc = Instance.new("HumanoidDescription")
	local col = TEAM_COLORS[team] or TEAM_COLORS.Attaquants
	desc.HeadColor = Color3.fromRGB(234, 184, 146); desc.LeftArmColor = desc.HeadColor; desc.RightArmColor = desc.HeadColor
	desc.TorsoColor = col.torso; desc.LeftLegColor = col.legs; desc.RightLegColor = col.legs
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = name or pickName()
	model:SetAttribute("Team", team)
	model:SetAttribute("Bot", true)
	if opts and opts.match then model:SetAttribute("MatchId", opts.match) end
	if opts and opts.diff then model:SetAttribute("DmgMult", opts.diff.dmg) end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayName = "[BOT] " .. model.Name
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.Viewer
	hum.NameDisplayDistance = 40
	hum.WalkSpeed = 15 * (if opts and opts.diff then opts.diff.speed else 1)
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	model.Parent = getFolder()
	model:PivotTo(CFrame.new(at + Vector3.new(0, 3, 0)))
	pcall(function() root:SetNetworkOwner(nil) end)   -- physique gérée par le serveur (pas de triche possible)

	local b: Brain = {
		model = model, hum = hum, root = root, team = team, roam = roam, waypoints = {}, wpIndex = 1, goal = nil, repathAt = 0,
		target = nil, seenAt = 0, lastSeen = nil, lastSeenAt = -99, burstLeft = math.random(BOT.burst[1], BOT.burst[2]), nextBurst = 0, alive = true,
		match = opts and opts.match, diff = opts and opts.diff, goalFn = opts and opts.goal,
		nades = opts ~= nil and opts.nades == true, nadeT = 0, mineT = 1.5 + math.random() * 2,
	}
	brains[model] = b
	local secondary = if team == "Attaquants" then "glock" else "usp"
	WeaponService.giveLoadout(model, if opts and opts.loadout then opts.loadout else { BOT.primaries[math.random(#BOT.primaries)], secondary, "knife" })
	hum.Died:Connect(function() b.alive = false end)
	return model
end

function BotService.remove(model: Model)
	brains[model] = nil
	usedNames[model.Name] = nil
	WeaponService.reset(model)
	model:Destroy()
end

function BotService.removeAll()
	for m in pairs(brains) do BotService.remove(m) end
end

function BotService.list(): { Model }
	local l = {}
	for m in pairs(brains) do table.insert(l, m) end
	return l
end

-- En pause (fin de partie) : les bots ne bougent plus et ne tirent plus.
function BotService.setPaused(on: boolean)
	paused = on
	for _, b in pairs(brains) do b.hum:Move(Vector3.zero); b.hum.WalkSpeed = if on then 0 else 15 end
end

-- Bots d'une partie ; pause d'une seule partie (fin de match) ; suppression de tous ses bots
function BotService.ofMatch(id: number): { Model }
	local l = {}
	for m, b in pairs(brains) do if b.match == id then table.insert(l, m) end end
	return l
end
function BotService.freezeMatch(id: number, on: boolean)
	for m, b in pairs(brains) do
		if b.match == id then
			m:SetAttribute("Frozen", if on then true else nil)
			b.hum:Move(Vector3.zero); b.hum.WalkSpeed = if on then 0 else 15 * (if b.diff then b.diff.speed else 1) * ((b.model:GetAttribute("SpeedMult") :: number?) or 1)
		end
	end
end
function BotService.removeMatch(id: number)
	for m, b in pairs(brains) do if b.match == id then BotService.remove(m) end end
end
-- niveau d'un bot déjà en jeu (Zombies : les alliés visent au moins comme en Normal)
function BotService.setDiff(model: Model, diff: any)
	local b = brains[model]; if b then b.diff = diff; model:SetAttribute("DmgMult", diff.dmg) end
end
function BotService.setGoal(model: Model, fn: ((Model) -> Vector3?)?)
	local b = brains[model]; if b then b.goalFn = fn end
end

-- combat d'un bot (grenades des modes à manches) : ennemi visé, dernière position vue d'un ennemi et quand
function BotService.combatOf(model: Model): (Model?, Vector3?, number)
	local b = brains[model]
	if not b then return nil, nil, -99 end
	return b.target, b.lastSeen, os.clock() - b.lastSeenAt
end

function BotService.isBot(m: any): boolean
	return typeof(m) == "Instance" and brains[m] ~= nil
end

task.spawn(function()
	while true do
		task.wait(BOT.thinkRate)
		if paused then continue end
		for _, b in pairs(brains) do
			local ok, err = pcall(think, b)
			if not ok then warn("[BotService]", err) end
			if b.nades and b.alive then
				if not pcall(BotService.nadeStep, b.model, BOT.thinkRate, if b.diff and b.diff.nade then b.diff.nade else 0.6, 0.12, b :: any) then
					warn("[BotService] grenades : erreur pour", b.model.Name)
				end
			end
		end
	end
end)

return BotService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="418">
      <Properties>
        <string name="Name">CareerService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/CareerService (ModuleScript, requis par Main)
-- Carrière du joueur, comptée côté serveur :
--   • statistiques par arme (profile.career[arme] = { k, hs }) : éliminations et tirs à la tête en partie (pas les zombies
--     ni les cibles d'entraînement), qui font avancer la maîtrise d'arme (Shared/Mastery : camos Or, Diamant, Matière noire) ;
--   • défis qui avancent en partie : défi d'arme du jour (« kw_<arme> »), tirs à la tête par type d'arme (« hs_<type> »),
--     glissades et escalades (« slide », « climb », lues sur l'attribut Anim du personnage, cadence bornée) ;
--   • carte de joueur (Shared/PlayerCard : bannière + emblème, profile.card), recopiée dans l'attribut « Card » ;
--   • records du stand d'entraînement (profile.train : score, précision, temps de réaction), écrits par Modes/train ;
--   • version des nouveautés déjà vue (fenêtre « Quoi de neuf », profile.newsSeen).
-- Remote « Career » (RemoteFunction, cadence limitée) :
--   ("get")                         -> carrière, maîtrise, carte, records, déblocages
--   ("camo", arme, camo | "")       -> pose (ou retire) un camo de maîtrise débloqué sur cette arme
--   ("card", banniere, embleme)     -> équipe une carte débloquée
--   ("news", version)               -> mémorise la version des nouveautés vue
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Mastery = require(ReplicatedStorage.Shared.Mastery)
local PlayerCard = require(ReplicatedStorage.Shared.PlayerCard)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local LoyaltyService = require(script.Parent.LoyaltyService)
local WeaponService = require(script.Parent.WeaponService)
local MatchService = require(script.Parent.MatchService)
local RateLimit = require(script.Parent.RateLimit)

local CareerService = {}

local SLIDE, MANT = 1, 16          -- bits de l'attribut « Anim » (Shared/SoldierAnim : Anim.SLIDE, Anim.MANT)
local MOVE_GAP = 0.8               -- une glissade / escalade comptée toutes les 0,8 s au plus
local MOVES: { [number]: string } = { [SLIDE] = "slide", [MANT] = "climb" }

local function career(profile: any): { [string]: { k: number, hs: number } }
	if typeof(profile.career) ~= "table" then profile.career = {} end
	return profile.career
end

-- ---------- éliminations : carrière par arme et défis ----------
local function enemies(m: any, a: any, b: any): boolean
	if m.teams then return WeaponService.teamOf(a) ~= WeaponService.teamOf(b) end
	return a ~= b
end
WeaponService.Killed:Connect(function(killer, victim, key: string, headshot: boolean)
	if typeof(killer) ~= "Instance" or not killer:IsA("Player") or killer == victim then return end
	local m = MatchService.matchOf(victim)
	if not m or m.state ~= "live" or MatchService.matchOf(killer) ~= m or not enemies(m, killer, victim) then return end
	if typeof(victim) == "Instance" and (victim:GetAttribute("Zombie") or victim:GetAttribute("Dummy")) then return end
	local w = Config.WEAPONS[key]
	if not w then return end
	local p = killer :: Player
	local profile = DataService.get(p)
	if profile then
		local c = career(profile)
		local rec = c[key] or { k = 0, hs = 0 }
		local before = Mastery.level(rec, Mastery.diamonds(c))
		rec.k += 1
		if headshot then rec.hs += 1 end
		c[key] = rec
		-- palier de maîtrise atteint : petite annonce au centre de l'écran (remote ModePop, comme le stand de tir)
		if Mastery.eligible(Config.WEAPONS, key) then
			local after = Mastery.level(rec, Mastery.diamonds(c))
			if after > before then
				local t = Mastery.TIERS[after]
				local pop = ReplicatedStorage:FindFirstChild("ModePop")
				if pop and pop:IsA("RemoteEvent") then
					pop:FireClient(p, "MAÎTRISE " .. string.upper(t.name) .. " : " .. w.name .. " (camo débloqué)", t.color, "pickup")
				end
			end
		end
	end
	if not w.melee then
		RewardService.missionEvent(p, "kw_" .. key)
		if headshot and w.cat then RewardService.missionEvent(p, "hs_" .. w.cat) end
	end
end)

-- ---------- glissades et escalades (défis « slide » et « climb ») ----------
local lastMove: { [Player]: { [string]: number } } = {}
local function watchChar(p: Player, char: Model)
	local prev = 0
	char:GetAttributeChangedSignal("Anim"):Connect(function()
		local bits = char:GetAttribute("Anim")
		if typeof(bits) ~= "number" then return end
		local rose = bit32.band(bits, bit32.bnot(prev))
		prev = bits
		if rose == 0 then return end
		local m = MatchService.matchOf(p)
		if not m or m.state ~= "live" then return end
		local mine = lastMove[p] or {}; lastMove[p] = mine
		local t = os.clock()
		for bit, id in pairs(MOVES) do
			if bit32.band(rose, bit) ~= 0 and t - (mine[id] or 0) >= MOVE_GAP then
				mine[id] = t
				RewardService.missionEvent(p, id)
			end
		end
	end)
end

-- ---------- carte de joueur ----------
function CareerService.cardView(profile: any): PlayerCard.View
	local c = career(profile)
	local gold, diamonds, dark = 0, Mastery.diamonds(c), 0
	for k, rec in pairs(c) do
		if Mastery.eligible(Config.WEAPONS, k) then
			local l = Mastery.level(rec, diamonds)
			if l >= 1 then gold += 1 end
			if l >= 3 then dark += 1 end
		end
	end
	local level = RewardService.levelInfo(profile)
	local rank = profile.rank and tonumber(profile.rank.best) or 0
	local pk = if profile.ev and profile.ev.id == X.EVENT.id then tonumber(profile.ev.pumpkins) or 0 else 0
	return { level = level, ach = if typeof(profile.ach) == "table" then profile.ach else {}, medals = if typeof(profile.medals) == "table" then profile.medals else {},
		gold = gold, diamonds = diamonds, dark = dark, vip = LoyaltyService.isVip(profile), rankBest = math.floor((rank or 0) / X.RANK_RP_PER_DIVISION),
		pumpkins = pk }
end
-- recopie la carte (si elle est toujours débloquée, sinon celle de base) dans l'attribut « Card » du joueur
function CareerService.publish(p: Player)
	local profile = DataService.get(p)
	if not profile then return end
	local card = if typeof(profile.card) == "table" then profile.card else {}
	local v = CareerService.cardView(profile)
	local b = PlayerCard.findBanner(tostring(card.b))
	local e = PlayerCard.findEmblem(tostring(card.e))
	local bid = if b and PlayerCard.open(b.need, v) then b.id else "recrue"
	local eid = if e and PlayerCard.open(e.need, v) then e.id else "cible"
	p:SetAttribute("Card", bid .. "|" .. eid)
	p:SetAttribute("CardLevel", v.level)
end

-- ---------- stand d'entraînement : records (appelé par Modes/train) ----------
-- rec = { score, acc (%, nil si trop peu de tirs), rt (temps de réaction moyen, s), rtBest (meilleur, s) } ; renvoie true si record battu
function CareerService.trainRecord(p: Player, rec: { [string]: number? }): boolean
	local profile = DataService.get(p)
	if not profile then return false end
	if typeof(profile.train) ~= "table" then profile.train = {} end
	local t = profile.train
	local beat = false
	if rec.score and rec.score > (t.score or 0) then t.score = rec.score; beat = true end
	if rec.acc and rec.acc > (t.acc or 0) then t.acc = rec.acc end
	if rec.rt and (t.rt == nil or rec.rt < t.rt) then t.rt = rec.rt end
	if rec.rtBest and (t.rtBest == nil or rec.rtBest < t.rtBest) then t.rtBest = rec.rtBest end
	return beat
end

-- ---------- remote ----------
local fn = Instance.new("RemoteFunction"); fn.Name = "Career"; fn.Parent = ReplicatedStorage
fn.OnServerInvoke = function(p: Player, action: any, a1: any, a2: any): any
	if typeof(action) ~= "string" or not RateLimit.ok(p, "Career_" .. action, if action == "get" then 0.3 else 0.4) then return nil end
	local profile = DataService.get(p)
	if not profile then return nil end
	if action == "get" then
		local c = career(profile)
		local cur = if typeof(profile.card) == "table" then profile.card else {}
		local b, e = PlayerCard.decode(p:GetAttribute("Card"))
		return { career = c, diamonds = Mastery.diamonds(c), view = CareerService.cardView(profile), card = { b = cur.b or b, e = cur.e or e },
			train = profile.train or {}, camos = profile.equipped and profile.equipped.animCamo or {}, byWeapon = profile.stats and profile.stats.byWeapon or {},
			newsSeen = profile.newsSeen }
	elseif action == "camo" then
		if typeof(a1) ~= "string" or not Mastery.eligible(Config.WEAPONS, a1) or typeof(a2) ~= "string" then return { ok = false } end
		local eq = profile.equipped
		eq.animCamo = eq.animCamo or {}
		if a2 == "" then
			if Mastery.CAMOS[eq.animCamo[a1] or ""] then eq.animCamo[a1] = nil end   -- ne retire qu'un camo de maîtrise
		else
			if not Mastery.CAMOS[a2] then return { ok = false } end
			if not Mastery.camoOpen(career(profile), a1, a2) then return { ok = false, err = "Maîtrise pas encore atteinte sur cette arme" } end
			eq.animCamo[a1] = a2
		end
		DataService.syncSkins(p)
		return { ok = true, camos = eq.animCamo }
	elseif action == "card" then
		if typeof(a1) ~= "string" or typeof(a2) ~= "string" then return { ok = false } end
		local b, e = PlayerCard.findBanner(a1), PlayerCard.findEmblem(a2)
		local v = CareerService.cardView(profile)
		if not b or not e then return { ok = false } end
		if not PlayerCard.open(b.need, v) or not PlayerCard.open(e.need, v) then return { ok = false, err = "Pas encore débloqué" } end
		profile.card = { b = b.id, e = e.id }
		CareerService.publish(p)
		return { ok = true }
	elseif action == "news" then
		if a1 ~= MenuConfig.NEWS_VERSION then return false end
		profile.newsSeen = a1
		return true
	end
	return nil
end

-- ---------- arrivée ----------
local function arrive(p: Player)
	p.CharacterAdded:Connect(function(char) watchChar(p, char); CareerService.publish(p) end)
	if p.Character then watchChar(p, p.Character) end
	task.spawn(function()
		for _ = 1, 30 do
			if DataService.get(p) then CareerService.publish(p); return end
			task.wait(1)
		end
	end)
end
Players.PlayerAdded:Connect(arrive)
for _, p in ipairs(Players:GetPlayers()) do arrive(p) end
Players.PlayerRemoving:Connect(function(p) lastMove[p] = nil end)

return CareerService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="419">
      <Properties>
        <string name="Name">ClanService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ClanService (ModuleScript) — base pour les clans
-- Un clan = tag de 3-4 lettres, couleur, membres (max 30), stats cumulées. Stocké dans un DataStore dédié.
-- Version minimale : création, rejoindre, quitter, tag affiché dans le profil. À étendre (salon, classement, guerres).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TextService = game:GetService("TextService")

local DataService = require(script.Parent.DataService)
local STORE = require(script.Parent.Stores).get("StrikeArenaClans_v1")
local MAX_MEMBERS = 30
local CREATE_COST = 2000

local ClanService = {}

local function clean(tag: string, player: Player): string?
	tag = string.upper((tag:gsub("[^%w]", "")))
	if #tag < 3 or #tag > 4 then return nil end
	local ok, res = pcall(function() return TextService:FilterStringAsync(tag, player.UserId):GetNonChatStringForBroadcastAsync() end)
	if not ok or res ~= tag then return nil end                           -- refuse les tags filtrés
	return tag
end

local createFn = Instance.new("RemoteFunction"); createFn.Name = "ClanCreate"; createFn.Parent = ReplicatedStorage
createFn.OnServerInvoke = function(player: Player, tag: any, color: any)
	if typeof(tag) ~= "string" or typeof(color) ~= "Color3" then return false, "invalide" end
	local profile = DataService.get(player); if not profile then return false, "pas de profil" end
	if profile.clan then return false, "déjà dans un clan" end
	if profile.coins < CREATE_COST then return false, "pièces insuffisantes" end
	local t = clean(tag, player); if not t then return false, "tag refusé" end
	local created = false
	local ok = pcall(function()
		STORE:UpdateAsync("clan_" .. t, function(old)
			if old then return nil end                                       -- tag déjà pris
			created = true
			return { tag = t, color = { color.R, color.G, color.B }, owner = player.UserId, members = { player.UserId }, kills = 0, wins = 0 }
		end)
	end)
	if not ok or not created then return false, "tag déjà utilisé" end
	profile.coins -= CREATE_COST; profile.clan = t
	return true
end

local joinFn = Instance.new("RemoteFunction"); joinFn.Name = "ClanJoin"; joinFn.Parent = ReplicatedStorage
joinFn.OnServerInvoke = function(player: Player, tag: any)
	if typeof(tag) ~= "string" then return false end
	local profile = DataService.get(player); if not profile or profile.clan then return false end
	local t = string.upper(tag)
	local joined = false
	pcall(function()
		STORE:UpdateAsync("clan_" .. t, function(old)
			if not old or #old.members >= MAX_MEMBERS or table.find(old.members, player.UserId) then return nil end
			table.insert(old.members, player.UserId); joined = true
			return old
		end)
	end)
	if joined then profile.clan = t end
	return joined
end

local leaveFn = Instance.new("RemoteFunction"); leaveFn.Name = "ClanLeave"; leaveFn.Parent = ReplicatedStorage
leaveFn.OnServerInvoke = function(player: Player)
	local profile = DataService.get(player); if not profile or not profile.clan then return false end
	local t = profile.clan
	pcall(function()
		STORE:UpdateAsync("clan_" .. t, function(old)
			if not old then return nil end
			local i = table.find(old.members, player.UserId); if i then table.remove(old.members, i) end
			if #old.members == 0 then return nil end
			if old.owner == player.UserId then old.owner = old.members[1] end
			return old
		end)
	end)
	profile.clan = nil
	return true
end

function ClanService.tagOf(player: Player): string
	local p = DataService.get(player); return p and p.clan or ""
end

return ClanService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="420">
      <Properties>
        <string name="Name">CodeList</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/CodeList (ModuleScript, SERVEUR UNIQUEMENT)
-- Liste des codes promo. Elle reste côté serveur pour que personne ne puisse lire les codes à l'avance.
--
-- Pour sortir un nouveau code (à chaque mise à jour, ou quand le jeu atteint 1 000 / 10 000 likes) :
--   ajoute une ligne, publie le jeu, puis annonce le code sur Discord, YouTube ou dans la description du jeu.
--
-- Champs :
--   code     : en MAJUSCULES (le joueur peut le taper en minuscules, les espaces sont ignorés)
--   reward   : { coins = n, box = "std"|"prem", killfx = "id", dance = "id" } (tout est facultatif)
--   from/to  : dates UTC "AAAA-MM-JJ" (facultatif) ; en dehors, le code répond « expiré » ou « pas encore actif »
return {
	{ code = "BIENVENUE", reward = { coins = 100 } },
	{ code = "HALLOWEEN25", reward = { coins = 150, killfx = "pumpkins" }, from = "2026-10-15", to = "2026-11-08" },
	{ code = "DUEL", reward = { box = "std" } },
	-- exemples à activer plus tard :
	-- { code = "1KLIKES", reward = { coins = 300 } },
	-- { code = "SAISON2", reward = { box = "prem" }, from = "2026-12-01", to = "2026-12-31" },
}
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="421">
      <Properties>
        <string name="Name">CodeService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/CodeService (ModuleScript, requis par Main)
-- Codes promo (comme Arsenal, BedWars, Blox Fruits) et récompense du groupe Roblox.
-- Tout est vérifié côté serveur : un code ne marche qu'une fois par joueur, avec une limite d'essais contre le forçage.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
local DataService = require(script.Parent.DataService)
local CODES = require(script.Parent.CodeList)

local CodeService = {}

-- ---------- donner un lot de récompenses ----------
-- reward = { coins, box, killfx, dance } ; renvoie la liste lisible de ce qui a été donné
function CodeService.grant(profile: any, reward: any): { string }
	local lines = {}
	if reward.coins then
		profile.coins += reward.coins
		table.insert(lines, "💰 " .. reward.coins .. " pièces")
	end
	if reward.box then
		profile.boxes[reward.box] = (profile.boxes[reward.box] or 0) + 1
		table.insert(lines, if reward.box == "prem" then "📦 Caisse Premium" else "📦 Caisse Standard")
	end
	if reward.killfx then
		profile.inv.killfx = profile.inv.killfx or {}
		if not table.find(profile.inv.killfx, reward.killfx) then table.insert(profile.inv.killfx, reward.killfx) end
		local fx = KillFxConfig.get(reward.killfx)
		table.insert(lines, "💥 Effet « " .. (fx and fx.name or reward.killfx) .. " »")
	end
	if reward.dance and not table.find(profile.inv.dances, reward.dance) then
		table.insert(profile.inv.dances, reward.dance)
		table.insert(lines, "💃 Danse")
	end
	return lines
end

-- ---------- codes promo ----------
local byCode: { [string]: any } = {}
for _, c in ipairs(CODES) do byCode[string.upper(c.code)] = c end

local tries: { [Player]: { last: number, window: number, count: number } } = {}
local function rateLimited(p: Player): boolean
	local t = os.clock()
	local r = tries[p] or { last = 0, window = t, count = 0 }
	tries[p] = r
	if t - r.last < 1.5 then return true end
	if t - r.window > 60 then r.window = t; r.count = 0 end
	r.count += 1; r.last = t
	return r.count > 10                 -- 10 essais par minute au maximum
end

function CodeService.redeem(player: Player, raw: string)
	if rateLimited(player) then return { ok = false, msg = "Doucement ! Réessaie dans quelques secondes." } end
	local profile = DataService.get(player)
	if not profile then return { ok = false, msg = "Profil pas encore chargé" } end
	local code = string.upper((string.gsub(raw, "%s", "")))
	if #code == 0 or #code > 30 then return { ok = false, msg = "Code invalide" } end
	local c = byCode[code]
	if not c then return { ok = false, msg = "Code invalide" } end
	local today = os.date("!%Y-%m-%d") :: string
	if c.from and today < c.from then return { ok = false, msg = "Ce code n'est pas encore actif" } end
	if c.to and today > c.to then return { ok = false, msg = "Ce code a expiré" } end
	profile.codes = profile.codes or {}
	if table.find(profile.codes, code) then return { ok = false, msg = "Tu as déjà utilisé ce code" } end
	table.insert(profile.codes, code)
	local lines = CodeService.grant(profile, c.reward)
	task.spawn(DataService.save, player)
	return { ok = true, msg = "Code accepté !", lines = lines }
end

-- ---------- groupe Roblox ----------
local function inGroup(player: Player, groupId: number): boolean
	local ok, res = pcall(function() return (player :: any):IsInGroupAsync(groupId) end)
	if ok then return res == true end
	ok, res = pcall(function() return player:IsInGroup(groupId) end)   -- ancienne méthode si la nouvelle n'existe pas
	return ok and res == true
end

function CodeService.claimGroup(player: Player)
	local G = CommunityConfig.GROUP
	if G.id <= 0 then return { ok = false, msg = "Le groupe n'est pas encore ouvert" } end
	local profile = DataService.get(player)
	if not profile then return { ok = false, msg = "Profil pas encore chargé" } end
	profile.social = profile.social or {}
	if profile.social.group then return { ok = false, msg = "Récompense déjà récupérée", claimed = true } end
	if not inGroup(player, G.id) then return { ok = false, msg = "Rejoins d'abord le groupe, puis réessaie" } end
	-- inGroup attend Roblox : deux demandes envoyées en même temps passeraient toutes les deux le premier test
	if profile.social.group then return { ok = false, msg = "Récompense déjà récupérée", claimed = true } end
	profile.social.group = os.time()
	local lines = CodeService.grant(profile, G.reward)
	task.spawn(DataService.save, player)
	return { ok = true, msg = "Merci d'avoir rejoint le groupe !", lines = lines, claimed = true }
end

function CodeService.groupStatus(player: Player)
	local profile = DataService.get(player)
	return { groupId = CommunityConfig.GROUP.id, claimed = profile ~= nil and profile.social ~= nil and profile.social.group ~= nil }
end

-- ---------- remotes ----------
local function remote(name: string, fn: (Player, ...any) -> any)
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; r.OnServerInvoke = fn
end
remote("RedeemCode", function(p, code: any)
	if typeof(code) ~= "string" then return { ok = false, msg = "Code invalide" } end
	return CodeService.redeem(p, code)
end)
remote("ClaimGroupReward", function(p) return CodeService.claimGroup(p) end)
remote("GetGroupStatus", function(p) return CodeService.groupStatus(p) end)

Players.PlayerRemoving:Connect(function(p) tries[p] = nil end)

return CodeService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="422">
      <Properties>
        <string name="Name">DataService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/DataService (ModuleScript)
-- Sauvegarde du profil joueur : XP, pièces, inventaire (skins/danses), caisses, pitié, stats, défis, série quotidienne.
-- Ne JAMAIS faire confiance au client : toutes les modifications passent par le serveur.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local Stores = require(script.Parent.Stores)
local STORE = Stores.get("StrikeArenaProfile_v1")
local AUTOSAVE_INTERVAL = 60

local DataService = {}
local profiles: { [Player]: any } = {}
local loadFailed: { [Player]: boolean } = {}   -- lecture ratée : on ne sauvegarde pas, sinon on écraserait le vrai profil

local function template()
	return {
		version = 1,
		xp = 0,
		coins = 250,
		lastLoginDay = 0,            -- jour UTC (os.time() // 86400)
		streak = 0,
		inv = { skins = {}, dances = { "wave", "clap" }, weapons = {}, outfits = {}, sights = {}, reticles = {}, misc = {}, exclusive = {}, killfx = {} },   -- exclusive = camos animés achetés en Robux   -- skins[weaponKey] = { skinIndex, ... } ; voir Shared/ShopCatalog
		equippedDance = "wave",
		equipped = { outfit = 1, reticle = "dot_red", trail = "", sights = {}, animCamo = {}, killFx = "none" },   -- animCamo[weaponKey] = camo animé (ConfigExtra.EXCLUSIVES)   -- sights[weaponKey] = id de ConfigExtra.SIGHTS
		boxes = { std = 1, prem = 0 },
		pity = { epic = 0, legend = 0 },
		opened = 0,
		stats = { matches = 0, wins = 0, kills = 0, deaths = 0, hs = 0, dmg = 0, shots = 0, hits = 0, seconds = 0, bestStreak = 0, byMode = {}, byMap = {}, byWeapon = {} },
		history = {},
		missions = { day = 0, list = {} },
		binds = {},                 -- touches personnalisées (synchronisées avec le client)
		codes = {},                 -- codes promo déjà utilisés (CodeService)
		purchases = {},             -- offres uniques déjà achetées en Robux (pack de départ : ShopService)
		social = {},                -- social.group = date de la récompense du groupe Roblox
		duel = { elo = 1000, w = 0, l = 0, best = 1000 },   -- duels 1v1 / 2v2 (DuelService)
		lobby = { rangeBest = 0, rangeRewarded = false, parkourBest = 0, parkourRewarded = false },
	}
end

local function reconcile(data: any, tpl: any)
	for k, v in pairs(tpl) do
		if data[k] == nil then
			data[k] = if type(v) == "table" then table.clone(v) else v
		elseif type(v) == "table" and type(data[k]) == "table" then
			reconcile(data[k], v)
		end
	end
end

-- Verrou de session (champ _lock du profil enregistré) : un joueur qui change vite de serveur ne doit pas voir
-- l'ancien serveur écraser, en sauvegardant en retard, ce que le nouveau a déjà chargé. Le verrou est posé au chargement,
-- rafraîchi à chaque sauvegarde et levé au départ ; au-delà de LOCK_STALE secondes (serveur planté), il est repris.
local LOCK_STALE = 300
local function lockedByOther(old: any): boolean
	local lk = typeof(old) == "table" and old._lock
	return typeof(lk) == "table" and lk.job ~= game.JobId and typeof(lk.t) == "number" and os.time() - lk.t < LOCK_STALE
end

function DataService.load(player: Player)
	local key = "u_" .. player.UserId
	local data, loaded = nil, false
	for attempt = 1, 6 do
		local claimed, busy = false, false
		local ok, res = pcall(function()
			return STORE:UpdateAsync(key, function(old: any)
				claimed, busy = false, false
				-- encore ouvert sur un autre serveur : on attend qu'il sauvegarde (on le reprend au dernier essai)
				if lockedByOther(old) and attempt < 6 then busy = true; return nil end
				local out = if typeof(old) == "table" then old else template()
				out._lock = { job = game.JobId, t = os.time() }
				claimed = true
				return out
			end)
		end)
		if ok and claimed then data = res; loaded = true; break end
		if not ok then warn("[DataService] lecture échouée (" .. attempt .. ")", res) end
		if not player.Parent then return nil end
		task.wait(if busy then 3 else 1.5 * attempt)
	end
	if not loaded then
		loadFailed[player] = true
		warn("[DataService] profil de " .. player.Name .. " non chargé : partie jouable, mais rien ne sera sauvegardé")
	end
	data = if typeof(data) == "table" then table.clone(data) else template()
	data._lock = nil
	reconcile(data, template())
	profiles[player] = data
	-- parti pendant le chargement : PlayerRemoving est déjà passé, on enregistre (verrou levé) et on oublie le profil
	if not player.Parent then
		DataService.save(player, true)
		profiles[player] = nil; loadFailed[player] = nil
		return nil
	end
	-- armes choisies dans le menu de chargement (LoadoutUI), gardées d'une session à l'autre
	if typeof(data.loadout) == "table" then
		if typeof(data.loadout.primary) == "string" then player:SetAttribute("Primary", data.loadout.primary) end
		if typeof(data.loadout.secondary) == "string" then player:SetAttribute("Secondary", data.loadout.secondary) end
	end
	DataService.syncSkins(player)
	return data
end

-- Skins équipés recopiés en attributs du joueur (Skin_<arme> = numéro de Config.SKINS, Camo_<arme> = camo animé) :
-- l'arme en main (vue subjective) et l'arme vue par les autres sont peintes d'après eux.
function DataService.syncSkins(player: Player)
	local data = profiles[player]
	if not data then return end
	local Config = require(game:GetService("ReplicatedStorage").Shared.Config)
	local camos = data.equipped and data.equipped.animCamo or {}
	for key in pairs(Config.WEAPONS) do
		local sk = data.equippedSkins and data.equippedSkins[key]
		player:SetAttribute("Skin_" .. key, if typeof(sk) == "number" and sk > 1 then sk else nil)
		player:SetAttribute("Camo_" .. key, if typeof(camos[key]) == "string" then camos[key] else nil)
	end
	-- traînée des balles équipée (boutique) : les clients colorent nos balles traçantes (ShotFx)
	local trail = data.equipped and data.equipped.trail
	player:SetAttribute("Trail", if typeof(trail) == "string" and trail ~= "" then trail else nil)
end

-- Sauvegarde : une seule écriture à la fois par joueur, au plus une toutes les WRITE_GAP secondes (limite Roblox par clé) ;
-- les demandes qui arrivent pendant une écriture sont regroupées dans la suivante. Renvoie true si le profil est enregistré.
-- release = départ du joueur : le verrou de session est levé.
local WRITE_GAP = 6
local inflight: { [Player]: boolean } = {}
local again: { [Player]: boolean } = {}
local lastWrite: { [Player]: number } = {}
local lastOk: { [Player]: boolean } = {}
local releasing: { [Player]: boolean } = {}

function DataService.canSave(player: Player): boolean
	return profiles[player] ~= nil and not loadFailed[player]
end

function DataService.save(player: Player, release: boolean?): boolean
	local data = profiles[player]
	if not data or loadFailed[player] then return false end
	if release then releasing[player] = true end
	if inflight[player] then
		again[player] = true
		while inflight[player] do task.wait(0.2) end
		return lastOk[player] == true
	end
	inflight[player] = true
	local key = "u_" .. player.UserId
	local saved = false
	repeat
		again[player] = nil
		local gap = WRITE_GAP - (os.clock() - (lastWrite[player] or -WRITE_GAP))
		if gap > 0 then task.wait(gap) end
		saved = false
		for attempt = 1, 4 do
			local stolen = false
			local free = releasing[player] == true
			local ok, err = pcall(function()
				STORE:UpdateAsync(key, function(old: any)
					stolen = false
					if lockedByOther(old) then stolen = true; return nil end   -- repris par un autre serveur : on n'écrase rien
					local out = table.clone(data)
					out._lock = if free then nil else { job = game.JobId, t = os.time() }
					return out
				end)
			end)
			lastWrite[player] = os.clock()
			if ok and stolen then
				warn("[DataService] profil de " .. player.Name .. " ouvert sur un autre serveur : sauvegarde coupée ici")
				loadFailed[player] = true
				break
			end
			if ok then saved = true; break end
			warn("[DataService] écriture échouée (" .. attempt .. ")", err)
			task.wait(1.5 * attempt)
		end
	until not again[player] or loadFailed[player]
	lastOk[player] = saved
	inflight[player] = nil
	return saved
end

function DataService.get(player: Player)
	return profiles[player]
end

local function forget(p: Player)
	profiles[p] = nil; loadFailed[p] = nil
	again[p] = nil; lastWrite[p] = nil; lastOk[p] = nil; releasing[p] = nil
end
Players.PlayerAdded:Connect(function(p) DataService.load(p) end)
Players.PlayerRemoving:Connect(function(p) DataService.save(p, true); forget(p) end)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(DataService.load, p) end

task.spawn(function()
	while true do
		task.wait(AUTOSAVE_INTERVAL)
		for p in pairs(profiles) do task.spawn(DataService.save, p) end
	end
end)

-- fermeture du serveur : toutes les sauvegardes en parallèle (30 s au plus), verrous levés
game:BindToClose(function()
	if RunService:IsStudio() then return end
	local left = 0
	for p in pairs(profiles) do
		left += 1
		task.spawn(function() pcall(DataService.save, p, true); left -= 1 end)
	end
	local t0 = os.clock()
	while left > 0 and os.clock() - t0 < 26 do task.wait(0.2) end
end)

return DataService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="423">
      <Properties>
        <string name="Name">DuelService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/DuelService (ModuleScript, requis par Main quand le lobby est activé)
-- Duels façon Rivals : on monte sur une plateforme du lobby (1v1 ou 2v2, avec ou sans mise), le duel démarre dès
-- qu'elle est pleine. Premier à CommunityConfig.DUEL.roundsToWin manches, une seule vie par manche.
-- La mise de chacun va dans un pot que l'équipe gagnante se partage. Chaque duel fait bouger le classement Elo.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
local DataService = require(script.Parent.DataService)
local WeaponService = require(script.Parent.WeaponService)
local RewardService = require(script.Parent.RewardService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local LobbyService = require(script.Parent.LobbyService)

local D = CommunityConfig.DUEL

local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local stateEvent = remoteEvent("DuelState")   -- serveur -> duellistes : manche, score, chrono, message
local endEvent = remoteEvent("DuelEnd")       -- serveur -> chaque duelliste : victoire/défaite, Elo, pièces

local DuelService = {}

-- ==========================================================================================
-- Arènes : petites salles symétriques construites loin de tout, réutilisées d'un duel à l'autre
-- ==========================================================================================
type Arena = { slot: number, folder: Folder, spawnsA: { Vector3 }, spawnsB: { Vector3 } }
local arenas: { [number]: Arena } = {}
local busy: { [number]: boolean } = {}

local function part(parent: Instance, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?): Part
	local p = Instance.new("Part")
	p.Anchored = true; p.Size = size; p.CFrame = cf; p.Color = color; p.Material = material or Enum.Material.Concrete
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function buildArena(slot: number): Arena
	local O = D.arenaOrigin + Vector3.new(slot * 400, 0, 0)
	local folder = Instance.new("Folder"); folder.Name = "DuelArena_" .. slot; folder.Parent = workspace
	local S, H = 110, 22
	local wall = Color3.fromRGB(58, 64, 82)
	part(folder, Vector3.new(S, 2, S), CFrame.new(O + Vector3.new(0, -1, 0)), Color3.fromRGB(80, 86, 102))
	for _, d in ipairs({ { 0, S / 2, true }, { 0, -S / 2, true }, { S / 2, 0, false }, { -S / 2, 0, false } }) do
		part(folder, if d[3] then Vector3.new(S, H, 2) else Vector3.new(2, H, S), CFrame.new(O + Vector3.new(d[1] :: number, H / 2, d[2] :: number)), wall)
	end
	part(folder, Vector3.new(S, 1, 2), CFrame.new(O + Vector3.new(0, 2, -S / 2 + 1.5)), Color3.fromRGB(255, 70, 85), Enum.Material.Neon)
	part(folder, Vector3.new(S, 1, 2), CFrame.new(O + Vector3.new(0, 2, S / 2 - 1.5)), Color3.fromRGB(74, 163, 255), Enum.Material.Neon)
	-- abris symétriques (caisses et murets) pour des duels tactiques
	local crate = Color3.fromRGB(165, 118, 64)
	for _, c in ipairs({ { 0, 0, 10, 8, 10 }, { -24, -18, 8, 6, 8 }, { 24, 18, 8, 6, 8 }, { 24, -18, 8, 6, 8 }, { -24, 18, 8, 6, 8 },
		{ 0, -30, 18, 4, 3 }, { 0, 30, 18, 4, 3 }, { -40, 0, 3, 7, 14 }, { 40, 0, 3, 7, 14 } }) do
		part(folder, Vector3.new(c[3], c[4], c[5]), CFrame.new(O + Vector3.new(c[1], c[4] / 2, c[2])), crate, Enum.Material.WoodPlanks)
	end
	local a = {
		slot = slot, folder = folder,
		spawnsA = { O + Vector3.new(-6, 3, -46), O + Vector3.new(6, 3, -46) },
		spawnsB = { O + Vector3.new(6, 3, 46), O + Vector3.new(-6, 3, 46) },
	}
	return a
end

local function takeArena(): Arena
	local slot = 0
	while busy[slot] do slot += 1 end
	busy[slot] = true
	if not arenas[slot] then arenas[slot] = buildArena(slot) end
	return arenas[slot]
end

-- ==========================================================================================
-- Elo
-- ==========================================================================================
local function eloOf(p: Player): number
	local profile = DataService.get(p)
	return profile and profile.duel and profile.duel.elo or D.startElo
end

local function average(list: { Player }): number
	if #list == 0 then return D.startElo end
	local sum = 0
	for _, p in ipairs(list) do sum += eloOf(p) end
	return sum / #list
end

-- ==========================================================================================
-- Un duel
-- ==========================================================================================
local nextId = 0

local function alive(p: Player): boolean
	local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
	return p.Parent ~= nil and h ~= nil and h.Health > 0
end

local function present(list: { Player }): { Player }
	local out = {}
	for _, p in ipairs(list) do if p.Parent and p:GetAttribute("Zone") == "duel" then table.insert(out, p) end end
	return out
end

local function runDuel(def: any, players: { Player }, arena: Arena)
	nextId += 1
	local id = nextId
	for i = #players, 2, -1 do local j = math.random(i); players[i], players[j] = players[j], players[i] end
	local teamA, teamB = {}, {}
	for i, p in ipairs(players) do table.insert(if i <= def.size then teamA else teamB, p) end
	local tagA, tagB = "DuelA_" .. id, "DuelB_" .. id

	-- mises : chacun paie en entrant (vérifié juste avant), le pot va aux gagnants
	local pot = 0
	local paid: { [Player]: number } = {}   -- mise réellement prise (des pièces ont pu être dépensées depuis la plateforme)
	for _, p in ipairs(players) do
		local profile = DataService.get(p)
		p:SetAttribute("DuelQueued", nil)
		p:SetAttribute("Zone", "duel")
		p:SetAttribute("DuelTeam", if table.find(teamA, p) then tagA else tagB)
		p.Team = nil
		if def.stake > 0 and profile then
			local pay = math.clamp(profile.coins, 0, def.stake)   -- jamais de solde négatif
			profile.coins -= pay; paid[p] = pay; pot += pay
		end
	end

	local score = { A = 0, B = 0 }
	local function nameList(list: { Player }): string
		local n = {}
		for _, p in ipairs(list) do table.insert(n, p.DisplayName) end
		return table.concat(n, " & ")
	end
	local function send(phase: string, extra: { [string]: any }?)
		for _, p in ipairs(present(players)) do
			local mine = table.find(teamA, p) ~= nil
			local msg = {
				phase = phase, mode = def.name, toWin = D.roundsToWin, stake = def.stake, pot = pot,
				me = if mine then score.A else score.B, them = if mine then score.B else score.A,
				myTeam = nameList(if mine then teamA else teamB), theirTeam = nameList(if mine then teamB else teamA),
			}
			for k, v in pairs(extra or {}) do msg[k] = v end
			stateEvent:FireClient(p, msg)
		end
	end

	local killConn = WeaponService.Killed:Connect(function(killer, victim)
		if typeof(victim) ~= "Instance" or not table.find(players, victim) then return end
		local text = WeaponService.nameOf(killer) .. " a éliminé " .. WeaponService.nameOf(victim)
		send("feed", { feed = text })
	end)

	local function spawnRound(p: Player, spawnPos: Vector3, facing: Vector3)
		WeaponService.reset(p)
		p:LoadCharacter()
		local char = p.Character or p.CharacterAdded:Wait()
		char:PivotTo(CFrame.lookAt(spawnPos, Vector3.new(facing.X, spawnPos.Y, facing.Z)))
		local hum = char:WaitForChild("Humanoid") :: Humanoid
		hum.WalkSpeed = 0; hum.JumpPower = 0
	end

	local round = 0
	while score.A < D.roundsToWin and score.B < D.roundsToWin do
		local A, B = present(teamA), present(teamB)
		if #A == 0 or #B == 0 then break end
		round += 1
		local center = (arena.spawnsA[1] + arena.spawnsB[1]) / 2
		for i, p in ipairs(A) do task.spawn(spawnRound, p, arena.spawnsA[i] or arena.spawnsA[1], center) end
		for i, p in ipairs(B) do task.spawn(spawnRound, p, arena.spawnsB[i] or arena.spawnsB[1], center) end
		for c = D.countdown, 1, -1 do
			send("countdown", { round = round, count = c })
			task.wait(1)
		end
		for _, p in ipairs(present(players)) do
			local hum = p.Character and p.Character:FindFirstChildOfClass("Humanoid")
			if hum then hum.WalkSpeed = 16; hum.JumpPower = 50 end
			local primary = p:GetAttribute("Primary")
			local w = typeof(primary) == "string" and Config.WEAPONS[primary]
			local sec = p:GetAttribute("Secondary")
			local sw = typeof(sec) == "string" and Config.WEAPONS[sec]
			WeaponService.giveLoadout(p, { if w and w.slot == 0 then primary :: string else D.defaultPrimary,
				if sw and sw.slot == 1 then sec :: string else D.secondary, "knife" })
		end
		local endsAt = os.clock() + D.roundTime
		send("live", { round = round, timeLeft = D.roundTime })
		local winner: string? = nil
		while true do
			task.wait(0.25)
			local aliveA, aliveB = 0, 0
			for _, p in ipairs(present(teamA)) do if alive(p) then aliveA += 1 end end
			for _, p in ipairs(present(teamB)) do if alive(p) then aliveB += 1 end end
			if aliveA == 0 or aliveB == 0 then
				winner = if aliveA > 0 then "A" elseif aliveB > 0 then "B" else nil
				break
			end
			if os.clock() >= endsAt then
				-- temps écoulé : l'équipe qui a le plus de vie l'emporte
				local hpA, hpB = 0, 0
				for _, p in ipairs(present(teamA)) do local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid"); if h then hpA += h.Health end end
				for _, p in ipairs(present(teamB)) do local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid"); if h then hpB += h.Health end end
				winner = if hpA > hpB then "A" elseif hpB > hpA then "B" else nil
				break
			end
		end
		if winner then score[winner] += 1 end
		for _, p in ipairs(present(players)) do
			local mine = if table.find(teamA, p) then "A" else "B"
			stateEvent:FireClient(p, { phase = "round", round = round, toWin = D.roundsToWin, mode = def.name, stake = def.stake, pot = pot,
				me = score[mine], them = score[if mine == "A" then "B" else "A"],
				result = if winner == nil then "draw" elseif winner == mine then "win" else "loss" })
		end
		task.wait(2.5)
	end
	killConn:Disconnect()

	-- vainqueur : le plus de manches ; si une équipe est partie, l'autre gagne
	local A, B = present(teamA), present(teamB)
	local winnerSide: string? = if score.A > score.B then "A" elseif score.B > score.A then "B" else nil
	if #A == 0 and #B > 0 then winnerSide = "B" elseif #B == 0 and #A > 0 then winnerSide = "A" end

	local eloA, eloB = average(teamA), average(teamB)
	local expectA = 1 / (1 + 10 ^ ((eloB - eloA) / 400))
	local winners = if winnerSide == "A" then A elseif winnerSide == "B" then B else {}
	local share = if #winners > 0 then math.floor(pot / #winners) else 0

	for _, p in ipairs(present(players)) do
		local side = if table.find(teamA, p) then "A" else "B"
		local won = winnerSide == side
		local profile = DataService.get(p)
		local delta, coins = 0, 0
		if profile then
			local expected = if side == "A" then expectA else 1 - expectA
			local result = if winnerSide == nil then 0.5 elseif won then 1 else 0
			delta = math.floor(D.eloK * (result - expected) + 0.5)
			local duel = profile.duel
			duel.elo = math.max(0, duel.elo + delta)
			duel.best = math.max(duel.best or 0, duel.elo)
			if winnerSide ~= nil then if won then duel.w += 1 else duel.l += 1 end end
			LeaderboardService.setDuelElo(p, duel.elo)
			if won then coins = share; profile.coins += share end
			if winnerSide == nil and def.stake > 0 then coins = paid[p] or 0; profile.coins += coins end   -- égalité : mise rendue
			RewardService.addXP(p, 40 + (if won then 60 else 0))
			if won then RewardService.missionEvent(p, "win") end
		end
		local rank = CommunityConfig.duelRank(profile and profile.duel.elo or D.startElo)
		endEvent:FireClient(p, { won = won, draw = winnerSide == nil, me = score[side], them = score[if side == "A" then "B" else "A"],
			eloDelta = delta, elo = profile and profile.duel.elo or D.startElo, rank = rank.name, coins = coins, stake = def.stake })
	end

	task.wait(4)
	for _, p in ipairs(present(players)) do task.spawn(LobbyService.spawn, p) end
	busy[arena.slot] = nil
end

-- ==========================================================================================
-- Plateformes du lobby : détection des joueurs debout dessus
-- ==========================================================================================
local function onPad(p: Player, pad: BasePart): boolean
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return false end
	local d = root.Position - pad.Position
	return Vector3.new(d.X, 0, d.Z).Magnitude < 8 and d.Y > -2 and d.Y < 8
end

function DuelService.start()
	task.spawn(function()
		while true do
			task.wait(0.5)
			local taken: { [Player]: boolean } = {}
			for _, pad in ipairs(LobbyService.duelPads) do
				local def = pad.def
				local need = def.size * 2
				local on = {}
				for _, p in ipairs(Players:GetPlayers()) do
					if not taken[p] and p:GetAttribute("Zone") == "lobby" and alive(p) and onPad(p, pad.part) then
						local profile = DataService.get(p)
						if def.stake > 0 and (not profile or profile.coins < def.stake) then
							if not p:GetAttribute("StakeWarned") then
								p:SetAttribute("StakeWarned", true)
								LobbyService.toast(p, "Il te faut " .. def.stake .. " 💰 pour cette mise", Color3.fromRGB(255, 90, 90))
								task.delay(5, function() p:SetAttribute("StakeWarned", nil) end)
							end
						else
							table.insert(on, p); taken[p] = true
						end
					end
				end
				for _, p in ipairs(Players:GetPlayers()) do
					if p:GetAttribute("Zone") == "lobby" then
						if table.find(on, p) then p:SetAttribute("DuelQueued", def.id)
						elseif p:GetAttribute("DuelQueued") == def.id then p:SetAttribute("DuelQueued", nil) end
					end
				end
				pad.label.Text = def.name .. "  ·  " .. math.min(#on, need) .. "/" .. need .. (if def.stake > 0 then "  ·  " .. def.stake .. " 💰" else "")
				if #on >= need then
					local group = {}
					for i = 1, need do table.insert(group, on[i]) end
					for _, p in ipairs(group) do p:SetAttribute("Zone", "duel") end   -- bloque tout de suite (pas de double départ)
					local arena = takeArena()
					task.spawn(function()
						local ok, err = pcall(runDuel, def, group, arena)
						if not ok then
							warn("[DuelService] duel interrompu :", err)
							busy[arena.slot] = nil
							for _, p in ipairs(group) do if p.Parent then task.spawn(LobbyService.spawn, p) end end
						end
					end)
				end
			end
		end
	end)
end

return DuelService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="424">
      <Properties>
        <string name="Name">GrenadeService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/GrenadeService (ModuleScript, branché par WeaponService.init)
-- Grenades frag / flash / fumigène et mines de proximité du jeu web (src/60_game.js, src/63_agents.js) :
-- stock par combattant (attribut « Nades » = "frag,flash,smoke,mine" pour le HUD), lancer validé et simulé
-- ici (rebonds, mèche), dégâts et aveuglement calculés ici ; les clients reçoivent « GrenadeFx » pour l'affichage.
-- Fumée : WeaponService.smokeBlocks(a, b) dit si un nuage coupe la vue (pour l'IA des bots).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local G = require(ReplicatedStorage.Shared.Grenades)
local M = G.M

local GrenadeService = {}
local WS: any = nil              -- WeaponService (injecté par init, évite la dépendance circulaire)

local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local fxEvent = remoteEvent("GrenadeFx")          -- serveur -> tous : { op = "throw" | "boom" | "mine" | "mineOff", ... }
local throwEvent = remoteEvent("ThrowGrenade")    -- client -> serveur : (type, regard)
local mineEvent = remoteEvent("PlaceMine")        -- client -> serveur : ()
local toastEvent = remoteEvent("GrenadeToast")    -- serveur -> joueur : texte court (« Mine posée », « Mine détruite »)
local flashFx = remoteEvent("FlashFeedback")    -- serveur -> joueur aveuglé (créé ici : WeaponService requiert ce module avant ses remotes)

type Stock = { frag: number, flash: number, smoke: number, mine: number }
local stocks: { [any]: Stock } = {}
local nades: { G.Nade } = {}
local nextId = 0
type Mine = { id: number, owner: any, team: string?, pos: Vector3, model: Model, armT: number, match: any }
local mines: { Mine } = {}
local smokes: { { p: Vector3, t: number } } = {}

local function publish(c: any)
	if typeof(c) ~= "Instance" then return end
	local s = stocks[c]
	if not s then c:SetAttribute("Nades", nil) return end
	c:SetAttribute("Nades", s.frag .. "," .. s.flash .. "," .. s.smoke .. "," .. s.mine)
end

function GrenadeService.set(c: any, frag: number, flash: number, smoke: number, mine: number)
	stocks[c] = { frag = frag, flash = flash, smoke = smoke, mine = mine }
	publish(c)
end
function GrenadeService.get(c: any): Stock?
	return stocks[c]
end
-- rend une grenade de ce type si le combattant n'en a plus (« Grenades à volonté ») ; true si rendue
function GrenadeService.refill(c: any, kind: string): boolean
	local s = stocks[c]
	if not s then s = { frag = 0, flash = 0, smoke = 0, mine = 0 }; stocks[c] = s end
	local st = s :: any
	if (st[kind] or 0) > 0 then return false end
	st[kind] = 1
	publish(c)
	return true
end
-- équipement de départ du web (dmLoadout) : joueur 1 de chaque ; bot frag 50 %, fumigène 20 %, mine 35 %
function GrenadeService.defaultKit(c: any)
	if typeof(c) == "Instance" and c:IsA("Player") then GrenadeService.set(c, 1, 1, 1, 1)
	else GrenadeService.set(c, if math.random() < .5 then 1 else 0, 0, if math.random() < .2 then 1 else 0, if math.random() < .35 then 1 else 0) end
end

local function rootOf(c: any): BasePart?
	local char = WS.charOf(c)
	return char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local function alive(c: any): boolean
	local char = WS.charOf(c)
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end
local function characters(): { Instance }
	local out = {}
	for c in WS.eachCombatant() do local ch = WS.charOf(c); if ch then table.insert(out, ch) end end
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(out, p.Character) end end
	return out
end
local function wallBetween(a: Vector3, b: Vector3, ignore: { Instance }): boolean
	local params = G.params(ignore)
	return G.cast(a, b - a, params) ~= nil
end

-- ---------- mines ----------
local function removeMine(m: Mine, boom: boolean)
	local i = table.find(mines, m)
	if not i then return end
	table.remove(mines, i)
	m.model:Destroy()
	fxEvent:FireAllClients({ op = "mineOff", p = m.pos, boom = boom })
	if not boom then return end
	-- explosion : 95 × (1 − d/5) + 10 dans 5 m (écart de hauteur < 2,2 m), coéquipiers épargnés mais pas le poseur
	for c in WS.eachCombatant() do
		local r = rootOf(c)
		local char = WS.charOf(c)
		if r and char and alive(c) then
			local d = Vector3.new(r.Position.X - m.pos.X, 0, r.Position.Z - m.pos.Z).Magnitude / M
			local dy = math.abs(r.Position.Y - 3 - m.pos.Y) / M
			local mate = m.team ~= nil and WS.teamOf(c) == m.team and c ~= m.owner
			if d <= G.MINE.r and dy <= 2.2 and not mate then
				WS.applyDamage(if c == m.owner then nil else m.owner, char, math.floor(95 * (1 - d / G.MINE.r) + 10 + .5), false, "mine", .5)
			end
		end
	end
end
local function isFoeMine(m: Mine, c: any): boolean
	return m.owner ~= c and (m.team == nil or WS.teamOf(c) ~= m.team)
end
-- balle sur une pièce de mine : renvoie true si c'était une mine (cassée, pas d'explosion)
function GrenadeService.bulletHit(shooter: any, inst: Instance): boolean
	local id = inst:GetAttribute("MineId")
	if typeof(id) ~= "number" then return false end
	for _, m in ipairs(mines) do
		if m.id == id and m.owner ~= shooter then
			removeMine(m, false)
			if typeof(shooter) == "Instance" and shooter:IsA("Player") then toastEvent:FireClient(shooter, "Mine détruite") end
			return true
		end
	end
	return true
end
-- coup de couteau / explosion : casse les mines proches (by = seulement les mines ennemies de by)
function GrenadeService.minesNear(pos: Vector3, r: number, by: any)
	for _, m in ipairs(table.clone(mines)) do
		local d = Vector3.new(m.pos.X - pos.X, 0, m.pos.Z - pos.Z).Magnitude / M
		if d < r and (by == nil or isFoeMine(m, by)) then removeMine(m, false) end
	end
end
function GrenadeService.placeMine(c: any): boolean
	if WS.throwBlocked and WS.throwBlocked(c) then return false end
	local s = stocks[c]
	local r = rootOf(c)
	if not s or s.mine <= 0 or not r or not alive(c) then return false end
	local own = {}
	for _, m in ipairs(mines) do if m.owner == c then table.insert(own, m) end end
	if #own >= G.MINE.max then removeMine(own[1], false) end
	local look = r.CFrame.LookVector
	local at = r.Position + Vector3.new(look.X, 0, look.Z).Unit * .8 * M
	local hit = G.cast(at + Vector3.new(0, 1, 0), Vector3.new(0, -12, 0), G.params(characters()))
	if not hit or wallBetween(r.Position, at, characters()) then return false end
	nextId += 1
	local model = G.mineMesh()
	model:PivotTo(CFrame.new(hit.Position) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p:SetAttribute("MineId", nextId) end end
	model:SetAttribute("MineId", nextId); model:SetAttribute("Team", WS.teamOf(c))
	model.Parent = workspace
	local ch = WS.charOf(c)
	table.insert(mines, { id = nextId, owner = c, team = WS.teamOf(c), pos = hit.Position, model = model, armT = G.MINE.arm, match = ch and ch:GetAttribute("MatchId") })
	s.mine -= 1; publish(c)
	fxEvent:FireAllClients({ op = "mine", p = hit.Position, owner = WS.charOf(c) })
	if typeof(c) == "Instance" and c:IsA("Player") then toastEvent:FireClient(c, "Mine posée") end
	return true
end

-- ---------- grenades ----------
local function explode(n: G.Nade)
	fxEvent:FireAllClients({ op = "boom", id = n.id, kind = n.kind, p = n.p })
	local owner = n.owner
	if n.kind == "frag" then
		GrenadeService.minesNear(n.p, 4.5, nil)
		for c in WS.eachCombatant() do
			local char = WS.charOf(c)
			local r = rootOf(c)
			if char and r and alive(c) then
				local target = r.Position + Vector3.new(0, -.5, 0)
				local d = (target - n.p).Magnitude / M
				local self = c == owner
				local mate = not self and n.team ~= nil and WS.teamOf(c) == n.team
				if d < G.FRAG_R and not mate and not wallBetween(n.p + Vector3.new(0, .4 * M, 0), target, characters()) then
					WS.applyDamage(if self then nil else owner, char, math.floor(140 * (1 - d / G.FRAG_R) * (if self then .6 else 1) + .5), false, "frag", .5)
				end
			end
		end
		-- zombies (pas des combattants de WeaponService)
		if WS.extraVictims then
			for _, z in ipairs(WS.extraVictims()) do
				local zr = z:FindFirstChild("HumanoidRootPart") :: BasePart?
				if zr and z:IsDescendantOf(workspace) then
					local d = (zr.Position - n.p).Magnitude / M
					if d < G.FRAG_R and not wallBetween(n.p + Vector3.new(0, .4 * M, 0), zr.Position, characters()) then
						WS.applyDamage(owner, z, math.floor(140 * (1 - d / G.FRAG_R) + .5), false, "frag", .5)
					end
				end
			end
		end
	elseif n.kind == "flash" then
		for c in WS.eachCombatant() do
			local char = WS.charOf(c)
			local head = char and (char:FindFirstChild("Head") :: BasePart?)
			local r = rootOf(c)
			if head and r and alive(c) then
				local to = n.p - head.Position
				local d = to.Magnitude / M
				if d <= G.FLASH_R and not wallBetween(head.Position, n.p, characters()) then
					local look = r.CFrame.LookVector
					local h = Vector3.new(to.X, 0, to.Z)
					local facing = if h.Magnitude > 1e-3 then Vector3.new(look.X, 0, look.Z).Unit:Dot(h.Unit) else 1
					local dur = (if facing > .1 then 3.4 else 1.1) * math.clamp(1.25 - d / 30, .2, 1)
					if typeof(c) == "Instance" and c:IsA("Player") then flashFx:FireClient(c, dur)
					elseif char then char:SetAttribute("BlindUntil", workspace:GetServerTimeNow() + dur) end   -- pour l'IA des bots
				end
			end
		end
	else
		table.insert(smokes, { p = n.p + Vector3.new(0, 1.3 * M, 0), t = G.SMOKE_T })
	end
end

-- target : point visé (bots) ; sinon le regard look (joueur) ; free : ne consomme pas le stock
function GrenadeService.throw(c: any, kind: string, free: boolean?, look: Vector3?, target: Vector3?): boolean
	if not G.KINDS[kind] then return false end
	if WS.throwBlocked and WS.throwBlocked(c) then return false end   -- début de manche, « PRÉPAREZ-VOUS »
	local char = WS.charOf(c)
	local r = rootOf(c)
	if not char or not r or not alive(c) then return false end
	if not free then
		local s = stocks[c] :: any
		if not s or (s[kind] or 0) <= 0 then return false end
		s[kind] -= 1; publish(c)
	end
	local head = char:FindFirstChild("Head") :: BasePart?
	local eye = (if head then head.Position else r.Position + Vector3.new(0, 1.5, 0)) - Vector3.new(0, .2 * M, 0)
	local v = if target then G.launchAt(eye, target) else G.launch(look or r.CFrame.LookVector, r.AssemblyLinearVelocity)
	nextId += 1
	local n: G.Nade = { id = nextId, kind = kind, p = eye, v = v, t = G.KINDS[kind].fuse, owner = c, team = WS.teamOf(c) }
	table.insert(nades, n)
	fxEvent:FireAllClients({ op = "throw", id = n.id, kind = kind, p = eye, v = v, t = n.t, owner = char, team = n.team })
	return true
end

-- ---------- la fumée coupe-t-elle la vue entre a et b ? (smokeBlocks du web) ----------
function GrenadeService.smokeBlocks(a: Vector3, b: Vector3): boolean
	local d = b - a
	local L = d.Magnitude
	if L < 1e-3 then return false end
	local u = d / L
	for _, s in ipairs(smokes) do
		local t = math.clamp((s.p - a):Dot(u), 0, L)
		if (a + u * t - s.p).Magnitude < G.SMOKE_R * M * .85 then return true end
	end
	return false
end

function GrenadeService.reset(c: any)
	stocks[c] = nil
	publish(c)
end
-- fin de manche / de partie : plus rien au sol
-- matchId : seulement les mines de cette partie (plusieurs parties tournent sur le même serveur)
function GrenadeService.clear(matchId: any?)
	if matchId == nil then table.clear(nades); table.clear(smokes) end
	for _, m in ipairs(table.clone(mines)) do if matchId == nil or m.match == matchId then removeMine(m, false) end end
end

function GrenadeService.init(weaponService: any)
	WS = weaponService
	throwEvent.OnServerEvent:Connect(function(player: Player, kind: any, look: any)
		if typeof(kind) ~= "string" then return end
		-- « not (… and …) » : un NaN échoue aux deux comparaisons et resterait sinon accepté (grenade bloquée à jamais)
		if typeof(look) ~= "Vector3" or not (look.Magnitude >= .5 and look.Magnitude <= 1.5) then look = nil end
		GrenadeService.throw(player, kind, false, if look then (look :: Vector3).Unit else nil)
	end)
	mineEvent.OnServerEvent:Connect(function(player: Player) GrenadeService.placeMine(player) end)

	local params = G.params({})
	local blink = 0
	RunService.Heartbeat:Connect(function(dt: number)
		if #nades > 0 then
			params.FilterDescendantsInstances = characters()
			for i = #nades, 1, -1 do
				local n = nades[i]
				G.step(n, math.min(dt, 1 / 20), params)
				if n.t <= 0 then table.remove(nades, i); explode(n) end
			end
		end
		for i = #smokes, 1, -1 do
			smokes[i].t -= dt
			if smokes[i].t <= 0 then table.remove(smokes, i) end
		end
		-- mines : armées après 1 s, explosent au passage d'un ennemi (1,5 m, écart de hauteur < 1,6 m)
		blink += dt
		local on = math.floor(blink * 2.5) % 2 == 1
		for _, m in ipairs(table.clone(mines)) do
			m.armT -= dt
			local led = m.model:FindFirstChild("Led") :: BasePart?
			if led then led.Color = if m.armT > 0 then Color3.fromRGB(102, 102, 102) elseif on then Color3.fromRGB(255, 42, 42) else Color3.fromRGB(85, 16, 16) end
			if m.owner == nil or (typeof(m.owner) == "Instance" and not m.owner.Parent) then removeMine(m, false)
			elseif m.armT <= 0 then
				for c in WS.eachCombatant() do
					local r = rootOf(c)
					if r and alive(c) and isFoeMine(m, c) then
						local d = Vector3.new(r.Position.X - m.pos.X, 0, r.Position.Z - m.pos.Z).Magnitude / M
						if d < G.MINE.trigger and math.abs(r.Position.Y - 3 - m.pos.Y) / M < G.MINE.dy then removeMine(m, true); break end
					end
				end
			end
		end
	end)
	Players.PlayerRemoving:Connect(function(p)
		stocks[p] = nil
		for _, m in ipairs(table.clone(mines)) do if m.owner == p then removeMine(m, false) end end
	end)
end

return GrenadeService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="425">
      <Properties>
        <string name="Name">HalloweenService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/HalloweenService (ModuleScript, requis par Main)
-- Événement d'Halloween hors Manoir hanté (src/8W_halloween.js), seulement pendant l'événement (ProgressService.eventActive) :
--   • décor des autres cartes (hwEventDeco) : citrouilles sculptées sur le haut des murs qui bordent une zone ouverte
--     (16, les 4 premières éclairées), petits groupes au pied des murs / caisses / maisons (14), une à chaque point de
--     départ, nuée de chauves-souris au centre (animée par HalloweenController) ;
--   • un adversaire éliminé par un joueur lâche parfois une citrouille à ramasser (25 %, 12 au plus par partie, pas à
--     l'entraînement) ;
--   • lobby : éclairage de nuit violet / orangé, brouillard, citrouilles et chauves-souris (thème « theme-hw » du menu web).
--     Attribut Workspace « EventTheme » = "hw" pour les écrans du menu.
-- Le décor est fait de Parts sans collision ni requête : il ne gêne ni les tirs ni les déplacements.
local CollectionService = game:GetService("CollectionService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local ProgressService = require(script.Parent.ProgressService)
local MatchService = require(script.Parent.MatchService)
local WeaponService = require(script.Parent.WeaponService)

local HalloweenService = {}

local U = Config.STUDS_PER_METER
local CELL = Config.CELL * U
local ORANGE = Color3.fromRGB(232, 112, 26)
local ORANGE2 = Color3.fromRGB(214, 98, 20)
local GLOW = Color3.fromRGB(255, 208, 96)

local function deco(name: string, size: Vector3, cf: CFrame, color: Color3, parent: Instance, mat: Enum.Material?, shape: Enum.PartType?): Part
	local p = Instance.new("Part")
	p.Name = name; p.Size = size; p.CFrame = cf; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic
	if shape then p.Shape = shape end
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.Parent = parent
	return p
end

-- citrouille sculptée décorative (jackO du web) : s = taille en mètres, posée au sol en pos, tournée de ry
function HalloweenService.jackO(pos: Vector3, s: number, ry: number, light: number, parent: Instance): Model
	local m = Instance.new("Model"); m.Name = "HwPumpkin"
	local d = s * U
	local c = CFrame.new(pos + Vector3.new(0, d * 0.4, 0)) * CFrame.Angles(0, ry, 0)
	deco("Body", Vector3.new(d, d * 0.8, d), c, ORANGE, m, nil, Enum.PartType.Ball)
	for i = 0, 5 do
		deco("Rib", Vector3.new(d * 0.4, d * 0.78, d * 1.02), c * CFrame.Angles(0, i / 6 * math.pi, 0), ORANGE2, m, nil, Enum.PartType.Ball)
	end
	deco("Stem", Vector3.new(d * 0.12, d * 0.24, d * 0.12), c * CFrame.new(0, d * 0.46, 0) * CFrame.Angles(0, 0, 0.25), Color3.fromRGB(74, 90, 34), m)
	for _, sx in ipairs({ -0.18, 0.18 }) do
		deco("Eye", Vector3.new(d * 0.15, d * 0.15, d * 0.05), c * CFrame.new(d * sx, d * 0.09, -d * 0.49) * CFrame.Angles(0, 0, math.rad(45)), GLOW, m, Enum.Material.Neon)
	end
	deco("Mouth", Vector3.new(d * 0.42, d * 0.08, d * 0.05), c * CFrame.new(0, -d * 0.13, -d * 0.48), GLOW, m, Enum.Material.Neon)
	local body = m:FindFirstChild("Body") :: BasePart
	m.PrimaryPart = body
	if light > 0 then
		local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(255, 138, 48); l.Brightness = light * 0.6; l.Range = (10 + s * 6) * 0.9; l.Shadows = false
		l.Parent = body
		CollectionService:AddTag(l, "HwFlicker")   -- vacille côté client (HalloweenController)
	end
	m.Parent = parent
	return m
end

-- nuée de chauves-souris (hwBats) : un repère que HalloweenController anime
function HalloweenService.bats(center: Vector3, n: number, radius: number, parent: Instance): Part
	local p = deco("HwBats", Vector3.new(1, 1, 1), CFrame.new(center), Color3.new(), parent)
	p.Transparency = 1
	p:SetAttribute("N", n); p:SetAttribute("Radius", radius)
	CollectionService:AddTag(p, "HwBats")
	return p
end

local function shuffle<T>(t: { T }, rng: Random)
	for i = #t, 2, -1 do local j = rng:NextInteger(1, i); t[i], t[j] = t[j], t[i] end
end

-- ---------- décor d'une carte (hwEventDeco) ----------
function HalloweenService.decorate(m: any)
	if not ProgressService.eventActive() then return end
	if m.settings.map == "manoir" or not m.map or not m.map.grid then return end
	local g = m.map.grid
	local N = MapData.N
	local TY = MapData.TY
	local o: Vector3 = m.map.origin
	local folder = Instance.new("Folder"); folder.Name = "Halloween"; folder.Parent = m.map.folder
	local rng = Random.new()
	local function cellPos(cx: number, cz: number, h: number): Vector3
		return o + Vector3.new((cx + 0.5) * CELL, h * U, (cz + 0.5) * CELL)
	end
	-- haut des murs qui bordent une zone ouverte
	local cand: { { number } } = {}
	for cz = 1, N - 2 do
		for cx = 1, N - 2 do
			local i = cz * N + cx
			if g.type[i] == TY.WALL and g.h[i] <= 7 then
				local open = false
				for _, dd in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
					local j = (cz + dd[2]) * N + cx + dd[1]
					if g.type[j] == 0 and (g.ceil[j] or 99) > 90 then open = true; break end
				end
				if open then table.insert(cand, { cx, cz }) end
			end
		end
	end
	shuffle(cand, rng)
	local used: { { number } } = {}
	for _, c in ipairs(cand) do
		if #used >= 16 then break end
		local near = false
		for _, u in ipairs(used) do if math.abs(u[1] - c[1]) + math.abs(u[2] - c[2]) < 5 then near = true; break end end
		if not near then
			table.insert(used, c)
			HalloweenService.jackO(cellPos(c[1], c[2], g.h[c[2] * N + c[1]]), 0.95, rng:NextNumber() * math.pi * 2, if #used <= 4 then 2.5 else 0, folder)
		end
	end
	-- groupes au pied des murs, caisses et maisons (collés à l'obstacle)
	local foot: { { number } } = {}
	for cz = 1, N - 2 do
		for cx = 1, N - 2 do
			local i = cz * N + cx
			if g.type[i] == 0 and (g.ramp[i] or 0) == 0 then
				for _, dd in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
					local t = g.type[(cz + dd[2]) * N + cx + dd[1]]
					if t == TY.WALL or t == TY.CRATE or t == TY.HOUSE then table.insert(foot, { cx, cz, dd[1], dd[2] }); break end
				end
			end
		end
	end
	shuffle(foot, rng)
	local fu: { { number } } = {}
	for _, f in ipairs(foot) do
		if #fu >= 14 then break end
		local near = false
		for _, u in ipairs(fu) do if math.abs(u[1] - f[1]) + math.abs(u[2] - f[2]) < 6 then near = true; break end end
		if not near then
			table.insert(fu, f)
			local dx, dz = f[3], f[4]
			local base = cellPos(f[1], f[2], 0) + Vector3.new(dx * 0.62 * U, 0, dz * 0.62 * U)
			local y = m.map.groundAt(base)
			HalloweenService.jackO(Vector3.new(base.X, y, base.Z), 0.75, math.atan2(-dx, -dz) + math.pi, 0, folder)
			local b2 = base + Vector3.new(-dz * 0.6 * U + rng:NextNumber(-0.1, 0.1) * U, 0, dx * 0.6 * U)
			HalloweenService.jackO(Vector3.new(b2.X, m.map.groundAt(b2), b2.Z), 0.45, rng:NextNumber() * math.pi * 2, 0, folder)
		end
	end
	-- petites citrouilles au pied des points de départ
	for _, s in ipairs({ (m.map.data.spawnCT or {})[1], (m.map.data.spawnT or {})[1] }) do
		if s then
			local p = cellPos(s[1], s[2], 0) + Vector3.new(1.2 * U, 0, 0.6 * U)
			HalloweenService.jackO(Vector3.new(p.X, m.map.groundAt(p), p.Z), 0.7, rng:NextNumber() * math.pi * 2, 2, folder)
		end
	end
	local half = N * CELL / 2
	HalloweenService.bats(o + Vector3.new(half, 16 * U, half), 14, 20 * U, folder)
end
table.insert(MatchService.buildHooks, HalloweenService.decorate)

-- ---------- citrouille lâchée par un adversaire éliminé ----------
WeaponService.Killed:Connect(function(killer: any, victim: any)
	if not ProgressService.eventActive() then return end
	if typeof(killer) ~= "Instance" or not killer:IsA("Player") or killer == victim then return end
	local m = MatchService.matchOf(killer)
	if not m or m.mode == "train" or not m.map or MatchService.matchOf(victim) ~= m then return end
	if math.random() >= (X.EVENT.killDropChance or 0.25) then return end
	local count = 0
	for _, d in ipairs(m.map.folder:GetDescendants()) do if d.Name == "Pumpkin" and d:IsA("BasePart") then count += 1 end end
	if count >= (X.EVENT.killDropMax or 12) then return end
	local ch = WeaponService.charOf(victim)
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local pos = root.Position
	ProgressService.pumpkinAt(Vector3.new(pos.X, m.map.groundAt(pos), pos.Z), m.map.folder)
end)

-- ---------- lobby ----------
local function themeLobby()
	if not ProgressService.eventActive() then return end
	workspace:SetAttribute("EventTheme", "hw")
	-- ambiance de nuit d'Halloween (MapDetailController la garde comme éclairage du lobby)
	Lighting.ClockTime = 20.6
	Lighting.Brightness = 1.4
	Lighting.Ambient = Color3.fromRGB(72, 48, 96)
	Lighting.OutdoorAmbient = Color3.fromRGB(96, 64, 128)
	Lighting.ColorShift_Top = Color3.fromRGB(255, 140, 60)
	Lighting.FogColor = Color3.fromRGB(46, 24, 66)
	Lighting.FogStart = 60
	Lighting.FogEnd = 900
	-- citrouilles et chauves-souris autour du lobby
	local L = CommunityConfig.LOBBY
	local o = L.origin
	local half = L.size / 2
	local folder = Instance.new("Folder"); folder.Name = "HalloweenLobby"; folder.Parent = workspace
	local rng = Random.new(31)
	for i = 0, 11 do   -- au pied des murs, entre les attractions
		local side = i % 4
		local t = (math.floor(i / 4) - 1) * 0.55 * half + rng:NextNumber(-8, 8)
		local inset = half - 5
		local p = if side == 0 then Vector3.new(t, 0, inset) elseif side == 1 then Vector3.new(t, 0, -inset)
			elseif side == 2 then Vector3.new(inset, 0, t) else Vector3.new(-inset, 0, t)
		HalloweenService.jackO(o + p, 1.1, rng:NextNumber() * math.pi * 2, if i < 4 then 2.5 else 0, folder)
		HalloweenService.jackO(o + p + Vector3.new(rng:NextNumber(-4, 4), 0, rng:NextNumber(-4, 4)), 0.55, rng:NextNumber() * math.pi * 2, 0, folder)
	end
	for _, c in ipairs({ { 1, 1 }, { -1, 1 }, { 1, -1 }, { -1, -1 } }) do   -- sur les coins des murs
		HalloweenService.jackO(o + Vector3.new(c[1] * (half - 1), 34, c[2] * (half - 1)), 1.4, rng:NextNumber() * math.pi * 2, 3, folder)
	end
	for _, c in ipairs({ { 0.7, 0.7 }, { -0.7, -0.6 }, { 0.6, -0.7 } }) do   -- autour de l'aire d'apparition
		HalloweenService.jackO(o + Vector3.new(c[1] * 20, 0, c[2] * 20), 0.8, rng:NextNumber() * math.pi * 2, 1.5, folder)
	end
	HalloweenService.bats(o + Vector3.new(0, 30, 0), 18, 60, folder)
end
themeLobby()

return HalloweenService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="426">
      <Properties>
        <string name="Name">KillFxService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/KillFxService (ModuleScript, requis par Main)
-- À chaque élimination faite par un joueur, envoie à tous les clients l'effet d'élimination qu'il a équipé.
-- L'effet lui-même est joué par StarterPlayerScripts/KillFxController (rien de lourd côté serveur).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
local DataService = require(script.Parent.DataService)
local WeaponService = require(script.Parent.WeaponService)

local fxEvent = Instance.new("RemoteEvent"); fxEvent.Name = "KillFx"; fxEvent.Parent = ReplicatedStorage

local KillFxService = {}

function KillFxService.equippedOf(player: Player): string
	local profile = DataService.get(player)
	local id = profile and profile.equipped and profile.equipped.killFx or "none"
	if not KillFxConfig.get(id) then return "none" end
	if id ~= "none" and not table.find(profile.inv.killfx or {}, id) then return "none" end   -- plus possédé : rien
	-- effets d'Halloween : seulement pendant l'événement (killFxOwned du web)
	if KillFxConfig.get(id).source == "event" and not require(script.Parent.ProgressService).eventActive() then return "none" end
	return id
end

WeaponService.Killed:Connect(function(killer, victim, _key: string, _headshot: boolean)
	if typeof(killer) ~= "Instance" or not killer:IsA("Player") then return end   -- les bots n'ont pas d'effet
	local id = KillFxService.equippedOf(killer)
	if id == "none" then return end
	local char = WeaponService.charOf(victim)
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not char or not root then return end
	fxEvent:FireAllClients(id, char, root.Position, killer.UserId)
end)

return KillFxService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="427">
      <Properties>
        <string name="Name">LeaderboardService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/LeaderboardService (ModuleScript)
-- Classement géant du lobby : meilleurs tueurs de la SEMAINE (remis à zéro chaque lundi) et classement des duels.
-- Les scores vivent dans des OrderedDataStore (partagés par tous les serveurs du jeu) ; le panneau se met à jour
-- toutes les CommunityConfig.LEADERBOARD.refresh secondes. Les éliminations sont regroupées avant l'envoi
-- pour respecter les limites de requêtes de Roblox.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Stores = require(script.Parent.Stores)
local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
local LB = CommunityConfig.LEADERBOARD

local LeaderboardService = {}

local function weeklyStore(week: number): OrderedDataStore
	return Stores.ordered("WeeklyKills_" .. week)
end
local duelStore = Stores.ordered("DuelElo_v1")

-- ---------- écriture ----------
local pendingKills: { [number]: number } = {}      -- userId -> éliminations pas encore envoyées
local pendingElo: { [number]: number } = {}

function LeaderboardService.addKills(player: Player, n: number)
	if n <= 0 then return end
	pendingKills[player.UserId] = (pendingKills[player.UserId] or 0) + n
end

function LeaderboardService.setDuelElo(player: Player, elo: number)
	pendingElo[player.UserId] = math.floor(elo)
end

local function flush()
	local week = CommunityConfig.weekId()
	local store = weeklyStore(week)
	local kills = pendingKills; pendingKills = {}
	for userId, n in pairs(kills) do
		local ok, err = pcall(function() store:IncrementAsync("u_" .. userId, n) end)
		if not ok then
			warn("[Leaderboard] envoi des éliminations échoué :", err)
			pendingKills[userId] = (pendingKills[userId] or 0) + n
		end
	end
	local elos = pendingElo; pendingElo = {}
	for userId, elo in pairs(elos) do
		local ok = pcall(function() duelStore:SetAsync("u_" .. userId, elo) end)
		if not ok and not pendingElo[userId] then pendingElo[userId] = elo end
	end
end

-- ---------- lecture ----------
local nameCache: { [number]: string } = {}
local function nameOf(userId: number): string
	if nameCache[userId] then return nameCache[userId] end
	local p = Players:GetPlayerByUserId(userId)
	if p then nameCache[userId] = p.DisplayName; return p.DisplayName end
	local ok, name = pcall(function() return Players:GetNameFromUserIdAsync(userId) end)
	nameCache[userId] = if ok and name then name else "Joueur"
	return nameCache[userId]
end

local function top(store: OrderedDataStore): { { name: string, value: number, userId: number } }
	local out = {}
	local ok, pages = pcall(function() return store:GetSortedAsync(false, LB.top) end)
	if not ok or not pages then return out end
	for _, entry in ipairs((pages :: any):GetCurrentPage()) do
		local userId = tonumber(string.sub(entry.key, 3)) or 0
		table.insert(out, { name = nameOf(userId), value = entry.value, userId = userId })
	end
	return out
end

-- ---------- panneau ----------
local MEDALS = { Color3.fromRGB(255, 205, 60), Color3.fromRGB(205, 212, 222), Color3.fromRGB(215, 140, 70) }
local columns: { [string]: Frame } = {}
local footer: TextLabel? = nil

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(className)
	if className == "TextLabel" then
		o.BackgroundTransparency = 1; o.Font = Enum.Font.GothamBold; o.TextColor3 = Color3.new(1, 1, 1); o.TextScaled = true
	end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end

local function buildBoard(board: BasePart)
	local sg = make("SurfaceGui", { Face = Enum.NormalId.Front, SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud, PixelsPerStud = 12, LightInfluence = 0 }, board)
	make("TextLabel", { Size = UDim2.new(1, 0, 0.12, 0), Position = UDim2.fromScale(0, 0.02), Text = "🏆 CLASSEMENT", Font = Enum.Font.GothamBlack,
		TextColor3 = Color3.fromRGB(255, 200, 60) }, sg)
	local function column(id: string, title: string, x: number)
		local col = make("Frame", { Size = UDim2.fromScale(0.46, 0.74), Position = UDim2.fromScale(x, 0.16), BackgroundColor3 = Color3.fromRGB(24, 30, 46), BorderSizePixel = 0 }, sg)
		make("UICorner", { CornerRadius = UDim.new(0.03, 0) }, col)
		make("TextLabel", { Size = UDim2.new(1, -20, 0.1, 0), Position = UDim2.new(0, 10, 0.02, 0), Text = title, TextColor3 = Color3.fromRGB(150, 200, 255) }, col)
		local list = make("Frame", { Name = "List", Size = UDim2.new(1, -20, 0.84, 0), Position = UDim2.new(0, 10, 0.14, 0), BackgroundTransparency = 1 }, col)
		make("UIListLayout", { Padding = UDim.new(0.01, 0), SortOrder = Enum.SortOrder.LayoutOrder }, list)
		columns[id] = list
	end
	column("kills", "⚔️ Éliminations de la semaine", 0.03)
	column("duel", "🥊 Meilleurs duellistes", 0.51)
	footer = make("TextLabel", { Size = UDim2.new(0.9, 0, 0.06, 0), Position = UDim2.fromScale(0.05, 0.92), Text = "", TextColor3 = Color3.fromRGB(170, 180, 200), Font = Enum.Font.Gotham }, sg)
end

local function fillColumn(id: string, rows: { any }, fmt: (number) -> string)
	local list = columns[id]
	if not list then return end
	for _, c in ipairs(list:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	if #rows == 0 then
		local row = make("Frame", { Size = UDim2.fromScale(1, 0.09), BackgroundTransparency = 1 }, list)
		make("TextLabel", { Size = UDim2.fromScale(1, 1), Text = "Personne pour l'instant : à toi de jouer !", TextColor3 = Color3.fromRGB(150, 160, 180) }, row)
		return
	end
	for i, r in ipairs(rows) do
		local row = make("Frame", { Size = UDim2.fromScale(1, 0.09), BackgroundColor3 = Color3.fromRGB(34, 42, 62), BackgroundTransparency = if i % 2 == 0 then 0.4 else 0.1,
			BorderSizePixel = 0, LayoutOrder = i }, list)
		local color = MEDALS[i] or Color3.new(1, 1, 1)
		make("TextLabel", { Size = UDim2.fromScale(0.12, 0.8), Position = UDim2.fromScale(0.02, 0.1), Text = "#" .. i, TextColor3 = color, Font = Enum.Font.GothamBlack }, row)
		make("TextLabel", { Size = UDim2.fromScale(0.58, 0.8), Position = UDim2.fromScale(0.15, 0.1), Text = r.name, TextColor3 = color, TextXAlignment = Enum.TextXAlignment.Left }, row)
		make("TextLabel", { Size = UDim2.fromScale(0.25, 0.8), Position = UDim2.fromScale(0.73, 0.1), Text = fmt(r.value), TextXAlignment = Enum.TextXAlignment.Right }, row)
	end
end

local function refresh()
	fillColumn("kills", top(weeklyStore(CommunityConfig.weekId())), function(v) return tostring(v) end)
	fillColumn("duel", top(duelStore), function(v)
		return CommunityConfig.duelRank(v).name .. " · " .. v
	end)
	local left = CommunityConfig.secondsToNextWeek()
	if footer then
		footer.Text = string.format("Remise à zéro des éliminations dans %d j %d h · mis à jour toutes les %d s",
			left // 86400, (left % 86400) // 3600, LB.refresh)
	end
end

function LeaderboardService.start(board: BasePart?)
	if board then buildBoard(board) end
	task.spawn(function()
		while true do
			pcall(flush)
			if board then pcall(refresh) end
			task.wait(LB.refresh)
		end
	end)
end

Players.PlayerRemoving:Connect(function(p) nameCache[p.UserId] = nil end)
game:BindToClose(function()
	if RunService:IsStudio() then return end
	pcall(flush)
end)

return LeaderboardService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="428">
      <Properties>
        <string name="Name">LobbyService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/LobbyService (ModuleScript, requis par Main quand CommunityConfig.LOBBY_ENABLED = true)
-- Lobby jouable façon Rivals : on y arrive, on s'entraîne au stand de tir, on fait le parcours, on regarde le
-- classement géant, on monte sur une plateforme de duel ou on passe le portail pour rejoindre le match à mort.
-- Personne ne peut blesser personne dans le lobby (pas d'équipe = pas de dégâts, voir WeaponService.fire).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
local DataService = require(script.Parent.DataService)
local WeaponService = require(script.Parent.WeaponService)
local MatchService = require(script.Parent.MatchService)
local RateLimit = require(script.Parent.RateLimit)

local L = CommunityConfig.LOBBY
local O = L.origin

local LobbyService = {}
LobbyService.duelPads = {} :: { { part: BasePart, def: any, label: TextLabel } }
LobbyService.board = nil :: BasePart?

local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local toastEvent = remoteEvent("LobbyToast")    -- serveur -> joueur : message court (record, récompense…)
local timerEvent = remoteEvent("LobbyTimer")    -- serveur -> joueur : chrono du parcours / du stand de tir
local panelEvent = remoteEvent("OpenPanel")     -- serveur -> joueur : ouvrir le panneau Codes ou Groupe (bornes du lobby)

function LobbyService.toast(p: Player, text: string, color: Color3?)
	toastEvent:FireClient(p, text, color)
end

-- ==========================================================================================
-- Construction
-- ==========================================================================================
local folder: Folder
local function part(name: string, size: Vector3, cf: CFrame, color: Color3, material: Enum.Material?, parent: Instance?): Part
	local p = Instance.new("Part")
	p.Name = name; p.Anchored = true; p.Size = size; p.CFrame = cf; p.Color = color
	p.Material = material or Enum.Material.SmoothPlastic
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent or folder
	return p
end
local function at(x: number, y: number, z: number): CFrame return CFrame.new(O + Vector3.new(x, y, z)) end

-- Panneau texte posé sur la face avant d'une pièce
local function sign(target: BasePart, text: string, color: Color3, face: Enum.NormalId?)
	local sg = Instance.new("SurfaceGui"); sg.Face = face or Enum.NormalId.Front; sg.PixelsPerStud = 20; sg.LightInfluence = 0
	sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud; sg.Parent = target
	local l = Instance.new("TextLabel"); l.Size = UDim2.fromScale(1, 1); l.BackgroundTransparency = 1; l.Text = text
	l.TextColor3 = color; l.Font = Enum.Font.GothamBlack; l.TextScaled = true; l.Parent = sg
	return l
end

local function billboard(target: BasePart, text: string, color: Color3, height: number): TextLabel
	local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(260, 60); bb.StudsOffset = Vector3.new(0, height, 0)
	bb.AlwaysOnTop = false; bb.MaxDistance = 140; bb.LightInfluence = 0; bb.Parent = target
	local l = Instance.new("TextLabel"); l.Size = UDim2.fromScale(1, 1); l.BackgroundTransparency = 1; l.Text = text
	l.TextColor3 = color; l.Font = Enum.Font.GothamBlack; l.TextScaled = true; l.TextStrokeTransparency = 0.4; l.Parent = bb
	return l
end

local DARK = Color3.fromRGB(28, 32, 44)
local FLOOR = Color3.fromRGB(46, 52, 68)
local RED = Color3.fromRGB(255, 70, 85)
local BLUE = Color3.fromRGB(74, 163, 255)
local GOLD = Color3.fromRGB(255, 200, 60)
local GREEN = Color3.fromRGB(80, 230, 140)

local rangeTargets: { BasePart } = {}
local rangeStart: BasePart
local parkourStart: BasePart
local parkourFinish: BasePart

local function build()
	local old = workspace:FindFirstChild("Lobby"); if old then old:Destroy() end
	folder = Instance.new("Folder"); folder.Name = "Lobby"; folder.Parent = workspace
	local S = L.size
	local half = S / 2

	-- sol, murs, bandes lumineuses
	part("Floor", Vector3.new(S, 2, S), at(0, -1, 0), FLOOR, Enum.Material.Concrete)
	for i, d in ipairs({ { 0, half }, { 0, -half }, { half, 0 }, { -half, 0 } }) do
		local alongX = i <= 2
		part("Wall", if alongX then Vector3.new(S, 34, 2) else Vector3.new(2, 34, S), at(d[1], 17, d[2]), DARK, Enum.Material.Metal)
		part("Strip", if alongX then Vector3.new(S, 0.6, 2.4) else Vector3.new(2.4, 0.6, S), at(d[1], 3, d[2]), if i % 2 == 0 then RED else BLUE, Enum.Material.Neon)
	end
	local spawnPad = part("SpawnPad", Vector3.new(26, 0.4, 26), at(0, 0.2, 0), Color3.fromRGB(60, 68, 90), Enum.Material.Metal)
	billboard(spawnPad, "STRIKE ARENA", Color3.new(1, 1, 1), 12)

	-- ---------- portail du match à mort (nord) ----------
	local portalFrame = part("PortalFrame", Vector3.new(30, 26, 3), at(0, 13, half - 14), DARK, Enum.Material.Metal)
	portalFrame.Transparency = 0
	local portal = part("Portal", Vector3.new(22, 20, 1), at(0, 10, half - 16), RED, Enum.Material.Neon)
	portal.Transparency = 0.35; portal.CanCollide = false
	billboard(portal, "⚡ PARTIE RAPIDE", Color3.new(1, 1, 1), 14)
	local portalDebounce: { [Player]: boolean } = {}
	portal.Touched:Connect(function(hit)
		local p = Players:GetPlayerFromCharacter(hit.Parent)
		if not p or portalDebounce[p] or p:GetAttribute("Zone") ~= "lobby" or p:GetAttribute("DuelQueued") then return end
		portalDebounce[p] = true
		task.delay(2, function() portalDebounce[p] = nil end)
		LobbyService.joinMatch(p)
	end)

	-- ---------- plateformes de duel (ouest) ----------
	part("DuelSign", Vector3.new(50, 8, 1), at(-half + 2, 22, 0) * CFrame.Angles(0, math.rad(-90), 0), DARK)
	sign(folder:FindFirstChild("DuelSign") :: BasePart, "DUELS", GOLD)
	for i, def in ipairs(CommunityConfig.DUEL.pads) do
		local z = -54 + (i - 1) * 34
		local pad = part("DuelPad_" .. def.id, Vector3.new(1, 16, 16), at(-80, 0.3, z) * CFrame.Angles(0, 0, math.rad(90)),
			if def.stake > 0 then GOLD else BLUE, Enum.Material.Neon)
		pad.Shape = Enum.PartType.Cylinder; pad.Size = Vector3.new(0.6, 16, 16)
		local label = billboard(pad, def.name, Color3.new(1, 1, 1), 7)
		table.insert(LobbyService.duelPads, { part = pad, def = def, label = label })
	end

	-- ---------- stand de tir (est) ----------
	local rx = 85
	part("RangeBack", Vector3.new(70, 30, 2), at(rx, 15, -110), DARK, Enum.Material.Metal)
	part("RangeLine", Vector3.new(70, 0.3, 1), at(rx, 0.15, -24), GOLD, Enum.Material.Neon)
	part("RangeSign", Vector3.new(40, 6, 1), at(rx, 24, -108.5), DARK)
	sign(folder:FindFirstChild("RangeSign") :: BasePart, "STAND DE TIR", GOLD, Enum.NormalId.Back)
	for row = 0, 2 do
		for col = 0, 4 do
			local t = part("Target", Vector3.new(4, 4, 0.6), at(rx - 26 + col * 13, 5 + row * 8, -100 + row * 6), Color3.fromRGB(235, 235, 235))
			t.Shape = Enum.PartType.Cylinder; t.Size = Vector3.new(0.6, 4, 4)
			t.CFrame = at(rx - 26 + col * 13, 5 + row * 8, -100 + row * 6) * CFrame.Angles(0, math.rad(90), 0)
			t:SetAttribute("RangeTarget", true)
			local bull = part("Bull", Vector3.new(0.7, 1.4, 1.4), t.CFrame, RED, Enum.Material.Neon)
			bull.Shape = Enum.PartType.Cylinder; bull.CanQuery = false; bull.CanCollide = false
			bull.Parent = t
			table.insert(rangeTargets, t)
		end
	end
	rangeStart = part("RangeStart", Vector3.new(4, 4, 4), at(rx, 2, -18), GREEN, Enum.Material.Neon)
	local pr = Instance.new("ProximityPrompt"); pr.ActionText = "Défi " .. L.range.duration .. " s"; pr.ObjectText = "Stand de tir"
	pr.HoldDuration = 0.3; pr.MaxActivationDistance = 10; pr.Parent = rangeStart
	billboard(rangeStart, "🎯 Défi " .. L.range.duration .. " secondes", GREEN, 4)

	-- ---------- parcours (nord-est) : 16 plateformes en zigzag qui montent jusqu'à ~45 studs ----------
	parkourStart = part("ParkourStart", Vector3.new(10, 0.6, 10), at(40, 0.3, 30), GREEN, Enum.Material.Neon)
	billboard(parkourStart, "🏃 PARCOURS · départ", GREEN, 5)
	local x, y, z = 40, 0, 30
	local steps = {   -- déplacement { x, hauteur, z } d'une plateforme à la suivante (saut faisable avec le saut Roblox par défaut)
		{ 12, 3, 0 }, { 12, 3, 0 }, { 13, 3, 0 }, { 12, 3, 0 }, { 0, 3, 12 }, { 0, 3, 13 }, { -12, 2, 0 }, { -13, 3, 0 },
		{ -12, 3, 0 }, { 0, 3, 12 }, { 13, 3, 0 }, { 12, 3, 0 }, { 13, 2, 0 }, { 0, 3, 12 }, { -12, 3, 0 }, { -13, 3, 0 },
	}
	local hues = { RED, GOLD, GREEN, BLUE }
	for i, st in ipairs(steps) do
		x += st[1]; y += st[2]; z += st[3]
		local size = if i % 5 == 0 then Vector3.new(4, 1, 4) else Vector3.new(6, 1, 6)   -- quelques plateformes plus petites
		part("Parkour_" .. i, size, at(x, y, z), hues[(i - 1) % 4 + 1], Enum.Material.Neon)
	end
	parkourFinish = part("ParkourFinish", Vector3.new(10, 1, 10), at(x - 13, y + 2, z), GOLD, Enum.Material.Neon)
	billboard(parkourFinish, "🏁 ARRIVÉE", GOLD, 5)

	-- ---------- bornes Codes et Groupe ----------
	local function kiosk(name: string, pos: CFrame, color: Color3, text: string, action: string, panel: string)
		local k = part(name, Vector3.new(6, 9, 3), pos, DARK, Enum.Material.Metal)
		local screen = part(name .. "Screen", Vector3.new(5, 4, 0.3), pos * CFrame.new(0, 2, 1.6), color, Enum.Material.Neon)
		sign(screen, text, Color3.new(1, 1, 1), Enum.NormalId.Back)
		local prompt = Instance.new("ProximityPrompt"); prompt.ActionText = action; prompt.ObjectText = text
		prompt.MaxActivationDistance = 10; prompt.HoldDuration = 0; prompt.Parent = k
		prompt.Triggered:Connect(function(p) panelEvent:FireClient(p, panel) end)
	end
	kiosk("CodesKiosk", at(-26, 4.5, 26) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(170, 90, 255), "🎟️ CODES", "Entrer un code", "codes")
	kiosk("GroupKiosk", at(26, 4.5, 26) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(0, 176, 111), "👥 GROUPE", "Récompense", "group")

	-- ---------- classement géant (fond du lobby, face au point d'arrivée) ----------
	local board = part("Leaderboard", Vector3.new(96, 50, 2), at(0, 30, -half + 3) * CFrame.Angles(0, math.rad(180), 0), Color3.fromRGB(14, 18, 28), Enum.Material.SmoothPlastic)
	part("BoardFrame", Vector3.new(100, 54, 1.5), at(0, 30, -half + 2), GOLD, Enum.Material.Neon)
	LobbyService.board = board
end

-- ==========================================================================================
-- Apparition dans le lobby
-- ==========================================================================================
local function lobbyLoadout(p: Player): { string }
	local primary = p:GetAttribute("Primary")
	local keys = table.clone(L.loadout)
	if typeof(primary) == "string" then keys[1] = primary end
	local secondary = p:GetAttribute("Secondary")
	if typeof(secondary) == "string" then keys[2] = secondary end
	return keys
end

function LobbyService.spawn(p: Player)
	if not p.Parent then return end
	p:SetAttribute("Zone", "lobby")
	p:SetAttribute("DuelTeam", nil)
	p.Team = nil
	WeaponService.reset(p)
	p:LoadCharacter()
	local char = p.Character or p.CharacterAdded:Wait()
	char:PivotTo(CFrame.new(O + Vector3.new(math.random(-8, 8), 4, math.random(-8, 8))) * CFrame.Angles(0, math.rad(180), 0))
	WeaponService.giveLoadout(p, lobbyLoadout(p))
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	hum.Died:Connect(function()
		WeaponService.reset(p)
		task.delay(2, function()
			if p.Parent and p.Character == char and p:GetAttribute("Zone") == "lobby" then LobbyService.spawn(p) end
		end)
	end)
end

function LobbyService.joinMatch(p: Player)
	if p:GetAttribute("Zone") ~= "lobby" or p:GetAttribute("DuelQueued") then return false end
	local ok, err = MatchService.quick(p)
	if not ok then LobbyService.toast(p, err or "Impossible de lancer une partie", RED) end
	return ok
end

function LobbyService.leaveMatch(p: Player)
	if p:GetAttribute("Zone") ~= "match" then return false end
	MatchService.leave(p)      -- MatchService rappelle LobbyService.spawn (setLobbyHooks)
	return true
end

-- ==========================================================================================
-- Stand de tir : entraînement libre + défi chronométré (un joueur à la fois)
-- ==========================================================================================
local challenge = { player = nil :: Player?, endsAt = 0, score = 0, active = {} :: { [BasePart]: boolean } }

local function setTargetVisible(t: BasePart, on: boolean)
	t.Transparency = if on then 0 else 0.85
	local bull = t:FindFirstChild("Bull") :: BasePart?
	if bull then bull.Transparency = if on then 0 else 0.85 end
end

local function pickNewTarget(except: BasePart?)
	local pool = {}
	for _, t in ipairs(rangeTargets) do
		if not challenge.active[t] and t ~= except then table.insert(pool, t) end
	end
	if #pool == 0 then return end
	local t = pool[math.random(#pool)]
	challenge.active[t] = true
	setTargetVisible(t, true)
end

local function endChallenge()
	local p = challenge.player
	challenge.player = nil
	challenge.active = {}
	for _, t in ipairs(rangeTargets) do setTargetVisible(t, true) end
	if not p or not p.Parent then return end
	timerEvent:FireClient(p, { kind = "stop" })
	local profile = DataService.get(p)
	if not profile then return end
	local score = challenge.score
	local lb = profile.lobby
	local msg = "🎯 " .. score .. " cibles en " .. L.range.duration .. " s"
	if score > lb.rangeBest then lb.rangeBest = score; msg ..= " · nouveau record !" end
	if score >= L.range.firstReward and not lb.rangeRewarded then
		lb.rangeRewarded = true
		profile.coins += L.range.rewardCoins
		msg ..= " · +" .. L.range.rewardCoins .. " 💰"
	end
	LobbyService.toast(p, msg, GOLD)
end

local function startChallenge(p: Player)
	if challenge.player then
		if challenge.player ~= p then LobbyService.toast(p, "Le stand est occupé, attends la fin du défi", RED) end
		return
	end
	if p:GetAttribute("Zone") ~= "lobby" then return end
	challenge.player = p
	challenge.score = 0
	challenge.active = {}
	challenge.endsAt = workspace:GetServerTimeNow() + L.range.duration
	for _, t in ipairs(rangeTargets) do setTargetVisible(t, false) end
	for _ = 1, L.range.visibleTargets do pickNewTarget() end
	WeaponService.resupply(p)
	timerEvent:FireClient(p, { kind = "range", endsAt = challenge.endsAt, goal = L.range.firstReward })
	local mine = challenge.endsAt
	task.delay(L.range.duration, function() if challenge.player == p and challenge.endsAt == mine then endChallenge() end end)
end

WeaponService.TargetHit:Connect(function(shooter, target: BasePart)
	if typeof(shooter) ~= "Instance" or not shooter:IsA("Player") then return end
	-- petit flash de la cible touchée
	local bull = target:FindFirstChild("Bull") :: BasePart?
	if bull then
		bull.Color = GREEN
		task.delay(0.15, function() bull.Color = RED end)
	end
	if challenge.player ~= shooter or not challenge.active[target] then return end
	challenge.active[target] = nil
	setTargetVisible(target, false)
	challenge.score += 1
	timerEvent:FireClient(shooter, { kind = "range", endsAt = challenge.endsAt, score = challenge.score, goal = L.range.firstReward })
	pickNewTarget(target)
end)

-- ==========================================================================================
-- Parcours : chrono du départ à l'arrivée, record personnel, récompense au premier parcours
-- ==========================================================================================
local parkourRun: { [Player]: number } = {}

local function touchedBy(partObj: BasePart, fn: (Player) -> ())
	local cooldown: { [Player]: number } = {}
	partObj.Touched:Connect(function(hit)
		local p = Players:GetPlayerFromCharacter(hit.Parent)
		if not p or p:GetAttribute("Zone") ~= "lobby" then return end
		if (cooldown[p] or 0) > os.clock() then return end
		cooldown[p] = os.clock() + 1
		fn(p)
	end)
end

local function hookParkour()
	touchedBy(parkourStart, function(p)
		parkourRun[p] = workspace:GetServerTimeNow()
		timerEvent:FireClient(p, { kind = "parkour", start = parkourRun[p] })
	end)
	touchedBy(parkourFinish, function(p)
		local t0 = parkourRun[p]
		if not t0 then return end
		parkourRun[p] = nil
		local t = workspace:GetServerTimeNow() - t0
		timerEvent:FireClient(p, { kind = "stop" })
		if t < 8 or t > 600 then return end     -- trop rapide pour être honnête, ou départ oublié
		local profile = DataService.get(p)
		if not profile then return end
		local lb = profile.lobby
		local msg = string.format("🏁 Parcours en %.2f s", t)
		if lb.parkourBest == 0 or t < lb.parkourBest then lb.parkourBest = math.floor(t * 100) / 100; msg ..= " · nouveau record !" end
		if not lb.parkourRewarded then
			lb.parkourRewarded = true
			profile.coins += L.parkour.rewardCoins
			msg ..= " · +" .. L.parkour.rewardCoins .. " 💰"
		end
		LobbyService.toast(p, msg, GOLD)
	end)
end

-- ==========================================================================================
-- Démarrage
-- ==========================================================================================
function LobbyService.start()
	Players.CharacterAutoLoads = false
	build()
	hookParkour()
	;(rangeStart:FindFirstChildOfClass("ProximityPrompt") :: ProximityPrompt).Triggered:Connect(startChallenge)

	local function onJoin(p: Player)
		p:SetAttribute("Zone", "lobby")
		task.spawn(LobbyService.spawn, p)
	end
	-- sortie d'une partie (menu, fin de partie, « Retour au lobby ») : on revient au lobby
	MatchService.setLobbyHooks(function(p: Player)
		parkourRun[p] = nil
		if challenge.player == p then endChallenge() end
	end, function(p: Player) LobbyService.spawn(p) end)
	Players.PlayerAdded:Connect(onJoin)
	for _, p in ipairs(Players:GetPlayers()) do onJoin(p) end
	Players.PlayerRemoving:Connect(function(p)
		parkourRun[p] = nil
		if challenge.player == p then endChallenge() end
	end)

	local joinFn = Instance.new("RemoteFunction"); joinFn.Name = "JoinMatch"; joinFn.Parent = ReplicatedStorage
	-- même cadence que MatchQuick : chaque partie rapide peut construire une carte
	joinFn.OnServerInvoke = function(p) return RateLimit.ok(p, "MatchCreate", 2) and LobbyService.joinMatch(p) end
	local leaveFn = Instance.new("RemoteFunction"); leaveFn.Name = "LeaveMatch"; leaveFn.Parent = ReplicatedStorage
	leaveFn.OnServerInvoke = function(p) return LobbyService.leaveMatch(p) end
end

return LobbyService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="429">
      <Properties>
        <string name="Name">LootService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/LootService (Script)
-- Ouverture des caisses : tirage pondéré + système de pitié, doublons convertis en pièces.
-- Les probabilités DOIVENT être affichées dans l'interface (règle Roblox pour les objets aléatoires payants).
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local DataService = require(script.Parent.DataService)

local remote = Instance.new("RemoteFunction")
remote.Name = "OpenBox"
remote.Parent = ReplicatedStorage

-- Construit le pool d'objets une seule fois
local pool: { { kind: string, weapon: string?, skin: number?, dance: string?, outfit: number?, rarity: number } } = {}
for weaponKey in pairs(Config.WEAPONS) do
	for i, skin in ipairs(Config.SKINS) do
		if skin.rarity > 1 and not (skin :: any).ev then        -- skins d'événement (Halloween) : jamais dans les caisses
			table.insert(pool, { kind = "skin", weapon = weaponKey, skin = i, rarity = skin.rarity })
		end
	end
end
for id, d in pairs(Config.DANCES) do
	if d.rarity > 1 then table.insert(pool, { kind = "dance", dance = id, rarity = d.rarity }) end
end
for i, o in ipairs(Config.OUTFITS) do
	if o.rarity > 1 and not (o :: any).ev then table.insert(pool, { kind = "outfit", outfit = i, rarity = o.rarity }) end
end

local function owns(profile, item): boolean
	if item.kind == "skin" then
		local list = profile.inv.skins[item.weapon]
		return list ~= nil and table.find(list, item.skin) ~= nil
	end
	if item.kind == "outfit" then return table.find(profile.inv.outfits or {}, item.outfit) ~= nil end
	return table.find(profile.inv.dances, item.dance) ~= nil
end

local function rollRarity(profile, weights: { number }): number
	if profile.pity.legend >= Config.PITY.legend - 1 then return 4 end
	if profile.pity.epic >= Config.PITY.epic - 1 then
		return (math.random() * (weights[3] + weights[4]) < weights[4]) and 4 or 3
	end
	local total = 0
	for _, w in ipairs(weights) do total += w end
	local r = math.random() * total
	for i, w in ipairs(weights) do
		r -= w
		if r <= 0 then return i end
	end
	return 1
end

local function openBox(player: Player, boxType: string)
	local def = Config.BOXES[boxType]
	local profile = DataService.get(player)
	if not def or not profile then return { ok = false, err = "invalid" } end

	-- paiement : caisse en stock sinon pièces
	if (profile.boxes[boxType] or 0) > 0 then
		profile.boxes[boxType] -= 1
	elseif profile.coins >= def.coins then
		profile.coins -= def.coins
	else
		return { ok = false, err = "not_enough_coins" }
	end

	local rarity = rollRarity(profile, def.weights)
	profile.pity.epic = (rarity >= 3) and 0 or profile.pity.epic + 1
	profile.pity.legend = (rarity == 4) and 0 or profile.pity.legend + 1
	profile.opened += 1

	local result: any = { ok = true, rarity = rarity, duplicate = false, coins = 0 }
	if rarity == 1 then
		result.item = { kind = "coins" }
		result.coins = math.random(40, 90)
		profile.coins += result.coins
	else
		local candidates = {}
		for _, it in ipairs(pool) do if it.rarity == rarity then table.insert(candidates, it) end end
		local item = candidates[math.random(#candidates)]
		result.item = item
		if owns(profile, item) then
			result.duplicate = true
			result.coins = Config.DUPLICATE_VALUE[rarity]
			profile.coins += result.coins
		elseif item.kind == "skin" then
			profile.inv.skins[item.weapon] = profile.inv.skins[item.weapon] or {}
			table.insert(profile.inv.skins[item.weapon], item.skin)
		elseif item.kind == "outfit" then
			profile.inv.outfits = profile.inv.outfits or {}
			table.insert(profile.inv.outfits, item.outfit)
		else
			table.insert(profile.inv.dances, item.dance)
		end
	end
	return result
end

remote.OnServerInvoke = function(player: Player, boxType: any)
	if typeof(boxType) ~= "string" then return { ok = false, err = "invalid" } end
	return openBox(player, boxType)
end

-- Les caisses achetées en Robux passent par ShopService (un seul ProcessReceipt possible par jeu) : voir ConfigExtra.SHOP.
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="430">
      <Properties>
        <string name="Name">LoyaltyService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/LoyaltyService (ModuleScript)
-- Fidélité et Premium : cadeaux de temps de jeu, paliers de série, rang de fidélité, bonus de fin de partie,
-- abonnement Premium (jours cumulables achetés en Robux, crédités par ShopService) et couleur de pseudo.
-- Valeurs dans ReplicatedStorage/Shared/LoyaltyConfig. Le serveur vérifie tout, le client ne fait qu'afficher.
-- Branché dans : RewardService.finishMatch (bonus), RewardService.dailyStatus/claimDaily (série protégée), ShopService (achat).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local L = require(ReplicatedStorage.Shared.LoyaltyConfig)
local DataService = require(script.Parent.DataService)

local LoyaltyService = {}

local function today(): number return math.floor(os.time() / 86400) end
local function week(): number return math.floor((today() + 3) / 7) end   -- semaine commençant le lundi

-- ---------- données du profil ----------
function LoyaltyService.ensure(profile: any)
	local y = profile.loy
	if not y then
		y = { day = 0, secs = 0, got = {}, days = 0, lastDay = 0, total = 0, tiers = { 1 }, streakGot = {}, boost = 0, win = 0,
			back = 0, titles = {}, vip = { untilTime = 0, color = "gold", daily = 0, shield = 0 } }
		profile.loy = y
	end
	if y.day ~= today() then y.day = today(); y.secs = 0; y.got = {} end
	return y
end
local ensure = LoyaltyService.ensure

function LoyaltyService.isVip(profile: any): boolean
	return ensure(profile).vip.untilTime > os.time()
end
local isVip = LoyaltyService.isVip

local function tierIndex(y: any): number
	local idx = 1
	for i, t in ipairs(L.TIERS) do if y.days >= t.days then idx = i end end
	return idx
end

local function addTitle(y: any, id: string)
	if not table.find(y.titles, id) then table.insert(y.titles, id) end
end

local function apply(profile: any, r: any)
	local y = ensure(profile)
	if r.coins then profile.coins += r.coins end
	if r.box then profile.boxes[r.box] = (profile.boxes[r.box] or 0) + (r.n or 1) end
	if r.boost then y.boost += r.boost end
	if r.title then addTitle(y, r.title) end
end
LoyaltyService.give = apply   -- { coins, box, n, boost, title } : utilisé aussi par le pack de départ (ShopService)

-- Attributs lus par les clients (chat, futur HUD) : Vip, VipColor, LoyaltyTier
local function publish(player: Player, profile: any)
	local y = ensure(profile)
	local vip = isVip(profile)
	player:SetAttribute("Vip", vip)
	player:SetAttribute("VipColor", if vip then y.vip.color else "")
	player:SetAttribute("LoyaltyTier", tierIndex(y))
end
LoyaltyService.publish = publish

-- ---------- ce qui peut être récupéré ----------
local function ready(profile: any, kind: string, i: number): (boolean, any)
	local y = ensure(profile)
	if kind == "pt" then
		local g = L.PLAYTIME_GIFTS[i]
		return g ~= nil and y.secs >= g.minutes * 60 and not table.find(y.got, i), g and g.reward
	elseif kind == "st" then
		local g = L.STREAK_GOALS[i]
		return g ~= nil and (profile.streak or 0) >= g.days and not table.find(y.streakGot, g.days), g and g.reward
	elseif kind == "tier" then
		local t = L.TIERS[i]
		return t ~= nil and t.reward ~= nil and y.days >= t.days and not table.find(y.tiers, i), t and t.reward
	elseif kind == "vip" then
		return isVip(profile) and y.vip.daily ~= today(), L.VIP.daily
	end
	return false, nil
end

function LoyaltyService.claim(player: Player, kind: string, i: number)
	local profile = DataService.get(player); if not profile then return nil end
	local ok, r = ready(profile, kind, i)
	if not ok then return nil end
	local y = ensure(profile)
	if kind == "pt" then table.insert(y.got, i)
	elseif kind == "st" then table.insert(y.streakGot, L.STREAK_GOALS[i].days)
	elseif kind == "tier" then table.insert(y.tiers, i)
	elseif kind == "vip" then y.vip.daily = today() end
	apply(profile, r)
	return r
end

function LoyaltyService.state(player: Player)
	local profile = DataService.get(player); if not profile then return nil end
	local y = ensure(profile)
	local pending = {}
	for i in ipairs(L.PLAYTIME_GIFTS) do if ready(profile, "pt", i) then table.insert(pending, { "pt", i }) end end
	for i in ipairs(L.STREAK_GOALS) do if ready(profile, "st", i) then table.insert(pending, { "st", i }) end end
	for i in ipairs(L.TIERS) do if ready(profile, "tier", i) then table.insert(pending, { "tier", i }) end end
	if ready(profile, "vip", 0) then table.insert(pending, { "vip", 0 }) end
	return { minutes = math.floor(y.secs / 60), got = y.got, streak = profile.streak or 0, streakGot = y.streakGot, days = y.days,
		tier = tierIndex(y), tiers = y.tiers, boost = y.boost, firstWinAvailable = y.win ~= today(), titles = y.titles,
		vip = isVip(profile), vipDaysLeft = math.max(0, math.ceil((y.vip.untilTime - os.time()) / 86400)), vipColor = y.vip.color,
		pending = pending }
end

-- ---------- temps de jeu : le joueur doit avoir un personnage en vie (pas l'écran de chargement ni un AFK mort) ----------
task.spawn(function()
	while true do
		task.wait(1)
		for _, player in ipairs(Players:GetPlayers()) do
			local profile = DataService.get(player)
			local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if profile and hum and hum.Health > 0 then
				local y = ensure(profile)
				local before = math.floor(y.secs / 60)
				y.secs += 1; y.total += 1
				local now = math.floor(y.secs / 60)
				if now ~= before then
					for _, g in ipairs(L.PLAYTIME_GIFTS) do
						if g.minutes == now then player:SetAttribute("LoyaltyGiftReady", now) end   -- le client affiche « Cadeau débloqué ! »
					end
				end
			end
		end
	end
end)

-- ---------- bonus de fin de partie (appelé par RewardService.finishMatch) ----------
-- Retourne l'XP et les pièces en plus, et les lignes à afficher.
function LoyaltyService.matchBonus(player: Player, baseXp: number, baseCoins: number, won: boolean): (number, number, { string }, boolean)
	local profile = DataService.get(player); if not profile then return 0, 0, {}, false end
	local y = ensure(profile)
	local xp, coins, lines = 0, 0, {}
	if y.lastDay ~= today() then y.lastDay = today(); y.days += 1 end   -- un jour de jeu de plus
	local tier = L.TIERS[tierIndex(y)]
	if tier.xp > 0 then
		local v = math.floor(baseXp * tier.xp / 100 + 0.5); xp += v
		table.insert(lines, string.format("Fidélité +%d %% (%d XP)", tier.xp, v))
	end
	if isVip(profile) then
		local v, c = math.floor(baseXp * L.VIP.xp + 0.5), math.floor(baseCoins * L.VIP.coins + 0.5)
		xp += v; coins += c
		table.insert(lines, string.format("⭐ Premium +%d XP, +%d pièces", v, c))
	end
	if y.boost > 0 then
		local v = math.floor(baseXp * L.BOOST_MULT + 0.5); xp += v; y.boost -= 1
		table.insert(lines, string.format("⚡ Boost +%d XP (%d restante(s))", v, y.boost))
	end
	local firstWin = false
	if won and y.win ~= today() then
		y.win = today(); xp += L.FIRST_WIN.xp; coins += L.FIRST_WIN.coins; firstWin = true
		table.insert(lines, string.format("🏆 Première victoire du jour +%d XP, +%d pièces", L.FIRST_WIN.xp, L.FIRST_WIN.coins))
	end
	publish(player, profile)
	return xp, coins, lines, firstWin
end

-- ---------- série protégée (Premium) : un jour manqué par semaine ne casse pas la série ----------
-- lastLoginDay = avant-hier, série en cours, Premium actif, bouclier pas encore utilisé cette semaine.
function LoyaltyService.shieldOk(profile: any): boolean
	local y = ensure(profile)
	return isVip(profile) and (profile.streak or 0) > 0 and profile.lastLoginDay == today() - 2 and y.vip.shield ~= week()
end
function LoyaltyService.useShield(profile: any)
	ensure(profile).vip.shield = week()
end

-- ---------- abonnement Premium (appelé par ShopService.ProcessReceipt) ----------
function LoyaltyService.grantVip(player: Player, days: number)
	local profile = DataService.get(player); if not profile then return false end
	local y = ensure(profile)
	y.vip.untilTime = math.max(os.time(), y.vip.untilTime) + days * 86400
	addTitle(y, "vip")
	apply(profile, L.VIP.onPurchase)
	publish(player, profile)
	return true
end

-- ---------- bon retour : après BACK_DAYS jours sans récompense quotidienne ----------
local function welcomeBack(player: Player, profile: any)
	local y = ensure(profile)
	local last = profile.lastLoginDay or 0
	if last <= 0 or y.back == today() or today() - last < L.BACK_DAYS then return end
	y.back = today()
	apply(profile, L.BACK_GIFT)
	player:SetAttribute("LoyaltyWelcomeBack", today() - last)   -- le client affiche la grande fenêtre « Bon retour ! »
end

-- ---------- remotes ----------
local function remoteFunction(name: string, fn: (Player, ...any) -> any)
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage
	r.OnServerInvoke = fn
end
remoteFunction("Loy_Get", function(p) return LoyaltyService.state(p) end)
remoteFunction("Loy_Claim", function(p, kind: any, i: any)
	if typeof(kind) ~= "string" or typeof(i) ~= "number" then return nil end
	return LoyaltyService.claim(p, kind, i)
end)
remoteFunction("Vip_SetColor", function(p, id: any)
	local profile = DataService.get(p)
	if not profile or typeof(id) ~= "string" or not isVip(profile) then return false end
	local known = false
	for _, c in ipairs(L.VIP.colors) do if c.id == id then known = true end end
	if not known then return false end
	ensure(profile).vip.color = id
	publish(p, profile)
	return true
end)

-- Profil chargé par DataService : on attend qu'il existe puis on publie les attributs
Players.PlayerAdded:Connect(function(player)
	for _ = 1, 30 do
		local profile = DataService.get(player)
		if profile then publish(player, profile); welcomeBack(player, profile); return end
		task.wait(1)
	end
end)

return LoyaltyService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="431">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/Main (Script) — point d'entrée serveur
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
require(script.Parent.WeaponService)
require(script.Parent.CodeService)        -- codes promo + récompense du groupe Roblox
require(script.Parent.KillFxService)      -- effets d'élimination
local ProgressService = require(script.Parent.ProgressService)
require(script.Parent.MenuService)        -- menu principal : défis de la semaine, réglages gardés, titre
require(script.Parent.MedalService)       -- médailles, bilan perso et défis de fin de partie (src/8G_medals.js, src/8O_defis.js)
require(script.Parent.RecapService)       -- écran de fin : détail des gains, barre de niveau, défis terminés (après MedalService)
require(script.Parent.CareerService)      -- carrière par arme, maîtrise (camos Or/Diamant), carte de joueur, records d'entraînement
require(script.Parent.AdminService)       -- panneau admin (propriétaire du jeu + code, src/8M_admin.js)
require(script.Parent.HalloweenService)   -- décor d'Halloween du lobby et des cartes, citrouilles lâchées (src/8W_halloween.js)
require(script.Parent.SprayService)       -- sprays sur les murs (touche J, src/64_extras.js)
require(script.Parent.TeamCommsService)   -- ping et messages rapides d'équipe (touches molette/K et N)
require(script.Parent.PerkDrinkService)   -- boisson d'atout (src/8U_perkdrink.js), appelée quand on prend un atout en Zombies
local LeaderboardService = require(script.Parent.LeaderboardService)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)

-- ---------- Remotes pour l'interface (profil, récompense quotidienne, défis) ----------
local function remoteFunction(name: string): RemoteFunction
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; return r
end

local getProfile = remoteFunction("GetProfile")
getProfile.OnServerInvoke = function(player: Player)
	local profile = DataService.get(player)
	if not profile then return nil end
	RewardService.ensureMissions(profile)
	RewardService.ensureWeekly(profile)
	ProgressService.ensure(profile)              -- passe de saison, classement, événement (affichés par le menu)
	local level, cur, need = RewardService.levelInfo(profile)
	return { profile = profile, level = level, xp = cur, xpNeed = need, daily = RewardService.dailyStatus(profile),
		eventActive = ProgressService.eventActive(), now = os.time(), weekend = RewardService.weekend() }
end

local claimDaily = remoteFunction("ClaimDaily")
claimDaily.OnServerInvoke = function(player: Player)
	local reward, day = RewardService.claimDaily(player)
	return reward and { reward = reward, day = day } or nil
end

local claimMission = remoteFunction("ClaimMission")
claimMission.OnServerInvoke = function(player: Player, index: any)
	if typeof(index) ~= "number" then return nil end
	return RewardService.claimMission(player, index)
end

-- liste complète des défis du jour et de la semaine avec leurs textes (ClaimWeekly est dans MenuService)
local getChallenges = remoteFunction("GetChallenges")
getChallenges.OnServerInvoke = function(player: Player) return RewardService.challenges(player) end

local equipDance = remoteFunction("EquipDance")
equipDance.OnServerInvoke = function(player: Player, id: any)
	local profile = DataService.get(player)
	if not profile or typeof(id) ~= "string" or not table.find(profile.inv.dances, id) then return false end
	profile.equippedDance = id
	return true
end

local equipSkin = remoteFunction("EquipSkin")
equipSkin.OnServerInvoke = function(player: Player, weapon: any, skinIndex: any)
	local profile = DataService.get(player)
	if not profile or typeof(weapon) ~= "string" or typeof(skinIndex) ~= "number" then return false end
	local Config = require(ReplicatedStorage.Shared.Config)
	local skin = Config.SKINS[skinIndex]
	if not skin or not Config.WEAPONS[weapon] then return false end
	local owned = skin.rarity == 1 or (profile.inv.skins[weapon] and table.find(profile.inv.skins[weapon], skinIndex))
	if not owned then return false end
	profile.equippedSkins = profile.equippedSkins or {}
	profile.equippedSkins[weapon] = skinIndex
	if profile.equipped and profile.equipped.animCamo then profile.equipped.animCamo[weapon] = nil end   -- un skin remplace le camo animé
	DataService.syncSkins(player)
	return true
end

-- ---------- Parties (MatchService) et lobby ----------
-- Chaque joueur lance sa partie depuis le menu (mode, carte, bots, comme l'écran « Jouer » du web) ou passe par
-- « Partie rapide » ; plusieurs parties tournent en même temps sur le serveur, chacune sur sa propre carte.
local MatchService = require(script.Parent.MatchService)
Players.CharacterAutoLoads = false
if CommunityConfig.LOBBY_ENABLED then
	-- lobby jouable (stand de tir, parcours, classement géant, bornes) + duels 1v1 / 2v2 depuis ses plateformes
	local LobbyService = require(script.Parent.LobbyService)
	LobbyService.start()
	LeaderboardService.start(LobbyService.board)
	require(script.Parent.DuelService).start()
else
	-- sans lobby : on arrive directement dans une partie rapide
	LeaderboardService.start(nil)
	local function arrive(p: Player) task.delay(2, function() if p.Parent then MatchService.quick(p, ModeConfig.MODE) end end) end
	Players.PlayerAdded:Connect(arrive)
	for _, p in ipairs(Players:GetPlayers()) do arrive(p) end
end
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="432">
      <Properties>
        <string name="Name">MapBuilder</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/MapBuilder (ModuleScript)
-- Construit une carte du web dans Workspace, à l'identique :
--   • Collision : blocs invisibles tirés de la grille de jeu du web (cases, hauteurs, rampes, plafonds), comme la
--     collision et les lignes de vue du web (groundH / ceilAt / rayWall). Ce sont les seules pièces touchées par
--     les balles, les bots et les déplacements.
--   • Décor : tous les blocs, boules et cylindres du décor 3D du web (MapScenes, tools/export_scene.js), en Parts
--     non collisionnables et ignorées des rayons (CanQuery = false), avec le matériau PBR haute définition de Roblox
--     qui remplace les textures floues du web (MapScene.hdMaterial). Le client (MapDetailController) ajoute les
--     maillages détaillés, les textures du web, les halos et l'ambiance (ciel, brouillard, lumière) de la carte.
-- Plusieurs cartes peuvent coexister (une par match) : build(id, origine, nom) décale tout de l'origine.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local MapScene = require(ReplicatedStorage.Shared.MapScene)

local MapBuilder = {}

local U = Config.STUDS_PER_METER           -- studs par mètre
local S = Config.CELL                      -- taille d'une case en mètres (2)
local CELL = S * U                         -- taille d'une case en studs
local MAXP = 2048                          -- taille maximale d'une Part

export type MapObj = {
	id: string, folder: Folder, origin: Vector3, data: any, grid: any,
	spawns: { T: { Vector3 }, CT: { Vector3 }, DM: { Vector3 } }, sites: { { name: string, pos: Vector3, radius: number } },
	cellToWorld: (cx: number, cz: number) -> Vector3, groundAt: (pos: Vector3) -> number, toCell: (pos: Vector3) -> (number, number),
}

-- couleurs de repli de l'ancien constructeur (carte sans décor exporté)
local FALLBACK = { [1] = Color3.fromRGB(226, 208, 168), [2] = Color3.fromRGB(165, 118, 64), [3] = Color3.fromRGB(235, 225, 203), [4] = Color3.fromRGB(190, 175, 140),
	[5] = Color3.fromRGB(190, 175, 140), [6] = Color3.fromRGB(205, 180, 140), [7] = Color3.fromRGB(125, 138, 106), [8] = Color3.fromRGB(150, 156, 163), [9] = Color3.fromRGB(205, 190, 160) }

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame): Part
	local p = Instance.new("Part")
	p.Name = name; p.Anchored = true; p.Size = size; p.CFrame = cf
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = parent
	return p
end

local function solid(parent: Instance, name: string, size: Vector3, cf: CFrame): Part
	local p = part(parent, name, size, cf)
	p.Transparency = 1; p.CastShadow = false; p.Material = Enum.Material.SmoothPlastic
	return p
end

-- ---------- grille : hauteur du sol (rampes comprises) en mètres, comme groundH() du web ----------
local function groundH(g: any, x: number, z: number): number
	local N = MapData.N
	local cx, cz = math.floor(x / S), math.floor(z / S)
	if cx < 0 or cz < 0 or cx >= N or cz >= N then return 99 end
	local i = cz * N + cx
	local r = g.ramp[i]
	if r and r ~= 0 then
		local R = g.ramps[r]
		local t = if R.axis == "x" then (x - R.x1 * S) / ((R.x2 - R.x1 + 1) * S) else (z - R.z1 * S) / ((R.z2 - R.z1 + 1) * S)
		return R.hA + (R.hB - R.hA) * math.clamp(t, 0, 1)
	end
	return g.h[i]
end
MapBuilder.groundH = groundH

-- rectangles maximaux de cases de même valeur (moins de Parts) ; key(i) renvoie nil pour « rien »
local function rects(key: (number) -> number?, fn: (x1: number, z1: number, x2: number, z2: number, v: number) -> ())
	local N = MapData.N
	local used = table.create(N * N, false)
	for z = 0, N - 1 do
		for x = 0, N - 1 do
			local i = z * N + x
			local v = key(i)
			if v and not used[i + 1] then
				local x2 = x
				while x2 + 1 < N and not used[z * N + x2 + 2] and key(z * N + x2 + 1) == v do x2 += 1 end
				local z2 = z
				while z2 + 1 < N do
					local ok = true
					for xx = x, x2 do local j = (z2 + 1) * N + xx; if used[j + 1] or key(j) ~= v then ok = false; break end end
					if not ok then break end
					z2 += 1
				end
				for zz = z, z2 do for xx = x, x2 do used[zz * N + xx + 1] = true end end
				fn(x, z, x2, z2, v)
			end
		end
	end
end

-- ---------- collision exacte du web ----------
local function buildCollision(folder: Folder, g: any, origin: Vector3)
	local N = MapData.N
	local col = Instance.new("Folder"); col.Name = "Collision"; col.Parent = folder
	local W = N * CELL
	-- sol (la grille) et murs invisibles tout autour : hors de la grille, le web bloque (groundH = 99)
	solid(col, "Floor", Vector3.new(W, 4, W), CFrame.new(origin + Vector3.new(W / 2, -2, W / 2)))
	local wallH = 40 * U
	for _, e in ipairs({ { W / 2, -1, W + 4, 2 }, { W / 2, W + 1, W + 4, 2 }, { -1, W / 2, 2, W + 4 }, { W + 1, W / 2, 2, W + 4 } }) do
		solid(col, "Border", Vector3.new(e[3], wallH, e[4]), CFrame.new(origin + Vector3.new(e[1], wallH / 2, e[2])))
	end
	-- colonnes pleines (murs, caisses, maisons, plateformes, fûts, piliers, blocs invisibles sous les décors)
	rects(function(i)
		if g.type[i] ~= 0 and g.ramp[i] == 0 and g.h[i] > 0 then return g.h[i] end
		return nil
	end, function(x1, z1, x2, z2, h)
		local sx, sz, hs = (x2 - x1 + 1) * CELL, (z2 - z1 + 1) * CELL, h * U
		local p = solid(col, "Block", Vector3.new(sx, hs, sz), CFrame.new(origin + Vector3.new(x1 * CELL + sx / 2, hs / 2, z1 * CELL + sz / 2)))
		p:SetAttribute("CellType", g.type[z1 * N + x1])
	end)
	-- plafonds : au-dessus de G_CEIL tout est plein sur le web (tunnels, souk, hangars, salles)
	local CEILH = 14 * U
	rects(function(i) local c = g.ceil[i]; return if c < 90 then c else nil end, function(x1, z1, x2, z2, h)
		local sx, sz = (x2 - x1 + 1) * CELL, (z2 - z1 + 1) * CELL
		solid(col, "Ceiling", Vector3.new(sx, CEILH, sz), CFrame.new(origin + Vector3.new(x1 * CELL + sx / 2, h * U + CEILH / 2, z1 * CELL + sz / 2)))
	end)
	-- rampes : pente continue (WedgePart) comme groundH() du web, plus un socle sous la partie basse
	for _, R in ipairs(g.ramps) do
		local lenC = if R.axis == "x" then R.x2 - R.x1 + 1 else R.z2 - R.z1 + 1
		local widC = if R.axis == "x" then R.z2 - R.z1 + 1 else R.x2 - R.x1 + 1
		local lo, hi = math.min(R.hA, R.hB), math.max(R.hA, R.hB)
		local cx = (R.x1 + (R.x2 - R.x1 + 1) / 2) * CELL
		local cz = (R.z1 + (R.z2 - R.z1 + 1) / 2) * CELL
		-- la face haute d'une WedgePart est du côté +Z local : on la tourne vers le côté haut de la rampe
		local up = R.hB > R.hA
		local yaw = if R.axis == "x" then (if up then math.pi / 2 else -math.pi / 2) else (if up then 0 else math.pi)
		local L, Wd = lenC * CELL, widC * CELL
		if hi - lo > 0.01 then
			local w = Instance.new("WedgePart")
			w.Name = "Ramp"; w.Anchored = true; w.Transparency = 1; w.CastShadow = false
			w.Size = Vector3.new(Wd, (hi - lo) * U, L)
			w.CFrame = CFrame.new(origin + Vector3.new(cx, lo * U + (hi - lo) * U / 2, cz)) * CFrame.Angles(0, yaw, 0)
			w.Parent = col
		end
		if lo > 0.01 then
			local sx = if R.axis == "x" then L else Wd
			local sz = if R.axis == "x" then Wd else L
			solid(col, "RampBase", Vector3.new(sx, lo * U, sz), CFrame.new(origin + Vector3.new(cx, lo * U / 2, cz)))
		end
	end
end

-- ---------- décor : primitives du web ----------
local faceMain = MapScene.faceMain

local function mulC(a: Color3, b: Color3): Color3 return Color3.new(a.R * b.R, a.G * b.G, a.B * b.B) end

-- graine de la petite variation de teinte (MapScene.vary) de chaque bloc. Les blocs alignés dont une face est dans le
-- même plan qu'une face d'un autre bloc et la recouvre en partie (dalles de 2,12 m posées tous les 2 m, murs du web qui
-- se chevauchent), du même matériau et de la même couleur, prennent la même graine : sinon la bande commune clignote
-- entre les deux teintes (z-fighting), en quadrillage sur les sols des 10 cartes (environ 2 000 recouvrements par carte,
-- mesurés sur MapScenes).
local function shadeSeeds(list: { MapScene.Prim }): { number }
	local parent = table.create(#list, 0)
	for i = 1, #list do parent[i] = i end
	local function find(i: number): number
		while parent[i] ~= i do parent[i] = parent[parent[i]]; i = parent[i] end
		return i
	end
	-- faces de chaque bloc aligné : plan (axe, sens, position au millimètre) -> { bloc, rectangle sur les deux autres axes }
	local planes: { [string]: { { any } } } = {}
	for i, p in ipairs(list) do
		if p.kind == 0 then
			local half = { 0, 0, 0 }
			local aligned = true
			local look = faceMain(p) .. "|" .. (if p.color then p.color:ToHex() else "")
			for j, v in ipairs({ p.rot.XVector, p.rot.YVector, p.rot.ZVector }) do
				local c = { math.abs(v.X), math.abs(v.Y), math.abs(v.Z) }
				local ax = if c[1] > 0.999 then 1 elseif c[2] > 0.999 then 2 elseif c[3] > 0.999 then 3 else 0
				if ax == 0 then aligned = false; break end
				half[ax] = (if j == 1 then p.size.X elseif j == 2 then p.size.Y else p.size.Z) / 2
			end
			if aligned then
				local c = { p.pos.X, p.pos.Y, p.pos.Z }
				for ax = 1, 3 do
					local o1, o2 = if ax == 1 then 2 else 1, if ax == 3 then 2 else 3
					local rect = { i, c[o1] - half[o1], c[o1] + half[o1], c[o2] - half[o2], c[o2] + half[o2] }
					for _, sg in ipairs({ -1, 1 }) do
						local key = ax .. (if sg > 0 then "+" else "-") .. math.floor((c[ax] + sg * half[ax]) * 1000 + 0.5) .. "|" .. look
						local l = planes[key]
						if not l then l = {}; planes[key] = l end
						table.insert(l, rect)
					end
				end
			end
		end
	end
	for _, l in pairs(planes) do
		for a = 1, #l - 1 do
			local ra = l[a]
			for b = a + 1, #l do
				local rb = l[b]
				if math.min(ra[3], rb[3]) - math.max(ra[2], rb[2]) > 0.01 and math.min(ra[5], rb[5]) - math.max(ra[4], rb[4]) > 0.01 then
					local x, y = find(ra[1]), find(rb[1])
					if x ~= y then parent[math.max(x, y)] = math.min(x, y) end
				end
			end
		end
	end
	local seeds = table.create(#list, 0)
	for i = 1, #list do seeds[i] = find(i) end
	return seeds
end

-- ---------- faces presque confondues (z-fighting) ----------
-- Le web empile des surfaces à quelques millimètres les unes des autres (calque d'ombres 1,2 cm au-dessus du sol dessiné,
-- nez de marche 5 mm au-dessus de la marche, affiches et vitraux contre les murs) : sous Roblox elles scintillent l'une
-- dans l'autre dès qu'on s'éloigne. Quand deux faces alignées de même sens se recouvrent à moins de GAP studs (GAP_BIG
-- pour deux grandes surfaces vues de loin), la face extérieure (celle du plus petit bloc si elles sont confondues) est
-- avancée jusqu'à cet écart en allongeant son bloc : 5 cm au plus (mesuré sur les 10 cartes : 60 à 170 faces par carte),
-- invisible. Deux faces confondues de même matériau, même couleur et même transparence (dalles qui se chevauchent) ne
-- bougent pas : elles ne peuvent pas scintiller.
local GAP, GAP_BIG = 0.05, 0.08
type Face = { part: BasePart, look: string, j: number, axv: Vector3, sg: number, off: number, qoff: number, adj: number, r: { number }, area: number }
local function separateFaces(items: { { part: BasePart, prim: MapScene.Prim } })
	local buckets: { [number]: { Face } } = {}
	for _, it in ipairs(items) do
		local p, q = it.prim, it.part
		if p.kind == 0 then
			local half, jOf, sOf = { 0, 0, 0 }, { 0, 0, 0 }, { 1, 1, 1 }
			local ok = true
			local sz = q.Size
			for j, v in ipairs({ q.CFrame.XVector, q.CFrame.YVector, q.CFrame.ZVector }) do
				local ax = if math.abs(v.X) > 0.999 then 1 elseif math.abs(v.Y) > 0.999 then 2 elseif math.abs(v.Z) > 0.999 then 3 else 0
				if ax == 0 then ok = false; break end
				half[ax] = (if j == 1 then sz.X elseif j == 2 then sz.Y else sz.Z) / 2
				jOf[ax] = j
				sOf[ax] = if (if ax == 1 then v.X elseif ax == 2 then v.Y else v.Z) > 0 then 1 else -1
			end
			if ok then
				local pos = q.Position
				local c = { pos.X, pos.Y, pos.Z }
				local hidden = q.Transparency >= 0.999
				local look = q.Material.Name .. q.Color:ToHex() .. q.Transparency
				for ax = 1, 3 do
					local o1, o2 = if ax == 1 then 2 else 1, if ax == 3 then 2 else 3
					local r = { c[o1] - half[o1], c[o1] + half[o1], c[o2] - half[o2], c[o2] + half[o2] }
					for _, sg in ipairs({ -1, 1 }) do
						-- bloc invisible (texture découpée posée par le client) : seules ses faces texturées comptent
						local k = (jOf[ax] - 1) * 2 + (if sg * sOf[ax] > 0 then 1 else 2)
						if not hidden or p.mats[k] > 0 then
							local key = ax * 2 + (if sg > 0 then 1 else 0)
							local l = buckets[key]
							if not l then l = {}; buckets[key] = l end
							local off = c[ax] + sg * half[ax]
							table.insert(l, { part = q, look = look, j = jOf[ax], axv = if ax == 1 then Vector3.xAxis elseif ax == 2 then Vector3.yAxis else Vector3.zAxis,
								sg = sg, off = off * sg, qoff = math.floor(off * sg * 10000 + 0.5), adj = off * sg, r = r, area = (r[2] - r[1]) * (r[4] - r[3]) })
						end
					end
				end
			end
		end
	end
	local grow: { [BasePart]: { size: Vector3, shift: Vector3 } } = {}
	for _, l in pairs(buckets) do
		-- tri par plan (au 1/10 000 de stud, ordre strict) puis du plus grand au plus petit bloc
		table.sort(l, function(a, b)
			if a.qoff ~= b.qoff then return a.qoff < b.qoff end
			return a.area > b.area
		end)
		for i = 2, #l do
			local f = l[i]
			local fp = f.part
			for gi = i - 1, 1, -1 do
				local g = l[gi]
				if f.off - g.off > GAP_BIG then break end
				if g.part ~= fp and not (f.qoff == g.qoff and f.look == g.look) then
					local ox = math.min(f.r[2], g.r[2]) - math.max(f.r[1], g.r[1])
					local oy = math.min(f.r[4], g.r[4]) - math.max(f.r[3], g.r[3])
					if ox > 0.05 and oy > 0.05 then
						local need = if math.min(ox, oy) > 100 then GAP_BIG else GAP
						if f.adj < g.adj + need then f.adj = g.adj + need end
					end
				end
			end
			local d = f.adj - f.off
			if d > 1e-5 then
				local gr = grow[fp]
				if not gr then gr = { size = Vector3.zero, shift = Vector3.zero }; grow[fp] = gr end
				gr.size += if f.j == 1 then Vector3.new(d, 0, 0) elseif f.j == 2 then Vector3.new(0, d, 0) else Vector3.new(0, 0, d)
				gr.shift += f.axv * (f.sg * d / 2)
			end
		end
	end
	for q, gr in pairs(grow) do
		q.Size += gr.size
		q.CFrame = q.CFrame + gr.shift
	end
end

local function buildVisuals(folder: Folder, id: string, origin: Vector3): number
	local info = MapScene.info(id)
	if not info then return 0 end
	local vis = Instance.new("Folder"); vis.Name = "Visuals"
	local mats = info.mats
	local count = 0
	local items: { { part: BasePart, prim: MapScene.Prim } } = {}
	local md = MapData[id]
	local theme, base = md and md.theme, md and md.base
	local list = MapScene.prims(id)
	local seeds = shadeSeeds(list)
	for i, p in ipairs(list) do
		local mi = if p.kind == 0 then faceMain(p) else p.mats[1]
		local m: MapScene.Mat? = if mi > 0 then mats[mi] else nil
		if m then
			local size = p.size * U
			local q = Instance.new("Part")
			q.Name = if p.kind == 0 then "Box" elseif p.kind == 1 then "Ball" else "Cyl"
			q.Anchored = true; q.CanCollide = false; q.CanQuery = false; q.CanTouch = false
			q.TopSurface = Enum.SurfaceType.Smooth; q.BottomSurface = Enum.SurfaceType.Smooth
			local col = MapScene.color(m.avg)
			if p.color then col = mulC(col, p.color) end
			-- matériau PBR haute définition à la place d'une texture floue du web (MapScene.hdMaterial) : le client ne pose
			-- alors pas la texture ; teinte légèrement variée d'un bloc à l'autre
			local hd = MapScene.hdMaterial(m)
			q.Material = hd or MapScene.material(m.rm)
			-- sol de jeu (texture de détail du web) et grand sol extérieur : matériau du sol de la carte (grain, relief)
			local big = (if p.size.X > 300 then 1 else 0) + (if p.size.Y > 300 then 1 else 0) + (if p.size.Z > 300 then 1 else 0) >= 2
			local ground = m.rm == "SmoothPlastic" and p.kind == 0 and (m.det ~= nil or (big and not m.tex))
			if ground then
				q.Material = MapScene.groundMaterial(theme, base, m.det == nil)
			elseif not hd and not m.tex and not m.a and m.rm == "SmoothPlastic" then
				-- bloc uni : béton ou bois d'après sa couleur, si assez grand pour que le grain se voie
				local s2 = math.max(size.X, size.Y, size.Z) + math.min(size.X, size.Y, size.Z)
				local g = if s2 > 2.5 * U then MapScene.guessMaterial(col) else nil
				if g then q.Material = g; hd = g end
			end
			if hd and not ground then col = MapScene.vary(col, seeds[i]) end
			q.Color = col
			if m.refl then q.Reflectance = m.refl end
			local tr = m.a or 0
			if m.cut and p.kind == 0 and not hd then tr = 1 end   -- texture découpée : seule la texture (client) se voit
			q.Transparency = tr
			q.CastShadow = bit32.band(p.flags, 2) ~= 0 and tr < 0.5
			local cf = CFrame.new(origin + p.pos * U) * p.rot
			if p.kind == 2 then                                -- cylindre : axe Y du web -> axe X de Roblox
				q.Shape = Enum.PartType.Cylinder
				q.Size = Vector3.new(math.min(size.X, MAXP), math.min(size.Y, MAXP), math.min(size.Z, MAXP))
				q.CFrame = cf * CFrame.Angles(0, 0, math.pi / 2)
				local cap = p.mats[2]
				if cap > 0 and cap ~= mi then q:SetAttribute("Cap", cap) end
			elseif p.kind == 1 then
				local d = size
				if math.abs(d.X - d.Y) < 0.02 * d.X and math.abs(d.X - d.Z) < 0.02 * d.X then
					q.Shape = Enum.PartType.Ball
					q.Size = Vector3.new(d.X, d.X, d.X)
				else
					q.Size = d
					local sm = Instance.new("SpecialMesh"); sm.MeshType = Enum.MeshType.Sphere; sm.Parent = q
				end
				q.CFrame = cf
			else
				q.Size = Vector3.new(math.clamp(size.X, 0.02, MAXP), math.clamp(size.Y, 0.02, MAXP), math.clamp(size.Z, 0.02, MAXP))
				-- grand sol extérieur (plan de 600 m, 2 cm sous le sol de jeu sur le web ; mer en métal du port et du labo) :
				-- descendu de 8 cm, sinon il perce le sol de jeu au loin
				if big and not m.tex and m.det == nil then cf = cf - Vector3.new(0, 0.3, 0) end
				q.CFrame = cf
				table.insert(items, { part = q :: BasePart, prim = p })
			end
			q:SetAttribute("P", i)                             -- numéro de la primitive : le client y pose les textures du web
			q.Parent = vis
			count += 1
		end
	end
	separateFaces(items)
	vis.Parent = folder
	-- vraies lampes du web
	if #info.lights > 0 then
		local lf = Instance.new("Folder"); lf.Name = "Lights"
		-- ombres pour les 4 lampes les plus fortes seulement : chaque lumière à ombres coûte cher en éclairage Future
		-- (jusqu'à 10 lampes dans le métro, plus les projecteurs et lampes de MapExtras côté client)
		local order = {}
		for k in ipairs(info.lights) do table.insert(order, k) end
		table.sort(order, function(x: number, y: number) return info.lights[x].i > info.lights[y].i end)
		local shadowed: { [number]: boolean } = {}
		for r = 1, math.min(4, #order) do shadowed[order[r]] = true end
		for li, L in ipairs(info.lights) do
			local a = Instance.new("Part"); a.Name = "Lamp"; a.Anchored = true; a.CanCollide = false; a.CanQuery = false; a.CanTouch = false
			a.Transparency = 1; a.Size = Vector3.new(0.2, 0.2, 0.2); a.CastShadow = false
			a.Position = origin + Vector3.new(L.p[1], L.p[2], L.p[3]) * U
			local pl = Instance.new("PointLight")
			pl.Color = MapScene.color(L.c); pl.Range = math.clamp((if L.d > 0 then L.d else 20) * U * 0.6, 8, 60)
			pl.Brightness = math.clamp(L.i / 9, 0.4, 3); pl.Shadows = shadowed[li] == true    -- ombres des lampes (éclairage Future)
			pl.Parent = a; a.Parent = lf
		end
		lf.Parent = folder
	end
	return count
end

-- ancien rendu en blocs colorés (carte sans décor exporté) : visible directement sur la collision
local function fallbackVisuals(folder: Folder, g: any)
	local col = folder:FindFirstChild("Collision")
	if not col then return end
	for _, p in ipairs(col:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "Border" and p.Name ~= "Ceiling" then
			p.Transparency = 0
			p.Color = if p.Name == "Floor" then Color3.fromRGB(201, 177, 138) else (FALLBACK[p:GetAttribute("CellType") :: number] or Color3.fromRGB(200, 200, 200))
			p.Material = Enum.Material.Sandstone
		end
	end
end

-- ---------- API ----------
function MapBuilder.list(): { { id: string, name: string, desc: string, theme: string } }
	local out = {}
	for _, id in ipairs(MapData.ORDER) do
		local m = MapData[id]
		table.insert(out, { id = id, name = m.name, desc = m.desc or "", theme = m.theme })
	end
	return out
end

function MapBuilder.destroy(map: MapObj?)
	if map and map.folder then map.folder:Destroy() end
end

function MapBuilder.build(mapId: string, origin: Vector3?, name: string?): MapObj
	if not MapData[mapId] then mapId = MapData.ORDER[1] end
	local o = origin or Vector3.zero
	local fname = name or "Map"
	local g = MapData.buildGrid(mapId)
	local m = g.map

	local old = workspace:FindFirstChild(fname); if old then old:Destroy() end
	local folder = Instance.new("Folder"); folder.Name = fname
	folder:SetAttribute("MapId", mapId)
	folder:SetAttribute("Origin", o)
	folder:SetAttribute("Theme", m.theme)
	folder:SetAttribute("MapSize", MapData.N * CELL)

	buildCollision(folder, g, o)
	local n = buildVisuals(folder, mapId, o)
	if n == 0 then fallbackVisuals(folder, g) end
	folder:SetAttribute("NVis", n)                      -- le client attend d'avoir reçu tout le décor avant d'y poser les textures
	folder.Parent = workspace                          -- un seul envoi aux clients, carte complète

	local function toCell(pos: Vector3): (number, number)
		local l = pos - o
		return math.floor(l.X / CELL), math.floor(l.Z / CELL)
	end
	local function groundAt(pos: Vector3): number     -- hauteur du sol (studs, monde) sous une position
		local l = pos - o
		return o.Y + groundH(g, l.X / U, l.Z / U) * U
	end
	local function cellToWorld(cx: number, cz: number): Vector3   -- centre d'une case, au niveau du sol
		local x, z = (cx + 0.5) * S, (cz + 0.5) * S
		return o + Vector3.new(x * U, math.min(groundH(g, x, z), 20) * U, z * U)
	end
	local function spawnAt(c: { number }): Vector3 return cellToWorld(c[1], c[2]) + Vector3.new(0, 3, 0) end
	local spawns = { T = {}, CT = {}, DM = {} }
	for _, c in ipairs(m.spawnT or {}) do table.insert(spawns.T, spawnAt(c)) end
	for _, c in ipairs(m.spawnCT or {}) do table.insert(spawns.CT, spawnAt(c)) end
	for _, c in ipairs(m.spawnDM or {}) do table.insert(spawns.DM, spawnAt(c)) end
	if #spawns.DM == 0 then spawns.DM = table.clone(spawns.T) end
	local sites = {}
	for _, s in ipairs(m.sites or {}) do table.insert(sites, { name = s.n, pos = spawnAt({ s.cx, s.cz }), radius = s.r * U }) end
	return { id = mapId, folder = folder, origin = o, data = m, grid = g, spawns = spawns, sites = sites,
		cellToWorld = cellToWorld, groundAt = groundAt, toCell = toCell }
end

return MapBuilder
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="433">
      <Properties>
        <string name="Name">MapVote</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/MapVote (ModuleScript, appelé par MatchService pendant la pause entre deux parties)
-- Vote de la carte suivante, comme à la fin d'une partie de Call of Duty ou de Valorant :
-- trois cartes du mode (dont la carte jouée), un vote par joueur, la plus votée gagne (égalité : tirage au sort,
-- aucun vote : on reste sur la même carte).
--   « MapVote » (serveur -> joueurs de la partie) : { options = { { id, n, theme } }, votes = { n1, n2, n3 }, left = s, mine = i? }
--     ou { done = id } quand le vote se termine.
--   « MapVoteCast » (joueur -> serveur) : numéro de la carte (1 à 3). Le serveur vérifie que le joueur est dans la partie.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Modes = require(ReplicatedStorage.Shared.Modes)

local push = Instance.new("RemoteEvent"); push.Name = "MapVote"; push.Parent = ReplicatedStorage
local cast = Instance.new("RemoteEvent"); cast.Name = "MapVoteCast"; cast.Parent = ReplicatedStorage

type Vote = { m: any, options: { string }, ballots: { [Player]: number }, endsAt: number }
local votes: { [any]: Vote } = {}          -- par partie
local byPlayer: { [Player]: Vote } = {}

local MapVote = {}

local function counts(v: Vote): { number }
	local c = table.create(#v.options, 0)
	for _, i in pairs(v.ballots) do c[i] += 1 end
	return c
end

local function send(v: Vote, only: Player?)
	local opts = {}
	for _, id in ipairs(v.options) do
		local def = Modes.MAP[id]
		table.insert(opts, { id = id, n = def and def.n or id, theme = def and def.theme or "" })
	end
	local c, left = counts(v), math.max(0, math.ceil(v.endsAt - os.clock()))
	for p in pairs(v.m.players) do
		if not only or only == p then push:FireClient(p, { options = opts, votes = c, left = left, mine = v.ballots[p] }) end
	end
end

-- ouvre le vote ; « seconds » = durée de la pause. Rien si le mode n'a qu'une carte (Zombies, Entraînement).
function MapVote.open(m: any, seconds: number)
	local pool = Modes.mapsFor(m.mode)
	if #pool < 2 or seconds < 4 then return end
	local cur = m.settings.map
	local others = {}
	for _, id in ipairs(pool) do if id ~= cur then table.insert(others, id) end end
	local options = { cur }
	while #options < 3 and #others > 0 do table.insert(options, table.remove(others, math.random(#others)) :: string) end
	local v: Vote = { m = m, options = options, ballots = {}, endsAt = os.clock() + seconds - 1.5 }
	votes[m] = v
	for p in pairs(m.players) do byPlayer[p] = v end
	send(v)
end

-- ferme le vote et règle la carte de la partie suivante
function MapVote.close(m: any)
	local v = votes[m]
	if not v then return end
	votes[m] = nil
	local c = counts(v)
	local best, list = 0, {}
	for i, n in ipairs(c) do
		if n > best then best, list = n, { i } elseif n == best and n > 0 then table.insert(list, i) end
	end
	local id = if #list > 0 then v.options[list[math.random(#list)]] else m.settings.map
	m.settings.map = id
	for p in pairs(m.players) do
		if byPlayer[p] == v then byPlayer[p] = nil end
		push:FireClient(p, { done = id, n = Modes.MAP[id] and Modes.MAP[id].n or id })
	end
end

cast.OnServerEvent:Connect(function(p: Player, i: any)
	local v = byPlayer[p]
	if not v or votes[v.m] ~= v or not v.m.players[p] then return end
	if typeof(i) ~= "number" or i ~= math.floor(i) or not v.options[i] or os.clock() > v.endsAt then return end
	v.ballots[p] = i
	send(v)
end)

game:GetService("Players").PlayerRemoving:Connect(function(p: Player)
	local v = byPlayer[p]
	if v then v.ballots[p] = nil end
	byPlayer[p] = nil
end)

return MapVote
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="434">
      <Properties>
        <string name="Name">MatchService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/MatchService (ModuleScript, lancé par Main)
-- Toutes les parties du jeu web, plusieurs en même temps sur un même serveur : chaque joueur choisit son mode, sa carte,
-- le niveau des bots et la taille des équipes dans le menu (écran « Jouer » du web), et sa partie est construite à part,
-- à côté des autres (une carte par partie, ses bots, ses scores). Les autres joueurs peuvent la rejoindre depuis la liste
-- des parties en cours ou par « Partie rapide ».
--
-- Le moteur gère ce qui est commun à tous les modes (équipes ou chacun pour soi, apparition loin des ennemis, protection,
-- objets à ramasser, éliminations, assistances, séries, kill-cam, tableau Tab, chrono, fin de partie et récompenses) ;
-- chaque mode (ServerScriptService/Modes/<id>) n'ajoute que ses règles. Interface d'un mode (tout est facultatif) :
--   setup(m)                  carte construite, avant les apparitions          start(m)        la partie commence
--   loadout(m, c) -> {clés}   armes d'un combattant à l'apparition             onSpawn(m, c, char)
--   onKill(m, killer, victim, key, headshot, ks, vs) -> boolean?   true = le mode compte lui-même les points
--   tick(m, dt)               10 fois par seconde pendant la partie            checkEnd(m) -> (fini, gagnant)
--   timeUp(m) -> gagnant      fin du chrono                                    canRespawn(m, c) -> boolean
--   respawnDelay(m, c)        teamFor(m, c) -> équipe à l'arrivée              info(m) -> { line, sub, color }
--   botGoal(m, bot) -> Vector3?   où envoyer un bot (zone, drapeau…)          spawnPoint(m, c) -> Vector3?
--   cleanup(m)                fin de partie
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local Modes = require(ReplicatedStorage.Shared.Modes)
local ShopCatalog = require(ReplicatedStorage.Shared.ShopCatalog)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local ProgressService = require(script.Parent.ProgressService)
local MapBuilder = require(script.Parent.MapBuilder)
local WeaponService = require(script.Parent.WeaponService)
local BotService = require(script.Parent.BotService)
local NetService = require(script.Parent.NetService)
local PartyService = require(script.Parent.PartyService)
local MapVote = require(script.Parent.MapVote)
local ArrivalService = require(script.Parent.ArrivalService)
local RateLimit = require(script.Parent.RateLimit)

local TDM = ModeConfig.TDM
local U = Config.STUDS_PER_METER
local CELL = Config.CELL * U
local TEAMS = { "Attaquants", "Défenseurs" }      -- T (orange) et CT (bleu), comme le web
local MAX_MATCHES = 6                             -- parties en même temps sur un serveur
local SLOT_ORIGIN = Vector3.new(0, 0, 5000)       -- loin du lobby (0, 0, -700) et des arènes de duel (2000, 0, 2000)
local SLOT_SPACING = 1200                         -- une carte du web fait 40 cases de 2 m ≈ 290 studs
local KILLCAM_MAX = 9                             -- la réapparition n'attend jamais plus longtemps la kill-cam
local WARMUP = 4                                  -- « PRÉPAREZ-VOUS… » avant le début
local INTERMISSION = TDM.intermission

local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local function remoteFunction(name: string): RemoteFunction
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local stateEvent = remoteEvent("TDMState")      -- serveur -> joueurs de la partie : score, temps, tableau, ligne du mode
local feedEvent = remoteEvent("KillFeed")       -- serveur -> joueurs de la partie : une élimination
local bannerEvent = remoteEvent("KillBanner")   -- serveur -> tueur : « +100 Élimination », séries
local deathEvent = remoteEvent("DeathInfo")     -- serveur -> victime : par qui, réapparition dans…
local endEvent = remoteEvent("MatchEnd")        -- serveur -> chaque joueur : victoire/défaite + récompenses
local announceEvent = remoteEvent("MatchAnnounce") -- serveur -> joueurs de la partie : grande bannière (« NOUVELLE ARME », « TU ES LE MASTODONTE »…)
local killcamEvent = remoteEvent("KillcamHold") -- victime -> serveur : kill-cam en cours (true) / finie ou passée (false)
local pickupToast = remoteEvent("PickupToast")  -- serveur -> joueur : objet ramassé
local createFn = remoteFunction("MatchCreate")  -- client -> serveur : lancer une partie avec ses réglages (et son groupe)
local quickFn = remoteFunction("MatchQuick")    -- client -> serveur : partie rapide
local joinFn = remoteFunction("MatchJoin")      -- client -> serveur : rejoindre une partie de la liste
local leaveFn = remoteFunction("MatchLeave")    -- client -> serveur : retour au lobby
local listFn = remoteFunction("MatchList")      -- client -> serveur : parties en cours (menu)
local loadoutFn = remoteFunction("SetLoadout")  -- client -> serveur : arme principale / pistolet du profil

local MatchService = {}

-- ==========================================================================================
-- Types
-- ==========================================================================================
export type Stat = {
	key: any, name: string, team: string, bot: boolean, player: Player?, model: Model?, k: number, d: number, a: number, hs: number,
	dmg: number, shots: number, hits: number, streak: number, bestStreak: number, score: number, pts: number, weaponKills: { [string]: number },
}
export type Match = {
	id: number, slot: number, settings: Modes.Settings, def: Modes.ModeDef, mode: string, mod: any,
	map: any, origin: Vector3, folderName: string, roam: { Vector3 },
	state: string, teams: { string }?, score: { [string]: number }, limit: number?, endsAt: number, startedAt: number, timed: boolean,
	players: { [Player]: boolean }, stats: { [any]: Stat }, dmgBy: { [any]: { [any]: number } }, kcHold: { [Player]: boolean },
	host: Player?, data: { [string]: any }, botCount: { [string]: number }, closed: boolean, pickups: { Model },
}

local matches: { [number]: Match } = {}
local nextId = 1
local matchOfPlayer: { [Player]: Match } = {}

local modeCache: { [string]: any } = {}
local function modeModule(id: string): any
	if modeCache[id] ~= nil then return modeCache[id] end
	local folder = script.Parent:FindFirstChild("Modes")
	local ms = folder and folder:FindFirstChild(id)
	local mod = {}
	if ms and ms:IsA("ModuleScript") then
		local ok, res = pcall(require, ms)
		if ok and typeof(res) == "table" then mod = res else warn("[MatchService] mode", id, res) end
	end
	modeCache[id] = mod
	return mod
end

-- ==========================================================================================
-- Combattants
-- ==========================================================================================
local function isBot(c: any): boolean return typeof(c) == "Instance" and c:IsA("Model") end
local function keyOf(c: any): any
	if isBot(c) then return "bot:" .. c.Name end
	return c
end
function MatchService.keyOf(c: any): any return keyOf(c) end

function MatchService.matchOf(c: any): Match?
	if typeof(c) ~= "Instance" then return nil end
	if c:IsA("Player") then return matchOfPlayer[c] end
	local id = c:GetAttribute("MatchId")
	return if typeof(id) == "number" then matches[id] else nil
end
function MatchService.get(id: number): Match? return matches[id] end

-- Tous les combattants (joueurs + bots) d'une partie
function MatchService.combatants(m: Match): { any }
	local list = {}
	for p in pairs(m.players) do table.insert(list, p) end
	for _, b in ipairs(BotService.ofMatch(m.id)) do table.insert(list, b) end
	return list
end
local function aliveChar(c: any): Model?
	local ch = WeaponService.charOf(c)
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	return if ch and h and h.Health > 0 then ch else nil
end
MatchService.aliveChar = aliveChar

function MatchService.statOf(m: Match, c: any): Stat?
	local k = keyOf(c)
	local s = m.stats[k]
	if not s then
		local team = WeaponService.teamOf(c)
		if not team then return nil end
		local bot = isBot(c)
		s = { key = k, name = WeaponService.nameOf(c), team = team, bot = bot, player = if bot then nil else c, model = if bot then c else nil,
			k = 0, d = 0, a = 0, hs = 0, dmg = 0, shots = 0, hits = 0, streak = 0, bestStreak = 0, score = 0, pts = 0, weaponKills = {} }
		m.stats[k] = s
	end
	return s
end
local statOf = MatchService.statOf

-- équipe « affichée » d'un combattant : T/CT en équipe, sa propre clé en chacun pour soi
local function soloTeam(c: any): string
	return "solo:" .. (if isBot(c) then c.Name else tostring((c :: Player).UserId))
end
function MatchService.setTeam(m: Match, c: any, team: string)
	if typeof(c) == "Instance" then c:SetAttribute("Team", team) end
	local s = m.stats[keyOf(c)]
	if s then s.team = team end
end

function MatchService.cellToWorld(m: Match, cx: number, cz: number): Vector3
	-- hauteur du sol comprise (MapBuilder) ; repli : sol plat
	if m.map and m.map.cellToWorld then return m.map.cellToWorld(cx, cz) end
	return m.origin + Vector3.new((cx + 0.5) * CELL, 0, (cz + 0.5) * CELL)
end

-- ==========================================================================================
-- Messages aux joueurs d'une partie
-- ==========================================================================================
local function fireMatch(m: Match, ev: RemoteEvent, ...: any)
	for p in pairs(m.players) do if p.Parent then ev:FireClient(p, ...) end end
end
MatchService.fire = fireMatch
function MatchService.announce(m: Match, title: string, sub: string?, color: Color3?, to: Player?)
	if to then announceEvent:FireClient(to, title, sub, color) else fireMatch(m, announceEvent, title, sub, color) end
end

-- ==========================================================================================
-- Apparition
-- ==========================================================================================
local function enemyPositions(m: Match, team: string): { Vector3 }
	local list = {}
	for _, c in ipairs(MatchService.combatants(m)) do
		local ch = aliveChar(c)
		local r = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r and WeaponService.teamOf(c) ~= team then table.insert(list, r.Position) end
	end
	return list
end

-- point le plus éloigné des ennemis parmi ceux de l'équipe (et ceux du chacun pour soi une fois la partie lancée), comme spawnFor du web
function MatchService.spawnPoint(m: Match, c: any): Vector3
	if m.mod.spawnPoint then
		local p = m.mod.spawnPoint(m, c)
		if p then return p end
	end
	local team = WeaponService.teamOf(c) or ""
	local candidates = {}
	if m.teams and (team == TEAMS[1] or team == TEAMS[2]) then
		for _, p in ipairs(if team == TEAMS[1] then m.map.spawns.T else m.map.spawns.CT) do table.insert(candidates, p) end
		if m.state == "live" then for _, p in ipairs(m.map.spawns.DM) do table.insert(candidates, p) end end
	else
		for _, p in ipairs(m.map.spawns.DM) do table.insert(candidates, p) end
	end
	if #candidates == 0 then candidates = table.clone(m.roam) end
	local enemies = enemyPositions(m, team)
	local best, bestScore = candidates[math.random(#candidates)], -1
	for _ = 1, 8 do
		local cand = candidates[math.random(#candidates)]
		local minD = math.huge
		for _, e in ipairs(enemies) do minD = math.min(minD, (e - cand).Magnitude) end
		if minD > bestScore then best, bestScore = cand, minD end
	end
	return best
end

-- ---------- modificateurs de partie (web : src/8Y_mutators.js) ----------
local popEvent = ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
if not popEvent then
	local e = Instance.new("RemoteEvent"); e.Name = "ModePop"; e.Parent = ReplicatedStorage; popEvent = e
end
local function mutOn(m: Match, k: string): boolean return m.settings.mut[k] == true end
local LUNE = 0.5     -- part de la gravité gardée en gravité lunaire
local TURBO = 1.3
-- appliqué à chaque apparition : gravité lunaire (force vers le haut sur le corps) et turbo (attribut lu par le mouvement)
local function applyMut(m: Match, char: Model)
	if mutOn(m, "turbo") then
		char:SetAttribute("SpeedMult", TURBO)
		local h = char:FindFirstChildOfClass("Humanoid")
		if h and isBot(char) then h.WalkSpeed *= TURBO end   -- le joueur, lui, applique le multiplicateur dans son mouvement
	end
	if mutOn(m, "lune") then
		char:SetAttribute("MutLune", true)
		local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root and not root:FindFirstChild("MutLune") then
			local att = Instance.new("Attachment"); att.Name = "MutLuneAtt"; att.Parent = root
			local vf = Instance.new("VectorForce"); vf.Name = "MutLune"; vf.Attachment0 = att
			vf.RelativeTo = Enum.ActuatorRelativeTo.World; vf.ApplyAtCenterOfMass = true
			vf.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * (1 - LUNE), 0)
			vf.Parent = root
			-- la masse change quand l'arme et les accessoires arrivent : on recalcule un peu plus tard
			task.delay(0.5, function() if vf.Parent then vf.Force = Vector3.new(0, root.AssemblyMass * workspace.Gravity * (1 - LUNE), 0) end end)
		end
	end
end
-- grenades et mines bloquées pendant « PRÉPAREZ-VOUS » et le début de manche (comme le web)
;(WeaponService :: any).throwBlocked = function(c: any): boolean
	local m = MatchService.matchOf(c)
	return m ~= nil and (m.state ~= "live" or (m.data :: any).phase == "freeze")
end
-- têtes seulement / une balle : filtre des dégâts de WeaponService (pas sur le couteau ni les grenades)
local NADES = { frag = true, flash = true, smoke = true, molotov = true, mine = true }
;(WeaponService :: any).damageFilter = function(attacker: any, victimChar: Model, raw: number, headshot: boolean, key: string): number?
	local m = MatchService.matchOf(attacker)
	if not m or m.state ~= "live" or MatchService.matchOf(victimChar) ~= m then return raw end
	local w = Config.WEAPONS[key]
	if (w and w.melee) or NADES[key] then return raw end
	if mutOn(m, "tetes") and not headshot then
		if typeof(attacker) == "Instance" and attacker:IsA("Player") and popEvent then popEvent:FireClient(attacker, "🎯 À LA TÊTE SEULEMENT", Color3.fromRGB(150, 200, 255), "shield") end
		return nil
	end
	if mutOn(m, "balle") then return 9999 end
	return raw
end

local function protect(char: Model)
	char:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + TDM.spawnProtection)
	local h = Instance.new("Highlight"); h.Name = "SpawnShield"; h.FillColor = Color3.fromRGB(255, 255, 255)
	h.FillTransparency = 0.75; h.OutlineColor = Color3.fromRGB(140, 220, 255); h.Parent = char
	task.delay(TDM.spawnProtection, function() if h.Parent then h:Destroy() end end)
	char:GetAttributeChangedSignal("ProtectedUntil"):Connect(function()
		if (char:GetAttribute("ProtectedUntil") :: number? or 0) <= 0 and h.Parent then h:Destroy() end
	end)
end

local BOT_PRIMARIES = ModeConfig.BOT.primaries
function MatchService.defaultLoadout(m: Match, c: any): { string }
	local team = WeaponService.teamOf(c)
	local base = TDM.loadout[team or ""] or TDM.loadout.Attaquants
	if isBot(c) then
		return { BOT_PRIMARIES[math.random(#BOT_PRIMARIES)], base.secondary, "knife" }
	end
	local chosen, secondary = c:GetAttribute("Primary"), c:GetAttribute("Secondary")
	return { if typeof(chosen) == "string" then chosen else base.primary, if typeof(secondary) == "string" then secondary else base.secondary, "knife" }
end

local function loadoutOf(m: Match, c: any): { string }
	if m.mod.loadout then
		local l = m.mod.loadout(m, c)
		if l then return l end
	end
	return MatchService.defaultLoadout(m, c)
end

local function respawnDelay(m: Match, c: any): number
	if m.mod.respawnDelay then return m.mod.respawnDelay(m, c) end
	return m.def.respawn or TDM.respawnDelay
end
local function canRespawn(m: Match, c: any): boolean
	if m.mod.canRespawn then return m.mod.canRespawn(m, c) end
	return (m.def.respawn or 0) > 0
end

local spawnPlayer: (Match, Player) -> ()
spawnPlayer = function(m: Match, p: Player)
	if not p.Parent or matchOfPlayer[p] ~= m or m.closed then return end
	p:LoadCharacter()
	local char = p.Character or p.CharacterAdded:Wait()
	char:SetAttribute("MatchId", m.id)
	char:PivotTo(CFrame.new(MatchService.spawnPoint(m, p) + Vector3.new(0, 1, 0)))
	protect(char)
	WeaponService.giveLoadout(p, loadoutOf(m, p))
	statOf(m, p)
	applyMut(m, char)
	if m.mod.onSpawn then m.mod.onSpawn(m, p, char) end
	if m.state ~= "live" then
		local h = char:FindFirstChildOfClass("Humanoid"); if h and m.state == "warmup" then h.WalkSpeed = 0 end
	end
	local hum = char:WaitForChild("Humanoid") :: Humanoid
	hum.Died:Connect(function()
		WeaponService.reset(p)
		if m.state ~= "live" or not canRespawn(m, p) then return end
		local delay = respawnDelay(m, p)
		task.delay(delay, function()
			-- la réapparition attend la fin de la kill-cam (comme sur le web), sans jamais dépasser KILLCAM_MAX
			local deadline = os.clock() + KILLCAM_MAX - delay
			while m.kcHold[p] and os.clock() < deadline do task.wait(0.1) end
			m.kcHold[p] = nil
			if m.state == "live" and p.Parent and p.Character == char and matchOfPlayer[p] == m and canRespawn(m, p) then spawnPlayer(m, p) end
		end)
	end)
end
function MatchService.respawn(m: Match, c: any)
	if isBot(c) then return end
	task.spawn(spawnPlayer, m, c)
end

local BOT_NO_NADES = { inf = true, zombies = true, br = true, train = true }   -- Infecté (couteau), Zombies, BR, Entraînement
local liveBots: (Match, string?) -> { Model }
local spawnBot: (Match, string, string?) -> Model
spawnBot = function(m: Match, team: string, name: string?): Model
	local model = BotService.spawn(if m.teams then team else "Attaquants", Vector3.zero, m.roam, name, {
		match = m.id, diff = Modes.DIFFS[m.settings.diff], loadout = { "knife" },
		goal = function(b: Model): Vector3? return if m.mod.botGoal then m.mod.botGoal(m, b) else nil end,
		-- grenades et mines des bots dans les modes à mort (les modes à manches les gèrent eux-mêmes, Modes/rounds)
		nades = m.def.respawn ~= nil and not BOT_NO_NADES[m.mode],
	})
	model:SetAttribute("Team", if m.teams then team else soloTeam(model))
	model:SetAttribute("Look", if m.teams then team else "ffa")
	model:PivotTo(CFrame.new(MatchService.spawnPoint(m, model) + Vector3.new(0, 3, 0)))
	WeaponService.giveLoadout(model, loadoutOf(m, model))
	protect(model)
	statOf(m, model)
	applyMut(m, model)
	if m.mod.onSpawn then m.mod.onSpawn(m, model, model) end
	-- arrivé pendant « PRÉPAREZ-VOUS » (un joueur qui rejoint) : immobile comme les autres jusqu'au départ
	if m.state == "warmup" then BotService.freezeMatch(m.id, true) end
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	local botName = model.Name
	hum.Died:Connect(function()
		task.delay(2, function() if model.Parent then BotService.remove(model) end end)
		if not canRespawn(m, model) then return end
		task.delay(respawnDelay(m, model), function()
			if m.state ~= "live" or m.closed then return end
			local s = m.stats["bot:" .. botName]
			-- ne réapparaît que s'il a toujours sa place (un joueur a pu le remplacer entre-temps)
			if not s then return end
			local group = if m.teams then s.team else nil
			local keep = if m.mod.botRespawn then m.mod.botRespawn(m, s) else #liveBots(m, group) < (m.botCount[group or "solo"] or 0)
			if keep then spawnBot(m, s.team, botName) end
		end)
	end)
	return model
end

-- Ajuste les bots pour que chaque équipe ait sa taille (ou que le chacun pour soi ait son nombre de joueurs)
local function humansIn(m: Match, team: string?): number
	local n = 0
	for p in pairs(m.players) do
		if not team or WeaponService.teamOf(p) == team then n += 1 end
	end
	return n
end
liveBots = function(m: Match, team: string?): { Model }
	local l = {}
	for _, b in ipairs(BotService.ofMatch(m.id)) do
		local h = b:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 and (not team or b:GetAttribute("Team") == team) then table.insert(l, b) end
	end
	return l
end
function MatchService.balanceBots(m: Match)
	-- partie fermée : un départ juste avant la fermeture (task.delay de leave) ne doit pas recréer des bots sans carte
	if m.closed or (m.state ~= "live" and m.state ~= "warmup") then return end
	if m.mod.noBots then return end
	local groups: { { string? } } = if m.teams then { { m.teams[1] }, { m.teams[2] } } else { { nil } }
	for _, g in ipairs(groups) do
		local team = g[1]
		local want: number? = math.max(0, m.settings.size - humansIn(m, team))
		if m.mod.botsWanted then want = m.mod.botsWanted(m, team, want) end
		if want == nil then continue end           -- le mode gère lui-même ses bots
		m.botCount[team or "solo"] = want
		local mine = liveBots(m, if m.teams then team else nil)
		while #mine > (want :: number) do
			local b = table.remove(mine) :: Model
			m.stats["bot:" .. b.Name] = nil
			BotService.remove(b)
		end
		for _ = #mine + 1, want :: number do spawnBot(m, team or "solo") end
	end
end
function MatchService.spawnBot(m: Match, team: string, name: string?): Model return spawnBot(m, team, name) end

-- ==========================================================================================
-- Objets à ramasser (bouclier, santé, munitions), comme makePickup() du web
-- ==========================================================================================
local PICKUP_COLORS = { shield = Color3.fromRGB(49, 200, 255), health = Color3.fromRGB(255, 74, 90), ammo = Color3.fromRGB(255, 210, 74) }

local function pickupPart(name: string, size: Vector3, color: Color3, cf: CFrame, parent: Instance, transparency: number?): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.CastShadow = false; p.Size = size; p.Color = color; p.Material = Enum.Material.Neon; p.CFrame = cf
	p.Transparency = transparency or 0.08; p.Parent = parent
	return p
end

function MatchService.makePickup(m: Match, kind: string, pos: Vector3, temp: boolean)
	local col = PICKUP_COLORS[kind] or Color3.new(1, 1, 1)
	local model = Instance.new("Model"); model.Name = "Pickup_" .. kind
	model:SetAttribute("Pickup", kind)
	local corePos = pos + Vector3.new(0, 0.9 * U, 0)
	local core: Part
	if kind == "shield" then       -- octaèdre du web : un cube posé sur une pointe
		core = pickupPart("Core", Vector3.new(0.4, 0.4, 0.4) * U, col, CFrame.new(corePos) * CFrame.Angles(math.rad(45), 0, math.rad(35.26)), model)
	elseif kind == "health" then
		core = pickupPart("Core", Vector3.new(0.4, 0.4, 0.4) * U, col, CFrame.new(corePos), model)
		pickupPart("CrossA", Vector3.new(0.5, 0.12, 0.12) * U, Color3.new(1, 1, 1), CFrame.new(corePos), model, 0)
		pickupPart("CrossB", Vector3.new(0.12, 0.5, 0.12) * U, Color3.new(1, 1, 1), CFrame.new(corePos), model, 0)
	else
		core = pickupPart("Core", Vector3.new(0.5, 0.28, 0.32) * U, col, CFrame.new(corePos), model)
	end
	local light = Instance.new("PointLight"); light.Color = col; light.Range = 2.4 * U; light.Brightness = 1.6; light.Parent = core
	local ring = pickupPart("Ring", Vector3.new(0.04 * U, 1.3 * U, 1.3 * U), col, CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), model, 0.5)
	ring.Shape = Enum.PartType.Cylinder
	local zone = pickupPart("Zone", Vector3.new(2.6, 3, 2.6) * U, col, CFrame.new(pos + Vector3.new(0, 1.5 * U, 0)), model, 1)
	zone.CanTouch = true
	model.PrimaryPart = core
	model.Parent = m.map.folder
	if temp then
		table.insert(m.pickups, model)
		if #m.pickups > 6 then local old = table.remove(m.pickups, 1); if old and old.Parent then old:Destroy() end end
		task.delay(25, function() if model.Parent then model:Destroy() end end)
	end
	local ready = true
	local function setShown(on: boolean)
		for _, d in ipairs(model:GetDescendants()) do
			if d:IsA("BasePart") and d.Name ~= "Zone" then d.Transparency = if on then (if d.Name == "Ring" then 0.5 elseif d.Name:sub(1, 5) == "Cross" then 0 else 0.08) else 1 end
		end
		light.Enabled = on
		model:SetAttribute("Ready", on)
	end
	model:SetAttribute("Ready", true)
	zone.Touched:Connect(function(hit)
		if not ready or m.state ~= "live" then return end
		local mm = hit:FindFirstAncestorOfClass("Model")
		local hum = mm and mm:FindFirstChildOfClass("Humanoid")
		if not mm or not hum or hum.Health <= 0 then return end
		local c = WeaponService.combatantOf(mm)
		if MatchService.matchOf(c) ~= m then return end
		if kind == "health" then
			if hum.Health >= hum.MaxHealth then return end
			hum.Health = math.min(hum.MaxHealth, hum.Health + 35)
		elseif kind == "shield" then
			if WeaponService.shieldOf(c) >= Config.SHIELD_MAX then return end
			WeaponService.addShield(c, 25)
		else
			WeaponService.resupply(c)
		end
		local pl = Players:GetPlayerFromCharacter(mm)
		if pl then pickupToast:FireClient(pl, kind) end
		if temp then model:Destroy(); return end
		ready = false; setShown(false)
		task.delay(20, function() if model.Parent then ready = true; setShown(true) end end)
	end)
end

-- bouclier lâché par un soldat éliminé (web : s'il en avait encore, ou 18 % du temps)
local function dropShield(m: Match, victim: any)
	if m.mod.noPickups then return end
	local char = WeaponService.charOf(victim)
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	if WeaponService.shieldOf(victim) > 0 or math.random() < 0.18 then
		local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = { (char :: any) :: Instance }
		local hit = workspace:Raycast(root.Position, Vector3.new(0, -20, 0), rp)
		MatchService.makePickup(m, "shield", if hit then hit.Position else root.Position - Vector3.new(0, 3, 0), true)
	end
end

-- ==========================================================================================
-- Éliminations, dégâts, tirs
-- ==========================================================================================
function MatchService.weaponName(key: string): string
	if key == "frag" then return "Grenade" end
	if key == "bomb" then return "Bombe" end
	local w = Config.WEAPONS[key]
	return w and w.name or key
end

WeaponService.Damaged:Connect(function(attacker, victim, amount: number, _headshot: boolean)
	local m = MatchService.matchOf(attacker)
	if not m or m.state ~= "live" or MatchService.matchOf(victim) ~= m then return end
	local s = statOf(m, attacker)
	if s then s.dmg += amount; s.hits += 1 end
	local vk, ak = keyOf(victim), keyOf(attacker)
	local by = m.dmgBy[vk] or {}; m.dmgBy[vk] = by
	by[ak] = (by[ak] or 0) + amount
end)

WeaponService.ShotFired:Connect(function(shooter, _key: string)
	local m = MatchService.matchOf(shooter)
	if not m or m.state ~= "live" then return end
	local s = statOf(m, shooter)
	if s then s.shots += 1 end
end)

-- points d'une élimination (+25 à la tête), comme le web
local KILL_POINTS = TDM.scorePerKill
WeaponService.Killed:Connect(function(killer, victim, key: string, headshot: boolean)
	local m = MatchService.matchOf(victim)
	if not m or m.state ~= "live" then return end
	local vs = statOf(m, victim)
	if not vs then return end
	local ks = if MatchService.matchOf(killer) == m then statOf(m, killer) else nil
	dropShield(m, victim)
	vs.d += 1; vs.streak = 0
	local selfKill = ks == nil or ks == vs
	if ks and not selfKill then
		ks.k += 1; ks.streak += 1; ks.bestStreak = math.max(ks.bestStreak, ks.streak)
		ks.score += KILL_POINTS + (if headshot then 25 else 0)
		if headshot then ks.hs += 1 end
		ks.weaponKills[key] = (ks.weaponKills[key] or 0) + 1
	end
	-- le mode compte ses points lui-même (plaques, Mastodonte, Course aux armes…) ; sinon : 1 point par élimination
	local handled = m.mod.onKill and m.mod.onKill(m, killer, victim, key, headshot, ks, vs)
	if not handled and ks and not selfKill then
		local scoreKey = if m.teams then ks.team else ks.key
		m.score[scoreKey] = (m.score[scoreKey] or 0) + 1
	end
	-- assistances : au moins 30 dégâts sur la victime pendant cette vie
	local vk, kk = keyOf(victim), keyOf(killer)
	for ak, amount in pairs(m.dmgBy[vk] or {}) do
		local as = m.stats[ak]
		if ak ~= kk and as and amount >= 30 then as.a += 1; as.score += TDM.scorePerAssist end
	end
	m.dmgBy[vk] = nil
	-- vampire : chaque élimination rend 50 PV au tueur
	if mutOn(m, "vamp") and ks and not selfKill and ks.team ~= vs.team then
		local kc = aliveChar(killer)
		local h = kc and kc:FindFirstChildOfClass("Humanoid")
		if h then
			h.Health = math.min(math.max(100, h.MaxHealth), h.Health + 50)
			if typeof(killer) == "Instance" and killer:IsA("Player") and popEvent then popEvent:FireClient(killer, "🦇 +50 PV", Color3.fromRGB(255, 70, 80), "heal") end
		end
	end

	local kName = if ks then ks.name else vs.name
	fireMatch(m, feedEvent, { killer = kName, killerTeam = if ks then ks.team else vs.team, victim = vs.name, victimTeam = vs.team,
		weapon = MatchService.weaponName(key), key = key, headshot = headshot })
	local kp = ks and ks.player
	if kp and not selfKill and ks then
		bannerEvent:FireClient(kp, { victim = vs.name, headshot = headshot, points = KILL_POINTS + (if headshot then 25 else 0), streak = ks.streak, streakName = TDM.streaks[ks.streak] })
		RewardService.missionEvent(kp, "kills")
		if headshot then RewardService.missionEvent(kp, "hs") end
		if key == "knife" then RewardService.missionEvent(kp, "knife") end
	end
	local vp = vs.player
	if vp then
		deathEvent:FireClient(vp, { killer = kName, weapon = MatchService.weaponName(key), headshot = headshot,
			respawn = if canRespawn(m, vp) then respawnDelay(m, vp) else nil, killerChar = if ks then WeaponService.charOf(killer) else nil,
			victimName = vs.name, key = key, killcam = ks ~= nil and not selfKill })
	end
end)

killcamEvent.OnServerEvent:Connect(function(p: Player, on: any)
	local m = matchOfPlayer[p]
	if m then m.kcHold[p] = if on == true then true else nil end
end)

-- ==========================================================================================
-- État de la partie (score, temps, tableau Tab, ligne du mode) envoyé aux joueurs de la partie
-- ==========================================================================================
local function board(m: Match)
	local list = {}
	for _, s in pairs(m.stats) do
		table.insert(list, { name = s.name, team = s.team, bot = s.bot, k = s.k, d = s.d, a = s.a, score = s.score, pts = if m.teams then s.pts else (m.score[s.key] or s.pts),
			userId = s.player and s.player.UserId or 0, ping = if s.player then math.floor(NetService.pingOf(s.player) * 1000) else 0 })
	end
	table.sort(list, function(x, y) return x.score > y.score end)
	return list
end
MatchService.board = board

local function broadcast(m: Match)
	-- la ligne du mode n'existe qu'une fois la partie lancée (les modes préparent leurs données dans start)
	local info = nil
	if m.mod.info and m.state ~= "warmup" and m.state ~= "loading" then
		local ok, r = pcall(m.mod.info, m)
		if ok then info = r else warn("[MatchService] info", m.mode, r) end
	end
	-- modificateurs actifs ajoutés à la sous-ligne du mode, comme le web (« · 🌙 Gravité lunaire »)
	local muts = {}
	for _, mu in ipairs(Modes.MUTATORS) do if mutOn(m, mu.k) then table.insert(muts, mu.ic .. " " .. mu.n) end end
	if #muts > 0 then
		info = table.clone(info or {})
		info.sub = (if info.sub and info.sub ~= "" then info.sub .. "  ·  " else "") .. table.concat(muts, "  ")
	end
	local payload = {
		state = if m.state == "warmup" then "live" else m.state, warmup = m.state == "warmup", id = m.id, mode = m.mode, modeName = m.def.n,
		modeColor = m.def.c, team = m.teams ~= nil, score = if m.teams then m.score else {}, teams = m.teams or TEAMS, killsToWin = m.limit, limitLabel = m.def.limitLabel,
		timeLeft = if m.timed or m.state ~= "live" then math.max(0, math.floor(m.endsAt - os.clock())) else -1,
		mapName = m.map and m.map.data.name or "", mapId = m.settings.map, board = board(m), info = info, data = m.data.public,
	}
	fireMatch(m, stateEvent, payload)
end
MatchService.broadcast = broadcast

-- ==========================================================================================
-- Arrivées / départs
-- ==========================================================================================
local function teamCounts(m: Match): (number, number)
	local a, b = 0, 0
	for p in pairs(m.players) do
		local t = WeaponService.teamOf(p)
		if t == TEAMS[1] then a += 1 elseif t == TEAMS[2] then b += 1 end
	end
	return a, b
end

local function pickTeam(m: Match, p: Player, prefer: string?): string
	if m.mod.teamFor then
		local t = m.mod.teamFor(m, p)
		if t then return t end
	end
	if not m.teams then return soloTeam(p) end
	local a, b = teamCounts(m)
	if prefer == "t" and a < m.settings.size then return TEAMS[1] end
	if prefer == "ct" and b < m.settings.size then return TEAMS[2] end
	if a == b then return TEAMS[math.random(2)] end
	return if a < b then TEAMS[1] else TEAMS[2]
end

function MatchService.capacity(m: Match): number
	return if m.teams then m.settings.size * 2 else m.settings.size
end
local function humanCount(m: Match): number
	local n = 0; for _ in pairs(m.players) do n += 1 end; return n
end

local leaveLobby: ((Player) -> ())? = nil     -- branché par LobbyService (sortie du lobby)
local backToLobby: ((Player) -> ())? = nil
function MatchService.setLobbyHooks(onLeave: (Player) -> (), onBack: (Player) -> ())
	leaveLobby, backToLobby = onLeave, onBack
end

function MatchService.join(p: Player, m: Match, prefer: string?): boolean
	if m.closed or m.state == "over" or matchOfPlayer[p] == m then return false end
	if humanCount(m) >= MatchService.capacity(m) then return false end
	if matchOfPlayer[p] then MatchService.leave(p, true) end
	if leaveLobby then leaveLobby(p) end
	matchOfPlayer[p] = m
	m.players[p] = true
	p:SetAttribute("Zone", "match")
	p:SetAttribute("MatchId", m.id)
	p:SetAttribute("MatchMap", m.folderName)
	p:SetAttribute("MatchMode", m.mode)
	p.Team = nil
	p:SetAttribute("DuelTeam", nil)          -- une équipe de duel restée posée fausserait tir ami et équipes
	MatchService.setTeam(m, p, pickTeam(m, p, prefer))
	statOf(m, p)
	if m.state == "live" or m.state == "warmup" then
		MatchService.balanceBots(m)
		task.spawn(spawnPlayer, m, p)
	end
	broadcast(m)
	return true
end

function MatchService.leave(p: Player, silent: boolean?)
	local m = matchOfPlayer[p]
	if not m then return end
	matchOfPlayer[p] = nil
	m.players[p] = nil
	m.kcHold[p] = nil
	m.stats[p] = nil
	if m.mod.onLeave then pcall(m.mod.onLeave, m, p) end
	WeaponService.reset(p)
	for _, a in ipairs({ "MatchId", "MatchMap", "MatchMode", "Team" }) do p:SetAttribute(a, nil) end
	if p.Character then p.Character:SetAttribute("MatchId", nil) end
	if not silent and p.Parent then
		p:SetAttribute("Zone", "lobby")
		if backToLobby then task.spawn(backToLobby, p) end
	end
	task.delay(0.3, function() MatchService.balanceBots(m) end)
end

-- ==========================================================================================
-- Déroulement d'une partie
-- ==========================================================================================
local function freeSlot(): number?
	local used = {}
	for _, m in pairs(matches) do used[m.slot] = true end
	for i = 1, MAX_MATCHES do if not used[i] then return i end end
	return nil
end

-- fonctions appelées pour chaque joueur à la fin d'une partie : (m, joueur, stat, gagné, résumé MatchEnd modifiable)
MatchService.buildHooks = {} :: { (Match) -> () }   -- appelées après chaque construction de carte (HalloweenService.decorate)
MatchService.finishHooks = {} :: { (Match, Player, Stat?, boolean, { [string]: any }) -> () }
local function finish(m: Match, winner: any)
	m.state = "over"
	broadcast(m)
	local seconds = math.floor(os.clock() - m.startedAt)
	local finalBoard = board(m)
	local mvp = finalBoard[1]
	for p in pairs(m.players) do
		local s = m.stats[p]
		local won: boolean
		if typeof(winner) == "string" then won = WeaponService.teamOf(p) == winner
		else won = winner ~= nil and s ~= nil and winner == s end
		local rewards, progress = nil, nil
		if s then
			local okR, r = pcall(RewardService.finishMatch, p, { kills = s.k, deaths = s.d, hs = s.hs, dmg = s.dmg, shots = s.shots, hits = s.hits,
				plants = (s :: any).plants or 0, defuses = (s :: any).defuses or 0, won = won, seconds = seconds, mode = m.mode, map = m.settings.map,
				bestStreak = s.bestStreak, weaponKills = s.weaponKills })
			if okR then rewards = r end
			if rewards then
				-- classement (rankUpdate du web) : partie classée, mode classé, bots Facile ou plus (diff web = diff - 1), sans modificateur
				local ranked = m.settings.ranked == true and next(m.settings.mut) == nil
				local okP, pr = pcall(ProgressService.finishMatch, p, { xp = rewards.xp, won = won, mode = m.mode, kills = s.k, weaponKills = s.weaponKills,
					ranked = ranked, difficulty = m.settings.diff - 1 })
				if okP then progress = pr end
			end
		end
		local winnerName = if typeof(winner) == "string" then winner elseif typeof(winner) == "table" then (winner :: any).name else nil
		local payload = { won = won, draw = winner == nil, winner = winnerName, team = m.teams ~= nil, mode = m.mode, modeName = m.def.n,
			score = if m.teams then m.score else {}, rewards = rewards, progress = progress, mvp = mvp, board = finalBoard,
			me = s and { k = s.k, d = s.d, a = s.a, hs = s.hs, dmg = s.dmg, score = s.score, bestStreak = s.bestStreak, shots = s.shots, hits = s.hits } or nil, next = INTERMISSION }
		-- médailles, défis de la semaine… (MatchService.finishHooks) : complètent le résumé avant l'envoi
		for _, hook in ipairs(MatchService.finishHooks) do
			local okH, errH = pcall(hook, m, p, s, won, payload)
			if not okH then warn("[MatchService] fin de partie :", errH) end
		end
		endEvent:FireClient(p, payload)
	end
	BotService.freezeMatch(m.id, true)
	for p in pairs(m.players) do
		local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed = 0 end
	end
end

local function close(m: Match)
	m.closed = true
	if m.mod.cleanup then pcall(m.mod.cleanup, m) end
	for p in pairs(m.players) do MatchService.leave(p) end
	BotService.removeMatch(m.id)
	if m.map then
		pcall(WeaponService.clearGrenades, m.id)
		if MapBuilder.destroy then pcall(MapBuilder.destroy, m.map) elseif m.map.folder then m.map.folder:Destroy() end
	end
	matches[m.id] = nil
end

local function playOnce(m: Match)
	-- carte, points de passage des bots, objets
	if m.map then
		pcall(WeaponService.clearGrenades, m.id)
		if MapBuilder.destroy then pcall(MapBuilder.destroy, m.map) elseif m.map.folder then m.map.folder:Destroy() end
	end
	BotService.removeMatch(m.id)
	m.map = (MapBuilder.build :: any)(m.settings.map, m.origin, m.folderName)
	m.map.folder:SetAttribute("MatchId", m.id); m.map.folder:SetAttribute("Origin", m.origin)
	m.roam = {}
	for _, c in ipairs(m.map.data.roam or {}) do table.insert(m.roam, MatchService.cellToWorld(m, c[1], c[2]) + Vector3.new(0, 3, 0)) end
	if #m.roam == 0 then m.roam = table.clone(m.map.spawns.DM) end
	m.stats = {}; m.dmgBy = {}; m.pickups = {}; m.data = {}; m.botCount = {}
	m.score = {}
	if m.teams then for _, t in ipairs(m.teams) do m.score[t] = 0 end end
	m.limit = m.settings.limit
	m.timed = m.def.time ~= nil
	if not m.mod.noPickups then
		for _, pk in ipairs(m.map.data.pickups or {}) do MatchService.makePickup(m, pk[3], MatchService.cellToWorld(m, pk[1], pk[2]), false) end
	end
	pcall(ProgressService.spawnPumpkins, m.map.data, function(cx: number, cz: number) return MatchService.cellToWorld(m, cx, cz) end, m.map.folder)
	for _, hook in ipairs(MatchService.buildHooks) do   -- décor ajouté après la construction de la carte (HalloweenService)
		if not pcall(hook, m) then warn("[MatchService] décor de carte : erreur") end
	end
	if m.mod.setup then m.mod.setup(m) end

	-- équipes : on rebat les cartes à chaque partie, les groupes d'amis restent ensemble
	if m.teams then
		local list = {}
		for p in pairs(m.players) do table.insert(list, p) end
		local groups = PartyService.groupsOf(list)
		table.sort(groups, function(a, b) return #a > #b end)
		local counts = { 0, 0 }
		for _, g in ipairs(groups) do
			local i = if counts[1] <= counts[2] then 1 else 2
			for _, p in ipairs(g) do MatchService.setTeam(m, p, TEAMS[i]); counts[i] += 1 end
		end
		if m.host and m.players[m.host] and m.settings.side ~= "rnd" then
			MatchService.setTeam(m, m.host, if m.settings.side == "t" then TEAMS[1] else TEAMS[2])
		end
		if m.mod.teamFor then for p in pairs(m.players) do local t = m.mod.teamFor(m, p); if t then MatchService.setTeam(m, p, t) end end end
	else
		for p in pairs(m.players) do MatchService.setTeam(m, p, pickTeam(m, p)) end
	end

	-- « PRÉPAREZ-VOUS… » : tout le monde apparaît, puis la partie démarre
	m.state = "warmup"
	m.startedAt = os.clock(); m.endsAt = os.clock() + WARMUP
	for p in pairs(m.players) do task.spawn(spawnPlayer, m, p) end
	MatchService.balanceBots(m)
	BotService.freezeMatch(m.id, true)
	ArrivalService.play(m, WARMUP, function() broadcast(m) end)   -- arrivée en hélicoptère ou en véhicule (modes en équipe)
	for _ = 1, WARMUP * 2 do task.wait(0.5); broadcast(m) end
	m.state = "live"
	BotService.freezeMatch(m.id, false)
	for p in pairs(m.players) do
		local h = p.Character and p.Character:FindFirstChildOfClass("Humanoid"); if h then h.WalkSpeed = 16 end
	end
	m.startedAt = os.clock()
	m.endsAt = os.clock() + (m.def.time or 0)
	if m.mod.start then m.mod.start(m) end

	local winner: any = nil
	local done = false
	local last, sinceBroadcast = os.clock(), 0
	while not done do
		task.wait(0.1)
		if m.closed then return end
		local now = os.clock()
		local dt = now - last; last = now
		-- grenades à volonté : une frag revient toutes les 5 s
		if mutOn(m, "nades") then
			m.data._nadeT = (m.data._nadeT or 0) + dt
			if m.data._nadeT >= 5 then
				m.data._nadeT = 0
				for _, c in ipairs(MatchService.combatants(m)) do
					if aliveChar(c) and WeaponService.refillGrenade(c, "frag") and typeof(c) == "Instance" and c:IsA("Player") and popEvent then
						popEvent:FireClient(c, "💣 GRENADE RECHARGÉE", Color3.fromRGB(255, 210, 58))
					end
				end
			end
		end
		if m.mod.tick then
			local ok, err = pcall(m.mod.tick, m, dt)
			if not ok then warn("[MatchService] tick", m.mode, err) end
		end
		sinceBroadcast += dt
		if sinceBroadcast >= 0.5 then sinceBroadcast = 0; broadcast(m) end
		-- fin : limite atteinte (ou règle du mode), chrono écoulé, plus personne ; ou décision de l'admin (MatchService.forceEnd)
		if (m :: any).forced then
			(m :: any).forced = nil
			done = true
			if m.teams then
				local a, b = m.score[m.teams[1]] or 0, m.score[m.teams[2]] or 0
				winner = if a > b then m.teams[1] elseif b > a then m.teams[2] else nil
			else
				local best, bv = nil, -1
				for k, v in pairs(m.score) do if v > bv and m.stats[k] then best, bv = m.stats[k], v end end
				winner = best
			end
		elseif m.mod.checkEnd then
			local fin, w = m.mod.checkEnd(m)
			if fin then done, winner = true, w end
		elseif m.limit then
			for k, v in pairs(m.score) do
				if v >= m.limit then done = true; winner = if m.teams then k else m.stats[k] end
			end
		end
		if not done and m.timed and now >= m.endsAt then
			done = true
			if m.mod.timeUp then winner = m.mod.timeUp(m)
			elseif m.teams then
				local a, b = m.score[m.teams[1]] or 0, m.score[m.teams[2]] or 0
				winner = if a > b then m.teams[1] elseif b > a then m.teams[2] else nil
			else
				local best, bv = nil, -1
				for k, v in pairs(m.score) do if v > bv and m.stats[k] then best, bv = m.stats[k], v end end
				winner = best
			end
		end
		if humanCount(m) == 0 then return end
	end
	finish(m, winner)
	m.state = "intermission"
	m.endsAt = os.clock() + INTERMISSION
	pcall(MapVote.open, m, INTERMISSION)   -- vote de la carte suivante pendant la pause
	for _ = 1, INTERMISSION * 2 do task.wait(0.5); if m.closed then pcall(MapVote.close, m); return end; broadcast(m) end
	pcall(MapVote.close, m)
end

local function run(m: Match)
	while not m.closed do
		local ok, err = pcall(playOnce, m)
		if not ok then warn("[MatchService] partie interrompue :", err); task.wait(2) end
		if humanCount(m) == 0 then break end
		if m.mod.cleanup then pcall(m.mod.cleanup, m) end
	end
	close(m)
end

function MatchService.create(settings: any, host: Player?): Match?
	local s = Modes.sanitize(settings)
	local slot = freeSlot()
	if not slot then return nil end
	local id = nextId; nextId += 1
	local def = Modes.LIST[s.mode]
	local m: Match = {
		id = id, slot = slot, settings = s, def = def, mode = s.mode, mod = modeModule(s.mode),
		map = nil, origin = SLOT_ORIGIN + Vector3.new((slot - 1) * SLOT_SPACING, 0, 0), folderName = "Match_" .. id, roam = {},
		state = "loading", teams = if def.team then table.clone(TEAMS) else nil, score = {}, limit = s.limit, endsAt = 0, startedAt = 0, timed = def.time ~= nil,
		players = {}, stats = {}, dmgBy = {}, kcHold = {}, host = host, data = {}, botCount = {}, closed = false, pickups = {},
	}
	matches[id] = m
	return m
end

-- termine la partie tout de suite (panneau admin) : le meilleur score gagne, comme à la fin du chrono
function MatchService.forceEnd(m: Match)
	if m.state == "live" then (m :: any).forced = true end
end

function MatchService.start(m: Match)
	task.spawn(run, m)
end

-- Parties qu'on peut rejoindre, pour le menu
function MatchService.list(): { any }
	local l = {}
	for _, m in pairs(matches) do
		if not m.closed and not m.settings.private then
			table.insert(l, { id = m.id, mode = m.mode, modeName = m.def.n, map = m.settings.map, mapName = Modes.MAP[m.settings.map] and Modes.MAP[m.settings.map].n or m.settings.map,
				players = humanCount(m), max = MatchService.capacity(m), state = m.state, diff = m.settings.diff,
				timeLeft = if m.timed then math.max(0, math.floor(m.endsAt - os.clock())) else -1, host = m.host and m.host.DisplayName or "",
				ranked = m.settings.ranked == true, hasMut = next(m.settings.mut or {}) ~= nil })
		end
	end
	table.sort(l, function(a, b) return a.players > b.players end)
	return l
end

-- en duel (ou en file d'attente d'une plateforme) : on ne l'emmène pas dans une partie
local function inDuel(q: Player): boolean
	return q:GetAttribute("DuelQueued") ~= nil or q:GetAttribute("Zone") == "duel"
end

-- Lancer une partie avec ses réglages : le joueur et les membres de son groupe y entrent
function MatchService.hostFor(p: Player, settings: any): (boolean, string?)
	if not PartyService.isLeader(p) then return false, "Seul le chef du groupe lance la partie" end
	local m = MatchService.create(settings, p)
	if not m then return false, "Serveur plein : rejoins une partie en cours" end
	local group = PartyService.membersOf(p)
	for _, q in ipairs(group) do
		if q.Parent and (q == p or not inDuel(q)) then
			-- quitter vraiment l'ancienne partie (sinon il y resterait compté et elle ne se libérerait jamais)
			if matchOfPlayer[q] then MatchService.leave(q, true) end
			MatchService.join(q, m, if q == p then m.settings.side else nil)
		end
	end
	MatchService.start(m)
	return true, nil
end

-- Parties en ligne : avant d'ouvrir une nouvelle partie publique, on rejoint une partie du même mode où il reste
-- de la place pour tout le groupe (même carte de préférence, puis la plus remplie). Les bots ne servent qu'à compléter :
-- balanceBots en retire un à chaque joueur qui arrive. Entraînement et parties avec modificateurs restent à part.
local function findPublic(s: any, need: number): Match?
	if s.mode == "train" or next(s.mut or {}) ~= nil then return nil end
	local best: Match?, bestScore = nil, -1
	for _, m in pairs(matches) do
		if not m.closed and not m.settings.private and m.state ~= "over" and m.mode == s.mode
			and m.settings.ranked == (s.ranked == true) and next(m.settings.mut or {}) == nil
			and humanCount(m) + need <= MatchService.capacity(m) then
			local score = humanCount(m) + (if m.settings.map == s.map then 100 else 0)
			if score > bestScore then best, bestScore = m, score end
		end
	end
	return best
end

function MatchService.playOnline(p: Player, settings: any): (boolean, string?)
	if not PartyService.isLeader(p) then return false, "Seul le chef du groupe lance la partie" end
	local s = Modes.sanitize(settings)
	if not s.private then
		local group = PartyService.membersOf(p)
		local m = findPublic(s, math.max(1, #group))
		if m then
			local ok = MatchService.join(p, m, s.side)
			for _, q in ipairs(group) do
				if q ~= p and q.Parent and not inDuel(q) then MatchService.join(q, m) end
			end
			if ok then return true, nil end
		end
	end
	return MatchService.hostFor(p, settings)
end

-- Partie rapide : une partie publique d'un mode rapide où il reste de la place, sinon une nouvelle
function MatchService.quick(p: Player, mode: string?): (boolean, string?)
	local best: Match? = nil
	for _, m in pairs(matches) do
		if not m.closed and not m.settings.private and m.state ~= "over" and (mode == nil or m.mode == mode)
			and table.find(Modes.QUICK, m.mode) and humanCount(m) < MatchService.capacity(m) then
			if not best or humanCount(m) > humanCount(best) then best = m end
		end
	end
	if best and MatchService.join(p, best) then return true, nil end
	local pick = mode or Modes.QUICK[math.random(#Modes.QUICK)]
	local maps = Modes.mapsFor(pick)
	return MatchService.hostFor(p, { mode = pick, map = maps[math.random(#maps)], diff = 3 })
end

-- cadence : chaque lancement construit une carte entière ; un client qui spamme occuperait toutes les places du serveur
local BUSY = "Doucement : une partie à la fois"
createFn.OnServerInvoke = function(p: Player, settings: any)
	if inDuel(p) then return false, "Termine ton duel d'abord" end
	if not RateLimit.ok(p, "MatchCreate", 2) then return false, BUSY end
	return MatchService.playOnline(p, settings)
end
quickFn.OnServerInvoke = function(p: Player, mode: any)
	if inDuel(p) then return false, "Termine ton duel d'abord" end
	if not RateLimit.ok(p, "MatchCreate", 2) then return false, BUSY end
	return MatchService.quick(p, if typeof(mode) == "string" and Modes.LIST[mode] then mode else nil)
end
joinFn.OnServerInvoke = function(p: Player, id: any)
	if inDuel(p) then return false, "Termine ton duel d'abord" end
	if not RateLimit.ok(p, "MatchJoin", 1) then return false, BUSY end
	local m = if typeof(id) == "number" then matches[id] else nil
	if not m or m.settings.private then return false, "Cette partie n'existe plus" end
	if MatchService.join(p, m) then return true, nil end
	return false, "Partie pleine"
end
leaveFn.OnServerInvoke = function(p: Player)
	if not matchOfPlayer[p] then return false end
	MatchService.leave(p)
	return true
end
listFn.OnServerInvoke = function(_p: Player) return MatchService.list() end

-- arme principale (slot 0) ou pistolet (slot 1) ; gardé dans le profil, appliqué à la prochaine apparition
loadoutFn.OnServerInvoke = function(player: Player, key: any)
	if typeof(key) ~= "string" then return false end
	local w = Config.WEAPONS[key]
	if not w or (w.slot ~= 0 and w.slot ~= 1) then return false end
	local profile = DataService.get(player)
	if not ShopCatalog.STARTER_WEAPONS[key] and not (profile and ShopCatalog.ownsWeapon(profile, key)) then return false end
	player:SetAttribute(if w.slot == 0 then "Primary" else "Secondary", key)   -- repris aussi par les duels et le stand de tir du lobby
	if profile then
		profile.loadout = profile.loadout or {}
		profile.loadout[if w.slot == 0 then "primary" else "secondary"] = key
	end
	return true
end

Players.PlayerRemoving:Connect(function(p) MatchService.leave(p, true) end)

-- charge tous les modes dès le démarrage : leurs remotes (ZombieGain, BuyItem…) existent avant que les
-- scripts clients les attendent, même si personne n'a encore lancé ce mode
task.defer(function()
	local folder = script.Parent:FindFirstChild("Modes")
	for _, ms in ipairs(folder and folder:GetChildren() or {}) do
		if ms:IsA("ModuleScript") then modeModule(ms.Name) end
	end
end)

return MatchService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="435">
      <Properties>
        <string name="Name">MedalService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/MedalService (ModuleScript, requis par Main)
-- Médailles en partie et fin de partie (src/8G_medals.js), bilan perso (src/8Zf_confort.js) et défis qui avancent
-- pendant les parties (src/8O_defis.js : éliminations par type d'arme, victoires par mode, Infecté, plaques).
--   • En partie : chaque médaille s'affiche au joueur (remote « MedalPop », MedalController) et compte dans son profil
--     (profile.medals[id]).
--   • Fin de partie (MatchService.finishHooks) : XP des médailles ajoutée aux récompenses, liste des médailles du match
--     (résumé MatchEnd : medals = { { id, n, ic, count } }, rewards.medXp) et bilan perso (bilan = { acc, hsPct, dmg, streak }).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local Medals = require(ReplicatedStorage.Shared.Medals)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local WeaponService = require(script.Parent.WeaponService)
local BotService = require(script.Parent.BotService)
local MatchService = require(script.Parent.MatchService)

local U = Config.STUDS_PER_METER
local popEvent = Instance.new("RemoteEvent"); popEvent.Name = "MedalPop"; popEvent.Parent = ReplicatedStorage   -- serveur -> joueur : id de la médaille

type PState = { got: { [string]: number }, killer: any, lastKill: { t: number, key: string }?, streak: number, roundKills: number, multi: number, deathsRow: number }
type MState = { fb: boolean, round: any, players: { [Player]: PState }, dmg: { [any]: { [Player]: { d: number, t: number } } }, hurtAt: { [Instance]: number },
	kst: { [any]: number } }   -- kst = série en cours de chaque combattant (bots compris), pour « Rabat-joie »

local MedalService = {}
local states: { [number]: MState } = {}

local function now(): number return os.clock() end
local function isPlayer(c: any): boolean return typeof(c) == "Instance" and c:IsA("Player") end

local function stateOf(m: any): MState
	local cur = states[m.id]
	if cur and cur.round ~= "__over" then return cur end
	local s: MState = { fb = false, round = nil, players = {}, dmg = {}, hurtAt = {}, kst = {} }
	states[m.id] = s
	return s
end
local function pstate(ms: MState, p: Player): PState
	local ps = ms.players[p]
	if not ps then ps = { got = {}, killer = nil, lastKill = nil, streak = 0, roundKills = 0, multi = 0, deathsRow = 0 }; ms.players[p] = ps end
	return ps
end

function MedalService.award(p: Player, ms: MState, id: string)
	local def = Medals.LIST[id]
	if not def then return end
	local ps = pstate(ms, p)
	ps.got[id] = (ps.got[id] or 0) + 1
	local profile = DataService.get(p)
	if profile then
		profile.medals = profile.medals or {}
		profile.medals[id] = (profile.medals[id] or 0) + 1
	end
	popEvent:FireClient(p, id)
	RewardService.missionEvent(p, "md_" .. id)   -- défis « fais N assistances / tirs lointains / glissades mortelles… »
end

local function rootOf(c: any): BasePart?
	local ch = WeaponService.charOf(c)
	return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local function enemies(m: any, a: any, b: any): boolean
	local ta, tb = WeaponService.teamOf(a), WeaponService.teamOf(b)
	if m.teams then return ta ~= tb end
	return a ~= b
end

-- dégâts des joueurs (assistances) et dernier coup reçu (Sauveur)
WeaponService.Damaged:Connect(function(attacker, victim, amount: number, _headshot: boolean)
	local m = MatchService.matchOf(victim)
	if not m or m.state ~= "live" then return end
	local ms = stateOf(m)
	local vc = WeaponService.charOf(victim)
	if vc then ms.hurtAt[vc] = now() end
	if isPlayer(attacker) and attacker ~= victim and MatchService.matchOf(attacker) == m then
		local key = MatchService.keyOf(victim)
		local by = ms.dmg[key] or {}; ms.dmg[key] = by
		local e = by[attacker]
		if e and now() - e.t < Medals.ASSIST_T then e.d += amount; e.t = now() else by[attacker] = { d = amount, t = now() } end
	end
end)

WeaponService.Killed:Connect(function(killer, victim, key: string, _headshot: boolean)
	local m = MatchService.matchOf(victim)
	if not m or m.state ~= "live" then return end
	local ms = stateOf(m)
	-- manche suivante (modes à manches) : compteurs de l'As remis à zéro
	local round = m.data and m.data.round
	if round ~= ms.round then
		ms.round = round
		for _, ps in pairs(ms.players) do ps.roundKills = 0 end
	end
	local w = Config.WEAPONS[key]
	local melee = w ~= nil and w.melee
	local t = now()
	if isPlayer(victim) then
		local vs = pstate(ms, victim)
		vs.killer = if killer ~= nil and killer ~= victim then killer else nil
		vs.streak = 0
		vs.deathsRow += 1
	end
	-- série de la victime (bots compris) avant sa mort : « Rabat-joie » pour qui l'arrête
	local vkst = ms.kst[MatchService.keyOf(victim)] or 0
	ms.kst[MatchService.keyOf(victim)] = 0
	if killer ~= nil and killer ~= victim then
		local kk = MatchService.keyOf(killer)
		ms.kst[kk] = (ms.kst[kk] or 0) + 1
	end
	-- assistances : un autre joueur a infligé au moins 25 dégâts à cet adversaire dans les 8 dernières secondes
	local vkey = MatchService.keyOf(victim)
	for p, e in pairs(ms.dmg[vkey] or {}) do
		if p ~= killer and p.Parent and m.players[p] and e.d >= Medals.ASSIST_DMG and t - e.t < Medals.ASSIST_T and enemies(m, p, victim) then
			MedalService.award(p, ms, "assist")
		end
	end
	ms.dmg[vkey] = nil
	if killer == nil or killer == victim then return end
	local firstBlood = not ms.fb
	ms.fb = true     -- le premier sang compte pour tout le monde
	if not isPlayer(killer) or not m.players[killer] or not enemies(m, killer, victim) then return end
	if victim:GetAttribute("Zombie") then return end
	local p = killer :: Player
	local ps = pstate(ms, p)
	ps.streak += 1
	if firstBlood then MedalService.award(p, ms, "first") end
	if ps.killer ~= nil and ps.killer == victim then ps.killer = nil; MedalService.award(p, ms, "revenge") end
	local kr, vr = rootOf(killer), rootOf(victim)
	local distM = if kr and vr then (Vector3.new(kr.Position.X - vr.Position.X, 0, kr.Position.Z - vr.Position.Z)).Magnitude / U else nil
	if distM and not melee and distM > Medals.LONG_M then
		MedalService.award(p, ms, "long")
	end
	if distM and not melee and key ~= "frag" and distM < Medals.POINT_M then MedalService.award(p, ms, "pointblank") end
	if vkst >= Medals.BUZZ_STREAK then MedalService.award(p, ms, "buzzkill") end
	if ps.deathsRow >= Medals.COMEBACK_D then MedalService.award(p, ms, "comeback") end
	ps.deathsRow = 0
	if melee then MedalService.award(p, ms, "knife") end
	if key == "frag" then MedalService.award(p, ms, "nade") end
	local kc = WeaponService.charOf(killer)
	local hum = kc and kc:FindFirstChildOfClass("Humanoid")
	local anim = kc and kc:GetAttribute("Anim")
	-- bit 1 de « Anim » = glissade (Shared/SoldierAnim, Anim.SLIDE) : médaille à part, plus « Acrobate »
	local sliding = typeof(anim) == "number" and bit32.band(anim, 1) ~= 0
	local inAir = hum ~= nil and hum.FloorMaterial == Enum.Material.Air and not sliding
	if inAir and not melee and key ~= "frag" then MedalService.award(p, ms, "air") end
	if sliding and key ~= "frag" then MedalService.award(p, ms, "slide") end
	if hum and hum.Health > 0 and hum.Health <= Medals.CLUTCH_HP then MedalService.award(p, ms, "clutchhp") end
	-- sauveur : la victime (un bot) visait un allié du tueur, touché il y a moins de 2 s
	if m.teams and BotService.isBot(victim) then
		local tgt = BotService.combatOf(victim)
		local tc = tgt and WeaponService.combatantOf(tgt)
		local th = tgt and tgt:FindFirstChildOfClass("Humanoid")
		if tgt and tc ~= nil and tc ~= p and th and th.Health > 0 and WeaponService.teamOf(tc) == WeaponService.teamOf(p)
			and t - (ms.hurtAt[tgt] or -99) < Medals.SAVE_T then
			MedalService.award(p, ms, "save")
		end
	end
	local lk = ps.lastKill
	if lk and t - lk.t < Medals.COLLAT_T and lk.key == key and not melee then MedalService.award(p, ms, "collat") end
	-- éliminations en chaîne (moins de 4 s entre chacune) : double, triplé, furie
	ps.multi = if lk and t - lk.t < Medals.MULTI_T then ps.multi + 1 else 1
	if ps.multi == 2 then MedalService.award(p, ms, "double")
	elseif ps.multi == 3 then MedalService.award(p, ms, "triple")
	elseif ps.multi == 4 then MedalService.award(p, ms, "fury") end
	ps.lastKill = { t = t, key = key }
	if ps.streak == 5 then MedalService.award(p, ms, "s5") end
	if ps.streak == 10 then MedalService.award(p, ms, "s10") end
	-- As (Compétitif) : toute l'équipe adverse (3 au moins) éliminée par le joueur dans la manche
	if m.mode == "bomb" then
		ps.roundKills += 1
		local foes = 0
		for _, c in ipairs(MatchService.combatants(m)) do if WeaponService.teamOf(c) ~= WeaponService.teamOf(p) then foes += 1 end end
		if foes >= 3 and ps.roundKills == foes then MedalService.award(p, ms, "ace") end
	end
	-- défis : éliminations par type d'arme (k_pistol, k_smg, k_shotgun, k_rifle, k_sniper) et à la grenade
	if w and w.cat and not melee then RewardService.missionEvent(p, "k_" .. w.cat) end
	if key == "frag" then RewardService.missionEvent(p, "nade") end
end)

-- ---------- fin de partie ----------
table.insert(MatchService.finishHooks, function(m: any, p: Player, s: any, won: boolean, payload: { [string]: any })
	local ms = states[m.id]
	local ps = ms and ms.players[p]
	-- médailles du match et leur XP
	local list, xp = {}, 0
	if ps then
		for _, id in ipairs(Medals.ORDER) do
			local n = ps.got[id]
			if n and n > 0 then
				local d = Medals.LIST[id]
				table.insert(list, { id = id, n = d.n, ic = d.ic, count = n })
				xp += d.xp * n
			end
		end
	end
	payload.medals = list
	if xp > 0 and payload.rewards then
		local ups = RewardService.addXP(p, xp)
		local r = payload.rewards
		r.xp += xp; r.medXp = xp
		r.levelUps = r.levelUps or {}
		for _, u in ipairs(ups) do table.insert(r.levelUps, u) end
		local profile = DataService.get(p)
		if profile and profile.history and profile.history[1] then profile.history[1].xp = r.xp end
	end
	-- bilan perso : précision, tirs à la tête, dégâts, meilleure série (pas en Entraînement)
	if s and m.mode ~= "train" then
		payload.bilan = {
			acc = if s.shots > 0 then math.floor(s.hits / s.shots * 100 + 0.5) else nil,
			hsPct = if s.k > 0 then math.floor(s.hs / s.k * 100 + 0.5) else nil,
			dmg = math.floor(s.dmg + 0.5), streak = s.bestStreak,
		}
	end
	-- défis liés au résultat de la partie
	if s then
		if won then RewardService.missionEvent(p, "w_" .. m.mode) end
		local planted = (s.plants or 0) + (s.defuses or 0)
		if planted > 0 then RewardService.missionEvent(p, "plant", planted) end
		if m.mode == "inf" and won and s.team == "Défenseurs" then RewardService.missionEvent(p, "inf_surv") end    -- survivant jusqu'au bout
		if m.mode == "kc" and (s.pts or 0) > 0 then RewardService.missionEvent(p, "kcTag", s.pts) end
	end
	-- Zombies : manches survécues (m.data.zs du mode, lu sans le modifier)
	local zs = m.mode == "zombies" and m.data and (m.data :: any).zs
	if zs and typeof(zs.wave) == "number" then
		local survived = zs.wave - (if zs.result == "win" then 0 else 1)
		if survived > 0 then RewardService.missionEvent(p, "z_wave", survived) end
	end
end)

-- partie suivante (même salon) ou fermée : les compteurs repartent à zéro
task.spawn(function()
	while true do
		task.wait(2)
		for id, ms in pairs(states) do
			local m = MatchService.get(id)
			if not m then states[id] = nil
			elseif m.state == "warmup" and ms.round ~= "__over" then ms.round = "__over" end
		end
	end
end)

Players.PlayerRemoving:Connect(function(p)
	for _, ms in pairs(states) do ms.players[p] = nil end
end)

return MedalService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="436">
      <Properties>
        <string name="Name">MenuService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/MenuService (ModuleScript, requis par Main)
-- Ce dont le menu principal (StarterPlayerScripts/MainMenu) a besoin côté serveur :
--   ClaimWeekly(i)        récupérer un défi de la semaine (RewardService)
--   MenuSave(kind, data)  garder dans le profil les réglages de l'écran « Jouer » (kind = "play") et les Réglages (kind = "opts")
--   SetTitle(id)          titre de profil (niveau ou fidélité), recopié dans l'attribut « Title » du joueur
-- Le serveur vérifie tout : réglages passés par Modes.sanitize, nombres bornés, titre réellement débloqué.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")

local Modes = require(ReplicatedStorage.Shared.Modes)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local LoyaltyConfig = require(ReplicatedStorage.Shared.LoyaltyConfig)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)

local MenuService = {}

local function remote(name: string, fn: (Player, ...any) -> any)
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; r.OnServerInvoke = fn
end

remote("ClaimWeekly", function(p: Player, index: any)
	if typeof(index) ~= "number" then return nil end
	return RewardService.claimWeekly(p, index)
end)

-- réglages du menu : bornés, un enregistrement toutes les 0,5 s au plus
local lastSave: { [Player]: number } = {}
local OPTS = { fov = { 60, 110, 70 }, sens = { 0.1, 4, 1 }, aimSens = { 0.2, 2, 1 }, vol = { 0, 1, 0.7 }, quality = { 1, 3, 3 } }
remote("MenuSave", function(p: Player, kind: any, data: any)
	local profile = DataService.get(p)
	if not profile or typeof(data) ~= "table" then return false end
	if os.clock() - (lastSave[p] or 0) < 0.5 then return false end
	lastSave[p] = os.clock()
	profile.menu = if typeof(profile.menu) == "table" then profile.menu else {}
	if kind == "play" then
		local s = Modes.sanitize(data)
		profile.menu.play = { mode = s.mode, map = s.map, diff = s.diff, size = s.size, limit = s.limit, side = s.side, eco = s.eco, mut = s.mut, ranked = s.ranked,
			friends = data.friends == true }
		return true
	elseif kind == "opts" then
		local o: { [string]: number } = {}
		for k, r in pairs(OPTS) do
			local v = data[k]
			o[k] = if typeof(v) == "number" and v == v then math.clamp(v, r[1], r[2]) else r[3]
		end
		o.quality = math.floor(o.quality + 0.5)
		profile.menu.opts = o
		return true
	end
	return false
end)

-- titres : ceux du niveau (MenuConfig.TITLES) et ceux de fidélité possédés (LoyaltyService, profile.loy.titles)
local function titleName(profile: any, id: string): string?
	if id == "" then return "" end
	local level = RewardService.levelInfo(profile)
	for _, t in ipairs(MenuConfig.TITLES) do
		if t.id == id then return if level >= t.lvl then t.n else nil end
	end
	local owned = profile.loy and profile.loy.titles or {}
	if table.find(owned, id) and LoyaltyConfig.TITLES[id] then return LoyaltyConfig.TITLES[id] end
	return nil
end
local function publishTitle(p: Player, profile: any)
	local id = profile.cosmetics and profile.cosmetics.title or ""
	local name = if typeof(id) == "string" then titleName(profile, id) else nil
	p:SetAttribute("Title", if name and name ~= "" then name else nil)
end
remote("SetTitle", function(p: Player, id: any)
	local profile = DataService.get(p)
	if not profile or typeof(id) ~= "string" or titleName(profile, id) == nil then return false end
	profile.cosmetics = profile.cosmetics or { attachments = {}, charm = "", trail = "", spray = "smile", title = "", knife = "classic" }
	profile.cosmetics.title = id
	publishTitle(p, profile)
	return true
end)

Players.PlayerAdded:Connect(function(p: Player)
	for _ = 1, 30 do
		local profile = DataService.get(p)
		if profile then publishTitle(p, profile); return end
		task.wait(1)
	end
end)
Players.PlayerRemoving:Connect(function(p: Player) lastSave[p] = nil end)

return MenuService
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="437">
      <Properties>
        <string name="Name">Modes</string>
      </Properties>
      <Item class="ModuleScript" referent="438">
        <Properties>
          <string name="Name">bomb</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/bomb : Compétitif (Recherche et destruction du web, src/60_game.js) : manches, phase d'achat figée de 20 s,
-- boutique (touche B), économie façon Valorant (src/8Zc_eco.js), bombe à poser / désamorcer, mi-temps.
-- Toutes les règles sont dans Modes/rounds.
return require(script.Parent.rounds).make("bomb")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="439">
        <Properties>
          <string name="Name">br</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/br : Bataille royale (web : src/61_variants.js brInit / brUpdate / addLoot, src/8G_rounds.js durée, src/70_ai.js botGoal).
--   - Chacun pour soi, pas de réapparition : tout le monde commence au couteau, sans gilet ni bouclier ni grenade.
--   - Butin à usage unique réparti sur la carte (au moins 26 objets, 3 par joueur) : 70 % d'armes (4 paliers, meilleures
--     au centre), sinon gilet, bouclier, santé ou munitions. On ramasse en passant dessus.
--   - Zone de 64 m de rayon au centre ; 4 phases (attente puis réduction vers 44, 26, 12 puis 0 m) étirées pour se fermer
--     vers 80 % du chrono (5 min). Hors zone : dégâts chaque seconde (2, 4, 7, 12 selon la phase, + 1,5 par phase passée).
--   - Le dernier en vie gagne ; à la fin du chrono, le survivant le plus en forme (vie + gilet + bouclier).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Z = require(ReplicatedStorage.Shared.ZombieConfig)
local MapData = require(ReplicatedStorage.Shared.MapData) :: any
local WeaponService = require(script.Parent.Parent.WeaponService)

local U = Config.STUDS_PER_METER
local N = MapData.N
local PURPLE = Z.rgb(0xc77dff)
local M = {}
M.noPickups = true
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end
local popEvent = ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
if not popEvent then
	local e = Instance.new("RemoteEvent"); e.Name = "ModePop"; e.Parent = ReplicatedStorage; popEvent = e
end
local function isPlayer(c: any): boolean return typeof(c) == "Instance" and c:IsA("Player") end
local function tell(c: any, text: string, color: Color3?, sound: string?)
	if isPlayer(c) and popEvent then (popEvent :: RemoteEvent):FireClient(c, text, color, sound) end
end
local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end

-- ---------- armes de chacun (principale p / pistolet s) ----------
local function arms(m: any, c: any): { p: string?, s: string? }
	local k = MS().keyOf(c)
	local a = m.data.arms[k]
	if not a then a = { p = nil, s = nil }; m.data.arms[k] = a end
	return a
end
local function equip(m: any, c: any, select: string?)
	local a = arms(m, c)
	local keys = {}
	if a.p then table.insert(keys, a.p) end
	if a.s then table.insert(keys, a.s) end
	table.insert(keys, "knife")
	WeaponService.setLoadoutKeep(c, keys, select)
end

-- ---------- butin ----------
local function aliveCombatants(m: any): { any }
	local l = {}
	for _, c in ipairs(MS().combatants(m)) do if MS().aliveChar(c) then table.insert(l, c) end end
	return l
end

local function lootPart(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, transp: number): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.Size = size; p.CFrame = cf; p.Color = color; p.Material = Enum.Material.Neon; p.Transparency = transp; p.Parent = parent
	return p
end

local useLoot: (any, any, any) -> boolean

local function addLoot(m: any, kind: string, key: string?, pos: Vector3)
	local model = Instance.new("Model"); model.Name = "Loot_" .. (key or kind)
	model:SetAttribute("LootKind", kind)
	local col: Color3
	local corePos = pos + Vector3.new(0, 0.9 * U, 0)
	if kind == "weapon" and key then
		col = Z.lootColor(Config.WEAPONS[key].cat)
		model:SetAttribute("LootKey", key)          -- le client y pose le vrai modèle de l'arme (ZombieBrHud)
		local core = lootPart(model, "Core", Vector3.new(0.3, 0.3, 0.3) * U, CFrame.new(corePos), col, 1)
		local l = Instance.new("PointLight"); l.Color = col; l.Range = 2.4 * U; l.Brightness = 1.2; l.Parent = core
		model.PrimaryPart = core
	else
		local vis = if kind == "armor" then "shield" else kind     -- le gilet a l'apparence du bouclier, comme sur le web
		col = if vis == "shield" then Z.rgb(0x31c8ff) elseif vis == "health" then Z.rgb(0xff4a5a) else Z.rgb(0xffd24a)
		local core: Part
		if vis == "shield" then
			core = lootPart(model, "Core", Vector3.new(0.4, 0.4, 0.4) * U, CFrame.new(corePos) * CFrame.Angles(math.rad(45), 0, math.rad(35.26)), col, 0.08)
		elseif vis == "health" then
			core = lootPart(model, "Core", Vector3.new(0.4, 0.4, 0.4) * U, CFrame.new(corePos), col, 0.08)
			lootPart(model, "CrossA", Vector3.new(0.5, 0.12, 0.12) * U, CFrame.new(corePos), Color3.new(1, 1, 1), 0)
			lootPart(model, "CrossB", Vector3.new(0.12, 0.5, 0.12) * U, CFrame.new(corePos), Color3.new(1, 1, 1), 0)
		else
			core = lootPart(model, "Core", Vector3.new(0.5, 0.28, 0.32) * U, CFrame.new(corePos), col, 0.08)
		end
		local l = Instance.new("PointLight"); l.Color = col; l.Range = 2.4 * U; l.Brightness = 1.6; l.Parent = core
		model.PrimaryPart = core
	end
	local ring = lootPart(model, "Ring", Vector3.new(0.04 * U, 1.3 * U, 1.3 * U), CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)), col, 0.45)
	ring.Shape = Enum.PartType.Cylinder
	local zone = lootPart(model, "Zone", Vector3.new(2.6, 3, 2.6) * U, CFrame.new(pos + Vector3.new(0, 1.5 * U, 0)), col, 1)
	zone.CanTouch = true
	model.Parent = m.data.folder
	local item = { kind = kind, key = key, pos = pos, model = model }
	table.insert(m.data.loot, item)
	zone.Touched:Connect(function(hit: BasePart)
		if not model.Parent or m.state ~= "live" then return end
		local mm = hit:FindFirstAncestorOfClass("Model")
		local hum = mm and mm:FindFirstChildOfClass("Humanoid")
		if not mm or not hum or hum.Health <= 0 then return end
		local c = WeaponService.combatantOf(mm)
		if MS().matchOf(c) ~= m then return end
		if useLoot(m, c, item) then
			model:Destroy()
			local i = table.find(m.data.loot, item); if i then table.remove(m.data.loot, i) end
		end
	end)
end

useLoot = function(m: any, c: any, item: any): boolean
	local ch = WeaponService.charOf(c)
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not hum then return false end
	local k = item.kind
	if k == "shield" then
		if WeaponService.shieldOf(c) >= Config.SHIELD_MAX then return false end
		WeaponService.addShield(c, 25); tell(c, "+25 bouclier", Z.rgb(0x31c8ff), "pickup")
	elseif k == "health" then
		if hum.Health >= 100 then return false end
		hum.Health = math.min(math.max(100, hum.MaxHealth), hum.Health + 35); tell(c, "+35 santé", Z.rgb(0xff4a5a), "heal")
	elseif k == "ammo" then
		for _, w in ipairs(WeaponService.loadoutOf(c)) do
			local def = Config.WEAPONS[w]
			if def and not def.melee then
				local _, res = WeaponService.ammoOf(c, w)
				WeaponService.setAmmo(c, w, WeaponService.magOf(c, w), math.max(res, def.reserve))
			end
		end
		tell(c, "Munitions", Z.rgb(0xffd24a), "pickup")
	elseif k == "armor" then
		if WeaponService.armorOf(c) >= 100 then return false end
		WeaponService.setArmor(c, 100); tell(c, "Gilet récupéré", Z.rgb(0x31c8ff), "pickup")
	elseif k == "weapon" and item.key then
		local a = arms(m, c)
		local slot = if Config.WEAPONS[item.key].slot == 1 then "s" else "p"
		if (a :: any)[slot] == item.key then return false end
		if slot == "p" then a.p = nil else a.s = nil end
		equip(m, c, nil)                          -- l'ancienne arme de cet emplacement est jetée
		if slot == "p" then a.p = item.key else a.s = item.key end
		equip(m, c, item.key)
		tell(c, "Arme : " .. Config.WEAPONS[item.key].name, Z.lootColor(Config.WEAPONS[item.key].cat), "pickup")
	else
		return false
	end
	return true
end

local function placeLoot(m: any)
	local g = m.map.grid or MapData.buildGrid(m.settings.map)
	local cells = {}
	for cz = 2, N - 3 do for cx = 2, N - 3 do
		local i = cz * N + cx
		if g.type[i] == 0 and g.ramp[i] == 0 then table.insert(cells, { cx, cz }) end
	end end
	for i = #cells, 2, -1 do local j = math.random(i); cells[i], cells[j] = cells[j], cells[i] end
	local want = math.max(26, #MS().combatants(m) * 3, m.settings.size * 3)
	local placed, taken = 0, {} :: { { number } }
	for _, c in ipairs(cells) do
		if placed >= want then break end
		local near = false
		for _, t in ipairs(taken) do if math.sqrt((t[1] - c[1]) ^ 2 + (t[2] - c[2]) ^ 2) < 3.2 then near = true; break end end
		if not near then
			table.insert(taken, c)
			local dc = math.sqrt((c[1] - 20) ^ 2 + (c[2] - 20) ^ 2) / 28
			local r = math.random()
			local kind, key = "weapon", nil :: string?
			if r < 0.7 then
				local tr = if r < 0.3 then 1 elseif r < 0.52 then 2 elseif r < 0.66 then 3 else 4
				local tier = Z.BR_TIERS[math.min(4, tr + (if dc < 0.5 and math.random() < 0.4 then 1 else 0))]
				key = tier[math.random(#tier)]
			else
				kind = ({ "armor", "shield", "health", "ammo" })[math.random(4)]
			end
			addLoot(m, kind, key, MS().cellToWorld(m, c[1], c[2]))
			placed += 1
		end
	end
end

-- ---------- zone ----------
local function zoneWorld(m: any): (Vector3, number)
	local z = m.data.zone
	return m.origin + Vector3.new(z.cx * U, 0, z.cz * U), z.r * U
end

function M.setup(m: any)
	m.limit = nil
	m.data.arms = {}
	m.data.loot = {}
	m.data.phases = Z.brPhases(Z.BR_TIME)
	m.data.zone = { phase = 1, state = "wait", t = 0, wait = m.data.phases[1].wait, r = Z.BR_START_R, from = Z.BR_START_R, to = Z.BR_START_R,
		cx = 40, cz = 40, fx = 40, fz = 40, tx = 40, tz = 40, dmg = 2, tick = 0, done = false }
	local f = Instance.new("Folder"); f.Name = "BattleRoyale"; f.Parent = m.map.folder
	m.data.folder = f
	m.data.warned = false
end
function M.start(m: any)
	m.timed = true
	m.endsAt = os.clock() + Z.BR_TIME
	m.data.started = true
	placeLoot(m)
	MS().announce(m, "BATAILLE ROYALE", "Ramasse une arme, reste dans la zone — " .. math.floor(Z.BR_TIME / 60) .. " min", PURPLE)
end
function M.loadout(_m: any, _c: any): { string }? return { "knife" } end
function M.onSpawn(m: any, c: any, char: Model)
	local a = arms(m, c); a.p = nil; a.s = nil
	task.defer(function()
		if not char.Parent then return end
		WeaponService.giveGrenades(c, 0, 0, 0)
		WeaponService.setArmor(c, 0)
		local sh = WeaponService.shieldOf(c)
		if sh > 0 then WeaponService.addShield(c, -sh) end
	end)
end
function M.botsWanted(m: any, _team: string?, want: number): number?
	if m.state == "live" then return nil end       -- personne ne réapparaît : on ne remplace pas les éliminés
	return want
end
function M.botRespawn(_m: any, _s: any): boolean return false end
function M.canRespawn(_m: any, _c: any): boolean return false end

function M.tick(m: any, dt: number)
	local z = m.data.zone
	local ph = m.data.phases[math.min(z.phase, #m.data.phases)]
	if z.state == "wait" then
		z.wait -= dt
		if z.wait <= 0 then
			z.state = "shrink"; z.t = ph.shrink; z.from = z.r; z.to = ph.r
			local a = math.random() * math.pi * 2
			local d = if ph.r > 0 then math.random() * math.max(0, z.r - ph.r) * 0.6 else 0
			z.tx = math.clamp(z.cx + math.cos(a) * d, 20, 60); z.tz = math.clamp(z.cz + math.sin(a) * d, 20, 60)
			z.fx = z.cx; z.fz = z.cz
			for p in pairs(m.players) do tell(p, "La zone se réduit !", Z.ZONE_COLOR, "beep") end
		end
	elseif z.state == "shrink" then
		z.t -= dt
		local k = 1 - math.max(0, z.t) / ph.shrink
		z.r = lerp(z.from, z.to, k); z.cx = lerp(z.fx, z.tx, k); z.cz = lerp(z.fz, z.tz, k); z.dmg = ph.dmg
		if z.t <= 0 then
			z.phase += 1
			if z.phase > #m.data.phases then z.state = "final" else z.state = "wait"; z.wait = m.data.phases[z.phase].wait end
		end
	end
	-- dégâts hors zone, une fois par seconde
	z.tick += dt
	if z.tick >= 1 then
		z.tick -= 1
		local center, r = zoneWorld(m)
		for _, c in ipairs(aliveCombatants(m)) do
			local ch = WeaponService.charOf(c)
			local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
			if ch and root and Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude > r + 0.5 * U then
				WeaponService.applyDamage(nil, ch, z.dmg + (z.phase - 1) * 1.5, false, "Zone", 1)
			end
		end
	end
	if not m.data.warned and m.endsAt - os.clock() <= 60 then
		m.data.warned = true
		for p in pairs(m.players) do tell(p, "Plus qu'une minute !", Z.rgb(0xff6b6b), "beep") end
	end
	-- objets : petite rotation
	local t = os.clock()
	for _, it in ipairs(m.data.loot) do
		local core = it.model.PrimaryPart
		if core then core.CFrame = CFrame.new(it.pos + Vector3.new(0, (0.9 + math.sin(t * 2 + it.pos.X) * 0.1) * U, 0)) * CFrame.Angles(0, t * 1.6, 0) * (if it.kind == "shield" or it.kind == "armor" then CFrame.Angles(math.rad(45), 0, math.rad(35.26)) else CFrame.identity) end
	end
	-- ligne personnelle : en vie / éliminations
	local alive = #aliveCombatants(m)
	for p in pairs(m.players) do
		local s = m.stats[p]
		p:SetAttribute("ModeLine", "🌀 " .. alive .. " EN VIE   ·   " .. (if s then s.k else 0) .. " ÉLIMINATION" .. (if s and s.k > 1 then "S" else ""))
	end
	m.data.alive = alive
end

local function winnerStat(m: any, c: any): any return if c then m.stats[MS().keyOf(c)] else nil end
function M.checkEnd(m: any): (boolean, any)
	if not m.data.started then return false, nil end
	local alive = aliveCombatants(m)
	if #alive <= 1 then return true, winnerStat(m, alive[1]) end
	return false, nil
end
function M.timeUp(m: any): any
	local best, bs = nil, -1
	for _, c in ipairs(aliveCombatants(m)) do
		local h = (MS().aliveChar(c) :: Model):FindFirstChildOfClass("Humanoid")
		local s = (if h then h.Health else 0) + WeaponService.armorOf(c) + WeaponService.shieldOf(c)
		if s > bs then bs = s; best = c end
	end
	for p in pairs(m.players) do tell(p, "Temps écoulé !", Z.rgb(0xff6b6b), "beep") end
	return winnerStat(m, best)
end

-- bots : rentrer dans la zone, prendre une arme, puis gilet / soins (botGoal du web)
function M.botGoal(m: any, bot: Model): Vector3?
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local center, r = zoneWorld(m)
	if Vector3.new(root.Position.X - center.X, 0, root.Position.Z - center.Z).Magnitude > r - 5 * U then
		return center + Vector3.new((math.random() - 0.5) * 6 * U, 3, (math.random() - 0.5) * 6 * U)
	end
	local a = arms(m, bot)
	local function nearest(ok: (any) -> boolean, maxD: number): Vector3?
		local best, bd = nil, maxD * U
		for _, it in ipairs(m.data.loot) do
			if ok(it) then
				local d = (it.pos - root.Position).Magnitude
				if d < bd then best, bd = it.pos, d end
			end
		end
		return best
	end
	if not a.p then
		local p = nearest(function(it) return it.kind == "weapon" end, 70)
		if p then return p end
	end
	local hum = bot:FindFirstChildOfClass("Humanoid")
	if WeaponService.armorOf(bot) < 1 or (hum and hum.Health < 60) then
		local p = nearest(function(it) return it.kind ~= "weapon" and it.kind ~= "ammo" end, 40)
		if p then return p end
	end
	return nil
end

function M.info(m: any): any
	local z = m.data.zone
	if not z then return nil end
	local center, r = zoneWorld(m)
	local label, tt
	if z.state == "wait" then label, tt = "ZONE STABLE", z.wait
	elseif z.state == "shrink" then label, tt = "LA ZONE SE RÉDUIT", z.t
	else label, tt = "ZONE FINALE", 0 end
	local alive = m.data.alive or #aliveCombatants(m)
	m.data.public = { br = { x = center.X, z = center.Z, r = r, state = z.state, label = label, t = math.max(0, math.ceil(tt)), phase = z.phase, alive = alive,
		dmg = z.dmg + (z.phase - 1) * 1.5 } }
	return {
		line = "🌀 " .. alive .. " EN VIE",
		sub = label .. (if z.state ~= "final" then "  " .. string.format("%d:%02d", math.floor(math.ceil(tt) / 60), math.ceil(tt) % 60) else ""),
		subWarn = z.state == "shrink",
		color = Z.ZONE_COLOR, kind = "br",
	}
end

function M.onLeave(_m: any, p: Player) p:SetAttribute("ModeLine", nil) end
function M.cleanup(m: any)
	for p in pairs(m.players) do p:SetAttribute("ModeLine", nil) end
	if m.data.folder then m.data.folder:Destroy() end
	m.data.loot = {}
	m.data.started = false
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="440">
        <Properties>
          <string name="Name">ctf</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/ctf : Capture du drapeau (web : src/8Zd_ctf.js). Chaque équipe a un drapeau dans sa base, un peu en avant de
-- son point de départ. Touche le drapeau adverse pour le prendre, ramène-le dans ta base pendant que ton drapeau y est :
-- +1 capture. Le porteur éliminé lâche le drapeau ; un adversaire qui le touche le ramène aussitôt chez lui, un allié
-- du porteur peut le reprendre ; un drapeau lâché revient seul au bout de 25 s. Les éliminations ne marquent pas.
-- Premier à 3 / 5 / 7 captures ; à la fin du chrono (10 min), le plus de captures gagne.
-- Bots : un tiers défend, le reste attaque ; tout le monde poursuit le voleur ; le porteur file vers sa base.
local WeaponService = require(script.Parent.Parent.WeaponService)
local O = require(script.Parent.objutil)

local U = O.U
local T, CT = O.T, O.CT
local R, BACK = 1.5 * U, 25
local CLOTH = { Attaquants = Color3.fromRGB(216, 64, 15), ["Défenseurs"] = Color3.fromRGB(22, 96, 216) }
local M = {}
local function MS(): any return O.MS() end

type Flag = { team: string, home: Vector3, pos: Vector3, state: string, carrier: any, backAt: number, model: Model, ring: Model, rot: number }

local function base(m: any, team: string): Vector3
	local mine = if team == T then m.map.data.spawnT else m.map.data.spawnCT
	local them = if team == T then m.map.data.spawnCT else m.map.data.spawnT
	local x, z = O.avg(mine or { { 20, 36 } })
	local ox, oz = O.avg(them or { { 20, 4 } })
	local cx, cz = O.spot(m, x + (ox - x) * 0.12, z + (oz - z) * 0.12)
	return O.ground(m, MS().cellToWorld(m, cx, cz))
end
local function flagOf(m: any, team: string): Flag return m.data.flags[team] end
local function say(m: any, f: Flag, mineText: string, theirText: string, goodForMine: boolean, special: Player?, specialText: string?)
	for p in pairs(m.players) do
		local mine = WeaponService.teamOf(p) == f.team
		local good = if mine then goodForMine else not goodForMine
		local text = if special == p and specialText then specialText elseif mine then mineText else theirText
		MS().announce(m, text, nil, if good then O.GOOD else O.BAD, p)
	end
end
local function setHome(m: any, f: Flag)
	O.release(f.model, CFrame.new(f.home) * CFrame.Angles(0, f.rot, 0))
	f.state = "home"; f.carrier = nil; f.pos = f.home
	f.model:SetAttribute("State", "home")
	local _ = m
end
local function drop(m: any, f: Flag)
	local c = f.carrier
	local r = c and O.root(c)
	local at = if r then O.feet(r) else f.pos
	f.carrier = nil
	local ch = c and WeaponService.charOf(c)
	if ch then ch:SetAttribute("HasFlag", nil) end
	f.pos = O.groundBelow(m, at)
	O.release(f.model, CFrame.new(f.pos))
	f.state = "dropped"; f.backAt = os.clock() + BACK
	f.model:SetAttribute("State", "dropped")
	say(m, f, "NOTRE DRAPEAU EST TOMBÉ", "DRAPEAU ENNEMI LÂCHÉ", false)
end
local function take(m: any, f: Flag, c: any)
	f.state = "carried"; f.carrier = c
	f.model:SetAttribute("State", "carried")
	local ch = WeaponService.charOf(c)
	if ch then ch:SetAttribute("HasFlag", f.team) end
	O.carry(f.model, c, CFrame.new(-0.18 * U, -0.6 * U, 0.4 * U) * CFrame.Angles(0.18, 0, -0.12), 0.75)
	say(m, f, "NOTRE DRAPEAU EST PRIS", "DRAPEAU ENNEMI PRIS", false, if O.isPlayer(c) then c else nil, "TU AS LE DRAPEAU ! RAMÈNE-LE À TA BASE")
end
local function carrying(m: any, c: any): boolean
	for _, f in pairs(m.data.flags :: { [string]: Flag }) do if f.state == "carried" and f.carrier == c then return true end end
	return false
end

function M.setup(m: any)
	local d = m.data
	d.flags = {}; d.bot = {}
	m.score[T] = 0; m.score[CT] = 0
	local center = MS().cellToWorld(m, 20, 20)
	for _, team in ipairs({ T, CT }) do
		local home = base(m, team)
		-- la toile fait face au milieu de la carte (d'où arrivent les attaquants)
		local rot = math.atan2(center.X - home.X, center.Z - home.Z) - math.pi / 4
		local model = O.flag(m.map.folder, "CtfFlag_" .. team, home, CLOTH[team])
		model:SetAttribute("Team", team); model:SetAttribute("State", "home")
		model:PivotTo(CFrame.new(home) * CFrame.Angles(0, rot, 0))
		local ring = O.ring(m, "CtfRing_" .. team, home, R + 0.3 * U, 0.9 * U, O.COL[team], 0.95)
		d.flags[team] = { team = team, home = home, pos = home, state = "home", carrier = nil, backAt = 0, model = model, ring = ring, rot = rot } :: Flag
	end
	M.publish(m)
end
function M.publish(m: any)
	local l = {}
	for team, f in pairs(m.data.flags :: { [string]: Flag }) do
		local s = f.carrier and m.stats[MS().keyOf(f.carrier)]
		l[team] = { state = f.state, pos = f.pos, home = f.home, carrier = s and s.name, carrierUserId = if O.isPlayer(f.carrier) then f.carrier.UserId else nil,
			back = if f.state == "dropped" then math.max(0, math.ceil(f.backAt - os.clock())) else nil }
	end
	m.data.public = { kind = "ctf", flags = l }
end

function M.onKill(m: any, _killer: any, victim: any): boolean
	for _, f in pairs(m.data.flags :: { [string]: Flag }) do
		if f.state == "carried" and f.carrier == victim then drop(m, f) end
	end
	return true
end
function M.tick(m: any, _dt: number)
	local d = m.data
	for _, team in ipairs({ T, CT }) do
		local f = flagOf(m, team)
		if f.state == "carried" then
			local c = f.carrier
			local r = c and O.root(c)
			if not r then drop(m, f); continue end
			f.pos = O.feet(r)
			local own = flagOf(m, O.other(team))
			-- le porteur (de l'autre équipe) rentre chez lui avec son propre drapeau à la base : capture
			if own.state == "home" and O.flat(f.pos, own.home) < R + 0.6 * U and math.abs(f.pos.Y - own.home.Y) < 2 * U then
				local ct = own.team
				m.score[ct] = (m.score[ct] or 0) + 1
				local s = m.stats[MS().keyOf(c)]
				if s then s.pts += 1; s.score += 300 end
				local ch = WeaponService.charOf(c)
				if ch then ch:SetAttribute("HasFlag", nil) end
				setHome(m, f)
				for p in pairs(m.players) do
					local us = WeaponService.teamOf(p) == ct
					local mine = m.score[WeaponService.teamOf(p) or T] or 0
					local their = m.score[O.other(WeaponService.teamOf(p) or T)] or 0
					MS().announce(m, if us then "DRAPEAU CAPTURÉ !" else "L'ENNEMI A CAPTURÉ NOTRE DRAPEAU",
						(if p == c then "Bien joué ! " else "") .. mine .. " – " .. their, if us then O.GOOD else O.BAD, p)
				end
				d.bot = {}
			end
			continue
		end
		if f.state == "dropped" and os.clock() >= f.backAt then
			setHome(m, f)
			say(m, f, "NOTRE DRAPEAU EST REVENU", "LE DRAPEAU ENNEMI EST REVENU", true)
			continue
		end
		for _, c in ipairs(O.alive(m)) do
			local r = O.root(c) :: BasePart
			if O.flat(r.Position, f.pos) <= R and math.abs(O.feet(r).Y - f.pos.Y) <= 2 * U then
				if WeaponService.teamOf(c) ~= f.team then
					if not carrying(m, c) then take(m, f, c); break end
				elseif f.state == "dropped" then
					setHome(m, f)
					say(m, f, "DRAPEAU RÉCUPÉRÉ", "L'ENNEMI A RÉCUPÉRÉ SON DRAPEAU", true)
					if O.isPlayer(c) then O.pop(c, "Drapeau ramené", O.GOOD, "pickup") end
					local s = m.stats[MS().keyOf(c)]; if s then s.score += 100 end
					break
				end
			end
		end
	end
	M.publish(m)
end
function M.checkEnd(m: any): (boolean, any)
	for _, t in ipairs({ T, CT }) do if m.limit and (m.score[t] or 0) >= m.limit then return true, t end end
	return false, nil
end
function M.timeUp(m: any): any
	local a, b = m.score[T] or 0, m.score[CT] or 0
	return if a > b then T elseif b > a then CT else nil
end
-- botGoal du web : un tiers défend (id % 3 == 0), le reste attaque ; le porteur rentre ; tout le monde chasse le voleur
local function jitter(p: Vector3, s: number): Vector3 return p + Vector3.new((math.random() * 2 - 1) * s * U, 3, (math.random() * 2 - 1) * s * U) end
function M.botGoal(m: any, bot: Model): Vector3?
	local d = m.data
	local attr = bot:GetAttribute("Team")
	if attr ~= T and attr ~= CT then return nil end
	local team = attr :: string
	local own, foe = flagOf(m, team), flagOf(m, O.other(team))
	if not own or not foe then return nil end
	if foe.state == "carried" and foe.carrier == bot then return own.home + Vector3.new(0, 3, 0) end
	local g = d.bot[bot.Name]
	if g and os.clock() < g.t then return g.pos end
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local id = 0
	for i = 1, #bot.Name do id += string.byte(bot.Name, i) end
	local def = id % 3 == 0
	local pos, hold
	if own.state == "carried" and own.carrier and (def or math.random() < 0.6) then
		local r = O.root(own.carrier); pos = if r then r.Position else own.pos; hold = 0.8
	elseif own.state == "dropped" and (def or O.flat(own.pos, root.Position) < 28 * U) then
		pos = own.pos + Vector3.new(0, 3, 0); hold = 1.2
	elseif def then
		pos = jitter(own.home, 5); hold = 4 + math.random() * 4
	elseif foe.state == "carried" and foe.carrier then
		local r = O.root(foe.carrier); pos = jitter(if r then r.Position - Vector3.new(0, 3, 0) else foe.pos, 3); hold = 1.2
	else
		pos = foe.pos + Vector3.new(0, 3, 0); hold = 1.2
	end
	d.bot[bot.Name] = { pos = pos, t = os.clock() + hold }
	return pos
end
function M.info(m: any): any
	return { line = "Ramène le drapeau adverse — premier à " .. tostring(m.limit) .. " captures", color = Color3.fromRGB(255, 159, 67), kind = "ctf" }
end
function M.onLeave(m: any, p: Player)
	for _, f in pairs(m.data.flags or {}) do if f.state == "carried" and f.carrier == p then drop(m, f) end end
end
function M.cleanup(m: any)
	for _, f in pairs(m.data.flags or {}) do
		local ch = f.carrier and WeaponService.charOf(f.carrier)
		if ch then ch:SetAttribute("HasFlag", nil) end
		if f.model.Parent then f.model:Destroy() end
		if f.ring.Parent then f.ring:Destroy() end
	end
	m.data.flags = {}
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="441">
        <Properties>
          <string name="Name">dom</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/dom : Domination (web : src/8P_domination.js). Trois drapeaux A, B, C entre les deux bases (A et C décalés
-- sur les côtés). Reste seul dans le cercle (3,4 m) pour capturer : 5 s depuis neutre, 8 s pour retourner un drapeau
-- adverse, plus vite à plusieurs (jusqu'à ×2) ; un adversaire dans le cercle bloque la capture ; la progression
-- redescend quand personne n'y est. Chaque drapeau tenu rapporte 1 point par seconde. Les éliminations ne marquent pas.
-- Premier à la limite (100 / 200 / 300) ; à la fin du chrono (10 min), le plus de points gagne.
-- Les bots choisissent un drapeau à prendre (75 %) ou à défendre et en changent toutes les 12 à 20 s.
local WeaponService = require(script.Parent.Parent.WeaponService)
local O = require(script.Parent.objutil)

local U = O.U
local T, CT = O.T, O.CT
local R, CAP = 3.4 * U, 5
local M = {}
local function MS(): any return O.MS() end

type Flag = { n: string, pos: Vector3, owner: string?, cap: string?, prog: number, contested: boolean, ring: Model, pole: BasePart }

function M.setup(m: any)
	local d = m.data
	d.flags = {}; d.tick = 0; d.bot = {}
	m.score[T] = 0; m.score[CT] = 0
	local tx, tz = O.avg(m.map.data.spawnT or { { 10, 30 } })
	local cx2, cz2 = O.avg(m.map.data.spawnCT or { { 30, 10 } })
	for i, n in ipairs({ "A", "B", "C" }) do
		local k = ({ 0.28, 0.5, 0.72 })[i]
		local cx, cz = O.spot(m, tx + (cx2 - tx) * k, tz + (cz2 - tz) * k)
		if i ~= 2 then
			-- A et C décalés sur les côtés pour que les trois drapeaux ne soient pas alignés
			local px, pz = -(cz2 - tz), cx2 - tx
			local L = math.max(0.001, math.sqrt(px * px + pz * pz))
			local s = (if i == 1 then 1 else -1) * 7
			cx, cz = O.spot(m, cx + px / L * s, cz + pz / L * s)
		end
		local pos = O.ground(m, MS().cellToWorld(m, cx, cz))
		local ring = O.ring(m, "DomRing_" .. n, pos, R, 4.5 * U, O.WHITE, 0.92)
		local pole = O.part(ring, "Marker", Vector3.new(0.3, 0.3, 0.3), CFrame.new(pos + Vector3.new(0, 3.2 * U, 0)), O.WHITE, 1)
		O.label(pole, n, O.WHITE, 0)
		ring:SetAttribute("Flag", n)
		table.insert(d.flags, { n = n, pos = pos, owner = nil, cap = nil, prog = 0, contested = false, ring = ring, pole = pole } :: Flag)
	end
	M.publish(m)
end

local function color(f: Flag): Color3
	return if f.contested then O.CONTEST elseif f.owner then O.COL[f.owner] else O.WHITE
end
function M.publish(m: any)
	local l = {}
	for _, f in ipairs(m.data.flags :: { Flag }) do
		table.insert(l, { n = f.n, pos = f.pos, owner = f.owner, cap = f.cap, prog = f.prog, contested = f.contested })
	end
	m.data.public = { kind = "dom", flags = l, r = R }
end

function M.onKill(): boolean return true end
function M.tick(m: any, dt: number)
	local d = m.data
	for _, f in ipairs(d.flags :: { Flag }) do
		local c = { [T] = 0, [CT] = 0 }
		local inside = {}
		for _, cb in ipairs(O.alive(m)) do
			local r = O.root(cb) :: BasePart
			local team = WeaponService.teamOf(cb)
			if team and c[team] and O.flat(r.Position, f.pos) < R and math.abs(O.feet(r).Y - f.pos.Y) < 2.5 * U then
				c[team] += 1; table.insert(inside, cb)
			end
		end
		f.contested = c[T] > 0 and c[CT] > 0
		local who = if c[T] > 0 and c[CT] == 0 then T elseif c[CT] > 0 and c[T] == 0 then CT else nil
		if who and who ~= f.owner then
			if f.cap ~= who then f.cap = who; f.prog = 0 end
			f.prog += dt * math.min(2, 1 + 0.25 * (c[who] - 1)) / (if f.owner == nil then CAP else CAP * 1.6)
			if f.prog >= 1 then
				local prev = f.owner
				f.owner = who; f.prog = 0; f.cap = nil
				for p in pairs(m.players) do
					local mine = WeaponService.teamOf(p) == who
					MS().announce(m, if mine then "DRAPEAU " .. f.n .. " CAPTURÉ" else "DRAPEAU " .. f.n .. " PERDU", nil, if mine then O.GOOD else O.BAD, p)
				end
				for _, cb in ipairs(inside) do
					local s = m.stats[MS().keyOf(cb)]
					if s then s.score += 100 end
				end
				-- les défenseurs du drapeau perdu réagissent
				if prev then for name, g in pairs(d.bot) do if g.team == prev then d.bot[name] = nil end end end
			end
		elseif not who and not f.contested and f.prog > 0 then
			f.prog = math.max(0, f.prog - dt * 0.25)
		end
		O.ringColor(f.ring, color(f))
		local lab = f.pole:FindFirstChild("Label")
		local txt = lab and lab:FindFirstChild("Text") :: TextLabel?
		if txt then
			txt.TextColor3 = color(f)
			local st = txt:FindFirstChildOfClass("UIStroke"); if st then st.Color = color(f) end
		end
	end
	d.tick += dt
	while d.tick >= 1 do
		d.tick -= 1
		for _, f in ipairs(d.flags :: { Flag }) do
			if f.owner then
				m.score[f.owner] = (m.score[f.owner] or 0) + 1
			end
		end
	end
	M.publish(m)
end
function M.checkEnd(m: any): (boolean, any)
	for _, t in ipairs({ T, CT }) do if m.limit and (m.score[t] or 0) >= m.limit then return true, t end end
	return false, nil
end
function M.timeUp(m: any): any
	local a, b = m.score[T] or 0, m.score[CT] or 0
	return if a > b then T elseif b > a then CT else nil
end
-- botGoal du web : un drapeau à prendre (75 %, le plus proche 7 fois sur 10) ou à défendre, pour 12 à 20 s
function M.botGoal(m: any, bot: Model): Vector3?
	local d = m.data
	local flags = d.flags :: { Flag }
	if #flags == 0 then return nil end
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local team = bot:GetAttribute("Team")
	local g = d.bot[bot.Name]
	if not g or os.clock() > g.t then
		local mine, other = {}, {}
		for _, f in ipairs(flags) do if f.owner == team then table.insert(mine, f) else table.insert(other, f) end end
		local f: Flag
		if #other > 0 and (math.random() < 0.75 or #mine == 0) then
			table.sort(other, function(a, b) return O.flat(a.pos, root.Position) < O.flat(b.pos, root.Position) end)
			f = if math.random() < 0.7 then other[1] else other[math.random(#other)]
		else
			local l = if #mine > 0 then mine else flags
			f = l[math.random(#l)]
		end
		local s = 1.8 * U
		g = { f = f, team = team, t = os.clock() + 12 + math.random() * 8,
			pos = f.pos + Vector3.new((math.random() * 2 - 1) * s, 3, (math.random() * 2 - 1) * s) }
		d.bot[bot.Name] = g
	end
	-- un bot posté sur un drapeau tenu et calme repart de temps en temps
	if g.f.owner == team and not g.f.contested and O.flat(root.Position, g.f.pos) < R and math.random() < 0.002 then g.t = 0 end
	return g.pos
end
function M.info(m: any): any
	local parts = {}
	for _, f in ipairs(m.data.flags :: { Flag }) do
		table.insert(parts, f.n .. " " .. (if f.contested then "disputé" elseif f.owner == T then "ATT" elseif f.owner == CT then "DÉF" else "libre"))
	end
	return { line = "Capture A, B et C — premier à " .. tostring(m.limit) .. " points", sub = table.concat(parts, "   ·   "), color = Color3.fromRGB(255, 210, 58), kind = "dom" }
end
function M.cleanup(m: any)
	for _, f in ipairs(m.data.flags or {}) do if f.ring.Parent then f.ring:Destroy() end end
	m.data.flags = {}
end
return M
]]></string>
        </Properties>
      </Item>
