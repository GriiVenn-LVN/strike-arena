		{ m = "wood", p = "static", c = { -1.1800, 1.6600, 0.9000 }, s = { 0.0600, 0.1600, 4.7500 }, r = { 1.00000, -0.00000, 0.00000, -0.00000, 1.00000, 0.00000, -0.00000, -0.00000, 1.00000 } },
		{ m = "paint", p = "static", c = { 1.2000, 1.4800, 0.3000 }, s = { 0.0800, 0.6000, 0.0800 }, r = { 1.00000, 0.00000, 0.00000, -0.00000, 1.00000, -0.00000, -0.00000, -0.00000, 1.00000 } },
		{ m = "paint", p = "static", c = { 1.2000, 1.4800, 1.6000 }, s = { 0.0800, 0.6000, 0.0800 }, r = { 1.00000, 0.00000, 0.00000, -0.00000, 1.00000, -0.00000, -0.00000, 0.00000, 1.00000 } },
