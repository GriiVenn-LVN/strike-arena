      <Item class="ModuleScript" referent="226">
        <Properties>
          <string name="Name">MeshStore</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MeshStore (ModuleScript, client + Studio)
-- Roblox limite très fort la mémoire des EditableMesh / EditableImage chez le joueur (quelques maillages seulement) :
-- les modèles du web (armes, viseurs, soldats, décor des cartes) et leurs textures sont donc envoyés une fois sur Roblox
-- depuis Studio (ServerStorage/MeshUploader), et leurs numéros d'asset sont rangés dans MeshAssets.
--   meshPart(clé, fill) : MeshPart chargé depuis l'asset s'il existe, sinon construit par fill() (EditableMesh) ;
--   image(clé, fill)    : Content de l'image envoyée, sinon de l'EditableImage rendue par fill().
-- Pendant l'envoi (Studio, mode Edit), MeshStore.uploader reçoit chaque objet construit.
local AssetService = game:GetService("AssetService")

local MeshStore = {}
local okIds, ids = pcall(require, script.Parent:WaitForChild("MeshAssets", 5) :: ModuleScript)
MeshStore.ids = (if okIds and type(ids) == "table" then ids else {}) :: { [string]: number }
MeshStore.uploader = nil :: ((key: string, obj: any, kind: string) -> ())?

local OPTS = { CollisionFidelity = Enum.CollisionFidelity.Box }
-- armes et viseurs : toujours le maillage complet. En « Automatic », Roblox affiche de loin (et parfois en ViewportFrame)
-- une version simplifiée qui écrase les pièces fines (crosse, garde-main, rails) : l'arme paraît plate vue de face.
MeshStore.PRECISE = { CollisionFidelity = Enum.CollisionFidelity.Box, RenderFidelity = Enum.RenderFidelity.Precise }
local warned = false

-- CreateMeshPartAsync avec les options demandées ; si Roblox refuse une option (RenderFidelity…), on refait sans
local function create(content: Content, o: { [string]: any }): MeshPart
	if o == OPTS then return AssetService:CreateMeshPartAsync(content, OPTS) end
	local ok, mp = pcall(function() return AssetService:CreateMeshPartAsync(content, o) end)
	if ok and mp then return mp end
	return AssetService:CreateMeshPartAsync(content, OPTS)
end

function MeshStore.count(): number
	local n = 0
	for _ in pairs(MeshStore.ids) do n += 1 end
	return n
end

-- opts : options de CreateMeshPartAsync (OPTS par défaut, MeshStore.PRECISE pour les armes)
function MeshStore.meshPart(key: string, fill: () -> EditableMesh, opts: { [string]: any }?): (MeshPart, EditableMesh?)
	local o = opts or OPTS
	local id = MeshStore.ids[key]
	if id and not MeshStore.uploader then
		local ok, mp = pcall(function() return create(Content.fromUri("rbxassetid://" .. id), o) end)
		if ok and mp then return mp, nil end
		if not warned then warned = true; warn("[MeshStore] maillage envoyé illisible (" .. key .. ") : " .. tostring(mp)) end
	end
	local em = fill()
	if not em then error("mémoire des maillages pleine (CreateEditableMesh a renvoyé nil)") end
	if MeshStore.uploader and not id then (MeshStore.uploader :: any)(key, em, "mesh") end
	return create(Content.fromObject(em), o), em
end

-- fill peut renvoyer nil (API refusée) : l'appelant garde alors la couleur moyenne
function MeshStore.image(key: string, fill: () -> EditableImage?): (Content?, EditableImage?)
	local k = "i:" .. key
	local id = MeshStore.ids[k]
	if id and not MeshStore.uploader then return Content.fromUri("rbxassetid://" .. id), nil end
	local img = fill()
	if not img then return nil, nil end
	if MeshStore.uploader and not id then (MeshStore.uploader :: any)(k, img, "image") end
	return Content.fromObject(img), img
end

return MeshStore
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="227">
        <Properties>
          <string name="Name">ModeConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ModeConfig (ModuleScript)
-- Réglages du mode de jeu lancé par Main, des bots et des sons de combat.
-- Partagé client / serveur : le HUD lit les mêmes valeurs que le serveur.
local ModeConfig = {}

-- Mode de la « Partie rapide » quand le lobby est désactivé (CommunityConfig.LOBBY_ENABLED = false) ; sinon chacun choisit dans le menu
ModeConfig.MODE = "tdm"

ModeConfig.TDM = {
	map = "village",
	killsToWin = 50,           -- première équipe à 50 éliminations
	matchTime = 480,           -- 8 minutes maximum
	respawnDelay = 3,
	spawnProtection = 2,       -- secondes d'invulnérabilité après l'apparition (annulée dès qu'on tire)
	teamSize = 5,              -- 5 contre 5 : les places vides sont prises par des bots
	minHumans = 1,             -- une partie démarre dès qu'un joueur est là (les bots complètent)
	intermission = 15,         -- écran de fin puis nouvelle partie
	teams = { "Attaquants", "Défenseurs" },
	-- armes de départ : la principale peut être changée (SetLoadout) parmi les armes possédées
	loadout = {
		Attaquants = { primary = "galil", secondary = "glock" },
		["Défenseurs"] = { primary = "famas", secondary = "usp" },
	},
	scorePerKill = 100,
	scorePerAssist = 50,
	streaks = { [3] = "Série de 3", [5] = "Inarrêtable", [7] = "Déchaîné", [10] = "Légendaire" },
}

-- Viseur : pas de croix de hanche (comme sur le web), seulement un petit point central.
-- Mets false pour l'enlever aussi ; il disparaît de toute façon quand tu vises (clic droit).
ModeConfig.CENTER_DOT = true

ModeConfig.BOT = {
	names = { "Renard", "Faucon", "Loup", "Vipère", "Ours", "Lynx", "Corbeau", "Puma", "Requin", "Cobra" },
	reaction = 0.45,           -- délai avant le premier tir quand un ennemi apparaît (s)
	aimErrorDeg = 3.2,         -- imprécision de visée (degrés)
	viewDistance = 160,        -- studs
	fov = 0.25,                -- produit scalaire minimum (≈ 150° de champ de vision)
	burst = { 3, 7 },          -- balles par rafale pour les armes automatiques
	thinkRate = 0.1,           -- le cerveau des bots tourne à 10 Hz
	-- armes des bots, tirées au hasard à chaque apparition
	primaries = { "galil", "famas", "ak", "m4", "ump", "mac10", "nova" },
}

-- Sons. Les vrais sons du jeu web sont dans UN fichier, « strike-arena-sons.ogg » (fait par tools/render_sounds.js) :
-- importe-le dans le Creator Hub (Créations → Audio) et colle son numéro ici. Tant que SOUND_SHEET vaut 0,
-- les sons rbxasset:// fournis avec Roblox (champ id) servent de remplacement.
-- sheet = nom du son dans la planche (ReplicatedStorage/Shared/SoundSheet.lua).
ModeConfig.SOUND_SHEET = 99180356518561
-- Deuxième planche, réaliste (tirs en couches, pas selon le sol, recharge, impacts…) : roblox/assets/strike-arena-sons-2.ogg,
-- faite par tools/render_sounds_real.js, positions dans SoundSheet2.lua. Importe-la de la même façon et colle son numéro
-- ici ; tant qu'il vaut 0, Shared/Sfx garde la première planche.
ModeConfig.SOUND_SHEET_2 = 0
ModeConfig.SOUNDS = {
	fire = {
		pistol = { sheet = "pistol", id = "rbxasset://sounds/snap.wav", volume = 0.6, pitch = 1.25 },
		smg = { sheet = "smg", id = "rbxasset://sounds/snap.wav", volume = 0.55, pitch = 1.4 },
		rifle = { sheet = "rifle", id = "rbxasset://sounds/snap.wav", volume = 0.7, pitch = 1.0 },
		shotgun = { sheet = "shotgun", id = "rbxasset://sounds/Rocket shot.wav", volume = 0.6, pitch = 1.6 },
		sniper = { sheet = "sniper", id = "rbxasset://sounds/Rocket shot.wav", volume = 0.8, pitch = 1.2 },
		lmg = { sheet = "lmg", id = "rbxasset://sounds/snap.wav", volume = 0.65, pitch = 0.9 },
		melee = { sheet = "knife", id = "rbxasset://sounds/swordlunge.wav", volume = 0.6, pitch = 1.0 },
	},
	reload = { sheet = "reload", id = "rbxasset://sounds/clickfast.wav", volume = 0.5, pitch = 0.8 },
	empty = { sheet = "click", id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 1.6 },
	-- touches : un « clac » sourd sur le corps, un « ding » métallique à la tête, un coup grave à l'élimination
	hitBody = { sheet = "hit", id = "rbxasset://sounds/swordhit.wav", volume = 0.55, pitch = 1.5 },
	hitHead = { sheet = "hs", id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.7, pitch = 1.35 },
	kill = { sheet = "kill", id = "rbxasset://sounds/electronicpingshort.wav", volume = 0.9, pitch = 0.75 },
	hurt = { sheet = "dmg", id = "rbxasset://sounds/swordhit.wav", volume = 0.6, pitch = 0.7 },
	streak = { sheet = "round", id = "rbxasset://sounds/victory.wav", volume = 0.5, pitch = 1.1 },
	-- animations d'arme et déplacements
	magout = { sheet = "magout", id = "rbxasset://sounds/clickfast.wav", volume = 0.35, pitch = 0.7 },
	magin = { sheet = "magin", id = "rbxasset://sounds/clickfast.wav", volume = 0.45, pitch = 0.9 },
	rack = { sheet = "rack", id = "rbxasset://sounds/clickfast.wav", volume = 0.45, pitch = 1.2 },
	bolt = { sheet = "bolt", id = "rbxasset://sounds/clickfast.wav", volume = 0.45, pitch = 1.0 },
	pump = { sheet = "pump", id = "rbxasset://sounds/clickfast.wav", volume = 0.5, pitch = 0.75 },
	shellin = { sheet = "shellin", id = "rbxasset://sounds/clickfast.wav", volume = 0.3, pitch = 1.3 },
	draw = { sheet = "draw", id = "rbxasset://sounds/unsheath.wav", volume = 0.3, pitch = 1.2 },
	knife = { sheet = "knife", id = "rbxasset://sounds/swordlunge.wav", volume = 0.5, pitch = 1.0 },
	slide = { sheet = "slide" },
	land = { sheet = "land" },
	jump = { sheet = "jump" },
}

-- Réglages du mixage (lus par Sfx et AmbienceController). Les volumes réglables par le joueur passent par Sfx.setVolume.
-- MIX : niveau de base et égaliseur (dB : graves, médiums, aigus) de chaque groupe, comme l'égaliseur du jeu web
-- (graves un peu renforcés, aigus perçants adoucis).
ModeConfig.SOUNDS.MIX = {
	weapons = { vol = 1, low = 2, mid = -2.5, high = -5 },
	steps = { vol = 1, low = 1, mid = 0, high = -4 },
	ui = { vol = 1, low = 0, mid = -1, high = -3 },
	ambient = { vol = 1, low = 0, mid = 0, high = -6 },
	music = { vol = 0.7, low = 0, mid = 0, high = 0 },
}

-- Réverbération selon le lieu : decay = durée (s), wet / dry = niveau de la salle / du son direct (dB),
-- echo = écho lointain ajouté à la queue des tirs (dehors seulement : un mur ou une colline renvoie le coup).
ModeConfig.SOUNDS.ACOUSTICS = {
	lobby = { decay = 0.8, wet = -16, dry = 0, density = 0.6, diffusion = 0.5 },
	open = { decay = 0.7, wet = -18, dry = 0, density = 0.5, diffusion = 0.4, echo = { delay = 0.34, feedback = 0.3, wet = -10 } },
	town = { decay = 1.0, wet = -14, dry = 0, density = 0.7, diffusion = 0.6, echo = { delay = 0.22, feedback = 0.35, wet = -9 } },
	snow = { decay = 0.6, wet = -20, dry = 0, density = 0.4, diffusion = 0.3, echo = { delay = 0.45, feedback = 0.25, wet = -13 } },
	forest = { decay = 1.1, wet = -15, dry = 0, density = 0.9, diffusion = 1, echo = { delay = 0.28, feedback = 0.3, wet = -12 } },
	covered = { decay = 1.2, wet = -9, dry = 0, density = 0.8, diffusion = 0.7, indoor = true },
	hall = { decay = 1.9, wet = -8, dry = 0, density = 0.8, diffusion = 0.8, indoor = true },
	tunnel = { decay = 2.6, wet = -6, dry = -1, density = 0.9, diffusion = 0.7, indoor = true },
	lab = { decay = 1.3, wet = -9, dry = 0, density = 1, diffusion = 0.9, indoor = true },
	stone = { decay = 2.0, wet = -7, dry = 0, density = 0.7, diffusion = 0.6, indoor = true },
}

-- Fonds sonores en boucle (sons fournis avec Roblox) : rate = vitesse de lecture (plus bas = plus grave),
-- vol = volume, high / mid = égaliseur (dB), gust = force des rafales (variation lente du volume, 0 = constant).
ModeConfig.SOUNDS.AMBIENCE = {
	wind = { { id = "rbxasset://sounds/action_falling.mp3", rate = 0.45, vol = 0.16, high = -14, mid = -3, gust = 0.4 } },
	windSoft = { { id = "rbxasset://sounds/action_falling.mp3", rate = 0.38, vol = 0.1, high = -18, mid = -4, gust = 0.3 } },
	windStrong = { { id = "rbxasset://sounds/action_falling.mp3", rate = 0.52, vol = 0.24, high = -10, mid = -2, gust = 0.55 } },
	hum = { { id = "rbxasset://sounds/action_falling.mp3", rate = 0.22, vol = 0.11, high = -30, mid = -6, gust = 0.06 } },
	harbor = {
		{ id = "rbxasset://sounds/action_falling.mp3", rate = 0.42, vol = 0.12, high = -16, mid = -3, gust = 0.4 },
		{ id = "rbxasset://sounds/action_swim.mp3", rate = 0.55, vol = 0.07, high = -12, mid = -2, gust = 0.5 },
	},
	haunt = { { id = "rbxasset://sounds/action_falling.mp3", rate = 0.3, vol = 0.13, high = -20, mid = -4, gust = 0.65 } },
}

-- Cartes : out = acoustique à l'air libre, inn = sous un toit (plafond détecté au-dessus de la caméra),
-- floor / raised = sol de la carte / dessus des caisses, plateformes et rampes, ambience = fond sonore (AMBIENCE).
ModeConfig.SOUNDS.MAPS = {
	village = { out = "town", inn = "covered", floor = "sand", raised = "stone", ambience = "wind" },
	warehouse = { out = "town", inn = "hall", floor = "stone", raised = "metal", ambience = "hum" },
	station = { out = "snow", inn = "covered", floor = "snow", raised = "snow", ambience = "windStrong" },
	harbor = { out = "town", inn = "covered", floor = "stone", raised = "metal", ambience = "harbor" },
	metro = { out = "tunnel", inn = "tunnel", floor = "stone", raised = "metal", ambience = "hum" },
	jungle = { out = "forest", inn = "stone", floor = "grass", raised = "stone", ambience = "windSoft" },
	range = { out = "town", inn = "hall", floor = "stone", raised = "metal", ambience = "hum" },
	labo = { out = "lab", inn = "lab", floor = "stone", raised = "metal", ambience = "hum" },
	asile = { out = "open", inn = "stone", floor = "sand", raised = "wood", ambience = "haunt" },
	manoir = { out = "open", inn = "stone", floor = "sand", raised = "wood", ambience = "haunt" },
}

-- Pas : couches jouées pour un pas sur chaque sol (sheet = son de la planche, rate = vitesse, vol = volume,
-- delay = décalage en s). Le volume se donne comme pour sfx('step') du web (0,28 en marchant, 0,36 en sprint).
ModeConfig.SOUNDS.STEPS = {
	sand = { { sheet = "jump", rate = 0.93, vol = 1.7 } },
	grass = { { sheet = "jump", rate = 0.85, vol = 1.5 } },
	snow = { { sheet = "jump", rate = 0.72, vol = 1.45 }, { sheet = "slide", rate = 2.2, vol = 0.12 } },
	stone = { { sheet = "jump", rate = 1.75, vol = 1.5 } },
	wood = { { sheet = "jump", rate = 1.25, vol = 1.5 }, { sheet = "land", rate = 1.9, vol = 0.25 } },
	metal = { { sheet = "jump", rate = 2.1, vol = 1.6 }, { sheet = "shellin", rate = 0.6, vol = 0.55, delay = 0.01 } },
}

return ModeConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="228">
        <Properties>
          <string name="Name">Modes</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Modes (ModuleScript, client + serveur)
-- Les modes de jeu, les cartes et les niveaux de bots du jeu web (src/10_core.js MODES, DIFFS ; src/87_nav.js
-- MODE_GROUPS / MODE_TAG ; src/87b_playui.js mapsFor ; src/85_menu.js réglages de l'écran « Jouer »).
-- Le menu (MainMenu) lit ces tables pour afficher les tuiles ; MatchService les lit pour lancer la partie.
local Modes = {}

export type ModeDef = {
	id: string, n: string, ic: string, c: Color3, team: boolean, respawn: number?, desc: string,
	limitLabel: string, limits: { number }, tag: string, time: number?, bomb: boolean?,
}

local function rgb(hex: number): Color3
	return Color3.fromRGB(bit32.rshift(hex, 16), bit32.band(bit32.rshift(hex, 8), 255), bit32.band(hex, 255))
end

-- time = durée de la partie en secondes (web : DM_TIME = 480 s, RTIME des variantes) ; nil = pas de chrono global
-- (Capture de zone et Domination : 10 min par défaut sur le web, RTIME.koth / RTIME.dom)
Modes.LIST = {
	bomb = { n = "Compétitif", ic = "💣", c = rgb(0xff4655), team = true, bomb = true, desc = "Pose ou désamorce la bombe. Économie, boutique, manches.", limitLabel = "Manches pour gagner", limits = { 3, 5, 7, 13 }, tag = "Bombe · économie · manches" },
	rapid = { n = "Désamorçage rapide", ic = "⚡", c = rgb(0xffd23a), team = true, bomb = true, desc = "Manches de 45 s, armes fournies, bombe dès le début. Pur gunfight.", limitLabel = "Manches pour gagner", limits = { 5, 7, 9 }, tag = "Manches courtes, armes fournies" },
	duel = { n = "Duel", ic = "🤺", c = rgb(0xff7ad9), team = true, desc = "Manches courtes sans bombe ni réapparition. Choisis ton arme, élimine l'adversaire. Premier à 5.", limitLabel = "Manches pour gagner", limits = { 3, 5, 7 }, tag = "Manches courtes, 1 v 1 à 5 v 5, sans bombe" },
	gunfight = { n = "Gunfight", ic = "🔫", c = rgb(0x5ad1ff), team = true, desc = "2 contre 2 (de 1 v 1 à 4 v 4), manches de 40 s sans réapparition. Tout le monde a les MÊMES armes, tirées au sort toutes les 2 manches. Pas de boutique : seul le talent compte.", limitLabel = "Manches pour gagner", limits = { 4, 6, 8 }, tag = "Mêmes armes pour tous, 2 v 2" },
	tdm = { n = "Match à mort par équipe", ic = "⚔", c = rgb(0x4aa3ff), team = true, respawn = 3, desc = "Deux équipes, réapparition rapide. Premier à atteindre le score.", limitLabel = "Éliminations pour gagner", limits = { 20, 30, 40, 60 }, tag = "Équipes, réapparition", time = 480 },
	survolte = { n = "Survolté", ic = "⏱", c = rgb(0xff5ad1), team = true, respawn = 3, desc = "Match à mort par équipe sous tension : après une élimination tu es SURVOLTÉ (tu cours 20 % plus vite) mais tu as 30 s pour éliminer à nouveau, sinon tu exploses !", limitLabel = "Éliminations pour gagner", limits = { 25, 40, 60 }, tag = "Élimine toutes les 30 s ou explose", time = 480 },
	ffa = { n = "Match à mort", ic = "☠", c = rgb(0xffb938), team = false, respawn = 2, desc = "Chacun pour soi. Le meilleur score gagne.", limitLabel = "Éliminations pour gagner", limits = { 15, 25, 35 }, tag = "Chacun pour soi", time = 480 },
	gg = { n = "Course aux armes", ic = "🔫", c = rgb(0x7dff9f), team = false, respawn = 1.5, desc = "Chaque élimination change ton arme. Termine avec le couteau.", limitLabel = "Niveaux", limits = {}, tag = "Une arme par élimination", time = 480 },
	koth = { n = "Capture de zone", ic = "🚩", c = rgb(0x35e0c0), team = true, respawn = 3, desc = "Tiens la zone qui change de place pour marquer des points.", limitLabel = "Points pour gagner", limits = { 100, 200, 300 }, tag = "Tiens la zone", time = 600 },
	dom = { n = "Domination", ic = "🏳", c = rgb(0xffd23a), team = true, respawn = 3, desc = "Trois drapeaux A, B, C à capturer et à tenir. Chaque drapeau tenu rapporte des points.", limitLabel = "Points pour gagner", limits = { 100, 200, 300 }, tag = "Tiens A, B et C", time = 600 },
	kc = { n = "Élimination confirmée", ic = "🏷", c = rgb(0xffcf4a), team = true, respawn = 3, desc = "Chaque adversaire éliminé lâche une plaque : ramasse-la pour marquer. Ramasse celles de tes alliés pour priver l'adversaire du point.", limitLabel = "Plaques pour gagner", limits = { 30, 50, 75 }, tag = "Ramasse les plaques pour marquer", time = 480 },
	ctf = { n = "Capture du drapeau", ic = "🚩", c = rgb(0xff9f43), team = true, respawn = 3, desc = "Va prendre le drapeau adverse et ramène-le dans ta base. Ton drapeau doit être chez toi pour marquer.", limitLabel = "Captures pour gagner", limits = { 3, 5, 7 }, tag = "Ramène le drapeau adverse", time = 600 },
	shp = { n = "Arme tournante", ic = "🎲", c = rgb(0xffa94d), team = false, respawn = 2, desc = "Tout le monde a la même arme, tirée au sort toutes les 30 secondes. Adapte-toi vite !", limitLabel = "Éliminations pour gagner", limits = { 15, 25, 35 }, tag = "Même arme pour tous, elle change", time = 480 },
	zombies = { n = "Zombies (coop)", ic = "🧟", c = rgb(0x8fd14f), team = true, respawn = 0, desc = "Façon Black Ops : points, armes aux murs, boîte mystère, atouts, Forge Arcane et armes prodiges.", limitLabel = "Manches à survivre", limits = { 10, 15, 25, 99 }, tag = "Coop contre des vagues" },
	inf = { n = "Infecté", ic = "☣", c = rgb(0x9dff5a), team = true, respawn = 2.5, desc = "Un joueur commence infecté. Chaque survivant tué rejoint les infectés. Tiens jusqu'à la fin du chrono.", limitLabel = "", limits = {}, tag = "Survis aux infectés", time = 300 },
	jug = { n = "Mastodonte", ic = "🛡", c = rgb(0xff5a3c), team = false, respawn = 2, desc = "Le premier à éliminer devient le Mastodonte : 400 PV et une mitrailleuse. Lui seul marque des points. Élimine-le pour prendre sa place.", limitLabel = "Points pour gagner", limits = { 25, 40, 60 }, tag = "Deviens le Mastodonte et tiens", time = 480 },
	br = { n = "Bataille royale", ic = "🌀", c = rgb(0xc77dff), team = false, respawn = 0, desc = "Un seul survivant. Ramasse des armes, évite la zone qui se resserre.", limitLabel = "", limits = {}, tag = "Un seul survivant" },
	train = { n = "Entraînement", ic = "🎯", c = rgb(0xff9a3a), team = false, respawn = 1, desc = "Cibles mobiles, chronomètre 60 s. Mesure précision et réflexes.", limitLabel = "", limits = {}, tag = "Stand de tir, sans limite de temps" },
} :: { [string]: ModeDef }
for id, m in pairs(Modes.LIST) do m.id = id end

-- ordre des tuiles de l'écran « Jouer » (MODE_GROUPS du web, avec les modes ajoutés par les extensions)
Modes.GROUPS = ({
	{ "Compétitif", { "bomb", "rapid", "duel", "gunfight" } },
	{ "Action", { "tdm", "ffa", "gg", "koth", "dom", "kc", "ctf", "shp", "survolte" } },
	{ "Spécial", { "zombies", "inf", "jug", "br", "train" } },
} :: any) :: { { any } }

-- Mode de la semaine (FEATURED_ROT du web, src/8D_matchflow.js) : XP ×2, change chaque lundi
Modes.FEATURED_ROT = { "duel", "gg", "koth", "rapid", "ffa", "tdm", "br" }
function Modes.featured(): string
	local week = math.floor((math.floor(os.time() / 86400) + 3) / 7)
	return Modes.FEATURED_ROT[week % #Modes.FEATURED_ROT + 1]
end

-- Partie rapide : modes tirés au hasard (QUICK_MODES du web)
Modes.QUICK = { "tdm", "ffa", "gg", "koth", "duel", "rapid", "dom", "kc", "ctf", "shp", "gunfight", "survolte" }

-- Cartes, dans l'ordre du web (MAPS) ; zombie = réservée au mode Zombies
Modes.MAPS = {
	{ id = "village", n = "Village", theme = "sand", desc = "Un village ocre avec toits-terrasses, ruelles étroites, un grand couloir ouvert côté A, un souk couvert côté B et des nids de sniper en hauteur." },
	{ id = "warehouse", n = "Entrepôt", theme = "industrial", desc = "Un dépôt logistique : grande halle de conteneurs, mezzanines, zone de stockage ouest (A) et salle de contrôle sur plateforme à l'est (B)." },
	{ id = "station", n = "Station polaire", theme = "snow", desc = "Un avant-poste de recherche enneigé : base CT sur plateau, hangar à l'ouest (A), salle des générateurs à l'est (B), étang gelé au centre, tour de guet et passerelle en hauteur." },
	{ id = "harbor", n = "Port de nuit", theme = "night", desc = "Un port industriel éclairé aux projecteurs : piles de conteneurs, grutier en hauteur, entrepôt couvert à l'est (B) et quai ouvert à l'ouest (A)." },
	{ id = "metro", n = "Métro", theme = "metro", desc = "Une station souterraine : salle de contrôle des CT, quais surélevés, rames à l'arrêt sur les voies et deux grands halls (A à l'ouest, B à l'est). Tout est couvert." },
	{ id = "jungle", n = "Temple perdu", theme = "jungle", desc = "Des ruines envahies par la jungle : pyramide à gradins au centre (contrôle du milieu), temple couvert côté B, cour aux colonnes côté A." },
	{ id = "range", n = "Stand de tir", theme = "range", desc = "Terrain d'entraînement : cibles fixes, mobiles et surgissantes à toutes les distances, nid de sniper et couvertures pour tester armes et skins." },
	{ id = "labo", n = "Laboratoire", theme = "night", desc = "Un laboratoire abandonné, de nuit : on démarre dans le hall, puis on dégage les débris pour ouvrir la salle des machines, l'infirmerie et le grand labo. Idéal pour les Zombies." },
	{ id = "asile", n = "Asile hanté", theme = "haunt", zombie = true, desc = "Carte Zombies : un asile abandonné une nuit d'orage. On démarre dans la chapelle, puis on dégage les barricades vers le cimetière, le jardin, l'aile des malades et son clocher, l'infirmerie et la crypte." },
	{ id = "manoir", n = "Manoir hanté", theme = "halloween", desc = "Carte d'Halloween : le manoir Ravenhollow une nuit de pleine lune. Site A dans le cimetière, site B sous la grange de la sorcière, le manoir au centre, l'allée des sorcières à l'ouest, le champ de citrouilles à l'est et la fête foraine au sud." },
}
Modes.MAP = {} :: { [string]: any }
for i, m in ipairs(Modes.MAPS) do m.index = i; Modes.MAP[m.id] = m end

-- cartes proposées pour chaque mode (mapsFor du web) : Zombies = Asile, Entraînement = Stand de tir
function Modes.mapsFor(mode: string): { string }
	if mode == "zombies" then return { "asile" } end
	if mode == "train" then return { "range" } end
	local list = {}
	for _, m in ipairs(Modes.MAPS) do if not m.zombie and m.id ~= "range" then table.insert(list, m.id) end end
	return list
end

-- niveaux des bots (DIFFS du web) : react = temps de réaction (s), spread = imprécision (degrés), aimHead = part de tirs à la tête,
-- speed = vitesse, strafe = esquive latérale, hear = ouïe, dmg = dégâts, sight = portée de vue (m), b = rafales, nade = grenades
Modes.DIFFS = {
	{ n = "Novice", react = 1.25, spread = 10, aimHead = 0, speed = 0.78, strafe = 0, hear = 0.2, dmg = 0.55, sight = 40, bmin = 2, bmax = 5, nade = 0.2, desc = "Pour découvrir le jeu : réagit lentement, vise très mal, fait peu de dégâts. En Zombies : zombies lents et fragiles." },
	{ n = "Facile", react = 0.8, spread = 6, aimHead = 0.02, speed = 0.86, strafe = 0.1, hear = 0.4, dmg = 0.8, sight = 55, bmin = 3, bmax = 7, nade = 0.4, desc = "Un adversaire facile à battre, tire en rafales imprécises. En Zombies : zombies moins forts et moins nombreux." },
	{ n = "Normal", react = 0.45, spread = 3, aimHead = 0.12, speed = 0.95, strafe = 0.45, hear = 0.7, dmg = 1, sight = 70, bmin = 4, bmax = 9, nade = 0.6, desc = "Équilibré : se déplace, entend les tirs, vise correctement." },
	{ n = "Pro", react = 0.26, spread = 1.6, aimHead = 0.3, speed = 1, strafe = 0.8, hear = 0.9, dmg = 1, sight = 90, bmin = 5, bmax = 12, nade = 0.8, desc = "Réflexes rapides, strafe + arrêt pour tirer, vise la tête." },
	{ n = "Légende", react = 0.13, spread = 0.75, aimHead = 0.55, speed = 1.05, strafe = 1, hear = 1, dmg = 1.05, sight = 110, bmin = 6, bmax = 16, nade = 1, desc = "Réaction quasi instantanée, headshots constants, grenades utiles." },
}

-- modificateurs de partie (src/8Y_mutators.js), cumulables, pour les parties contre les bots
Modes.MUTATORS = {
	{ k = "lune", ic = "🌙", n = "Gravité lunaire", d = "Sauts géants, chute lente" },
	{ k = "turbo", ic = "⚡", n = "Turbo", d = "Tout le monde court 30 % plus vite" },
	{ k = "tetes", ic = "🎯", n = "Têtes seulement", d = "Seuls les tirs à la tête blessent" },
	{ k = "balle", ic = "💥", n = "Une balle", d = "Chaque touche élimine" },
	{ k = "vamp", ic = "🦇", n = "Vampire", d = "Chaque élimination rend 50 PV" },
	{ k = "nades", ic = "💣", n = "Grenades à volonté", d = "Une grenade revient toutes les 5 s" },
}

-- boutique des modes à manches (Compétitif, Désamorçage rapide, Duel) : CATS et renderBuy du web (src/10_core.js, src/80_ui.js)
-- prix des armes : Config.WEAPONS[k].price ; équipement : prix du web (buyItem)
Modes.BUY_CATS = {
	{ n = "Pistolets", list = { "glock", "usp", "p250", "fiveseven", "deagle" } },
	{ n = "SMG", list = { "mac10", "mp9", "ump", "p90" } },
	{ n = "Pompes", list = { "nova", "sawedoff", "xm" } },
	{ n = "Fusils", list = { "galil", "famas", "ak", "m4", "sg553", "aug" } },
	{ n = "Snipers", list = { "ssg", "awp", "scar" } },
	{ n = "Lourd", list = { "negev", "m249" } },
}
Modes.BUY_ITEMS = {
	{ k = "armor", n = "Gilet pare-balles", price = 650 },
	{ k = "shield1", n = "Bouclier léger (+25)", price = 400 },
	{ k = "shield2", n = "Bouclier lourd (+50)", price = 1000 },
	{ k = "kit", n = "Kit de désamorçage", price = 400, ct = true },
	{ k = "frag", n = "Grenade frag (G)", price = 300 },
	{ k = "flash", n = "Flashbang (F) ×2", price = 200 },
	{ k = "smoke", n = "Fumigène (H)", price = 300 },
	{ k = "mine", n = "Mine de proximité (X) — max 2", price = 350 },
}

-- réglages possibles de l'écran « Jouer » (src/85_menu.js)
function Modes.sizes(mode: string): { number }
	local m = Modes.LIST[mode]
	if mode == "duel" then return { 1, 2, 3, 4, 5 } end
	if mode == "gunfight" then return { 1, 2, 3, 4 } end
	if m and m.team then
		local mx = if mode == "bomb" or mode == "rapid" then 5 else 8
		local l = {}; for i = 1, mx do l[i] = i end
		return l
	end
	return { 4, 6, 8, 10, 12 }
end
function Modes.defaultLimit(mode: string): number?
	local l = Modes.LIST[mode] and Modes.LIST[mode].limits or {}
	if #l == 0 then return nil end
	if mode == "bomb" then return 5 end
	return l[math.floor(#l / 2) + 1]
end

-- réglages d'une partie, vérifiés (le client peut envoyer n'importe quoi)
export type Settings = { mode: string, map: string, diff: number, size: number, limit: number?, side: string, eco: number, private: boolean, mut: { [string]: boolean }, ranked: boolean }
function Modes.sanitize(s: any): Settings
	local t = if typeof(s) == "table" then s else {}
	local mode = if typeof(t.mode) == "string" and Modes.LIST[t.mode] then t.mode else "tdm"
	local maps = Modes.mapsFor(mode)
	local map = if typeof(t.map) == "string" and table.find(maps, t.map) then t.map else maps[1]
	local diff = if typeof(t.diff) == "number" and t.diff == t.diff then math.clamp(math.floor(t.diff), 1, #Modes.DIFFS) else 3   -- NaN refusé
	local sizes = Modes.sizes(mode)
	local size = if typeof(t.size) == "number" and table.find(sizes, t.size) then t.size
		elseif mode == "duel" then 1                       -- web : 1 v 1 par défaut (cfg.duelSize)
		elseif mode == "gunfight" then 2                   -- Gunfight : 2 v 2 comme Call of Duty
		else (if Modes.LIST[mode].team then math.min(5, sizes[#sizes]) else 8)
	local lims = Modes.LIST[mode].limits
	local limit = if typeof(t.limit) == "number" and table.find(lims, t.limit) then t.limit else Modes.defaultLimit(mode)
	local side = if t.side == "t" or t.side == "ct" then t.side else "rnd"
	local eco = if t.eco == 0 then 0 else 1
	local mut = {}
	if typeof(t.mut) == "table" then
		for _, m in ipairs(Modes.MUTATORS) do if t.mut[m.k] == true then mut[m.k] = true end end
	end
	-- ranked : partie classée (web : cfg.ranked, src/66_progress.js) ; ne compte que dans RANKED_MODES, sans modificateur
	return { mode = mode, map = map, diff = diff, size = size, limit = limit, side = side, eco = eco, private = t.private == true, mut = mut, ranked = t.ranked == true }
end

return Modes
]]></string>
        </Properties>
      </Item>
