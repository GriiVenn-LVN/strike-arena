      </Item>
      <Item class="ModuleScript" referent="444">
        <Properties>
          <string name="Name">gg</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/gg : Course aux armes (web : GG_LADDER, ggKill, ggEquip dans src/60_game.js).
-- Chacun pour soi : chaque élimination fait passer à l'arme suivante de l'échelle ; une élimination au couteau fait
-- reculer la victime d'un niveau. Le premier qui élimine avec le couteau (dernier niveau) gagne.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local WeaponService = require(script.Parent.Parent.WeaponService)

local LADDER = { "glock", "p250", "fiveseven", "deagle", "mac10", "mp9", "ump", "nova", "xm", "galil", "famas", "ak", "m4", "sg553", "ssg", "awp", "knife" }

local M = {}
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end
local function alive(c: any): boolean
	local ch = WeaponService.charOf(c)
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0
end
local function levelOf(m: any, c: any): number
	m.data.lvl = m.data.lvl or {}
	return m.data.lvl[MS().keyOf(c)] or 1
end
local function setLevel(m: any, c: any, n: number)
	m.data.lvl[MS().keyOf(c)] = n
	local s = m.stats[MS().keyOf(c)]
	if s then s.pts = n end
	if typeof(c) == "Instance" and c:IsA("Player") then
		local key = LADDER[n]
		c:SetAttribute("ModeLine", "Niveau " .. n .. " / " .. #LADDER .. " — " .. (Config.WEAPONS[key] and Config.WEAPONS[key].name or key))
	end
end
local function equip(c: any, n: number)
	local key = LADDER[n]
	WeaponService.giveLoadout(c, if key == "knife" then { "knife" } else { key, "knife" })
	WeaponService.setReserve(c, key, 999)
end

function M.setup(m: any) m.data.lvl = {}; m.limit = #LADDER end
function M.loadout(m: any, c: any): { string }
	local n = levelOf(m, c)
	setLevel(m, c, n)
	local key = LADDER[n]
	return if key == "knife" then { "knife" } else { key, "knife" }
end
function M.onSpawn(_m: any, c: any) task.defer(function() local s = WeaponService.current(c); if s then WeaponService.setReserve(c, s, 999) end end) end

function M.onKill(m: any, killer: any, victim: any, key: string, _hs: boolean, ks: any, vs: any): boolean
	if not ks or ks == vs then return true end
	local n = levelOf(m, killer)
	if n >= #LADDER then
		m.data.winner = ks
		return true
	end
	setLevel(m, killer, n + 1)
	if alive(killer) then equip(killer, n + 1) end
	if typeof(killer) == "Instance" and killer:IsA("Player") then
		local nk = LADDER[n + 1]
		MS().announce(m, "NIVEAU " .. (n + 1) .. " / " .. #LADDER, Config.WEAPONS[nk] and Config.WEAPONS[nk].name or nk, Color3.fromRGB(125, 255, 159), killer)
	end
	if Config.WEAPONS[key] and Config.WEAPONS[key].melee then
		local vn = levelOf(m, victim)
		if vn > 1 then
			setLevel(m, victim, vn - 1)
			if typeof(victim) == "Instance" and victim:IsA("Player") then MS().announce(m, "RÉTROGRADÉ", "par un coup de couteau !", Color3.fromRGB(255, 90, 90), victim) end
		end
	end
	m.score[ks.key] = levelOf(m, killer)
	return true
end

function M.checkEnd(m: any): (boolean, any)
	if m.data.winner then return true, m.data.winner end
	return false, nil
end
function M.timeUp(m: any): any
	local best, bl, bk = nil, -1, -1
	for k, s in pairs(m.stats) do
		local l = m.data.lvl[k] or 1
		if l > bl or (l == bl and s.k > bk) then best, bl, bk = s, l, s.k end
	end
	return best
end
function M.info(m: any): any
	local best, bl = nil, 0
	for k, s in pairs(m.stats) do local l = m.data.lvl[k] or 1; if l > bl then best, bl = s, l end end
	return { line = "Course aux armes", sub = if best then "En tête : " .. best.name .. " (niveau " .. bl .. " / " .. #LADDER .. ")" else nil, color = Color3.fromRGB(125, 255, 159) }
end
function M.cleanup(m: any)
	for p in pairs(m.players) do p:SetAttribute("ModeLine", nil) end
end
function M.onLeave(_m: any, p: Player) p:SetAttribute("ModeLine", nil) end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="445">
        <Properties>
          <string name="Name">gunfight</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/gunfight : Gunfight (Call of Duty), 1 v 1 à 4 v 4 (2 v 2 par défaut) : manches de 40 s sans bombe ni réapparition,
-- 5 s de préparation, pas de boutique : tout le monde reçoit les MÊMES armes (principale + pistolet + grenade ou flash),
-- tirées au sort toutes les 2 manches. Positions révélées à 15 s de la fin ; au temps, l'équipe avec le plus de survivants
-- puis le plus de points de vie gagne la manche. Premier à 6 manches par défaut. Toutes les règles sont dans Modes/rounds.
return require(script.Parent.rounds).make("gunfight")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="446">
        <Properties>
          <string name="Name">inf</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/inf : Infecté (web : src/8Q_infecte.js). Tout le monde commence survivant (armes normales) dans l'équipe
-- « Défenseurs » ; quelques secondes après le début, un joueur au hasard devient l'infecté (équipe « Attaquants ») :
-- couteau seulement, plus rapide, halo vert, réapparaît. Chaque survivant tué rejoint les infectés. Les infectés gagnent
-- s'il ne reste plus de survivant ; les survivants gagnent s'il en reste au moins un à la fin du chrono (5 min).
-- Les bots infectés foncent au couteau sur le survivant le plus proche.
local WeaponService = require(script.Parent.Parent.WeaponService)

local SURV, INF = "Défenseurs", "Attaquants"
local GREEN = Color3.fromRGB(157, 255, 90)
local M = {}
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end

local function look(c: any)
	local ch = WeaponService.charOf(c)
	if not ch or ch:FindFirstChild("InfGlow") then return end
	local hl = Instance.new("Highlight"); hl.Name = "InfGlow"; hl.FillColor = GREEN; hl.FillTransparency = 0.55; hl.OutlineColor = GREEN; hl.Parent = ch
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum then hum.WalkSpeed = 16 * 1.12 end
end
local function arm(c: any)
	if not MS().aliveChar(c) then return end
	WeaponService.giveLoadout(c, { "knife" })
	WeaponService.setReduction(c, 0)
	look(c)
end
local function turn(m: any, c: any, first: boolean)
	MS().setTeam(m, c, INF)
	arm(c)
	local s = m.stats[MS().keyOf(c)]
	local isP = typeof(c) == "Instance" and c:IsA("Player")
	if first then
		for p in pairs(m.players) do
			if p == c then MS().announce(m, "TU ES L'INFECTÉ", "Contamine tout le monde au couteau", GREEN, p)
			else MS().announce(m, string.upper(s and s.name or "?") .. " EST INFECTÉ", "Survis jusqu'à la fin du chrono", GREEN, p) end
		end
	elseif isP then
		MS().announce(m, "TU ES INFECTÉ", "Contamine les survivants", GREEN, c)
	end
end
local function count(m: any): (number, number)
	local s, i = 0, 0
	for _, c in ipairs(MS().combatants(m)) do
		if WeaponService.teamOf(c) == INF then i += 1 else s += 1 end
	end
	m.score[SURV] = s; m.score[INF] = i
	return s, i
end

function M.setup(m: any) m.data.started = false; m.data.startAt = math.huge; m.limit = nil end
function M.teamFor(m: any, _c: any): string? return if m.data.started then INF else SURV end
function M.start(m: any) m.data.startAt = os.clock() + 5 end
function M.loadout(m: any, c: any): { string }?
	if WeaponService.teamOf(c) == INF then return { "knife" } end
	return nil
end
function M.onSpawn(_m: any, c: any) if WeaponService.teamOf(c) == INF then task.defer(look, c) end end
function M.onKill(m: any, _killer: any, victim: any, _key: string, _hs: boolean, ks: any, vs: any): boolean
	if vs.team == SURV and m.data.started then
		MS().setTeam(m, victim, INF)
		if victim:IsA("Player") then MS().announce(m, "TU ES INFECTÉ", "Contamine les survivants", GREEN, victim) end
		if ks and ks.player and ks ~= vs then ks.pts += 1 end
	end
	if ks and ks.team == SURV and ks ~= vs then ks.pts += 1 end
	count(m)
	return true
end
function M.tick(m: any, _dt: number)
	if not m.data.started and os.clock() >= m.data.startAt then
		m.data.started = true
		local alive = {}
		for _, c in ipairs(MS().combatants(m)) do if MS().aliveChar(c) then table.insert(alive, c) end end
		if #alive > 0 then turn(m, alive[math.random(#alive)], true) end
	end
	count(m)
end
-- les infectés n'ont pas de bots en plus : l'équipe des survivants est complétée, les bots infectés viennent des contaminés
function M.botsWanted(m: any, team: string?, want: number): number?
	if m.data.started then return nil end      -- après le début, les bots ne changent plus (les contaminés réapparaissent)
	if team == INF then return 0 end
	-- tout le monde commence survivant : l'équipe des survivants reçoit les places des deux équipes
	return want + math.max(0, m.settings.size - 0)
end
function M.botRespawn(_m: any, _s: any): boolean return true end
function M.checkEnd(m: any): (boolean, any)
	if not m.data.started then return false, nil end
	local s = count(m)
	if s == 0 then return true, INF end
	return false, nil
end
function M.timeUp(m: any): any
	local s = count(m)
	return if s > 0 then SURV else INF
end
function M.botGoal(m: any, bot: Model): Vector3?
	if bot:GetAttribute("Team") ~= INF then return nil end
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return nil end
	local best, bd = nil, math.huge
	for _, c in ipairs(MS().combatants(m)) do
		if WeaponService.teamOf(c) == SURV then
			local ch = MS().aliveChar(c)
			local r = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r and (r.Position - root.Position).Magnitude < bd then best, bd = r.Position, (r.Position - root.Position).Magnitude end
		end
	end
	return best
end
function M.info(m: any): any
	local s, i = count(m)
	if not m.data.started then return { line = "Un joueur va être infecté… survis jusqu'à la fin", color = GREEN } end
	return { line = "☣ " .. s .. " survivant" .. (if s > 1 then "s" else "") .. " · " .. i .. " infecté" .. (if i > 1 then "s" else ""), color = GREEN }
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="447">
        <Properties>
          <string name="Name">jug</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/jug : Mastodonte (web : src/8X_mastodonte.js). Chacun pour soi : le premier qui élimine devient le Mastodonte
-- (400 PV, gilet, M249 à réserve illimitée, halo rouge). Seul le Mastodonte marque : +1 par élimination et +1 toutes les
-- 5 s. Celui qui l'élimine prend sa place. Premier à la limite (25 / 40 / 60) ; à la fin du chrono, le meilleur score gagne.
-- Les bots chassent le Mastodonte.
local WeaponService = require(script.Parent.Parent.WeaponService)

local HP, WPN = 400, "m249"
local M = {}
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end

local function look(c: any, on: boolean)
	local ch = WeaponService.charOf(c)
	if not ch then return end
	local h = ch:FindFirstChild("JugGlow")
	if on and not h then
		local hl = Instance.new("Highlight"); hl.Name = "JugGlow"; hl.FillColor = Color3.fromRGB(255, 58, 42); hl.FillTransparency = 0.6
		hl.OutlineColor = Color3.fromRGB(255, 120, 60); hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop; hl.Parent = ch
	elseif not on and h then h:Destroy() end
	ch:SetAttribute("Jug", if on then true else nil)
end
local function point(m: any, c: any, n: number)
	local k = MS().keyOf(c)
	m.score[k] = (m.score[k] or 0) + n
	local s = m.stats[k]; if s then s.pts = m.score[k] end
end
local function make(m: any, c: any, s: any)
	local prev = m.data.who
	if prev and prev ~= c then look(prev, false) end
	m.data.who = c; m.data.whoName = s and s.name; m.data.tick = 0
	local ch = MS().aliveChar(c)
	if not ch then return end
	local hum = ch:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.MaxHealth = HP; hum.Health = HP
	WeaponService.giveLoadout(c, { WPN, "knife" })
	WeaponService.setReserve(c, WPN, 999)
	WeaponService.addShield(c, 0)
	look(c, true)
	if typeof(c) == "Instance" and c:IsA("Player") then
		MS().announce(m, "TU ES LE MASTODONTE", "Tiens le plus longtemps possible", Color3.fromRGB(255, 90, 60), c)
	end
	for p in pairs(m.players) do
		if p ~= c then MS().announce(m, string.upper(s and s.name or "?") .. " EST LE MASTODONTE", "Élimine-le pour prendre sa place", Color3.fromRGB(255, 90, 60), p) end
	end
end

function M.setup(m: any) m.data.who = nil; m.data.tick = 0 end
function M.onKill(m: any, killer: any, victim: any, _key: string, _hs: boolean, ks: any, vs: any): boolean
	local wasJ = m.data.who == victim
	if wasJ then look(victim, false); m.data.who = nil end
	if not ks or ks == vs then return true end
	if wasJ or not m.data.who then make(m, killer, ks)
	elseif m.data.who == killer then point(m, killer, 1) end
	return true
end
function M.tick(m: any, dt: number)
	local j = m.data.who
	if j and not MS().aliveChar(j) then look(j, false); m.data.who = nil; return end
	if j then
		m.data.tick += dt
		if m.data.tick >= 5 then m.data.tick -= 5; point(m, j, 1) end
	end
end
function M.checkEnd(m: any): (boolean, any)
	for k, v in pairs(m.score) do if m.limit and v >= m.limit then return true, m.stats[k] end end
	return false, nil
end
function M.botGoal(m: any, bot: Model): Vector3?
	local j = m.data.who
	if not j or j == bot then return nil end
	local ch = MS().aliveChar(j)
	local r = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	return r and r.Position
end
function M.info(m: any): any
	local j = m.data.who
	local ch = j and MS().aliveChar(j)
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	local top = {}
	for k, v in pairs(m.score) do local s = m.stats[k]; if s then table.insert(top, { s.name, v }) end end
	table.sort(top, function(a, b) return a[2] > b[2] end)
	local parts = {}
	for i = 1, math.min(3, #top) do table.insert(parts, top[i][1] .. " " .. top[i][2]) end
	return { line = if j then "🛡 MASTODONTE : " .. (m.data.whoName or "?") .. " — " .. (if hum then math.ceil(hum.Health) else 0) .. " PV" else "Première élimination = Mastodonte",
		sub = table.concat(parts, "   ") .. (if m.limit then "   / " .. m.limit else ""), color = Color3.fromRGB(255, 122, 90) }
end
function M.cleanup(m: any) if m.data.who then look(m.data.who, false) end; m.data.who = nil end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="448">
        <Properties>
          <string name="Name">kc</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/kc : Élimination confirmée (web : src/8W_confirm.js). Par équipe : chaque soldat éliminé lâche une plaque à la
-- couleur de son équipe, qui reste 30 s. La plaque d'un ADVERSAIRE ramassée = +1 point (élimination confirmée) ;
-- celle d'un ALLIÉ = l'adversaire ne marque pas (élimination refusée). Les éliminations seules ne rapportent rien.
-- Les bots vont chercher les plaques proches.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local WeaponService = require(script.Parent.Parent.WeaponService)

local LIFE, R = 30, 1.35 * Config.STUDS_PER_METER
local COL = { Attaquants = Color3.fromRGB(255, 122, 74), ["Défenseurs"] = Color3.fromRGB(74, 163, 255) }
local U = Config.STUDS_PER_METER
local M = {}
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end
local popEvent = ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
if not popEvent then
	local e = Instance.new("RemoteEvent"); e.Name = "ModePop"; e.Parent = ReplicatedStorage; popEvent = e
end

type Tag = { model: Model, team: string, pos: Vector3, life: number }

local function drop(m: any, victim: any, team: string)
	local ch = WeaponService.charOf(victim)
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Exclude; rp.FilterDescendantsInstances = { (ch :: any) :: Instance }
	local hit = workspace:Raycast(root.Position, Vector3.new(0, -25, 0), rp)
	local pos = if hit then hit.Position else root.Position - Vector3.new(0, 3, 0)
	local col = COL[team] or Color3.new(1, 1, 1)
	local model = Instance.new("Model"); model.Name = "Pickup_tag"
	model:SetAttribute("Pickup", "tag"); model:SetAttribute("TagTeam", team)
	local core = Instance.new("Part"); core.Name = "Core"; core.Size = Vector3.new(0.34, 0.5, 0.06) * U; core.Color = col
	core.Material = Enum.Material.Neon; core.Anchored = true; core.CanCollide = false; core.CanQuery = false; core.CanTouch = false
	core.CFrame = CFrame.new(pos + Vector3.new(0, 0.85 * U, 0)); core.Parent = model
	local chain = Instance.new("Part"); chain.Name = "Chain"; chain.Size = Vector3.new(0.02, 0.36, 0.02) * U; chain.Color = Color3.fromRGB(200, 205, 215)
	chain.Material = Enum.Material.Metal; chain.Anchored = true; chain.CanCollide = false; chain.CanQuery = false; chain.CFrame = core.CFrame * CFrame.new(0, 0.42 * U, 0); chain.Parent = model
	local ring = Instance.new("Part"); ring.Name = "Ring"; ring.Shape = Enum.PartType.Cylinder; ring.Size = Vector3.new(0.04 * U, 1.4 * U, 1.4 * U)
	ring.Color = col; ring.Material = Enum.Material.Neon; ring.Transparency = 0.5; ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false
	ring.CFrame = CFrame.new(pos + Vector3.new(0, 0.05, 0)) * CFrame.Angles(0, 0, math.rad(90)); ring.Parent = model
	local light = Instance.new("PointLight"); light.Color = col; light.Range = 2 * U; light.Brightness = 1.5; light.Parent = core
	model.PrimaryPart = core
	model.Parent = m.map.folder
	table.insert(m.data.tags, { model = model, team = team, pos = pos, life = LIFE } :: Tag)
end

function M.setup(m: any) m.data.tags = {} end
function M.onKill(m: any, _killer: any, victim: any, _key: string, _hs: boolean, _ks: any, vs: any): boolean
	drop(m, victim, vs.team)
	return true      -- l'élimination seule ne marque pas
end
function M.tick(m: any, dt: number)
	local tags: { Tag } = m.data.tags
	for i = #tags, 1, -1 do
		local t = tags[i]
		t.life -= dt
		if t.life < 5 then   -- clignote avant de disparaître, comme le web
			local on = math.sin(os.clock() * 14) > 0
			for _, d in ipairs(t.model:GetChildren()) do if d:IsA("BasePart") and d.Name ~= "Ring" then d.Transparency = if on then 0 else 0.75 end end
		end
		if t.life <= 0 then t.model:Destroy(); table.remove(tags, i); continue end
		for _, c in ipairs(MS().combatants(m)) do
			local ch = MS().aliveChar(c)
			local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
			if root and (Vector3.new(root.Position.X, 0, root.Position.Z) - Vector3.new(t.pos.X, 0, t.pos.Z)).Magnitude <= R
				and math.abs(root.Position.Y - 3 - t.pos.Y) < 1.6 * U + 3 then
				local team = WeaponService.teamOf(c) :: string
				local s = m.stats[MS().keyOf(c)]
				local conf = team ~= t.team
				if conf then
					m.score[team] = (m.score[team] or 0) + 1
					if s then s.pts += 1; s.score += 50 end
				elseif s then s.score += 25 end
				local p = if typeof(c) == "Instance" and c:IsA("Player") then c else nil
				if p and popEvent then
					popEvent:FireClient(p, if conf then "ÉLIMINATION CONFIRMÉE  +1" else "ÉLIMINATION REFUSÉE", if conf then Color3.fromRGB(255, 210, 58) else Color3.fromRGB(125, 216, 255), if conf then "powerup" else "pickup")
				end
				t.model:Destroy(); table.remove(tags, i)
				break
			end
		end
	end
	-- pour le HUD : nombre de plaques à confirmer / à refuser vues par chaque équipe
	local counts = { Attaquants = 0, ["Défenseurs"] = 0 }
	for _, t in ipairs(tags) do counts[t.team] = (counts[t.team] or 0) + 1 end
	m.data.public = { tags = counts }
end
function M.botGoal(m: any, bot: Model): Vector3?
	local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = bot:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return nil end
	local team = bot:GetAttribute("Team")
	local best, bd = nil, (if hum.Health < 45 then 12 else 26) * U
	for _, t in ipairs(m.data.tags :: { Tag }) do
		local d = (t.pos - root.Position).Magnitude * (if t.team == team then 1.25 else 1)
		if d < bd then best, bd = t.pos, d end
	end
	return best
end
function M.info(m: any): any
	return { line = "Ramasse les plaques — premier à " .. tostring(m.limit), color = Color3.fromRGB(255, 207, 74), kind = "kc" }
end
function M.cleanup(m: any)
	for _, t in ipairs(m.data.tags or {}) do if t.model.Parent then t.model:Destroy() end end
	m.data.tags = {}
end
local _ = Players
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="449">
        <Properties>
          <string name="Name">koth</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/koth : Capture de zone (web : src/61_variants.js kothUpdate). Par équipe : une zone (anneau) sur la carte ;
-- une équipe seule dans la zone marque 1 point par seconde, deux équipes = zone disputée. La zone se déplace au bout
-- de 60 s puis toutes les 75 s (zones de la carte : MAP.koth, sinon le centre puis les sites A et B). Les éliminations
-- ne marquent pas. Premier à la limite (100 / 200 / 300) ; à la fin du chrono (10 min), le plus de points gagne.
-- Les bots vont dans la zone.
local WeaponService = require(script.Parent.Parent.WeaponService)
local O = require(script.Parent.objutil)

local U = O.U
local T, CT = O.T, O.CT
-- zones du web (src/21_maps_extra.js) pour les cartes qui en ont ; les autres : le centre puis les sites
local KOTH: { [string]: { { number } } } = {
	harbor = { { 20, 19, 5 }, { 7, 5, 5 }, { 33, 6, 5 } },
	metro = { { 20, 21, 5 }, { 6, 20, 5 }, { 33, 20, 5 } },
	jungle = { { 20, 19, 5 }, { 7, 8, 5 }, { 33, 8, 5 } },
	range = { { 20, 20, 5 } },
	labo = { { 19, 31, 4 }, { 6, 28, 4 }, { 33, 28, 4 }, { 19, 11, 5 } },
	asile = { { 19, 32, 4 }, { 6, 28, 4 }, { 33, 29, 4 }, { 19, 18, 4 } },
}
local M = {}
local function MS(): any return O.MS() end

local function zones(m: any): { { number } }
	local z = m.map.data.koth or KOTH[m.settings.map]
	if z and #z > 0 then return z end
	local l = { { 20, 20, 5 } }
	for _, s in ipairs(m.map.data.sites or {}) do table.insert(l, { s.cx, s.cz, 5 }) end
	return l
end
local function zone(m: any): (Vector3, number)
	local list = zones(m)
	local z = list[(m.data.idx % #list) + 1]
	return O.ground(m, MS().cellToWorld(m, z[1], z[2])), z[3] * 1.45 * U
end
local function place(m: any)
	local pos, r = zone(m)
	if m.data.ring then m.data.ring:Destroy() end
	m.data.ring = O.ring(m, "KothRing", pos, r, 9 * U, O.WHITE, 0.92)
	m.data.owner = nil; m.data.hold = 0; m.data.contested = false
	m.data.pos, m.data.r = pos, r
	m.data.bot = {}
end

function M.setup(m: any)
	local d = m.data
	d.idx = 0; d.owner = nil; d.contested = false; d.hold = 0; d.moveAt = math.huge; d.bot = {}
	m.score[T] = 0; m.score[CT] = 0
	place(m)
	d.public = { kind = "koth", pos = d.pos, r = d.r, owner = nil, contested = false, moveLeft = 60 }
end
function M.start(m: any) m.data.moveAt = os.clock() + 60 end
function M.onKill(): boolean return true end     -- les éliminations ne marquent pas
function M.tick(m: any, dt: number)
	local d = m.data
	if os.clock() >= d.moveAt then
		d.idx += 1; d.moveAt = os.clock() + 75
		place(m)
		for p in pairs(m.players) do O.pop(p, "LA ZONE SE DÉPLACE !", O.CONTEST, "click") end
	end
	local c = { [T] = 0, [CT] = 0 }
	for _, cb in ipairs(O.alive(m)) do
		local r = O.root(cb) :: BasePart
		local team = WeaponService.teamOf(cb)
		if team and c[team] and O.flat(r.Position, d.pos) < d.r and math.abs(O.feet(r).Y - d.pos.Y) < 3 * U then c[team] += 1 end
	end
	d.contested = c[T] > 0 and c[CT] > 0
	local owner = if c[T] > 0 and c[CT] == 0 then T elseif c[CT] > 0 and c[T] == 0 then CT else nil
	d.owner = owner
	O.ringColor(d.ring, if owner then O.COL[owner] elseif d.contested then O.CONTEST else O.WHITE)
	if owner then
		d.hold += dt
		while d.hold >= 1 do
			d.hold -= 1
			m.score[owner] = (m.score[owner] or 0) + 1
			for _, cb in ipairs(O.alive(m, owner)) do
				local r = O.root(cb) :: BasePart
				local s = m.stats[MS().keyOf(cb)]
				if s and O.flat(r.Position, d.pos) < d.r then s.pts += 1; s.score += 5 end
			end
		end
	end
	d.public = { kind = "koth", pos = d.pos, r = d.r, owner = owner, contested = d.contested, moveLeft = math.max(0, math.ceil(d.moveAt - os.clock())) }
end
function M.checkEnd(m: any): (boolean, any)
	for _, t in ipairs({ T, CT }) do if m.limit and (m.score[t] or 0) >= m.limit then return true, t end end
	return false, nil
end
function M.timeUp(m: any): any
	local a, b = m.score[T] or 0, m.score[CT] or 0
	return if a > b then T elseif b > a then CT else nil
end
-- les bots vont dans la zone, chacun à un endroit différent (web : z.x ± 0,7 r), et changent de place de temps en temps
function M.botGoal(m: any, bot: Model): Vector3?
	local d = m.data
	if not d.pos then return nil end
	local g = d.bot[bot.Name]
	if not g or os.clock() > g.t then
		local s = d.r * 0.7
		g = { pos = d.pos + Vector3.new((math.random() * 2 - 1) * s, 3, (math.random() * 2 - 1) * s), t = os.clock() + 7 + math.random() * 8 }
		d.bot[bot.Name] = g
	end
	return g.pos
end
function M.info(m: any): any
	local d = m.data
	local line = if d.contested then "ZONE DISPUTÉE" elseif d.owner == nil then "ZONE LIBRE — allez dessus !"
		else "ZONE TENUE PAR LES " .. (if d.owner == T then "ATTAQUANTS" else "DÉFENSEURS")
	local left = if d.moveAt == math.huge then 60 else math.max(0, math.ceil(d.moveAt - os.clock()))
	return { line = line, sub = "Prochaine zone " .. left .. " s · premier à " .. tostring(m.limit),
		color = if d.owner then O.COL[d.owner] elseif d.contested then O.CONTEST else O.WHITE, kind = "koth" }
end
function M.cleanup(m: any)
	if m.data.ring then m.data.ring:Destroy() end
	m.data.ring = nil
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="450">
        <Properties>
          <string name="Name">objutil</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/objutil : outils partagés des modes à objectifs (bombe, zone, drapeaux). Ce n'est pas un mode (absent de Modes.LIST).
-- Couleurs d'équipe du web, combattants en vie, hauteur du sol, cases libres de la grille, anneaux et drapeaux posés
-- dans le dossier de la carte de la partie (le client ModeHud les anime).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local WeaponService = require(script.Parent.Parent.WeaponService)

local O = {}
local U = Config.STUDS_PER_METER
O.U = U
O.T, O.CT = "Attaquants", "Défenseurs"
O.COL = { Attaquants = Color3.fromRGB(255, 122, 74), ["Défenseurs"] = Color3.fromRGB(74, 163, 255) } :: { [string]: Color3 }
O.WHITE = Color3.new(1, 1, 1)
O.CONTEST = Color3.fromRGB(255, 210, 58)
O.GOOD = Color3.fromRGB(125, 255, 159)
O.BAD = Color3.fromRGB(255, 107, 107)

function O.MS(): any return require(script.Parent.Parent.MatchService) :: any end
function O.other(team: string): string return if team == O.T then O.CT else O.T end
function O.isPlayer(c: any): boolean return typeof(c) == "Instance" and c:IsA("Player") end

-- racine d'un combattant en vie (nil s'il est mort ou sans personnage)
function O.root(c: any): BasePart?
	local ch = O.MS().aliveChar(c)
	return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end
-- combattants en vie de la partie (d'une équipe si donnée)
function O.alive(m: any, team: string?): { any }
	local l = {}
	for _, c in ipairs(O.MS().combatants(m)) do
		if O.MS().aliveChar(c) and (not team or WeaponService.teamOf(c) == team) then table.insert(l, c) end
	end
	return l
end
function O.flat(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end
-- les pieds d'un personnage (la racine est ~3 studs au-dessus du sol)
function O.feet(r: BasePart): Vector3 return r.Position - Vector3.new(0, 3, 0) end

-- hauteur du sol (toits, plateformes) sous un point de la carte de la partie
function O.ground(m: any, pos: Vector3): Vector3
	if m.map.groundAt then return Vector3.new(pos.X, m.map.groundAt(pos), pos.Z) end   -- hauteur de la grille (MapBuilder)
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { m.map.folder }
	local hit = workspace:Raycast(Vector3.new(pos.X, m.origin.Y + 60, pos.Z), Vector3.new(0, -120, 0), rp)
	return Vector3.new(pos.X, if hit then hit.Position.Y else m.origin.Y, pos.Z)
end
-- sol sans plafond : premier sol en partant de la hauteur donnée (sous un toit, sous une passerelle)
function O.groundBelow(m: any, pos: Vector3): Vector3
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Include
	rp.FilterDescendantsInstances = { m.map.folder }
	local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -40, 0), rp)
	return if hit then hit.Position else Vector3.new(pos.X, m.origin.Y, pos.Z)
end

-- ---------- grille de la carte (cases libres), comme walkableCell / domSpot du web ----------
local grids: { [string]: any } = {}
function O.grid(m: any): any
	if m.map and m.map.grid then return m.map.grid end
	local id = m.settings.map
	if grids[id] == nil then
		local ok, g = pcall(MapData.buildGrid, id)
		grids[id] = if ok then g else false
	end
	return if grids[id] then grids[id] else nil
end
local function openCell(g: any, cx: number, cz: number): boolean
	local N = MapData.N
	if cx < 1 or cz < 1 or cx >= N - 1 or cz >= N - 1 then return false end
	local i = cz * N + cx
	return g.type[i] == 0 or (g.ramp[i] or 0) ~= 0
end
-- case libre la plus proche d'un point de la grille, entourée de cases libres (pas coincée dans un recoin)
function O.spot(m: any, fx: number, fz: number): (number, number)
	local tx, tz = math.floor(fx + 0.5), math.floor(fz + 0.5)
	local g = O.grid(m)
	if not g then return tx, tz end
	for pass = 1, 2 do
		for r = 0, 9 do
			for dz = -r, r do
				for dx = -r, r do
					if math.max(math.abs(dx), math.abs(dz)) == r then
						local cx, cz = tx + dx, tz + dz
						if openCell(g, cx, cz) then
							local ok = true
							if pass == 1 then
								for oz = -1, 1 do for ox = -1, 1 do if not openCell(g, cx + ox, cz + oz) then ok = false end end end
							end
							if ok then return cx, cz end
						end
					end
				end
			end
		end
	end
	return tx, tz
end
function O.avg(list: { any }): (number, number)
	local x, z = 0, 0
	for _, c in ipairs(list) do x += c[1]; z += c[2] end
	local n = math.max(1, #list)
	return x / n, z / n
end

-- sites de bombe de la carte : { n, pos (au sol), r (studs) }
function O.sites(m: any): { { n: string, pos: Vector3, r: number } }
	local l = {}
	for _, s in ipairs(m.map.data.sites or {}) do
		local p = O.ground(m, O.MS().cellToWorld(m, s.cx, s.cz))
		table.insert(l, { n = s.n, pos = p, r = (s.r or 7) * U })
	end
	if #l == 0 then
		table.insert(l, { n = "A", pos = O.ground(m, O.MS().cellToWorld(m, 10, 10)), r = 7 * U })
		table.insert(l, { n = "B", pos = O.ground(m, O.MS().cellToWorld(m, 30, 10)), r = 7 * U })
	end
	return l
end

-- ---------- objets posés dans la carte ----------
local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, transparency: number, shape: Enum.PartType?, material: Enum.Material?): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.CastShadow = false; p.Size = size; p.CFrame = cf; p.Color = color; p.Transparency = transparency
	p.Material = material or Enum.Material.Neon
	if shape then p.Shape = shape end
	p.Parent = parent
	return p
end
O.part = part

-- anneau au sol (ringMesh du web) : disque transparent, cercle lumineux (segments) et mur translucide
function O.ring(m: any, name: string, center: Vector3, radius: number, height: number, color: Color3, wallAlpha: number?): Model
	local model = Instance.new("Model"); model.Name = name
	model:SetAttribute("ModeRing", true); model:SetAttribute("Radius", radius)
	local up = CFrame.new(center) * CFrame.Angles(0, 0, math.rad(90))
	part(model, "Disc", Vector3.new(0.1, radius * 2, radius * 2), up + Vector3.new(0, 0.12, 0), color, 0.88, Enum.PartType.Cylinder)
	part(model, "Wall", Vector3.new(height, radius * 2, radius * 2), up + Vector3.new(0, height / 2, 0), color, wallAlpha or 0.9, Enum.PartType.Cylinder, Enum.Material.ForceField)
	local seg = 40
	local len = 2 * math.pi * radius / seg + 0.15
	for i = 1, seg do
		local a = (i / seg) * math.pi * 2
		local p = center + Vector3.new(math.cos(a) * radius, 0.2, math.sin(a) * radius)
		part(model, "Seg", Vector3.new(len, 0.25, 0.35), CFrame.new(p) * CFrame.Angles(0, -a + math.pi / 2, 0), color, 0.05)
	end
	model.Parent = m.map.folder
	return model
end
function O.ringColor(model: Model?, color: Color3)
	if not model then return end
	for _, p in ipairs(model:GetChildren()) do if p:IsA("BasePart") and p.Color ~= color then p.Color = color end end
end
function O.moveRing(model: Model?, center: Vector3)
	if not model then return end
	local disc = model:FindFirstChild("Disc") :: BasePart?
	if not disc then return end
	local old = disc.Position - Vector3.new(0, 0.12, 0)
	for _, p in ipairs(model:GetChildren()) do if p:IsA("BasePart") then p.Position += center - old end end
end

-- étiquette flottante (lettre de drapeau, site de bombe) : BillboardGui toujours visible
function O.label(adornee: BasePart, text: string, color: Color3, offset: number): BillboardGui
	local bb = Instance.new("BillboardGui"); bb.Name = "Label"; bb.AlwaysOnTop = true; bb.Size = UDim2.fromOffset(42, 42)
	bb.StudsOffsetWorldSpace = Vector3.new(0, offset, 0); bb.LightInfluence = 0; bb.MaxDistance = 600
	local t = Instance.new("TextLabel"); t.Name = "Text"; t.Size = UDim2.fromScale(1, 1); t.BackgroundColor3 = Color3.new(0, 0, 0)
	t.BackgroundTransparency = 0.35; t.Text = text; t.TextColor3 = color; t.Font = Enum.Font.GothamBlack; t.TextScaled = true
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = t
	local s = Instance.new("UIStroke"); s.Color = color; s.Thickness = 3; s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = t
	t.Parent = bb
	bb.Adornee = adornee; bb.Parent = adornee
	return bb
end

-- drapeau (ctfFlagMesh du web) : mât, boule dorée, toile à la couleur de l'équipe
function O.flag(parent: Instance, name: string, at: Vector3, color: Color3): Model
	local model = Instance.new("Model"); model.Name = name
	local pole = part(model, "Pole", Vector3.new(0.07, 2.3, 0.07) * U, CFrame.new(at + Vector3.new(0, 1.15 * U, 0)), Color3.fromRGB(216, 221, 228), 0, nil, Enum.Material.Metal)
	part(model, "Tip", Vector3.new(0.14, 0.14, 0.14) * U, CFrame.new(at + Vector3.new(0, 2.33 * U, 0)), Color3.fromRGB(255, 210, 58), 0, Enum.PartType.Ball, Enum.Material.Metal)
	part(model, "Cloth", Vector3.new(1.1, 0.7, 0.03) * U, CFrame.new(at + Vector3.new(0.58 * U, 1.92 * U, 0)), color, 0, nil, Enum.Material.Fabric)
	pole.PivotOffset = CFrame.new(0, -1.15 * U, 0)       -- le pivot est au pied du mât
	model.PrimaryPart = pole
	model.Parent = parent
	return model
end

-- objet porté par un combattant (drapeau, bombe) : soudé dans son dos
function O.carry(model: Model, c: any, offset: CFrame, scale: number?)
	local r = O.root(c)
	if not r then return end
	O.release(model)
	if scale and model:GetScale() ~= scale then model:ScaleTo(scale) end
	model:PivotTo(r.CFrame * offset)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("BasePart") then
			p.Massless = true; p.CanCollide = false
			local w = Instance.new("WeldConstraint"); w.Name = "CarryWeld"; w.Part0 = r; w.Part1 = p; w.Parent = p
			p.Anchored = false
		end
	end
end
-- lâché : ancré là où il est posé (ou à la position donnée)
function O.release(model: Model, at: CFrame?)
	for _, p in ipairs(model:GetDescendants()) do
		if p:IsA("WeldConstraint") and p.Name == "CarryWeld" then p:Destroy() end
	end
	for _, p in ipairs(model:GetDescendants()) do if p:IsA("BasePart") then p.Anchored = true end end
	if model:GetScale() ~= 1 then model:ScaleTo(1) end
	if at then model:PivotTo(at) end
end

-- texte bref à un joueur (petit message au centre, ModePop du HUD)
local popEvent = ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
function O.pop(p: Player, text: string, color: Color3?, sound: string?)
	popEvent = popEvent or ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
	if not popEvent then
		local e = Instance.new("RemoteEvent"); e.Name = "ModePop"; e.Parent = ReplicatedStorage; popEvent = e
	end
	(popEvent :: RemoteEvent):FireClient(p, text, color, sound)
end

return O
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="451">
        <Properties>
          <string name="Name">rapid</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/rapid : Désamorçage rapide (variante « rapid » du web, src/61_variants.js) : manches de 45 s, 10 s d'achat,
-- argent illimité (16 000), bombe comme en Compétitif, mi-temps. Toutes les règles sont dans Modes/rounds.
return require(script.Parent.rounds).make("rapid")
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="452">
        <Properties>
          <string name="Name">rounds</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/rounds : moteur commun des modes à manches du web (src/60_game.js resetRound / endRound / afterEnd, bombe,
-- boutique ; src/8Zc_eco.js économie ; src/8G_rounds.js mi-temps ; src/61_variants.js Désamorçage rapide ;
-- src/8B_duel.js Duel). Ce n'est pas un mode : bomb.lua, rapid.lua, duel.lua et gunfight.lua appellent Rounds.make(variante).
-- Gunfight (Call of Duty) : comme le Duel, mais sans boutique : tout le monde reçoit les MÊMES armes (principale, pistolet,
-- une grenade), tirées au sort toutes les 2 manches ; manches de 40 s, positions révélées à 15 s de la fin.
--
-- Une manche : phase d'achat figée (20 s / 10 s / 6 s), puis la manche (100 s / 45 s / 60 s), sans réapparition.
-- Bombe (Compétitif, Désamorçage rapide) : un attaquant au hasard la porte ; il la pose sur un site (maintenir E, 3,2 s),
-- elle explose 40 s plus tard ; un défenseur la désamorce (maintenir E à côté, 5 s, 2,5 s avec le kit).
-- Les attaquants gagnent si la bombe explose ou si tous les défenseurs sont éliminés ; les défenseurs gagnent si la
-- bombe est désamorcée, si tous les attaquants sont éliminés avant la pose, ou à la fin du temps.
-- Économie façon Valorant (réglage « Économie réaliste », par défaut) : 800 au départ, 3000 par manche gagnée,
-- 1900 / 2400 / 2900 par défaites d'affilée, 200 par élimination, 300 à chaque attaquant quand la bombe est posée,
-- plafond 9000. Mi-temps : changement de camp, retour à 800 et manche au pistolet. « Armes libres » : tout est gratuit.
-- Les survivants gardent leur équipement à la manche suivante.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local Modes = require(ReplicatedStorage.Shared.Modes)
local WeaponService = require(script.Parent.Parent.WeaponService)
local BotService = require(script.Parent.Parent.BotService)
local O = require(script.Parent.objutil)
local GrenadeService = require(script.Parent.Parent.GrenadeService)
local Grenades = require(ReplicatedStorage.Shared.Grenades)

local U = O.U
local T, CT = O.T, O.CT
local ECO = { start = 800, win = 3000, loss = { 1900, 2400, 2900 }, kill = 200, plant = 300, defuse = 0, max = 9000 }
local PLANT_T, DEFUSE_T, BOMB_T, END_T = 3.2, 5, 40, 5.5
local PICK_R, DEFUSE_R = 1.4 * U, 1.8 * U
local REVEAL = 20
local GOLD, PINK = Color3.fromRGB(255, 215, 94), Color3.fromRGB(255, 122, 217)

local VARIANTS = {
	bomb = { round = 100, freeze = 20, bomb = true, half = true },
	rapid = { round = 45, freeze = 10, bomb = true, half = true },
	duel = { round = 60, freeze = 6, bomb = false, half = false },
	gunfight = { round = 40, freeze = 5, bomb = false, half = false, reveal = 15, kitEvery = 2 },
}
-- armes de Gunfight : une principale et un pistolet pour tout le monde, avec une grenade ou un flash (kits de COD)
local GF_PRIMARY = { "ak", "m4", "famas", "galil", "sg553", "aug", "mp9", "ump", "p90", "mac10", "nova", "xm", "ssg", "awp", "negev" }
local GF_PISTOL = { "glock", "usp", "p250", "fiveseven", "deagle" }

local ITEM_PRICE: { [string]: number } = {}
for _, it in ipairs(Modes.BUY_ITEMS) do ITEM_PRICE[it.k] = it.price end
local BUYABLE: { [string]: boolean } = {}
for _, cat in ipairs(Modes.BUY_CATS) do for _, k in ipairs(cat.list) do BUYABLE[k] = true end end
local PRIMARIES: { string } = {}
for _, cat in ipairs(Modes.BUY_CATS) do for _, k in ipairs(cat.list) do if Config.WEAPONS[k].slot == 0 then table.insert(PRIMARIES, k) end end end

type Inv = { money: number, primary: string?, secondary: string, armor: number, shield: number, kit: boolean,
	frag: number, flash: number, smoke: number, mine: number, keep: boolean }

local function MS(): any return O.MS() end
local function now(): number return os.clock() end
local function pistolOf(team: string?): string return if team == T then "glock" else "usp" end
local function shuffle<V>(l: { V }): { V }
	for i = #l, 2, -1 do local j = math.random(i); l[i], l[j] = l[j], l[i] end
	return l
end
local function setAttr(inst: Instance, name: string, v: any)
	if inst:GetAttribute(name) ~= v then inst:SetAttribute(name, v) end
end

local Rounds = {}

-- ---------- remotes (boutique, touche E) ; les grenades et les mines passent par GrenadeService ----------
local function remote(class: string, name: string): Instance
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r then r = Instance.new(class); r.Name = name; r.Parent = ReplicatedStorage end
	return r :: Instance
end
local buyFn = remote("RemoteFunction", "ModeBuy") :: RemoteFunction
local useEv = remote("RemoteEvent", "ModeUse") :: RemoteEvent
-- modes sans manches (match à mort, zones, drapeaux…) : « armurerie gratuite » du web (buyItem quand isDM()),
-- l'arme est donnée tout de suite ; pas d'achat en Course aux armes, Zombies, Arme tournante, Bataille royale, Infecté
local NO_BUY = { gg = "Course aux armes : pas d'achat, chaque élimination te donne l'arme suivante",
	zombies = "Zombies : achète aux murs (craie), à la boîte mystère et aux machines", shp = "Arme tournante : tout le monde a la même arme",
	br = "Bataille royale : ramasse les armes sur la carte", inf = "Infecté : pas de boutique" }
local function freeState(m: any, p: Player): any
	local list = WeaponService.loadoutOf(p)
	local prim, sec
	for _, k in ipairs(list) do
		local w = Config.WEAPONS[k]
		if w and not w.melee then if w.slot == 0 then prim = prim or k else sec = sec or k end end
	end
	local g = GrenadeService.get(p) or { frag = 0, flash = 0, smoke = 0, mine = 0 }
	return { money = 0, free = true, dm = true, pistol = false, phase = "freeze", team = WeaponService.teamOf(p), bombMode = false,
		primary = prim, secondary = sec, armor = WeaponService.armorOf(p), shield = WeaponService.shieldOf(p), kit = false,
		frag = g.frag, flash = g.flash, smoke = g.smoke, mine = g.mine, alive = MS().aliveChar(p) ~= nil }
end
local function freeBuy(p: Player, k: string): boolean
	if not MS().aliveChar(p) then return false end
	if k == "armor" then
		if WeaponService.armorOf(p) >= 100 then return false end
		WeaponService.setArmor(p, 100); return true
	elseif k == "shield1" or k == "shield2" then
		local v = if k == "shield1" then 25 else 50
		if WeaponService.shieldOf(p) >= v then return false end
		WeaponService.setShield(p, v); return true
	elseif k == "frag" or k == "flash" or k == "smoke" or k == "mine" then
		local s = table.clone(GrenadeService.get(p) or { frag = 0, flash = 0, smoke = 0, mine = 0 }) :: any
		local max = if k == "flash" then 2 elseif k == "mine" then Grenades.MINE.max else 1
		if (s[k] or 0) >= max then return false end
		s[k] = (s[k] or 0) + 1
		GrenadeService.set(p, s.frag, s.flash, s.smoke, s.mine)
		return true
	end
	local w = Config.WEAPONS[k]
	if not w or not BUYABLE[k] then return false end
	local st = freeState(MS().matchOf(p), p)
	if (w.slot == 0 and st.primary == k) or (w.slot ~= 0 and st.secondary == k) then return false end
	local prim = if w.slot == 0 then k else st.primary
	local sec = if w.slot ~= 0 then k else st.secondary
	local list = {}
	if prim then table.insert(list, prim) end
	if sec then table.insert(list, sec) end
	table.insert(list, "knife")
	WeaponService.setLoadoutKeep(p, list, k)
	return true
end
buyFn.OnServerInvoke = function(p: Player, key: any)
	local m = MS().matchOf(p)
	if not m then return nil end
	local k = if typeof(key) == "string" and #key <= 16 then key else nil
	if m.mod and m.mod.buy then return m.mod.buy(m, p, k) end
	if NO_BUY[m.mode] then return { closed = NO_BUY[m.mode] } end
	local ok = if k then freeBuy(p, k) else true
	local st = freeState(m, p)
	st.ok = ok
	return st
end
useEv.OnServerEvent:Connect(function(p: Player, on: any)
	local m = MS().matchOf(p)
	if m and m.mod and m.mod.useKey then m.mod.useKey(m, p, on == true) end
end)

function Rounds.make(variant: string): any
	local V = VARIANTS[variant]
	local M: any = {}
	M.noPickups = true      -- web : pas d'objets à ramasser dans les modes à bombe (setupPickups seulement hors « bomb »)

	local duelLike = variant == "duel" or variant == "gunfight"   -- sans bombe : départage aux survivants, positions révélées
	local function ecoOn(m: any): boolean return m.settings.eco == 1 and variant ~= "rapid" and not duelLike end
	local function cap(m: any): number return if ecoOn(m) then ECO.max else 16000 end
	local function free(m: any): boolean return m.settings.eco ~= 1 end
	local function startMoney(m: any): number return if m.settings.eco == 1 and variant == "bomb" then ECO.start else 16000 end

	-- ---------- inventaire (argent, armes, gilet, bouclier, kit, grenades) de chaque combattant ----------
	local function invOf(m: any, key: any, team: string?): Inv
		local inv = m.data.inv[key]
		if not inv then
			inv = { money = startMoney(m), primary = nil, secondary = pistolOf(team), armor = 0, shield = 0, kit = false,
				frag = 0, flash = 0, smoke = 0, mine = 0, keep = false }
			m.data.inv[key] = inv
		end
		return inv
	end
	local function inv(m: any, c: any): Inv return invOf(m, MS().keyOf(c), WeaponService.teamOf(c)) end
	local function listOf(i: Inv): { string }
		local l = {}
		if i.primary then table.insert(l, i.primary) end
		table.insert(l, i.secondary)
		table.insert(l, "knife")
		return l
	end
	local function syncMoney(m: any, p: Player)
		local i = m.data.inv[p]
		setAttr(p, "Money", if i then i.money else nil)
	end
	local function applyGear(c: any, i: Inv)
		WeaponService.setArmor(c, i.armor)
		WeaponService.setShield(c, i.shield)
	end
	-- grenades et mines : le stock vit dans GrenadeService (lancers, compteur « Nades »), l'inventaire le garde entre deux manches
	local function stockOf(c: any): { frag: number, flash: number, smoke: number, mine: number }
		local s = GrenadeService.get(c)
		return if s then s else { frag = 0, flash = 0, smoke = 0, mine = 0 }
	end
	local function applyNades(c: any, i: Inv)
		WeaponService.giveGrenades(c, i.smoke, i.flash, i.frag, i.mine)    -- remplace l'équipement de départ du match à mort
	end

	-- membres de la partie (joueurs + bots de l'effectif, même morts) : { key, team, c? }
	local function members(m: any): { { key: any, team: string, c: any } }
		local l = {}
		for p in pairs(m.players) do table.insert(l, { key = p, team = WeaponService.teamOf(p) or T, c = p }) end
		local models: { [string]: Model } = {}
		for _, b in ipairs(BotService.ofMatch(m.id)) do models[b.Name] = b end
		for _, team in ipairs({ T, CT }) do
			for _, n in ipairs(m.data.roster[team]) do table.insert(l, { key = "bot:" .. n, team = team, c = models[n] }) end
		end
		return l
	end

	local function freezeHum(c: any, on: boolean)
		local ch = WeaponService.charOf(c)
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if not h then return end
		if O.isPlayer(c) then
			h.WalkSpeed = if on then 0 else 16
			h.JumpPower = if on then 0 else 50; h.JumpHeight = if on then 0 else 7.2
		end
	end

	-- ---------- bombe ----------
	local function bombModel(m: any): Model
		local b = m.data.bombModel
		if b then return b end
		local model = Instance.new("Model"); model.Name = "Bomb"
		local body = O.part(model, "Body", Vector3.new(0.5, 0.14, 0.32) * U, CFrame.new(0, 0.07 * U, 0), Color3.fromRGB(42, 45, 51), 0, nil, Enum.Material.Metal)
		O.part(model, "Screen", Vector3.new(0.18, 0.05, 0.07) * U, CFrame.new(0, 0.145 * U, 0), Color3.fromRGB(255, 32, 32), 0)
		for i = 0, 2 do
			O.part(model, "Tube", Vector3.new(0.28, 0.06, 0.06) * U, CFrame.new((-0.15 + i * 0.15) * U, 0.18 * U, 0) * CFrame.Angles(0, math.rad(90), 0), Color3.fromRGB(184, 69, 42), 0, Enum.PartType.Cylinder, Enum.Material.SmoothPlastic)
		end
		local light = Instance.new("PointLight"); light.Name = "Glow"; light.Color = Color3.fromRGB(255, 48, 48); light.Range = 2 * U; light.Brightness = 2; light.Parent = body
		body.PivotOffset = CFrame.new(0, -0.07 * U, 0)
		model.PrimaryPart = body
		m.data.bombModel = model
		return model
	end
	local function showBomb(m: any, at: Vector3?)
		local model = bombModel(m)
		if at then
			O.release(model, CFrame.new(at))
			model.Parent = m.map.folder
		else
			model.Parent = nil
		end
	end
	local function bombState(m: any, st: string)
		local b = m.data.bomb
		b.state = st
		local model = bombModel(m)
		model:SetAttribute("State", st)
	end
	local function dropBomb(m: any, at: Vector3?)
		local b = m.data.bomb
		if b.state ~= "carried" then return end
		local c = b.carrier
		local r = c and O.root(c)
		local pos = at or (r and O.feet(r)) or b.lastPos or m.data.sites[1].pos
		b.carrier = nil
		if typeof(c) == "Instance" and c:IsA("Model") then c:SetAttribute("Busy", nil) end
		local ch = c and WeaponService.charOf(c)
		if ch then ch:SetAttribute("HasBomb", nil) end
		b.pos = O.groundBelow(m, pos)
		bombState(m, "dropped")
		showBomb(m, b.pos)
		for p in pairs(m.players) do
			if WeaponService.teamOf(p) == T then O.pop(p, "BOMBE LÂCHÉE", Color3.fromRGB(255, 185, 56), "click") end
		end
	end
	local function giveBomb(m: any, c: any)
		local b = m.data.bomb
		b.carrier = c; b.prog = 0
		bombState(m, "carried")
		local model = bombModel(m)
		local ch = WeaponService.charOf(c)
		if ch then ch:SetAttribute("HasBomb", true) end
		model.Parent = m.map.folder
		O.carry(model, c, CFrame.new(0, 0.2 * U, 0.42 * U) * CFrame.Angles(math.rad(90), 0, 0))
		if O.isPlayer(c) then O.pop(c, "TU AS LA BOMBE — POSE-LA SUR UN SITE (E)", Color3.fromRGB(255, 185, 56), "pickup") end
	end
	local function siteAt(m: any, pos: Vector3): any
		for _, s in ipairs(m.data.sites) do
			if O.flat(pos, s.pos) < s.r and math.abs(pos.Y - s.pos.Y) < 3.5 * U then return s end
		end
		return nil
	end

	-- ---------- fin de manche ----------
	local function teamWord(team: string): string return if team == T then "ATTAQUANTS" else "DÉFENSEURS" end
	local function endRound(m: any, win: string, reason: string)
		local d = m.data
		if d.phase ~= "live" then return end
		if duelLike and reason == "Temps écoulé" then
			-- départage du duel : le plus de survivants, puis le plus de points de vie
			local al, hp = { [T] = 0, [CT] = 0 }, { [T] = 0, [CT] = 0 }
			for _, c in ipairs(O.alive(m)) do
				local team = WeaponService.teamOf(c) :: string
				local ch = MS().aliveChar(c)
				local h = ch and ch:FindFirstChildOfClass("Humanoid")
				al[team] = (al[team] or 0) + 1; hp[team] = (hp[team] or 0) + (if h then h.Health else 0)
			end
			if al[T] ~= al[CT] then win = if al[T] > al[CT] then T else CT
			elseif hp[T] ~= hp[CT] then win = if hp[T] > hp[CT] then T else CT
			else win = if math.random() < 0.5 then T else CT end
			reason = "Temps écoulé — " .. (if al[T] ~= al[CT] then "plus de survivants" else "plus de points de vie")
		end
		d.phase = "end"; d.phaseEnd = now() + END_T; m.endsAt = d.phaseEnd
		m.score[win] = (m.score[win] or 0) + 1
		d.lastWin, d.lastReason = win, reason
		local lose = O.other(win)
		for _, e in ipairs(members(m)) do
			local i = invOf(m, e.key, e.team)
			local bonus = if e.team == win then ECO.win else ECO.loss[math.min(#ECO.loss, d.loss[e.team] + 1)]
			if m.settings.eco == 1 then i.money = math.min(cap(m), i.money + bonus) end
			-- les survivants gardent leur équipement (web : e.keep)
			i.keep = e.c ~= nil and MS().aliveChar(e.c) ~= nil
			if i.keep then
				i.armor = WeaponService.armorOf(e.c); i.shield = WeaponService.shieldOf(e.c)
				local s = stockOf(e.c); i.frag, i.flash, i.smoke, i.mine = s.frag, s.flash, s.smoke, s.mine
			end
			if O.isPlayer(e.c) then syncMoney(m, e.c) end
		end
		d.loss[win] = 0; d.loss[lose] += 1
		for _, b in ipairs(BotService.ofMatch(m.id)) do b:SetAttribute("Busy", nil) end
		WeaponService.clearGrenades(m.id)     -- plus de mines au sol pour la manche suivante
		for p in pairs(m.players) do
			local mine = WeaponService.teamOf(p) == win
			local r = reason
			if duelLike and string.find(reason, "Temps écoulé", 1, true) ~= 1 then r = if mine then "Adversaire éliminé" else "Ton équipe est éliminée" end
			MS().announce(m, if mine then "MANCHE GAGNÉE" else "MANCHE PERDUE", r, if mine then O.GOOD else O.BAD, p)
			setAttr(p, "UseProg", nil); setAttr(p, "UseMsg", nil); setAttr(p, "UseHint", nil)
		end
	end

	local function checkAlive(m: any)
		if m.data.phase ~= "live" then return end
		local aT, aC = #O.alive(m, T), #O.alive(m, CT)
		if m.data.bomb.state == "planted" then
			if aC == 0 then endRound(m, T, "Défenseurs éliminés") end
		elseif aT == 0 then endRound(m, CT, "Attaquants éliminés")
		elseif aC == 0 then endRound(m, T, "Défenseurs éliminés") end
	end

	-- ---------- achats ----------
	local function buyState(m: any, p: Player): any
		local i = inv(m, p)
		local d = m.data
		return { money = i.money, free = free(m), pistol = d.pistol, phase = d.phase, team = WeaponService.teamOf(p), bombMode = V.bomb,
			primary = i.primary, secondary = i.secondary, armor = i.armor, shield = i.shield, kit = i.kit, frag = stockOf(p).frag, flash = stockOf(p).flash, smoke = stockOf(p).smoke, mine = stockOf(p).mine,
			left = math.max(0, math.floor(d.phaseEnd - now())) }
	end
	local function doBuy(m: any, c: any, k: string): (boolean, string?)
		local d = m.data
		if variant == "gunfight" then return false, "Gunfight : tout le monde a les mêmes armes" end
		if d.phase ~= "freeze" then return false, "Achats possibles seulement en début de manche" end
		local i = inv(m, c)
		local team = WeaponService.teamOf(c)
		local function pay(pr: number): boolean
			if free(m) then return true end
			if i.money < pr then return false end
			i.money -= pr
			return true
		end
		if k == "armor" then
			if i.armor >= 100 or not pay(ITEM_PRICE.armor) then return false, nil end
			i.armor = 100; WeaponService.setArmor(c, 100); return true, nil
		elseif k == "shield1" then
			if i.shield >= 25 or not pay(ITEM_PRICE.shield1) then return false, nil end
			i.shield = 25; WeaponService.setShield(c, 25); return true, nil
		elseif k == "shield2" then
			if i.shield >= 50 or not pay(ITEM_PRICE.shield2) then return false, nil end
			i.shield = 50; WeaponService.setShield(c, 50); return true, nil
		elseif k == "kit" then
			if team ~= CT or i.kit or not V.bomb or not pay(ITEM_PRICE.kit) then return false, nil end
			i.kit = true; return true, nil
		elseif k == "frag" or k == "flash" or k == "smoke" or k == "mine" then
			-- limites du web : 1 frag, 2 flashs, 1 fumigène, 2 mines
			local s = table.clone(stockOf(c)) :: any
			local max = if k == "flash" then 2 elseif k == "mine" then Grenades.MINE.max else 1
			if (s[k] or 0) >= max or not pay(ITEM_PRICE[k]) then return false, nil end
			s[k] = (s[k] or 0) + 1
			GrenadeService.set(c, s.frag, s.flash, s.smoke, s.mine)
			local ii = i :: any; ii[k] = s[k]
			return true, nil
		end
		local w = Config.WEAPONS[k]
		if not w or not BUYABLE[k] then return false, nil end
		if d.pistol and w.slot == 0 then return false, "Manche au pistolet : pistolets uniquement" end
		if (w.slot == 0 and i.primary == k) or (w.slot == 1 and i.secondary == k) then return false, nil end
		if not pay(w.price) then return false, nil end
		if w.slot == 0 then i.primary = k else i.secondary = k end
		if MS().aliveChar(c) then
			WeaponService.giveLoadout(c, listOf(i))
			applyGear(c, i)
		end
		return true, nil
	end
	function M.buy(m: any, p: Player, k: string?): any
		if not m.data.inv then return nil end
		if variant == "gunfight" then return { closed = "Gunfight : pas de boutique, tout le monde a les mêmes armes (" .. tostring(m.data.kitName or "…") .. ")" } end
		local ok, msg = true, nil
		if k then ok, msg = doBuy(m, p, k); syncMoney(m, p) end
		local st = buyState(m, p)
		st.ok = ok; st.msg = msg
		return st
	end

	-- achats d'un bot (botBuy du web)
	local function botBuy(m: any, b: Model)
		if m.data.phase ~= "freeze" or not b.Parent or variant == "gunfight" then return end
		local i = inv(m, b)
		local function try(k: string) doBuy(m, b, k) end
		local aff = {}
		for _, k in ipairs(PRIMARIES) do if Config.WEAPONS[k].price <= i.money or free(m) then table.insert(aff, k) end end
		if not i.primary and #aff > 0 and not (m.settings.eco == 1 and i.money < 1800 and math.random() < 0.5) then
			local wt = { rifle = 5, smg = 2.4, sniper = 1, shotgun = 1, lmg = 0.5 }
			local tot, ws = 0, {}
			for _, k in ipairs(aff) do
				local w = if m.settings.diff <= 2 then 1 else (wt[Config.WEAPONS[k].cat] or 1) * (if k == "awp" then 0.8 else 1)
				table.insert(ws, w); tot += w
			end
			local r, ch = math.random() * tot, aff[1]
			for n, k in ipairs(aff) do r -= ws[n]; if r <= 0 then ch = k; break end end
			try(ch)
		elseif not i.primary and i.money >= 700 and math.random() < 0.5 then
			local l = { "p250", "fiveseven", "deagle" }; try(l[math.random(#l)])
		end
		if i.armor < 100 and i.money >= 650 and math.random() < 0.85 then try("armor") end
		if i.money >= 1000 and math.random() < 0.35 then try("shield2") elseif i.money >= 400 and math.random() < 0.4 then try("shield1") end
		if WeaponService.teamOf(b) == CT and i.money >= 400 and math.random() < 0.6 then try("kit") end
		if i.money >= 300 and math.random() < 0.55 then try("frag") end
		if i.money >= 300 and math.random() < 0.3 then try("smoke") end
		if i.money >= 200 and math.random() < 0.3 then try("flash") end
		if i.money >= ITEM_PRICE.mine and math.random() < 0.25 then try("mine") end
	end

	-- ---------- début de manche ----------
	local function botName(m: any): string
		local used = {}
		for _, team in ipairs({ T, CT }) do for _, n in ipairs(m.data.roster[team]) do used[n] = true end end
		local pool = shuffle(table.clone(ModeConfig.BOT.names))
		for _, n in ipairs(pool) do if not used[n] then return n end end
		local n = pool[1] .. " " .. math.random(10, 99)
		while used[n] do n = pool[1] .. " " .. math.random(10, 99) end
		return n
	end
	local function spawnRoster(m: any)
		for _, b in ipairs(BotService.ofMatch(m.id)) do BotService.remove(b) end
		for _, team in ipairs({ T, CT }) do
			local humans = 0
			for p in pairs(m.players) do if WeaponService.teamOf(p) == team then humans += 1 end end
			local want = if m.mod.noBots then 0 else math.max(0, m.settings.size - humans)
			local list = m.data.roster[team]
			while #list > want do
				local n = table.remove(list) :: string
				m.stats["bot:" .. n] = nil; m.data.inv["bot:" .. n] = nil
			end
			while #list < want do table.insert(list, botName(m)) end
			for _, n in ipairs(list) do
				local model = MS().spawnBot(m, team, n)
				MS().setTeam(m, model, team)
			end
		end
		BotService.freezeMatch(m.id, m.data.phase ~= "live")
	end

	-- postes des bots : attaquants autour du site prévu, défenseurs sur leurs positions de garde (plans du web)
	local function placeBots(m: any)
		local d = m.data
		d.hold = {}
		local site = d.sites[d.plan]
		local holdCT = m.map.data.holdCT or {}
		local ci = 0
		for _, b in ipairs(BotService.ofMatch(m.id)) do
			local key = "bot:" .. b.Name
			if b:GetAttribute("Team") == T then
				local a, r = math.random() * math.pi * 2, (2.5 * U) + math.random() * math.max(1, site.r - 3 * U)
				d.hold[key] = O.ground(m, site.pos + Vector3.new(math.cos(a) * r, 0, math.sin(a) * r))
			elseif #holdCT > 0 then
				ci += 1
				local h = holdCT[(ci - 1) % #holdCT + 1]
				local cx, cz = O.spot(m, h[1], h[2])
				d.hold[key] = O.ground(m, MS().cellToWorld(m, cx, cz))
			else
				ci += 1
				local s = d.sites[(ci - 1) % #d.sites + 1]
				d.hold[key] = s.pos
			end
		end
	end

	local function resetRound(m: any)
		local d = m.data
		d.round += 1
		d.pistol = not duelLike and (d.round == 1 or d.halfPistol)
		d.halfPistol = false
		d.phase = "freeze"; d.phaseEnd = now() + V.freeze; m.endsAt = d.phaseEnd
		d.revealed = false; d.use = {}; d.retake = {}; d.roam = {}
		local b = d.bomb
		b.carrier = nil; b.prog = 0; b.defProg = {}; b.pos = nil; b.site = nil; b.explodeAt = nil
		bombState(m, if V.bomb then "carried" else "none")
		showBomb(m, nil)
		-- Gunfight : nouvelles armes pour tout le monde toutes les 2 manches
		local newKit = false
		if variant == "gunfight" and (not d.kit or (d.round - 1) % (V.kitEvery or 2) == 0) then
			local prev = d.kit and d.kit.primary
			local pool = {}
			for _, k in ipairs(GF_PRIMARY) do if Config.WEAPONS[k] and k ~= prev then table.insert(pool, k) end end
			local prim = pool[math.random(#pool)]
			d.kit = { primary = prim, secondary = GF_PISTOL[math.random(#GF_PISTOL)], nade = if math.random() < 0.5 then "frag" else "flash" }
			d.kitName = Config.WEAPONS[prim].name .. " + " .. Config.WEAPONS[d.kit.secondary].name .. " + " .. (if d.kit.nade == "frag" then "grenade" else "flash")
			newKit = true
		end
		-- inventaire de la manche (web : resetRound, Duel : armes du profil, gilet)
		for _, e in ipairs(members(m)) do
			local i = invOf(m, e.key, e.team)
			if variant == "gunfight" then
				-- Gunfight : chacun repart avec le kit de la manche, même les survivants
				i.armor = 0; i.shield = 0; i.kit = false; i.frag = 0; i.flash = 0; i.smoke = 0; i.mine = 0
				i.primary = d.kit.primary; i.secondary = d.kit.secondary
				if d.kit.nade == "frag" then i.frag = 1 else i.flash = 1 end
			elseif not i.keep then
				i.armor = 0; i.shield = 0; i.kit = false; i.frag = 0; i.flash = 0; i.smoke = 0; i.mine = 0
				i.primary = nil; i.secondary = pistolOf(e.team)
				local p = if O.isPlayer(e.c) then e.c :: Player else nil
				local prim = p and p:GetAttribute("Primary")
				local sec = p and p:GetAttribute("Secondary")
				if variant == "duel" then
					if p then
						if typeof(prim) == "string" and Config.WEAPONS[prim] then i.primary = prim end
						if typeof(sec) == "string" and Config.WEAPONS[sec] then i.secondary = sec end
					end
					i.armor = 100
				elseif p then
					if not free(m) then
						if typeof(sec) == "string" and Config.WEAPONS[sec] and Config.WEAPONS[sec].price <= 300 then i.secondary = sec end
					else
						if typeof(prim) == "string" and Config.WEAPONS[prim] and not d.pistol then i.primary = prim end
						if typeof(sec) == "string" and Config.WEAPONS[sec] then i.secondary = sec end
						i.armor = 100
					end
				end
			end
			if free(m) or duelLike then i.money = 16000 end
			i.keep = false
		end
		-- points d'apparition : chaque équipe à son départ, une place chacun
		d.spawnQ = {}
		for _, team in ipairs({ T, CT }) do d.spawnQ[team] = shuffle(table.clone(if team == T then m.map.spawns.T else m.map.spawns.CT)) end
		d.plan = math.random(#d.sites)
		for p in pairs(m.players) do MS().respawn(m, p); syncMoney(m, p) end
		spawnRoster(m)
		placeBots(m)
		-- la bombe : un attaquant au hasard
		if V.bomb then
			local ts = {}
			for _, e in ipairs(members(m)) do if e.team == T then table.insert(ts, e) end end
			d.bombFor = if #ts > 0 then ts[math.random(#ts)].key else nil
		end
		-- les bots font leurs achats pendant la phase d'achat
		local round = d.round
		for _, bot in ipairs(BotService.ofMatch(m.id)) do
			task.delay(0.5 + math.random() * math.min(3.5, V.freeze - 1), function()
				if d.round == round and d.phase == "freeze" then botBuy(m, bot) end
			end)
		end
		if variant == "gunfight" then
			MS().announce(m, if newKit then "NOUVELLES ARMES" else "MANCHE " .. d.round, (if newKit then "Manche " .. d.round .. " · " else "") .. d.kitName, Color3.fromRGB(90, 209, 255))
		elseif variant == "duel" then
			MS().announce(m, "MANCHE " .. d.round, "Premier à " .. tostring(m.limit) .. " — touche B pour changer d'arme (" .. V.freeze .. " s)", PINK)
		elseif d.pistol then
			MS().announce(m, "MANCHE AU PISTOLET", "Pistolets uniquement — achète avec B (" .. V.freeze .. " s)", GOLD)
		else
			MS().announce(m, "MANCHE " .. d.round, "Phase d'achat — touche B (" .. V.freeze .. " s)", GOLD)
		end
	end

	local function goLive(m: any)
		local d = m.data
		d.phase = "live"; d.phaseEnd = now() + V.round; m.endsAt = d.phaseEnd
		for p in pairs(m.players) do freezeHum(p, false) end
		BotService.freezeMatch(m.id, false)
		MS().announce(m, "C'EST PARTI !", nil, O.WHITE)
	end

	-- mi-temps (Compétitif, Désamorçage rapide) : changement de camp après la manche limite - 1
	local function halfTimeDue(m: any): boolean
		local d = m.data
		local lim = m.limit or 0
		return V.half and not d.halfDone and lim > 1 and d.round == lim - 1 and (m.score[T] or 0) < lim and (m.score[CT] or 0) < lim
	end
	local function halfTime(m: any)
		local d = m.data
		d.halfDone = true
		for p in pairs(m.players) do MS().setTeam(m, p, O.other(WeaponService.teamOf(p) or T)) end
		d.roster[T], d.roster[CT] = d.roster[CT], d.roster[T]
		for _, i in pairs(d.inv) do
			i.keep = false
			if ecoOn(m) then i.money = ECO.start end
		end
		m.score[T], m.score[CT] = m.score[CT] or 0, m.score[T] or 0
		d.loss = { [T] = 0, [CT] = 0 }
		d.halfPistol = true
	end

	-- ---------- interface du mode ----------
	function M.setup(m: any)
		local d = m.data
		m.timed = true
		d.phase = "pre"; d.phaseEnd = math.huge; d.round = 0; d.pistol = false; d.halfDone = false; d.halfPistol = false
		d.nadeT = {}; d.mineT = {}
		d.loss = { [T] = 0, [CT] = 0 }; d.inv = {}; d.roster = { [T] = {}, [CT] = {} }; d.use = {}; d.hold = {}; d.retake = {}; d.roam = {}
		d.sites = O.sites(m); d.plan = 1; d.started = false; d.over = false
		d.bomb = { state = "none", carrier = nil, prog = 0, defProg = {}, pos = nil, site = nil, explodeAt = nil, lastPos = nil }
		d.bombModel = nil
		d.public = { kind = "rounds", variant = variant }
	end
	function M.start(m: any)
		local d = m.data
		d.started = true
		for _, b in ipairs(BotService.ofMatch(m.id)) do
			local team = b:GetAttribute("Team")
			if team == T or team == CT then table.insert(d.roster[team], b.Name) end
		end
		resetRound(m)
	end
	function M.botsWanted(m: any, _team: string?, want: number): number?
		if m.data.started then return nil end      -- pendant les manches, les bots sont recréés à chaque manche
		return want
	end
	function M.canRespawn(_m: any, _c: any): boolean return false end
	function M.spawnPoint(m: any, c: any): Vector3?
		local q = m.data.spawnQ and m.data.spawnQ[WeaponService.teamOf(c) or ""]
		if q and #q > 0 then return table.remove(q) end
		local l = if WeaponService.teamOf(c) == T then m.map.spawns.T else m.map.spawns.CT
		return if #l > 0 then l[math.random(#l)] else nil
	end
	function M.loadout(m: any, c: any): { string }?
		if not m.data.inv then return nil end
		return listOf(inv(m, c))
	end
	function M.onSpawn(m: any, c: any, char: Model)
		if not m.data.inv then return end
		char:SetAttribute("ProtectedUntil", 0)     -- pas de protection d'apparition dans une manche
		applyGear(c, inv(m, c)); applyNades(c, inv(m, c))
		if m.data.phase == "freeze" or m.data.phase == "pre" then
			freezeHum(c, true)
			if not O.isPlayer(c) then BotService.freezeMatch(m.id, true) end
		end
		if O.isPlayer(c) then syncMoney(m, c) end
	end
	function M.onKill(m: any, killer: any, victim: any, key: string, _hs: boolean, ks: any, vs: any): boolean
		local d = m.data
		if ks and ks ~= vs and ks.team ~= vs.team then
			local i = inv(m, killer)
			local w = Config.WEAPONS[key]
			i.money = math.min(cap(m), i.money + (if ecoOn(m) then ECO.kill else (w and w.kill or 300)))
			if O.isPlayer(killer) then syncMoney(m, killer) end
		end
		if d.bomb.carrier == victim then dropBomb(m, nil) end
		if typeof(victim) == "Instance" and victim:IsA("Model") then victim:SetAttribute("Busy", nil) end
		return true     -- les éliminations ne marquent pas : on compte les manches
	end
	function M.useKey(m: any, p: Player, on: boolean) m.data.use[p] = if on then true else nil end

	-- grenades et mines des bots, aux mêmes moments que le web (src/70_ai.js botUpdate, src/63_agents.js agentBot) :
	-- en combat, flash entre 9 et 24 m, fumigène quand il est blessé ; hors combat, frag sur la dernière position vue
	-- (moins de 4 s, entre 9 et 26 m) ; mine de temps en temps quand il ne se bat pas
	local function botNades(m: any, dt: number)
		local d = m.data
		local diff = Modes.DIFFS[m.settings.diff] or Modes.DIFFS[3]
		local t = now()
		for _, bot in ipairs(BotService.ofMatch(m.id)) do
			local r = O.root(bot)
			if not r or bot:GetAttribute("Frozen") then continue end
			local s = GrenadeService.get(bot)
			if not s then continue end
			local key = bot.Name
			local target, seen, ago = BotService.combatOf(bot)
			local tr = target and target:FindFirstChild("HumanoidRootPart") :: BasePart?
			if t > (d.nadeT[key] or 0) then
				if tr then
					local dist = O.flat(tr.Position, r.Position) / U
					local hum = bot:FindFirstChildOfClass("Humanoid")
					if s.flash > 0 and dist > 9 and dist < 24 and math.random() < dt * 0.5 * diff.nade then
						d.nadeT[key] = t + 4; WeaponService.throwGrenade(bot, "flash", false, tr.Position)
					elseif s.smoke > 0 and hum and hum.Health < 40 and dist > 6 and math.random() < dt * 1.2 * diff.nade then
						d.nadeT[key] = t + 6; WeaponService.throwGrenade(bot, "smoke", false, r.Position:Lerp(tr.Position, 0.35))
					end
				elseif s.frag > 0 and seen and ago < 4 then
					local dd = O.flat(seen, r.Position) / U
					if dd > 9 and dd < 26 and math.random() < dt * 0.8 * diff.nade then
						d.nadeT[key] = t + 5; WeaponService.throwGrenade(bot, "frag", false, seen)
					end
				end
			end
			d.mineT[key] = (d.mineT[key] or (1.5 + math.random() * 2)) - dt
			if d.mineT[key] <= 0 then
				d.mineT[key] = 1.5 + math.random() * 2
				if not target and s.mine > 0 and math.random() < 0.18 then WeaponService.placeMine(bot) end
			end
		end
	end

	function M.tick(m: any, dt: number)
		local d = m.data
		if not d.started then return end
		local t = now()
		if d.phase == "freeze" then
			m.endsAt = d.phaseEnd
			if t >= d.phaseEnd then goLive(m) end
		elseif d.phase == "live" then
			pcall(botNades, m, dt)
			local b = d.bomb
			-- la bombe va à son porteur dès qu'il est apparu
			if V.bomb and b.state == "carried" and not b.carrier and d.bombFor then
				local c = if typeof(d.bombFor) == "string" then nil else d.bombFor
				if not c then
					for _, bot in ipairs(BotService.ofMatch(m.id)) do if "bot:" .. bot.Name == d.bombFor then c = bot end end
				end
				if c and O.root(c) then giveBomb(m, c) else
					local ts = O.alive(m, T)
					if #ts > 0 then giveBomb(m, ts[math.random(#ts)]) end
				end
				d.bombFor = nil
			end
			if V.bomb then
				if b.state == "carried" and b.carrier then
					local r = O.root(b.carrier)
					if not r then dropBomb(m, nil)
					else
						b.lastPos = O.feet(r)
						local c = b.carrier
						local site = siteAt(m, b.lastPos)
						local isBot = not O.isPlayer(c)
						local holding = site ~= nil and (if isBot then true else d.use[c] == true)
						if isBot then c:SetAttribute("Busy", if site then true else nil) end
						if holding then
							b.prog += dt
							if b.prog >= PLANT_T then
								-- bombe posée
								b.prog = 0
								local ch = WeaponService.charOf(c)
								if ch then ch:SetAttribute("HasBomb", nil) end
								if isBot then c:SetAttribute("Busy", nil) end
								b.carrier = nil
								b.pos = O.groundBelow(m, b.lastPos); b.site = site.n
								b.explodeAt = t + BOMB_T
								bombState(m, "planted")
								showBomb(m, b.pos)
								local model = bombModel(m)
								model:SetAttribute("Site", site.n); model:SetAttribute("ExplodeAt", workspace:GetServerTimeNow() + BOMB_T)
								local s = m.stats[MS().keyOf(c)]
								if s then (s :: any).plants = ((s :: any).plants or 0) + 1; s.score += 300 end
								if O.isPlayer(c) then require(script.Parent.Parent.RewardService).missionEvent(c, "site_" .. string.lower(tostring(site.n))) end   -- défis « site A / B »
								if ecoOn(m) then
									for _, e in ipairs(members(m)) do
										if e.team == T then
											local i = invOf(m, e.key, e.team); i.money = math.min(ECO.max, i.money + ECO.plant)
											if O.isPlayer(e.c) then syncMoney(m, e.c) end
										end
									end
								else
									local i = inv(m, c); i.money = math.min(16000, i.money + 300)
									if O.isPlayer(c) then syncMoney(m, c) end
								end
								MS().announce(m, "BOMBE POSÉE", "Site " .. site.n, Color3.fromRGB(255, 185, 56))
								-- les défenseurs bots se replacent autour de la bombe
								for _, bot in ipairs(BotService.ofMatch(m.id)) do
									if bot:GetAttribute("Team") == CT then
										local a, rr = math.random() * math.pi * 2, (5 + math.random() * 5) * U
										d.retake["bot:" .. bot.Name] = O.ground(m, b.pos + Vector3.new(math.cos(a) * rr, 0, math.sin(a) * rr))
									end
								end
							end
						else
							b.prog = 0
						end
						if O.isPlayer(c) then
							setAttr(c, "UseHint", if site and not holding then "Maintenez E : poser la bombe" else nil)
							setAttr(c, "UseMsg", if holding then "POSE DE LA BOMBE" else nil)
							setAttr(c, "UseProg", if holding then math.clamp(b.prog / PLANT_T, 0, 1) else nil)
						end
					end
				elseif b.state == "dropped" and b.pos then
					-- un attaquant qui passe dessus la ramasse ; le bot le plus proche va la chercher
					local best, bd = nil, math.huge
					for _, c in ipairs(O.alive(m, T)) do
						local r = O.root(c) :: BasePart
						local dd = O.flat(O.feet(r), b.pos)
						if dd < PICK_R and math.abs(O.feet(r).Y - b.pos.Y) < 2 * U then giveBomb(m, c); break end
						if not O.isPlayer(c) and dd < bd then best, bd = c, dd end
					end
					d.fetcher = best
				elseif b.state == "planted" and b.pos then
					m.endsAt = b.explodeAt
					-- désamorçage : le défenseur bot le plus proche y va ; un joueur maintient E à côté
					local best, bd = nil, math.huge
					local busy = {}
					for _, c in ipairs(O.alive(m, CT)) do
						local r = O.root(c) :: BasePart
						local dd = O.flat(O.feet(r), b.pos)
						local isBot = not O.isPlayer(c)
						if isBot and dd < bd then best, bd = c, dd end
						local near = dd < DEFUSE_R and math.abs(O.feet(r).Y - b.pos.Y) < 1.5 * U + 1
						local key = MS().keyOf(c)
						local holding = near and (if isBot then c == d.defuser else d.use[c] == true)
						local need = if inv(m, c).kit then DEFUSE_T / 2 else DEFUSE_T
						if isBot then c:SetAttribute("Busy", if holding then true else nil) end
						if holding then
							busy[key] = true
							b.defProg[key] = (b.defProg[key] or 0) + dt
							if b.defProg[key] >= need then
								-- bombe désamorcée
								local i = inv(m, c); i.money = math.min(cap(m), i.money + (if ecoOn(m) then ECO.defuse else 300))
								if O.isPlayer(c) then syncMoney(m, c) end
								local s = m.stats[key]
								if s then (s :: any).defuses = ((s :: any).defuses or 0) + 1; s.score += 300 end
								bombState(m, "defused"); showBomb(m, nil)
								endRound(m, CT, "Bombe désamorcée")
								return
							end
						end
						if O.isPlayer(c) then
							setAttr(c, "UseHint", if near and not holding then "Maintenez E : désamorcer" else nil)
							setAttr(c, "UseMsg", if holding then "DÉSAMORÇAGE" else nil)
							setAttr(c, "UseProg", if holding then math.clamp((b.defProg[key] or 0) / need, 0, 1) else nil)
						end
					end
					for k in pairs(b.defProg) do if not busy[k] then b.defProg[k] = nil end end
					d.defuser = best
					if t >= b.explodeAt then
						-- explosion : dégâts autour (240 au centre, nuls à 16 m), puis fin de manche
						bombState(m, "exploded"); showBomb(m, nil)
						local ex = Instance.new("Explosion"); ex.Position = b.pos; ex.BlastRadius = 6 * U; ex.BlastPressure = 0
						ex.DestroyJointRadiusPercent = 0; ex.Parent = m.map.folder
						for _, c in ipairs(O.alive(m)) do
							local r = O.root(c)
							local dist = r and O.flat(r.Position, b.pos) / U or math.huge
							if r and dist < 16 then
								WeaponService.applyDamage(nil, r.Parent :: Model, math.floor(240 * (1 - dist / 16) + 0.5), false, "bomb", 1)
							end
						end
						endRound(m, T, "La bombe a explosé")
						return
					end
				end
			end
			-- duel : positions révélées à 20 s de la fin
			if duelLike and not d.revealed and d.phaseEnd - t <= (V.reveal or REVEAL) then
				d.revealed = true
				d.roam = {}
				MS().announce(m, "POSITIONS RÉVÉLÉES", "Plus que " .. (V.reveal or REVEAL) .. " s", PINK)
			end
			if b.state ~= "planted" then
				m.endsAt = d.phaseEnd
				if t >= d.phaseEnd then endRound(m, CT, "Temps écoulé") end
			end
			checkAlive(m)
			-- les autres joueurs : rien à faire avec E
			for p in pairs(m.players) do
				if p ~= b.carrier and not (b.state == "planted" and WeaponService.teamOf(p) == CT) then
					setAttr(p, "UseHint", nil); setAttr(p, "UseMsg", nil); setAttr(p, "UseProg", nil)
				end
			end
		elseif d.phase == "end" then
			m.endsAt = d.phaseEnd
			if t >= d.phaseEnd then
				local lim = m.limit or 1
				if (m.score[T] or 0) >= lim or (m.score[CT] or 0) >= lim then
					d.over = true
					d.winner = if (m.score[T] or 0) >= lim then T else CT
					m.endsAt = t + 60
				elseif halfTimeDue(m) then
					halfTime(m)
					resetRound(m)
					for p in pairs(m.players) do
						MS().announce(m, "MI-TEMPS", "Changement de camp — vous êtes maintenant " .. teamWord(WeaponService.teamOf(p) or T)
							.. (if d.pistol then " · manche au pistolet" else ""), GOLD, p)
					end
				else
					resetRound(m)
				end
			end
		end
		-- pour le HUD (ModeHud) : phase, manche, bombe, sites
		local b = d.bomb
		local carrierName = nil
		if b.carrier then local s = m.stats[MS().keyOf(b.carrier)]; carrierName = s and s.name end
		local sites = {}
		for _, s in ipairs(d.sites) do table.insert(sites, { n = s.n, pos = s.pos, r = s.r }) end
		d.public = {
			kind = "rounds", variant = variant, phase = d.phase, round = d.round, pistol = d.pistol, limit = m.limit, bombMode = V.bomb,
			left = if d.phaseEnd < math.huge then math.max(0, d.phaseEnd - t) else 0, freeze = V.freeze, half = d.halfDone,
			bomb = { state = b.state, site = b.site, pos = b.pos, carrier = carrierName, left = if b.explodeAt then math.max(0, b.explodeAt - t) else nil },
			sites = sites, revealed = d.revealed, lastWin = d.lastWin, lastReason = d.lastReason, kit = d.kitName,
		}
	end

	function M.checkEnd(m: any): (boolean, any)
		if m.data.over then return true, m.data.winner end
		return false, nil
	end
	function M.timeUp(m: any): any
		local a, b = m.score[T] or 0, m.score[CT] or 0
		return if a > b then T elseif b > a then CT else nil
	end

	-- où vont les bots (botGoal du web, et la traque du duel)
	function M.botGoal(m: any, bot: Model): Vector3?
		local d = m.data
		if not d.started or d.phase ~= "live" then return nil end
		local key = "bot:" .. bot.Name
		local team = (bot:GetAttribute("Team") :: string?) or T
		local root = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
		if not root then return nil end
		if not V.bomb then
			local r = d.roam[key]
			if not r or now() > r.t or O.flat(r.pos, root.Position) < 1.6 * U then
				local foes = O.alive(m, O.other(team))
				local pos: Vector3? = nil
				if #foes > 0 then
					local fr = O.root(foes[math.random(#foes)])
					local s = (if d.revealed then 3 else 10) * U
					if fr then pos = fr.Position + Vector3.new((math.random() * 2 - 1) * s, 0, (math.random() * 2 - 1) * s) end
				end
				if not pos and #m.roam > 0 then pos = m.roam[math.random(#m.roam)] end
				r = { pos = pos or root.Position, t = now() + 4 + math.random() * 3 }
				d.roam[key] = r
			end
			return r.pos
		end
		local b = d.bomb
		if team == T then
			if b.state == "dropped" and d.fetcher == bot and b.pos then return b.pos end
			if b.state == "carried" and b.carrier == bot then
				local s = d.sites[d.plan]
				return s and s.pos
			end
			return d.hold[key]
		end
		if b.state == "planted" and b.pos then
			if d.defuser == bot then return b.pos end
			return d.retake[key] or b.pos
		end
		return d.hold[key]
	end

	function M.info(m: any): any
		local d = m.data
		local col = m.def.c
		if not d.started then return { line = "Premier à " .. tostring(m.limit) .. " manches", color = col } end
		local sub = "Premier à " .. tostring(m.limit) .. " manches" .. (if V.half and not d.halfDone and (m.limit or 0) > 1 then " · mi-temps après la manche " .. ((m.limit or 1) - 1) else "")
		if variant == "gunfight" and d.kitName then sub = d.kitName .. " · " .. sub end
		if d.phase == "freeze" then
			local line = if variant == "gunfight" then "MANCHE " .. d.round .. " — " .. string.upper(tostring(d.kitName))
				elseif variant == "duel" then "MANCHE " .. d.round .. " — CHOISIS TON ARME (B)"
				elseif d.pistol then "MANCHE AU PISTOLET — PHASE D'ACHAT (B)" else "MANCHE " .. d.round .. " — PHASE D'ACHAT (B)"
			return { line = line, sub = sub, color = GOLD }
		elseif d.phase == "end" then
			return { line = "MANCHE " .. d.round .. " : VICTOIRE DES " .. teamWord(d.lastWin or T), sub = d.lastReason, color = O.COL[d.lastWin or T] }
		end
		local b = d.bomb
		if b.state == "planted" then
			return { line = "💣 BOMBE POSÉE — SITE " .. (b.site or "?"), sub = "Explosion dans " .. math.max(0, math.ceil((b.explodeAt or 0) - now())) .. " s", subWarn = true, color = Color3.fromRGB(255, 185, 56) }
		elseif b.state == "dropped" then
			return { line = "MANCHE " .. d.round .. " — 💣 BOMBE LÂCHÉE", sub = sub, color = Color3.fromRGB(255, 185, 56) }
		elseif duelLike and d.revealed then
			return { line = "MANCHE " .. d.round .. " — POSITIONS RÉVÉLÉES", sub = sub, color = PINK }
		end
		return { line = "MANCHE " .. d.round, sub = sub, color = col }
	end

	local function clearPlayer(p: Player)
		for _, a in ipairs({ "Money", "UseProg", "UseMsg", "UseHint" }) do p:SetAttribute(a, nil) end
		if p.Character then p.Character:SetAttribute("HasBomb", nil) end
	end
	function M.onLeave(m: any, p: Player)
		clearPlayer(p)
		if m.data.use then m.data.use[p] = nil end
		if m.data.bomb and m.data.bomb.carrier == p then dropBomb(m, nil) end
	end
	function M.cleanup(m: any)
		for p in pairs(m.players) do clearPlayer(p) end
		WeaponService.clearGrenades(m.id)
		local model = m.data.bombModel
		if model then model:Destroy() end
		m.data.bombModel = nil
	end

	local _ = Players
	return M
end

return Rounds
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="453">
        <Properties>
          <string name="Name">shp</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/shp : Arme tournante (web : src/8Ze_tournante.js). Chacun pour soi, tout le monde a la MÊME arme, tirée au sort
-- toutes les 30 s parmi pistolets, PM, fusils à pompe, fusils, fusils de précision et mitrailleuses (jamais une des 4 dernières).
-- Réserve illimitée, pas de grenades. Premier à la limite d'éliminations.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local WeaponService = require(script.Parent.Parent.WeaponService)

local EVERY = 30
local CATS = { pistol = true, smg = true, shotgun = true, rifle = true, sniper = true, lmg = true }
local M = {}
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end

local function pool(): { string }
	local l = {}
	for k, w in pairs(Config.WEAPONS) do
		if not w.melee and (w.slot == 0 or w.slot == 1) and (w.price or 0) > 0 and CATS[w.cat or ""] then table.insert(l, k) end
	end
	table.sort(l)
	return l
end
local function pick(m: any): string
	local all = pool()
	local free = {}
	for _, k in ipairs(all) do if not table.find(m.data.last, k) then table.insert(free, k) end end
	local list = if #free > 0 then free else all
	local k = list[math.random(#list)]
	table.insert(m.data.last, k); if #m.data.last > 4 then table.remove(m.data.last, 1) end
	return k
end
local function equip(m: any, c: any)
	if not MS().aliveChar(c) then return end
	WeaponService.giveLoadout(c, { m.data.key, "knife" })
	WeaponService.setReserve(c, m.data.key, 999)
end
local function roll(m: any, first: boolean)
	m.data.key = pick(m); m.data.t = EVERY
	m.data.public = { weapon = m.data.key }
	for _, c in ipairs(MS().combatants(m)) do equip(m, c) end
	if not first then MS().announce(m, "NOUVELLE ARME", Config.WEAPONS[m.data.key].name, Color3.fromRGB(255, 169, 77)) end
end

function M.setup(m: any) m.data.last = {}; roll(m, true) end
function M.loadout(m: any, _c: any): { string } return { m.data.key, "knife" } end
function M.onSpawn(m: any, c: any) task.defer(function() WeaponService.setReserve(c, m.data.key, 999); WeaponService.giveGrenades(c, 0, 0, 0, 0) end) end
function M.tick(m: any, dt: number)
	m.data.t -= dt
	if m.data.t <= 0 then roll(m, false) end
end
function M.info(m: any): any
	local s = math.max(0, math.ceil(m.data.t or 0))
	return { line = "🎲 " .. string.upper(Config.WEAPONS[m.data.key] and Config.WEAPONS[m.data.key].name or "—"),
		sub = "nouvelle arme dans " .. s .. " s", subWarn = s <= 5, color = Color3.fromRGB(255, 169, 77) }
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="454">
        <Properties>
          <string name="Name">survolte</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/survolte : Survolté (« Cranked » de Call of Duty). Match à mort par équipe, réapparition en 3 s, 1 point par
-- élimination, première équipe à la limite (25 / 40 / 60) ou meilleur score au bout des 8 minutes (MatchService).
-- Après une élimination, le tueur est SURVOLTÉ : il court 20 % plus vite (attribut SpeedMult, lu par le mouvement et les
-- bots) mais il a 30 s pour éliminer à nouveau, sinon il explose. Chaque nouvelle élimination remet le compte à 30 s.
-- Être éliminé ou exploser enlève l'état survolté. Les bots survoltés foncent vers l'adversaire le plus proche.
local WeaponService = require(script.Parent.Parent.WeaponService)
local O = require(script.Parent.objutil)

local LIMIT, SPEED = 30, 1.2
local PINK = Color3.fromRGB(255, 90, 209)
local M = {}
local function MS(): any return O.MS() end
local function now(): number return os.clock() end

-- état survolté visible : halo rose, vitesse, ligne personnelle du HUD
local function look(c: any, on: boolean)
	local ch = WeaponService.charOf(c)
	if not ch then return end
	local h = ch:FindFirstChild("CrankGlow")
	if on and not h then
		local hl = Instance.new("Highlight"); hl.Name = "CrankGlow"; hl.FillColor = PINK; hl.FillTransparency = 0.75
		hl.OutlineColor = PINK; hl.OutlineTransparency = 0.3; hl.DepthMode = Enum.HighlightDepthMode.Occluded; hl.Parent = ch
	elseif not on and h then h:Destroy() end
	-- vitesse : multipliée par-dessus celle d'avant (modificateur Turbo compris), rendue telle quelle à la fin
	local base = ch:GetAttribute("CrankBase")     -- présent = déjà survolté ; 0 = pas de multiplicateur avant
	local was = base ~= nil
	if O.isPlayer(c) and not on then (c :: Player):SetAttribute("ModeLine", nil) end
	if was == on then return end
	local hum = ch:FindFirstChildOfClass("Humanoid")
	if hum and not O.isPlayer(c) then   -- le joueur, lui, applique SpeedMult dans son mouvement
		hum.WalkSpeed = if on then hum.WalkSpeed * SPEED else hum.WalkSpeed / SPEED
	end
	if on then
		local cur = ch:GetAttribute("SpeedMult")
		local mult = if typeof(cur) == "number" then cur else 1
		ch:SetAttribute("CrankBase", if typeof(cur) == "number" then cur else 0)
		ch:SetAttribute("SpeedMult", mult * SPEED)
	else
		ch:SetAttribute("SpeedMult", if typeof(base) == "number" and base > 0 then base else nil)
		ch:SetAttribute("CrankBase", nil)
	end
end
local function clear(m: any, c: any)
	local k = MS().keyOf(c)
	if m.data.cr[k] then m.data.cr[k] = nil end
	m.data.warn[k] = nil
	look(c, false)
end
-- explosion : vraie élimination sans tueur (comptée comme une mort, réapparition normale)
local function explode(m: any, c: any)
	local ch = MS().aliveChar(c)
	clear(m, c)
	if not ch then return end
	local r = ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	if r then
		local e = Instance.new("Explosion"); e.Position = r.Position; e.BlastPressure = 0; e.BlastRadius = 6
		e.DestroyJointRadiusPercent = 0; e.ExplosionType = Enum.ExplosionType.NoCraters; e.Parent = m.map and m.map.folder or workspace
	end
	ch:SetAttribute("ProtectedUntil", 0)
	WeaponService.applyDamage(nil, ch, 9999, false, "bomb", 1)
	if O.isPlayer(c) then O.pop(c, "💥 TU AS EXPLOSÉ — élimine plus vite !", O.BAD, "click") end
end

function M.setup(m: any)
	m.data.cr = {}; m.data.warn = {}
	m.data.public = { kind = "survolte" }
end
function M.onKill(m: any, killer: any, victim: any, _key: string, _hs: boolean, ks: any, vs: any): boolean
	clear(m, victim)
	if not ks or ks == vs or ks.team == vs.team then return false end
	m.data.cr[ks.key] = now() + LIMIT
	m.data.warn[ks.key] = nil
	look(killer, true)
	if O.isPlayer(killer) then O.pop(killer, "⏱ SURVOLTÉ ! 30 s pour éliminer à nouveau", PINK, "pickup") end
	return false     -- MatchService compte le point de l'élimination
end
function M.tick(m: any, _dt: number)
	local t = now()
	for _, c in ipairs(MS().combatants(m)) do
		local k = MS().keyOf(c)
		local dl = m.data.cr[k]
		if dl then
			if not MS().aliveChar(c) then clear(m, c)
			elseif t >= dl then explode(m, c)
			else
				local left = math.ceil(dl - t)
				if O.isPlayer(c) then
					(c :: Player):SetAttribute("ModeLine", "⏱ SURVOLTÉ — " .. left .. " s pour éliminer")
					if left <= 10 and (m.data.warn[k] or 99) > 10 then O.pop(c, "⚠ PLUS QUE 10 S !", O.BAD, "click") end
					if left <= 5 and (m.data.warn[k] or 99) > 5 then O.pop(c, "⚠ 5 S !", O.BAD, "click") end
				end
				m.data.warn[k] = left
			end
		end
	end
end
-- bots survoltés : vers l'ennemi vivant le plus proche (sinon leur comportement habituel)
function M.botGoal(m: any, bot: Model): Vector3?
	if not m.data.cr["bot:" .. bot.Name] then return nil end
	local r = bot:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not r then return nil end
	local team = WeaponService.teamOf(bot)
	local best, bd = nil, math.huge
	for _, c in ipairs(O.alive(m)) do
		if WeaponService.teamOf(c) ~= team then
			local cr = O.root(c)
			if cr then
				local d = O.flat(cr.Position, r.Position)
				if d < bd then best, bd = cr.Position, d end
			end
		end
	end
	return best
end
function M.info(m: any): any
	local n = 0
	for _ in pairs(m.data.cr) do n += 1 end
	return { line = "⏱ SURVOLTÉ — élimine toutes les 30 s ou explose", sub = (if n > 0 then n .. " survolté(s) en ce moment · " else "") .. "premier à " .. tostring(m.limit),
		color = PINK, kind = "survolte" }
end
function M.onLeave(m: any, p: Player)
	if m.data.cr then m.data.cr[p] = nil end
	p:SetAttribute("ModeLine", nil)
end
function M.cleanup(m: any)
	for _, c in ipairs(MS().combatants(m)) do look(c, false) end
	for p in pairs(m.players) do p:SetAttribute("ModeLine", nil) end
	m.data.cr = {}
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="455">
        <Properties>
          <string name="Name">tdm</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/tdm : Match à mort par équipe (web : MODES.tdm). Deux équipes, réapparition en 3 s, 1 point par élimination,
-- première équipe à la limite (20 / 30 / 40 / 60) ou meilleur score à la fin des 8 minutes. Tout est fait par MatchService.
return {}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="456">
        <Properties>
          <string name="Name">train</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/train : Entraînement (web : src/61_variants.js trPlaceDummies / trUpdate / variantKill, src/8Za_train.js).
-- Stand de tir sans limite de temps : des silhouettes fixes (s), mobiles (m, va-et-vient de 5 m) et surgissantes (p,
-- 2,6 s visibles puis 1,2 s cachées). Touche = +100 (+150 à la tête) + bonus de série (5 par cible, 100 au plus) ;
-- elles reviennent après 0,7 à 1,4 s. Réserve illimitée. Le chrono compte le temps passé ; « Terminer » affiche le bilan.
-- Temps de réaction (port Roblox) : délai entre la réapparition d'une cible et sa chute (moyenne des 10 dernières,
-- meilleur temps) ; records du joueur (score, précision, réaction) gardés dans le profil par CareerService.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local WeaponService = require(script.Parent.Parent.WeaponService)

local U = Config.STUDS_PER_METER
local M = {}
M.noBots = true
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end
local popEvent = ReplicatedStorage:FindFirstChild("ModePop") :: RemoteEvent?
if not popEvent then
	local e = Instance.new("RemoteEvent"); e.Name = "ModePop"; e.Parent = ReplicatedStorage; popEvent = e
end

type Dummy = { kind: string, home: Vector3, model: Model?, ph: number, popT: number, up: boolean, n: number, upAt: number? }
local function CS(): any return require(script.Parent.Parent.CareerService) :: any end
local RT_MAX = 3            -- au-delà de 3 s, la cible n'a pas été vue : le temps ne compte pas

local function newModel(m: any, d: Dummy): Model
	local desc = Instance.new("HumanoidDescription")
	desc.HeadColor = Color3.fromRGB(230, 200, 160); desc.TorsoColor = Color3.fromRGB(200, 70, 60)
	desc.LeftArmColor = desc.HeadColor; desc.RightArmColor = desc.HeadColor
	desc.LeftLegColor = Color3.fromRGB(60, 60, 70); desc.RightLegColor = desc.LeftLegColor
	local model = Players:CreateHumanoidModelFromDescription(desc, Enum.HumanoidRigType.R15)
	model.Name = "Cible " .. d.n
	model:SetAttribute("MatchId", m.id); model:SetAttribute("Team", "cible"); model:SetAttribute("Dummy", true)
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.BreakJointsOnDeath = false
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	root.Anchored = true
	model:PivotTo(CFrame.new(d.home + Vector3.new(0, 3, 0)))
	model.Parent = m.map.folder
	return model
end

local function place(m: any)
	local list = m.map.data.targets
	if not list or #list == 0 then
		list = {}
		for i, c in ipairs(m.map.data.roam or {}) do table.insert(list, { c[1], c[2], ({ "s", "m", "p" })[(i - 1) % 3 + 1] }) end
	end
	m.data.dummies = {}
	for i, tg in ipairs(list) do
		local d: Dummy = { kind = tg[3] or "s", home = MS().cellToWorld(m, tg[1], tg[2]), model = nil, ph = math.random() * 6, popT = 0, up = true, n = i }
		d.model = newModel(m, d)
		table.insert(m.data.dummies, d)
	end
end

function M.setup(m: any)
	m.data.tr = { score = 0, streak = 0, best = 0, hits = 0, t = 0, rts = {}, rtBest = nil, rec = nil }
	m.limit = nil
	place(m)
end
function M.onSpawn(_m: any, c: any)
	task.defer(function() local k = WeaponService.current(c); if k then WeaponService.setReserve(c, k, 999) end end)
end
function M.onKill(m: any, killer: any, victim: any, _key: string, headshot: boolean, ks: any, _vs: any): boolean
	if typeof(victim) ~= "Instance" or not victim:GetAttribute("Dummy") then return true end
	m.stats[MS().keyOf(victim)] = nil       -- les cibles n'apparaissent pas au tableau
	local tr = m.data.tr
	tr.hits += 1; tr.streak += 1; tr.best = math.max(tr.best, tr.streak)
	local pts = (if headshot then 150 else 100) + math.min(100, tr.streak * 5)
	tr.score += pts
	if ks then ks.pts = tr.score end
	if typeof(killer) == "Instance" and killer:IsA("Player") and popEvent then
		popEvent:FireClient(killer, (if headshot then "TÊTE ! " else "") .. "+" .. pts, Color3.fromRGB(255, 215, 94), "pickup")
	end
	for _, d in ipairs(m.data.dummies :: { Dummy }) do
		if d.model == victim then
			-- temps de réaction : depuis la réapparition de la cible (pas les cibles posées au départ)
			if d.upAt then
				local rt = os.clock() - d.upAt
				if rt > 0.05 and rt < RT_MAX then
					table.insert(tr.rts, rt); if #tr.rts > 10 then table.remove(tr.rts, 1) end
					tr.rtBest = math.min(tr.rtBest or rt, rt)
				end
			end
			d.popT = 0.7 + math.random() * 0.7; d.up = false; d.upAt = nil
		end
	end
	-- records du joueur (score, précision à partir de 30 tirs, réaction moyenne à partir de 5 cibles)
	if typeof(killer) == "Instance" and killer:IsA("Player") then
		local st = m.stats[killer]
		local acc = if st and st.shots >= 30 then math.floor(math.min(1, st.hits / st.shots) * 100 + 0.5) else nil
		local avg: number? = nil
		if #tr.rts >= 5 then local s = 0; for _, v in ipairs(tr.rts) do s += v end; avg = s / #tr.rts end
		local okR, beat = pcall(function() return CS().trainRecord(killer, { score = tr.score, acc = acc, rt = avg, rtBest = tr.rtBest }) end)
		if okR and beat and not tr.recShown and tr.score >= 1000 and popEvent then
			tr.recShown = true
			popEvent:FireClient(killer, "NOUVEAU RECORD !", Color3.fromRGB(125, 255, 159), "pickup")
		end
	end
	return true
end
function M.tick(m: any, dt: number)
	local tr = m.data.tr
	tr.t += dt
	local t = os.clock()
	for _, d in ipairs(m.data.dummies :: { Dummy }) do
		local model = d.model
		local hum = model and model:FindFirstChildOfClass("Humanoid")
		local alive = hum ~= nil and hum.Health > 0 and d.up
		if d.kind == "m" and alive and model then
			local x = math.sin(t * 0.9 + d.ph) * 5 * U
			local dir = if math.cos(t * 0.9 + d.ph) > 0 then -90 else 90
			model:PivotTo(CFrame.new(d.home + Vector3.new(x, 3, 0)) * CFrame.Angles(0, math.rad(dir), 0))
		end
		if d.kind == "p" and alive then
			d.ph += dt
			if d.ph > 2.6 then d.up = false; d.ph = 0; d.popT = 1.2; if model then model.Parent = nil end end
		end
		if not d.up then
			d.popT -= dt
			if d.popT <= 0 then
				if model and (not hum or hum.Health <= 0) then model:Destroy(); model = nil end
				if model then model.Parent = m.map.folder; d.up = true
				else d.model = newModel(m, d); d.up = true end
				d.ph = 0; d.upAt = os.clock()
			end
		end
	end
	-- un tir raté remet la série à zéro (comme le web)
	local shots = 0
	for p in pairs(m.players) do local st = m.stats[p]; if st then shots += st.shots end end
	local misses = math.max(0, shots - tr.hits)
	if misses > (tr.misses or 0) then tr.streak = 0 end
	tr.misses = misses
	for p in pairs(m.players) do
		local k, _mag, reserve = WeaponService.current(p)
		if k and reserve < 30 and not Config.WEAPONS[k].melee then WeaponService.setReserve(p, k, 999) end
	end
end
function M.info(m: any): any
	local tr = m.data.tr
	local shots, hits = 0, 0
	for p in pairs(m.players) do local s = m.stats[p]; if s then shots += s.shots; hits += s.hits end end
	local acc = if shots > 0 then math.floor(math.min(1, tr.hits / shots) * 100 + 0.5) else 0
	local mins = math.floor(tr.t / 60)
	local avg: number? = nil
	if #tr.rts > 0 then local s = 0; for _, v in ipairs(tr.rts) do s += v end; avg = s / #tr.rts end
	m.data.public = { train = { score = tr.score, acc = acc, streak = tr.streak, best = tr.best, t = math.floor(tr.t), rt = avg, rtBest = tr.rtBest } }
	local function sec(x: number): string return (string.gsub(string.format("%.2f", x), "%.", ",")) .. " s" end
	return { line = "SCORE " .. tr.score .. "   ·   précision " .. acc .. " %   ·   série " .. tr.streak,
		sub = string.format("%d:%02d — série max %d", mins, math.floor(tr.t) % 60, tr.best)
			.. (if avg then " — réaction " .. sec(avg) .. " (meilleure " .. sec(tr.rtBest or avg) .. ")" else ""), color = Color3.fromRGB(255, 215, 94) }
end
function M.cleanup(m: any)
	for _, d in ipairs(m.data.dummies or {}) do if d.model then d.model:Destroy() end end
	m.data.dummies = {}
end
return M
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="457">
        <Properties>
          <string name="Name">zombies</string>
          <string name="Source"><![CDATA[--!strict
-- Modes/zombies : Zombies (coop) façon « Black Ops », sur l'Asile hanté
-- (web : src/61_variants.js zStartWave / zSpawn / zombieWaves, src/69_zombies.js, src/69z_extra.js, src/8K_zammo.js, src/8L_zdiff.js).
--   - Tous les humains (joueurs + bots alliés) sont dans la même équipe ; les zombies arrivent par vagues (7 + 5 × manche,
--     au plus min(24, 6 + 2 × manche) en même temps). Manche des rôdeurs toutes les 5 manches, la Brute toutes les 10.
--   - Points : +10 par touche, +50 élimination (+90 à la tête, +120 au couteau), +1000 la Brute, +100 réanimation.
--   - Armes murales (moitié prix pour les munitions), boîte mystère (950, nounours qui la déplace), Forge Arcane (5000),
--     atouts (Mastodonte, Turbo Cola, Double Détente, Second Souffle, Pas de Course), armes prodiges.
--   - Bonus lâchés : Munitions max, Mort instantanée, Points doubles, Bombe, Vente de feu (30 s).
--   - Débris à dégager pour ouvrir l'asile, joueurs à terre (30 s pour être réanimé), porteurs de munitions, easter egg.
--   - Victoire après la dernière manche choisie, défaite quand plus personne n'est debout.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Modes = require(ReplicatedStorage.Shared.Modes)
local Z = require(ReplicatedStorage.Shared.ZombieConfig)
local MapData = require(ReplicatedStorage.Shared.MapData) :: any
local WeaponService = require(script.Parent.Parent.WeaponService)
local BotService = require(script.Parent.Parent.BotService)
local ZombieService = require(script.Parent.Parent.ZombieService)
local RewardService = require(script.Parent.Parent.RewardService)

Z.registerWeapons()

local U = Config.STUDS_PER_METER
local S = Config.CELL * U                 -- une case en studs
local HUMANS = "Attaquants"               -- équipe 0 du web
local RED = Z.rgb(0xd0202a)
local GOLD = Z.rgb(0xffd23a)

local M = {}
M.noPickups = true
local function MS(): any return require(script.Parent.Parent.MatchService) :: any end

local function remote(name: string): RemoteEvent
	local r = ReplicatedStorage:FindFirstChild(name) :: RemoteEvent?
	if not r then local e = Instance.new("RemoteEvent"); e.Name = name; e.Parent = ReplicatedStorage; r = e end
	return r :: RemoteEvent
end
local popEvent = remote("ModePop")        -- petit message au centre (HudController)
local gainEvent = remote("ZombieGain")    -- serveur -> joueur : +points (ZombieBrHud)
local feedEvent = ReplicatedStorage:WaitForChild("KillFeed") :: RemoteEvent
local bannerEvent = ReplicatedStorage:WaitForChild("KillBanner") :: RemoteEvent

local function isPlayer(c: any): boolean return typeof(c) == "Instance" and c:IsA("Player") end
local function now(): number return os.clock() end
local function hypot(a: number, b: number): number return math.sqrt(a * a + b * b) end

-- ==========================================================================================
-- Survivants : points, atouts, armes
-- ==========================================================================================
type Person = { pts: number, perks: { [string]: boolean }, pap: { [string]: boolean }, p: string?, s: string?,
	downed: boolean, downT: number, revP: number, lastAttacker: any, prompt: ProximityPrompt? }

local function zOn(m: any): boolean return m ~= nil and m.mode == "zombies" and m.data and m.data.zs ~= nil end

local function person(m: any, c: any): Person
	local k = MS().keyOf(c)
	local p = m.data.people[k]
	if not p then
		p = { pts = Z.START_PTS, perks = {}, pap = {}, p = nil, s = nil, downed = false, downT = 0, revP = 0, lastAttacker = nil, prompt = nil }
		m.data.people[k] = p
	end
	return p
end

-- humains de la partie (vivants ou non) et vivants debout
local function humans(m: any): { any }
	local l = {}
	for _, c in ipairs(MS().combatants(m)) do if WeaponService.teamOf(c) == HUMANS then table.insert(l, c) end end
	return l
end
local function aliveHumans(m: any, standing: boolean?): { any }
	local l = {}
	for _, c in ipairs(humans(m)) do
		if MS().aliveChar(c) and (not standing or not person(m, c).downed) then table.insert(l, c) end
	end
	return l
end
local function rootOf(c: any): BasePart?
	local ch = WeaponService.charOf(c)
	return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local function flatDist(a: Vector3, b: Vector3): number return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude end

local function syncAttrs(m: any, c: any)
	if not isPlayer(c) then return end
	local p = person(m, c)
	c:SetAttribute("ZPts", p.pts)
	local perks = {}
	for _, k in ipairs(Z.PERK_ORDER) do if p.perks[k] then table.insert(perks, k) end end
	c:SetAttribute("ZPerks", table.concat(perks, ","))
	local pap = {}
	for k in pairs(p.pap) do table.insert(pap, k) end
	c:SetAttribute("ZPap", table.concat(pap, ","))
	c:SetAttribute("ZOwn", (p.p or "") .. "," .. (p.s or ""))
end

local function tell(c: any, text: string, color: Color3?, sound: string?)
	if isPlayer(c) and text ~= "" then popEvent:FireClient(c, text, color, sound) end
end

-- points (doublés pendant « Points doubles »)
local function zPts(m: any, c: any, n: number)
	if not c then return end
	local zs = m.data.zs
	n = math.floor(n * (if zs.dbl > now() then 2 else 1) + 0.5)
	local p = person(m, c)
	p.pts += n
	local s = MS().statOf(m, c)
	if s then s.pts = p.pts; s.score += n end
	if isPlayer(c) then c:SetAttribute("ZPts", p.pts); gainEvent:FireClient(c, n) end
end
local function zSpend(m: any, c: any, n: number): boolean
	local p = person(m, c)
	if p.pts < n then tell(c, "Pas assez de points (" .. n .. ")", Z.rgb(0xff6b6b), "deny"); return false end
	p.pts -= n
	local s = MS().statOf(m, c)
	if s then s.pts = p.pts end
	syncAttrs(m, c)
	return true
end

-- effets des atouts sur le personnage : cadence (lue aussi par WeaponController), vitesse
local function applyPerks(m: any, c: any)
	local ch = WeaponService.charOf(c)
	if not ch then return end
	local p = person(m, c)
	ch:SetAttribute("RateMult", if p.perks.dtap then 1.33 else nil)
	if isPlayer(c) then
		ch:SetAttribute("SpeedMult", if p.downed then 0.15 elseif p.perks.stamin then 1.18 else nil)
	end
	syncAttrs(m, c)
end

-- jeu d'armes : emplacement principal (p), pistolet (s), couteau
local function slotOf(key: string): string
	local w = Config.WEAPONS[key]
	return if w and w.slot == 1 then "s" else "p"
end
local function equip(m: any, c: any, select: string?)
	local p = person(m, c)
	local keys = {}
	if p.p then table.insert(keys, p.p) end
	if p.s then table.insert(keys, p.s) end
	table.insert(keys, "knife")
	WeaponService.setLoadoutKeep(c, keys, select)
	syncAttrs(m, c)
end
local function zGive(m: any, c: any, key: string)
	local p = person(m, c)
	local sl = slotOf(key)
	local old = if sl == "p" then p.p else p.s
	if old then p.pap[old] = nil end
	p.pap[key] = nil
	if sl == "p" then p.p = nil else p.s = nil end
	equip(m, c, nil)                              -- retire l'ancienne (ses munitions repartent à zéro)
	if sl == "p" then p.p = key else p.s = key end
	equip(m, c, key)
	tell(c, Config.WEAPONS[key].name, GOLD, "draw")
end
local function refillAll(m: any, c: any)
	local p = person(m, c)
	for _, k in ipairs({ p.p, p.s }) do
		if k then
			local _, res = WeaponService.ammoOf(c, k)
			local full = Config.WEAPONS[k].reserve * (if p.pap[k] then 2 else 1)
			if k == "p250" or k == "glock" then full = math.max(full, Z.START_RES) end
			WeaponService.setAmmo(c, k, WeaponService.magOf(c, k), math.max(res, full))
		end
	end
end

-- ==========================================================================================
-- Grille de la carte : cases libres, zones accessibles depuis la chapelle
-- ==========================================================================================
local N = MapData.N
local function cellIdx(cx: number, cz: number): number return cz * N + cx end
local function cellPos(m: any, cx: number, cz: number): Vector3
	return MS().cellToWorld(m, cx, cz)        -- centre de la case, au niveau du sol (MapBuilder)
end
local function walkable(g: any, i: number): boolean
	if g.blocked[i] then return false end
	return g.ramp[i] ~= 0 or g.h[i] < 1.4
end
local function zReach(m: any)
	local g = m.data.grid
	local sp = m.map.data.spawnCT[1]
	local start = cellIdx(sp[1], sp[2])
	local R = { [start] = true }
	local q = { start }
	while #q > 0 do
		local c = table.remove(q) :: number
		local cx, cz = c % N, c // N
		for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
			local nx, nz = cx + d[1], cz + d[2]
			if nx >= 0 and nz >= 0 and nx < N and nz < N then
				local ni = cellIdx(nx, nz)
				if not R[ni] and walkable(g, ni) and (g.ramp[ni] ~= 0 or g.ramp[c] ~= 0 or math.abs(g.h[ni] - g.h[c]) <= 1.3) then
					R[ni] = true; table.insert(q, ni)
				end
			end
		end
	end
	m.data.reach = R
	local cells = {}
	for i in pairs(R) do if g.ramp[i] == 0 then table.insert(cells, i) end end
	m.data.reachCells = cells
end
local function nearestFree(m: any, cx: number, cz: number): (number, number)
	local g = m.data.grid
	for r = 0, 4 do
		for dz = -r, r do for dx = -r, r do
			local x, z = cx + dx, cz + dz
			if x > 0 and z > 0 and x < N - 1 and z < N - 1 and walkable(g, cellIdx(x, z)) then return x, z end
		end end
	end
	return cx, cz
end
-- ligne de vue sur la grille (à 1,2 m du sol), comme losClear du web
local function gridLos(g: any, x0: number, z0: number, x1: number, z1: number): boolean
	local d = math.max(math.abs(x1 - x0), math.abs(z1 - z0))
	local steps = math.max(1, math.ceil(d * 4))
	for k = 1, steps - 1 do
		local t = k / steps
		local cx, cz = math.floor(x0 + (x1 - x0) * t), math.floor(z0 + (z1 - z0) * t)
		local i = cellIdx(cx, cz)
		if (g.h[i] or 0) > 1.2 and g.ramp[i] == 0 then return false end
	end
	return true
end

-- emplacements contre un mur (armes murales, boîte, machines) : zFindSpots du web
type Spot = { cx: number, cz: number, pos: Vector3, dx: number, dz: number }
local function findSpots(m: any): { Spot }
	local g = m.data.grid
	local out, seen = {}, {}
	local function free(cx: number, cz: number): boolean
		local i = cellIdx(cx, cz)
		return cx > 0 and cz > 0 and cx < N - 1 and cz < N - 1 and g.type[i] == 0 and g.h[i] == 0 and g.ramp[i] == 0 and not g.blocked[i]
	end
	local function wallAt(cx: number, cz: number): boolean
		if cx < 0 or cz < 0 or cx >= N or cz >= N then return true end
		local i = cellIdx(cx, cz)
		return g.h[i] >= 2.4 or g.blocked[i] == true
	end
	local list = {}
	for _, r in ipairs(m.map.data.roam or {}) do table.insert(list, r) end
	for _, r in ipairs(m.map.data.spawnDM or {}) do table.insert(list, r) end
	for _, r in ipairs(list) do
		for dz = -2, 2 do for dx = -2, 2 do
			local cx, cz = r[1] + dx, r[2] + dz
			local key = cx .. "," .. cz
			if not seen[key] and free(cx, cz) then
				seen[key] = true
				for _, o in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do
					if wallAt(cx + o[1], cz + o[2]) and free(cx - o[1], cz - o[2]) and gridLos(g, r[1] + 0.5, r[2] + 0.5, cx + 0.5, cz + 0.5) then
						table.insert(out, { cx = cx, cz = cz, pos = cellPos(m, cx, cz), dx = o[1], dz = o[2] })
						break
					end
				end
			end
		end end
	end
	return out
end
local function pickSpread(list: { Spot }, n: number, avoid: { Spot }): { Spot }
	local res, pool = {}, table.clone(list)
	while #res < n and #pool > 0 do
		local best, bd = 1, -1
		for i, s in ipairs(pool) do
			local md = math.huge
			for _, p in ipairs(res) do md = math.min(md, flatDist(p.pos, s.pos)) end
			for _, p in ipairs(avoid) do md = math.min(md, flatDist(p.pos, s.pos)) end
			if #res == 0 and #avoid == 0 then md = math.random() end
			if md > bd then bd = md; best = i end
		end
		table.insert(res, table.remove(pool, best) :: Spot)
	end
	return res
end

-- ==========================================================================================
-- Construction : armes murales, boîte mystère, machines, Forge Arcane, débris, fragments
-- ==========================================================================================
local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material?, transp: number?): Part
	local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.Size = size; p.CFrame = cf; p.Color = color
	p.Material = mat or Enum.Material.SmoothPlastic; p.Transparency = transp or 0
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth; p.Parent = parent
	return p
end
local function surface(p: BasePart, face: Enum.NormalId, ppu: number?): SurfaceGui
	local sg = Instance.new("SurfaceGui"); sg.Face = face; sg.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud; sg.PixelsPerStud = ppu or 40
	sg.LightInfluence = 0; sg.Brightness = 1.4; sg.Parent = p
	return sg
end
local function text(parent: Instance, t: string, pos: UDim2, size: UDim2, color: Color3, font: Enum.Font?): TextLabel
	local l = Instance.new("TextLabel"); l.BackgroundTransparency = 1; l.Position = pos; l.Size = size; l.Text = t; l.TextColor3 = color
	l.TextScaled = true; l.Font = font or Enum.Font.GothamBlack; l.Parent = parent
	return l
end
local function prompt(parent: Instance, kind: string, action: string, object: string, dist: number): ProximityPrompt
	local pp = Instance.new("ProximityPrompt"); pp.Name = "ZPrompt"; pp.ActionText = action; pp.ObjectText = object
	pp.KeyboardKeyCode = Enum.KeyCode.E; pp.GamepadKeyCode = Enum.KeyCode.ButtonX; pp.HoldDuration = 0; pp.RequiresLineOfSight = false
	pp.MaxActivationDistance = dist * U; pp:SetAttribute("ZKind", kind); pp.Parent = parent
	return pp
end
-- objet posé contre le mur, face vers la pièce (zPlaceObj du web)
local function placeCF(s: Spot, depth: number, y: number): CFrame
	local d = Vector3.new(s.dx, 0, s.dz)
	local pos = s.pos + d * ((1 - depth / 2 - 0.02) * U) + Vector3.new(0, y * U, 0)
	return CFrame.lookAt(pos, pos - d)
end

local handleUse: (any, Player, ProximityPrompt) -> ()

local function hookPrompt(m: any, pp: ProximityPrompt)
	pp.Triggered:Connect(function(pl: Player)
		if m.closed or m.state ~= "live" or MS().matchOf(pl) ~= m then return end
		local ok, err = pcall(function() handleUse(m, pl, pp) end)
		if not ok then warn("[zombies]", err) end
	end)
end

local function buildWall(m: any, s: Spot, key: string, price: number)
	local d = Vector3.new(s.dx, 0, s.dz)
	local pos = s.pos + d * ((1 - 0.03) * U) + Vector3.new(0, 1.45 * U, 0)
	local p = part(m.data.folder, "WallBuy", Vector3.new(1.5 * U, 0.75 * U, 0.05), CFrame.lookAt(pos, pos - d), Color3.new(1, 1, 1), nil, 1)
	p.CanCollide = false; p.CanQuery = false
	local sg = surface(p, Enum.NormalId.Front, 30)
	local fr = Instance.new("Frame"); fr.BackgroundTransparency = 1; fr.Size = UDim2.fromScale(0.86, 0.62); fr.Position = UDim2.fromScale(0.07, 0.06); fr.Parent = sg
	local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(244, 244, 240); st.Thickness = 3; st.Transparency = 0.25; st.Parent = fr
	text(fr, "✏️ " .. string.upper(Config.WEAPONS[key].name), UDim2.fromScale(0.05, 0.2), UDim2.fromScale(0.9, 0.6), Color3.fromRGB(244, 244, 240), Enum.Font.PermanentMarker)
	text(sg, string.upper(Config.WEAPONS[key].name) .. " — " .. price, UDim2.fromScale(0, 0.74), UDim2.fromScale(1, 0.24), Color3.fromRGB(244, 244, 240), Enum.Font.PermanentMarker)
	local pp = prompt(p, "wall", "Acheter " .. Config.WEAPONS[key].name .. " — " .. price .. " pts", "Arme murale", 2.4)
	pp:SetAttribute("Weapon", key); pp:SetAttribute("Price", price)
	hookPrompt(m, pp)
end

local function buildBox(m: any, s: Spot, first: boolean)
	local zs = m.data.zs
	if zs.box and zs.box.model then zs.box.model:Destroy() end
	local model = Instance.new("Model"); model.Name = "MysteryBox"
	local cf = placeCF(s, 0.75, 0.31)
	local wood = Color3.fromRGB(74, 53, 32)
	local base = part(model, "Base", Vector3.new(1.5, 0.62, 0.75) * U, cf, wood, Enum.Material.WoodPlanks)
	local lid = part(model, "Lid", Vector3.new(1.52, 0.12, 0.77) * U, cf * CFrame.new(0, 0.37 * U, 0), Color3.fromRGB(58, 42, 24), Enum.Material.WoodPlanks)
	lid:SetAttribute("Closed", lid.CFrame)
	local q = surface(base, Enum.NormalId.Front, 30)
	text(q, "?", UDim2.fromScale(0.35, 0), UDim2.fromScale(0.3, 1), Color3.fromRGB(127, 224, 255), Enum.Font.Fantasy)
	local beam = part(model, "Beam", Vector3.new(40 * U, 0.9 * U, 0.9 * U), CFrame.new(cf.Position + Vector3.new(0, 20.6 * U, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color3.fromRGB(127, 224, 255), Enum.Material.Neon, 0.86)
	beam.Shape = Enum.PartType.Cylinder; beam.CanCollide = false; beam.CanQuery = false; beam.CastShadow = false
	local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(127, 224, 255); l.Range = 3 * U; l.Brightness = 2; l.Parent = base
	model.PrimaryPart = base
	model:SetAttribute("BoxState", "idle")
	model.Parent = m.data.folder
	local pp = prompt(base, "box", "Boîte mystère — " .. Z.BOX_PRICE .. " pts", "Boîte mystère", 2.4)
	hookPrompt(m, pp)
	zs.box = { model = model, spot = s, state = "idle", t = 0, key = nil, owner = nil, teddy = false }
	if not first then
		for p in pairs(m.players) do tell(p, "La boîte mystère a changé de place !", Z.rgb(0x7fe0ff), "beep") end
	end
end

local function buildPerk(m: any, s: Spot, key: string)
	local pk = Z.PERKS[key]
	local model = Instance.new("Model"); model.Name = "Perk_" .. key
	local cf = placeCF(s, 0.7, 1.025)
	local body = part(model, "Body", Vector3.new(0.95, 2.05, 0.7) * U, cf, pk.c:Lerp(Color3.new(0, 0, 0), 0.45), Enum.Material.Metal)
	part(model, "Top", Vector3.new(1.02, 0.14, 0.76) * U, cf * CFrame.new(0, 1.075 * U, 0), Color3.fromRGB(34, 34, 34), Enum.Material.Metal)
	local lamp = part(model, "Lamp", Vector3.new(0.8, 0.06, 0.06) * U, cf * CFrame.new(0, 0.925 * U, -0.36 * U), pk.c, Enum.Material.Neon)
	lamp.CanCollide = false
	local sg = surface(body, Enum.NormalId.Front, 30)
	local bg = Instance.new("Frame"); bg.Size = UDim2.fromScale(1, 1); bg.BackgroundColor3 = pk.c; bg.Parent = sg
	local grad = Instance.new("UIGradient"); grad.Rotation = 90
	grad.Color = ColorSequence.new(Color3.new(1, 1, 1), Color3.fromRGB(30, 24, 18)); grad.Parent = bg
	text(bg, pk.ic, UDim2.fromScale(0.15, 0.12), UDim2.fromScale(0.7, 0.28), Color3.new(1, 1, 1))
	text(bg, string.upper(pk.n), UDim2.fromScale(0.05, 0.46), UDim2.fromScale(0.9, 0.1), Color3.new(1, 1, 1))
	text(bg, pk.price .. " points", UDim2.fromScale(0.1, 0.58), UDim2.fromScale(0.8, 0.07), Color3.fromRGB(255, 233, 176), Enum.Font.GothamBold)
	local l = Instance.new("PointLight"); l.Color = pk.c; l.Range = 2.6 * U; l.Brightness = 1.2; l.Parent = lamp
	model.Parent = m.data.folder
	local pp = prompt(body, "perk", pk.n .. " — " .. pk.price .. " pts", pk.d, 2.4)
	pp:SetAttribute("Perk", key); pp:SetAttribute("Price", pk.price)
	hookPrompt(m, pp)
end

local function buildPap(m: any, s: Spot)
	local model = Instance.new("Model"); model.Name = "ForgeArcane"
	local cf = placeCF(s, 0.85, 0.65)
	local body = part(model, "Body", Vector3.new(1.7, 1.3, 0.85) * U, cf, Color3.fromRGB(58, 37, 96), Enum.Material.Metal)
	local top = part(model, "Top", Vector3.new(0.5, 1.1, 1.1) * U, cf * CFrame.new(0, 0.9 * U, 0) * CFrame.Angles(0, 0, math.rad(90)), Color3.fromRGB(138, 77, 255), Enum.Material.Neon, 0.2)
	top.Shape = Enum.PartType.Cylinder
	local sg = surface(body, Enum.NormalId.Front, 30)
	local bg = Instance.new("Frame"); bg.Size = UDim2.fromScale(1, 1); bg.BackgroundColor3 = Color3.fromRGB(29, 20, 48); bg.Parent = sg
	local st = Instance.new("UIStroke"); st.Color = Color3.fromRGB(180, 107, 255); st.Thickness = 4; st.Parent = bg
	text(bg, "FORGE ARCANE", UDim2.fromScale(0.05, 0.2), UDim2.fromScale(0.9, 0.3), Color3.fromRGB(231, 200, 255))
	text(bg, "Améliore ton arme — " .. Z.PAP_PRICE .. " pts", UDim2.fromScale(0.08, 0.58), UDim2.fromScale(0.84, 0.16), Color3.fromRGB(255, 215, 94), Enum.Font.GothamBold)
	local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(180, 107, 255); l.Range = 4 * U; l.Brightness = 2; l.Parent = top
	model.Parent = m.data.folder
	local pp = prompt(body, "pap", "Forge Arcane — " .. Z.PAP_PRICE .. " pts", "Forge Arcane", 2.6)
	hookPrompt(m, pp)
end

-- débris qui bouchent un passage (zSetupDoors / zDebrisMesh du web)
local function buildDoors(m: any)
	local g = m.data.grid
	m.data.doors = {}
	for k, dd in ipairs(m.map.data.zdoors or {}) do
		local price = dd.price or Z.DOOR_PRICES[k] or 1500
		local minX, maxX, minZ, maxZ = math.huge, -math.huge, math.huge, -math.huge
		local cells = {}
		for _, c in ipairs(dd.cells) do
			minX = math.min(minX, c[1]); maxX = math.max(maxX, c[1]); minZ = math.min(minZ, c[2]); maxZ = math.max(maxZ, c[2])
			local i = cellIdx(c[1], c[2]); g.blocked[i] = true; table.insert(cells, i)
		end
		local horiz = (maxX - minX) >= (maxZ - minZ)
		local n = #dd.cells
		local a = MS().cellToWorld(m, minX, minZ)
		local b = MS().cellToWorld(m, maxX, maxZ)
		local center = (a + b) / 2
		local model = Instance.new("Model"); model.Name = "Debris"
		local size = if horiz then Vector3.new(n * S, 2.4 * U, S) else Vector3.new(S, 2.4 * U, n * S)
		local block = part(model, "Blocker", size, CFrame.new(center + Vector3.new(0, 1.2 * U, 0)), Color3.new(0, 0, 0), nil, 1)
		local rot = if horiz then CFrame.identity else CFrame.Angles(0, math.rad(90), 0)
		local base = CFrame.new(center) * rot
		local W2 = n * 2
		local r = Random.new(k * 31)
		for j = 0, 5 do
			local plank = part(model, "Plank", Vector3.new(W2 * 1.05, 0.22, 0.08) * U, base * CFrame.new(0, (0.3 + j * 0.36) * U, (if j % 2 == 1 then 0.12 else -0.12) * U)
				* CFrame.Angles(0, 0, r:NextNumber(-0.18, 0.18)), if j % 2 == 1 then Color3.fromRGB(107, 74, 43) else Color3.fromRGB(59, 42, 26), Enum.Material.WoodPlanks)
			plank.CanCollide = false
		end
		for j = 0, n * 2 - 1 do
			local cr = part(model, "Crate", Vector3.new(0.8, 0.8, 0.8) * U, base * CFrame.new(r:NextNumber(-W2 / 2 + 0.4, W2 / 2 - 0.4) * U, (0.4 + (j % 2) * 0.8) * U,
				r:NextNumber(-0.6, 0.6) * U) * CFrame.Angles(0, r:NextNumber(0, 3), 0), if j % 3 ~= 0 then Color3.fromRGB(107, 74, 43) else Color3.fromRGB(85, 91, 98),
				if j % 3 ~= 0 then Enum.Material.WoodPlanks else Enum.Material.DiamondPlate)
			cr.CanCollide = false
		end
		local sign = part(model, "Sign", Vector3.new(1.2, 0.4, 0.05) * U, base * CFrame.new(0, 2.2 * U, 0.2 * U), Color3.fromRGB(255, 210, 58))
		sign.CanCollide = false
		local sg = surface(sign, Enum.NormalId.Front, 20)
		text(sg, "⚠ " .. price .. " ⚠", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), Color3.fromRGB(17, 17, 17))
		local sgb = surface(sign, Enum.NormalId.Back, 20)
		text(sgb, "⚠ " .. price .. " ⚠", UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), Color3.fromRGB(17, 17, 17))
		model.Parent = m.data.folder
		local door = { cells = cells, price = price, model = model, open = false, pos = center }
		table.insert(m.data.doors, door)
		local pp = prompt(block, "door", "Dégager les débris — " .. price .. " pts", "Débris", 2.8)
		pp:SetAttribute("Price", price); pp:SetAttribute("Door", #m.data.doors)
		hookPrompt(m, pp)
	end
end
local function openDoor(m: any, door: any)
	if door.open then return end
	door.open = true
	for _, i in ipairs(door.cells) do m.data.grid.blocked[i] = nil end
	if door.model then door.model:Destroy() end
	zReach(m)
	MS().announce(m, "ZONE OUVERTE", "", GOLD)
end

-- easter egg : 3 fragments de l'Orbe aux points les plus éloignés du départ
local function buildEgg(m: any)
	m.data.frags = {}; m.data.fragGot = 0
	local sp = m.map.data.spawnCT[1]
	local pts = {}
	for _, r in ipairs(m.map.data.roam or {}) do table.insert(pts, r) end
	for _, r in ipairs(m.map.data.spawnDM or {}) do table.insert(pts, r) end
	table.sort(pts, function(a, b)
		return hypot(b[1] - sp[1], b[2] - sp[2]) < hypot(a[1] - sp[1], a[2] - sp[2])
	end)
	local chosen = {}
	for _, p in ipairs(pts) do
		if #chosen >= 3 then break end
		local ok = true
		for _, c in ipairs(chosen :: { any }) do if hypot(c[1] - p[1], c[2] - p[2]) <= 8 then ok = false end end
		if ok then table.insert(chosen, p) end
	end
	for _, c in ipairs(chosen) do
		local fx, fz = nearestFree(m, c[1], c[2])
		local pos = cellPos(m, fx, fz) + Vector3.new((math.random() - 0.5) * 1.2 * U, 0.45 * U, (math.random() - 0.5) * 1.2 * U)
		local f = part(m.data.folder, "OrbFragment", Vector3.new(0.22, 0.22, 0.22) * U, CFrame.new(pos) * CFrame.Angles(math.rad(45), 0, math.rad(35)), Color3.fromRGB(199, 125, 255), Enum.Material.Neon)
		f.CanCollide = false; f.CanQuery = false
		local l = Instance.new("PointLight"); l.Color = Color3.fromRGB(180, 107, 255); l.Range = 2.5 * U; l.Brightness = 2; l.Parent = f
		table.insert(m.data.frags, { part = f, pos = pos })
	end
end

-- ==========================================================================================
-- Bonus lâchés par les zombies
-- ==========================================================================================
local function zDrop(m: any, pos: Vector3)
	local key = Z.DROP_ORDER[math.random(#Z.DROP_ORDER)]
	local d = Z.DROPS[key]
	local p = part(m.data.folder, "Drop_" .. key, Vector3.new(0.5, 0.5, 0.5) * U, CFrame.new(pos + Vector3.new(0, 1 * U, 0)), d.c, Enum.Material.Neon, 0.35)
	p.Shape = Enum.PartType.Ball; p.CanCollide = false; p.CanQuery = false
	local bb = Instance.new("BillboardGui"); bb.Size = UDim2.fromOffset(64, 64); bb.AlwaysOnTop = false; bb.LightInfluence = 0; bb.Parent = p
	local l = text(bb, d.ic, UDim2.fromScale(0, 0), UDim2.fromScale(1, 1), d.c)
	l.TextStrokeTransparency = 0.3
	local pl = Instance.new("PointLight"); pl.Color = d.c; pl.Range = 3 * U; pl.Brightness = 2; pl.Parent = p
	table.insert(m.data.drops, { key = key, part = p, pos = pos, t = 26 })
end
local function applyDrop(m: any, key: string, who: any)
	local d = Z.DROPS[key]
	local zs = m.data.zs
	MS().announce(m, d.n, "", d.c)
	for p in pairs(m.players) do popEvent:FireClient(p, "", nil, "pickup") end
	if key == "ammo" then
		for _, h in ipairs(aliveHumans(m)) do refillAll(m, h) end
	elseif key == "insta" then zs.insta = now() + 30
	elseif key == "dbl" then zs.dbl = now() + 30
	elseif key == "fire" then zs.fire = now() + 30
	elseif key == "nuke" then
		m.data.nuking = true
		for _, z in ipairs(ZombieService.ofMatch(m.id)) do
			local h = z:FindFirstChildOfClass("Humanoid")
			if h then
				local ex = Instance.new("Explosion"); ex.Position = (z:GetPivot()).Position; ex.BlastPressure = 0; ex.BlastRadius = 1.5 * U
				ex.DestroyJointRadiusPercent = 0; ex.Parent = workspace
				WeaponService.applyDamage(who, z, h.Health + 999, false, "frag", 1)
			end
		end
		m.data.nuking = false
		for _, h in ipairs(humans(m)) do zPts(m, h, 400) end
	end
end

-- ==========================================================================================
-- Joueurs à terre, Second Souffle, réanimation
-- ==========================================================================================
local function clearDown(m: any, c: any)
	local p = person(m, c)
	p.downed = false; p.revP = 0
	if p.prompt then p.prompt:Destroy(); p.prompt = nil end
	local ch = WeaponService.charOf(c)
	if ch then
		ch:SetAttribute("Downed", nil); ch:SetAttribute("DownT", nil)
		if not isPlayer(c) then ch:SetAttribute("Frozen", nil) end
		local h = ch:FindFirstChildOfClass("Humanoid")
		if h and isPlayer(c) then h.JumpPower = 50; h.JumpHeight = 7.2 end
	end
	applyPerks(m, c)
end
local function zRevive(m: any, v: any, by: any)
	local ch = MS().aliveChar(v)
	clearDown(m, v)
	if not ch then return end
	local h = ch:FindFirstChildOfClass("Humanoid")
	if h then h.Health = math.min(h.MaxHealth, 60) end
	ch:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + 1.5)
	if isPlayer(v) then MS().announce(m, "RÉANIMÉ", "", Z.rgb(0x7dff9f), v) end
	if by and isPlayer(by) then zPts(m, by, 100); tell(by, "Allié réanimé (+100)", Z.rgb(0x7dff9f), "heal") end
end
local function zDown(m: any, v: any)
	local p = person(m, v)
	local ch = WeaponService.charOf(v)
	if not ch then return end
	p.downed = true; p.downT = 30; p.revP = 0; p.perks = {}
	ch:SetAttribute("Downed", true); ch:SetAttribute("DownT", 30)
	ch:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + 1e6)   -- les zombies ignorent les joueurs à terre
	local h = ch:FindFirstChildOfClass("Humanoid")
	if isPlayer(v) then
		if h then h.JumpPower = 0; h.JumpHeight = 0 end
		MS().announce(m, "À TERRE !", "Un allié doit te réanimer — tu peux encore tirer", Z.rgb(0xff4655), v)
		popEvent:FireClient(v, "", nil, "dmg")
	else
		ch:SetAttribute("Frozen", true)
		if h then h:Move(Vector3.zero) end
	end
	-- on garde le pistolet en main
	if p.s then
		local idx = table.find(WeaponService.loadoutOf(v), p.s)
		if idx then WeaponService.switchTo(v, idx) end
	end
	applyPerks(m, v)
	local root = ch:FindFirstChild("HumanoidRootPart")
	if root then
		local pp = prompt(root, "revive", "Réanimer", WeaponService.nameOf(v), 1.9)
		pp.HoldDuration = 3
		pp:SetAttribute("Target", MS().keyOf(v) == v and (v :: Player).UserId or 0)
		p.prompt = pp
		pp.Triggered:Connect(function(pl: Player)
			if pl == v or MS().matchOf(pl) ~= m or not p.downed then return end
			if person(m, pl).downed or not MS().aliveChar(pl) then return end
			zRevive(m, v, pl)
		end)
	end
	-- plus personne debout : tout le monde saigne
	for p2 in pairs(m.players) do if p2 ~= v then tell(p2, WeaponService.nameOf(v) .. " est à terre !", Z.rgb(0xff4655), nil) end end
end
local function bleedOut(m: any, v: any)
	local p = person(m, v)
	local ch = MS().aliveChar(v)
	clearDown(m, v)
	if not ch then return end
	ch:SetAttribute("ProtectedUntil", 0)
	local h = ch:FindFirstChildOfClass("Humanoid")
	if h then WeaponService.applyDamage(p.lastAttacker, ch, h.Health + 999, false, "Saignement", 1) end
	if h and h.Health > 0 then h.Health = 0 end
end
-- true = le coup ne tue pas (à terre avec des alliés debout, ou Second Souffle seul) : zSave du web
local function zSave(m: any, v: any): boolean
	local p = person(m, v)
	if p.downed then return true end
	local others = 0
	for _, c in ipairs(aliveHumans(m, true)) do if c ~= v then others += 1 end end
	if others > 0 then zDown(m, v); return true end
	if not p.perks.revive then return false end
	p.perks = {}
	local ch = MS().aliveChar(v)
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if h then h.Health = math.min(h.MaxHealth, 100) end
	if ch then ch:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + 2.5) end
	applyPerks(m, v)
	if isPlayer(v) then MS().announce(m, "SECOND SOUFFLE", "Tu te relèves… atouts perdus", Z.rgb(0x4aa3ff), v) end
	local r = rootOf(v)
	if r then
		for _, z in ipairs(ZombieService.ofMatch(m.id)) do
			local zp = z:GetPivot().Position
			if flatDist(zp, r.Position) < 4 * U then ZombieService.push(z, zp - r.Position, 2 * U) end
		end
	end
	return true
end

-- morsure d'un zombie (hurt du web) : Mastodonte encaisse, à terre plutôt que mort
local function onBite(m: any, z: Model, target: Model, dmg: number)
	if m.state ~= "live" then return end
	local c = WeaponService.combatantOf(target)
	if MS().matchOf(c) ~= m then return end
	local p = person(m, c)
	if p.downed then return end
	local h = target:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 then return end
	local pu = target:GetAttribute("ProtectedUntil")
	if typeof(pu) == "number" and pu > workspace:GetServerTimeNow() then return end
	if p.perks.jugg then dmg *= 0.45 end
	p.lastAttacker = z
	local shield = WeaponService.shieldOf(c)
	if h.Health + shield - dmg <= 0.5 then
		if zSave(m, c) then
			if h.Health > 1 then WeaponService.applyDamage(z, target, math.max(0, h.Health - 1 + shield), false, "Morsure", 1) end
			if p.downed then h.Health = 1 end
			return
		end
	end
	WeaponService.applyDamage(z, target, dmg, false, "Morsure", 1)
end

-- ==========================================================================================
-- Zombies et manches
-- ==========================================================================================
local function zDiff(m: any): any return Z.ZDIFF[math.clamp(m.settings.diff, 1, #Z.ZDIFF)] end

local function zTargets(m: any): { Model }
	local out = {}
	local t = workspace:GetServerTimeNow()
	for _, c in ipairs(aliveHumans(m, true)) do
		local ch = WeaponService.charOf(c)
		local pu = ch and ch:GetAttribute("ProtectedUntil")
		if ch and not (typeof(pu) == "number" and pu > t) then table.insert(out, ch) end
	end
	return out
end

-- case accessible la plus éloignée des humains (zReachSpot)
local function reachSpot(m: any, hum: { Vector3 }): { number }?
	local cells = m.data.reachCells
	if not cells or #cells == 0 then return nil end
	local best, bd = nil, -1
	for _ = 1, 40 do
		local i = cells[math.random(#cells)]
		local p = cellPos(m, i % N, i // N)
		local md = math.huge
		for _, h in ipairs(hum) do md = math.min(md, flatDist(h, p)) end
		if md > bd then bd = md; best = { i % N, i // N } end
	end
	return best
end

local function zSpawn(m: any)
	local zs = m.data.zs
	local hum = {}
	for _, c in ipairs(aliveHumans(m)) do local r = rootOf(c); if r then table.insert(hum, r.Position) end end
	if #hum == 0 then return end
	local cand = {}
	for _, r in ipairs(m.map.data.roam or {}) do table.insert(cand, r) end
	for _, r in ipairs(m.map.data.spawnDM or {}) do table.insert(cand, r) end
	if m.data.reach then
		local f = {}
		for _, c in ipairs(cand) do local x, z = nearestFree(m, c[1], c[2]); if m.data.reach[cellIdx(x, z)] then table.insert(f, c) end end
		if #f > 0 then cand = f end
	end
	local best, bd = nil, -1
	for _ = 1, 8 do
		local c = cand[math.random(#cand)]
		local p = cellPos(m, c[1], c[2])
		local md = math.huge
		for _, h in ipairs(hum) do md = math.min(md, flatDist(h, p) / U) end
		if md > bd and md > 14 then bd = md; best = c end
	end
	if m.data.reach then
		local s = reachSpot(m, hum)
		if s and (not best or bd < 10) then best = s end
	end
	if not best then best = cand[math.random(#cand)] end
	local bx, bz = nearestFree(m, best[1], best[2])
	-- type de zombie (zSpawn + zSpecialType)
	local w = zs.wave
	local r = math.random()
	local ztype = if w >= 4 and r < 0.07 then "tank" elseif r < math.min(0.7, (w - 2) * 0.12) then "runner" else "normal"
	if zs.boss > 0 and (math.random() < 0.12 or zs.queue < 6) then zs.boss -= 1; ztype = "boss"
	elseif zs.special and math.random() < 0.75 then ztype = "crawler" end
	local hp = (if ztype == "tank" then 3 elseif ztype == "runner" then 0.7 else 1) * (if w < 10 then 100 + 55 * (w - 1) else 595 * math.pow(1.08, w - 9))
	local speed = if ztype == "runner" then 5 + math.min(1, w * 0.05) elseif ztype == "tank" then 2.6 else 2.3 + math.min(1.6, w * 0.13)
	local dmg = if ztype == "tank" then 28 else 12 + w
	if ztype == "crawler" then hp *= 0.55; speed = 4.6; dmg = math.floor(dmg * 0.7 + 0.5) end
	if ztype == "boss" then hp = 1500 + w * 400; speed = 2.9; dmg = 45 end
	local d = zDiff(m)
	hp = math.max(1, math.floor(hp * d.hp + 0.5))
	speed = math.min(speed * Z.ZSLOW * d.spd, Z.RUN * 0.9 * d.spd)
	dmg = math.max(1, math.floor(dmg * d.dmg + 0.5))
	-- porteur de munitions : tous sortent avant la fin de la manche
	local carrier = false
	if zs.ammoLeft > 0 and ztype ~= "boss" and math.random() < zs.ammoLeft / math.max(1, zs.queue) then zs.ammoLeft -= 1; carrier = true end
	zs.nextId += 1
	ZombieService.spawn({
		match = m.id, parent = m.data.zfolder, pos = cellPos(m, bx, bz), ztype = ztype, hp = hp, speed = ZombieService.metersToSpeed(speed), dmg = dmg, atk = d.atk,
		carrier = carrier, id = zs.nextId,
		targets = function() return zTargets(m) end,
		onHit = function(z: Model, t: Model, n: number) onBite(m, z, t, n) end,
	})
end

-- alliés bots : ils dépensent leurs points à chaque manche (zBotsShop)
local function botsShop(m: any)
	for _, b in ipairs(aliveHumans(m)) do
		if not isPlayer(b) then
			local p = person(m, b)
			if not p.perks.jugg and p.pts >= Z.PERKS.jugg.price + 500 then p.pts -= Z.PERKS.jugg.price; p.perks.jugg = true
			elseif p.p and not p.pap[p.p] and p.pts >= Z.PAP_PRICE + 800 then
				p.pts -= Z.PAP_PRICE; p.pap[p.p] = true
				WeaponService.setAmmo(b, p.p, WeaponService.magOf(b, p.p), Config.WEAPONS[p.p].reserve * 2)
			elseif p.pts >= 1500 then
				local w = ({ "m4", "ak", "famas", "ump", "xm" })[math.random(5)]
				if not p.p or Config.WEAPONS[p.p].price < Config.WEAPONS[w].price then p.pts -= 1500; zGive(m, b, w) end
			end
			local s = MS().statOf(m, b); if s then s.pts = p.pts end
		end
	end
end

local function zStartWave(m: any)
	local zs = m.data.zs
	zs.wave += 1
	zs.queue = 7 + zs.wave * 5
	zs.state = "spawn"; zs.spawnT = 1.2
	MS().announce(m, "MANCHE " .. zs.wave, if zs.wave == 1 then "Gagne des points, achète des armes aux murs, tente la boîte mystère" else "Ils sont plus nombreux…", RED)
	-- les morts reviennent près d'un allié vivant (60 PV), les vivants regagnent 35 PV
	local alive = aliveHumans(m)
	local sp = m.map.data.spawnCT[1]
	local nearCell = { sp[1], sp[2] }
	local fr = alive[1] and rootOf(alive[1])
	if fr then
		local lp = fr.Position - m.origin
		nearCell = { math.floor(lp.X / S), math.floor(lp.Z / S) }
	end
	local nx, nz = nearestFree(m, nearCell[1] + 1, nearCell[2])
	m.data.respawnAt = cellPos(m, nx, nz)
	for p in pairs(m.players) do
		if not MS().aliveChar(p) then m.data.waveRespawn[p] = true; MS().respawn(m, p) end
	end
	for k, s in pairs(m.stats) do
		if s.bot and s.team == HUMANS and not (s.model and MS().aliveChar(s.model)) then
			local name = string.sub(tostring(k), 5)
			m.data.waveRespawn[k] = true
			MS().spawnBot(m, HUMANS, name)
		end
	end
	local t = workspace:GetServerTimeNow()
	for _, c in ipairs(alive) do
		local ch = WeaponService.charOf(c)
		local h = ch and ch:FindFirstChildOfClass("Humanoid")
		if h and not person(m, c).downed then h.Health = math.min(100, h.Health + 35) end
		WeaponService.giveGrenades(c, 0, 0, 2)
		if ch and isPlayer(c) and not person(m, c).downed then ch:SetAttribute("ProtectedUntil", t + 1.5) end
	end
	-- zOnWave : manches spéciales, bonus, achats des bots, porteurs de munitions, difficulté
	zs.special = zs.wave % 5 == 0
	zs.boss = if zs.wave % 10 == 0 then 1 else 0
	if zs.special then
		zs.queue = math.floor(zs.queue * 1.3 + 0.5)
		task.delay(2.8, function() if not m.closed then MS().announce(m, "MANCHE DES RÔDEURS", "Ils rampent… et ils sont rapides", Z.rgb(0xb06bff)) end end)
	end
	if zs.boss > 0 then
		task.delay(if zs.special then 5.6 else 2.8, function() if not m.closed then MS().announce(m, "LA BRUTE ARRIVE", "Un boss rejoint la manche", Z.rgb(0xff3030)) end end)
	end
	zs.dropsWave = 0
	botsShop(m)
	zs.ammoLeft = math.min(5, #humans(m))
	zs.queue = math.max(4, math.floor(zs.queue * zDiff(m).n + 0.5))
	local allyDiff = Modes.DIFFS[math.max(3, m.settings.diff)]
	for _, c in ipairs(humans(m)) do if not isPlayer(c) then BotService.setDiff(c, allyDiff) end end
	for p in pairs(m.players) do popEvent:FireClient(p, "", nil, "round") end
end

-- ==========================================================================================
-- Interactions (touche E) : zInteractFor du web
-- ==========================================================================================
handleUse = function(m: any, pl: Player, pp: ProximityPrompt)
	local p = person(m, pl)
	if p.downed or not MS().aliveChar(pl) then return end
	local zs = m.data.zs
	local kind = pp:GetAttribute("ZKind")
	if kind == "wall" then
		local key = pp:GetAttribute("Weapon") :: string
		local price = pp:GetAttribute("Price") :: number
		local own = p.p == key or p.s == key
		local pr = if own then math.floor(price / 2 + 0.5) else price
		if not zSpend(m, pl, pr) then return end
		if own then
			WeaponService.setAmmo(pl, key, WeaponService.magOf(pl, key), Config.WEAPONS[key].reserve * (if p.pap[key] then 2 else 1))
			tell(pl, "Munitions rechargées", GOLD, "pickup")
		else
			zGive(m, pl, key); popEvent:FireClient(pl, "", nil, "buy")
		end
	elseif kind == "box" then
		local b = zs.box
		if not b then return end
		if b.state == "idle" then
			local price = if zs.fire > now() then 10 else Z.BOX_PRICE
			if not zSpend(m, pl, price) then return end
			b.state = "roll"; b.t = 0; b.owner = pl; zs.boxUses += 1
			b.teddy = zs.boxUses > 3 and math.random() < 0.16 and #zs.boxSpots > 1
			local pool = {}
			for _, k in ipairs(Z.BOXPOOL) do if k ~= p.p and k ~= p.s then table.insert(pool, k) end end
			b.key = pool[math.random(#pool)]
			b.model:SetAttribute("BoxState", "roll"); b.model:SetAttribute("BoxT", workspace:GetServerTimeNow())
			b.model:SetAttribute("BoxOwner", pl.UserId); b.model:SetAttribute("BoxWeapon", nil)
			popEvent:FireClient(pl, "", nil, "beep")
		elseif b.state == "ready" and b.owner == pl and b.key then
			zGive(m, pl, b.key)
			b.state = "idle"; b.model:SetAttribute("BoxState", "idle"); b.model:SetAttribute("BoxWeapon", nil)
		end
	elseif kind == "perk" then
		local key = pp:GetAttribute("Perk") :: string
		local pk = Z.PERKS[key]
		if p.perks[key] then tell(pl, pk.n .. " (déjà bu)", pk.c, "deny"); return end
		if not zSpend(m, pl, pk.price) then return end
		p.perks[key] = true
		applyPerks(m, pl)
		MS().announce(m, string.upper(pk.n), pk.d, pk.c, pl)
	elseif kind == "door" then
		local door = m.data.doors[pp:GetAttribute("Door") :: number]
		if not door or door.open then return end
		if not zSpend(m, pl, door.price) then return end
		openDoor(m, door)
	elseif kind == "pap" then
		local key = WeaponService.current(pl)
		if not key or key == "knife" then tell(pl, "Forge Arcane : prends une arme en main", Z.rgb(0xc77dff), "deny"); return end
		if p.pap[key] then tell(pl, Config.WEAPONS[key].name .. " est déjà améliorée", Z.rgb(0xc77dff), "deny"); return end
		if not zSpend(m, pl, Z.PAP_PRICE) then return end
		p.pap[key] = true
		WeaponService.setAmmo(pl, key, WeaponService.magOf(pl, key), Config.WEAPONS[key].reserve * 2)
		syncAttrs(m, pl)
		MS().announce(m, "ARME AMÉLIORÉE", Config.WEAPONS[key].name .. " ★ — dégâts ×2, chargeur +50 %", Z.rgb(0xc77dff), pl)
	end
end

-- ==========================================================================================
-- Crochets globaux (installés une fois) : dégâts sur les zombies, multiplicateurs d'armes, cibles des bots
-- ==========================================================================================
local prevFilter = WeaponService.damageFilter
WeaponService.damageFilter = function(attacker: any, victimChar: Model, raw: number, headshot: boolean, key: string): number?
	local r: number? = raw
	if prevFilter then r = prevFilter(attacker, victimChar, raw, headshot, key) end
	if r == nil then return nil end
	if not ZombieService.isZombie(victimChar) then return r end
	local m = MS().matchOf(victimChar)
	if not zOn(m) or MS().matchOf(attacker) ~= m or WeaponService.teamOf(attacker) ~= HUMANS then return r end
	if m.data.nuking then return r end
	local p = person(m, attacker)
	local w = Config.WEAPONS[key]
	local wonder = Z.isWonder(key)
	local out = r :: number
	if p.pap[key] then out *= if wonder then 1.5 else 2 end
	if p.perks.dtap and w and not w.melee and not wonder then out *= 1.5 end
	if m.data.zs.insta > now() then
		local h = victimChar:FindFirstChildOfClass("Humanoid")
		out = (if h then h.Health else 0) + 999
	end
	m.data.lastHit[attacker] = { model = victimChar, t = os.clock() }
	zPts(m, attacker, 10)
	return out
end

WeaponService.modFn = function(c: any, key: string, what: string): number
	local m = MS().matchOf(c)
	if not zOn(m) then return 1 end
	local p = m.data.people[MS().keyOf(c)]
	if not p then return 1 end
	if what == "rate" and p.perks.dtap then return 1.33 end
	if what == "reload" and p.perks.speed then return 0.5 end
	if what == "mag" and p.pap[key] then return 1.5 end
	return 1
end

local prevTargets = BotService.extraTargets
BotService.extraTargets = function(team: string, matchId: number): { Model }
	local out = if prevTargets then prevTargets(team, matchId) else {}
	local m = MS().get(matchId)
	if zOn(m) and team == HUMANS then
		for _, z in ipairs(ZombieService.ofMatch(matchId)) do table.insert(out, z) end
	end
	return out
end

-- élimination d'un zombie (zKillHook + porteurs de munitions)
WeaponService.Killed:Connect(function(killer: any, victim: any, key: string, headshot: boolean)
	if not ZombieService.isZombie(victim) then return end
	local m = MS().matchOf(victim)
	if not zOn(m) or m.state ~= "live" then return end
	local zs = m.data.zs
	local z = victim :: Model
	local zpos = z:GetPivot().Position
	local human = if killer and MS().matchOf(killer) == m and WeaponService.teamOf(killer) == HUMANS then killer else nil
	local ks = human and MS().statOf(m, human)
	local w = Config.WEAPONS[key]
	if human and ks then
		ks.k += 1; ks.streak += 1; ks.bestStreak = math.max(ks.bestStreak, ks.streak)
		if headshot then ks.hs += 1 end
		ks.weaponKills[key] = (ks.weaponKills[key] or 0) + 1
		local before = person(m, human).pts
		zPts(m, human, if w and w.melee then 120 elseif headshot then 90 else 50)
		if isPlayer(human) then
			bannerEvent:FireClient(human, { victim = "Zombie", headshot = headshot, points = person(m, human).pts - before, streak = ks.streak, streakName = nil })
			RewardService.missionEvent(human, "kills")
			if headshot then RewardService.missionEvent(human, "hs") end
			if key == "knife" then RewardService.missionEvent(human, "knife") end
		end
	end
	MS().fire(m, feedEvent, { killer = if ks then ks.name else "?", killerTeam = HUMANS, victim = "Zombie", victimTeam = "Zombies",
		weapon = MS().weaponName(key), key = key, headshot = headshot })
	if ZombieService.typeOf(z) == "boss" then
		if human then zPts(m, human, 1000) end
		zDrop(m, zpos)
		MS().announce(m, "BRUTE ÉLIMINÉE", "+1000", GOLD)
	end
	if math.random() < 0.035 and zs.dropsWave < 4 then zs.dropsWave += 1; zDrop(m, zpos) end
	if z:GetAttribute("AmmoCarrier") then
		z:SetAttribute("AmmoCarrier", nil)
		local h = if human and MS().aliveChar(human) then human else nil
		if not h then
			local bd = math.huge
			for _, c in ipairs(aliveHumans(m)) do
				local r = rootOf(c)
				if r and flatDist(r.Position, zpos) < bd then bd = flatDist(r.Position, zpos); h = c end
			end
		end
		if h then
			refillAll(m, h)
			if isPlayer(h) then MS().announce(m, "MUNITIONS RECHARGÉES", "Zombie porteur éliminé", GOLD, h); popEvent:FireClient(h, "", nil, "pickup") end
		end
	end
	m.dmgBy[MS().keyOf(z)] = nil
	task.delay(4, function() WeaponService.reset(z); ZombieService.remove(z) end)
end)

-- armes prodiges : effets de zone en plus du tir (wonderFire du web)
local function wonderEnemies(m: any): { Model }
	return ZombieService.ofMatch(m.id)
end
WeaponService.ShotFired:Connect(function(c: any, key: string)
	local wdef = Z.WONDERS[key]
	if not wdef then return end
	local m = MS().matchOf(c)
	if not zOn(m) then return end
	local ch = WeaponService.charOf(c)
	local head = ch and ch:FindFirstChild("Head") :: BasePart?
	local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not ch or not head or not root then return end
	local pitch = ch:GetAttribute("Pitch")
	local dir = (root.CFrame * CFrame.Angles(if typeof(pitch) == "number" then pitch else 0, 0, 0)).LookVector
	local origin = head.Position
	local shotT = os.clock()
	local pap = person(m, c).pap[key] == true
	task.delay(0.05, function()
		-- zombie touché directement par ce tir (noté par le filtre de dégâts) : il a déjà pris les dégâts du tir
		local lh = m.data.lastHit[c]
		local direct: Model? = if lh and lh.t >= shotT - 0.01 then lh.model else nil
		local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { ch, m.data.zfolder }
		local function los(to: Vector3): boolean
			local r = workspace:Raycast(origin, to - origin, params)
			return r == nil or (r.Position - origin).Magnitude >= (to - origin).Magnitude - 0.5 * U
		end
		if wdef.wonder == "ray" then
			local r = workspace:Raycast(origin, dir * 120 * U, params)
			local impact = if r then r.Position else origin + dir * 120 * U
			if direct then impact = direct:GetPivot().Position end
			for _, z in ipairs(wonderEnemies(m)) do
				if z ~= direct and (z:GetPivot().Position - impact).Magnitude < 2.8 * U then
					WeaponService.applyDamage(c, z, wdef.dmg * 0.6, false, key, 1)
				end
			end
		else
			local range = (if wdef.wonder == "thunder" then (if pap then 18 else 14) else (if pap then 14 else 11)) * U
			local cone = if wdef.wonder == "thunder" then (if pap then 0.72 else 0.6) else 0.42
			for _, z in ipairs(wonderEnemies(m)) do
				local zp = z:GetPivot().Position
				local to = zp - origin
				local L = to.Magnitude
				if L <= range and L > 0.01 and to.Unit:Dot(dir) >= math.cos(cone) and los(zp) then
					if wdef.wonder == "thunder" then
						if z ~= direct then WeaponService.applyDamage(c, z, wdef.dmg, false, key, 1) end
						ZombieService.push(z, to, 3 * U)
					else
						ZombieService.freeze(z, if pap then 4 else 2.6)
						WeaponService.applyDamage(c, z, if z == direct then wdef.dmg * 0.5 else wdef.dmg * 1.5, false, key, 1)
					end
				end
			end
		end
	end)
end)

-- ==========================================================================================
-- Interface du mode (MatchService)
-- ==========================================================================================
function M.setup(m: any)
	Z.registerWeapons()
	-- la grille de MapData est partagée (cache) : les débris fermés vont dans une table à part
	local g = (m.map and m.map.grid) or MapData.buildGrid(m.settings.map)
	m.data.grid = setmetatable({ blocked = {} }, { __index = g })
	m.data.limit = m.settings.limit or 15
	m.limit = nil                                   -- pas de « PREMIER À » : on compte les manches
	m.data.people = {}
	m.data.lastHit = {}
	m.data.drops = {}
	m.data.waveRespawn = {}
	m.data.zs = { wave = 0, queue = 0, state = "wait", breakT = 6, spawnT = 0, special = false, boss = 0, dropsWave = 0, ammoLeft = 0, nextId = 100,
		insta = 0, dbl = 0, fire = 0, box = nil, boxSpots = {}, boxIdx = 1, boxUses = 0, result = nil }
	local folder = Instance.new("Folder"); folder.Name = "Zombies"; folder.Parent = m.map.folder
	m.data.folder = folder
	local zf = Instance.new("Folder"); zf.Name = "Horde"; zf.Parent = m.map.folder
	m.data.zfolder = zf
	m.map.folder:SetAttribute("Atmosphere", "haunt")
	buildDoors(m)
	zReach(m)
	buildEgg(m)
	-- armes murales près du départ, boîte mystère, Forge Arcane et machines à atouts réparties sur la carte (zSetup du web)
	local spots = findSpots(m)
	local sp = m.map.data.spawnCT[1]
	local home = MS().cellToWorld(m, sp[1], sp[2])
	local near = table.clone(spots)
	table.sort(near, function(a, b) return flatDist(a.pos, home) < flatDist(b.pos, home) end)
	local reach = m.data.reach
	local function inStart(s: Spot): boolean return reach[cellIdx(s.cx, s.cz)] == true end
	local first: Spot? = nil
	for _, s in ipairs(near) do if inStart(s) and flatDist(s.pos, home) > 2 * U then first = s; break end end
	if not first then for _, s in ipairs(near) do if inStart(s) then first = s; break end end end
	first = first or near[1]
	local walls: { Spot } = {}
	if first then
		walls = { first }
		local pool = {}
		for i = 1, math.max(10, #near // 2) do local s = near[i]; if s and s ~= first then table.insert(pool, s) end end
		for _, s in ipairs(pickSpread(pool, math.min(#Z.WALLBUYS, 7) - 1, { first })) do table.insert(walls, s) end
	end
	local rest = {}
	for _, s in ipairs(spots) do if not table.find(walls, s) then table.insert(rest, s) end end
	local boxSpots = pickSpread(rest, 3, walls)
	local i0 = nil
	for i, s in ipairs(boxSpots) do if inStart(s) then i0 = i; break end end
	if i0 and i0 > 1 then table.insert(boxSpots, 1, table.remove(boxSpots, i0) :: Spot)
	elseif not i0 then
		local st = {}
		for _, s in ipairs(rest) do if inStart(s) and not table.find(boxSpots, s) then table.insert(st, s) end end
		if #st > 0 then table.insert(boxSpots, 1, st[math.random(#st)]) end
	end
	local rest2 = {}
	for _, s in ipairs(rest) do if not table.find(boxSpots, s) then table.insert(rest2, s) end end
	local avoid = table.clone(walls)
	for _, s in ipairs(boxSpots) do table.insert(avoid, s) end
	local machines = pickSpread(rest2, 6, avoid)
	for i, s in ipairs(walls) do buildWall(m, s, Z.WALLBUYS[i][1], Z.WALLBUYS[i][2]) end
	m.data.zs.boxSpots = boxSpots
	if #boxSpots > 0 then buildBox(m, boxSpots[1], true) end
	for i, s in ipairs(machines) do
		if i == 1 then buildPap(m, s)
		elseif Z.PERK_ORDER[i - 1] then buildPerk(m, s, Z.PERK_ORDER[i - 1]) end
	end
end

function M.teamFor(_m: any, _c: any): string? return HUMANS end
function M.botsWanted(m: any, team: string?, want: number): number?
	if m.state == "live" then return nil end     -- ensuite les bots morts reviennent seulement au début de chaque manche
	return if team == HUMANS then want else 0
end
function M.botRespawn(_m: any, _s: any): boolean return false end
function M.spawnPoint(m: any, c: any): Vector3?
	local k = MS().keyOf(c)
	if m.data.waveRespawn and m.data.waveRespawn[k] and m.data.respawnAt then
		return m.data.respawnAt + Vector3.new((math.random() - 0.5) * 2, 3, (math.random() - 0.5) * 2)
	end
	local list = m.map.spawns.CT
	return if #list > 0 then list[math.random(#list)] else nil
end
function M.loadout(_m: any, c: any): { string }?
	return if isPlayer(c) then { "p250", "knife" } else { "glock", "knife" }
end
function M.onSpawn(m: any, c: any, char: Model)
	local p = person(m, c)
	p.perks = {}; p.pap = {}; p.p = nil; p.s = if isPlayer(c) then "p250" else "glock"; p.downed = false; p.prompt = nil
	local k = MS().keyOf(c)
	local again = m.data.waveRespawn[k]
	m.data.waveRespawn[k] = nil
	task.defer(function()
		if not char.Parent then return end
		WeaponService.setAmmo(c, p.s :: string, nil, Z.START_RES)
		WeaponService.giveGrenades(c, 0, 0, 2)
		char:SetAttribute("RateMult", nil); char:SetAttribute("Downed", nil)
		if again then
			local h = char:FindFirstChildOfClass("Humanoid"); if h then h.Health = 60 end
			char:SetAttribute("ProtectedUntil", workspace:GetServerTimeNow() + 1.5)
		end
		applyPerks(m, c)
		local s = MS().statOf(m, c); if s then s.pts = p.pts end
	end)
end
function M.onKill(m: any, _killer: any, victim: any, _key: string, _hs: boolean, _ks: any, vs: any): boolean
	if vs.team == HUMANS then
		local p = person(m, victim)
		if p.prompt then p.prompt:Destroy(); p.prompt = nil end
		p.downed = false; p.perks = {}; p.pap = {}
		syncAttrs(m, victim)
		vs.streak = 0
	end
	return true
end

function M.tick(m: any, dt: number)
	local zs = m.data.zs
	if zs.result then return end
	-- les zombies n'apparaissent pas au tableau (ils n'ont pas d'équipe ; on nettoie au cas où)
	local hs = humans(m)
	local standing = aliveHumans(m, true)
	local alive = aliveHumans(m)
	if #alive == 0 and #hs > 0 then zs.result = "lose"; return end
	local zAlive = #ZombieService.ofMatch(m.id)
	if zs.state == "wait" or zs.state == "break" then
		zs.breakT -= dt
		if zs.breakT <= 0 then zStartWave(m) end
	elseif zs.state == "spawn" then
		zs.spawnT -= dt
		if zs.spawnT <= 0 and zs.queue > 0 and zAlive < math.min(24, 6 + zs.wave * 2) then
			zSpawn(m); zs.queue -= 1
			zs.spawnT = math.max(0.35, 1.1 - zs.wave * 0.06)
		end
		if zs.queue <= 0 and zAlive == 0 then
			if zs.wave >= m.data.limit then zs.result = "win"; return end
			zs.state = "break"; zs.breakT = 9
			MS().announce(m, "MANCHE " .. zs.wave .. " TERMINÉE", "La suivante arrive…", RED)
			for p in pairs(m.players) do popEvent:FireClient(p, "", nil, "win") end
		end
	end
	-- boîte mystère (zBoxUpdate)
	local b = zs.box
	if b and b.state ~= "idle" then
		b.t += dt
		if b.state == "roll" and b.t >= 4.2 then
			if b.teddy then
				b.state = "teddy"; b.t = 0
				b.model:SetAttribute("BoxState", "teddy")
				if b.owner then
					local op = person(m, b.owner); op.pts += Z.BOX_PRICE; syncAttrs(m, b.owner)
					tell(b.owner, "Le nounours ! Points remboursés", Z.rgb(0x7fe0ff), "deny")
				end
			else
				b.state = "ready"; b.t = 0
				b.model:SetAttribute("BoxState", "ready"); b.model:SetAttribute("BoxWeapon", b.key)
				if b.key and Z.isWonder(b.key) and b.owner then MS().announce(m, string.upper(Config.WEAPONS[b.key].name), "Arme prodige !", Z.rgb(0x7dff6a), b.owner) end
			end
		elseif b.state == "ready" and b.t > 9 then
			b.state = "idle"; b.model:SetAttribute("BoxState", "idle"); b.model:SetAttribute("BoxWeapon", nil)
		elseif b.state == "teddy" and b.t > 3 then
			local n = #zs.boxSpots
			local idx = ((zs.boxIdx - 1 + 1 + math.random(0, math.max(0, n - 2))) % n) + 1
			zs.boxIdx = idx; zs.boxUses = 0
			buildBox(m, zs.boxSpots[idx], false)
		end
	end
	-- bonus au sol (26 s, clignotent les 6 dernières)
	for i = #m.data.drops, 1, -1 do
		local d = m.data.drops[i]
		d.t -= dt
		if d.part.Parent then
			d.part.CFrame = CFrame.new(d.pos + Vector3.new(0, (1 + math.sin(os.clock() * 3) * 0.15) * U, 0))
			d.part.Transparency = if d.t > 6 or math.floor(os.clock() * 6) % 2 == 0 then 0.35 else 1
		end
		if d.t <= 0 then d.part:Destroy(); table.remove(m.data.drops, i)
		else
			for _, h in ipairs(alive) do
				local r = rootOf(h)
				if r and flatDist(r.Position, d.pos) < 1.3 * U and math.abs(r.Position.Y - d.pos.Y) < 3 * U then
					d.part:Destroy(); table.remove(m.data.drops, i)
					applyDrop(m, d.key, h)
					break
				end
			end
		end
	end
	-- fragments de l'Orbe (joueurs seulement)
	for i = #m.data.frags, 1, -1 do
		local f = m.data.frags[i]
		f.part.CFrame = CFrame.new(f.pos + Vector3.new(0, math.sin(os.clock() * 2 + i) * 0.08 * U, 0)) * CFrame.Angles(math.rad(45), os.clock() * 2, math.rad(35))
		for p in pairs(m.players) do
			local r = rootOf(p)
			if r and MS().aliveChar(p) and not person(m, p).downed and flatDist(r.Position, f.pos) < 1.2 * U and math.abs(r.Position.Y - f.pos.Y) < 3 * U then
				f.part:Destroy(); table.remove(m.data.frags, i)
				m.data.fragGot += 1
				if m.data.fragGot < 3 then tell(p, "Fragment de l'Orbe " .. m.data.fragGot .. " / 3", Z.rgb(0xc77dff), "pickup")
				else
					MS().announce(m, "EASTER EGG RÉUSSI !", "L'Orbe est reconstituée — arme prodige améliorée + 5000 pts", Z.rgb(0xc77dff))
					zGive(m, p, "raygun")
					person(m, p).pap.raygun = true
					WeaponService.setAmmo(p, "raygun", WeaponService.magOf(p, "raygun"), Z.WONDERS.raygun.reserve * 2)
					zPts(m, p, 5000)
				end
				break
			end
		end
	end
	-- à terre : saignement, réanimation par les bots (zDownUpdate)
	for _, v in ipairs(alive) do
		local p = person(m, v)
		if p.downed then
			p.downT -= dt
			local ch = WeaponService.charOf(v)
			if ch then ch:SetAttribute("DownT", math.ceil(p.downT)) end
			local vr = rootOf(v)
			local best, bd = nil, math.huge
			for _, b2 in ipairs(standing) do
				if b2 ~= v and not isPlayer(b2) then
					local r = rootOf(b2)
					if r and vr and flatDist(r.Position, vr.Position) < bd then best, bd = b2, flatDist(r.Position, vr.Position) end
				end
			end
			if best and vr then
				local br = rootOf(best) :: BasePart
				local danger = false
				for _, z in ipairs(ZombieService.ofMatch(m.id)) do
					if flatDist(z:GetPivot().Position, br.Position) < 3.5 * U then danger = true; break end
				end
				m.data.reviveGoal = m.data.reviveGoal or {}
				if bd < 1.6 * U and not danger then
					p.revP += dt
					m.data.reviveGoal[best] = vr.Position
				elseif not danger or bd < 12 * U then
					m.data.reviveGoal[best] = vr.Position
				end
			end
			if p.revP >= 3 then zRevive(m, v, best)
			elseif p.downT <= 0 then bleedOut(m, v) end
		end
	end
	if #standing == 0 then
		for _, v in ipairs(alive) do if person(m, v).downed then bleedOut(m, v) end end
	end
	if m.data.reviveGoal then
		for b2, _ in pairs(m.data.reviveGoal) do
			local still = false
			for _, v in ipairs(alive) do if person(m, v).downed then still = true end end
			if not still or not MS().aliveChar(b2) then m.data.reviveGoal[b2] = nil end
		end
	end
	-- score affiché en haut : manche (survivants) et zombies restants
	local left = zAlive + zs.queue
	m.score[HUMANS] = zs.wave
	m.score["Défenseurs"] = left
	for k, s in pairs(m.stats) do if s.team ~= HUMANS then m.stats[k] = nil end end
end

function M.checkEnd(m: any): (boolean, any)
	local zs = m.data.zs
	if not zs or not zs.result then return false, nil end
	for _, z in ipairs(ZombieService.ofMatch(m.id)) do z:SetAttribute("Frozen", true); local h = z:FindFirstChildOfClass("Humanoid"); if h then h:Move(Vector3.zero) end end
	return true, if zs.result == "win" then HUMANS else "Zombies"
end

function M.botGoal(m: any, bot: Model): Vector3?
	local g = m.data.reviveGoal
	return g and g[bot] or nil
end

local function fmt(t: number): string return string.format("%d:%02d", math.floor(t / 60), math.floor(t) % 60) end
function M.info(m: any): any
	local zs = m.data.zs
	if not zs then return nil end
	local left = #ZombieService.ofMatch(m.id) + zs.queue
	local surv = #aliveHumans(m, true)
	local t = os.clock()
	local pause = zs.state == "wait" or zs.state == "break"
	local lim = if m.data.limit >= 99 then "∞" else tostring(m.data.limit)
	local fx = {}
	if zs.insta > t then table.insert(fx, "☠ MORT INSTANTANÉE " .. math.ceil(zs.insta - t)) end
	if zs.dbl > t then table.insert(fx, "×2 POINTS " .. math.ceil(zs.dbl - t)) end
	if zs.fire > t then table.insert(fx, "$ VENTE DE FEU " .. math.ceil(zs.fire - t)) end
	m.data.public = { z = {
		wave = zs.wave, limit = m.data.limit, state = zs.state, breakT = math.max(0, math.ceil(zs.breakT)), left = left, survivors = surv,
		insta = math.max(0, math.ceil(zs.insta - t)), dbl = math.max(0, math.ceil(zs.dbl - t)), fire = math.max(0, math.ceil(zs.fire - t)),
		boxPrice = if zs.fire > t then 10 else Z.BOX_PRICE, elapsed = math.floor(t - m.startedAt), frags = m.data.fragGot or 0,
	} }
	return {
		line = if pause then "PROCHAINE VAGUE  " .. math.max(0, math.ceil(zs.breakT)) .. " s" else "MANCHE " .. zs.wave .. " / " .. lim .. "   ·   " .. left .. " ZOMBIES RESTANTS",
		sub = surv .. " survivant" .. (if surv > 1 then "s" else "") .. "   ·   survie " .. fmt(t - m.startedAt) .. (if #fx > 0 then "   ·   " .. table.concat(fx, "  ") else ""),
		subWarn = zs.insta > t,
		color = RED, kind = "zombies",
	}
end

local function clearAttrs(p: Player)
	for _, a in ipairs({ "ZPts", "ZPerks", "ZPap", "ZOwn" }) do p:SetAttribute(a, nil) end
	local ch = p.Character
	if ch then for _, a in ipairs({ "RateMult", "SpeedMult", "Downed", "DownT" }) do ch:SetAttribute(a, nil) end end
end
function M.onLeave(_m: any, p: Player) clearAttrs(p) end
function M.cleanup(m: any)
	ZombieService.removeMatch(m.id)
	for p in pairs(m.players) do clearAttrs(p) end
	if m.data.folder then m.data.folder:Destroy() end
	if m.data.zfolder then m.data.zfolder:Destroy() end
	m.data.zs = nil
end

-- pour l'aperçu dans d'autres scripts
M.HUMANS = HUMANS
local _ = Players
return M
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="ModuleScript" referent="458">
      <Properties>
        <string name="Name">NetService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/NetService (ModuleScript)
-- Réseau : mesure du ping + compensation de latence (« lag compensation ») pour le tir hitscan.
-- Le serveur garde un historique des positions des joueurs (1 s, à 30 Hz) ; quand un tir arrive,
-- il rejoue la scène au moment où le tireur a visé (now - ping - interpolation) avant de lancer le rayon.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local NetService = {}

local HISTORY_SECONDS = 1
local MAX_REWIND = 0.35                         -- on ne rembobine jamais plus de 350 ms (anti-abus des gros pings)
local history: { [Player]: { { t: number, cf: CFrame } } } = {}
local pings: { [Player]: number } = {}

local pingFn = Instance.new("RemoteFunction"); pingFn.Name = "Ping"; pingFn.Parent = ReplicatedStorage
pingFn.OnServerInvoke = function(_) return os.clock() end              -- le client mesure l'aller-retour
local pingReport = Instance.new("RemoteEvent"); pingReport.Name = "PingReport"; pingReport.Parent = ReplicatedStorage
pingReport.OnServerEvent:Connect(function(player: Player, rtt: any)
	if typeof(rtt) == "number" and rtt >= 0 and rtt < 2 then pings[player] = rtt end
end)

function NetService.pingOf(player: Player): number return pings[player] or 0.06 end

RunService.Heartbeat:Connect(function()
	local now = os.clock()
	for _, p in ipairs(Players:GetPlayers()) do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then
			local h = history[p] or {}; history[p] = h
			table.insert(h, { t = now, cf = root.CFrame })
			while #h > 0 and now - h[1].t > HISTORY_SECONDS do table.remove(h, 1) end
		end
	end
end)

local function sampleAt(p: Player, t: number): CFrame?
	local h = history[p]; if not h or #h == 0 then return nil end
	for i = #h, 2, -1 do
		if h[i - 1].t <= t then
			local a, b = h[i - 1], h[i]
			return a.cf:Lerp(b.cf, math.clamp((t - a.t) / math.max(b.t - a.t, 1e-4), 0, 1))
		end
	end
	return h[1].cf
end

-- Exécute fn pendant que les autres joueurs sont replacés à leur position passée.
function NetService.rewound<T>(shooter: Player, fn: () -> T): T
	local rewind = math.min(NetService.pingOf(shooter) / 2 + 0.05, MAX_REWIND)
	local target = os.clock() - rewind
	local saved: { [Player]: CFrame } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= shooter then
			local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			local past = sampleAt(p, target)
			if root and past then saved[p] = root.CFrame; root.CFrame = past end
		end
	end
	local ok, res = pcall(fn)
	for p, cf in pairs(saved) do
		local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
		if root then root.CFrame = cf end
	end
	if not ok then error(res) end
	return res :: T
end

Players.PlayerRemoving:Connect(function(p) history[p] = nil; pings[p] = nil end)
return NetService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="459">
      <Properties>
        <string name="Name">OptionsService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/OptionsService (Script)
-- Options du joueur (Réglages du menu principal et panneau Options de la pause) gardées dans le profil (DataService) :
--   OptionsSave(data)   remplace profile.options par la version nettoyée (MenuConfig.cleanOptions : clés connues, nombres bornés)
-- À l'arrivée, l'accessibilité enregistrée est recopiée dans l'attribut « Access » que lit AccessibilityController.
-- Le reste est relu par le client dans GetProfile (profile.options). MenuSave("opts") de MenuService reste en place pour
-- les cinq anciens réglages (champ de vision, sensibilités, volume, qualité).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local HttpService = game:GetService("HttpService")

local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local DataService = require(script.Parent:WaitForChild("DataService"))

local lastSave: { [Player]: number } = {}

local save = Instance.new("RemoteFunction"); save.Name = "OptionsSave"; save.Parent = ReplicatedStorage
-- un enregistrement toutes les 0,5 s au plus, rien qui ne soit pas une table
save.OnServerInvoke = function(p: Player, data: any): boolean
	if typeof(data) ~= "table" then return false end
	if os.clock() - (lastSave[p] or 0) < 0.5 then return false end
	local profile = DataService.get(p)
	if not profile then return false end
	lastSave[p] = os.clock()
	profile.options = MenuConfig.cleanOptions(data)
	return true
end

-- accessibilité enregistrée -> attribut « Access » (daltonisme, taille de l'interface… appliqués dès l'arrivée)
local function publish(p: Player)
	for _ = 1, 30 do
		if not p.Parent then return end
		local profile = DataService.get(p)
		if profile then
			if typeof(profile.options) == "table" and typeof(profile.options.access) == "table" then
				local acc = MenuConfig.cleanOptions(profile.options).access
				local ok, raw = pcall(HttpService.JSONEncode, HttpService, acc)
				if ok then p:SetAttribute("Access", raw) end
			end
			return
		end
		task.wait(1)
	end
end
Players.PlayerAdded:Connect(publish)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(publish, p) end
Players.PlayerRemoving:Connect(function(p: Player) lastSave[p] = nil end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="460">
      <Properties>
        <string name="Name">PartyService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/PartyService (ModuleScript)
-- Groupes d'amis (jusqu'à 5) + téléportation vers un serveur privé réservé.
-- Les invitations passent par SocialService (boîte de dialogue native Roblox) ; le chef lance la partie.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TeleportService = game:GetService("TeleportService")
local MessagingService = game:GetService("MessagingService")

local PartyService = {}
local MAX_PARTY = 5

type Party = { id: string, leader: Player, members: { Player } }
local parties: { [string]: Party } = {}
local partyOf: { [Player]: string } = {}

local function remote(kind: string, name: string)
	local r = Instance.new(kind); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local partyEvent = remote("RemoteEvent", "PartyUpdate") :: RemoteEvent
local createFn = remote("RemoteFunction", "PartyCreate") :: RemoteFunction
local joinFn = remote("RemoteFunction", "PartyJoin") :: RemoteFunction
local leaveFn = remote("RemoteFunction", "PartyLeave") :: RemoteFunction
local startFn = remote("RemoteFunction", "PartyStart") :: RemoteFunction

local function broadcast(party: Party)
	local names = {}
	for _, m in ipairs(party.members) do table.insert(names, { userId = m.UserId, name = m.DisplayName, leader = m == party.leader }) end
	for _, m in ipairs(party.members) do
		m:SetAttribute("Party", party.id); m:SetAttribute("PartyLeader", m == party.leader)   -- lus par le menu (groupes du serveur)
		partyEvent:FireClient(m, party.id, names)
	end
end

local function leave(player: Player)
	local id = partyOf[player]; if not id then return end
	local party = parties[id]; partyOf[player] = nil
	if not party then return end
	local i = table.find(party.members, player); if i then table.remove(party.members, i) end
	player:SetAttribute("Party", nil); player:SetAttribute("PartyLeader", nil)
	partyEvent:FireClient(player, nil, {})
	if #party.members == 0 then parties[id] = nil return end
	if party.leader == player then party.leader = party.members[1] end
	broadcast(party)
end

createFn.OnServerInvoke = function(player: Player)
	leave(player)
	local id = string.format("%d-%d", player.UserId, os.time())
	parties[id] = { id = id, leader = player, members = { player } }; partyOf[player] = id
	broadcast(parties[id])
	return id
end
function PartyService.join(player: Player, id: any): boolean
	if typeof(id) ~= "string" then return false end
	local party = parties[id]
	if not party or #party.members >= MAX_PARTY or table.find(party.members, player) then return false end
	leave(player)
	table.insert(party.members, player); partyOf[player] = id
	broadcast(party)
	return true
end
joinFn.OnServerInvoke = PartyService.join
-- invitation (SocialService, LaunchData = numéro du groupe) : l'ami qui arrive rejoint le groupe tout seul
Players.PlayerAdded:Connect(function(player: Player)
	local ok, data = pcall(function() return player:GetJoinData() end)
	local launch = ok and typeof(data) == "table" and data.LaunchData
	if typeof(launch) == "string" and string.sub(launch, 1, 6) == "party:" then
		task.delay(3, function() if player.Parent then PartyService.join(player, string.sub(launch, 7)) end end)
	end
end)
leaveFn.OnServerInvoke = function(player: Player) leave(player); return true end

-- Le chef lance : serveur réservé + téléportation de tout le groupe
-- toujours ce jeu-ci : un numéro de place venu du client enverrait tout le groupe vers n'importe quel jeu
local RateLimit = require(script.Parent.RateLimit)
startFn.OnServerInvoke = function(player: Player, _placeId: any)
	local id = partyOf[player]; local party = id and parties[id]
	if not party or party.leader ~= player or not RateLimit.ok(player, "PartyStart", 5) then return false end
	local pid = game.PlaceId
	local ok, code = pcall(function() return TeleportService:ReserveServer(pid) end)
	if not ok then return false end
	local opts = Instance.new("TeleportOptions"); opts.ReservedServerAccessCode = code
	opts:SetTeleportData({ partyId = party.id, size = #party.members })
	local ok2 = pcall(function() TeleportService:TeleportAsync(pid, party.members, opts) end)
	return ok2
end

-- Invitation d'un ami : ouvre la fenêtre native de Roblox (le client appelle SocialService:PromptGameInvite)
Players.PlayerRemoving:Connect(leave)

-- Équilibrage : les groupes arrivent dans la même équipe (utilisé par MatchService)
-- Membres du groupe d'un joueur (lui compris) ; seul s'il n'a pas de groupe
function PartyService.membersOf(player: Player): { Player }
	local id = partyOf[player]
	local party = id and parties[id]
	return if party then table.clone(party.members) else { player }
end
function PartyService.isLeader(player: Player): boolean
	local id = partyOf[player]
	local party = id and parties[id]
	return party == nil or party.leader == player
end

function PartyService.groupsOf(players: { Player }): { { Player } }
	local seen: { [string]: { Player } } = {}
	local solo: { { Player } } = {}
	for _, p in ipairs(players) do
		local id = partyOf[p]
		if id then seen[id] = seen[id] or {}; table.insert(seen[id], p) else table.insert(solo, { p }) end
	end
	local out = {}
	for _, g in pairs(seen) do table.insert(out, g) end
	for _, g in ipairs(solo) do table.insert(out, g) end
	table.sort(out, function(a, b) return #a > #b end)
	return out
end

return PartyService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="461">
      <Properties>
        <string name="Name">PerkDrinkService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/PerkDrinkService (ModuleScript, requis par Main)
-- Boire un atout en Zombies (src/8U_perkdrink.js) : quand un joueur prend un atout, il range l'arme, sort le flacon de
-- la couleur de l'atout, fait sauter la capsule, boit, jette le flacon puis ressort l'arme. Pendant 2,3 s : ni tir ni
-- visée (vérifié ici aussi : ses tirs ne font pas de dégâts). Vu par les autres : flacon porté à la bouche.
-- Rien à appeler depuis Modes/zombies : on suit l'attribut « ZPerks » du joueur (liste des atouts, publiée par le mode)
-- et chaque atout nouveau lance la boisson. PerkDrinkService.drink(joueur, atout) reste disponible.
-- Attributs du personnage : DrinkUntil (heure serveur de fin), DrinkPerk (clé de l'atout).
-- Remote : PerkDrink (RemoteEvent, serveur -> tous : (joueur, atout, durée)).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponService = require(script.Parent.WeaponService)

local PerkDrinkService = {}
PerkDrinkService.T = 2.3

local ev = Instance.new("RemoteEvent"); ev.Name = "PerkDrink"; ev.Parent = ReplicatedStorage

local function drinking(ch: Instance?): boolean
	local u = ch and ch:GetAttribute("DrinkUntil")
	return typeof(u) == "number" and workspace:GetServerTimeNow() < u
end
PerkDrinkService.drinking = drinking

function PerkDrinkService.drink(p: Player, perk: string)
	local ch = p.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not ch or not h or h.Health <= 0 then return end
	ch:SetAttribute("DrinkUntil", workspace:GetServerTimeNow() + PerkDrinkService.T)
	ch:SetAttribute("DrinkPerk", perk)
	ev:FireAllClients(p, perk, PerkDrinkService.T)
end

-- pas de dégâts pendant qu'on boit (le client bloque déjà le tir ; ceci empêche un client trafiqué de tirer quand même)
local prevFilter = (WeaponService :: any).damageFilter
;(WeaponService :: any).damageFilter = function(attacker: any, victimChar: Model, raw: number, headshot: boolean, key: string): number?
	if typeof(attacker) == "Instance" and attacker:IsA("Player") and drinking(attacker.Character) then return nil end
	if prevFilter then return prevFilter(attacker, victimChar, raw, headshot, key) end
	return raw
end
local prevThrow = (WeaponService :: any).throwBlocked
;(WeaponService :: any).throwBlocked = function(c: any): boolean
	if typeof(c) == "Instance" and c:IsA("Player") and drinking(c.Character) then return true end
	return if prevThrow then prevThrow(c) else false
end

-- suit la liste des atouts du joueur (attribut ZPerks : "jugg,speed,…")
local function setOf(v: any): { [string]: boolean }
	local s = {}
	if typeof(v) == "string" then for k in string.gmatch(v, "[^,]+") do s[k] = true end end
	return s
end
local function watch(p: Player)
	local prev = setOf(p:GetAttribute("ZPerks"))
	p:GetAttributeChangedSignal("ZPerks"):Connect(function()
		local now = setOf(p:GetAttribute("ZPerks"))
		local new: string? = nil
		for k in pairs(now) do if not prev[k] then new = k end end
		prev = now
		if new then PerkDrinkService.drink(p, new) end
	end)
end
Players.PlayerAdded:Connect(watch)
for _, p in ipairs(Players:GetPlayers()) do watch(p) end

return PerkDrinkService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="462">
      <Properties>
        <string name="Name">ProgressService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ProgressService (ModuleScript)
-- Passe de combat saisonnier, classement (PR), succès (+ Badges Roblox) et événement limité.
-- À appeler depuis RewardService.finishMatch (voir Main.server.lua) avec le résumé de partie.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local BadgeService = game:GetService("BadgeService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local DataService = require(script.Parent.DataService)

local ProgressService = {}

-- Crée ces badges dans le Creator Hub puis colle leurs identifiants ici (0 = ignoré)
local BADGE_IDS: { [string]: number } = {}

local function ensure(profile)
	if not profile.bp or profile.bp.id ~= X.SEASON.id then
		profile.bp = { id = X.SEASON.id, xp = 0, premium = false, claimedFree = {}, claimedPremium = {} }
	end
	profile.rank = profile.rank or { rp = 0, best = 0 }
	profile.ach = profile.ach or {}
	profile.ev = profile.ev or { id = "", pumpkins = 0, claimed = {} }
	profile.weaponKills = profile.weaponKills or {}
	profile.cosmetics = profile.cosmetics or { attachments = {}, charm = "", trail = "", spray = "smile", title = "", knife = "classic" }
end
ProgressService.ensure = ensure

local function bpTier(profile): number
	return math.min(X.SEASON.tiers, math.floor(profile.bp.xp / X.SEASON.xpPerTier))
end

-- ---------- passe de combat ----------
local function seededItem(tier: number, rarity: number)
	-- même tirage pour tous les joueurs : l'objet du palier est déterministe
	local pool = {}
	for w, _ in pairs(Config.WEAPONS) do
		for i, skin in ipairs(Config.SKINS) do
			if skin.rarity == rarity and w ~= "knife" and not (skin :: any).ev then table.insert(pool, { weapon = w, skin = i }) end   -- skins d'événement : jamais dans le passe
		end
	end
	table.sort(pool, function(a, b) return a.weapon .. a.skin < b.weapon .. b.skin end)
	local r = Random.new(tier * 17 + rarity)
	return pool[r:NextInteger(1, #pool)]
end

function ProgressService.claimTier(player: Player, tier: number, premium: boolean)
	local profile = DataService.get(player); if not profile then return nil end
	ensure(profile)
	local claimed = if premium then profile.bp.claimedPremium else profile.bp.claimedFree
	if tier ~= math.floor(tier) or tier < 1 or tier > bpTier(profile) or table.find(claimed, tier) then return nil end   -- palier entier seulement (1,5 ferait un palier fantôme)
	if premium and not profile.bp.premium then return nil end
	local r = X.bpReward(tier, premium)
	if r.coins then profile.coins += r.coins end
	if r.box then profile.boxes[r.box] = (profile.boxes[r.box] or 0) + 1 end
	local granted
	if r.item then
		granted = seededItem(tier, r.rarity)
		local owned = profile.inv.skins[granted.weapon] or {}
		if table.find(owned, granted.skin) then
			profile.coins += Config.DUPLICATE_VALUE[r.rarity]
			granted.duplicate = true
		else
			table.insert(owned, granted.skin); profile.inv.skins[granted.weapon] = owned
		end
	end
	table.insert(claimed, tier)
	return { reward = r, item = granted }
end

function ProgressService.grantPremium(player: Player)
	local profile = DataService.get(player); if not profile then return false end
	ensure(profile); profile.bp.premium = true
	return true
end

function ProgressService.buyPremiumWithCoins(player: Player): boolean
	local profile = DataService.get(player); if not profile then return false end
	ensure(profile)
	if profile.bp.premium or profile.coins < X.SEASON.premiumCoins then return false end
	profile.coins -= X.SEASON.premiumCoins; profile.bp.premium = true
	return true
end

-- ---------- succès ----------
local function awardBadge(player: Player, id: string)
	local badge = BADGE_IDS[id]
	if badge and badge > 0 then task.spawn(function() pcall(BadgeService.AwardBadge, BadgeService, player.UserId, badge) end) end
end
local function checkAchievements(player: Player, profile, ctx)
	local unlocked = {}
	for _, a in ipairs(X.ACHIEVEMENTS) do
		if not profile.ach[a.id] then
			local ok = false
			if a.stat then ok = (profile.stats[a.stat] or 0) >= a.target
			elseif a.match then ok = (ctx[a.match] or 0) >= a.target
			elseif a.rank then ok = math.floor(profile.rank.rp / X.RANK_RP_PER_DIVISION) >= a.rank end
			if ok then
				profile.ach[a.id] = os.time(); profile.coins += a.coins
				table.insert(unlocked, a.id); awardBadge(player, a.id)
			end
		end
	end
	return unlocked
end

-- ---------- événement ----------
local function today(): string return os.date("!%Y-%m-%d") :: string end
function ProgressService.eventActive(): boolean
	local t = today(); return t >= X.EVENT.from and t <= X.EVENT.to
end
local toastEvent = Instance.new("RemoteEvent"); toastEvent.Name = "PumpkinToast"; toastEvent.Parent = ReplicatedStorage   -- serveur -> joueur : { count, lines }

-- objets d'Halloween d'un palier (src/8W_halloween.js applyReward) : skin pour toutes les armes, tenue, effet d'élimination
local function skinIndex(pattern: string): number?
	for i, sk in ipairs(Config.SKINS) do if sk.pattern == pattern then return i end end
	return nil
end
local function outfitIndex(name: string): number?
	for i, o in ipairs(Config.OUTFITS) do if o.name == name then return i end end
	return nil
end
local function grantHw(profile: any, g: any): { string }
	local lines = {}
	if g.skin then
		local i = skinIndex(g.skin)
		if i then
			for w in pairs(Config.WEAPONS) do
				local owned = profile.inv.skins[w] or {}
				if not table.find(owned, i) then table.insert(owned, i) end
				profile.inv.skins[w] = owned
			end
			table.insert(lines, "Skin " .. Config.SKINS[i].name)
		end
	end
	if g.outfit then
		local i = outfitIndex(g.outfit)
		if i then
			profile.inv.outfits = profile.inv.outfits or {}
			if not table.find(profile.inv.outfits, i) then table.insert(profile.inv.outfits, i) end
			table.insert(lines, "Tenue " .. g.outfit)
		end
	end
	if g.fx then
		profile.inv.killfx = profile.inv.killfx or {}
		if not table.find(profile.inv.killfx, g.fx) then table.insert(profile.inv.killfx, g.fx) end
		local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
		local f = KillFxConfig.get(g.fx)
		table.insert(lines, "Effet " .. (if f then f.name else g.fx))
	end
	return lines
end
-- texte d'un palier (rewardText du web)
function ProgressService.goalText(g: any): string
	local a = {}
	if g.coins then table.insert(a, g.coins .. " pièces") end
	if g.box then table.insert(a, if g.box == "prem" then "Caisse Premium" else "Caisse Standard") end
	if g.dance and Config.DANCES[g.dance] then table.insert(a, "Danse « " .. Config.DANCES[g.dance].name .. " »") end
	if g.skin then local i = skinIndex(g.skin); if i then table.insert(a, "Skin " .. Config.SKINS[i].name) end end
	if g.outfit then table.insert(a, "Tenue " .. g.outfit) end
	if g.fx then
		local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
		local f = KillFxConfig.get(g.fx)
		table.insert(a, "Effet " .. (if f then f.name else g.fx))
	end
	return table.concat(a, " • ")
end
-- paliers atteints : récompenses de base (claimed = n) et objets d'Halloween (claimed = "hw" .. n, rattrapage des anciens profils)
local GOALS: { any } = X.EVENT.goals :: any
local function claimGoals(profile: any): ({ any }, { string })
	local rewards, lines = {}, {}
	for _, g in ipairs(GOALS) do
		if profile.ev.pumpkins >= g.n then
			if (g.coins or g.box or g.dance) and not table.find(profile.ev.claimed, g.n) then
				table.insert(profile.ev.claimed, g.n)
				if g.coins then profile.coins += g.coins end
				if g.box then profile.boxes[g.box] = (profile.boxes[g.box] or 0) + 1 end
				if g.dance and not table.find(profile.inv.dances, g.dance) then table.insert(profile.inv.dances, g.dance) end
				table.insert(rewards, g)
				table.insert(lines, "🎃 Palier " .. g.n .. " : " .. ProgressService.goalText(g))
			end
			local tag = "hw" .. g.n
			if (g.skin or g.outfit or g.fx) and not table.find(profile.ev.claimed, tag) then
				table.insert(profile.ev.claimed, tag)
				local got = grantHw(profile, g)
				if not table.find(rewards, g) then table.insert(rewards, g) end
				if #got > 0 then table.insert(lines, "🎃 Palier " .. g.n .. " : " .. table.concat(got, " • ")) end
			end
		end
	end
	return rewards, lines
end
local function evProfile(profile: any)
	ensure(profile)
	if profile.ev.id ~= X.EVENT.id then profile.ev = { id = X.EVENT.id, pumpkins = 0, claimed = {} } end
end
function ProgressService.collectPumpkin(player: Player): any
	local profile = DataService.get(player); if not profile or not ProgressService.eventActive() then return nil end
	evProfile(profile)
	profile.ev.pumpkins += 1
	local rewards, lines = claimGoals(profile)
	toastEvent:FireClient(player, { count = profile.ev.pumpkins, lines = lines })
	return { count = profile.ev.pumpkins, rewards = rewards }
end
-- état de l'événement pour le menu (paliers, citrouilles ramassées, textes)
function ProgressService.eventStatus(player: Player): any
	local profile: any = DataService.get(player)
	local pk = 0
	if profile then ensure(profile); if profile.ev.id == X.EVENT.id then pk = profile.ev.pumpkins end end
	local goals = {}
	for _, g in ipairs(GOALS) do table.insert(goals, { n = g.n, text = ProgressService.goalText(g), done = pk >= g.n }) end
	return { id = X.EVENT.id, name = X.EVENT.name, from = X.EVENT.from, to = X.EVENT.to, active = ProgressService.eventActive(), pumpkins = pk, goals = goals }
end
-- rattrapage à l'arrivée : paliers déjà atteints avant l'ajout des objets d'Halloween
task.spawn(function()
	local function catchUp(p: Player)
		for _ = 1, 30 do
			local profile = DataService.get(p)
			if profile then
				ensure(profile)
				if ProgressService.eventActive() and profile.ev.id == X.EVENT.id then claimGoals(profile) end
				return
			end
			task.wait(1)
		end
	end
	Players.PlayerAdded:Connect(catchUp)
	for _, p in ipairs(Players:GetPlayers()) do task.spawn(catchUp, p) end
end)

-- ---------- fin de partie ----------
-- summary : { xp, won, mode, difficulty, ranked, kills, brWin, zombieWave, kothWin, trainScore, weaponKills }
function ProgressService.finishMatch(player: Player, summary)
	local profile = DataService.get(player); if not profile then return nil end
	ensure(profile)
	local before = bpTier(profile)
	profile.bp.xp += summary.xp
	local rankInfo
	if summary.ranked and X.RANKED_MODES[summary.mode] and (summary.difficulty or 0) >= 1 then
		local old = profile.rank.rp
		profile.rank.rp = math.max(0, old + X.rankDelta(summary.won, summary.difficulty))
		profile.rank.best = math.max(profile.rank.best, profile.rank.rp)
		rankInfo = { delta = profile.rank.rp - old, name = X.rankName(profile.rank.rp) }
	end
	for k, v in pairs(summary.weaponKills or {}) do profile.weaponKills[k] = (profile.weaponKills[k] or 0) + v end
	local ach = checkAchievements(player, profile, summary)
	return { tier = bpTier(profile), tiersGained = bpTier(profile) - before, rank = rankInfo, achievements = ach }
end

-- ---------- Remotes UI ----------
local function remote(name: string, fn: (Player, ...any) -> any)
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; r.OnServerInvoke = fn
end
local RateLimit = require(script.Parent.RateLimit)
remote("BP_Claim", function(p, tier: any, premium: any)
	if typeof(tier) ~= "number" or typeof(premium) ~= "boolean" or not RateLimit.ok(p, "BP_Claim", 0.15) then return nil end
	return ProgressService.claimTier(p, tier, premium)
end)
remote("BP_BuyPremium", function(p) return ProgressService.buyPremiumWithCoins(p) end)
-- fenêtre du passe de combat (PassUI) : paliers gratuits et Premium, avec l'objet exact de chaque palier Premium
-- (même tirage que claimTier) pour l'aperçu 3D ; « tout récupérer » d'un coup. Cadence limitée.
remote("BP_State", function(p)
	if not RateLimit.ok(p, "BP_State", 0.25) then return nil end
	local profile = DataService.get(p); if not profile then return nil end
	ensure(profile)
	local tiers = {}
	for t = 1, X.SEASON.tiers do
		local free, prem = X.bpReward(t, false), X.bpReward(t, true)
		local item = if prem.item then seededItem(t, prem.rarity) else nil
		table.insert(tiers, { free = free, prem = prem, item = item })
	end
	return { name = X.SEASON.name, tier = bpTier(profile), max = X.SEASON.tiers, xp = profile.bp.xp, xpPerTier = X.SEASON.xpPerTier,
		premium = profile.bp.premium, claimedFree = profile.bp.claimedFree, claimedPremium = profile.bp.claimedPremium,
		premiumCoins = X.SEASON.premiumCoins, premiumRobux = X.SEASON.premiumRobux, coins = profile.coins, tiers = tiers }
end)
remote("BP_ClaimAll", function(p)
	if not RateLimit.ok(p, "BP_ClaimAll", 1) then return nil end
	local profile = DataService.get(p); if not profile then return nil end
	ensure(profile)
	local got = {}
	for t = 1, bpTier(profile) do
		for _, prem in ipairs({ false, true }) do
			local list = if prem then profile.bp.claimedPremium else profile.bp.claimedFree
			if not table.find(list, t) and (not prem or profile.bp.premium) then
				local r = ProgressService.claimTier(p, t, prem)
				if r then r.tier = t; r.premium = prem; table.insert(got, r) end
			end
		end
	end
	if #got > 0 then task.spawn(DataService.save, p) end
	return got
end)
remote("EventStatus", function(p) return ProgressService.eventStatus(p) end)
remote("PumpkinCollected", function(p, id: any)
	-- la citrouille existe côté serveur (Part nommée "Pumpkin") : on vérifie la distance avant de créditer
	if typeof(id) ~= "Instance" or not id:IsA("BasePart") or id.Name ~= "Pumpkin" or not id:IsDescendantOf(workspace) then return nil end
	local root = p.Character and p.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or ((id :: BasePart).Position - root.Position).Magnitude > 12 then return nil end
	id:Destroy()
	return ProgressService.collectPumpkin(p)
end)

-- Citrouille à ramasser : Part « Pumpkin » (vérifiée par PumpkinCollected) habillée en citrouille sculptée (jackO du web)
function ProgressService.pumpkinAt(pos: Vector3, parent: Instance?): BasePart
	local p = Instance.new("Part"); p.Name = "Pumpkin"; p.Shape = Enum.PartType.Ball; p.Size = Vector3.new(2.2, 1.8, 2.2)
	p.Color = Color3.fromRGB(232, 112, 26); p.Material = Enum.Material.SmoothPlastic; p.Anchored = true; p.CanCollide = false; p.CanQuery = false
	p.Position = pos + Vector3.new(0, 0.9, 0)
	for i = 0, 5 do   -- côtes
		local a = i / 6 * math.pi
		local r = Instance.new("Part"); r.Name = "Rib"; r.Shape = Enum.PartType.Ball; r.Size = Vector3.new(0.9, 1.75, 2.25)
		r.Color = Color3.fromRGB(214, 98, 20); r.Material = Enum.Material.SmoothPlastic; r.Anchored = true; r.CanCollide = false; r.CanQuery = false; r.CanTouch = false
		r.CFrame = CFrame.new(p.Position) * CFrame.Angles(0, a, 0); r.Parent = p
	end
	local stem = Instance.new("Part"); stem.Name = "Stem"; stem.Size = Vector3.new(0.25, 0.5, 0.25); stem.Color = Color3.fromRGB(74, 90, 34)
	stem.Anchored = true; stem.CanCollide = false; stem.CanQuery = false; stem.CanTouch = false
	stem.CFrame = CFrame.new(p.Position + Vector3.new(0, 1.05, 0)) * CFrame.Angles(0, 0, 0.25); stem.Parent = p
	for _, sx in ipairs({ -0.4, 0.4 }) do   -- yeux lumineux
		local e = Instance.new("Part"); e.Name = "Eye"; e.Size = Vector3.new(0.32, 0.32, 0.1); e.Material = Enum.Material.Neon; e.Color = Color3.fromRGB(255, 208, 96)
		e.Anchored = true; e.CanCollide = false; e.CanQuery = false; e.CanTouch = false
		e.CFrame = CFrame.new(p.Position + Vector3.new(sx, 0.2, -1.08)) * CFrame.Angles(0, 0, math.rad(45)); e.Parent = p
	end
	local mouth = Instance.new("Part"); mouth.Name = "Mouth"; mouth.Size = Vector3.new(0.9, 0.18, 0.1); mouth.Material = Enum.Material.Neon; mouth.Color = Color3.fromRGB(255, 208, 96)
	mouth.Anchored = true; mouth.CanCollide = false; mouth.CanQuery = false; mouth.CanTouch = false
	mouth.CFrame = CFrame.new(p.Position + Vector3.new(0, -0.3, -1.06)); mouth.Parent = p
	local light = Instance.new("PointLight"); light.Color = Color3.fromRGB(255, 120, 20); light.Range = 10; light.Parent = p
	local prompt = Instance.new("ProximityPrompt"); prompt.ActionText = "Ramasser"; prompt.ObjectText = "Citrouille"; prompt.HoldDuration = 0; prompt.MaxActivationDistance = 8; prompt.RequiresLineOfSight = false; prompt.Parent = p
	prompt.Triggered:Connect(function(player)
		if not p.Parent then return end
		p:Destroy()
		ProgressService.collectPumpkin(player)
	end)
	p.Parent = parent or workspace
	return p
end

-- Décor d'événement : citrouilles posées sur les points de passage des bots (MapData.roam)
function ProgressService.spawnPumpkins(map, cellToWorld: (number, number) -> Vector3, parent: Instance?)
	if not ProgressService.eventActive() then return end
	local pts = table.clone(map.roam or {})
	local rng = Random.new()
	for i = #pts, 2, -1 do local j = rng:NextInteger(1, i); pts[i], pts[j] = pts[j], pts[i] end
	for i = 1, math.min(X.EVENT.pumpkinsPerMatch, #pts) do
		ProgressService.pumpkinAt(cellToWorld(pts[i][1], pts[i][2]) + Vector3.new(0, 0.1, 0), parent)
	end
end

return ProgressService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="463">
      <Properties>
        <string name="Name">RateLimit</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/RateLimit (ModuleScript)
-- Cadence des remotes de récompenses et de boutique : un joueur ne peut pas appeler la même action plus d'une fois
-- toutes les `gap` secondes (un client modifié qui spamme ne fait que recevoir des refus).
--   if not RateLimit.ok(player, "ShopBuy", 0.4) then return { ok = false, err = "Doucement !" } end
local Players = game:GetService("Players")

local RateLimit = {}
local last: { [Player]: { [string]: number } } = {}

function RateLimit.ok(player: Player, key: string, gap: number): boolean
	local t = os.clock()
	local mine = last[player]
	if not mine then mine = {}; last[player] = mine end
	local prev = mine[key]
	if prev and t - prev < gap then return false end
	mine[key] = t
	return true
end

Players.PlayerRemoving:Connect(function(p) last[p] = nil end)

return RateLimit
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="464">
      <Properties>
        <string name="Name">RecapService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/RecapService (ModuleScript, requis par Main après MedalService)
-- Écran de fin de partie façon Call of Duty / Fortnite : complète le résumé MatchEnd (MatchService.finishHooks) avec
-- payload.recap = {
--   lines      = { { t, xp } }  détail de l'XP (participation, éliminations, victoire, mode de la semaine, week-end, médailles…)
--   bonus      = { texte }       bonus de fidélité, Premium, boost, première victoire du jour (LoyaltyService)
--   xp, coins  = gains totaux ; coinsTotal = pièces du joueur après la partie
--   from, to   = { level, xp, need } avant / après la partie (la barre de niveau se remplit d'un état à l'autre)
--   challenges = défis du jour / de la semaine terminés pendant la partie (à récupérer dans le menu)
--   bp         = { tier, gained, frac, max, claimable } passe de combat
--   weekend, firstWin, firstWinLeft (première victoire du jour encore possible), featured (mode de la semaine)
-- }
-- Rien n'est crédité ici : tout l'a déjà été par RewardService / MedalService / ProgressService. On ne fait que décrire.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Modes = require(ReplicatedStorage.Shared.Modes)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local LoyaltyService = require(script.Parent.LoyaltyService)
local MatchService = require(script.Parent.MatchService)

local RecapService = {}

local function lvl(xp: number): { level: number, xp: number, need: number }
	local l, cur, need = RewardService.levelInfo({ xp = xp })
	return { level = l, xp = cur, need = need }
end

table.insert(MatchService.finishHooks, function(m: any, p: Player, _s: any, _won: boolean, payload: { [string]: any })
	local r = payload.rewards
	local profile = DataService.get(p)
	if not r or not profile then return end
	local lines = table.clone(r.lines or {})
	if (r.medXp or 0) > 0 then table.insert(lines, { t = "Médailles", xp = r.medXp }) end
	-- passe de combat : palier atteint, avancée dans le palier, récompenses qui attendent
	local bp = profile.bp
	local bpInfo = nil
	if bp then
		local tier = math.min(X.SEASON.tiers, math.floor((bp.xp or 0) / X.SEASON.xpPerTier))
		local claimable = 0
		for t = 1, tier do
			if not table.find(bp.claimedFree or {}, t) then claimable += 1 end
			if bp.premium and not table.find(bp.claimedPremium or {}, t) then claimable += 1 end
		end
		bpInfo = { tier = tier, max = X.SEASON.tiers, gained = payload.progress and payload.progress.tiersGained or 0,
			frac = if tier >= X.SEASON.tiers then 1 else ((bp.xp or 0) % X.SEASON.xpPerTier) / X.SEASON.xpPerTier, claimable = claimable, premium = bp.premium == true }
	end
	local y = LoyaltyService.ensure(profile)
	payload.recap = {
		lines = lines, bonus = r.bonus or {}, xp = r.xp, coins = r.coins, coinsTotal = profile.coins,
		from = lvl(r.xpStart or profile.xp), to = lvl(profile.xp),
		challenges = RewardService.takeDone(p), bp = bpInfo,
		weekend = r.weekend == true, firstWin = r.firstWin == true, firstWinLeft = y.win ~= math.floor(os.time() / 86400),
		featured = m.mode == Modes.featured(),
	}
end)

return RecapService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="465">
      <Properties>
        <string name="Name">RegenService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/RegenService (Script)
-- Régénération de santé du jeu web (src/8J_regen.js) : après 3 s sans subir de dégâts, les PV remontent de 20 PV/s
-- jusqu'à 100, pour les joueurs et les bots. Pas pour les zombies, les cibles d'entraînement ni un joueur à terre.
-- Pas dans les modes à manches sans réapparition (Compétitif, Désamorçage rapide, Duel, Gunfight, duels du lobby)
-- ni à l'Entraînement : la santé y reste tactique. Le script « Health » de Roblox est remplacé par un script vide
-- (StarterCharacterScripts/Health), sinon il ajoutait 1 % de vie par seconde partout.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")

local DELAY, RATE, MAX = 3, 20, 100
local NO_REGEN = { bomb = true, rapid = true, duel = true, gunfight = true, train = true }

type Track = { last: number, hurt: number }
local track: { [Humanoid]: Track } = {}

local function watch(h: Humanoid)
	if track[h] then return end
	local st: Track = { last = h.Health, hurt = os.clock() }
	track[h] = st
	-- tout dégât relance le délai (coups, chute, explosions…)
	h.HealthChanged:Connect(function(hp: number)
		if hp < st.last - 1e-3 then st.hurt = os.clock() end
		st.last = hp
	end)
	h.AncestryChanged:Connect(function()
		if not h:IsDescendantOf(workspace) then track[h] = nil end
	end)
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then watch(d) end
end)
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Humanoid") then watch(d) end
end

-- mode de la partie d'un combattant : attribut MatchMode du joueur ; un bot prend celui d'un joueur de sa partie
local function modeOf(char: Model): string?
	local p = Players:GetPlayerFromCharacter(char)
	if p then
		local zone = p:GetAttribute("Zone")
		if zone == "duel" then return "duel" end
		if zone ~= "match" then return nil end
		local m = p:GetAttribute("MatchMode")
		return if typeof(m) == "string" then m else nil
	end
	local id = char:GetAttribute("MatchId")
	if id == nil then return nil end
	for _, q in ipairs(Players:GetPlayers()) do
		if q:GetAttribute("MatchId") == id then
			local m = q:GetAttribute("MatchMode")
			return if typeof(m) == "string" then m else nil
		end
	end
	return nil
end

local acc = 0
RunService.Heartbeat:Connect(function(dt: number)
	acc += dt
	if acc < 0.1 then return end
	local step = acc; acc = 0
	local now = os.clock()
	for h, st in pairs(track) do
		local hp = h.Health
		local cap = math.min(MAX, h.MaxHealth)
		if hp <= 0 or hp >= cap or now - st.hurt < DELAY then continue end
		local char = h.Parent
		if not char or not char:IsA("Model") then continue end
		if char:GetAttribute("Zombie") == true or char:GetAttribute("Dummy") == true or char:GetAttribute("Downed") == true then continue end
		local mode = modeOf(char)
		if mode and NO_REGEN[mode] then continue end
		local nh = math.min(cap, hp + RATE * step)
		st.last = nh                                   -- notre propre soin n'est pas un dégât
		h.Health = nh
	end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="466">
      <Properties>
        <string name="Name">RewardService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/RewardService (ModuleScript)
-- XP / niveaux, récompense quotidienne (série de 7 jours), défis du jour, récompenses de fin de partie.
-- Fin de partie : le détail des gains (lignes XP / pièces) part dans le résumé MatchEnd (RecapService le complète,
-- RewardScreen l'affiche côté client) ; chaque montée de niveau est envoyée au joueur (remote « LevelUp ») avec sa récompense.
-- Bonus : XP ×2 le week-end (samedi et dimanche UTC) et passe de jeu « XP ×2 » (attribut PassXp2 posé par ShopService) ;
-- les pièces, elles, ne sont pas doublées (économie lente).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Modes = require(ReplicatedStorage.Shared.Modes)
local DataService = require(script.Parent.DataService)
local LoyaltyService = require(script.Parent.LoyaltyService)
local LeaderboardService = require(script.Parent.LeaderboardService)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local RateLimit = require(script.Parent.RateLimit)

local RewardService = {}

local function today(): number
	return math.floor(os.time() / 86400)      -- jour UTC
end

-- ---------- niveaux ----------
function RewardService.levelInfo(profile)
	local level, xp = 1, profile.xp
	while xp >= Config.xpNeeded(level) do
		xp -= Config.xpNeeded(level)
		level += 1
	end
	return level, xp, Config.xpNeeded(level)
end

local function applyReward(profile, r)
	if r.coins then profile.coins += r.coins end
	if r.box then profile.boxes[r.box] = (profile.boxes[r.box] or 0) + (r.n or 1) end
	if r.dance and not table.find(profile.inv.dances, r.dance) then table.insert(profile.inv.dances, r.dance) end
end
RewardService.applyReward = applyReward

local function levelReward(level: number)
	if level % 25 == 0 then return { box = "prem", coins = 250 } end
	if level % 10 == 0 then return { box = "std", coins = 150 } end
	if level % 5 == 0 then return { coins = 120 } end
	return { coins = 30 + level * 3 }
end
RewardService.levelReward = levelReward

-- montée de niveau : fenêtre « NIVEAU SUPÉRIEUR » côté client (RewardScreen), avec la récompense et le prochain gros palier
local levelUpEvent = Instance.new("RemoteEvent"); levelUpEvent.Name = "LevelUp"; levelUpEvent.Parent = ReplicatedStorage
local function nextMilestone(level: number): any
	local l = level + 1
	while l % 5 ~= 0 do l += 1 end
	return { level = l, reward = levelReward(l) }
end

function RewardService.addXP(player: Player, amount: number)
	local profile = DataService.get(player)
	if not profile then return {} end
	local before = RewardService.levelInfo(profile)
	profile.xp += amount
	local after = RewardService.levelInfo(profile)
	local ups = {}
	for l = before + 1, after do
		local r = levelReward(l)
		applyReward(profile, r)
		table.insert(ups, { level = l, reward = r })
	end
	if #ups > 0 then levelUpEvent:FireClient(player, { ups = ups, level = after, milestone = nextMilestone(after) }) end
	return ups
end

-- ---------- bonus d'XP ----------
-- week-end : samedi ou dimanche (UTC), XP ×2 en fin de partie
function RewardService.weekend(): boolean
	local wd = (os.date("!*t", os.time()) :: any).wday   -- 1 = dimanche, 7 = samedi
	return wd == 1 or wd == 7
end

-- ---------- récompense quotidienne ----------
function RewardService.dailyStatus(profile)
	local t = today()
	if profile.lastLoginDay == t then
		return { canClaim = false, day = ((profile.streak - 1) % 7) + 1, streak = profile.streak }
	end
	local nextStreak = (profile.lastLoginDay == t - 1) and (profile.streak + 1) or 1
	local shield = nextStreak == 1 and LoyaltyService.shieldOk(profile)   -- Premium : un jour manqué par semaine est pardonné
	if shield then nextStreak = profile.streak + 1 end
	return { canClaim = true, day = ((nextStreak - 1) % 7) + 1, streak = nextStreak, shield = shield }
end

function RewardService.claimDaily(player: Player)
	local profile = DataService.get(player)
	if not profile then return nil end
	local st = RewardService.dailyStatus(profile)
	if not st.canClaim then return nil end
	if st.shield then LoyaltyService.useShield(profile) end
	profile.streak = st.streak
	profile.lastLoginDay = today()
	local r = Config.DAILY[st.day]
	applyReward(profile, r)
	return r, st.day
end

-- ---------- défis du jour ----------
-- n = texte du défi ({t} = objectif), comme MPOOL du web (src/62_meta.js + src/8O_defis.js + src/8W_confirm.js)
local MISSION_POOL = {
	{ id = "kills", n = "Élimine {t} adversaires", target = 15, coins = 50, xp = 60 },
	{ id = "hs", n = "Fais {t} headshots", target = 5, coins = 40, xp = 50 },
	{ id = "win", n = "Gagne {t} partie", target = 1, coins = 65, xp = 80 },
	{ id = "matches", n = "Joue {t} parties", target = 3, coins = 60, xp = 60 },
	{ id = "plant", n = "Pose ou désamorce la bombe {t} fois", target = 2, coins = 50, xp = 60 },
	{ id = "nade", n = "Élimine {t} adversaires avec une grenade", target = 2, coins = 65, xp = 70 },
	{ id = "knife", n = "Élimine {t} adversaire au couteau", target = 1, coins = 85, xp = 90 },
	{ id = "dmg", n = "Inflige {t} dégâts", target = 1500, coins = 50, xp = 60 },
	-- défis ajoutés par src/8O_defis.js : par type d'arme, par mode, Zombies, Infecté
	{ id = "k_shotgun", n = "Élimine {t} adversaires au fusil à pompe", target = 8, coins = 180, xp = 70 },
	{ id = "k_sniper", n = "Élimine {t} adversaires au fusil de précision", target = 5, coins = 200, xp = 80 },
	{ id = "k_smg", n = "Élimine {t} adversaires au pistolet-mitrailleur", target = 12, coins = 160, xp = 60 },
	{ id = "k_pistol", n = "Élimine {t} adversaires au pistolet", target = 8, coins = 180, xp = 70 },
	{ id = "k_rifle", n = "Élimine {t} adversaires au fusil d'assaut", target = 15, coins = 160, xp = 60 },
	{ id = "w_duel", n = "Gagne {t} Duel", target = 1, coins = 220, xp = 90 },
	{ id = "w_dom", n = "Gagne {t} partie de Domination", target = 1, coins = 220, xp = 90 },
	{ id = "w_gg", n = "Gagne {t} Course aux armes", target = 1, coins = 250, xp = 100 },
	{ id = "z_wave", n = "Survis à {t} manches de Zombies", target = 5, coins = 200, xp = 80 },
	{ id = "inf_surv", n = "Termine {t} partie d'Infecté sans être infecté", target = 1, coins = 250, xp = 100 },
	{ id = "kcTag", n = "Ramasse {t} plaques en Élimination confirmée", target = 10, coins = 150, xp = 70 },
	-- modes ajoutés : Gunfight et Survolté
	{ id = "w_gunfight", n = "Gagne {t} Gunfight", target = 1, coins = 220, xp = 90 },
	{ id = "w_survolte", n = "Gagne {t} partie de Survolté", target = 1, coins = 220, xp = 90 },
	-- port Roblox (défis renouvelables) : médailles (MedalService, « md_ »), mouvements et têtes (CareerService),
	-- sites de bombe (Modes/rounds), autres modes. Gains modestes : l'économie reste lente.
	{ id = "md_assist", n = "Fais {t} assistances", target = 4, coins = 60, xp = 60 },
	{ id = "md_long", n = "Réussis {t} tirs lointains (plus de 38 m)", target = 3, coins = 70, xp = 70 },
	{ id = "md_double", n = "Fais {t} doubles éliminations", target = 2, coins = 70, xp = 70 },
	{ id = "md_revenge", n = "Venge-toi {t} fois de ton tueur", target = 2, coins = 55, xp = 60 },
	{ id = "md_first", n = "Fais le premier sang {t} fois", target = 1, coins = 60, xp = 60 },
	{ id = "md_slide", n = "Élimine {t} adversaires en glissade", target = 2, coins = 70, xp = 70 },
	{ id = "md_air", n = "Élimine {t} adversaires en plein saut", target = 2, coins = 70, xp = 70 },
	{ id = "md_pointblank", n = "Élimine {t} adversaires à bout portant", target = 3, coins = 55, xp = 60 },
	{ id = "md_buzzkill", n = "Arrête {t} séries adverses (Rabat-joie)", target = 2, coins = 65, xp = 70 },
	{ id = "slide", n = "Fais {t} glissades en partie", target = 15, coins = 45, xp = 50 },
	{ id = "climb", n = "Escalade {t} rebords en partie", target = 10, coins = 45, xp = 50 },
	{ id = "hs_sniper", n = "Fais {t} headshots au fusil de précision", target = 3, coins = 80, xp = 80 },
	{ id = "hs_pistol", n = "Fais {t} headshots au pistolet", target = 4, coins = 70, xp = 70 },
	{ id = "hs_rifle", n = "Fais {t} headshots au fusil d'assaut", target = 6, coins = 70, xp = 70 },
	{ id = "site_a", n = "Pose la bombe {t} fois sur le site A", target = 1, coins = 60, xp = 60 },
	{ id = "site_b", n = "Pose la bombe {t} fois sur le site B", target = 1, coins = 60, xp = 60 },
	{ id = "w_tdm", n = "Gagne {t} Match à mort par équipe", target = 1, coins = 70, xp = 80 },
	{ id = "w_ffa", n = "Gagne {t} Match à mort", target = 1, coins = 90, xp = 90 },
	{ id = "w_koth", n = "Gagne {t} Capture de zone", target = 1, coins = 80, xp = 90 },
	{ id = "w_ctf", n = "Gagne {t} Capture du drapeau", target = 1, coins = 80, xp = 90 },
	{ id = "w_kc", n = "Gagne {t} Élimination confirmée", target = 1, coins = 80, xp = 90 },
	{ id = "w_bomb", n = "Gagne {t} partie de Compétitif", target = 1, coins = 90, xp = 100 },
}
-- défi d'arme du jour (3e défi) : « Élimine N adversaires avec : AK-47 », parmi les armes que le joueur possède
-- (CareerService envoie « kw_<arme> » à chaque élimination). Objectif selon le type d'arme.
local WEAPON_TARGET: { [string]: number } = { pistol = 5, smg = 8, shotgun = 5, rifle = 8, sniper = 4, lmg = 8 }
local WEAPON_POOL: { any } = {}
for key, w in pairs(Config.WEAPONS) do
	if not w.melee and WEAPON_TARGET[w.cat] then
		table.insert(WEAPON_POOL, { id = "kw_" .. key, weapon = key, n = "Élimine {t} adversaires avec : " .. w.name, target = WEAPON_TARGET[w.cat], coins = 70, xp = 70 })
	end
end
table.sort(WEAPON_POOL, function(a, b) return a.id < b.id end)
-- « Changer » un défi du jour : 1 changement gratuit par jour, ensuite REROLL.cost pièces, REROLL.max par jour au plus
RewardService.REROLL = { free = 1, cost = 60, max = 5 }
-- défis de la semaine (src/8O_defis.js WPOOL) : 3 par semaine (lundi), plus longs et mieux payés
local WEEKLY_POOL = {
	{ id = "kills", n = "Élimine {t} adversaires", target = 150, coins = 800, xp = 300 },
	{ id = "hs", n = "Fais {t} headshots", target = 40, coins = 700, xp = 280 },
	{ id = "win", n = "Gagne {t} parties", target = 8, coins = 900, xp = 350 },
	{ id = "matches", n = "Joue {t} parties", target = 15, coins = 700, xp = 250 },
	{ id = "k_sniper", n = "Élimine {t} adversaires au fusil de précision", target = 25, coins = 800, xp = 300 },
	{ id = "k_shotgun", n = "Élimine {t} adversaires au fusil à pompe", target = 30, coins = 800, xp = 300 },
	{ id = "knife", n = "Élimine {t} adversaires au couteau", target = 5, coins = 900, xp = 350 },
	{ id = "w_duel", n = "Gagne {t} Duels", target = 3, coins = 800, xp = 300 },
	{ id = "w_dom", n = "Gagne {t} parties de Domination", target = 3, coins = 800, xp = 300 },
	{ id = "z_wave", n = "Survis à {t} manches de Zombies", target = 20, coins = 900, xp = 350 },
	{ id = "dmg", n = "Inflige {t} dégâts", target = 15000, coins = 700, xp = 280 },
	{ id = "inf_surv", n = "Termine {t} parties d'Infecté sans être infecté", target = 3, coins = 900, xp = 350 },
	-- port Roblox : médailles et mouvements
	{ id = "md_assist", n = "Fais {t} assistances", target = 25, coins = 600, xp = 250 },
	{ id = "md_double", n = "Fais {t} doubles éliminations", target = 12, coins = 650, xp = 260 },
	{ id = "md_slide", n = "Élimine {t} adversaires en glissade", target = 12, coins = 650, xp = 260 },
	{ id = "climb", n = "Escalade {t} rebords en partie", target = 60, coins = 500, xp = 220 },
}
local function poolDef(pool: { any }, id: string): any
	for _, m in ipairs(pool) do if m.id == id then return m end end
	return nil
end
local function missionText(d: any): string
	return (string.gsub(d.n, "{t}", tostring(d.target)))
end
-- définition d'un défi du jour (pool général ou défi d'arme)
local function dailyDef(id: string): any
	return poolDef(MISSION_POOL, id) or poolDef(WEAPON_POOL, id)
end
-- armes possédées (défi d'arme) ; repli sur toute la liste si l'inventaire est vide
local function weaponChoices(profile: any): { any }
	local out = {}
	for _, d in ipairs(WEAPON_POOL) do
		if Catalog.STARTER_WEAPONS[d.weapon] == true or Catalog.ownsWeapon(profile, d.weapon) then table.insert(out, d) end
	end
	return if #out > 0 then out else WEAPON_POOL
end
local function newMission(d: any, weapon: boolean?): any
	return { id = d.id, target = d.target, coins = d.coins, xp = d.xp, progress = 0, done = false, claimed = false, w = if weapon then true else nil }
end

-- défi terminé : petit message au joueur (uiMissionDone / uiToast du web)
local doneEvent = Instance.new("RemoteEvent"); doneEvent.Name = "ChallengeDone"; doneEvent.Parent = ReplicatedStorage
-- défis terminés depuis la dernière fin de partie : listés sur l'écran de fin (RecapService les relève)
local doneLog: { [Player]: { any } } = {}
local function logDone(player: Player, d: any)
	local l = doneLog[player] or {}
	if #l < 12 then table.insert(l, d) end
	doneLog[player] = l
end
function RewardService.takeDone(player: Player): { any }
	local l = doneLog[player] or {}
	doneLog[player] = nil
	return l
end
game:GetService("Players").PlayerRemoving:Connect(function(p) doneLog[p] = nil end)

local function ensureMissions(profile: any)
	local t = today()
	if profile.missions.day ~= t then
		profile.missions.day = t
		local pool = table.clone(MISSION_POOL)
		local list = {}
		for _ = 1, 2 do
			local i = math.random(#pool)
			local m = table.remove(pool, i) :: any
			table.insert(list, newMission(m))
		end
		local wp = weaponChoices(profile)
		table.insert(list, newMission(wp[math.random(#wp)], true))   -- défi d'arme du jour
		profile.missions.list = list
	end
end
RewardService.ensureMissions = ensureMissions

-- semaine commençant le lundi (weekKey du web)
local function weekKey(): string
	return "w" .. math.floor((os.time() / 86400 + 3) / 7)
end
function RewardService.weekSecondsLeft(): number
	local w = math.floor((os.time() / 86400 + 3) / 7)
	return math.max(0, math.floor(((w + 1) * 7 - 3) * 86400 - os.time()))
end
local function ensureWeekly(profile: any)
	local k = weekKey()
	if not profile.wmis or profile.wmis.wk ~= k then
		local pool = table.clone(WEEKLY_POOL)
		local list = {}
		for _ = 1, 3 do
			local m = table.remove(pool, math.random(#pool)) :: any
			table.insert(list, { id = m.id, target = m.target, coins = m.coins, xp = m.xp, progress = 0, done = false, claimed = false })
		end
		profile.wmis = { wk = k, list = list }
	end
end
RewardService.ensureWeekly = ensureWeekly

function RewardService.missionEvent(player: Player, id: string, n: number?)
	local profile = DataService.get(player)
	if not profile then return end
	ensureMissions(profile)
	ensureWeekly(profile)
	for _, m in ipairs(profile.missions.list) do
		if m.id == id and not m.done then
			m.progress = math.min(m.target, m.progress + (n or 1))
			if m.progress >= m.target then
				m.done = true
				local d = dailyDef(m.id)
				if d then
					local info = { weekly = false, text = missionText(d), coins = m.coins, xp = m.xp }
					doneEvent:FireClient(player, info); logDone(player, info)
				end
			end
		end
	end
	for _, m in ipairs(profile.wmis.list) do
		if m.id == id and not m.done then
			m.progress = math.min(m.target, m.progress + (n or 1))
			if m.progress >= m.target then
				m.done = true
				local d = poolDef(WEEKLY_POOL, m.id)
				if d then
					local info = { weekly = true, text = missionText(d), coins = m.coins, xp = m.xp }
					doneEvent:FireClient(player, info); logDone(player, info)
				end
			end
		end
	end
end

function RewardService.claimMission(player: Player, index: number): any
	local profile = DataService.get(player)
	if not profile then return nil end
	local m = profile.missions.list[index]
	if not m or not m.done or m.claimed then return nil end
	m.claimed = true
	profile.coins += m.coins
	return RewardService.addXP(player, m.xp)
end
function RewardService.claimWeekly(player: Player, index: number): any
	local profile = DataService.get(player)
	if not profile then return nil end
	ensureWeekly(profile)
	local m = profile.wmis.list[index]
	if not m or not m.done or m.claimed then return nil end
	m.claimed = true
	profile.coins += m.coins
	return RewardService.addXP(player, m.xp)
end
-- défis du jour et de la semaine avec leurs textes, pour le menu (Progression)
function RewardService.challenges(player: Player): any
	local profile = DataService.get(player)
	if not profile then return nil end
	ensureMissions(profile)
	ensureWeekly(profile)
	local function view(list: { any }, weekly: boolean): { any }
		local out = {}
		for i, m in ipairs(list) do
			local d = if weekly then poolDef(WEEKLY_POOL, m.id) else dailyDef(m.id)
			table.insert(out, { index = i, id = m.id, text = if d then missionText(d) else m.id, progress = m.progress, target = m.target,
				coins = m.coins, xp = m.xp, done = m.done, claimed = m.claimed, weapon = m.w == true })
		end
		return out
	end
	return { daily = view(profile.missions.list, false), dailyLeft = 86400 - os.time() % 86400,
		weekly = view(profile.wmis.list, true), weeklyLeft = RewardService.weekSecondsLeft(), reroll = RewardService.rerollInfo(profile) }
end

-- ---------- défis renouvelables (« Changer ») ----------
local function rerollState(profile: any): any
	local rr = profile.missions.rr
	if typeof(rr) ~= "table" or rr.day ~= today() then rr = { day = today(), n = 0 }; profile.missions.rr = rr end
	return rr
end
-- prix du prochain changement (0 = gratuit) et changements restants aujourd'hui
function RewardService.rerollInfo(profile: any): any
	local rr = rerollState(profile)
	local R = RewardService.REROLL
	return { cost = if rr.n < R.free then 0 else R.cost, left = math.max(0, R.max - rr.n), freeLeft = math.max(0, R.free - rr.n) }
end
-- remplace le défi du jour n° index par un autre, tiré au hasard (jamais un défi déjà présent ; défi d'arme -> autre arme)
function RewardService.rerollMission(player: Player, index: number): any
	local profile = DataService.get(player)
	if not profile then return { ok = false, err = "Profil pas encore chargé" } end
	ensureMissions(profile)
	local list = profile.missions.list
	local m = list[index]
	if not m then return { ok = false, err = "Défi introuvable" } end
	if m.done or m.claimed then return { ok = false, err = "Ce défi est déjà terminé" } end
	local rr = rerollState(profile)
	local R = RewardService.REROLL
	if rr.n >= R.max then return { ok = false, err = "Plus de changement possible aujourd'hui" } end
	local cost = if rr.n < R.free then 0 else R.cost
	if profile.coins < cost then return { ok = false, err = "Il faut " .. cost .. " pièces pour changer ce défi" } end
	local cand = {}
	for _, d in ipairs(if m.w then weaponChoices(profile) else MISSION_POOL) do
		local used = false
		for _, o in ipairs(list) do if o.id == d.id then used = true; break end end
		if not used then table.insert(cand, d) end
	end
	if #cand == 0 then return { ok = false, err = "Aucun autre défi disponible" } end
	local d = cand[math.random(#cand)]
	profile.coins -= cost
	rr.n += 1
	list[index] = newMission(d, m.w == true)
	if cost > 0 then task.spawn(DataService.save, player) end   -- pièces dépensées : sauvegarde tout de suite
	return { ok = true, cost = cost, coins = profile.coins, index = index, text = missionText(d), reroll = RewardService.rerollInfo(profile) }
end
local rerollRemote = Instance.new("RemoteFunction"); rerollRemote.Name = "RerollChallenge"; rerollRemote.Parent = ReplicatedStorage
rerollRemote.OnServerInvoke = function(player: Player, index: any)
	if typeof(index) ~= "number" or index ~= math.floor(index) or index < 1 or index > 6 then return { ok = false, err = "Défi introuvable" } end
	if not RateLimit.ok(player, "RerollChallenge", 1) then return { ok = false, err = "Doucement !" } end
	return RewardService.rerollMission(player, index)
end

-- ---------- fin de partie ----------
function RewardService.finishMatch(player: Player, summary: any)
	-- summary = { kills, deaths, hs, dmg, shots, hits, plants, defuses, won, seconds, mode, map, weaponKills = {} }
	local profile = DataService.get(player)
	if not profile then return end
	local s = profile.stats
	s.matches += 1; if summary.won then s.wins += 1 end
	s.kills += summary.kills; s.deaths += summary.deaths; s.hs += summary.hs; s.dmg += summary.dmg
	s.shots += summary.shots; s.hits += summary.hits; s.seconds += summary.seconds
	s.bestStreak = math.max(s.bestStreak, summary.bestStreak or 0)
	local bm = s.byMode[summary.mode] or { m = 0, w = 0 }; bm.m += 1; if summary.won then bm.w += 1 end; s.byMode[summary.mode] = bm
	local bp = s.byMap[summary.map] or { m = 0, w = 0 }; bp.m += 1; if summary.won then bp.w += 1 end; s.byMap[summary.map] = bp
	for k, v in pairs(summary.weaponKills or {}) do s.byWeapon[k] = (s.byWeapon[k] or 0) + v end
	LeaderboardService.addKills(player, summary.kills)    -- classement géant de la semaine (lobby)
	table.insert(profile.history, 1, { t = os.time(), mode = summary.mode, map = summary.map, won = summary.won, k = summary.kills, d = summary.deaths })
	while #profile.history > 25 do table.remove(profile.history) end
	-- détail des gains, ligne par ligne (écran de fin de partie)
	local lines = {}
	local function line(t: string, x: number)
		if x > 0 then table.insert(lines, { t = t, xp = x }) end
	end
	local obj = summary.plants + summary.defuses
	line("Participation", 40)
	line("Éliminations ×" .. summary.kills, summary.kills * 10)
	line("Tirs à la tête ×" .. summary.hs, summary.hs * 5)
	if summary.won then line("Victoire", 120) end
	line("Objectifs ×" .. obj, obj * 25)
	local xp = 40 + summary.kills * 10 + summary.hs * 5 + (summary.won and 120 or 0) + obj * 25
	local base = xp
	if summary.mode == Modes.featured() then xp *= 2; line("Mode de la semaine ×2", base) end   -- mode de la semaine : XP ×2 (affiché sur l'accueil du menu)
	-- pièces tirées de l'XP de base (web : coinsGain = xp × 0,15 avant le ×2 du mode de la semaine, qui ne double que l'XP)
	local coins = math.floor(base * 0.15)   -- ~35 pièces par partie : progression lente, comme sur le web
	-- XP ×2 du week-end et du passe XP ×2 : chacun ajoute l'XP de base de la partie (pas de pièces en plus)
	local weekend = RewardService.weekend()
	if weekend then xp += base; line("Week-end XP ×2", base) end
	if player:GetAttribute("PassXp2") == true then xp += base; line("Passe XP ×2", base) end
	local bonusXp, bonusCoins, bonusLines, firstWin = LoyaltyService.matchBonus(player, xp, coins, summary.won)   -- fidélité, Premium, boost, 1re victoire
	local matchCoins = coins
	xp += bonusXp; coins += bonusCoins
	profile.coins += coins
	RewardService.missionEvent(player, "matches")
	if summary.won then RewardService.missionEvent(player, "win") end
	RewardService.missionEvent(player, "dmg", summary.dmg)
	local xpStart = profile.xp
	local ups = RewardService.addXP(player, xp)
	return { xp = xp, coins = coins, levelUps = ups, bonus = bonusLines, lines = lines, matchCoins = matchCoins,
		xpStart = xpStart, weekend = weekend, firstWin = firstWin == true }
end

return RewardService
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="467">
      <Properties>
        <string name="Name">ShopService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ShopService (Script)
-- Boutique : achats en pièces (armes, skins, viseurs, tenues), offres du jour, équipement, produits Robux et exclusifs payants.
-- Le catalogue est dans ReplicatedStorage/Shared/ShopCatalog. Le serveur revérifie TOUT (prix, possession, pièces) : ne jamais croire le client.
-- C'est le SEUL ProcessReceipt du jeu (Roblox n'en accepte qu'un) : pièces, caisses, passe de combat, abonnement Premium et
-- pack de départ passent tous par ici. Les passes de jeu (XP ×2) sont vérifiés à l'arrivée (UserOwnsGamePassAsync).
-- Un produit dont le numéro vaut 0 dans ProductIds n'est jamais proposé : le serveur répond « Bientôt disponible ».
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Players = game:GetService("Players")

local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local DataService = require(script.Parent.DataService)
local ProgressService = require(script.Parent.ProgressService)
local LoyaltyService = require(script.Parent.LoyaltyService)
local LoyaltyConfig = require(ReplicatedStorage.Shared.LoyaltyConfig)
local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
local RateLimit = require(script.Parent.RateLimit)
local SOON = "Bientôt disponible"

-- anciens reçus (avant que les achats soient notés dans le profil) : relus seulement, pour ne jamais créditer deux fois
local receipts = require(script.Parent.Stores).get("StrikeArenaReceipts_v1")

local function remoteFunction(name: string): RemoteFunction
	local r = Instance.new("RemoteFunction"); r.Name = name; r.Parent = ReplicatedStorage; return r
end

-- ---------- Robux (Developer Products) ----------
local byProduct: { [number]: any } = {}
for _, it in ipairs(Catalog.ITEMS) do
	if (it.kind == "devproduct" or it.kind == "exclusive" or it.kind == "vip" or (it.kind == "killfx" and it.source == "robux")) and it.productId > 0 then
		byProduct[it.productId] = it
	end
end

-- Anti-doublon : le numéro de l'achat est noté DANS le profil, en même temps que ce qu'il donne, et Roblox n'apprend
-- que l'achat est crédité qu'une fois ce profil réellement enregistré (sinon il redemande plus tard, sans recréditer).
local function credit(player: Player, profile: any, it: any)
	if it.coins then profile.coins += it.coins end
	if it.box then profile.boxes[it.box] = (profile.boxes[it.box] or 0) + (it.boxes or 1) end
	if it.premium then ProgressService.grantPremium(player) end
	if it.kind == "vip" then LoyaltyService.grantVip(player, it.days) end   -- abonnement Premium : jours ajoutés + caisse offerte
	if it.once then                                                           -- pack de départ : boosts, titre, marqué comme acheté
		profile.purchases = profile.purchases or {}
		profile.purchases[it.id] = true
		LoyaltyService.give(profile, { boost = it.boost, title = it.title })
		LoyaltyService.publish(player, profile)
	end
	if it.kind == "exclusive" then                                            -- camos animés : ajoutés pour toujours
		profile.inv.exclusive = profile.inv.exclusive or {}
		for _, c in ipairs(it.camos) do
			if not table.find(profile.inv.exclusive, c) then table.insert(profile.inv.exclusive, c) end
		end
	end
	if it.kind == "killfx" then                                               -- effet d'élimination exclusif : pour toujours
		profile.inv.killfx = profile.inv.killfx or {}
		if not table.find(profile.inv.killfx, it.fx) then table.insert(profile.inv.killfx, it.fx) end
	end
end

local busyReceipt: { [string]: boolean } = {}   -- même achat présenté deux fois en même temps : un seul crédit
MarketplaceService.ProcessReceipt = function(info)
	local player = Players:GetPlayerByUserId(info.PlayerId)
	if not player then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local it = byProduct[info.ProductId]
	local profile = DataService.get(player)
	-- profil absent ou en lecture seule (chargement raté) : rien ne pourrait être enregistré, Roblox réessaiera
	if not it or not profile or not DataService.canSave(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
	local id = tostring(info.PurchaseId)
	if busyReceipt[id] then return Enum.ProductPurchaseDecision.NotProcessedYet end
	busyReceipt[id] = true
	local ok, res = pcall(function()
		profile.receipts = if typeof(profile.receipts) == "table" then profile.receipts else {}
		if not profile.receipts[id] then
			local old = false
			local okOld = pcall(function() old = receipts:GetAsync(info.PlayerId .. "_" .. info.PurchaseId) == true end)
			if not okOld then return Enum.ProductPurchaseDecision.NotProcessedYet end
			if old then return Enum.ProductPurchaseDecision.PurchaseGranted end   -- déjà crédité avant (ancien registre)
			credit(player, profile, it)
			profile.receipts[id] = os.time()
			-- on ne garde que les reçus récents (Roblox ne redemande pas un achat vieux de plus de quelques jours)
			local n = 0
			for _ in pairs(profile.receipts) do n += 1 end
			if n > 40 then
				for k, t in pairs(profile.receipts) do
					if typeof(t) ~= "number" or os.time() - t > 14 * 86400 then profile.receipts[k] = nil end
				end
			end
		end
		if not DataService.save(player) then return Enum.ProductPurchaseDecision.NotProcessedYet end
		return Enum.ProductPurchaseDecision.PurchaseGranted
	end)
	busyReceipt[id] = nil
	if not ok then warn("[ShopService] achat non traité :", res); return Enum.ProductPurchaseDecision.NotProcessedYet end
	return res
end

-- ---------- Ajout à l'inventaire ----------
local function grant(profile: any, it: any)
	local inv = profile.inv
	local function push(list: string, value: any)
		inv[list] = inv[list] or {}
		table.insert(inv[list], value)
	end
	if it.kind == "weapon" then push("weapons", it.weapon)
	elseif it.kind == "skin" then
		inv.skins[it.weapon] = inv.skins[it.weapon] or {}
		table.insert(inv.skins[it.weapon], it.skin)
	elseif it.kind == "outfit" then push("outfits", it.outfit)
	elseif it.kind == "sight" then push("sights", it.sight)
	elseif it.kind == "reticle" then push("reticles", it.reticle)
	elseif it.kind == "killfx" then push("killfx", it.fx)
	else push("misc", it.id) end
end

-- ---------- Remotes ----------
-- État de la boutique pour l'interface : pièces, offres du jour (avec prix réduit), objets possédés et équipés
local getShop = remoteFunction("GetShop")
getShop.OnServerInvoke = function(player: Player)
	local profile = DataService.get(player)
	if not profile then return nil end
	local day = Catalog.today()
	local owned = {}
	for _, it in ipairs(Catalog.ITEMS) do
		if Catalog.owns(profile, it) then owned[it.id] = true end
	end
	local offers = {}
	for i, id in ipairs(Catalog.dailyOffers(day)) do
		local it = Catalog.get(id)
		table.insert(offers, { id = id, price = Catalog.priceFor(it, day), was = it.price, off = math.floor(Catalog.discountFor(it, day) * 100 + 0.5), featured = i == 5 })
	end
	-- produits Robux disponibles (numéro renseigné dans ProductIds) et passes possédés
	local live, passes = {}, {}
	for _, it in ipairs(Catalog.ITEMS) do
		if (it.productId or 0) > 0 or (it.passId or 0) > 0 then live[it.id] = true end
		if it.kind == "gamepass" then passes[it.id] = player:GetAttribute(it.attr) == true end
	end
	return { coins = profile.coins, owned = owned, offers = offers, equipped = profile.equipped, equippedSkins = profile.equippedSkins or {},
		secondsToReset = 86400 - os.time() % 86400, live = live, passes = passes, boxes = profile.boxes }
end

local buy = remoteFunction("ShopBuy")
buy.OnServerInvoke = function(player: Player, id: any)
	if typeof(id) ~= "string" then return { ok = false, err = "Objet inconnu" } end
	if not RateLimit.ok(player, "ShopBuy", 0.4) then return { ok = false, err = "Doucement : un achat à la fois" } end
	local profile = DataService.get(player)
	if not profile then return { ok = false, err = "Profil pas encore chargé" } end
	local it = Catalog.get(id)
	if not it then return { ok = false, err = "Objet inconnu" } end

	-- objets d'événement (skins, tenues et effets d'Halloween) : seulement avec les paliers de citrouilles
	if it.event then return { ok = false, err = if Catalog.owns(profile, it) then "Déjà possédé" else "Récompense de l'événement d'Halloween (citrouilles)" } end

	-- passe de jeu (Game Pass) : Roblox affiche sa fenêtre, PromptGamePassPurchaseFinished pose l'attribut
	if it.kind == "gamepass" then
		if player:GetAttribute(it.attr) == true then return { ok = false, err = "Déjà possédé" } end
		if (it.passId or 0) <= 0 then return { ok = false, err = SOON } end
		MarketplaceService:PromptGamePassPurchase(player, it.passId)
		return { ok = true, pending = true }
	end

	if it.kind == "devproduct" or it.kind == "exclusive" or it.kind == "vip" then
		if (it.kind == "exclusive" or it.once) and Catalog.owns(profile, it) then return { ok = false, err = "Déjà possédé" } end
		if it.productId <= 0 then return { ok = false, err = SOON } end
		MarketplaceService:PromptProductPurchase(player, it.productId)   -- le crédit se fait dans ProcessReceipt
		return { ok = true, pending = true }
	end

	if it.kind == "killfx" and it.source ~= "coins" then
		if Catalog.owns(profile, it) then return { ok = false, err = "Déjà possédé" } end
		if it.source == "code" then return { ok = false, err = "S'obtient avec un code promo" } end
		if it.source == "group" then return { ok = false, err = "S'obtient en rejoignant le groupe Roblox" } end
		if it.productId <= 0 then return { ok = false, err = SOON } end
		MarketplaceService:PromptProductPurchase(player, it.productId)
		return { ok = true, pending = true }
	end

	if (it.price or 0) <= 0 then return { ok = false, err = "Objet inconnu" } end
	if Catalog.owns(profile, it) then return { ok = false, err = "Déjà possédé" } end
	local price = Catalog.priceFor(it, Catalog.today())
	if profile.coins < price then return { ok = false, err = "Pièces insuffisantes" } end
	profile.coins -= price
	grant(profile, it)
	task.spawn(DataService.save, player)      -- sauvegarde tout de suite : un achat ne doit jamais se perdre
	return { ok = true, coins = profile.coins }
end

-- Pour le futur menu d'achat en partie : Catalog.ownsWeapon(profile, key) dit si une arme est débloquée.

-- Équiper : tenue, réticule, traînée, ou viseur d'une arme (les skins utilisent le remote EquipSkin de Main)
local equip = remoteFunction("ShopEquip")
equip.OnServerInvoke = function(player: Player, id: any, weapon: any)
	if typeof(id) ~= "string" then return false end
	local profile = DataService.get(player)
	local it = Catalog.get(id)
	if not profile or not it or not Catalog.owns(profile, it) then return false end
	local eq = profile.equipped
	if it.kind == "outfit" then eq.outfit = it.outfit
	elseif it.kind == "reticle" then eq.reticle = it.reticle
	elseif it.kind == "trail" then
		eq.trail = it.trail
		ProgressService.ensure(profile)
		profile.cosmetics.trail = it.trail
		DataService.syncSkins(player)                 -- attribut Trail (couleur des balles traçantes)
	elseif it.kind == "sight" then
		if typeof(weapon) ~= "string" or not Config.WEAPONS[weapon] or Config.WEAPONS[weapon].melee then return false end
		eq.sights[weapon] = it.sight
	elseif it.kind == "exclusive" and it.camo then   -- un camo animé se pose arme par arme (le lot se possède, il ne s'équipe pas)
		if typeof(weapon) ~= "string" or not Config.WEAPONS[weapon] or Config.WEAPONS[weapon].melee then return false end
		eq.animCamo = eq.animCamo or {}
		eq.animCamo[weapon] = it.camo
		DataService.syncSkins(player)
	elseif it.kind == "killfx" then
		eq.killFx = it.fx
	else
		return false
	end
	return true
end

-- ---------- passes de jeu : possession vérifiée par Roblox à l'arrivée et après un achat ----------
local function checkPasses(player: Player)
	for _, it in ipairs(Catalog.ITEMS) do
		if it.kind == "gamepass" and (it.passId or 0) > 0 then
			local ok, owns = pcall(function() return MarketplaceService:UserOwnsGamePassAsync(player.UserId, it.passId) end)
			if ok and owns then player:SetAttribute(it.attr, true) end
		end
	end
end
Players.PlayerAdded:Connect(checkPasses)
for _, p in ipairs(Players:GetPlayers()) do task.spawn(checkPasses, p) end
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(player: Player, passId: number, purchased: boolean)
	if not purchased then return end
	for _, it in ipairs(Catalog.ITEMS) do
		if it.kind == "gamepass" and it.passId == passId then player:SetAttribute(it.attr, true) end
	end
end)

-- Vérification au démarrage : un productId en double ferait créditer le mauvais produit
do
	local seen = {}
	for _, list in ipairs({ Catalog.ITEMS }) do for _, it in ipairs(list) do   -- numéros finaux (ProductIds compris)
		if (it.productId or 0) > 0 then
			if seen[it.productId] then warn("[ShopService] productId en double (ProductIds.lua) :", it.productId, it.id) end
			seen[it.productId] = true
		end
	end end
end
]]></string>
      </Properties>
    </Item>
    <Item class="Script" referent="468">
      <Properties>
        <string name="Name">SoldierService</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/SoldierService (Script)
-- Côté serveur des soldats du jeu web (l'habillage et l'animation sont faits par chaque client, SoldierController) :
--   attributs répliqués : Outfit (joueur, tenue équipée du profil), Anim (personnage : glissade, sprint, accroupi…
--     envoyés par son client), ReloadT (début de recharge), Dance / DanceT (danse procédurale du web) ;
--   ragdoll à la mort (src/8Zb_ragdoll.js) pour les joueurs et les bots : les Motor6D sont remplacés par des
--     BallSocketConstraint placées aux articulations du soldat, et le corps part dans le sens du tir qui tue
--     (plus fort au fusil à pompe et au sniper, sur la tête pour un tir à la tête).
-- La réapparition (TDMService : LoadCharacter, BotService.remove) ne change pas : le corps disparaît avec le personnage.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PhysicsService = game:GetService("PhysicsService")

local Config = require(ReplicatedStorage.Shared.Config)
local Look = require(ReplicatedStorage.Shared.SoldierLook)
local WeaponService = require(script.Parent.WeaponService)
local DataService = require(script.Parent.DataService)

local K = Look.K
local IMP = 6            -- studs/s par m/s d'élan du web (le monde Roblox tombe plus vite : élan renforcé)

-- ---------- remotes ----------
local animRemote = Instance.new("UnreliableRemoteEvent"); animRemote.Name = "SoldierAnim"; animRemote.Parent = ReplicatedStorage
local danceRemote = Instance.new("RemoteEvent"); danceRemote.Name = "SoldierDance"; danceRemote.Parent = ReplicatedStorage

animRemote.OnServerEvent:Connect(function(p: Player, bits: any)
	local c = p.Character
	if c and typeof(bits) == "number" and bits >= 0 and bits < 256 and bits % 1 == 0 then c:SetAttribute("Anim", bits) end
end)

danceRemote.OnServerEvent:Connect(function(p: Player, on: any)
	local c = p.Character
	if not c then return end
	local prof = DataService.get(p) :: any
	local id = prof and prof.equippedDance
	if on == true and typeof(id) == "string" and Config.DANCES[id] then
		c:SetAttribute("Dance", id); c:SetAttribute("DanceT", workspace:GetServerTimeNow())
	else
		c:SetAttribute("Dance", nil)
	end
end)

-- ---------- tenue équipée et recharge ----------
local function soldiers(): { [Model]: any }
	local out: { [Model]: any } = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then out[p.Character] = p end end
	local bots = workspace:FindFirstChild("Bots")
	if bots then for _, m in ipairs(bots:GetChildren()) do if m:IsA("Model") then out[m] = m end end end
	return out
end

task.spawn(function()
	local n = 0
	while true do
		task.wait(0.1)
		n += 1
		if n % 15 == 0 then
			for _, p in ipairs(Players:GetPlayers()) do
				local prof = DataService.get(p) :: any
				local o = prof and prof.equipped and prof.equipped.outfit
				if typeof(o) == "number" and p:GetAttribute("Outfit") ~= o then p:SetAttribute("Outfit", o) end
			end
		end
		for char, c in pairs(soldiers()) do
			local ok, _, _, _, reloading = pcall(WeaponService.current, c)
			if ok then
				local cur = char:GetAttribute("ReloadT")
				if reloading and cur == nil then char:SetAttribute("ReloadT", workspace:GetServerTimeNow())
				elseif not reloading and cur ~= nil then char:SetAttribute("ReloadT", nil) end
			end
		end
	end
end)

-- ---------- ragdoll ----------
pcall(function()
	PhysicsService:RegisterCollisionGroup("Ragdoll")
	PhysicsService:CollisionGroupSetCollidable("Ragdoll", "Ragdoll", false)   -- les membres d'un corps ne se bloquent pas entre eux
end)

-- angle du cône et torsion de chaque articulation (degrés)
local LIMITS: { [string]: { number } } = {
	UpperTorso = { 30, 20 }, Head = { 45, 40 },
	LeftUpperArm = { 110, 60 }, RightUpperArm = { 110, 60 }, LeftLowerArm = { 110, 10 }, RightLowerArm = { 110, 10 },
	LeftHand = { 50, 20 }, RightHand = { 50, 20 },
	LeftUpperLeg = { 80, 20 }, RightUpperLeg = { 80, 20 }, LeftLowerLeg = { 100, 5 }, RightLowerLeg = { 100, 5 },
	LeftFoot = { 35, 10 }, RightFoot = { 35, 10 },
}
-- part de l'élan reçue par chaque membre (poids W du web : corps / tir à la tête)
local WEIGHT: { [string]: { number } } = {
	LowerTorso = { 0.9, 0.6 }, UpperTorso = { 1, 0.9 }, Head = { 0.8, 1.3 },
	UpperLeg = { 0.5, 0.4 }, LowerLeg = { 0.3, 0.2 }, Foot = { 0.15, 0.1 },
	UpperArm = { 0.8, 0.8 }, LowerArm = { 0.6, 0.6 }, Hand = { 0.5, 0.5 },
}

type Impulse = { dir: Vector3, f: number, hs: boolean }
local pending: { [Model]: Impulse } = {}
local done: { [Model]: boolean } = {}

local function push(char: Model, imp: Impulse)
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local base = if hrp then hrp.AssemblyLinearVelocity else Vector3.zero
	local fwd = if hrp then hrp.CFrame.LookVector else Vector3.zero
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") and p ~= hrp then
			local key = string.gsub(string.gsub(p.Name, "^Left", ""), "^Right", "")
			local w = WEIGHT[key]
			if w then
				local k = (if imp.hs then w[2] else w[1]) * imp.f * (0.85 + math.random() * 0.3)
				local up = if key == "LowerTorso" or key == "UpperTorso" then 0.6 else 0.2
				local v = base + imp.dir * (k * IMP) + Vector3.new(0, up * IMP, 0)
				if key == "LowerLeg" then v += fwd * (0.9 * IMP) end                -- les genoux lâchent vers l'avant
				p.AssemblyLinearVelocity = v
			end
		end
	end
end

local function ragdoll(char: Model)
	if done[char] then return end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hum or not hrp or not char:FindFirstChild("UpperTorso") then return end
	done[char] = true
	local look = Look.look(char)
	local rest = Look.rest(look.rig)
	local N, joints = Look.natural(char, hum, hrp)
	hum.RequiresNeck = false
	local held = char:FindFirstChild("HeldWeapon")
	for _, j in ipairs(joints) do
		local m, p0, p1 = j.m, j.p0, j.p1
		if m.Name ~= "Root" then
			-- articulation au point du soldat du web (repère naturel de la pièce parente), axe X le long du membre
			local piv = rest.pivot[p1.Name]
			local a0cf: CFrame
			if piv then
				local dir = rest.dir[p1.Name] or Vector3.new(0, -1, 0)
				local side = if math.abs(dir.Y) > 0.9 then Vector3.xAxis else Vector3.yAxis
				a0cf = N[p0]:Inverse() * CFrame.fromMatrix(piv * K, dir, side)
			else
				a0cf = Look.jointC0(m)
			end
			local a0 = Instance.new("Attachment"); a0.Name = "RagdollA0_" .. m.Name; a0.CFrame = a0cf; a0.Parent = p0
			local a1 = Instance.new("Attachment"); a1.Name = "RagdollA1_" .. m.Name
			a1.CFrame = p1.CFrame:ToObjectSpace(p0.CFrame * a0cf)   -- même point qu'à l'instant de la mort : pas de saut
			a1.Parent = p1
			local bs = Instance.new("BallSocketConstraint"); bs.Name = "Ragdoll_" .. m.Name
			bs.Attachment0 = a0; bs.Attachment1 = a1
			local lim = LIMITS[p1.Name]
			if lim then
				bs.LimitsEnabled = true; bs.UpperAngle = lim[1]
				bs.TwistLimitsEnabled = true; bs.TwistLowerAngle = -lim[2]; bs.TwistUpperAngle = lim[2]
			end
			-- un peu de frottement aux articulations (tonus qui s'éteint) : le corps s'affaisse au lieu de gigoter comme un
			-- pantin, sans se figer (≈ 5 % du couple de son propre poids)
			pcall(function() bs.MaxFrictionTorque = p1:GetMass() * workspace.Gravity * 0.05 end)
			bs.Parent = p1
			m:Destroy()
		end
	end
	for _, p in ipairs(char:GetDescendants()) do
		if p:IsA("BasePart") and not (held and p:IsDescendantOf(held)) and p ~= held then
			if p == hrp then p.CanCollide = false; p.Massless = true
			elseif p.Parent == char then p.CanCollide = true; p.CollisionGroup = "Ragdoll" end
		end
	end
	char:SetAttribute("Ragdoll", true)
	-- la physique du corps passe au serveur (même chute pour tout le monde)
	for _, p in ipairs(char:GetChildren()) do
		if p:IsA("BasePart") then pcall(function() p:SetNetworkOwner(nil) end) end
	end
	local imp = pending[char]
	if imp then pending[char] = nil; push(char, imp) end
end

local function setup(hum: Humanoid)
	local char = hum.Parent
	if not char or not char:IsA("Model") then return end
	hum.BreakJointsOnDeath = false
	hum.Died:Connect(function()
		task.defer(function() local ok, err = pcall(function() ragdoll(char :: Model); return true end); if not ok then warn("[SoldierService] ragdoll", err) end end)
	end)
	char.AncestryChanged:Connect(function()
		if not char:IsDescendantOf(workspace) then done[char :: Model] = nil; pending[char :: Model] = nil end
	end)
end
workspace.DescendantAdded:Connect(function(d) if d:IsA("Humanoid") then setup(d) end end)
for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("Humanoid") then setup(d) end end

-- élan du tir qui tue (direction : du tueur vers la victime ; sans tireur : en arrière)
WeaponService.Killed:Connect(function(attacker: any, victim: any, key: any, headshot: any)
	local vc = WeaponService.charOf(victim)
	if not vc then return end
	local vr = vc:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not vr then return end
	local ac = attacker and WeaponService.charOf(attacker)
	local ar = ac and ac ~= vc and ac:FindFirstChild("HumanoidRootPart") :: BasePart?
	local dir = if ar then Vector3.new(vr.Position.X - ar.Position.X, 0, vr.Position.Z - ar.Position.Z) else -vr.CFrame.LookVector
	dir = if dir.Magnitude > 1e-3 then dir.Unit else -vr.CFrame.LookVector
	local w = typeof(key) == "string" and Config.WEAPONS[key]
	local c = w and w.cat
	local f = if c == "shotgun" then 3.2 elseif c == "sniper" then 2.9 elseif w and w.melee then 1.1 elseif c == "pistol" then 1.3 else 1.7
	local imp: Impulse = { dir = dir, f = f, hs = headshot == true }
	if done[vc] then push(vc, imp) else pending[vc] = imp end
end)
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="469">
      <Properties>
        <string name="Name">SprayService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/SprayService (ModuleScript, requis par Main)
-- Sprays sur les murs (src/64_extras.js doSpray) : touche J (SprayController). Le serveur vérifie tout et pose le spray
-- pour tout le monde : mur à 4,5 m au plus devant la tête, pas au sol ni au plafond, 4 s entre deux sprays,
-- 12 sprays par joueur au plus (le plus ancien disparaît), pas pendant le temps d'achat du mode Bombe.
-- Remotes : Spray (RemoteEvent, client -> serveur : direction du regard), SetSpray (RemoteFunction : choisir son spray
-- parmi ConfigExtra.SPRAYS ; débloqués par niveau comme sur le web : 1, 1, 2, 2, 3, 3, 4, 4).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local DataService = require(script.Parent.DataService)
local RewardService = require(script.Parent.RewardService)
local ProgressService = require(script.Parent.ProgressService)
local MatchService = require(script.Parent.MatchService)

local SprayService = {}

local U = Config.STUDS_PER_METER
local RANGE = 4.5 * U
local SIZE = 1.1 * U
local COOLDOWN = 4
local MAX = 12

-- dessin de chaque spray (couleur du web, symbole)
SprayService.LOOK = {
	smile = { n = "Sourire", g = "☺", c = Color3.fromHex("#ffd23a") },
	heart = { n = "Cœur", g = "♥", c = Color3.fromHex("#ff4d6d") },
	skull = { n = "Crâne", g = "☠", c = Color3.fromHex("#f2f2f2") },
	bolt = { n = "Éclair", g = "⚡", c = Color3.fromHex("#fff04a") },
	flame = { n = "Flamme", g = "🔥", c = Color3.fromHex("#ff7a2a") },
	crown = { n = "Couronne", g = "♛", c = Color3.fromHex("#ffc933") },
	target = { n = "Cible", g = "◎", c = Color3.fromHex("#ff4655") },
	ghost = { n = "Fantôme", g = "👻", c = Color3.fromHex("#e8f1ff") },
}
function SprayService.levelOf(id: string): number
	local i = table.find(X.SPRAYS, id)
	return if i then 1 + (i - 1) // 2 else math.huge
end

local sprayEv = Instance.new("RemoteEvent"); sprayEv.Name = "Spray"; sprayEv.Parent = ReplicatedStorage
local setSpray = Instance.new("RemoteFunction"); setSpray.Name = "SetSpray"; setSpray.Parent = ReplicatedStorage
local toast = Instance.new("RemoteEvent"); toast.Name = "SprayToast"; toast.Parent = ReplicatedStorage

local last: { [Player]: number } = {}
local placed: { [Player]: { Instance } } = {}

local function chosen(p: Player): string
	local profile: any = DataService.get(p)
	if not profile then return "smile" end
	ProgressService.ensure(profile)
	local id = profile.cosmetics.spray
	if typeof(id) ~= "string" or not SprayService.LOOK[id] then return "smile" end
	if RewardService.levelInfo(profile) < SprayService.levelOf(id) then return "smile" end
	return id
end

setSpray.OnServerInvoke = function(p: Player, id: any): any
	if typeof(id) ~= "string" or not SprayService.LOOK[id] then return false end
	local profile: any = DataService.get(p)
	if not profile then return false end
	ProgressService.ensure(profile)
	if RewardService.levelInfo(profile) < SprayService.levelOf(id) then return false end
	profile.cosmetics.spray = id
	return true
end

local function build(id: string, pos: Vector3, normal: Vector3, parent: Instance): Part
	local look = SprayService.LOOK[id]
	local p = Instance.new("Part")
	p.Name = "Spray"; p.Size = Vector3.new(SIZE, SIZE, 0.05); p.Transparency = 1
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	local up = if math.abs(normal.Y) > 0.95 then Vector3.new(0, 0, 1) else Vector3.new(0, 1, 0)
	p.CFrame = CFrame.lookAt(pos + normal * 0.04, pos + normal * 2, up)
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(128, 128); sg.LightInfluence = 0.6
	sg.SizingMode = Enum.SurfaceGuiSizingMode.FixedSize; sg.Parent = p
	local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundTransparency = 1; t.Text = look.g; t.TextScaled = true
	t.Font = Enum.Font.GothamBlack; t.TextColor3 = look.c; t.TextTransparency = 0.08; t.Parent = sg
	p:SetAttribute("SprayId", id)
	p.Parent = parent
	return p
end

sprayEv.OnServerEvent:Connect(function(p: Player, dir: any)
	if typeof(dir) ~= "Vector3" or not (dir.Magnitude >= 0.5 and dir.Magnitude <= 1.5) then return end   -- refuse aussi NaN
	dir = dir.Unit
	local now = os.clock()
	if last[p] and now - last[p] < COOLDOWN then return end
	local ch = p.Character
	local head = ch and ch:FindFirstChild("Head") :: BasePart?
	local hum = ch and ch:FindFirstChildOfClass("Humanoid")
	if not head or not hum or hum.Health <= 0 then return end
	local m = MatchService.matchOf(p)
	if m and m.mode == "bomb" and m.data and m.data.phase == "freeze" then return end
	if math.abs(dir.Y) > 0.8 then toast:FireClient(p, "Vise un mur"); return end
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ex: { Instance } = { ch :: Model }
	local bots = workspace:FindFirstChild("Bots"); if bots then table.insert(ex, bots) end
	for _, q in ipairs(Players:GetPlayers()) do if q.Character then table.insert(ex, q.Character) end end
	params.FilterDescendantsInstances = ex
	local hit = workspace:Raycast(head.Position, dir * RANGE, params)
	if not hit or not hit.Instance:IsA("BasePart") or not hit.Instance.Anchored then toast:FireClient(p, "Trop loin d'une surface"); return end
	if math.abs(hit.Normal.Y) > 0.6 then toast:FireClient(p, "Vise un mur"); return end
	last[p] = now
	local parent: Instance = if m and m.map then m.map.folder else (workspace:FindFirstChild("Lobby") or workspace)
	local s = build(chosen(p), hit.Position, hit.Normal, parent)
	local list = placed[p] or {}; placed[p] = list
	table.insert(list, s)
	while #list > MAX do local old = table.remove(list, 1); if old then old:Destroy() end end
	sprayEv:FireAllClients(p, hit.Position)   -- son du spray chez tout le monde
end)

Players.PlayerRemoving:Connect(function(p: Player)
	last[p] = nil
	for _, s in ipairs(placed[p] or {}) do s:Destroy() end
	placed[p] = nil
end)

return SprayService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="470">
      <Properties>
        <string name="Name">Stores</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/Stores (ModuleScript)
-- Accès aux DataStore avec une solution de secours : tant que le jeu n'est pas publié (ou que
-- « Enable Studio Access to API Services » est coupé), Roblox refuse GetDataStore et tout le serveur
-- s'arrêterait. Dans ce cas on renvoie un magasin en mémoire : le jeu tourne, rien n'est sauvegardé.
local DataStoreService = game:GetService("DataStoreService")

local Stores = {}
Stores.offline = false

local warned = false
local function warnOnce(err: any)
	Stores.offline = true
	if warned then return end
	warned = true
	warn("[Stores] DataStore indisponible, sauvegarde coupée pour cette session :", err,
		"\n→ Publie le jeu puis active Game Settings > Security > Enable Studio Access to API Services.")
end

local function memoryStore(): any
	local data: { [string]: any } = {}
	local store = {}
	function store:GetAsync(key: string) return data[key] end
	function store:SetAsync(key: string, value: any) data[key] = value end
	function store:UpdateAsync(key: string, fn: (any) -> any)
		local v = fn(data[key]); if v ~= nil then data[key] = v end
		return data[key]
	end
	function store:IncrementAsync(key: string, n: number?)
		data[key] = (data[key] or 0) + (n or 1); return data[key]
	end
	function store:RemoveAsync(key: string) local v = data[key]; data[key] = nil; return v end
	function store:GetSortedAsync(ascending: boolean, pageSize: number)
		local list = {}
		for k, v in pairs(data) do if typeof(v) == "number" then table.insert(list, { key = k, value = v }) end end
		table.sort(list, function(a, b) if ascending then return a.value < b.value else return a.value > b.value end end)
		local page = {}
		for i = 1, math.min(pageSize, #list) do page[i] = list[i] end
		return {
			IsFinished = true,
			GetCurrentPage = function(_) return page end,
			AdvanceToNextPageAsync = function(_) end,
		}
	end
	return store
end

local function get(kind: string, name: string): any
	local ok, res = pcall(function()
		if kind == "ordered" then return DataStoreService:GetOrderedDataStore(name) end
		return DataStoreService:GetDataStore(name)
	end)
	if ok and res then return res end
	warnOnce(res)
	return memoryStore()
end

local cache: { [string]: any } = {}
local function cached(kind: string, name: string): any
	local k = kind .. ":" .. name
	if not cache[k] then cache[k] = get(kind, name) end
	return cache[k]
end

function Stores.get(name: string): DataStore return cached("normal", name) end
function Stores.ordered(name: string): OrderedDataStore return cached("ordered", name) end

return Stores
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="471">
      <Properties>
        <string name="Name">TeamCommsService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/TeamCommsService (ModuleScript, requis par Main)
-- Communication d'équipe tirée d'autres jeux (ping d'Apex / Valorant, radio de CS) :
--   • Ping (clic molette ou K) : marque un point pour toute l'équipe pendant quelques secondes (jamais un ennemi).
--     Remote « TeamPing » (joueur -> serveur : position, modèle visé ignoré) puis « TeamPingShow »
--     (serveur -> coéquipiers : position, genre "spot", nom de l'auteur, nil).
--   • Messages rapides (touche N puis 1 à 6) : « QuickChat » (joueur -> serveur : numéro) puis
--     « QuickChatShow » (serveur -> coéquipiers : nom, numéro). Les textes sont dans Shared/TeamComms.
-- Le serveur vérifie tout : joueur en vie dans une partie, cadence limitée, point pas trop loin.
-- En chacun pour soi, seul l'auteur voit son ping.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local TeamComms = require(ReplicatedStorage.Shared.TeamComms)
local WeaponService = require(script.Parent.WeaponService)
local MatchService = require(script.Parent.MatchService)

local function remote(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local pingIn, pingOut = remote("TeamPing"), remote("TeamPingShow")
local chatIn, chatOut = remote("QuickChat"), remote("QuickChatShow")

local MAX_DIST = 900          -- studs : au-delà, le point ne peut pas venir de la vue du joueur
local lastPing: { [Player]: number } = {}
local lastChat: { [Player]: number } = {}

local TeamCommsService = {}

-- coéquipiers de p dans sa partie (p compris) ; en chacun pour soi (« solo:… ») : p seul
local function mates(p: Player): { Player }
	local m = MatchService.matchOf(p)
	local team = WeaponService.teamOf(p)
	if not m or not team or string.sub(team, 1, 5) == "solo:" then return { p } end
	local list = {}
	for q in pairs(m.players) do
		if WeaponService.teamOf(q) == team then table.insert(list, q) end
	end
	return list
end

local function aliveRoot(p: Player): BasePart?
	local ch = MatchService.aliveChar(p)
	return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end

pingIn.OnServerEvent:Connect(function(p: Player, pos: any, target: any)
	if typeof(pos) ~= "Vector3" or pos ~= pos then return end           -- refuse NaN
	local now = os.clock()
	if now - (lastPing[p] or 0) < TeamComms.PING_COOLDOWN then return end
	local root = aliveRoot(p)
	if not root or (pos - root.Position).Magnitude > MAX_DIST then return end
	lastPing[p] = now
	-- seulement un lieu : Noa a refusé le marquage des ennemis sur le web (PR #8), on ne marque donc pas les adversaires
	local kind, model = "spot", nil
	local _ = target
	for _, q in ipairs(mates(p)) do pingOut:FireClient(q, pos, kind, p.DisplayName, model) end
end)

chatIn.OnServerEvent:Connect(function(p: Player, index: any)
	if typeof(index) ~= "number" or not TeamComms.LINES[index] then return end
	local now = os.clock()
	if now - (lastChat[p] or 0) < TeamComms.CHAT_COOLDOWN then return end
	if not MatchService.matchOf(p) then return end
	lastChat[p] = now
	for _, q in ipairs(mates(p)) do chatOut:FireClient(q, p.DisplayName, index) end
end)

Players.PlayerRemoving:Connect(function(p: Player) lastPing[p] = nil; lastChat[p] = nil end)

return TeamCommsService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="472">
      <Properties>
        <string name="Name">WeaponService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/WeaponService (ModuleScript, requis par Main)
-- Tir "hitscan" validé côté serveur : cadence, munitions, recharge, changement d'arme, couteau, équipes.
-- Dégâts : bouclier -> gilet -> santé. Le serveur est la seule référence : le client ne fait que demander.
--
-- Un « combattant » est soit un Player, soit le Model d'un bot (BotService). Les deux passent par les
-- mêmes fonctions, ce qui garantit que les dégâts sont identiques pour tout le monde.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local NetService = require(script.Parent.NetService)
local A = require(ReplicatedStorage.Shared.Attachments)       -- armurier (effets des accessoires)
require(script.Parent.ArmoryService)                           -- choix des accessoires / réticules (profil -> attributs Att_, Ret_)
local GrenadeService = require(script.Parent.GrenadeService)

local function remoteEvent(name: string): RemoteEvent
	local r = Instance.new("RemoteEvent"); r.Name = name; r.Parent = ReplicatedStorage; return r
end
local fireEvent = remoteEvent("FireWeapon")       -- client -> serveur : (origine, direction)
local switchEvent = remoteEvent("SwitchWeapon")   -- client -> serveur : (emplacement 1..3)
local reloadEvent = remoteEvent("ReloadWeapon")   -- client -> serveur : ()
local ammoFx = remoteEvent("AmmoState")           -- serveur -> client : état de l'arme tenue
local hitFx = remoteEvent("HitFeedback")          -- serveur -> tireur : (tête, élimination, dégâts, position)
local damagedFx = remoteEvent("Damaged")          -- serveur -> victime : (position du tireur, dégâts, tête)
local tracerFx = remoteEvent("Tracer")            -- serveur -> tous : (origine, impact, personnage du tireur)
-- client -> serveur : inclinaison du regard (radians), recopiée en attribut « Pitch » du personnage pour la kill-cam
local pitchFx = Instance.new("UnreliableRemoteEvent"); pitchFx.Name = "AimPitch"; pitchFx.Parent = ReplicatedStorage
pitchFx.OnServerEvent:Connect(function(player: Player, pitch: any)
	local char = player.Character
	if char and typeof(pitch) == "number" and pitch == pitch then char:SetAttribute("Pitch", math.clamp(pitch, -1.5, 1.5)) end
end)

local MAX_RANGE = 400
local MELEE_RANGE = 2.6 * Config.STUDS_PER_METER
local DRAW_TIME = 0.35                             -- temps pour sortir une arme

local WeaponService = {}
WeaponService.damageFilter = nil :: ((any, Model, number, boolean, string) -> number?)?
WeaponService.extraVictims = nil :: (() -> { Model })?   -- cibles non combattantes touchées par les grenades (zombies)
WeaponService.throwBlocked = nil :: ((any) -> boolean)?   -- posé par MatchService : pas de grenade pendant l'attente
-- multiplicateurs posés par un mode (Zombies : atouts, Forge Arcane) : what = "rate" (cadence), "reload" (durée), "mag" (chargeur)
WeaponService.modFn = nil :: ((any, string, string) -> number)?
local function modOf(c: any, key: string, what: string): number
	local f = WeaponService.modFn
	if not f then return 1 end
	local ok, v = pcall(f, c, key, what)
	return if ok and typeof(v) == "number" and v > 0 then v else 1
end

-- Événements serveur pour le mode de jeu (score, statistiques, assistances)
local killedEvent = Instance.new("BindableEvent")
local damagedEvent = Instance.new("BindableEvent")
local shotEvent = Instance.new("BindableEvent")
local targetEvent = Instance.new("BindableEvent")
WeaponService.Killed = killedEvent.Event       -- (tueur, victime, cléArme, tête)
WeaponService.Damaged = damagedEvent.Event     -- (tireur, victime, dégâts, tête)
WeaponService.ShotFired = shotEvent.Event      -- (tireur, cléArme)
WeaponService.TargetHit = targetEvent.Event    -- (tireur, cible) : cibles du stand de tir (attribut RangeTarget)

type Ammo = { mag: number, reserve: number }
type WState = {
	loadout: { string }, slot: number, weapon: string, ammo: { [string]: Ammo },
	nextShot: number, reloading: boolean, reloadToken: number,
	shield: number, armor: number, reduction: number, attachments: { string }, mods: A.Mods,
}
local state: { [any]: WState } = {}
local dead: { [Model]: boolean } = {}

-- ---------- identité des combattants ----------
function WeaponService.charOf(c: any): Model?
	if typeof(c) == "Instance" and c:IsA("Player") then return c.Character end
	if typeof(c) == "Instance" and c:IsA("Model") then return c end
	return nil
end

function WeaponService.combatantOf(model: Model): any
	return Players:GetPlayerFromCharacter(model) or model
end

function WeaponService.teamOf(c: any): string?
	if typeof(c) == "Instance" and c:IsA("Player") then
		local duelTeam = c:GetAttribute("DuelTeam")          -- en duel, l'équipe du duel passe avant celle du match
		if typeof(duelTeam) == "string" then return duelTeam end
		local team = c:GetAttribute("Team")                  -- équipe dans sa partie (MatchService), « solo:… » en chacun pour soi
		if typeof(team) == "string" then return team end
		return c.Team and c.Team.Name or nil
	end
	if typeof(c) == "Instance" and c:IsA("Model") then return c:GetAttribute("Team") :: string? end
	return nil
end

function WeaponService.nameOf(c: any): string
	if typeof(c) == "Instance" and c:IsA("Player") then return c.DisplayName end
	if typeof(c) == "Instance" then return c.Name end
	return "?"
end

local function isPlayer(c: any): boolean
	return typeof(c) == "Instance" and c:IsA("Player")
end

local function now(): number return workspace:GetServerTimeNow() end

-- ---------- arme visible dans la main ----------
-- Le serveur ne pose qu'une poignée invisible (« HeldWeapon ») avec l'attachment Muzzle au bout du vrai canon.
-- Chaque client y soude la vraie arme du jeu web (WeaponVisuals + WeaponModels) : rien ne passe par le réseau.
-- Si ReplicatedStorage/Assets/Weapons/<clé> existe (Model ou MeshPart fait dans Studio), il est utilisé à la place.
local WeaponInfo = require(ReplicatedStorage.Shared.WeaponInfo)
local WORLD_SCALE = 2.9                            -- studs par mètre pour l'arme tenue (proportions d'un avatar R15)

-- bras levés « en position de tir » : on tourne l'épaule (C0), l'animation de marche reste par-dessus
local function aimPose(char: Model, key: string)
	local w = Config.WEAPONS[key]
	local function pose(armName: string, jointName: string, cf: CFrame?)
		local arm = char:FindFirstChild(armName)
		local joint = arm and arm:FindFirstChild(jointName)
		if not joint or not joint:IsA("Motor6D") then return end
		local base = joint:GetAttribute("BaseC0")
		if typeof(base) ~= "CFrame" then base = joint.C0; joint:SetAttribute("BaseC0", base) end
		joint.C0 = if cf then (base :: CFrame) * cf else base :: CFrame
	end
	if w.melee then
		pose("RightUpperArm", "RightShoulder", CFrame.Angles(math.rad(55), 0, 0))
		pose("LeftUpperArm", "LeftShoulder", nil)
	else
		pose("RightUpperArm", "RightShoulder", CFrame.Angles(math.rad(90), 0, 0))
		pose("LeftUpperArm", "LeftShoulder", CFrame.Angles(math.rad(85), 0, math.rad(-35)))
	end
end

local function attachModel(c: any, key: string)
	local char = WeaponService.charOf(c)
	if not char then return end
	local old = char:FindFirstChild("HeldWeapon"); if old then old:Destroy() end
	local hand = (char:FindFirstChild("RightHand") or char:FindFirstChild("Right Arm")) :: BasePart?
	if not hand then return end
	aimPose(char, key)
	local w = Config.WEAPONS[key]
	local inf = WeaponInfo[key]
	local assets = ReplicatedStorage:FindFirstChild("Assets")
	local folder = assets and assets:FindFirstChild("Weapons")
	local src = folder and folder:FindFirstChild(key)
	local model: Instance
	local handle: BasePart
	if src and (src:IsA("Model") or src:IsA("BasePart")) then
		model = src:Clone()
		handle = (if model:IsA("Model") then (model.PrimaryPart or model:FindFirstChildWhichIsA("BasePart", true)) else model) :: BasePart
	else
		local p = Instance.new("Part"); p.Name = "Handle"; p.Size = Vector3.new(0.2, 0.2, 0.2); p.Transparency = 1
		model = p; handle = p
	end
	model.Name = "HeldWeapon"
	local parts = if model:IsA("BasePart") then { model } else {}
	for _, d in ipairs(model:GetDescendants()) do if d:IsA("BasePart") then table.insert(parts, d) end end
	for _, bp in ipairs(parts) do
		local b = bp :: BasePart
		b.Anchored = false; b.CanCollide = false; b.CanQuery = false; b.CanTouch = false; b.Massless = true
	end
	if not handle:FindFirstChild("Muzzle") then
		local a = Instance.new("Attachment"); a.Name = "Muzzle"
		a.Position = if inf then Vector3.new(0, inf.sight * 0.6, inf.muzzle) * WORLD_SCALE elseif w.melee then Vector3.new(0, 0, -0.7) else Vector3.new(0, 0.1, -1.5)
		a.Parent = handle
	end
	-- l'épaule levée fait pointer -Y de la main vers l'avant : l'arme (-Z = canon) est tournée pour suivre
	-- (Weld avec C0 fixe, et non WeldConstraint : la pose de l'épaule n'est appliquée qu'au pas physique suivant)
	local gripOffset = CFrame.new(0, -0.1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
	if model:IsA("Model") then model:PivotTo(hand.CFrame * gripOffset * handle.CFrame:ToObjectSpace(model:GetPivot())) else handle.CFrame = hand.CFrame * gripOffset end
	local weld = Instance.new("Weld"); weld.Part0 = hand; weld.Part1 = handle; weld.C0 = gripOffset; weld.Parent = handle
	model:SetAttribute("Custom", src ~= nil)
	model:SetAttribute("Key", key)
	-- skin de l'arme (attributs Skin_<arme> / Camo_<arme> du joueur, posés par DataService.syncSkins)
	model:SetAttribute("Skin", c:GetAttribute("Skin_" .. key))
	model:SetAttribute("Camo", c:GetAttribute("Camo_" .. key))
	model:SetAttribute("Att", c:GetAttribute("Att_" .. key))        -- accessoires de l'armurier, vus par tout le monde
	model.Parent = char
	char:SetAttribute("Weapon", key)
end

-- ---------- état et notification ----------
local function current(s: WState): Ammo
	local a = s.ammo[s.weapon]
	if not a then a = { mag = 0, reserve = 0 }; s.ammo[s.weapon] = a end
	return a
end

-- reloadDur : durée réelle de la recharge qui commence (accessoires et atouts compris), pour caler l'animation et ses sons
local function notify(c: any, reloadDur: number?)
	local s = state[c]
	if not s or not isPlayer(c) then return end
	local a = current(s)
	ammoFx:FireClient(c, { weapon = s.weapon, mag = a.mag, reserve = a.reserve, reloading = s.reloading, slot = s.slot, loadout = s.loadout,
		reloadDur = reloadDur })
end

-- Le bouclier vit sur le serveur : on le recopie dans un attribut du personnage pour le HUD.
local function syncShield(c: any)
	local s, char = state[c], WeaponService.charOf(c)
	if s and char then char:SetAttribute("Shield", math.floor(s.shield + 0.5)) end
end

-- accessoires actifs : attribut Att_<arme> posé par ArmoryService (déjà filtré : catégorie, niveau, éliminations)
local function readAttachments(c: any, key: string): { string }
	if not isPlayer(c) then return {} end
	return A.activeOf(c, key)
end

local function magSize(key: string, att: { string }, c: any?): number
	return math.ceil(Config.WEAPONS[key].mag * A.modsOf(att).mag * (if c ~= nil then modOf(c, key, "mag") else 1))
end

-- Donne un jeu d'armes complet (ex. { "galil", "glock", "knife" }) et sort la première.
function WeaponService.giveLoadout(c: any, keys: { string })
	local old = state[c]
	local s: WState = {
		loadout = {}, slot = 1, weapon = keys[1], ammo = {}, nextShot = 0, reloading = false, reloadToken = 0,
		shield = old and old.shield or 0, armor = old and old.armor or 0, reduction = 0, attachments = {}, mods = A.neutral(),
	}
	for _, k in ipairs(keys) do
		if Config.WEAPONS[k] then
			table.insert(s.loadout, k)
			s.ammo[k] = { mag = magSize(k, readAttachments(c, k), c), reserve = Config.WEAPONS[k].reserve }
		end
	end
	if #s.loadout == 0 then return end
	s.weapon = s.loadout[1]
	s.attachments = readAttachments(c, s.weapon); s.mods = A.modsOf(s.attachments)
	s.nextShot = now() + DRAW_TIME
	state[c] = s
	if not old then GrenadeService.defaultKit(c) end        -- équipement du web (dmLoadout) ; giveGrenades le remplace
	attachModel(c, s.weapon)
	syncShield(c)
	notify(c)
end

-- Une seule arme + couteau.
function WeaponService.giveWeapon(c: any, key: string)
	WeaponService.giveLoadout(c, { key, "knife" })
end

function WeaponService.switchTo(c: any, slot: number)
	local s = state[c]
	if not s or not s.loadout[slot] or s.slot == slot then return end
	s.slot = slot; s.weapon = s.loadout[slot]
	s.reloading = false; s.reloadToken += 1
	s.attachments = readAttachments(c, s.weapon); s.mods = A.modsOf(s.attachments)
	s.nextShot = now() + DRAW_TIME
	attachModel(c, s.weapon)
	notify(c)
end

function WeaponService.reload(c: any)
	local s = state[c]
	if not s or s.reloading then return end
	local w = Config.WEAPONS[s.weapon]
	local a = current(s)
	if w.melee or a.reserve <= 0 or a.mag >= magSize(s.weapon, s.attachments, c) then return end
	s.reloading = true; s.reloadToken += 1
	local token, key = s.reloadToken, s.weapon
	local dur = w.reload * s.mods.rel * modOf(c, key, "reload")
	notify(c, dur)
	task.delay(dur, function()
		local s2 = state[c]
		if s2 ~= s or s.reloadToken ~= token or s.weapon ~= key then return end
		local need = magSize(key, s.attachments, c) - a.mag
		local take = math.min(need, a.reserve)
		a.mag += take; a.reserve -= take
		s.reloading = false
		notify(c)
	end)
end

function WeaponService.current(c: any): (string?, number, number, boolean)
	local s = state[c]
	if not s then return nil, 0, 0, false end
	local a = current(s)
	return s.weapon, a.mag, a.reserve, s.reloading
end

function WeaponService.reset(c: any)
	state[c] = nil
	GrenadeService.reset(c)
	local char = WeaponService.charOf(c)
	if char then dead[char] = nil end
end

-- ---------- dégâts ----------
-- Point d'entrée unique pour tous les dégâts (balles, couteau, grenade) : bouclier -> gilet -> santé.
function WeaponService.applyDamage(attacker: any, victimChar: Model, raw: number, headshot: boolean, weaponKey: string, armorPen: number)
	local hum = victimChar:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or dead[victimChar] then return end
	-- filtre posé par MatchService (modificateurs « Têtes seulement », « Une balle ») ; nil = aucun dégât
	if WeaponService.damageFilter then
		local r = WeaponService.damageFilter(attacker, victimChar, raw, headshot, weaponKey)
		if not r then return end
		raw = r
	end
	local protectedUntil = victimChar:GetAttribute("ProtectedUntil")
	if typeof(protectedUntil) == "number" and protectedUntil > now() then return end
	local victim = WeaponService.combatantOf(victimChar)
	if victim == attacker then return end
	local dmg = raw
	local vs = state[victim]
	if vs and vs.reduction > 0 then dmg *= (1 - vs.reduction) end
	local total = dmg
	local absorbed = 0
	if vs and vs.shield > 0 then
		absorbed = math.min(vs.shield, dmg)
		vs.shield -= absorbed; dmg -= absorbed
		syncShield(victim)
	end
	if dmg > 0 and vs and vs.armor > 0 then
		local hp = dmg * armorPen
		vs.armor = math.max(0, vs.armor - (dmg - hp) * 0.5)
		dmg = hp
	end
	-- bouclier comme sur le web : tant qu'il tient, la vie ne bouge pas
	local final = if dmg <= 0.01 then 0 else math.max(1, math.floor(dmg + 0.5))
	if final > 0 then hum:TakeDamage(final) end
	local killed = hum.Health <= 0
	if killed then dead[victimChar] = true end
	local shieldOnly = absorbed > 0 and final == 0
	local shieldBroke = absorbed > 0 and vs ~= nil and vs.shield <= 0

	local aChar = WeaponService.charOf(attacker)
	local aRoot = aChar and aChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local vRoot = victimChar:FindFirstChild("HumanoidRootPart") :: BasePart?
	local shown = math.max(1, math.floor(total + 0.5))   -- le chiffre affiché compte aussi ce que le bouclier a pris
	if isPlayer(attacker) then
		hitFx:FireClient(attacker, headshot, killed, shown, vRoot and vRoot.Position or Vector3.zero, shieldOnly, victimChar)
	end
	if isPlayer(victim) then
		damagedFx:FireClient(victim, aRoot and aRoot.Position or Vector3.zero, shown, headshot, shieldOnly, shieldBroke, aChar)
	end
	damagedEvent:Fire(attacker, victim, shown, headshot)
	if killed then killedEvent:Fire(attacker, victim, weaponKey, headshot) end
end

local function zoneOf(part: Instance): string
	if part.Name == "Head" then return "Head" end
	if part.Name:find("Leg") or part.Name:find("Foot") then return "Leg" end
	return "Body"
end

-- ---------- tir ----------
-- Utilisé par le client (via FireWeapon) et par les bots : mêmes règles pour tout le monde.
function WeaponService.fire(c: any, origin: Vector3, direction: Vector3, aiming: boolean?): boolean
	local s = state[c]
	local char = WeaponService.charOf(c)
	if not s or not char or direction.Magnitude < 1e-3 then return false end
	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 then return false end
	local w = Config.WEAPONS[s.weapon]
	local t = now()
	if t < s.nextShot - 0.03 or s.reloading then return false end
	local a = current(s)
	if not w.melee and a.mag <= 0 then return false end
	local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root or (origin - root.Position).Magnitude > 8 then return false end -- l'origine doit rester près du tireur
	s.nextShot = t + 60 / (w.rpm * modOf(c, s.weapon, "rate"))
	if not w.melee then a.mag -= 1 end
	char:SetAttribute("ProtectedUntil", 0)             -- tirer annule la protection d'apparition
	shotEvent:Fire(c, s.weapon)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { char }
	local myTeam = WeaponService.teamOf(c)

	local m = s.mods
	if w.melee then          -- coup de couteau : casse les mines ennemies juste devant (minesNear du web)
		GrenadeService.minesNear(origin + direction.Unit * 1.4 * Config.STUDS_PER_METER, 1.1, c)
	end
	local function shoot()
		for _ = 1, (if w.melee then 1 else (w.pellets or 1)) do
			-- dispersion du web : réduite de 40 % en visée, puis accessoires (visée / hanche)
			local spread = math.rad(w.spread * (if aiming then .6 * m.adsSpr else m.hip))
			local dir = (CFrame.lookAlong(Vector3.zero, direction.Unit) * CFrame.Angles(
				(math.random() - 0.5) * spread, (math.random() - 0.5) * spread, 0)).LookVector
			local range = if w.melee then MELEE_RANGE else MAX_RANGE
			local result = workspace:Raycast(origin, dir * range, params)
			local endPos = result and result.Position or origin + dir * range
			if not w.melee then tracerFx:FireAllClients(origin, endPos, char) end
			if result and result.Instance and result.Instance:GetAttribute("MineId") ~= nil then
				GrenadeService.bulletHit(c, result.Instance)            -- balle sur une mine : elle est cassée
			elseif result and result.Instance and result.Instance:GetAttribute("RangeTarget") then
				targetEvent:Fire(c, result.Instance)
			elseif result and result.Instance then
				local victim = result.Instance:FindFirstAncestorOfClass("Model")
				if victim and victim:FindFirstChildOfClass("Humanoid") then
					local vc = WeaponService.combatantOf(victim)
					if WeaponService.teamOf(vc) ~= myTeam then          -- pas de tir ami
						local zone = zoneOf(result.Instance)
						local dmg = w.dmg * (if zone == "Head" then w.hs elseif zone == "Leg" then 0.75 else 1)
						dmg *= m.dmg
						-- chute des dégâts du web : au-delà de fo × portée (m), −fr par mètre, plancher fmin (0,5)
						local fall = A.FALLOFF[s.weapon]
						local dist = (result.Position - origin).Magnitude / Config.STUDS_PER_METER
						local fo = (if fall then fall[1] else 40) * m.rng
						if not w.melee and dist > fo then dmg *= math.max(fall and fall[3] or .5, 1 - (dist - fo) * (if fall then fall[2] else .004)) end
						local mult = char:GetAttribute("DmgMult")   -- niveau des bots (Modes.DIFFS.dmg)
						if typeof(mult) == "number" then dmg *= mult end
						WeaponService.applyDamage(c, victim, dmg, zone == "Head", s.weapon, w.armorPen)
					end
				end
			end
		end
	end
	if isPlayer(c) then NetService.rewound(c, function() shoot(); return true end) else shoot() end
	if not w.melee and a.mag <= 0 then WeaponService.reload(c) end -- recharge automatique
	return true
end

-- vecteur fini (ni NaN ni infini) : un NaN passe tous les tests « > 8 studs » et ferait partir un rayon n'importe où
local function finite(v: Vector3): boolean
	local m = v.Magnitude
	return m == m and m < 1e7
end
fireEvent.OnServerEvent:Connect(function(player: Player, origin: any, direction: any, aiming: any)
	if typeof(origin) ~= "Vector3" or typeof(direction) ~= "Vector3" or not finite(origin) or not finite(direction) then return end
	if not WeaponService.fire(player, origin, direction, aiming == true) then notify(player) end -- tir refusé : on resynchronise le client
end)
switchEvent.OnServerEvent:Connect(function(player: Player, slot: any)
	if typeof(slot) == "number" then WeaponService.switchTo(player, math.floor(slot)) end
end)
reloadEvent.OnServerEvent:Connect(function(player: Player)
	WeaponService.reload(player)
end)

-- ---------- bouclier, soins, munitions (ramassables de la carte) ----------
-- ajoute du bouclier (ramassable : +25, comme sur le web), sans dépasser Config.SHIELD_MAX
function WeaponService.addShield(c: any, amount: number)
	local s = state[c]; if s then s.shield = math.min(Config.SHIELD_MAX, s.shield + amount); syncShield(c) end
end
function WeaponService.shieldOf(c: any): number
	local s = state[c]; return s and s.shield or 0
end
-- bouclier fixé à une valeur (boutique des modes à manches : bouclier léger 25, lourd 50)
function WeaponService.setShield(c: any, amount: number)
	local s = state[c]; if s then s.shield = math.clamp(amount, 0, Config.SHIELD_MAX); syncShield(c) end
end
-- gilet pare-balles (boutique des modes à manches : 100 = gilet neuf)
function WeaponService.setArmor(c: any, amount: number)
	local s = state[c]; if s then s.armor = math.clamp(amount, 0, 100) end
	local char = WeaponService.charOf(c)
	if char then char:SetAttribute("Armor", math.floor(math.clamp(amount, 0, 100) + 0.5)) end
end
function WeaponService.armorOf(c: any): number
	local s = state[c]; return s and s.armor or 0
end
function WeaponService.setReduction(c: any, r: number)
	local s = state[c]; if s then s.reduction = r end
end
-- Réserve d'une arme (Arme tournante, Mastodonte : 999 = illimitée)
function WeaponService.setReserve(c: any, key: string, n: number)
	local s = state[c]
	local a = s and s.ammo[key]
	if a then a.reserve = n; notify(c) end
end

function WeaponService.resupply(c: any)
	local s = state[c]; if not s then return end
	for _, k in ipairs(s.loadout) do
		local a = s.ammo[k]
		if a then a.reserve = Config.WEAPONS[k].reserve end
	end
	notify(c)
end
function WeaponService.hearingRange(c: any): number
	local s = state[c]
	return if s and s.mods.sil then X.ATTACHMENTS.sil.hearingRange else 42
end

-- ---------- armes changées en cours de partie (Zombies, Bataille royale) ----------
function WeaponService.loadoutOf(c: any): { string }
	local s = state[c]
	return if s then table.clone(s.loadout) else {}
end
-- remplace le jeu d'armes en gardant les munitions de celles déjà tenues ; sort `select` (ou la première)
function WeaponService.setLoadoutKeep(c: any, keys: { string }, select: string?)
	local old = state[c]
	if not old then WeaponService.giveLoadout(c, keys); return end
	local list, ammo = {}, {}
	for _, k in ipairs(keys) do
		if Config.WEAPONS[k] and not table.find(list, k) then
			table.insert(list, k)
			ammo[k] = old.ammo[k] or { mag = magSize(k, readAttachments(c, k), c), reserve = Config.WEAPONS[k].reserve }
		end
	end
	if #list == 0 then return end
	old.loadout = list; old.ammo = ammo
	local want = if select and table.find(list, select) then select elseif table.find(list, old.weapon) then old.weapon else list[1]
	old.slot = table.find(list, want) :: number
	if want ~= old.weapon then
		old.weapon = want; old.reloading = false; old.reloadToken += 1
		old.attachments = readAttachments(c, want); old.mods = A.modsOf(old.attachments); old.nextShot = now() + DRAW_TIME
		attachModel(c, want)
	end
	notify(c)
end
function WeaponService.ammoOf(c: any, key: string): (number, number)
	local s = state[c]
	local a = s and s.ammo[key]
	if not a then return 0, 0 end
	return a.mag, a.reserve
end
function WeaponService.setAmmo(c: any, key: string, mag: number?, reserve: number?)
	local s = state[c]
	local a = s and s.ammo[key]
	if not s or not a then return end
	if mag then a.mag = mag end
	if reserve then a.reserve = reserve end
	notify(c)
end
-- taille du chargeur de ce combattant pour cette arme (accessoires et multiplicateurs du mode compris)
function WeaponService.magOf(c: any, key: string): number
	if not Config.WEAPONS[key] then return 0 end
	return magSize(key, readAttachments(c, key), c)
end

-- ---------- grenades et mines : GrenadeService (trajectoire, rebonds, mèches, dégâts, flash, fumée) ----------
-- compatibilité : (fumigènes, flashs, frags[, mines])
function WeaponService.giveGrenades(c: any, smoke: number, flash: number, frag: number, mine: number?)
	GrenadeService.set(c, frag, flash, smoke, mine or 0)
end
-- rend une grenade de ce type si le combattant n'en a plus (modificateur « Grenades à volonté ») ; true si rendue
function WeaponService.refillGrenade(c: any, kind: string): boolean
	return GrenadeService.refill(c, kind)
end
-- target : point visé (bots, trajectoire en cloche du web) ; sinon le regard du personnage
function WeaponService.throwGrenade(c: any, kind: string, free: boolean?, target: Vector3?): boolean
	return GrenadeService.throw(c, kind, free, nil, target)
end
WeaponService.placeMine = GrenadeService.placeMine
-- stock de grenades et de mines d'un combattant ({ frag, flash, smoke, mine }), nil s'il n'en a pas
function WeaponService.grenadesOf(c: any): { frag: number, flash: number, smoke: number, mine: number }?
	return GrenadeService.get(c)
end
-- recharge l'arme en main et les autres armes au maximum du chargeur (panneau admin : balles infinies)
function WeaponService.fillMags(c: any)
	local s = state[c]; if not s then return end
	for _, k in ipairs(s.loadout) do
		local a = s.ammo[k]
		if a and not Config.WEAPONS[k].melee then
			a.mag = math.max(a.mag, magSize(k, if k == s.weapon then s.attachments else readAttachments(c, k)))
			a.reserve = math.max(a.reserve, Config.WEAPONS[k].reserve)
		end
	end
	notify(c)
end
WeaponService.smokeBlocks = GrenadeService.smokeBlocks
WeaponService.clearGrenades = GrenadeService.clear
-- itère sur les combattants armés (joueurs et bots)
function WeaponService.eachCombatant(): () -> any
	local list = {}
	for c in pairs(state) do table.insert(list, c) end
	local i = 0
	return function() i += 1; return list[i] end
end
GrenadeService.init(WeaponService)

Players.PlayerRemoving:Connect(function(p) WeaponService.reset(p) end)
return WeaponService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="473">
      <Properties>
        <string name="Name">WeatherService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/WeatherService (ModuleScript)
-- Météo + heure de la journée : règle Lighting côté serveur et publie l'attribut "Weather" sur Workspace
-- (le client, WeatherController, ajoute pluie / éclairs / sons).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Lighting = game:GetService("Lighting")

local X = require(ReplicatedStorage.Shared.ConfigExtra)

local WeatherService = {}
local base = { brightness = Lighting.Brightness, fogEnd = Lighting.FogEnd, fogStart = Lighting.FogStart, fogColor = Lighting.FogColor, ambient = Lighting.Ambient }

function WeatherService.apply(weather: string, tod: string, nightMap: boolean?)
	local w = X.WEATHER[weather] or X.WEATHER.clear
	Lighting.ClockTime = if nightMap then 23 else (X.TIME_OF_DAY[tod] or 14)
	Lighting.Brightness = base.brightness * w.sun * (if tod == "night" and not nightMap then 0.35 else 1)
	Lighting.FogStart = w.fogStart or base.fogStart
	Lighting.FogEnd = if w.fogStart then w.fogEnd else base.fogEnd * w.fogEnd
	Lighting.FogColor = if weather == "clear" then base.fogColor else base.fogColor:Lerp(Color3.fromRGB(110, 118, 132), 0.55)
	Lighting.Ambient = if tod == "night" then base.ambient:Lerp(Color3.fromRGB(20, 30, 60), 0.7) else base.ambient
	workspace:SetAttribute("Weather", weather)
	workspace:SetAttribute("TimeOfDay", tod)
end

return WeatherService
]]></string>
      </Properties>
    </Item>
    <Item class="ModuleScript" referent="474">
      <Properties>
        <string name="Name">ZombieService</string>
        <string name="Source"><![CDATA[--!strict
-- ServerScriptService/ZombieService (ModuleScript, requis par Modes/zombies)
-- Les zombies du mode Zombies (web : zSpawn / zombieUpdate de src/61_variants.js, apparence de src/49_charmodels.js) :
-- ils sortent du sol (1,1 s), foncent vers le survivant le plus proche (ligne droite s'il est en vue à moins de 9 m,
-- sinon PathfindingService), mordent quand ils sont à moins de 1,8 m (cadence propre au niveau), peuvent être gelés
-- (Souffle Givré) et repoussés (Canon Tonnerre). Types : normal, runner (coureur), tank, crawler (rôdeur), boss (la Brute).
-- Ce ne sont pas des bots : ils n'ont pas d'équipe (attribut Team absent), MatchService ne les compte donc pas au tableau.
local Players = game:GetService("Players")
local PathfindingService = game:GetService("PathfindingService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)

local U = Config.STUDS_PER_METER
local SPEED_K = 16 / 5.2          -- 1 m/s du web en studs/s (le joueur Roblox court à 16 studs/s, le web à 5,2 m/s)
local ZombieService = {}

export type SpawnOpts = {
	match: number, parent: Instance, pos: Vector3, ztype: string, hp: number, speed: number, dmg: number, atk: number,
	carrier: boolean?, id: number,
	targets: () -> { Model },                       -- personnages que les zombies peuvent viser (vivants, debout, sans protection)
	onHit: (Model, Model, number) -> (),            -- (zombie, cible, dégâts)
}
type Brain = {
	model: Model, hum: Humanoid, root: BasePart, opts: SpawnOpts, alive: boolean, riseT: number, atkT: number, frozenT: number,
	waypoints: { PathWaypoint }, wp: number, pathGoal: Vector3?, repathAt: number, pathBusy: boolean, home: Vector3,
	tracks: { [string]: AnimationTrack }, cur: string?, punchT: number,
}
local brains: { [Model]: Brain } = {}

-- animations R15 du « Zombie Animation Package » de Roblox
local ANIMS = { idle = "rbxassetid://616158929", walk = "rbxassetid://616168032", run = "rbxassetid://616163682" }

local function hsv(h: number, s: number, v: number): Color3 return Color3.fromHSV(h % 1, math.clamp(s, 0, 1), math.clamp(v, 0, 1)) end

-- apparence : peau pâle verdâtre ou violacée propre à chaque zombie, vêtements sales ; la Brute est rougeâtre
local function look(ztype: string, id: number): HumanoidDescription
	local r = Random.new(id * 7919 + 7)
	local desc = Instance.new("HumanoidDescription")
	local skin = if ztype == "boss" then Color3.fromRGB(242, 184, 178) else hsv(0.2 + r:NextNumber() * 0.16, 0.22 + r:NextNumber() * 0.2, 0.5 + r:NextNumber() * 0.18)
	desc.HeadColor = skin; desc.LeftArmColor = skin; desc.RightArmColor = skin
	local cloth = if ztype == "tank" then Color3.fromRGB(38, 44, 52) elseif ztype == "boss" then Color3.fromRGB(70, 30, 26)
		else hsv(0.05 + r:NextNumber() * 0.12, 0.2 + r:NextNumber() * 0.3, 0.2 + r:NextNumber() * 0.25)
	desc.TorsoColor = cloth
	local legs = hsv(0.6, 0.1, 0.12 + r:NextNumber() * 0.15)
	desc.LeftLegColor = legs; desc.RightLegColor = legs
	return desc
end

local function play(b: Brain, name: string, speed: number)
	if b.cur ~= name then
		local old = b.cur and b.tracks[b.cur]
		if old then old:Stop(0.25) end
		local t = b.tracks[name]
		if t then t:Play(0.25) end
		b.cur = name
	end
	local t = b.tracks[name]
	if t then t:AdjustSpeed(speed) end
end

local function headOf(m: Model): BasePart?
	return (m:FindFirstChild("Head") or m:FindFirstChild("HumanoidRootPart")) :: BasePart?
end

local function losClear(b: Brain, target: Model): boolean
	local a, t = headOf(b.model), headOf(target)
	if not a or not t then return false end
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { b.opts.parent }
	local r = workspace:Raycast(a.Position, t.Position - a.Position, params)
	return r == nil or r.Instance:IsDescendantOf(target)
end

local function repath(b: Brain, goal: Vector3)
	if b.pathBusy then return end
	b.pathBusy = true; b.repathAt = os.clock() + 1.2 + math.random() * 0.6
	task.spawn(function()
		local path = PathfindingService:CreatePath({ AgentRadius = 1.6, AgentHeight = 5, AgentCanJump = true, WaypointSpacing = 5 })
		local ok = pcall(function() path:ComputeAsync(b.root.Position, goal) end)
		b.pathBusy = false
		if ok and path.Status == Enum.PathStatus.Success and b.alive then
			b.waypoints = path:GetWaypoints(); b.wp = 2; b.pathGoal = goal
		end
	end)
end

-- bras qui frappent (petite rotation des épaules)
local function punch(b: Brain)
	b.punchT = 0.35
	for _, n in ipairs({ { "RightUpperArm", "RightShoulder" }, { "LeftUpperArm", "LeftShoulder" } }) do
		local arm = b.model:FindFirstChild(n[1])
		local j = arm and arm:FindFirstChild(n[2])
		if j and j:IsA("Motor6D") then
			local base = j:GetAttribute("BaseC0")
			if typeof(base) ~= "CFrame" then base = j.C0; j:SetAttribute("BaseC0", base) end
			j.C0 = (base :: CFrame) * CFrame.Angles(math.rad(70), 0, 0)
			task.delay(0.25, function() if j.Parent then j.C0 = base :: CFrame end end)
		end
	end
end

local function think(b: Brain, dt: number)
	if not b.alive then return end
	local o = b.opts
	-- sortie du sol
	if b.riseT > 0 then
		b.riseT -= dt
		local pv = b.model:GetPivot()
		b.model:PivotTo(CFrame.new(b.home - Vector3.new(0, math.max(0, b.riseT) * 1.6 * U, 0)) * (pv - pv.Position))
		if b.riseT <= 0 then
			b.root.Anchored = false
			pcall(function() b.root:SetNetworkOwner(nil) end)
		end
		return
	end
	if b.frozenT > 0 then
		b.frozenT -= dt
		b.hum:Move(Vector3.zero); b.hum.WalkSpeed = 0
		play(b, "idle", 0)
		if b.frozenT <= 0 then
			b.hum.WalkSpeed = o.speed
			local h = b.model:FindFirstChild("Frost"); if h then h:Destroy() end
		end
		return
	end
	if b.punchT > 0 then b.punchT -= dt end
	-- survivant le plus proche
	local best, bd = nil :: Model?, math.huge
	for _, t in ipairs(o.targets()) do
		local r = t:FindFirstChild("HumanoidRootPart") :: BasePart?
		if r then
			local d = (Vector3.new(r.Position.X, 0, r.Position.Z) - Vector3.new(b.root.Position.X, 0, b.root.Position.Z)).Magnitude
			if d < bd then best, bd = t, d end
		end
	end
	b.atkT -= dt
	if not best then b.hum:Move(Vector3.zero); play(b, "idle", 1); return end
	local tr = best:FindFirstChild("HumanoidRootPart") :: BasePart
	local dy = math.abs(tr.Position.Y - b.root.Position.Y)
	local scale = b.model:GetScale()
	if bd < 1.8 * U * math.max(1, scale * 0.8) and dy < 2.2 * U then
		b.hum:Move(Vector3.zero)
		b.root.CFrame = CFrame.lookAt(b.root.Position, Vector3.new(tr.Position.X, b.root.Position.Y, tr.Position.Z))
		play(b, "idle", 1)
		if b.atkT <= 0 then
			b.atkT = o.atk
			punch(b)
			o.onHit(b.model, best, o.dmg)
		end
		return
	end
	local run = o.ztype == "runner" or o.speed > 3.8 * SPEED_K
	play(b, if run then "run" else "walk", math.clamp(o.speed / (if run then 18 else 8), 0.6, 1.6))
	if bd < 9 * U and dy < 1.2 * U and losClear(b, best) then
		b.hum:MoveTo(tr.Position)
		b.waypoints = {}
		return
	end
	if #b.waypoints == 0 or os.clock() > b.repathAt or (b.pathGoal and (b.pathGoal - tr.Position).Magnitude > 4 * U) then
		repath(b, tr.Position)
	end
	local wp = b.waypoints[b.wp]
	if wp then
		if wp.Action == Enum.PathWaypointAction.Jump then b.hum.Jump = true end
		b.hum:MoveTo(wp.Position)
		local flat = (Vector3.new(wp.Position.X, 0, wp.Position.Z) - Vector3.new(b.root.Position.X, 0, b.root.Position.Z)).Magnitude
		if flat < 2.5 then b.wp += 1 end
	else
		b.hum:MoveTo(tr.Position)
	end
end

function ZombieService.metersToSpeed(ms: number): number return ms * SPEED_K end

function ZombieService.spawn(o: SpawnOpts): Model
	local model = Players:CreateHumanoidModelFromDescription(look(o.ztype, o.id), Enum.HumanoidRigType.R15)
	model.Name = "Zombie_" .. o.id
	model:SetAttribute("MatchId", o.match)
	model:SetAttribute("Zombie", true)
	model:SetAttribute("ZType", o.ztype)
	local hum = model:FindFirstChildOfClass("Humanoid") :: Humanoid
	hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	hum.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	hum.MaxHealth = o.hp; hum.Health = o.hp
	hum.WalkSpeed = o.speed
	hum.AutoJumpEnabled = true
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart
	local scale = if o.ztype == "boss" then 1.8 elseif o.ztype == "tank" then 1.3 elseif o.ztype == "runner" then 0.92 elseif o.ztype == "crawler" then 0.95 else 0.93 + (o.id * 0.137 % 1) * 0.14
	pcall(function() model:ScaleTo(scale) end)
	-- rôdeur : à quatre pattes (corps basculé vers l'avant, plus bas)
	if o.ztype == "crawler" then
		local lt = model:FindFirstChild("LowerTorso")
		local j = lt and lt:FindFirstChild("Root")
		if j and j:IsA("Motor6D") then j.C0 = j.C0 * CFrame.new(0, -1.2, 0) * CFrame.Angles(math.rad(-70), 0, 0) end
		hum.HipHeight = math.max(0.4, hum.HipHeight * 0.4)
	end
	if o.ztype == "boss" then
		local hl = Instance.new("Highlight"); hl.Name = "BossGlow"; hl.FillColor = Color3.fromRGB(255, 60, 40); hl.FillTransparency = 0.8
		hl.OutlineColor = Color3.fromRGB(255, 80, 60); hl.DepthMode = Enum.HighlightDepthMode.Occluded; hl.Parent = model
	end
	if o.carrier then
		local hl = Instance.new("Highlight"); hl.Name = "AmmoGlow"; hl.FillColor = Color3.fromRGB(255, 210, 58); hl.FillTransparency = 0.55
		hl.OutlineColor = Color3.fromRGB(255, 225, 120); hl.DepthMode = Enum.HighlightDepthMode.Occluded; hl.Parent = model
		local head = model:FindFirstChild("Head")
		if head then local l = Instance.new("PointLight"); l.Name = "AmmoLight"; l.Color = Color3.fromRGB(255, 210, 58); l.Range = 10; l.Brightness = 2; l.Parent = head end
		model:SetAttribute("AmmoCarrier", true)
	end
	root.Anchored = true
	local home = o.pos + Vector3.new(0, hum.HipHeight + root.Size.Y / 2, 0)
	model:PivotTo(CFrame.new(home - Vector3.new(0, 1.1 * 1.6 * U, 0)) * CFrame.Angles(0, math.random() * math.pi * 2, 0))
	model.Parent = o.parent
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator")
	animator.Parent = hum
	local tracks = {}
	for k, id in pairs(ANIMS) do
		local a = Instance.new("Animation"); a.AnimationId = id
		local ok, t = pcall(function() return animator:LoadAnimation(a) end)
		if ok and t then t.Looped = true; tracks[k] = t end
	end
	local b: Brain = { model = model, hum = hum, root = root, opts = o, alive = true, riseT = 1.1, atkT = 0, frozenT = 0,
		waypoints = {}, wp = 1, pathGoal = nil, repathAt = 0, pathBusy = false, home = home, tracks = tracks, cur = nil, punchT = 0 }
	brains[model] = b
	play(b, "idle", 1)
	hum.Died:Connect(function()
		b.alive = false
		for _, t in pairs(b.tracks) do t:Stop(0.1) end
		root.Anchored = false
		for _, n in ipairs({ "AmmoGlow", "AmmoLight", "Frost" }) do local x = model:FindFirstChild(n, true); if x then x:Destroy() end end
	end)
	return model
end

function ZombieService.isZombie(m: any): boolean
	return typeof(m) == "Instance" and brains[m :: any] ~= nil
end
function ZombieService.alive(m: Model): boolean
	local b = brains[m]; return b ~= nil and b.alive
end
function ZombieService.ofMatch(id: number): { Model }
	local l = {}
	for m, b in pairs(brains) do if b.alive and b.opts.match == id then table.insert(l, m) end end
	return l
end
-- tous les zombies vivants (grenades et mines : WeaponService.extraVictims)
function ZombieService.all(): { Model }
	local l = {}
	for m, b in pairs(brains) do if b.alive then table.insert(l, m) end end
	return l
end
function ZombieService.typeOf(m: Model): string?
	local b = brains[m]; return b and b.opts.ztype
end
-- gel (Souffle Givré) : immobile, halo bleu
function ZombieService.freeze(m: Model, t: number)
	local b = brains[m]
	if not b or not b.alive then return end
	b.frozenT = math.max(b.frozenT, t)
	if not m:FindFirstChild("Frost") then
		local hl = Instance.new("Highlight"); hl.Name = "Frost"; hl.FillColor = Color3.fromRGB(150, 220, 255); hl.FillTransparency = 0.35
		hl.OutlineColor = Color3.fromRGB(200, 240, 255); hl.Parent = m
	end
end
function ZombieService.frozen(m: Model): number
	local b = brains[m]; return b and b.frozenT or 0
end
-- repousse (Canon Tonnerre, Second Souffle)
function ZombieService.push(m: Model, dir: Vector3, studs: number)
	local b = brains[m]
	if not b or not b.alive or b.riseT > 0 then return end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 1e-3 then return end
	local to = b.root.Position + flat.Unit * studs
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { b.opts.parent }
	if workspace:Raycast(b.root.Position, to - b.root.Position, params) then return end
	b.model:PivotTo(b.model:GetPivot() + (to - b.root.Position))
end
function ZombieService.remove(m: Model)
	brains[m] = nil
	if m.Parent then m:Destroy() end
end
function ZombieService.removeMatch(id: number)
	for m, b in pairs(brains) do if b.opts.match == id then ZombieService.remove(m) end end
end

task.spawn(function()
	local last = os.clock()
	while true do
		task.wait(0.1)
		local now = os.clock()
		local dt = now - last; last = now
		for m, b in pairs(brains) do
			if not m.Parent then brains[m] = nil
			elseif b.alive and not m:GetAttribute("Frozen") then
				local ok, err = pcall(function() think(b, dt) end)
				if not ok then warn("[ZombieService]", err) end
			end
		end
	end
end)

do
	local WS = require(script.Parent.WeaponService) :: any
	WS.extraVictims = ZombieService.all
end
return ZombieService
]]></string>
      </Properties>
    </Item>
  </Item>
  <Item class="ServerStorage" referent="475">
    <Properties>
      <string name="Name">ServerStorage</string>
    </Properties>
    <Item class="ModuleScript" referent="476">
      <Properties>
        <string name="Name">JpegDecode</string>
        <string name="Source"><![CDATA[--!strict
--!native
--!optimize 2
-- ServerStorage/JpegDecode (ModuleScript, Studio seulement : envoi des textures par ServerStorage/MeshUploader)
-- Décodeur JPEG « baseline » (le format des textures des armes réalistes, models/weapons_real) : tables de Huffman,
-- quantification, transformée en cosinus inverse (algorithme de Loeffler, comme stb_image), sous-échantillonnage des
-- couleurs (4:2:0, 4:2:2, 4:4:4), intervalles de reprise, images en niveaux de gris ou en couleur (YCbCr).
-- Les JPEG progressifs ou arithmétiques sont refusés (erreur) : tools/export_weapons_real_lua.py n'en écrit pas.
--   decode(données, début, longueur) -> largeur, hauteur, pixels RGBA (buffer de largeur × hauteur × 4 octets)
-- Garder les textures en JPEG (et non en pixels) divise par dix la place qu'elles prennent dans la place Roblox.

local ZZ = { -- ordre en zigzag -> position dans le bloc 8 × 8 (0..63)
	0, 1, 8, 16, 9, 2, 3, 10, 17, 24, 32, 25, 18, 11, 4, 5, 12, 19, 26, 33, 40, 48, 41, 34, 27, 20, 13, 6, 7, 14, 21,
	28, 35, 42, 49, 56, 57, 50, 43, 36, 29, 22, 15, 23, 30, 37, 44, 51, 58, 59, 52, 45, 38, 31, 39, 46, 53, 60, 61,
	54, 47, 55, 62, 63,
}
local LUTBITS = 9

type Huff = { lut: { number }, maxcode: { number }, valptr: { number }, mincode: { number }, vals: { number } }
type Comp = { id: number, h: number, v: number, tq: number, td: number, ta: number, bw: number, bh: number,
	plane: buffer, stride: number, pred: number }

local function buildHuff(counts: { number }, vals: { number }): Huff
	local lut = table.create(bit32.lshift(1, LUTBITS), 0)
	local maxcode, valptr, mincode = table.create(17, -1), table.create(17, 0), table.create(17, 0)
	local code, k = 0, 0
	for len = 1, 16 do
		local n = counts[len]
		valptr[len] = k; mincode[len] = code
		for _ = 1, n do
			if len <= LUTBITS then
				-- toutes les entrées de 9 bits qui commencent par ce code
				local shift = LUTBITS - len
				local base = bit32.lshift(code, shift)
				for f = 0, bit32.lshift(1, shift) - 1 do lut[base + f + 1] = len * 256 + vals[k + 1] end
			end
			code += 1; k += 1
		end
		maxcode[len] = if n > 0 then code - 1 else -1
		code *= 2
	end
	return { lut = lut, maxcode = maxcode, valptr = valptr, mincode = mincode, vals = vals }
end

-- transformée inverse d'un bloc (coefficients déquantifiés, en place) puis écriture des 64 pixels dans le plan
local function idct(c: { number }, plane: buffer, stride: number, px: number, py: number)
	-- colonnes
	for i = 0, 7 do
		local s0, s1, s2, s3 = c[i + 1], c[i + 9], c[i + 17], c[i + 25]
		local s4, s5, s6, s7 = c[i + 33], c[i + 41], c[i + 49], c[i + 57]
		if s1 == 0 and s2 == 0 and s3 == 0 and s4 == 0 and s5 == 0 and s6 == 0 and s7 == 0 then
			c[i + 9] = s0; c[i + 17] = s0; c[i + 25] = s0; c[i + 33] = s0; c[i + 41] = s0; c[i + 49] = s0; c[i + 57] = s0
		else
			local p1 = (s2 + s6) * 0.5411961
			local t2 = p1 + s6 * -1.847759065
			local t3 = p1 + s2 * 0.765366865
			local t0 = s0 + s4
			local t1 = s0 - s4
			local x0, x3, x1, x2 = t0 + t3, t0 - t3, t1 + t2, t1 - t2
			local q3, q4, q1, q2 = s7 + s3, s5 + s1, s7 + s1, s5 + s3
			local p5 = (q3 + q4) * 1.175875602
			local a0, a1, a2, a3 = s7 * 0.298631336, s5 * 2.053119869, s3 * 3.072711026, s1 * 1.501321110
			q1 = p5 + q1 * -0.899976223
			q2 = p5 + q2 * -2.562915447
			q3 = q3 * -1.961570560
			q4 = q4 * -0.390180644
			a3 += q1 + q4; a2 += q2 + q3; a1 += q2 + q4; a0 += q1 + q3
			c[i + 1] = x0 + a3; c[i + 57] = x0 - a3; c[i + 9] = x1 + a2; c[i + 49] = x1 - a2
			c[i + 17] = x2 + a1; c[i + 41] = x2 - a1; c[i + 25] = x3 + a0; c[i + 33] = x3 - a0
		end
	end
	-- lignes, puis /8, +128, bornes 0..255
	for r = 0, 7 do
		local o = r * 8
		local s0, s1, s2, s3 = c[o + 1], c[o + 2], c[o + 3], c[o + 4]
		local s4, s5, s6, s7 = c[o + 5], c[o + 6], c[o + 7], c[o + 8]
		local p1 = (s2 + s6) * 0.5411961
		local t2 = p1 + s6 * -1.847759065
		local t3 = p1 + s2 * 0.765366865
		local t0 = s0 + s4
		local t1 = s0 - s4
		local x0, x3, x1, x2 = t0 + t3, t0 - t3, t1 + t2, t1 - t2
		local q3, q4, q1, q2 = s7 + s3, s5 + s1, s7 + s1, s5 + s3
		local p5 = (q3 + q4) * 1.175875602
		local a0, a1, a2, a3 = s7 * 0.298631336, s5 * 2.053119869, s3 * 3.072711026, s1 * 1.501321110
		q1 = p5 + q1 * -0.899976223
		q2 = p5 + q2 * -2.562915447
		q3 = q3 * -1.961570560
		q4 = q4 * -0.390180644
		a3 += q1 + q4; a2 += q2 + q3; a1 += q2 + q4; a0 += q1 + q3
		local base = (py + r) * stride + px
		local v
		v = (x0 + a3) * 0.125 + 128.5; buffer.writeu8(plane, base, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x1 + a2) * 0.125 + 128.5; buffer.writeu8(plane, base + 1, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x2 + a1) * 0.125 + 128.5; buffer.writeu8(plane, base + 2, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x3 + a0) * 0.125 + 128.5; buffer.writeu8(plane, base + 3, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x3 - a0) * 0.125 + 128.5; buffer.writeu8(plane, base + 4, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x2 - a1) * 0.125 + 128.5; buffer.writeu8(plane, base + 5, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x1 - a2) * 0.125 + 128.5; buffer.writeu8(plane, base + 6, if v < 0 then 0 elseif v > 255 then 255 else v)
		v = (x0 - a3) * 0.125 + 128.5; buffer.writeu8(plane, base + 7, if v < 0 then 0 elseif v > 255 then 255 else v)
	end
end

local function decode(data: buffer, start: number, len: number): (number, number, buffer)
	local pos = start
	local stop = start + len
	local function u8(): number local b = buffer.readu8(data, pos); pos += 1; return b end
	local function u16(): number local b = buffer.readu8(data, pos) * 256 + buffer.readu8(data, pos + 1); pos += 2; return b end

	local qt: { { number } } = {}
	local hdc: { Huff } = {}
	local hac: { Huff } = {}
	local comps: { Comp } = {}
	local W, H, hmax, vmax = 0, 0, 1, 1
	local restart = 0
	local done = false
	local scanned = 0

	if u16() ~= 0xFFD8 then error("JPEG : en-tête SOI absent") end
	while not done and pos < stop do
		local m = u8()
		if m ~= 0xFF then continue end
		local mk = u8()
		while mk == 0xFF do mk = u8() end
		if mk == 0xD8 or (mk >= 0xD0 and mk <= 0xD7) or mk == 0x01 then continue end
		if mk == 0xD9 then break end
		local seg = u16()
		local segEnd = pos + seg - 2
		if mk == 0xDB then                                  -- tables de quantification
			while pos < segEnd do
				local pq = u8()
				local t = table.create(64, 0)
				local wide = bit32.rshift(pq, 4) ~= 0
				for k = 1, 64 do t[k] = if wide then u16() else u8() end
				qt[bit32.band(pq, 15) + 1] = t
			end
		elseif mk == 0xC4 then                              -- tables de Huffman
			while pos < segEnd do
				local tc = u8()
				local counts = table.create(16, 0)
				local total = 0
				for k = 1, 16 do counts[k] = u8(); total += counts[k] end
				local vals = table.create(total, 0)
				for k = 1, total do vals[k] = u8() end
				local h = buildHuff(counts, vals)
				if bit32.rshift(tc, 4) == 0 then hdc[bit32.band(tc, 15) + 1] = h else hac[bit32.band(tc, 15) + 1] = h end
			end
		elseif mk == 0xC0 or mk == 0xC1 then                -- image « baseline »
			if u8() ~= 8 then error("JPEG : seuls les échantillons de 8 bits sont lus") end
			H = u16(); W = u16()
			local nf = u8()
			for _ = 1, nf do
				local id, hv, tq = u8(), u8(), u8()
				local c: Comp = { id = id, h = bit32.rshift(hv, 4), v = bit32.band(hv, 15), tq = tq + 1, td = 1, ta = 1,
					bw = 0, bh = 0, plane = buffer.create(0), stride = 0, pred = 0 }
				hmax = math.max(hmax, c.h); vmax = math.max(vmax, c.v)
				table.insert(comps, c)
			end
		elseif mk == 0xC2 or mk == 0xC3 or (mk >= 0xC5 and mk <= 0xCF and mk ~= 0xC8 and mk ~= 0xCC) then
			error("JPEG : format non pris en charge (progressif ou arithmétique)")
		elseif mk == 0xDD then
			restart = u16()
		elseif mk == 0xDA then                              -- début des données
			local ns = u8()
			local scomp: { Comp } = {}
			for _ = 1, ns do
				local id, t = u8(), u8()
				for _, c in ipairs(comps) do
					if c.id == id then c.td = bit32.rshift(t, 4) + 1; c.ta = bit32.band(t, 15) + 1; table.insert(scomp, c) end
				end
			end
			pos = segEnd
			local mcuW, mcuH = 8 * hmax, 8 * vmax
			local mx, my = (W + mcuW - 1) // mcuW, (H + mcuH - 1) // mcuH
			for _, c in ipairs(comps) do
				c.bw = mx * c.h; c.bh = my * c.v
				c.stride = c.bw * 8
				if buffer.len(c.plane) == 0 then c.plane = buffer.create(c.stride * c.bh * 8) end
				c.pred = 0
			end
			-- lecture des bits (octets 0xFF00 = 0xFF ; un marqueur arrête la lecture : on complète par des zéros)
			local bitbuf, bitcnt = 0, 0
			local function fill()
				while bitcnt <= 24 do
					local b = 0
					if pos < stop then
						b = buffer.readu8(data, pos)
						if b == 0xFF then
							local n2 = if pos + 1 < stop then buffer.readu8(data, pos + 1) else 0
							if n2 == 0 then pos += 2 else b = 0 end    -- marqueur : on ne le consomme pas
						else
							pos += 1
						end
					end
					bitbuf = bit32.bor(bit32.lshift(bitbuf, 8), b)
					bitcnt += 8
				end
			end
			local function bits(n: number): number
				if bitcnt < n then fill() end
				bitcnt -= n
				return bit32.band(bit32.rshift(bitbuf, bitcnt), bit32.lshift(1, n) - 1)
			end
			local function huff(h: Huff): number
				if bitcnt < 16 then fill() end
				local look = bit32.band(bit32.rshift(bitbuf, bitcnt - LUTBITS), bit32.lshift(1, LUTBITS) - 1)
				local e = h.lut[look + 1]
				if e ~= 0 then
					bitcnt -= e // 256
					return e % 256
				end
				-- code plus long que 9 bits
				local code = 0
				for l = 1, 16 do
					code = code * 2 + bits(1)
					if h.maxcode[l] >= 0 and code <= h.maxcode[l] and code >= h.mincode[l] then
						return h.vals[h.valptr[l] + code - h.mincode[l] + 1]
					end
				end
				error("JPEG : code de Huffman invalide")
			end
			local function extend(v: number, s: number): number
				if v < bit32.lshift(1, s - 1) then return v - bit32.lshift(1, s) + 1 end
				return v
			end
			local blk = table.create(64, 0)
			local function block(c: Comp, bx: number, by: number)
				for k = 1, 64 do blk[k] = 0 end
				local q = qt[c.tq]
				local t = huff(hdc[c.td])
				local diff = if t == 0 then 0 else extend(bits(t), t)
				c.pred += diff
				blk[1] = c.pred * q[1]
				local ac = hac[c.ta]
				local k = 1
				while k < 64 do
					local rs = huff(ac)
					local r, s = bit32.rshift(rs, 4), bit32.band(rs, 15)
					if s == 0 then
						if r == 15 then k += 16 else break end
					else
						k += r
						if k > 63 then break end
						blk[ZZ[k + 1] + 1] = extend(bits(s), s) * q[k + 1]
						k += 1
					end
				end
				idct(blk, c.plane, c.stride, bx * 8, by * 8)
			end
			local function resync()
				-- marqueur de reprise RSTn : on vide les bits, on saute le marqueur, les prédictions repartent de 0
				bitbuf, bitcnt = 0, 0
				while pos + 1 < stop and not (buffer.readu8(data, pos) == 0xFF and buffer.readu8(data, pos + 1) >= 0xD0 and buffer.readu8(data, pos + 1) <= 0xD7) do pos += 1 end
				pos += 2
				for _, c in ipairs(scomp) do c.pred = 0 end
			end
			local n = 0
			if #scomp == 1 then
				-- une seule composante : blocs non entrelacés, juste ce qu'il faut pour couvrir l'image
				local c = scomp[1]
				local cw = (W * c.h + hmax - 1) // hmax
				local ch = (H * c.v + vmax - 1) // vmax
				for by = 0, (ch + 7) // 8 - 1 do
					for bx = 0, (cw + 7) // 8 - 1 do
						if restart > 0 and n > 0 and n % restart == 0 then resync() end
						block(c, bx, by); n += 1
					end
				end
			else
				for y = 0, my - 1 do
					for x = 0, mx - 1 do
						if restart > 0 and n > 0 and n % restart == 0 then resync() end
						for _, c in ipairs(scomp) do
							for v = 0, c.v - 1 do
								for u = 0, c.h - 1 do block(c, x * c.h + u, y * c.v + v) end
							end
						end
						n += 1
					end
				end
			end
			-- fin du balayage : prochain marqueur
			while pos + 1 < stop and not (buffer.readu8(data, pos) == 0xFF and buffer.readu8(data, pos + 1) ~= 0 and
				not (buffer.readu8(data, pos + 1) >= 0xD0 and buffer.readu8(data, pos + 1) <= 0xD7)) do pos += 1 end
			scanned += #scomp
			if scanned >= #comps then done = true end
		else
			pos = segEnd                                     -- APPn, COM… : ignorés
		end
		if not done and pos < segEnd then pos = segEnd end
	end
	if W == 0 or #comps == 0 then error("JPEG : image vide") end

	-- conversion en RGBA (couleurs : YCbCr -> RGB, chrominance agrandie)
	local out = buffer.create(W * H * 4)
	if #comps == 1 then
		local c = comps[1]
		for y = 0, H - 1 do
			local row = y * c.stride
			local o = y * W * 4
			for x = 0, W - 1 do
				local l = buffer.readu8(c.plane, row + x)
				buffer.writeu32(out, o + x * 4, 0xFF000000 + l * 0x10101)
			end
		end
	else
		local cy = comps[1]
		-- chrominance à pleine taille : interpolation bilinéaire centrée (comme le « fancy upsampling » de libjpeg),
		-- sinon les cartes de normales gardent des marches de 2 pixels le long des arêtes
		local function full(c: Comp): (buffer, number)
			local sx, sy = hmax // c.h, vmax // c.v
			if sx == 1 and sy == 1 then return c.plane, c.stride end
			local cw, ch = (W + sx - 1) // sx, (H + sy - 1) // sy
			local o = buffer.create(W * H)
			local xa, xb, xf = table.create(W, 0), table.create(W, 0), table.create(W, 0)
			for x = 0, W - 1 do
				local f = (x + 0.5) / sx - 0.5
				local i = math.floor(f)
				xf[x + 1] = f - i
				xa[x + 1] = math.clamp(i, 0, cw - 1); xb[x + 1] = math.clamp(i + 1, 0, cw - 1)
			end
			for y = 0, H - 1 do
				local f = (y + 0.5) / sy - 0.5
				local i = math.floor(f)
				local fy = f - i
				local r0 = math.clamp(i, 0, ch - 1) * c.stride
				local r1 = math.clamp(i + 1, 0, ch - 1) * c.stride
				local ro = y * W
				for x = 1, W do
					local a, b = xa[x], xb[x]
					local fx = xf[x]
					local t = buffer.readu8(c.plane, r0 + a); t += (buffer.readu8(c.plane, r0 + b) - t) * fx
					local u = buffer.readu8(c.plane, r1 + a); u += (buffer.readu8(c.plane, r1 + b) - u) * fx
					buffer.writeu8(o, ro + x - 1, t + (u - t) * fy + 0.5)
				end
			end
			return o, W
		end
		local pb, sb = full(comps[2])
		local pr, sr = full(comps[3])
		for y = 0, H - 1 do
			local ry = y * cy.stride
			local rb = y * sb
			local rr = y * sr
			local o = y * W * 4
			for x = 0, W - 1 do
				local Y = buffer.readu8(cy.plane, ry + x)
				local B = buffer.readu8(pb, rb + x) - 128
				local R = buffer.readu8(pr, rr + x) - 128
				local r = Y + 1.402 * R + 0.5
				local g = Y - 0.344136 * B - 0.714136 * R + 0.5
				local b = Y + 1.772 * B + 0.5
				r = if r < 0 then 0 elseif r > 255 then 255 else r // 1
				g = if g < 0 then 0 elseif g > 255 then 255 else g // 1
				b = if b < 0 then 0 elseif b > 255 then 255 else b // 1
				buffer.writeu32(out, o + x * 4, 0xFF000000 + b * 65536 + g * 256 + r)
			end
		end
	end
	return W, H, out
end

return decode
]]></string>
