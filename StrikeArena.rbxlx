	{ id = "camo_prism", camo = "prism", name = "Camo animé Prisme", robux = 449, productId = 0, anim = { scroll = 0.8, pulse = 0, colors = { "#ff3b3b", "#3bff8a", "#3b7bff" } } },
	{ id = "camo_storm", camo = "storm", name = "Camo animé Tempête électrique", robux = 349, productId = 0, anim = { scroll = 0, pulse = 9, colors = { "#0a0f1a", "#3caaff", "#c8f2ff" } } },
	{ id = "camo_bundle", camos = { "plasma", "magma", "code", "nebula", "prism", "storm" }, name = "Collection des 6 camos animés", robux = 1299, productId = 0 },
}

return X
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">CrateOpening</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/CrateOpening (ModuleScript, côté client)
-- Animation 3D d'ouverture de caisse du jeu web (src/8V_crate.js), dans un ViewportFrame :
--   1) 0 – 0,9 s : la caisse tombe en tournant, se pose (écrasement, anneau de poussière, secousse) ;
--   2) 1,1 – 2,9 s : suspense — les deux loquets sautent (1,5 s et 2,1 s, voyant rouge -> vert), la caisse tremble de
--      plus en plus, le couvercle se soulève par à-coups, la lumière fuit par les joints et monte de couleur jusqu'à la
--      rareté obtenue, la caméra s'approche ;
--   3) 2,9 s : ouverture — le couvercle s'ouvre sur ses charnières (ou part en l'air dès Légendaire, avec un ralenti),
--      étincelles, onde de choc, faisceau (Rare et +), rayons tournants et tourbillon (Épique et +), pluie de pièces
--      (Légendaire), l'objet sort et flotte au-dessus d'un socle holographique ; le texte arrive à +0,95 s.
-- Utilisation : CrateOpening.play(parent?, res, boxId, onDone?) où res est la réponse d'OpenBox
-- ({ rarity, item = { kind, weapon, skin, outfit, dance }, duplicate, coins }). parent = nil : l'écran a son propre
-- ScreenGui (au-dessus du menu). Renvoie une fonction qui ferme l'écran.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")

local Config = require(ReplicatedStorage.Shared.Config)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local CrateOpening = {}

local BOX_ACCENT = { std = Color3.fromHex("#4aa3ff"), prem = Color3.fromHex("#ffb938") }
local TAU = math.pi * 2

local function rcol(q: number): Color3
	local r = Config.RARITY[math.clamp(q + 1, 1, #Config.RARITY)]
	return r.color
end
local function smooth(x: number): number x = math.clamp(x, 0, 1); return x * x * (3 - 2 * x) end
local function rand(a: number, b: number): number return a + math.random() * (b - a) end
local function snd(id: string, pitch: number, vol: number)
	pcall(function() Sfx.play({ id = id, volume = vol, pitch = pitch }) end)
end

function CrateOpening.itemName(res: any): string
	local it = res.item or {}
	if it.kind == "skin" then
		return (Config.SKINS[it.skin] and Config.SKINS[it.skin].name or "Skin") .. " · " .. (Config.WEAPONS[it.weapon] and Config.WEAPONS[it.weapon].name or "")
	elseif it.kind == "dance" then return "Danse " .. (Config.DANCES[it.dance] and Config.DANCES[it.dance].name or "")
	elseif it.kind == "outfit" then return "Tenue " .. (Config.OUTFITS[it.outfit] and Config.OUTFITS[it.outfit].name or "") end
	return "+" .. tostring(res.coins or 0) .. " pièces"
end

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end

-- pièce de décor : position locale dans son groupe (off), redessinée chaque image
type Piece = { p: Part, off: CFrame }
local function piece(list: { Piece }, parent: Instance, size: Vector3, off: CFrame, color: Color3, mat: Enum.Material?, shape: Enum.PartType?, transp: number?): Part
	local p = Instance.new("Part")
	p.Size = size; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic; p.Transparency = transp or 0
	if shape then p.Shape = shape end
	p.Anchored = true; p.CanCollide = false; p.CastShadow = false; p.CFrame = off
	p.Parent = parent
	table.insert(list, { p = p, off = off })
	return p
end
local function draw(list: { Piece }, base: CFrame)
	for _, e in ipairs(list) do e.p.CFrame = base * e.off end
end
local UPCYL = CFrame.Angles(0, 0, math.pi / 2)   -- cylindre Roblox couché sur X : redressé sur Y

function CrateOpening.play(parent: Instance?, res: any, boxId: string?, onDone: (() -> ())?): () -> ()
	local own: ScreenGui? = nil
	if not parent then
		local sg = Instance.new("ScreenGui"); sg.Name = "CrateOpening"; sg.IgnoreGuiInset = true; sg.ResetOnSpawn = false; sg.DisplayOrder = 80
		sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
		sg.Parent = Players.LocalPlayer:WaitForChild("PlayerGui")
		own = sg
	end
	local q = math.clamp((res.rarity or 1) - 1, 0, 4)
	local col = rcol(q)
	local acc = BOX_ACCENT[boxId or "std"] or BOX_ACCENT.std
	local prem = boxId == "prem"

	-- ---------- écran ----------
	local veil = make("TextButton", { Name = "CrateOpening", Text = "", AutoButtonColor = false, Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(7, 11, 20),
		BackgroundTransparency = 0.08, ZIndex = 95, Modal = true }, parent or own)
	local vf = make("ViewportFrame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.44), Size = UDim2.fromScale(0.9, 0.78), BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(70, 80, 100), LightColor = Color3.fromRGB(220, 230, 255), LightDirection = Vector3.new(-0.4, -1, -0.6), ZIndex = 96 }, veil)
	make("UIAspectRatioConstraint", { AspectRatio = 1.6 }, vf)
	local cam = make("Camera", { FieldOfView = 42 }, vf)
	vf.CurrentCamera = cam
	local world = make("WorldModel", {}, vf)
	local flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = col, BackgroundTransparency = 1, ZIndex = 97 }, veil)
	local rar = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.8), Size = UDim2.new(0.9, 0, 0, 22), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack, TextSize = 16, TextColor3 = acc, Text = "OUVERTURE…", ZIndex = 98 }, veil)
	local title = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.8, 24), Size = UDim2.new(0.9, 0, 0, 34), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack, TextSize = 28, TextColor3 = col, Text = "", ZIndex = 98, TextTransparency = 1 }, veil)
	local sub = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.8, 62), Size = UDim2.new(0.9, 0, 0, 20), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.fromRGB(141, 160, 189), Text = "", ZIndex = 98, TextTransparency = 1, RichText = true }, veil)
	local hint = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -14), Size = UDim2.new(0.9, 0, 0, 16), BackgroundTransparency = 1,
		Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = Color3.fromRGB(141, 160, 189), Text = "", ZIndex = 98 }, veil)

	-- ---------- décor : sol, socle hexagonal, liseré, halo ----------
	local env: { Piece } = {}
	piece(env, world, Vector3.new(0.05, 9.2, 9.2), CFrame.new(0, 0, 0) * UPCYL, Color3.fromRGB(13, 20, 36), Enum.Material.Metal, Enum.PartType.Cylinder, 0.2)
	piece(env, world, Vector3.new(0.16, 3.7, 3.7), CFrame.new(0, 0.08, 0) * UPCYL, Color3.fromRGB(26, 34, 54), Enum.Material.Metal, Enum.PartType.Cylinder)
	piece(env, world, Vector3.new(0.1, 3.0, 3.0), CFrame.new(0, 0.21, 0) * UPCYL, Color3.fromRGB(26, 34, 54), Enum.Material.Metal, Enum.PartType.Cylinder)
	local rim = piece(env, world, Vector3.new(0.03, 3.3, 3.3), CFrame.new(0, 0.165, 0) * UPCYL, acc, Enum.Material.Neon, Enum.PartType.Cylinder)
	local halo = piece(env, world, Vector3.new(5.5, 5.5, 0.05), CFrame.new(0, 1.6, -2.5), acc, Enum.Material.Neon, Enum.PartType.Ball, 0.8)
	local motes: { Piece } = {}
	for _ = 1, 40 do piece(motes, world, Vector3.new(0.035, 0.035, 0.035), CFrame.new(rand(-5, 5), rand(0, 4.5), rand(-4, 2)), Color3.fromRGB(159, 200, 255), Enum.Material.Neon, Enum.PartType.Ball, 0.5) end
	draw(env, CFrame.new())

	-- ---------- la caisse ----------
	local W, H, D = 1.7, 0.9, 1.1
	local shell = if prem then Color3.fromRGB(42, 36, 24) else Color3.fromRGB(34, 43, 61)
	local trim = if prem then Color3.fromRGB(224, 176, 64) else Color3.fromRGB(154, 166, 184)
	local dark = Color3.fromRGB(11, 14, 20)
	local body: { Piece } = {}
	piece(body, world, Vector3.new(W, H, D), CFrame.new(0, H / 2, 0), shell, Enum.Material.Metal)
	for _, z in ipairs({ D / 2 + 0.006, -D / 2 - 0.006 }) do
		piece(body, world, Vector3.new(W - 0.24, H - 0.18, 0.012), CFrame.new(0, H / 2, z), Color3.fromRGB(28, 35, 51), Enum.Material.Metal)
		piece(body, world, Vector3.new(W - 0.36, 0.08, 0.016), CFrame.new(0, 0.2, z), acc, Enum.Material.Neon, nil, 0.3)           -- bande d'avertissement
		piece(body, world, Vector3.new(0.2, 0.2, 0.016), CFrame.new(0, H * 0.55, z) * CFrame.Angles(0, 0, math.rad(45)), acc, Enum.Material.Neon, nil, 0.1)   -- emblème
	end
	piece(body, world, Vector3.new(W + 0.04, 0.08, D + 0.04), CFrame.new(0, 0.06, 0), trim, Enum.Material.Metal)
	piece(body, world, Vector3.new(W + 0.04, 0.06, D + 0.04), CFrame.new(0, H - 0.03, 0), trim, Enum.Material.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do
			piece(body, world, Vector3.new(0.2, 0.2, 0.2), CFrame.new(sx * (W / 2 - 0.06), 0.1, sz * (D / 2 - 0.06)), trim, Enum.Material.Metal)
			piece(body, world, Vector3.new(0.2, 0.16, 0.2), CFrame.new(sx * (W / 2 - 0.06), H - 0.08, sz * (D / 2 - 0.06)), trim, Enum.Material.Metal)
		end
		piece(body, world, Vector3.new(0.05, 0.08, 0.34), CFrame.new(sx * (W / 2 + 0.02), H * 0.62, 0), dark, Enum.Material.Metal)   -- poignées
	end
	local seam = piece(body, world, Vector3.new(W - 0.02, 0.035, D - 0.02), CFrame.new(0, H + 0.005, 0), acc, Enum.Material.Neon, nil, 1)
	local inner = piece(body, world, Vector3.new(W - 0.16, 0.01, D - 0.16), CFrame.new(0, H - 0.04, 0), acc, Enum.Material.Neon, nil, 1)
	-- loquets : socle, levier (pivote), voyant
	type Latch = { lever: { Piece }, led: Part, at: CFrame, open: number, popped: boolean }
	local latches: { Latch } = {}
	for _, sx in ipairs({ -0.42, 0.42 }) do
		local at = CFrame.new(sx, H - 0.02, D / 2 + 0.03)
		piece(body, world, Vector3.new(0.16, 0.1, 0.05), at * CFrame.new(0, -0.02, 0), trim, Enum.Material.Metal)
		local led = piece(body, world, Vector3.new(0.044, 0.044, 0.044), at * CFrame.new(0, 0.04, 0.03), Color3.fromRGB(255, 51, 68), Enum.Material.Neon, Enum.PartType.Ball)
		local lever: { Piece } = {}
		piece(lever, world, Vector3.new(0.12, 0.2, 0.035), CFrame.new(0, -0.1, 0.02), dark, Enum.Material.Metal)
		piece(lever, world, Vector3.new(0.13, 0.04, 0.04), CFrame.new(0, -0.19, 0.03), trim, Enum.Material.Metal)
		table.insert(latches, { lever = lever, led = led, at = at, open = 0, popped = false })
	end
	-- fuites de lumière autour du joint
	local leaks: { Piece } = {}
	for i = 0, 9 do
		local a = i / 10 * TAU
		piece(leaks, world, Vector3.new(0.06, 1.6, 0.01), CFrame.new(math.cos(a) * 0.75, 0.3, math.sin(a) * 0.5) * CFrame.Angles(0, -a, math.cos(a) * 0.6), acc, Enum.Material.Neon, nil, 1)
	end
	-- couvercle sur charnières : pivot sur l'arête arrière
	local lid: { Piece } = {}
	piece(lid, world, Vector3.new(W + 0.02, 0.2, D + 0.02), CFrame.new(0, 0.1, D / 2), shell, Enum.Material.Metal)
	piece(lid, world, Vector3.new(W - 0.3, 0.06, D - 0.3), CFrame.new(0, 0.22, D / 2), shell, Enum.Material.Metal)
	piece(lid, world, Vector3.new(W + 0.06, 0.05, D + 0.06), CFrame.new(0, 0.02, D / 2), trim, Enum.Material.Metal)
	for _, sx in ipairs({ -1, 1 }) do
		for _, sz in ipairs({ -1, 1 }) do piece(lid, world, Vector3.new(0.2, 0.16, 0.2), CFrame.new(sx * (W / 2 - 0.06), 0.11, D / 2 + sz * (D / 2 - 0.06)), trim, Enum.Material.Metal) end
		piece(lid, world, Vector3.new(0.22, 0.1, 0.1), CFrame.new(sx * 0.55, 0.02, -0.02), trim, Enum.Material.Metal)   -- charnières
	end
	local emb = piece(lid, world, Vector3.new(0.012, 0.4, 0.4), CFrame.new(0, 0.256, D / 2) * UPCYL, acc, Enum.Material.Neon, Enum.PartType.Cylinder)

	-- ---------- état ----------
	local T = 0
	local hit, burst, shown = false, false, false
	local sq, pulse, shake = -1, 0, 0
	local crateY, crateRY, crateRX, crateRZ, lidRX = 6.5, -2.6, 0, 0, 0
	local scaleY, scaleXZ = 1, 1
	local dust: BasePart? = nil
	local lidFree: { cf: CFrame, v: Vector3, w: Vector3 }? = nil
	local sparks: { { p: Part, v: Vector3 } } = {}
	local beam: BasePart? = nil
	local rays: { Piece } = {}
	local swirl: { { p: Part, a: number, r: number, tilt: number } } = {}
	local wave: BasePart? = nil
	local coins: { { p: Part, v: Vector3, w: Vector3 } } = {}
	local glow: BasePart? = nil
	local holo: { BasePart } = {}
	local item: Model? = nil
	local itemBase = 1
	local done = false


	local function buildItem(): Model
		local it = res.item or {}
		local m: Model? = nil
		if it.kind == "skin" and it.weapon then
			pcall(function()
				local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels) :: any
				local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint) :: any
				local w = WeaponModels.build(it.weapon, 1)
				pcall(SkinPaint.apply, w, it.skin, nil)
				for _, d in ipairs(w:GetDescendants()) do if d:IsA("BasePart") then d.Anchored = true end end
				m = w
			end)
		end
		if not m then
			local g = Instance.new("Model")
			if it.kind == "coins" or not it.kind then
				for i = 0, 4 do
					local c = Instance.new("Part"); c.Shape = Enum.PartType.Cylinder; c.Material = Enum.Material.Metal; c.Color = Color3.fromRGB(242, 185, 40)
					c.Size = if i == 0 then Vector3.new(0.13, 0.84, 0.84) else Vector3.new(0.08, 0.48, 0.48); c.Anchored = true
					c.CFrame = if i == 0 then CFrame.Angles(0, math.pi / 2, 0) else CFrame.new(math.cos(i * 1.7) * 0.62, math.sin(i * 2.3) * 0.25 - 0.1, math.sin(i * 1.7) * 0.3 - 0.1) * CFrame.Angles(rand(-0.5, 0.5), math.pi / 2 + rand(-0.6, 0.6), 0)
					c.Parent = g
				end
			else
				local gem = Instance.new("Part"); gem.Material = Enum.Material.Neon; gem.Color = col; gem.Size = Vector3.new(0.7, 0.7, 0.7); gem.Anchored = true
				gem.CFrame = CFrame.Angles(math.rad(45), 0, math.rad(45)); gem.Parent = g
				local core = Instance.new("Part"); core.Material = Enum.Material.Glass; core.Transparency = 0.5; core.Color = Color3.new(1, 1, 1); core.Size = Vector3.new(0.95, 0.95, 0.95)
				core.Anchored = true; core.Shape = Enum.PartType.Ball; core.Parent = g
			end
			m = g
		end
		local model = m :: Model
		local ext = model:GetExtentsSize()
		itemBase = 1.6 / math.max(ext.X, ext.Y, ext.Z, 0.1)
		model.Parent = world
		return model
	end

	local function doBurst()
		burst = true
		crateRX, crateRZ, crateY = 0, 0, 0
		snd(if q >= 2 then "rbxasset://sounds/victory.wav" else "rbxasset://sounds/clickfast.wav", if q >= 2 then 1.1 else 0.6, 0.6)
		snd("rbxasset://sounds/Rocket shot.wav", 1.5, if q >= 3 then 0.6 else 0.25)
		if q >= 3 then lidFree = { cf = CFrame.new(0, H, -D / 2), v = Vector3.new(rand(-0.6, 0.6), 6.5, -2.5), w = Vector3.new(rand(-5, -3), rand(-2, 2), rand(-2, 2)) } end
		for _ = 1, math.min(140, 30 + q * 30) do
			local p = Instance.new("Part"); p.Shape = Enum.PartType.Ball; p.Material = Enum.Material.Neon; p.Color = col; p.Anchored = true; p.CanCollide = false
			local s = 0.06 + q * 0.015; p.Size = Vector3.new(s, s, s); p.Position = Vector3.new(rand(-0.5, 0.5), 1, rand(-0.3, 0.3)); p.Parent = world
			local a, sp = rand(0, TAU), rand(1, 2.5 + q)
			table.insert(sparks, { p = p, v = Vector3.new(math.cos(a) * sp, rand(2, 5 + q), math.sin(a) * sp * 0.6) })
		end
		if q >= 1 then
			local b = Instance.new("Part"); b.Shape = Enum.PartType.Cylinder; b.Material = Enum.Material.Neon; b.Color = col; b.Anchored = true; b.Transparency = 1
			b.Size = Vector3.new(14, 1.2 + q * 0.25, 1.2 + q * 0.25); b.CFrame = CFrame.new(0, 7, 0) * UPCYL; b.Parent = world; beam = b
		end
		if q >= 2 then
			local nr = if q >= 3 then 16 else 10
			for i = 0, nr - 1 do piece(rays, world, Vector3.new(0.5 + math.random() * 0.5, 10, 0.01), CFrame.Angles(0, 0, i / nr * math.pi + rand(-0.05, 0.05)), col, Enum.Material.Neon, nil, 1) end
			for i = 0, 2 do
				for j = 0, 15 do
					local p = Instance.new("Part"); p.Shape = Enum.PartType.Ball; p.Material = Enum.Material.Neon; p.Color = col; p.Anchored = true; p.Size = Vector3.new(0.05, 0.05, 0.05)
					p.Parent = world
					table.insert(swirl, { p = p, a = j / 16 * TAU, r = 0.7 + i * 0.18, tilt = rand(-0.5, 0.5) + i * 0.4 })
				end
			end
		end
		local w = Instance.new("Part"); w.Shape = Enum.PartType.Cylinder; w.Material = Enum.Material.Neon; w.Color = col; w.Anchored = true; w.Transparency = 0.1
		w.Size = Vector3.new(0.02, 2, 2); w.CFrame = CFrame.new(0, 0.3, 0) * UPCYL; w.Parent = world; wave = w
		local g = Instance.new("Part"); g.Shape = Enum.PartType.Ball; g.Material = Enum.Material.Neon; g.Color = col; g.Anchored = true; g.Transparency = 1
		g.Size = Vector3.new(3.2, 3.2, 0.05); g.CFrame = CFrame.new(0, 2.3, -0.4); g.Parent = world; glow = g
		for i = 0, 1 do
			local r = Instance.new("Part"); r.Shape = Enum.PartType.Cylinder; r.Material = Enum.Material.Neon; r.Color = col; r.Anchored = true; r.Transparency = 1
			r.Size = Vector3.new(0.01, 1.2 + i * 0.28, 1.2 + i * 0.28); r.Parent = world
			table.insert(holo, r)
		end
		local it = res.item or {}
		if q >= 3 or (it.kind == "coins" and (res.coins or 0) >= 300) then
			for _ = 1, if q >= 3 then 40 else 18 do
				local c = Instance.new("Part"); c.Shape = Enum.PartType.Cylinder; c.Material = Enum.Material.Metal; c.Color = Color3.fromRGB(242, 185, 40); c.Anchored = true
				c.Size = Vector3.new(0.02, 0.14, 0.14); c.Position = Vector3.new(rand(-2.5, 2.5), rand(4, 9), rand(-1.5, 1)); c.Parent = world
				table.insert(coins, { p = c, v = Vector3.new(0, -rand(1, 3), 0), w = Vector3.new(rand(-8, 8), rand(-8, 8), rand(-8, 8)) })
			end
		end
		item = buildItem()
		inner.Color = col; inner.Transparency = 0.1; seam.Color = col
		flash.BackgroundColor3 = col
		flash.BackgroundTransparency = 1 - (if q >= 3 then 0.85 elseif q >= 2 then 0.6 elseif q >= 1 then 0.4 else 0.2)
		vf.Ambient = col:Lerp(Color3.fromRGB(70, 80, 100), 0.5)
		shake = if q >= 3 then 0.5 elseif q >= 2 then 0.25 else 0.1
	end

	local conn: RBXScriptConnection? = nil
	local function close()
		if done then return end
		done = true
		if conn then conn:Disconnect() end
		veil:Destroy()
		if own then own:Destroy() end
		if onDone then task.spawn(onDone) end
	end
	veil.Activated:Connect(function() if shown then close() end end)

	snd("rbxasset://sounds/swoosh.wav", 1.1, 0.4)
	conn = RunService.RenderStepped:Connect(function(rdt: number)
		local dt = math.min(0.05, rdt)
		if burst and q >= 3 and T - 2.9 < 0.5 then dt *= 0.45 end   -- petit ralenti pour un légendaire
		T += dt
		shake = math.max(0, shake - dt * 1.5)
		flash.BackgroundTransparency = math.min(1, flash.BackgroundTransparency + dt * 1.6)
		-- 1) chute
		if T < 0.9 then
			local k = T / 0.9
			crateY = 6.5 * (1 - k * k); crateRY = -2.6 + smooth(k) * 2.25
		elseif not hit then
			hit = true; crateY = 0; crateRY = -0.35; shake = 0.35
			snd("rbxasset://sounds/Rocket shot.wav", 0.5, 0.15); snd("rbxasset://sounds/clickfast.wav", 0.5, 0.5)
			local d = Instance.new("Part"); d.Shape = Enum.PartType.Cylinder; d.Material = Enum.Material.SmoothPlastic; d.Color = Color3.fromRGB(200, 190, 170)
			d.Anchored = true; d.Transparency = 0.4; d.Size = Vector3.new(0.01, 2.4, 2.4); d.CFrame = CFrame.new(0, 0.28, 0) * UPCYL; d.Parent = world; dust = d
		end
		if T >= 0.9 and T < 1.3 then
			local k = (T - 0.9) / 0.4
			scaleXZ = 1 + math.sin(k * math.pi) * 0.06 * (1 - k); scaleY = 1 - math.sin(k * math.pi) * 0.1 * (1 - k)
		else scaleXZ, scaleY = 1, 1 end
		if dust then
			local k = (T - 0.9) / 1.2
			local s = 2.4 * (1 + k * 2.5)
			dust.Size = Vector3.new(0.01, s, s); dust.Transparency = math.min(1, 0.4 + k * 0.6)
		end
		-- 2) suspense
		if T >= 1.1 and T < 2.9 then
			local k = (T - 1.1) / 1.8
			local s2 = math.min(q, math.floor(k * k * (q + 1.3)))
			local sc = rcol(s2)
			if s2 ~= sq then sq = s2; pulse = 1; snd("rbxasset://sounds/clickfast.wav", 1.4 + s2 * 0.2, 0.45) end
			pulse = math.max(0, pulse - dt * 3)
			for i, L in ipairs(latches) do
				local at = 1.5 + (i - 1) * 0.6
				if T >= at and not L.popped then L.popped = true; L.led.Color = Color3.fromRGB(61, 255, 122); shake = math.max(shake, 0.12); snd("rbxasset://sounds/clickfast.wav", 1, 0.7) end
				if L.popped then L.open = math.min(1, L.open + dt * 9) end
			end
			local sh = k * k
			crateY = math.abs(math.sin(T * (9 + k * 20))) * 0.05 * sh
			crateRZ = math.sin(T * (21 + k * 30)) * 0.05 * sh
			crateRX = math.cos(T * (17 + k * 25)) * 0.035 * sh
			lidRX = -math.max(0, math.sin(T * (14 + k * 22))) * 0.05 * sh
			seam.Transparency = 1 - (0.15 + k * 0.85); seam.Color = sc
			for _, e in ipairs(leaks) do e.p.Transparency = 1 - math.min(1, k * k * 0.5 + pulse * 0.3); e.p.Color = sc end
			emb.Color = sc; rim.Color = sc; halo.Color = sc; halo.Transparency = 1 - (0.25 + k * 0.35)
			vf.Ambient = Color3.fromRGB(70, 80, 100):Lerp(sc, math.min(1, k * 0.35 + pulse * 0.4))
			if math.random() < k * 0.35 * dt * 60 * 0.1 then snd("rbxasset://sounds/clickfast.wav", 2, 0.2) end
		end
		-- 3) ouverture
		if T >= 2.9 and not burst then doBurst() end
		local crateCF = CFrame.new(0, crateY, 0) * CFrame.Angles(0, crateRY, 0) * CFrame.Angles(crateRX, 0, crateRZ)
		if burst then
			local k = T - 2.9
			if lidFree then
				local lf = lidFree :: { cf: CFrame, v: Vector3, w: Vector3 }
				lf.v -= Vector3.new(0, 12 * dt, 0)
				lf.cf = (lf.cf + lf.v * dt) * CFrame.Angles(lf.w.X * dt, lf.w.Y * dt, lf.w.Z * dt)
			else
				local a = math.min(1, k / 0.45)
				local ov = if a < 1 then smooth(a) * 1.18 else 1.18 - math.sin(math.min(1, (k - 0.45) / 0.5) * math.pi) * 0.08 * math.exp(-(k - 0.45) * 3)
				lidRX = -ov * 1.62
			end
			for _, e in ipairs(leaks) do e.p.Transparency = math.min(1, e.p.Transparency + dt * 1.5) end
			seam.Transparency = 1 - math.max(0, 0.9 - k * 2)
			inner.Transparency = 1 - math.max(0.35, 0.9 - k * 0.4)
			for _, s in ipairs(sparks) do
				s.v = (s.v - Vector3.new(0, 6 * dt, 0)) * (1 - dt * 0.6)
				s.p.Position += s.v * dt
				s.p.Transparency = math.min(1, k / 2.4)
			end
			if beam then beam.Transparency = 1 - math.min(0.55, k * 3) * math.max(0.25, 1 - k * 0.3) * (0.6 + q * 0.15) end
			if #rays > 0 then
				local rot = T * (if q >= 3 then 0.6 else 0.35)
				local sc = math.min(1, k * 1.8)
				for _, e in ipairs(rays) do
					e.p.Transparency = 1 - math.min(0.32 + q * 0.05, k * 1.2)
					e.p.Size = Vector3.new(e.p.Size.X, 10 * math.max(0.05, sc), 0.01)
				end
				draw(rays, CFrame.new(0, 2.3, -1.2) * CFrame.Angles(0, 0, rot))
			end
			for _, s in ipairs(swirl) do
				s.a += dt * 2.2
				local sc = math.min(1, k * 1.5)
				local pos = CFrame.new(0, 2.3, 0) * CFrame.Angles(s.tilt, 0, s.tilt * 0.5) * CFrame.new(math.cos(s.a) * s.r * sc, 0, math.sin(s.a) * s.r * sc)
				s.p.CFrame = pos
				s.p.Transparency = 1 - math.min(0.7, k) * (0.6 + 0.4 * math.sin(T * 3 + s.r * 9))
			end
			if wave then
				local sk = math.min(1, k / 0.9)
				local s = 2 * (1 + sk * (5 + q * 1.5))
				wave.Size = Vector3.new(0.02, s, s); wave.Transparency = math.min(1, 0.1 + sk)
			end
			if glow then glow.Transparency = 1 - math.min(0.42, k) * (0.85 + 0.15 * math.sin(T * 3)) end
			for _, c in ipairs(coins) do
				c.v -= Vector3.new(0, 6 * dt, 0)
				local p = c.p.Position + c.v * dt
				if p.Y < 0.32 then p = Vector3.new(p.X, 0.32, p.Z); c.v = Vector3.new(c.v.X, math.abs(c.v.Y) * 0.3, c.v.Z); c.w *= 0.7 end
				c.p.CFrame = CFrame.new(p) * c.p.CFrame.Rotation * CFrame.Angles(c.w.X * dt, 0, c.w.Z * dt)
			end
			local ik = smooth(math.min(1, k / 0.9))
			if item then
				local mdl = item :: Model
				pcall(function() mdl:ScaleTo(math.max(0.01, itemBase * (0.01 + ik * 0.99))) end)
				mdl:PivotTo(CFrame.new(0, 1.0 + ik * 1.3 + math.sin(T * 2) * 0.05, 0) * CFrame.Angles(0, T * 1.1, 0))
			end
			for i, r in ipairs(holo) do
				r.CFrame = CFrame.new(0, 1.0 + ik * 0.45, 0) * CFrame.Angles(0, T, 0) * UPCYL
				r.Transparency = 1 - ik * 0.55 * (1 + math.sin(T * 3 + i) * 0.04)
			end
			rim.Transparency = 0.45 - 0.25 * math.sin(T * 4)
			if k > 0.95 and not shown then
				shown = true
				rar.Text = string.upper(Config.RARITY[q + 1].name); rar.TextColor3 = col
				title.Text = CrateOpening.itemName(res); title.TextTransparency = 0
				sub.Text = if res.duplicate then "Doublon — converti en <b>" .. tostring(res.coins) .. " pièces</b>"
					elseif (res.item or {}).kind == "coins" then "Pièces ajoutées à ton solde" else "<b>NOUVEAU !</b> Ajouté à ta collection"
				sub.TextTransparency = 0
				hint.Text = "Clique pour continuer"
			end
		end
		-- dessin de la caisse
		local bcf = crateCF * CFrame.new(0, 0, 0)
		for _, e in ipairs(body) do
			local o = e.off
			e.p.CFrame = bcf * CFrame.new(o.Position.X * scaleXZ, o.Position.Y * scaleY, o.Position.Z * scaleXZ) * o.Rotation
		end
		for _, L in ipairs(latches) do draw(L.lever, bcf * CFrame.new(L.at.Position.X * scaleXZ, L.at.Position.Y * scaleY, L.at.Position.Z * scaleXZ) * CFrame.Angles(L.open * 1.3, 0, 0)) end
		draw(leaks, bcf * CFrame.new(0, H * scaleY, 0) * CFrame.Angles(0, T * 0.8, 0))
		if lidFree then draw(lid, crateCF * (lidFree :: any).cf)
		else draw(lid, bcf * CFrame.new(0, H * scaleY, -D / 2 * scaleXZ) * CFrame.Angles(lidRX, 0, 0)) end
		-- poussières qui montent
		for _, e in ipairs(motes) do
			local p = e.p.Position
			e.p.Position = Vector3.new(p.X, if p.Y > 4.5 then 0 else p.Y + dt * 0.12, p.Z)
		end
		-- caméra : s'approche pendant le suspense, recule à l'ouverture, tremble aux chocs
		local cz, cy = 6.4, 2.0
		if T > 1.1 and T < 2.9 then cz -= smooth((T - 1.1) / 1.8) * 0.9 end
		if burst then local k = T - 2.9; cz = 5.5 + smooth(math.min(1, k / 0.6)) * 0.9; cy = 2.0 + smooth(math.min(1, k / 0.8)) * 0.35 end
		local shk = shake * shake
		local pos = Vector3.new(math.sin(T * 0.45) * 0.5 + rand(-1, 1) * shk * 0.3, cy + math.sin(T * 0.4) * 0.1 + rand(-1, 1) * shk * 0.3, cz)
		cam.CFrame = CFrame.lookAt(pos, Vector3.new(0, if burst then 1.7 else 1.0, 0))
		if T > 12 and shown then close() end
	end)
	return close
end

return CrateOpening
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">Grenades</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Grenades (ModuleScript, client + serveur)
-- Grenades et mines du jeu web (src/60_game.js throwNade/updateNades/explodeNade, src/63_agents.js placeMine),
-- mêmes valeurs : lancer à 15 m/s (+2,5 vers le haut, +40 % de la vitesse du lanceur), gravité 18 m/s²,
-- rebonds (murs −45 %, sol 35 % + frottement 0,72), mèches frag 1,9 s / flash 1,5 s / fumigène 1,3 s.
-- Le serveur simule la grenade qui compte ; chaque client rejoue la même trajectoire pour l'afficher sans saccade.
local Config = require(script.Parent.Config)

local G = {}
local M = Config.STUDS_PER_METER
G.M = M

G.KINDS = {
	frag = { n = "Grenade frag", key = "G", fuse = 1.9, color = Color3.fromRGB(63, 90, 46), short = "G" },
	flash = { n = "Flashbang", key = "F", fuse = 1.5, color = Color3.fromRGB(221, 221, 221), short = "F" },
	smoke = { n = "Fumigène", key = "H", fuse = 1.3, color = Color3.fromRGB(154, 160, 168), short = "H" },
}
G.ORDER = { "frag", "flash", "smoke" }
G.GRAVITY = 18 * M
G.RADIUS = .07 * M
G.FRAG_R = 9                    -- m : 140 × (1 − d/9), 60 % sur soi
G.FLASH_R = 34
G.SMOKE_R = 3.6                 -- m, nuage de 18 s
G.SMOKE_T = 18
G.MINE = { max = 2, arm = 1, trigger = 1.5, dy = 1.6, r = 5, see = 8 }
G.WARN_R = 9.5                  -- alerte grenade : frag à moins de 9,5 m (src/8Zf_confort.js)

-- sons (planche du web, sinon sons fournis avec Roblox)
G.SFX = {
	boom = { sheet = "boom", id = "rbxasset://sounds/Rocket shot.wav", volume = 0.9, pitch = 0.6 },
	bang = { sheet = "bang", id = "rbxasset://sounds/Rocket shot.wav", volume = 0.8, pitch = 1.5 },
	pop = { sheet = "pop", id = "rbxasset://sounds/clickfast.wav", volume = 0.5, pitch = 0.6 },
	smoke = { sheet = "pop", id = "rbxasset://sounds/swoosh.wav", volume = 0.5, pitch = 0.5 },
	click = { sheet = "click", id = "rbxasset://sounds/clickfast.wav", volume = 0.4, pitch = 1.2 },
	throw = { sheet = "draw", id = "rbxasset://sounds/swoosh.wav", volume = 0.4, pitch = 1.1 },
}

-- vitesse de départ (studs/s) ; look = regard (unitaire), carVel = vitesse du lanceur
function G.launch(look: Vector3, carVel: Vector3): Vector3
	local pitch = math.asin(math.clamp(look.Y, -1, 1)) + .16
	local h = Vector3.new(look.X, 0, look.Z)
	h = if h.Magnitude > 1e-4 then h.Unit else Vector3.new(0, 0, -1)
	local d = h * math.cos(pitch) + Vector3.new(0, math.sin(pitch), 0)
	return d * 15 * M + Vector3.new(0, 2.5 * M, 0) + Vector3.new(carVel.X, 0, carVel.Z) * .4
end
-- lancer vers un point (bots) : vitesse horizontale clamp(L × 0,85, 6, 17) m/s, 5 m/s vers le haut
function G.launchAt(from: Vector3, target: Vector3): Vector3
	local d = Vector3.new(target.X - from.X, 0, target.Z - from.Z)
	local L = d.Magnitude / M
	local s = math.clamp(L * .85, 6, 17) * M
	return (if d.Magnitude > 1e-3 then d.Unit else Vector3.new(0, 0, -1)) * s + Vector3.new(0, 5 * M, 0)
end

export type Nade = { id: number, kind: string, p: Vector3, v: Vector3, t: number, owner: Instance?, team: string?, bounced: boolean? }

-- rayon qui ignore les personnages (une grenade traverse les joueurs, comme sur le web)
local function cast(from: Vector3, d: Vector3, params: RaycastParams): RaycastResult?
	for _ = 1, 4 do
		local r = workspace:Raycast(from, d, params)
		if not r then return nil end
		local m = r.Instance:FindFirstAncestorOfClass("Model")
		if (m and m:FindFirstChildOfClass("Humanoid")) or r.Instance:GetAttribute("MineId") ~= nil then params:AddToFilter(r.Instance)
		else return r end
	end
	return nil
end
G.cast = cast

function G.params(exclude: { Instance }): RaycastParams
	local p = RaycastParams.new(); p.FilterType = Enum.RaycastFilterType.Exclude; p.RespectCanCollide = true
	p.FilterDescendantsInstances = exclude
	return p
end

-- un pas de simulation ; renvoie true si la grenade a rebondi (son « clic »)
function G.step(n: Nade, dt: number, params: RaycastParams): boolean
	n.t -= dt
	n.v -= Vector3.new(0, G.GRAVITY * dt, 0)
	local d = n.v * dt
	if d.Magnitude < 1e-5 then return false end
	local r = cast(n.p, d + d.Unit * G.RADIUS, params)
	if not r then n.p += d; return false end
	local nrm = r.Normal
	local loud = false
	if nrm.Y > .6 then                                  -- sol
		loud = n.v.Y < -2 * M
		local vy = math.abs(n.v.Y) * .35
		if vy < 1 * M then vy = 0 end
		n.v = Vector3.new(n.v.X * .72, vy, n.v.Z * .72)
	else                                                -- mur, plafond : la composante vers la paroi repart à −45 %
		local vn = n.v:Dot(nrm)
		if vn < 0 then n.v -= nrm * vn * 1.45 end
		loud = math.abs(vn) > 2 * M
	end
	n.p = r.Position + nrm * G.RADIUS
	return loud
end

-- modèle de la grenade (web : sphère 7 cm pour la frag, cylindre pour flash et fumigène, cuillère métal)
function G.mesh(kind: string): Model
	local m = Instance.new("Model"); m.Name = "Grenade_" .. kind
	local k = G.KINDS[kind] or G.KINDS.frag
	local b = Instance.new("Part"); b.Name = "Body"; b.Color = k.color; b.Material = Enum.Material.Metal
	if kind == "frag" then b.Shape = Enum.PartType.Ball; b.Size = Vector3.one * .14 * M
	else b.Shape = Enum.PartType.Cylinder; b.Size = Vector3.new(.15, .09, .09) * M; b.CFrame = CFrame.Angles(0, 0, math.rad(90)) end
	b.Anchored = true; b.CanCollide = false; b.CanQuery = false; b.CanTouch = false; b.Parent = m
	local l = Instance.new("Part"); l.Name = "Lever"; l.Size = Vector3.new(.015, .05, .015) * M; l.Color = Color3.fromRGB(153, 153, 153)
	l.Material = Enum.Material.Metal; l.Anchored = true; l.CanCollide = false; l.CanQuery = false; l.CanTouch = false
	l.CFrame = CFrame.new(0, .09 * M, 0); l.Parent = m
	m.PrimaryPart = b
	return m
end

-- mine de proximité (mineMesh du web) ; la DEL change de couleur (armée : clignote en rouge)
function G.mineMesh(): Model
	local m = Instance.new("Model"); m.Name = "Mine"
	local function cyl(name: string, r: number, h: number, y: number, col: Color3): Part
		local p = Instance.new("Part"); p.Name = name; p.Shape = Enum.PartType.Cylinder; p.Size = Vector3.new(h, r * 2, r * 2) * M
		p.CFrame = CFrame.new(0, y * M, 0) * CFrame.Angles(0, 0, math.rad(90)); p.Color = col; p.Material = Enum.Material.Metal
		p.Anchored = true; p.CanCollide = false; p.CanTouch = false; p.Parent = m
		return p
	end
	local base = cyl("Base", .22, .08, .04, Color3.fromRGB(58, 64, 51))
	cyl("Top", .095, .04, .1, Color3.fromRGB(34, 38, 31))
	for i = 0, 2 do
		local p = cyl("Pin", .008, .07, .14, Color3.fromRGB(153, 153, 153))
		p.CFrame = CFrame.new(math.cos(i * 2.1) * .05 * M, .14 * M, math.sin(i * 2.1) * .05 * M) * CFrame.Angles(0, 0, math.rad(90))
	end
	local led = Instance.new("Part"); led.Name = "Led"; led.Shape = Enum.PartType.Ball; led.Size = Vector3.one * .056 * M
	led.Material = Enum.Material.Neon; led.Color = Color3.fromRGB(102, 102, 102); led.CFrame = CFrame.new(.13 * M, .09 * M, 0)
	led.Anchored = true; led.CanCollide = false; led.CanTouch = false; led.Parent = m
	m.PrimaryPart = base
	return m
end

return G
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">HandMeshes</string>
          <string name="Source"><![CDATA[-- Généré par tools/hands/export_hands.js (gants modelés de src/55b_hands.js et manches du soldat) : ne pas modifier à la main.
-- par sommet 9 octets : position int16 ×3 (1/10000 m, repère de la main droite), normale int8 ×3 ; puis triangles uint16 ×3
return {
	Q = 10000,
	wrist = Vector3.new(0.03200, -0.03200, 0.07000),
	mats = { fab = { rough = 0.86, metal = 0 }, palm = { rough = 0.6, metal = 0 }, pad = { rough = 0.35, metal = 0.15 }, strap = { rough = 0.7, metal = 0 }, skin = { rough = 0.55, metal = 0 } },
	glove = {
		fab = { nv = 2814, nt = 5112, data = "" },
		palm = { nv = 672, nt = 1248, data = "" },
		pad = { nv = 294, nt = 432, data = "" },
		strap = { nv = 294, nt = 432, data = "" },
	},
	sleeve = {
		u = { nv = 50, nt = 48, data = "" },
		f = { nv = 50, nt = 48, data = "" },
	},
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">HandModels</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/HandModels (ModuleScript, côté client + Studio)
-- Gants modelés et manches coniques de la vue subjective, exportés du jeu web (tools/hands/export_hands.js →
-- HandMeshes) : un maillage par matière du gant (tissu, paume, coque des jointures, sangle) et par main (la gauche est
-- le reflet de la droite, comme VM.hL.scale.x = -1 du web), plus les deux cônes de manche. 10 pièces en tout au lieu
-- d'environ 200 pièces arrondies : bien plus léger sur téléphone.
-- Les maillages ne sont chargés chez le joueur que s'ils ont été envoyés par ServerStorage/MeshUploader (MeshAssets) :
-- la mémoire des EditableMesh est gardée pour les armes ; sinon ViewmodelController garde ses pièces arrondies.
--   build() -> { R = { GlovePart }, L = { GlovePart }, u = MeshPart?, f = MeshPart? } ou nil
--   keys()  -> clés de maillage attendues (h:glove:<main>:<matière>/<nv>/<nt>, h:sleeve:<u|f>/<nv>/<nt>)
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local decode = require(ReplicatedStorage.Shared.Base64)
local MeshStore = require(ReplicatedStorage.Shared.MeshStore)
local data = require(ReplicatedStorage.Shared.HandMeshes) :: any

local HandModels = {}
HandModels.MATS = { "fab", "palm", "pad", "strap" }
HandModels.WRIST = data.wrist :: Vector3          -- le bras s'arrête au poignet du gant (userData.wristL du web)

export type GlovePart = { p: MeshPart, at: CFrame, mat: string }
export type Built = { R: { GlovePart }, L: { GlovePart }, u: MeshPart?, f: MeshPart?, ems: { EditableMesh } }

local function keyOf(prefix: string, piece: any): string
	return prefix .. "/" .. piece.nv .. "/" .. piece.nt
end

function HandModels.keys(): { string }
	local out = {}
	for _, side in ipairs({ "R", "L" }) do
		for _, m in ipairs(HandModels.MATS) do
			local piece = data.glove[m]
			if piece then table.insert(out, keyOf("h:glove:" .. side .. ":" .. m, piece)) end
		end
	end
	table.insert(out, keyOf("h:sleeve:u", data.sleeve.u))
	table.insert(out, keyOf("h:sleeve:f", data.sleeve.f))
	return out
end

-- tous les maillages sont envoyés (ou on est dans l'envoi, depuis Studio)
function HandModels.ready(): boolean
	if MeshStore.uploader then return true end
	for _, k in ipairs(HandModels.keys()) do if not MeshStore.ids[k] then return false end end
	return true
end

-- maillage d'une pièce, recentré sur sa boîte (le MeshPart a son origine au centre) ; mirror = reflet en x
local function mesh(key: string, piece: any, mirror: boolean, ems: { EditableMesh }): (MeshPart, Vector3)
	local raw = decode(piece.data)
	local nv, nt = piece.nv :: number, piece.nt :: number
	local q = 1 / (data.Q :: number)
	local sx = if mirror then -1 else 1
	local pos: { Vector3 } = table.create(nv)
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for i = 0, nv - 1 do
		local o = i * 9
		local v = Vector3.new(buffer.readi16(raw, o) * sx, buffer.readi16(raw, o + 2), buffer.readi16(raw, o + 4)) * q
		pos[i + 1] = v; lo = lo:Min(v); hi = hi:Max(v)
	end
	local center = (lo + hi) / 2
	local mp, em0 = MeshStore.meshPart(key, function()
		local em = AssetService:CreateEditableMesh({ FixedSize = false })
		local vid, nid = table.create(nv), table.create(nv)
		for i = 0, nv - 1 do
			local o = i * 9
			vid[i + 1] = em:AddVertex(pos[i + 1] - center)
			local n = Vector3.new(buffer.readi8(raw, o + 6) * sx, buffer.readi8(raw, o + 7), buffer.readi8(raw, o + 8))
			nid[i + 1] = em:AddNormal(if n.Magnitude > 0 then n.Unit else Vector3.yAxis)
		end
		local base = nv * 9
		for t = 0, nt - 1 do
			local a = buffer.readu16(raw, base + t * 6) + 1
			local b = buffer.readu16(raw, base + t * 6 + 2) + 1
			local c = buffer.readu16(raw, base + t * 6 + 4) + 1
			if mirror then b, c = c, b end                  -- le reflet retourne les faces : on remet l'ordre des sommets
			local f = em:AddTriangle(vid[a], vid[b], vid[c])
			em:SetFaceNormals(f, { nid[a], nid[b], nid[c] })
		end
		return em
	end)
	if em0 then table.insert(ems, em0) end
	mp.Anchored = true; mp.CanCollide = false; mp.CanQuery = false; mp.CanTouch = false; mp.Massless = true
	mp.CastShadow = false
	return mp, center
end

-- matière Roblox proche de la rugosité / du métal du web (handMats de 55b_hands.js)
local function dress(mp: MeshPart, m: string)
	if m == "pad" then
		-- coque des jointures : plastique dur, satiné (rugosité 0,35, métal 0,15)
		mp.Material = Enum.Material.SmoothPlastic; mp.Reflectance = 0.04
	elseif m == "palm" then
		mp.Material = Enum.Material.Leather       -- paume et bout des doigts : cuir synthétique (rugosité 0,6)
	else
		mp.Material = Enum.Material.Fabric        -- toile du gant et sangle (rugosité 0,86 / 0,7)
	end
	mp.Name = "Gant_" .. m
end

-- fabrique tout (yield : CreateMeshPartAsync) ; nil si les maillages ne sont pas envoyés ou si Roblox refuse
function HandModels.build(): Built?
	if not HandModels.ready() then return nil end
	local ok, res = pcall(function(): Built
		local out: Built = { R = {}, L = {}, u = nil, f = nil, ems = {} }
		for _, side in ipairs({ "R", "L" }) do
			for _, m in ipairs(HandModels.MATS) do
				local piece = data.glove[m]
				if piece then
					local mp, c = mesh(keyOf("h:glove:" .. side .. ":" .. m, piece), piece, side == "L", out.ems)
					dress(mp, m)
					table.insert((out :: any)[side], { p = mp, at = CFrame.new(c), mat = m })
				end
			end
		end
		local u = mesh(keyOf("h:sleeve:u", data.sleeve.u), data.sleeve.u, false, out.ems)
		local f = mesh(keyOf("h:sleeve:f", data.sleeve.f), data.sleeve.f, false, out.ems)
		u.Name = "MancheHaut"; f.Name = "MancheBas"
		u.Material = Enum.Material.Fabric; f.Material = Enum.Material.Fabric
		out.u = u; out.f = f
		return out
	end)
	if ok then return res end
	warn("[HandModels] gants modelés indisponibles : pièces arrondies gardées.", res)
	return nil
end

-- envoi depuis Studio (ServerStorage/MeshUploader, mode Edit)
function HandModels.prebuildAll()
	local b = HandModels.build()
	if not b then return end
	for _, list in ipairs({ b.R, b.L }) do for _, g in ipairs(list) do g.p:Destroy() end end
	if b.u then b.u:Destroy() end
	if b.f then b.f:Destroy() end
	for _, em in ipairs(b.ems) do pcall(function() em:Destroy() end) end
end

return HandModels
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="17">
        <Properties>
          <string name="Name">Icons</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Icons (ModuleScript, client et serveur)
-- Petites icônes sûres pour l'interface. Les polices de Roblox ne savent pas dessiner tous les symboles du web :
-- croix U+2715, étoile U+2726, crayon U+270E, croix U+271A, barre U+275A, flèches U+27F3 et U+279C (pictogrammes « Dingbats »
-- sans version emoji), pièce U+1FA99, casque U+1FA96, parachute U+1FA82, goutte U+1FA78, pansement U+1FA79 (emoji Unicode 12 et 13),
-- bâtons U+1D378 ou carte U+1F0A1
-- donnaient des carrés vides dans Studio. Règle : dans les textes, seulement des emoji très courants (Unicode 11 au plus)
-- ou des symboles déjà vus à l'écran (⌂ ▸ ▶ ★ ⚙ ● → ·) ; sinon une icône dessinée ici avec des Frames :
--   Icons.coin(parent, taille)    pièce : rond doré, liseré foncé, reflet clair (remplace la pièce U+1FA99 à côté d'un montant)
--   Icons.cross(parent, taille)   croix de fermeture : deux barres en rotation (remplace ✕)
--   Icons.check(parent, taille)   coche : deux barres (remplace ✔, que Roblox dessine en emoji gris sans tenir compte de la couleur)
--   Icons.closeButton(bouton)     enlève le texte du bouton et y centre une croix
-- Icons.COIN : la pièce dans un texte (RichText ne sait pas mettre d'image) : 💰, emoji Unicode 6.
local Icons = {}

Icons.COIN = "💰"
Icons.GOLD = Color3.fromRGB(255, 210, 58)

local function frame(props: { [string]: any }, parent: Instance?): Frame
	local f = Instance.new("Frame")
	f.BorderSizePixel = 0
	f.BackgroundTransparency = 0
	for k, v in pairs(props) do (f :: any)[k] = v end
	if parent then f.Parent = parent end
	return f
end
local function round(o: Instance)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0.5, 0)
	c.Parent = o
end

-- pièce d'or : disque doré en dégradé, liseré brun, anneau intérieur et petit reflet. size en pixels.
function Icons.coin(parent: Instance?, size: number, props: { [string]: any }?): Frame
	local f = frame({ Name = "CoinIcon", Size = UDim2.fromOffset(size, size), BackgroundColor3 = Color3.new(1, 1, 1) }, parent)
	round(f)
	local g = Instance.new("UIGradient")
	g.Color = ColorSequence.new(Color3.fromRGB(255, 226, 110), Color3.fromRGB(230, 150, 20))
	g.Rotation = 120
	g.Parent = f
	local st = Instance.new("UIStroke")
	st.Color = Color3.fromRGB(120, 72, 0); st.Thickness = math.max(1, size / 14); st.Transparency = 0.1
	st.Parent = f
	local inner = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(0.62, 0.62),
		BackgroundTransparency = 1, ZIndex = f.ZIndex }, f)
	round(inner)
	local ist = Instance.new("UIStroke")
	ist.Color = Color3.fromRGB(176, 104, 0); ist.Thickness = math.max(1, size / 18); ist.Transparency = 0.35
	ist.Parent = inner
	local hl = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.34, 0.3), Size = UDim2.fromScale(0.22, 0.14), Rotation = -35,
		BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.35, ZIndex = f.ZIndex }, f)
	round(hl)
	for _, d in ipairs(f:GetDescendants()) do if d:IsA("GuiObject") then d.Active = false end end
	f.Active = false
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f
end

-- croix (✕) : deux barres croisées dans un carré de « size » pixels
function Icons.cross(parent: Instance?, size: number, color: Color3?, props: { [string]: any }?): Frame
	local f = frame({ Name = "CrossIcon", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local th = math.max(2, math.floor(size / 7 + 0.5))
	for _, r in ipairs({ 45, -45 }) do
		local b = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1.2, 0, 0, th), Rotation = r,
			BackgroundColor3 = color or Color3.new(1, 1, 1), ZIndex = f.ZIndex, Active = false }, f)
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, th // 2); c.Parent = b
	end
	f.Active = false
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f
end

-- coche (✔) : une barre courte et une longue qui se rejoignent en bas, dans un carré de « size » pixels
function Icons.check(parent: Instance?, size: number, color: Color3?, props: { [string]: any }?): Frame
	local f = frame({ Name = "CheckIcon", Size = UDim2.fromOffset(size, size), BackgroundTransparency = 1 }, parent)
	local th = math.max(2, math.floor(size / 6 + 0.5))
	local col = color or Color3.new(1, 1, 1)
	-- Roblox fait tourner un cadre autour de son centre : chaque barre est posée par son milieu.
	-- Coche de (0,18 ; 0,52) à la pointe (0,40 ; 0,74), puis jusqu'à (0,84 ; 0,26) (en fractions du carré).
	for _, seg in ipairs({ { 0.29, 0.63, 0.311, 45 }, { 0.62, 0.50, 0.651, -47.5 } }) do
		local b = frame({ AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(seg[1], seg[2]), Size = UDim2.new(seg[3], th, 0, th), Rotation = seg[4],
			BackgroundColor3 = col, ZIndex = f.ZIndex, Active = false }, f)
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, th // 2); c.Parent = b
	end
	f.Active = false
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f
end

-- bouton de fermeture : le texte « ✕ » est remplacé par une croix dessinée, centrée
function Icons.closeButton(b: GuiButton, size: number?, color: Color3?): Frame
	if b:IsA("TextButton") then b.Text = "" end
	local s = size or math.floor(math.min(b.AbsoluteSize.X, b.AbsoluteSize.Y) * 0.38 + 0.5)
	if s <= 2 then s = 14 end
	return Icons.cross(b, s, color, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), ZIndex = b.ZIndex + 1 })
end

-- un montant avec la pièce dessinée devant : cadre transparent (icône + texte) ; renvoie le cadre et le texte
function Icons.amount(parent: Instance?, value: string, textSize: number, props: { [string]: any }?): (Frame, TextLabel)
	local f = frame({ Name = "Amount", BackgroundTransparency = 1, Size = UDim2.fromOffset(0, textSize + 6), AutomaticSize = Enum.AutomaticSize.X }, parent)
	local lay = Instance.new("UIListLayout")
	lay.FillDirection = Enum.FillDirection.Horizontal; lay.VerticalAlignment = Enum.VerticalAlignment.Center
	lay.Padding = UDim.new(0, math.max(3, textSize // 3)); lay.SortOrder = Enum.SortOrder.LayoutOrder
	lay.Parent = f
	local ic = Icons.coin(f, math.floor(textSize * 1.05 + 0.5))
	ic.LayoutOrder = 1
	local t = Instance.new("TextLabel")
	t.BackgroundTransparency = 1; t.BorderSizePixel = 0
	t.Font = Enum.Font.GothamBlack; t.TextSize = textSize; t.TextColor3 = Color3.fromRGB(232, 238, 249); t.RichText = true
	t.Text = value; t.AutomaticSize = Enum.AutomaticSize.X; t.Size = UDim2.fromOffset(0, textSize + 6); t.LayoutOrder = 2
	t.Parent = f
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f, t
end

return Icons
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="18">
        <Properties>
          <string name="Name">ItemPreview</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ItemPreview (ModuleScript, côté client)
-- Aperçu 3D d'une arme avant achat ou réclamation (boutique, passe de combat) : le modèle de l'arme (WeaponModels)
-- peint avec le skin ou le camo animé (SkinPaint), dans un ViewportFrame, qui tourne doucement si spin = true.
-- Même rendu que les icônes de l'Arsenal. Si le modèle ne se construit pas (maillage pas encore envoyé), le cadre reste vide :
-- l'appelant affiche déjà le nom et la rareté à côté.
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)

local ItemPreview = {}

-- parent : où poser l'aperçu ; key : arme (Config.WEAPONS) ; skin : numéro de Config.SKINS ; camo : camo animé (ConfigExtra.EXCLUSIVES)
function ItemPreview.weapon(parent: Instance, key: string, skin: number?, camo: string?, props: { [string]: any }?, spin: boolean?): ViewportFrame
	local vf = Instance.new("ViewportFrame")
	vf.BackgroundTransparency = 1; vf.BorderSizePixel = 0; vf.Size = UDim2.fromScale(1, 1)
	vf.Ambient = Color3.fromRGB(170, 175, 190); vf.LightColor = Color3.new(1, 1, 1); vf.LightDirection = Vector3.new(0.4, -1, 0.3)
	if props then for k, v in pairs(props) do (vf :: any)[k] = v end end
	vf.Parent = parent
	task.spawn(function()
		local ok, m = pcall(WeaponModels.build, key, 1)
		if not ok or not m then return end
		local model = m :: Model
		if not vf.Parent then model:Destroy(); return end
		pcall(SkinPaint.apply, model, skin, camo)
		model.Parent = vf
		local cf, ext = model:GetBoundingBox()
		local cam = Instance.new("Camera"); cam.FieldOfView = 20
		local size = vf.AbsoluteSize
		local aspect = if size.Y > 0 then size.X / size.Y else 1.6
		local tv = math.tan(math.rad(10))
		local dist = math.max(ext.Y / 2 / tv, math.max(ext.Z, ext.X) / 2 / (tv * aspect)) * 1.15 + math.max(ext.X, ext.Z) / 2
		local center = cf.Position
		cam.CFrame = CFrame.lookAt(center - Vector3.new(dist, -dist * 0.12, 0), center)
		cam.Parent = vf; vf.CurrentCamera = cam
		if spin then
			local a = 0
			local conn: RBXScriptConnection
			conn = RunService.RenderStepped:Connect(function(dt: number)
				if not vf.Parent then conn:Disconnect(); return end
				if not vf.Visible then return end
				a += dt * 0.6
				cam.CFrame = CFrame.lookAt(center + Vector3.new(-math.cos(a) * dist, dist * 0.12, math.sin(a) * dist), center)
				-- la lumière suit la caméra (en haut à gauche) : la face vue du camo reste éclairée pendant tout le tour
				vf.LightDirection = cam.CFrame:VectorToWorldSpace(Vector3.new(0.35, -0.6, -1))
			end)
		end
	end)
	return vf
end

return ItemPreview
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="19">
        <Properties>
          <string name="Name">KillFxConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/KillFxConfig (ModuleScript)
-- Effets d'élimination : ce qui arrive au corps de l'ennemi que TU élimines (comme dans Rivals ou Arsenal).
-- Purement visuel : aucun avantage de jeu. Joués par KillFxController (client), déclenchés par KillFxService (serveur).
--
-- source :
--   "coins"  = s'achète avec des pièces (price)
--   "robux"  = exclusif payant (robux + productId à créer dans le Creator Hub, 0 = « Bientôt »)
--   "code"   = seulement avec un code promo (ServerScriptService/CodeList)
--   "group"  = seulement en rejoignant le groupe Roblox (CommunityConfig.GROUP)
--   "event"  = récompense d'un palier de citrouilles de l'événement d'Halloween (pk = citrouilles), utilisable pendant l'événement
local KillFxConfig = {}

KillFxConfig.LIST = {
	{ id = "none", name = "Aucun effet", rarity = 1, source = "coins", price = 0 },
	{ id = "confetti", name = "Confettis", rarity = 2, source = "coins", price = 900 },
	{ id = "pixels", name = "Désintégration pixel", rarity = 3, source = "coins", price = 2000 },
	{ id = "ascend", name = "Envol céleste", rarity = 4, source = "coins", price = 5000 },
	{ id = "lightning", name = "Coup de foudre", rarity = 5, source = "robux", robux = 149, productId = 0 },
	{ id = "ice", name = "Statue de glace", rarity = 5, source = "robux", robux = 199, productId = 0 },
	{ id = "blackhole", name = "Trou noir", rarity = 5, source = "robux", robux = 299, productId = 0 },
	{ id = "pumpkins", name = "Pluie de citrouilles", rarity = 4, source = "code" },
	{ id = "spirit", name = "Esprit du groupe", rarity = 4, source = "group" },
	-- événement d'Halloween (src/8W_halloween.js) : paliers 15, 60 et 85 citrouilles
	{ id = "bats", name = "Nuée de chauves-souris", rarity = 4, source = "event", pk = 15 },
	{ id = "soul", name = "Âme damnée", rarity = 4, source = "event", pk = 60 },
	{ id = "grave", name = "Pierre tombale", rarity = 4, source = "event", pk = 85 },
}

local byId: { [string]: any } = {}
for _, fx in ipairs(KillFxConfig.LIST) do byId[fx.id] = fx end
function KillFxConfig.get(id: string): any
	return byId[id]
end

return KillFxConfig
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="20">
        <Properties>
          <string name="Name">LoyaltyConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/LoyaltyConfig (ModuleScript)
-- Fidélité et Premium, mêmes valeurs que la version web (src/8W_loyalty.js) :
-- cadeaux de temps de jeu, paliers de série, rang de fidélité, bonus, abonnement Premium (Robux).
-- Économie lente conservée : ~35 pièces par partie, ces cadeaux ajoutent ~150 pièces par longue journée de jeu.
local L = {}

-- Cadeaux de temps de jeu : minutes jouées dans la journée (UTC), remis à zéro chaque jour
L.PLAYTIME_GIFTS = {
	{ minutes = 10, reward = { coins = 15 }, icon = "💰" },
	{ minutes = 20, reward = { boost = 2 }, icon = "⚡" },
	{ minutes = 35, reward = { coins = 30 }, icon = "💰" },
	{ minutes = 50, reward = { coins = 45 }, icon = "💎" },
	{ minutes = 75, reward = { coins = 70, boost = 2 }, icon = "🎁" },
}

-- Paliers de la série de connexion (profile.streak, voir RewardService.claimDaily), chacun récupérable une fois
L.STREAK_GOALS = {
	{ days = 3, reward = { coins = 100 }, icon = "🔥" },
	{ days = 7, reward = { coins = 200, boost = 3 }, icon = "🔥" },
	{ days = 14, reward = { box = "std", coins = 150 }, icon = "📦" },
	{ days = 30, reward = { box = "prem", title = "loy_flame" }, icon = "👑" },
	{ days = 60, reward = { box = "prem", coins = 600 }, icon = "💠" },
	{ days = 100, reward = { box = "prem", n = 2, title = "loy_100" }, icon = "🏆" },
}

-- Rang de fidélité : nombre de jours où le joueur a fini au moins une partie. xp = bonus d'XP permanent en %.
L.TIERS = {
	{ days = 0, name = "Nouvelle recrue", color = Color3.fromRGB(141, 160, 189), xp = 0 },
	{ days = 3, name = "Habitué", color = Color3.fromRGB(125, 255, 159), xp = 2, reward = { coins = 100 } },
	{ days = 7, name = "Régulier", color = Color3.fromRGB(74, 163, 255), xp = 4, reward = { box = "std" } },
	{ days = 14, name = "Vétéran", color = Color3.fromRGB(199, 125, 255), xp = 6, reward = { coins = 300, title = "loy_vet" } },
	{ days = 30, name = "Fidèle", color = Color3.fromRGB(255, 215, 94), xp = 8, reward = { box = "prem", coins = 200 } },
	{ days = 60, name = "Pilier de l'arène", color = Color3.fromRGB(255, 122, 74), xp = 10, reward = { box = "prem", coins = 500, title = "loy_pillar" } },
	{ days = 100, name = "Légende fidèle", color = Color3.fromRGB(255, 70, 85), xp = 12, reward = { box = "prem", n = 2, coins = 800, title = "loy_legend" } },
}

L.TITLES = { loy_flame = "Flamme éternelle", loy_100 = "Centurion", loy_vet = "Vétéran", loy_pillar = "Pilier de l'arène",
	loy_legend = "Légende fidèle", vip = "⭐ Premium", starter = "🎖 Pionnier" }   -- starter : pack de départ (ShopCatalog.STARTER)

L.FIRST_WIN = { xp = 100, coins = 25 }     -- première victoire du jour
L.BOOST_MULT = 0.5                          -- +50 % d'XP par partie de boost
L.BACK_DAYS = 3                             -- absence (jours) qui déclenche le cadeau « bon retour »
L.BACK_GIFT = { coins = 150, boost = 3 }

-- ---------- Abonnement Premium ----------
-- Developer Products (et pas Game Pass) : chaque achat ajoute des jours, cumulables. Crédité dans ShopService (seul ProcessReceipt).
-- Prix alignés sur les VIP des FPS Roblox (Arsenal VIP ~400 R$, RIVALS ~350 R$). productId = 0 tant que le produit n'est pas créé.
L.VIP = {
	xp = 0.2, coins = 0.2,                  -- +20 % XP et pièces en fin de partie
	daily = { coins = 60 },                 -- cadeau Premium chaque jour
	onPurchase = { box = "prem" },          -- offert à chaque achat
	offers = {
		{ id = "vip_30", days = 30, robux = 349, name = "Premium 30 jours", productId = 0 },
		{ id = "vip_90", days = 90, robux = 899, name = "Premium 90 jours", productId = 0, best = true },
	},
	-- Couleurs de pseudo (chat, tableau des scores, fil des éliminations). "rainbow" = dégradé animé côté client.
	colors = {
		{ id = "gold", name = "Or", color = Color3.fromRGB(255, 196, 40) },
		{ id = "neon", name = "Néon", color = Color3.fromRGB(95, 246, 255) },
		{ id = "rose", name = "Rose", color = Color3.fromRGB(255, 106, 213) },
		{ id = "emerald", name = "Émeraude", color = Color3.fromRGB(77, 255, 166) },
		{ id = "rainbow", name = "Arc-en-ciel", color = Color3.fromRGB(255, 255, 255) },
	},
}

function L.color(id: string?): Color3
	for _, c in ipairs(L.VIP.colors) do
		if c.id == id then return c.color end
	end
	return L.VIP.colors[1].color
end

-- Texte riche pour afficher un pseudo Premium (chat, futur HUD) : à partir des attributs « VipColor » posés par LoyaltyService
function L.richName(player: Player): string
	local name = player.DisplayName
	local col = player:GetAttribute("VipColor")
	if typeof(col) ~= "string" or col == "" then return name end
	if col == "rainbow" then
		local hues = { "#ff4655", "#ffb300", "#fff36a", "#4dff88", "#4aa3ff", "#c77dff" }
		local out = ""
		for i = 1, utf8.len(name) or 0 do
			local ch = string.sub(name, utf8.offset(name, i) or 1, (utf8.offset(name, i + 1) or (#name + 1)) - 1)
			out ..= string.format('<font color="%s">%s</font>', hues[(i - 1) % #hues + 1], ch)
		end
		return '<font color="#ffd24a">⭐</font> ' .. out
	end
	return string.format('<font color="#ffd24a">⭐</font> <font color="#%s">%s</font>', L.color(col):ToHex(), name)
end

return L
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="21">
        <Properties>
          <string name="Name">MapAmbience</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MapAmbience (ModuleScript, client)
-- Ambiance de la carte où se trouve le joueur, comme sur le web (applyTheme / buildSky de src/40_gfx.js, thèmes de
-- src/41_gfx_themes.js, 42_haunt.js, 8W_halloween.js, poussière de src/50_fx.js), avec ce que Roblox fait nativement :
--   • lumière : éclairage Future (Lighting.Technology dans default.project.json : pas réglable par script), style
--     réaliste (ombres nettes et douces), soleil placé dans la direction du thème (sunPos), lumière du ciel et du sol
--     (hémisphère du web), reflets du ciel assez forts pour les matériaux PBR (env du thème), exposition, brouillard du
--     thème, rendu aussi par une Atmosphere (brume, halo du soleil, horizon fondu) ;
--   • ciel : dégradé du web (MapDress.skyImages), soleil, lune des cartes hantées, halo de la lune, étoiles, nuages ;
--   • post-traitement du web : bloom (plus fort de nuit), saturation ×1,1, contraste, teinte légère du thème, rayons du soleil le jour,
--     flou très léger au loin (hors de la zone de jeu) ;
--   • particules autour de la caméra : poussière qui flotte (toutes les cartes), neige (Station), feuilles (Temple).
-- Rien de neuf à envoyer sur Roblox : les images viennent de MapDress (déjà dans MeshAssets).
-- Qualité basse (ombres coupées dans les réglages) : ni particules, ni flou, ni étoiles. Bloom et rayons restent
-- allumés en permanence (Intensity à 0 au lobby) pour que les réglages du menu (MainMenu) puissent les couper.
local Lighting = game:GetService("Lighting")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local MapScene = require(ReplicatedStorage.Shared.MapScene)
local MapDress = require(ReplicatedStorage.Shared.MapDress)

local MapAmbience = {}
local U = Config.STUDS_PER_METER

-- valeurs des thèmes du web absentes de l'export : env (intensité des reflets du ciel sur le web, pour mémoire : Roblox
-- prend LOOK.diff / LOOK.spec), lune peinte dans le ciel
-- (taille en degrés) et couleur de son halo
type Extra = { env: number, moon: number?, halo: Color3? }
local EXTRA: { [string]: Extra } = {
	sand = { env = 0.5 }, snow = { env = 0.8 }, industrial = { env = 0.6 }, night = { env = 0.35 }, metro = { env = 0.5 },
	jungle = { env = 0.6 }, range = { env = 0.7 },
	haunt = { env = 0.12, moon = 8.5 },                                          -- lune de 26 m à 175 m (42_haunt.js)
	halloween = { env = 0.14, moon = 11, halo = Color3.fromRGB(255, 150, 70) },   -- lune orange de 34 m + halo (8W_halloween.js)
}

-- ---------- rendu réaliste par thème (réglé sur la capture de Noa : sol bleu violet, ombres dures, image délavée) ----------
-- Le web éclaire avec une lumière d'hémisphère (ciel / sol du thème) et une carte d'environnement qui contient le disque du
-- soleil (makeEnv de 40_gfx.js) : le sol reste beige. Roblox tire sa lumière diffuse du ciel du seul skybox (dégradé du
-- web, bleu profond au zénith, sans le soleil) : les sols, tournés vers le zénith, devenaient bleus à l'ombre et violets
-- au soleil, les murs (tournés vers l'horizon chaud) non. On baisse donc la part du skybox (diff) et on rend la lumière
-- d'hémisphère du web par OutdoorAmbient (amb). Le tone mapping ACES du web relève contraste et saturation : rendus par
-- la correction colorimétrique (sat, con). Brume plus légère le jour (atmo : densité, décalage, éclat, voile).
type Look = { diff: number, spec: number, soft: number, amb: number, sat: number, con: number, bri: number, tint: Color3,
	bloom: { number }, rays: { number }, atmo: { number }, dof: number }
local LOOK: { [string]: Look } = {
	sand = { diff = 0.22, spec = 0.45, soft = 0.32, amb = 1.35, sat = 0.15, con = 0.12, bri = 0.01, tint = Color3.new(1, 0.975, 0.93),
		bloom = { 0.28, 24, 1.4 }, rays = { 0.07, 0.55 }, atmo = { 0.16, 0.1, 0.28, 0.55 }, dof = 0.1 },
	industrial = { diff = 0.26, spec = 0.55, soft = 0.26, amb = 1.25, sat = 0.17, con = 0.14, bri = 0, tint = Color3.new(1, 0.955, 0.9),
		bloom = { 0.36, 28, 1.25 }, rays = { 0.12, 0.6 }, atmo = { 0.2, 0.12, 0.5, 0.8 }, dof = 0.1 },
	snow = { diff = 0.4, spec = 0.65, soft = 0.4, amb = 1.1, sat = 0.06, con = 0.1, bri = 0, tint = Color3.new(0.96, 0.985, 1),
		bloom = { 0.3, 24, 1.35 }, rays = { 0.06, 0.5 }, atmo = { 0.22, 0.1, 0.25, 1.2 }, dof = 0.14 },
	night = { diff = 0.3, spec = 0.7, soft = 0.45, amb = 1, sat = 0.1, con = 0.12, bri = 0, tint = Color3.new(0.93, 0.96, 1),
		bloom = { 0.75, 32, 0.95 }, rays = { 0, 0.5 }, atmo = { 0.3, 0.05, 0, 1 }, dof = 0.12 },
	metro = { diff = 0.3, spec = 0.6, soft = 0.5, amb = 1, sat = 0.08, con = 0.12, bri = 0, tint = Color3.new(0.97, 0.98, 1),
		bloom = { 0.5, 28, 1.05 }, rays = { 0, 0.5 }, atmo = { 0.3, 0, 0, 0.6 }, dof = 0.1 },
	jungle = { diff = 0.3, spec = 0.5, soft = 0.38, amb = 1.1, sat = 0.14, con = 0.12, bri = 0, tint = Color3.new(0.98, 1, 0.95),
		bloom = { 0.3, 24, 1.35 }, rays = { 0.12, 0.7 }, atmo = { 0.26, 0.1, 0.3, 1 }, dof = 0.14 },
	range = { diff = 0.26, spec = 0.5, soft = 0.3, amb = 1.2, sat = 0.12, con = 0.12, bri = 0, tint = Color3.new(1, 0.99, 0.96),
		bloom = { 0.28, 24, 1.4 }, rays = { 0.07, 0.55 }, atmo = { 0.16, 0.1, 0.25, 0.55 }, dof = 0.1 },
	haunt = { diff = 0.12, spec = 0.25, soft = 0.5, amb = 1, sat = 0, con = 0.14, bri = 0, tint = Color3.new(0.94, 1, 0.95),
		bloom = { 0.75, 32, 0.95 }, rays = { 0, 0.5 }, atmo = { 0.36, 0.05, 0, 1.2 }, dof = 0.12 },
	halloween = { diff = 0.14, spec = 0.3, soft = 0.5, amb = 1, sat = 0.06, con = 0.14, bri = 0, tint = Color3.new(1, 0.95, 0.9),
		bloom = { 0.75, 32, 0.95 }, rays = { 0, 0.5 }, atmo = { 0.34, 0.05, 0, 1 }, dof = 0.12 },
}

-- ---------- éclairage du lobby (remis en sortant de la carte) ----------
local PROPS = { "Ambient", "OutdoorAmbient", "Brightness", "ClockTime", "GeographicLatitude", "FogColor", "FogStart", "FogEnd",
	"ColorShift_Top", "ColorShift_Bottom", "ExposureCompensation", "EnvironmentDiffuseScale", "EnvironmentSpecularScale",
	"ShadowSoftness", "LightingStyle" }
local lobby: { [string]: any } = {}
for _, k in ipairs(PROPS) do pcall(function() lobby[k] = (Lighting :: any)[k] end) end
local lobbyKids: { Instance } = {}       -- ciel et atmosphère d'origine, retirés le temps d'un match
local lobbyClouds: { [string]: any }? = nil

-- ---------- post-traitement (créé une fois) ----------
local bloom = Instance.new("BloomEffect"); bloom.Name = "MapBloom"; bloom.Intensity = 0; bloom.Parent = Lighting
local rays = Instance.new("SunRaysEffect"); rays.Name = "MapSunRays"; rays.Intensity = 0; rays.Parent = Lighting
local grade = Instance.new("ColorCorrectionEffect"); grade.Name = "MapGrade"; grade.Enabled = false; grade.Parent = Lighting
local depth = Instance.new("DepthOfFieldEffect"); depth.Name = "MapDepth"; depth.Enabled = false; depth.NearIntensity = 0; depth.Parent = Lighting

local function c3(t: { number }?): Color3 return if t then Color3.new(t[1], t[2], t[3]) else Color3.new(1, 1, 1) end
local function scale(c: Color3, k: number): Color3 return Color3.new(math.min(1, c.R * k), math.min(1, c.G * k), math.min(1, c.B * k)) end
local function rgbText(s: string?): Color3      -- couleur « r,g,b » des nuages du web
	local r, g, b = string.match(s or "", "(%d+)%s*,%s*(%d+)%s*,%s*(%d+)")
	return Color3.fromRGB(tonumber(r) or 255, tonumber(g) or 255, tonumber(b) or 255)
end
local function low(): boolean return not Lighting.GlobalShadows end

-- ---------- état de la carte habillée ----------
type State = { key: string, origin: Vector3, center: Vector3, night: boolean, holder: Folder, sky: Sky?, clouds: Clouds?, atmo: Atmosphere?,
	emit: Part?, emitters: { ParticleEmitter }, stars: Part?, conn: RBXScriptConnection? }
local cur: State? = nil

-- ---------- soleil : ClockTime + latitude pour que le soleil de Roblox soit dans la direction sunPos du web ----------
local sunCache: { [string]: { number } } = {}
local function placeSun(id: string, want: Vector3)
	local c = sunCache[id]
	if c then Lighting.ClockTime = c[1]; Lighting.GeographicLatitude = c[2]; return end
	local best, bc, bl = -2, 12, 41.73
	local ok = true
	local function try(t: number, lat: number)
		Lighting.ClockTime = t; Lighting.GeographicLatitude = lat
		local d: any = Lighting:GetSunDirection()
		if typeof(d) ~= "Vector3" then ok = false; return end
		local s = (d :: Vector3):Dot(want)
		if s > best then best, bc, bl = s, t, lat end
	end
	-- recherche grossière puis fine (une fois par carte)
	for lat = -80, 80, 10 do
		for t = 6, 18, 0.5 do try(t, lat); if not ok then break end end
		if not ok then break end
	end
	if ok then
		local l0, t0 = bl, bc
		for lat = l0 - 9, l0 + 9, 1.5 do
			for t = t0 - 0.45, t0 + 0.45, 0.075 do try(t, math.clamp(lat, -90, 90)) end
		end
	else                                   -- direction du soleil indisponible : seulement sa hauteur
		local el = math.deg(math.asin(math.clamp(want.Y, -1, 1)))
		bc, bl = 6 + el / 15, 41.73
	end
	sunCache[id] = { bc, bl }
	Lighting.ClockTime = bc; Lighting.GeographicLatitude = bl
end

-- ---------- ciel lointain : étoiles et halo de la lune (BillboardGui loin de la carte : ni brouillard ni parallaxe) ----------
local FAR = 1500
local function farAnchor(st: State): Part
	if st.stars then return st.stars end
	local p = Instance.new("Part")
	p.Name = "CielLointain"; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Transparency = 1; p.Size = Vector3.new(0.2, 0.2, 0.2); p.CastShadow = false; p.CFrame = CFrame.new(st.center)
	p.Parent = st.holder
	st.stars = p
	return p
end

local function farBillboard(st: State, dir: Vector3, size: UDim2): BillboardGui
	local at = Instance.new("Attachment"); at.Position = dir * FAR; at.Parent = farAnchor(st)
	local bg = Instance.new("BillboardGui")
	bg.Size = size; bg.LightInfluence = 0; bg.Adornee = at; bg.Parent = at
	return bg
end

-- étoiles du web : n points de 1,6 px au-dessus de l'horizon (stars() de 41_gfx_themes.js)
local function buildStars(st: State, n: number)
	local rng = Random.new(n * 7919)
	for _ = 1, n do
		local a, e = rng:NextNumber(0, math.pi * 2), rng:NextNumber(0.08, 1.2)
		local bg = farBillboard(st, Vector3.new(math.cos(a) * math.cos(e), math.sin(e), math.sin(a) * math.cos(e)), UDim2.fromOffset(2, 2))
		local f = Instance.new("Frame")
		f.Size = UDim2.fromScale(1, 1); f.BorderSizePixel = 0; f.BackgroundColor3 = Color3.new(1, 1, 1)
		f.BackgroundTransparency = rng:NextNumber(0.05, 0.45)
		f.Parent = bg
	end
end

-- halo de la lune (sprite additif du web, 95 m à 180 m, teinté de la couleur du soleil du thème)
local function buildHalo(st: State, dir: Vector3, col: Color3, deg: number, transp: number)
	local img = MapDress.glow()
	if not img then return end
	local s = 2 * FAR * math.tan(math.rad(deg / 2))
	local bg = farBillboard(st, dir, UDim2.fromScale(s, s))
	bg.Brightness = 1.2
	local il = Instance.new("ImageLabel")
	il.Size = UDim2.fromScale(1, 1); il.BackgroundTransparency = 1; il.ImageContent = img
	il.ImageColor3 = col; il.ImageTransparency = transp
	il.Parent = bg
end

-- ---------- nuages (Clouds du terrain), comme la couche de nuages du ciel du web ----------
local function setClouds(st: State, th: any)
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then return end
	local cov = if typeof(th.cov) == "number" then th.cov else 0.42
	local cl = terrain:FindFirstChildOfClass("Clouds")
	if cl and cl.Name ~= "MapClouds" and not lobbyClouds then
		lobbyClouds = { Cover = cl.Cover, Density = cl.Density, Color = cl.Color, Enabled = cl.Enabled }
	end
	if not cl then
		cl = Instance.new("Clouds"); (cl :: Clouds).Name = "MapClouds"; (cl :: Clouds).Parent = terrain
	end
	local c = cl :: Clouds
	c.Enabled = cov > 0.01
	c.Cover = math.clamp(cov * 0.9, 0, 1)
	c.Density = math.clamp(0.35 + cov * 0.45, 0, 1)
	c.Color = rgbText(th.cloud)
	st.clouds = c
end

local function restoreClouds()
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	local cl = terrain and terrain:FindFirstChildOfClass("Clouds")
	if not cl then return end
	if cl.Name == "MapClouds" then cl:Destroy(); return end
	local o = lobbyClouds
	if o then
		pcall(function() cl.Cover = o.Cover; cl.Density = o.Density; cl.Color = o.Color; cl.Enabled = o.Enabled end)
	end
end

-- ---------- particules d'ambiance autour de la caméra ----------
local function seq(pts: { { number } }): NumberSequence
	local k = {}
	for _, p in ipairs(pts) do table.insert(k, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0)) end
	return NumberSequence.new(k)
end

local function emitter(st: State, name: string): ParticleEmitter
	local e = Instance.new("ParticleEmitter")
	e.Name = name
	e.Shape = Enum.ParticleEmitterShape.Box; e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	e.Enabled = not low()
	e.Parent = st.emit
	table.insert(st.emitters, e)
	return e
end

local function buildParticles(st: State, id: string, themeName: string, base: string)
	local snow = base == "snow"
	-- volume du web : 50 m × 50 m autour de la caméra, de 0,3 à 12 m (14 m pour la neige)
	local hgt = (if snow then 14 else 12) * U
	local p = Instance.new("Part")
	p.Name = "Ambiance"; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Transparency = 1; p.CastShadow = false; p.Size = Vector3.new(50 * U, hgt, 50 * U)
	p.CFrame = CFrame.new(st.center + Vector3.new(0, hgt / 2, 0))
	p.Parent = st.holder
	st.emit = p
	local soft = MapDress.glow()
	local e = emitter(st, if snow then "Neige" else "Poussiere")
	if soft then e.TextureContent = soft end
	e.LightInfluence = 0
	if snow then
		-- flocons qui tombent (0,9 à 1,5 m/s) en dérivant
		e.Rate = 34; e.Lifetime = NumberRange.new(6, 10)
		e.EmissionDirection = Enum.NormalId.Bottom; e.Speed = NumberRange.new(0.9 * U, 1.5 * U); e.SpreadAngle = Vector2.new(14, 14)
		e.Acceleration = Vector3.new(0.3 * U, 0, 0)
		e.Size = seq({ { 0, 0.26, 0.1 }, { 1, 0.26, 0.1 } })
		e.Transparency = seq({ { 0, 1 }, { 0.1, 0.25 }, { 0.85, 0.25 }, { 1, 1 } })
		e.Color = ColorSequence.new(Color3.new(1, 1, 1)); e.LightEmission = 0.6
	else
		-- poussière qui flotte dans la lumière (motes du web : 260 grains, alpha 0,1 à 0,35)
		e.Rate = 26; e.Lifetime = NumberRange.new(7, 12)
		e.Speed = NumberRange.new(0.04 * U, 0.14 * U); e.SpreadAngle = Vector2.new(180, 180)
		e.Size = seq({ { 0, 0.17, 0.08 }, { 1, 0.17, 0.08 } })
		e.Transparency = seq({ { 0, 1 }, { 0.2, 0.72, 0.1 }, { 0.8, 0.72, 0.1 }, { 1, 1 } })
		e.Color = ColorSequence.new(Color3.new(1, 0.95, 0.85)); e.LightEmission = 1
	end
	-- Temple perdu : quelques feuilles qui tombent en tournoyant (texture de feuille du web)
	if themeName == "jungle" then
		local info = MapScene.info(id)
		local leaf: Content? = nil
		for _, m in ipairs(info and info.mats or {}) do
			if m.tex and MapScene.texKind(m.tex) == "leafbroad" then leaf = MapDress.texture(m.tex); break end
		end
		if leaf then
			local f = emitter(st, "Feuilles")
			f.TextureContent = leaf
			f.Rate = 2.5; f.Lifetime = NumberRange.new(8, 11)
			f.EmissionDirection = Enum.NormalId.Bottom; f.Speed = NumberRange.new(0.5 * U, 0.9 * U); f.SpreadAngle = Vector2.new(35, 35)
			f.Acceleration = Vector3.new(0.25 * U, 0, 0.12 * U); f.Drag = 0.4
			f.Rotation = NumberRange.new(0, 360); f.RotSpeed = NumberRange.new(-120, 120)
			f.Size = seq({ { 0, 0.32 * U, 0.08 * U }, { 1, 0.32 * U, 0.08 * U } })
			f.Transparency = seq({ { 0, 1 }, { 0.08, 0 }, { 0.9, 0 }, { 1, 1 } })
			f.Color = ColorSequence.new(Color3.fromRGB(176, 140, 80), Color3.fromRGB(122, 140, 66))
			f.LightInfluence = 1; f.LightEmission = 0
		end
	end
	-- le volume suit la caméra (les particules déjà émises restent sur place)
	local groundY = st.origin.Y
	st.conn = RunService.RenderStepped:Connect(function()
		local cam = workspace.CurrentCamera
		if not cam or not p.Parent then return end
		local pos = cam.CFrame.Position
		p.CFrame = CFrame.new(pos.X, groundY + 0.3 * U + hgt / 2, pos.Z)
	end)
end

-- ---------- qualité : suit le réglage des ombres du menu ----------
local function applyQuality()
	local st = cur
	local lo = low()
	depth.Enabled = st ~= nil and not lo
	if not st then return end
	for _, e in ipairs(st.emitters) do e.Enabled = not lo end
	if st.stars then             -- étoiles (taille en pixels) coupées en qualité basse, halo de la lune gardé
		for _, d in ipairs(st.stars:GetDescendants()) do if d:IsA("BillboardGui") then d.Enabled = not lo or d.Size.X.Scale > 0 end end
	end
end
Lighting:GetPropertyChangedSignal("GlobalShadows"):Connect(applyQuality)

-- ---------- API ----------
local function clearMap()
	local st = cur
	cur = nil
	if not st then return end
	if st.conn then st.conn:Disconnect() end
	if st.sky then st.sky:Destroy() end
	if st.atmo then st.atmo:Destroy() end
	st.holder:Destroy()
end

function MapAmbience.restore()
	clearMap()
	for k, v in pairs(lobby) do pcall(function() (Lighting :: any)[k] = v end) end
	for _, k in ipairs(lobbyKids) do pcall(function() k.Parent = Lighting end) end
	lobbyKids = {}
	restoreClouds()
	bloom.Intensity = 0; rays.Intensity = 0; grade.Enabled = false; depth.Enabled = false
end

-- f : dossier de la carte dans Workspace (attributs MapId, Origin, MapSize)
function MapAmbience.apply(f: Instance)
	local id = f:GetAttribute("MapId")
	if typeof(id) ~= "string" then MapAmbience.restore(); return end
	local info = MapScene.info(id)
	local th = info and info.theme
	if not th then MapAmbience.restore(); return end
	clearMap()
	local md = MapData[id]
	local themeName: string = (md and md.theme) or "sand"
	local base: string = (md and md.base) or th.base or "sand"
	local ex = EXTRA[themeName] or EXTRA.sand
	local look = LOOK[themeName] or LOOK.sand
	local o = f:GetAttribute("Origin")
	local size = f:GetAttribute("MapSize")
	local origin = if typeof(o) == "Vector3" then o else Vector3.zero
	local sz = if typeof(size) == "number" then size else 40 * 2 * U
	local holder = Instance.new("Folder"); holder.Name = "MapAmbience"; holder.Parent = workspace
	local night = (th.sunI or 2) < 1.5
	local st: State = { key = f.Name .. "@" .. id, origin = origin, center = origin + Vector3.new(sz / 2, 0, sz / 2), night = night,
		holder = holder, emitters = {} }
	cur = st

	-- lumière
	local L = Lighting :: any
	local sp = th.sunPos or { 55, 80, 34 }
	local sunDir = Vector3.new(sp[1], sp[2], sp[3]).Unit
	pcall(function()
		L.LightingStyle = Enum.LightingStyle.Realistic       -- ombres nettes du soleil et des lampes (rendu « Future »)
		L.ShadowSoftness = look.soft                         -- pénombre des ombres (PCF doux du web)
		local hemiS, hemiG, sunC = c3(th.hemiS), c3(th.hemiG), c3(th.sunC)
		-- lumière d'hémisphère du web (moitié ciel, moitié sol) : éclaire les ombres sans les bleuir
		L.OutdoorAmbient = scale(hemiS:Lerp(hemiG, 0.5), math.clamp(th.hemiI * 1.3 * look.amb, 0.2, 1.2))
		L.Ambient = scale(hemiG, math.clamp(th.hemiI * 0.8, 0.1, 0.8))
		L.Brightness = math.clamp(th.sunI, 0.15, 3.2)
		L.ColorShift_Top = sunC
		L.ColorShift_Bottom = hemiG
		L.ExposureCompensation = math.clamp(math.log(th.exp or 1, 2), -1, 1)
		-- lumière et reflets du skybox : un peu de diffus (sinon le zénith bleu teinte les sols), reflets assez forts pour
		-- les matériaux PBR (métal, béton mouillé, vitres)
		L.EnvironmentDiffuseScale = look.diff
		L.EnvironmentSpecularScale = look.spec
		L.FogColor = c3(th.fog); L.FogStart = (th.fogN or 50) * U; L.FogEnd = (th.fogF or 200) * U
	end)
	pcall(placeSun, id, sunDir)

	-- l'atmosphère et le ciel du lobby remplacent le brouillard : on les retire le temps du match
	for _, k in ipairs(Lighting:GetChildren()) do
		if k:IsA("Atmosphere") or k:IsA("Sky") then table.insert(lobbyKids, k); k.Parent = nil end
	end

	-- ciel : dégradé du web, soleil de jour, lune peinte des cartes hantées, rien dans le métro
	local imgs = th.sky and MapDress.skyImages(id, th.sky)
	local sky = Instance.new("Sky"); sky.Name = "MapSky"
	sky.StarCount = 0                                  -- étoiles du web dessinées à part (le ciel de Roblox est en plein jour)
	if themeName == "metro" then
		sky.CelestialBodiesShown = false
	elseif ex.moon then
		sky.CelestialBodiesShown = true
		sky.SunTextureId = "rbxasset://sky/moon.jpg"; sky.SunAngularSize = ex.moon
	else
		sky.CelestialBodiesShown = not night               -- port et labo : seulement le halo bleuté du web
		sky.SunAngularSize = 21
	end
	if imgs then
		pcall(function()
			local side = imgs.side
			sky.SkyboxBackContent = side; sky.SkyboxFrontContent = side; sky.SkyboxLeftContent = side; sky.SkyboxRightContent = side
			sky.SkyboxUpContent = imgs.up; sky.SkyboxDownContent = imgs.dn
		end)
	end
	sky.Parent = Lighting
	st.sky = sky
	pcall(setClouds, st, th)                           -- métro : cov = 0, pas de nuages

	-- atmosphère : brume de la couleur du brouillard du web, plus dense sur les cartes courtes (asile : 78 m) que sur les
	-- grandes (village : 210 m) ; halo autour du soleil le jour, horizon fondu dans le ciel. Plafond 0,36 : au-delà (0,44
	-- dans l'asile, avec un voile de 1,6), la brume quasi noire de nuit cachait le bout des couloirs et les zombies à 25 m,
	-- alors que le brouillard linéaire du web laisse encore voir à mi-carte.
	pcall(function()
		local a = Instance.new("Atmosphere")
		a.Name = "MapAtmosphere"
		a.Density = look.atmo[1]
		a.Offset = look.atmo[2]
		a.Color = c3(th.fog)
		a.Decay = scale(c3(th.hemiG), 0.85)
		a.Glare = if night then 0 else look.atmo[3]
		a.Haze = look.atmo[4]
		a.Parent = Lighting
		st.atmo = a
	end)
	if themeName ~= "metro" then
		if night then
			pcall(buildHalo, st, sunDir, ex.halo or c3(th.sunC), if ex.halo then 33 else 29, if ex.halo then 0.45 else 0.35)
			if (th.stars or 0) > 0 then pcall(buildStars, st, math.floor(th.stars * 0.7)) end
		end
	end

	-- post-traitement du web (postEnd de 40_gfx.js) : bloom 0,32 / 0,75 sur les cartes de nuit et hantées, saturation, contraste
	bloom.Intensity = look.bloom[1]
	bloom.Size = look.bloom[2]
	bloom.Threshold = look.bloom[3]
	rays.Intensity = if night then 0 else look.rays[1]
	rays.Spread = look.rays[2]
	-- teinte légère par thème : chaude au soleil du désert et au couchant, froide sur la neige et la nuit, verdâtre dans l'asile
	grade.Saturation = look.sat; grade.Contrast = look.con; grade.Brightness = look.bri; grade.TintColor = look.tint
	grade.Enabled = true
	-- flou léger seulement au-delà de la zone de jeu (relief et silhouettes lointaines)
	depth.FocusDistance = sz * 0.75; depth.InFocusRadius = sz * 0.75; depth.FarIntensity = look.dof; depth.NearIntensity = 0

	pcall(buildParticles, st, id, themeName, base)
	applyQuality()
end

-- clé de la carte habillée (nom du dossier @ carte), nil au lobby
function MapAmbience.current(): string?
	return if cur then cur.key else nil
end

return MapAmbience
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="22">
        <Properties>
          <string name="Name">MapData</string>
          <string name="Source"><![CDATA[--!nocheck
-- Généré par tools/scene_to_lua.py depuis le jeu web (tools/export_scene.js : grille, points, sites, zones) : ne pas modifier à la main.

-- Grille de jeu des 10 cartes du web, relevée sur le jeu en marche (cases, hauteurs, rampes, plafonds, sols),
-- avec les points d'apparition corrigés par l'audit du web. 1 case = 2 m.
local MapData: any = {}

local N = 40
local TY = { OPEN = 0, WALL = 1, CRATE = 2, HOUSE = 3, LOW = 4, BARREL = 5, PLAT = 6, CONT = 7, CONC = 8, PILLAR = 9 }
local TYH = { [0] = 0, 6, 2.6, 4.6, 0.9, 1.1, 3, 2.7, 5.4, 6 }
MapData.N, MapData.TY, MapData.TYH = N, TY, TYH
MapData.ORDER = {"village", "warehouse", "station", "harbor", "metro", "jungle", "range", "labo", "asile", "manoir"}

