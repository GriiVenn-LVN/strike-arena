		{ m = "paint", p = "tailgate", c = { 0.0000, 0.2700, 0.0000 }, s = { 2.3600, 0.5500, 0.0600 }, r = { 1.00000, -0.00000, 0.00000, 0.00000, 1.00000, -0.00000, 0.00000, -0.00000, 1.00000 } },
		{ m = "dark", p = "tailgate", c = { 0.0000, 0.2800, 0.0400 }, s = { 2.3000, 0.4000, 0.0300 }, r = { 1.00000, -0.00000, 0.00000, 0.00000, 1.00000, -0.00000, 0.00000, -0.00000, 1.00000 } },
