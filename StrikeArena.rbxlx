local hitmarker = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, Visible = false, ZIndex = 6 }, center)
local hmLines: { Frame } = {}
local hmHolders: { Frame } = {}
for i, rot in ipairs({ 45, 135, 225, 315 }) do
	local holder = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(0, 0), Rotation = rot, BackgroundTransparency = 1 }, hitmarker)
	hmLines[i] = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromOffset(0, -7), Size = UDim2.fromOffset(3, 11), BackgroundColor3 = C.text, ZIndex = 6 }, holder)
	corner(hmLines[i], 2); stroke(hmLines[i], Color3.new(0, 0, 0), 1, 0.3)
	hmHolders[i] = holder
end
local hmRing = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(44, 44), BackgroundTransparency = 1, Visible = false, ZIndex = 6 }, center)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, hmRing)
local hmRingStroke = make("UIStroke", { Color = rgb(0xff3b47), Thickness = 2 }, hmRing)
local hmToken = 0
local function showHitmarker(head: boolean, kill: boolean, shieldOnly: boolean)
	hmToken += 1
	local my = hmToken
	local col = if kill then rgb(0xff3b47) elseif shieldOnly then rgb(0x5fd6ff) elseif head then rgb(0xffd23f) else C.text
	local dur = if kill then 0.55 elseif head then 0.4 else 0.3
	hitmarker.Visible = true
	for _, l in ipairs(hmLines) do
		l.BackgroundColor3 = col; l.BackgroundTransparency = 0
		l.Size = UDim2.fromOffset(if kill then 4 else 3, if kill then 15 else 11)
		l.Position = UDim2.fromOffset(0, -13)
		tween(l, dur * 0.18, { Position = UDim2.fromOffset(0, -6) })
		task.delay(dur * 0.18, function()
			if my ~= hmToken then return end
			tween(l, dur * 0.82, { Position = UDim2.fromOffset(0, -9), BackgroundTransparency = 1 })
		end)
	end
	if kill then
		hmRing.Visible = true; hmRing.Size = UDim2.fromOffset(15, 15); hmRingStroke.Transparency = 0.05
		tween(hmRing, 0.45, { Size = UDim2.fromOffset(66, 66) }); tween(hmRingStroke, 0.45, { Transparency = 1 })
	end
	task.delay(dur + 0.05, function() if my == hmToken then hitmarker.Visible = false; hmRing.Visible = false end end)
end

-- voile rouge des dégâts (dégradé vers les bords) et vignette de vie basse
local function edgeVeil(color: Color3, z: number): { Frame }
	local list = {}
	local specs: { { any } } = { { UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0), 90 }, { UDim2.fromScale(1, 0.32), UDim2.fromScale(0, 0.68), -90 },
		{ UDim2.fromScale(0.22, 1), UDim2.fromScale(0, 0), 0 }, { UDim2.fromScale(0.22, 1), UDim2.fromScale(0.78, 0), 180 } }
	for i, spec in ipairs(specs) do
		local f = make("Frame", { Size = spec[1], Position = spec[2], BackgroundColor3 = color, BackgroundTransparency = 1, ZIndex = z }, gui)
		make("UIGradient", { Rotation = spec[3], Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0), NumberSequenceKeypoint.new(1, 1) }) }, f)
		list[i] = f
	end
	return list
end
local hurtVeil = edgeVeil(rgb(0xaa0000), 0)
local lowVeil = edgeVeil(rgb(0xb40000), 0)
local function setVeil(list: { Frame }, alpha: number)
	for _, f in ipairs(list) do f.BackgroundTransparency = 1 - clamp(alpha, 0, 1) end
end
local hurtAlpha = 0
local lowPhase = 0

-- direction des tirs reçus : l'arc suit la position du tireur quand on se retourne
type Dir = { holder: Frame, arc: Frame, chev: TextLabel, from: Vector3, att: Instance?, t: number, k: number }
local dirs: { Dir } = {}
for i = 1, 6 do
	local holder = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(0, 0), BackgroundTransparency = 1, ZIndex = 5 }, center)
	local arc = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, -146), Size = UDim2.fromOffset(112, 9), BackgroundColor3 = rgb(0xff2636),
		BackgroundTransparency = 1, ZIndex = 5 }, holder)
	corner(arc, 5)
	make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, arc)
	local chev = label(holder, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(0, -161), Size = UDim2.fromOffset(26, 16), Text = "▲", TextSize = 16,
		TextColor3 = rgb(0xff3442), TextTransparency = 1, ZIndex = 5 })
	dirs[i] = { holder = holder, arc = arc, chev = chev, from = Vector3.zero, att = nil, t = 9, k = 0 }
end
local function damageIndicator(fromPos: Vector3, att: Instance?, dmg: number)
	local k = math.min(1, 0.35 + dmg / 45)
	local slot: Dir? = nil
	for _, d in ipairs(dirs) do if att and d.att == att and d.t < 1.4 then slot = d end end
	if not slot then
		slot = dirs[1]
		for _, d in ipairs(dirs) do if d.t > (slot :: any).t then slot = d end end
	end
	local s = (slot :: any) :: Dir
	s.k = math.max(if s.t < 1.4 then s.k else 0, k); s.from = fromPos; s.att = att; s.t = 0
end

-- chiffres de dégâts au-dessus de la cible : cumulés tant que les touches s'enchaînent (doré = tête, bleu = bouclier, rouge = élimination)
type Num = { bb: BillboardGui, txt: TextLabel, total: number, hs: boolean, sh: boolean, kill: boolean, t0: number, tu: number, bump: number, target: Instance?, anchor: BasePart }
local nums: { Num } = {}
local function damageNumber(pos: Vector3, dmg: number, head: boolean, kill: boolean, shieldOnly: boolean, target: Instance?)
	local t = os.clock()
	local o: Num? = nil
	for _, n in ipairs(nums) do if n.target == target and t - n.tu < 0.65 and not n.kill then o = n end end
	if not o then
		local anchor = make("Part", { Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, Transparency = 1, Size = Vector3.new(0.2, 0.2, 0.2),
			Position = pos + Vector3.new(0, 2.05 * U * 0.8, 0) }, workspace)
		local bb = make("BillboardGui", { Adornee = anchor, Size = UDim2.fromOffset(160, 60), AlwaysOnTop = true, LightInfluence = 0,
			StudsOffsetWorldSpace = Vector3.zero }, anchor)
		local txt = label(bb, { Size = UDim2.fromScale(1, 1), FontFace = ITALIC, TextSize = 22, Text = "", RichText = true })
		make("UIStroke", { Thickness = 1.5, Transparency = 0.15 }, txt)
		o = { bb = bb, txt = txt, total = 0, hs = false, sh = true, kill = false, t0 = t, tu = t, bump = 0, target = target, anchor = anchor }
		table.insert(nums, (o :: any) :: Num)
	end
	local n = (o :: any) :: Num
	n.total += dmg; n.hs = n.hs or head; n.sh = n.sh and shieldOnly; n.tu = t; n.bump = 1
	if kill then n.kill = true end
	n.txt.TextColor3 = if n.kill then rgb(0xff4655) elseif n.hs then rgb(0xffd23f) elseif n.sh then rgb(0x5fd6ff) else Color3.new(1, 1, 1)
	n.txt.Text = tostring(math.floor(n.total + 0.5)) .. (if n.kill then '<font size="13"> ☠</font>' elseif n.hs then '<font size="13"> ◆</font>' else "")
	n.txt.TextSize = math.min(40, 20 + math.sqrt(n.total) * 1.5 + (if n.hs then 4 else 0) + (if n.kill then 5 else 0))
	if target and target:IsA("Model") then
		local head = target:FindFirstChild("Head") :: BasePart?
		if head then n.anchor.Position = head.Position + Vector3.new(0, 1.6, 0) end
	end
end
local function updateNumbers(dt: number)
	local t = os.clock()
	for i = #nums, 1, -1 do
		local n = nums[i]
		local age, life = t - n.tu, t - n.t0
		if age > 1.05 then n.anchor:Destroy(); table.remove(nums, i); continue end
		n.bump = math.max(0, n.bump - dt * 7)
		local rise = math.min(life, 1.6) * 26 + age * 30
		n.bb.StudsOffset = Vector3.new(0, rise / 60, 0)
		n.txt.TextTransparency = if age < 0.7 then 0 else (age - 0.7) / 0.35
		local sc = (1 + n.bump * 0.45) * (if life < 0.08 then 1.6 - life * 7.5 else 1)
		n.bb.Size = UDim2.fromOffset(160 * sc, 60 * sc)
	end
end

-- recharge : petite barre sous le viseur
local relBar = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromOffset(0, 46), Size = UDim2.fromOffset(84, 4), BackgroundColor3 = Color3.new(1, 1, 1),
	BackgroundTransparency = 0.88, Visible = false }, center)
corner(relBar, 3)
local relFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.5 }, relBar)
corner(relFill, 3)

hitRemote.OnClientEvent:Connect(function(head: boolean, kill: boolean, dmg: number?, pos: Vector3?, shieldOnly: boolean?, target: Instance?)
	showHitmarker(head, kill, shieldOnly == true)
	playSound(if kill then ModeConfig.SOUNDS.kill elseif shieldOnly then "shield" elseif head then ModeConfig.SOUNDS.hitHead else ModeConfig.SOUNDS.hitBody)
	if dmg and pos then damageNumber(pos, dmg, head, kill, shieldOnly == true, target) end
end)

damagedRemote.OnClientEvent:Connect(function(fromPos: Vector3, dmg: number, _head: boolean, shieldOnly: boolean?, shieldBroke: boolean?, att: Instance?)
	if fromPos.Magnitude > 0 then damageIndicator(fromPos, att, dmg) end
	playSound(if shieldOnly then "shield" else ModeConfig.SOUNDS.hurt)
	if shieldBroke then playSound("shieldbreak") end
	hurtAlpha = math.max(hurtAlpha, math.min(0.95, 0.25 + dmg / 50) * (if shieldOnly then 0.4 else 1))
end)

-- ==========================================================================================
-- Bannière d'élimination (#killmsg) et grande bannière unique (#banner : séries, annonces du mode)
-- ==========================================================================================
-- fondu qui annule le précédent sur le même objet : sinon un fondu de sortie encore en cours
-- recouvrait la bannière suivante (texte qui disparaît trop tôt ou reste à moitié visible)
local liveFade: { [Instance]: Tween } = {}
local function fade(o: Instance, t: number, props: { [string]: any }): Tween
	local old = liveFade[o]
	if old then old:Cancel() end
	local tw = tween(o, t, props)
	liveFade[o] = tw
	return tw
end
-- modes à manches (web : G.mode === 'bomb') : pas de série d'éliminations affichée
local ROUND_MODES = { bomb = true, rapid = true, duel = true, gunfight = true }
local function roundMode(): boolean
	local md = player:GetAttribute("MatchMode")
	return typeof(md) == "string" and ROUND_MODES[md] == true
end

local killMsg = label(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(700, 26), TextSize = 18, Font = FONT,
	RichText = true, TextTransparency = 1, TextStrokeTransparency = 1, Text = "" })
local killScale = make("UIScale", { Scale = 1 }, killMsg)

-- une seule grande bannière à la fois, comme uiBanner() du web : la nouvelle remplace l'ancienne
-- (même cadre, mêmes fondus annulés), jamais deux textes l'un sur l'autre
local banTitle = titleLabel(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262), Size = UDim2.fromOffset(900, 60), TextSize = 56,
	TextColor3 = C.text, Text = "", TextTransparency = 1, ZIndex = 8 })
local banSub = label(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 324), Size = UDim2.fromOffset(900, 22), TextSize = 18, Font = Enum.Font.GothamBold,
	Text = "", TextTransparency = 1, TextStrokeTransparency = 1, ZIndex = 8 })
local banScale = make("UIScale", { Scale = 1 }, banTitle)
local banToken = 0
-- web : top 20 % ; jamais plus haut que 262 px, sous les lignes du mode (ModeHud : objectifs jusqu'à ~252 px)
local function showBanner(title: string, sub: string?, color: Color3?, subColor: Color3?, secs: number?)
	banToken += 1
	local my = banToken
	local y = math.max(camera.ViewportSize.Y * 0.2, 262)
	-- MedalController attend la fin de la bannière avant d'afficher sa médaille au même endroit
	gui:SetAttribute("BanUntil", os.clock() + (secs or 2) + 0.2)
	banTitle.Position = UDim2.new(0.5, 0, 0, y); banSub.Position = UDim2.new(0.5, 0, 0, y + 62)
	banTitle.Text = spaced(title, 2); banTitle.TextColor3 = color or C.text
	banSub.Text = sub or ""; banSub.TextColor3 = subColor or color or C.text
	-- apparition vive (web : opacité + échelle 1,3 → 1 en 0,35 s)
	banTitle.TextTransparency = 0.5; fade(banTitle, 0.12, { TextTransparency = 0 })
	banSub.TextTransparency = 0.5; banSub.TextStrokeTransparency = 1; fade(banSub, 0.12, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
	banScale.Scale = 1.3; tween(banScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	-- durée du web (2 s par défaut), puis sortie courte ; le texte est vidé pour que rien ne traîne
	task.delay(secs or 2, function()
		if my ~= banToken then return end
		fade(banTitle, 0.15, { TextTransparency = 1 }); fade(banSub, 0.15, { TextTransparency = 1, TextStrokeTransparency = 1 })
		task.delay(0.2, function()
			if my ~= banToken then return end
			banTitle.Text = ""; banSub.Text = ""
		end)
	end)
end

local bannerToken = 0
bannerRemote.OnClientEvent:Connect(function(b: any)
	bannerToken += 1
	local my = bannerToken
	local rounds = roundMode()
	local streak = if typeof(b.streak) == "number" then b.streak else 0
	killMsg.Text = spaced((if b.headshot then "TIR À LA TÊTE" else "ÉLIMINATION") .. "  +" .. tostring(b.points), 1) .. '   <font color="#ffd75e">' .. tostring(b.victim) .. "</font>"
		.. (if streak >= 2 and not rounds then '   <font color="#8da0bd">' .. streak .. " d'affilée</font>" else "")
	fade(killMsg, 0.1, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
	killScale.Scale = 1.3
	tween(killScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(1.8, function()
		if my ~= bannerToken then return end
		fade(killMsg, 0.2, { TextTransparency = 1, TextStrokeTransparency = 1 })
	end)
	if typeof(b.streakName) == "string" and not rounds then
		showBanner(upper(b.streakName), spaced(streak .. " ÉLIMINATIONS D'AFFILÉE", 1), C.text, C.gold)
		playSound(ModeConfig.SOUNDS.streak)
	end
end)

-- ==========================================================================================
-- Écran de mort + réapparition (#respawn du web)
-- ==========================================================================================
local deathFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(30, 0, 5), BackgroundTransparency = 1, Visible = false, ZIndex = 5 }, gui)
local deathTitle = label(deathFrame, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.58), Size = UDim2.fromOffset(700, 26), TextSize = 18, Font = FONT,
	ZIndex = 6, RichText = true, TextStrokeTransparency = 0.5, Text = "" })
local respawnNum = label(deathFrame, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.36), Size = UDim2.fromOffset(300, 70), TextSize = 64, Font = FONT,
	ZIndex = 6, TextStrokeTransparency = 0.6, Text = "" })
local respawnHint = label(deathFrame, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.36, 74), Size = UDim2.fromOffset(700, 20), TextSize = 14, Font = FONT, ZIndex = 6,
	TextColor3 = C.gold, TextStrokeTransparency = 0.6, Text = spaced("RÉAPPARITION — B : CHOISIR UNE ARME", 1) })
local deathToken = 0
deathRemote.OnClientEvent:Connect(function(d: any)
	deathFrame.Visible = true; deathFrame.BackgroundTransparency = 1
	tween(deathFrame, 0.4, { BackgroundTransparency = 0.6 })
	deathTitle.Text = spaced("ÉLIMINÉ PAR", 1) .. '  <font color="#ffd75e">' .. tostring(d.killer) .. "</font>   " .. '<font color="#8da0bd">' .. tostring(d.weapon)
		.. (if d.headshot then " · tête" else "") .. "</font>"
	-- pas de réapparition (manches, Élimination) : respawn est absent ; une nouvelle mort relance le compte à rebours
	local left = if typeof(d.respawn) == "number" then math.ceil(d.respawn) else 0
	respawnHint.Visible = left > 0
	deathToken += 1
	local my = deathToken
	task.spawn(function()
		while left > 0 and deathFrame.Visible and my == deathToken do
			respawnNum.Text = tostring(left)
			task.wait(1); left -= 1
		end
		if my == deathToken then respawnNum.Text = "" end
	end)
end)

-- ==========================================================================================
-- Tableau des scores (Tab)
-- ==========================================================================================
local board = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(820, 460), BackgroundColor3 = C.bg,
	BackgroundTransparency = 0.08, Visible = false, ZIndex = 20 }, gui)
corner(board, 6); stroke(board, C.line, 1.5, 0.2)
local boardScale = make("UIScale", { Scale = 1 }, board)
label(board, { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 26), TextSize = 18, Font = FONT, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 21,
	Text = spaced("MATCH À MORT PAR ÉQUIPE", 1) })
local boardTitle = board:FindFirstChildOfClass("TextLabel") :: TextLabel
local boardInfo = label(board, { Position = UDim2.fromOffset(20, 12), Size = UDim2.new(1, -40, 0, 26), TextSize = 14, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 21 })
local columns: { Frame } = {}
for i = 1, 2 do
	local col = make("Frame", { Position = UDim2.new((i - 1) * 0.5, if i == 1 then 16 else 8, 0, 50), Size = UDim2.new(0.5, -24, 1, -66), BackgroundTransparency = 1, ZIndex = 21 }, board)
	make("UIListLayout", { Padding = UDim.new(0, 3), SortOrder = Enum.SortOrder.LayoutOrder }, col)
	columns[i] = col
end
local function boardRow(parent: Instance, order: number, cells: { string }, color: Color3, bg: Color3?, bold: boolean?)
	local row = make("Frame", { Size = UDim2.new(1, 0, 0, 30), BackgroundColor3 = bg or C.panel2, BackgroundTransparency = if bg then 0.1 else 0.35, LayoutOrder = order, ZIndex = 21 }, parent)
	corner(row, 3)
	local widths = { 0.46, 0.12, 0.12, 0.12, 0.18 }
	local x = 0
	for i, text in ipairs(cells) do
		label(row, { Position = UDim2.new(x, if i == 1 then 10 else 0, 0, 0), Size = UDim2.new(widths[i], if i == 1 then -10 else 0, 1, 0), Text = text, ZIndex = 22,
			TextSize = if i == 1 then 14 else 13, TextColor3 = if i == 1 then color else C.text, Font = if bold then FONT else Enum.Font.GothamBold,
			TextXAlignment = if i == 1 then Enum.TextXAlignment.Left else Enum.TextXAlignment.Center, TextTruncate = Enum.TextTruncate.AtEnd })
		x += widths[i]
	end
end
local lastState: any = nil
local function renderBoard()
	local st = lastState
	if not st then return end
	for _, col in ipairs(columns) do for _, c in ipairs(col:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end end
	boardTitle.Text = spaced(string.upper(st.modeName or "Match à mort par équipe"), 1)
	boardInfo.Text = st.mapName .. (if st.timeLeft >= 0 then "   ·   " .. fmtTime(st.timeLeft) else "") .. (if st.killsToWin then "   ·   premier à " .. st.killsToWin else "")
	if not st.team then
		-- chacun pour soi : une seule liste, classée par points du mode (éliminations, niveau, points du Mastodonte…)
		local list = table.clone(st.board)
		table.sort(list, function(a: any, b: any) return (a.pts or 0) > (b.pts or 0) or ((a.pts or 0) == (b.pts or 0) and a.score > b.score) end)
		for ci, col in ipairs(columns) do
			boardRow(col, 0, { if ci == 1 then "JOUEUR" else "JOUEUR", "É", "M", "PTS", "SCORE" }, C.gold, rgb(0x1e2434), true)
		end
		for i, e in ipairs(list) do
			local col = columns[if i <= math.ceil(#list / 2) then 1 else 2]
			local isMe = e.userId == player.UserId
			boardRow(col, i, { i .. ". " .. (if e.bot then "[BOT] " else "") .. e.name, tostring(e.k), tostring(e.d), tostring(e.pts or 0), tostring(e.score) },
				if isMe then C.gold else C.text, if isMe then rgb(0x3c3418) else nil)
		end
		return
	end
	for i, team in ipairs(st.teams) do
		local col = columns[i]
		boardRow(col, 0, { string.upper(team) .. "   " .. (st.score[team] or 0), "É", "M", "A", "SCORE" }, teamColor(team), rgb(0x1e2434), true)
		local n = 0
		for _, e in ipairs(st.board) do
			if e.team == team then
				n += 1
				local mine = e.userId == player.UserId
				boardRow(col, n, { (if e.bot then "[BOT] " else "") .. e.name .. (if e.bot then "" else "  · " .. e.ping .. " ms"), tostring(e.k), tostring(e.d), tostring(e.a), tostring(e.score) },
					if mine then C.gold else C.text, if mine then rgb(0x3c3418) else nil)
			end
		end
	end
end
local function showBoard(on: boolean)
	if on == board.Visible then return end
	if on then
		renderBoard(); board.Visible = true; boardScale.Scale = 0.94
		tween(boardScale, 0.14, { Scale = 1 }, Enum.EasingStyle.Back)
	else
		board.Visible = false
	end
end
UserInputService.InputBegan:Connect(function(input, processed)
	if processed then return end   -- Tab dans le chat
	if input.KeyCode == Enum.KeyCode.Tab or input.KeyCode == Enum.KeyCode.ButtonSelect then showBoard(true) end
end)
UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == Enum.KeyCode.Tab or input.KeyCode == Enum.KeyCode.ButtonSelect then showBoard(false) end
end)
-- bouton tactile pour les téléphones
if UserInputService.TouchEnabled then
	local btn = make("TextButton", { AnchorPoint = Vector2.new(0, 0), Position = UDim2.fromOffset(16, RADAR + 46), Size = UDim2.fromOffset(90, 34), BackgroundColor3 = C.bg,
		BackgroundTransparency = 0.25, Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = C.text, Text = "Scores" }, gui)
	corner(btn, 3)
	btn.Activated:Connect(function() showBoard(not board.Visible) end)
end

-- ==========================================================================================
-- Écran de fin de partie
-- ==========================================================================================
local endFrame = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(5, 8, 14), BackgroundTransparency = 1, Visible = false, ZIndex = 30 }, gui)
local endTitle = titleLabel(endFrame, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.24), Size = UDim2.fromOffset(900, 90), TextSize = 88, ZIndex = 31 })
local endTitleScale = make("UIScale", { Scale = 1 }, endTitle)
local endScore = label(endFrame, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.34), Size = UDim2.fromOffset(600, 40), TextSize = 30, ZIndex = 31 })
local endCards = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(760, 150), BackgroundTransparency = 1, ZIndex = 31 }, endFrame)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 14) }, endCards)
local endNext = label(endFrame, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -40), Size = UDim2.fromOffset(600, 24), TextSize = 16, TextColor3 = C.dim, ZIndex = 31 })

-- bouton « Quitter la partie » (web : écran de fin -> Menu) ; Modal libère la souris en vue à la 1re personne
local endLeave = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -76), Size = UDim2.fromOffset(240, 40),
	BackgroundColor3 = C.panel2, BackgroundTransparency = 0.1, Text = spaced("QUITTER LA PARTIE", 1), TextColor3 = C.text, TextSize = 15, Font = FONT,
	AutoButtonColor = true, Modal = true, ZIndex = 32 }, endFrame)
corner(endLeave, 4)
make("UIStroke", { Color = C.red, Thickness = 1.5, Transparency = 0.2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, endLeave)
-- petits écrans (téléphone à l'horizontale : 844 × 390) : tout l'écran de fin rétrécit et les bandeaux du bas (bouton,
-- compte à rebours, vote de la carte de MapVoteController) se resserrent ; sinon cartes, bouton et vote se chevauchaient
local endScales: { UIScale } = {}
for _, o in ipairs({ endScore, endCards, endNext, endLeave } :: { GuiObject }) do table.insert(endScales, make("UIScale", { Scale = 1 }, o)) end
local function endLayout(): number
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	local k = math.clamp(math.min(vp.X / 1400, vp.Y / 800), 0.5, 1)
	for _, sc in ipairs(endScales) do sc.Scale = k end
	endLeave.Position = UDim2.new(0.5, 0, 1, -76 * k)
	endNext.Position = UDim2.new(0.5, 0, 1, -40 * k)
	return k
end

endLeave.Activated:Connect(function()
	endLeave.Text = spaced("RETOUR AU SALON…", 1)
	local ok = pcall(function() leaveFn:InvokeServer() end)
	endLeave.Text = spaced("QUITTER LA PARTIE", 1)
	if ok then endFrame.Visible = false end
end)

local endToken = 0
local function card(title: string, lines: { string }, accent: Color3, delay: number)
	local f = make("Frame", { Size = UDim2.fromOffset(240, 150), BackgroundColor3 = C.panel2, BackgroundTransparency = 1, ZIndex = 31 }, endCards)
	corner(f, 4)
	local st = make("UIStroke", { Color = accent, Thickness = 1.5, Transparency = 1 }, f)
	local t = label(f, { Position = UDim2.fromOffset(16, 12), Size = UDim2.new(1, -32, 0, 20), TextSize = 13, TextColor3 = accent, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 32, Text = spaced(string.upper(title), 1) })
	local items = {}
	for i, l in ipairs(lines) do
		table.insert(items, label(f, { Position = UDim2.fromOffset(16, 14 + i * 24), Size = UDim2.new(1, -32, 0, 22), TextSize = 17, TextXAlignment = Enum.TextXAlignment.Left, TextTransparency = 1, ZIndex = 32, Text = l }))
	end
	task.delay(delay, function()
		tween(f, 0.3, { BackgroundTransparency = 0.1 }); tween(st, 0.3, { Transparency = 0.2 }); tween(t, 0.3, { TextTransparency = 0 })
		for i, it in ipairs(items) do task.delay(i * 0.08, function() tween(it, 0.25, { TextTransparency = 0 }) end) end
	end)
end

endRemote.OnClientEvent:Connect(function(r: any)
	showBoard(false)
	deathFrame.Visible = false
	for _, c in ipairs(endCards:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	endFrame.Visible = true; endFrame.BackgroundTransparency = 1
	tween(endFrame, 0.5, { BackgroundTransparency = 0.25 })
	endTitle.Text = spaced(if r.draw then "ÉGALITÉ" elseif r.won then "VICTOIRE" else "DÉFAITE", 2)
	endTitle.TextColor3 = if r.draw then C.text elseif r.won then C.gold else C.red
	local k = endLayout()
	endTitleScale.Scale = 2.2 * k; endTitle.TextTransparency = 1
	tween(endTitleScale, 0.5, { Scale = k }, Enum.EasingStyle.Back); tween(endTitle, 0.3, { TextTransparency = 0 })
	local t1, t2 = lastState and lastState.teams[1] or "", lastState and lastState.teams[2] or ""
	if r.team then
		endScore.Text = string.format("%s  %d  —  %d  %s", t1, r.score[t1] or 0, r.score[t2] or 0, t2)
	else
		endScore.Text = if r.winner then "Vainqueur : " .. tostring(r.winner) else (r.modeName or "")
	end
	if r.me then
		card("Ta partie", { r.me.k .. " éliminations · " .. r.me.d .. " morts", r.me.a .. " assistances · " .. r.me.hs .. " à la tête", r.me.dmg .. " dégâts",
			"Meilleure série : " .. r.me.bestStreak }, C.blue, 0.5)
	end
	if r.mvp then
		card("Meilleur joueur", { (if r.mvp.bot then "[BOT] " else "") .. r.mvp.name, r.mvp.k .. " éliminations", r.mvp.score .. " points" }, C.gold, 0.7)
	end
	if r.rewards and not r.recap then   -- avec le bilan détaillé (RewardScreen, à droite), pas de 3e carte
		local lines = { "+" .. r.rewards.xp .. " XP", "+" .. r.rewards.coins .. " pièces" }
		local ups = r.rewards.levelUps
		if typeof(ups) == "table" and #ups > 0 then table.insert(lines, "Niveau supérieur !") end
		if r.progress and (r.progress.tiersGained or 0) > 0 then table.insert(lines, "+" .. r.progress.tiersGained .. " palier(s) du passe") end
		card("Récompenses", lines, C.green, 0.9)
	end
	endToken += 1
	local my = endToken
	task.spawn(function()
		local left = r.next or 15
		while left > 0 and endFrame.Visible and my == endToken do
			endNext.Text = "Prochaine partie dans " .. left .. " s — même mode"
			task.wait(1); left -= 1
		end
	end)
end)

-- ==========================================================================================
-- Mise à jour continue
-- ==========================================================================================
local inMatch = false
-- ligne du mode (web : #shpHud, #jugHud, #kcHud… au-dessus du centre de l'écran)
local modeLine = label(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 104), Size = UDim2.fromOffset(700, 20), TextSize = 15,
	Font = FONT, TextColor3 = C.gold, Text = "", TextStrokeTransparency = 0.5 })
local modeSub = label(gui, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 124), Size = UDim2.fromOffset(700, 16), TextSize = 12,
	Font = Enum.Font.GothamBold, TextColor3 = rgb(0xdfe6f2), Text = "", TextStrokeTransparency = 0.5 })
-- grande bannière du mode (uiBanner du web : « NOUVELLE ARME », « TU ES LE MASTODONTE », « MI-TEMPS »…) :
-- même cadre que les séries (showBanner), la dernière arrivée remplace l'autre
local annRemote = ReplicatedStorage:WaitForChild("MatchAnnounce", 20) :: RemoteEvent?
if annRemote then
	annRemote.OnClientEvent:Connect(function(title: string, sub: string?, color: Color3?)
		-- web : 2 s, un peu plus quand une ligne d'explication suit (MI-TEMPS : 3,6 s)
		local long = typeof(sub) == "string" and #sub > 40
		showBanner(tostring(title), sub, color or C.gold, rgb(0xdfe6f2), if long then 3.2 else 2)
		playSound(ModeConfig.SOUNDS.streak)
	end)
end
-- petit message de mode au centre (« ÉLIMINATION CONFIRMÉE +1 », « +150 »…)
-- sous la bannière d'élimination (58 %) : elle ne monte plus dessus
local popLabel = label(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.66), Size = UDim2.fromOffset(600, 26), TextSize = 20, Font = FONT,
	Text = "", TextTransparency = 1, TextStrokeTransparency = 1 })
local popToken = 0
local popRemote = ReplicatedStorage:WaitForChild("ModePop", 20) :: RemoteEvent?
if popRemote then
	popRemote.OnClientEvent:Connect(function(text: string, color: Color3?, sound: string?)
		popToken += 1
		local my = popToken
		popLabel.Text = spaced(text, 1); popLabel.TextColor3 = color or C.gold
		popLabel.Position = UDim2.fromScale(0.5, 0.66)
		fade(popLabel, 0.08, { TextTransparency = 0, TextStrokeTransparency = 0.5 })
		tween(popLabel, 1.1, { Position = UDim2.fromScale(0.5, 0.64) })
		if sound then pcall(function() Sfx.play(sound) end) end
		task.delay(1, function() if my == popToken then fade(popLabel, 0.2, { TextTransparency = 1, TextStrokeTransparency = 1 }) end end)
	end)
end
player:GetAttributeChangedSignal("ModeLine"):Connect(function()
	local v = player:GetAttribute("ModeLine")
	if typeof(v) == "string" then modeLine.Text = v end
end)
player:GetAttributeChangedSignal("Zone"):Connect(function()
	if player:GetAttribute("Zone") ~= "match" then
		inMatch = false; top.Visible = false; radarWrap.Visible = false; phaseLabel.Text = ""; modeLine.Text = ""; modeSub.Text = ""
		endFrame.Visible = false; deathFrame.Visible = false; showBoard(false)
	end
end)
stateRemote.OnClientEvent:Connect(function(st: any)
	-- avec le lobby, le score du match à mort ne s'affiche que pour ceux qui y jouent
	inMatch = player:GetAttribute("Zone") == "match" and st.id == player:GetAttribute("MatchId")
	top.Visible = inMatch; radarWrap.Visible = inMatch
	if not inMatch then phaseLabel.Text = ""; modeLine.Text = ""; modeSub.Text = ""; return end
	lastState = st
	if typeof(st.mapId) == "string" and st.mapId ~= "" then buildRadar(st.mapId) end
	local mine = myTeam()
	if st.team then
		-- à gauche l'équipe bleue (Défenseurs), à droite l'orange (Attaquants), comme #top du web
		local l, r = st.teams[2], st.teams[1]
		scoreL.Text = tostring(st.score[l] or 0); scoreR.Text = tostring(st.score[r] or 0)
		borderL.BackgroundColor3 = teamColor(l); borderR.BackgroundColor3 = teamColor(r)
		scoreL.TextColor3 = if mine == l then C.text else rgb(0xd5deec)
		scoreR.TextColor3 = if mine == r then C.text else rgb(0xd5deec)
	else
		-- chacun pour soi (comme le web) : à gauche mon score, à droite celui du premier
		local me, best = 0, 0
		for _, e in ipairs(st.board) do
			if e.userId == player.UserId then me = e.pts or 0 end
			best = math.max(best, e.pts or 0)
		end
		scoreL.Text = tostring(me); scoreR.Text = tostring(best)
		aliveL.Text = "TOI"; aliveR.Text = "1ER"
		borderL.BackgroundColor3 = C.gold; borderR.BackgroundColor3 = st.modeColor or C.red
		scoreL.TextColor3 = C.text; scoreR.TextColor3 = rgb(0xd5deec)
	end
	timerLabel.Text = if st.timeLeft >= 0 then fmtTime(st.timeLeft) else "—"
	goalLabel.Text = if st.state == "live" and st.killsToWin then spaced("PREMIER À " .. st.killsToWin, 1) elseif st.state == "intermission" then spaced("PAUSE", 1) else spaced(string.upper(st.modeName or ""), 1)
	phaseLabel.Text = if st.state == "intermission" then spaced("NOUVELLE PARTIE DANS " .. st.timeLeft .. " S", 2)
		elseif st.warmup then spaced("PRÉPAREZ-VOUS…", 2)
		else ""
	-- ligne du mode (arme tournante, Mastodonte, infectés, plaques, score de l'entraînement…) sous le chrono
	local info = st.info
	local personal = player:GetAttribute("ModeLine")
	modeLine.Text = if typeof(personal) == "string" then personal elseif info and info.line then info.line else ""
	modeLine.TextColor3 = if info and info.color then info.color else C.gold
	modeSub.Text = if info and info.sub then info.sub else ""
	modeSub.TextColor3 = if info and info.subWarn then rgb(0xff6b6b) else rgb(0xdfe6f2)
	if info and info.kind == "kc" and st.data and st.data.tags and mine then
		local other = if mine == st.teams[1] then st.teams[2] else st.teams[1]
		modeSub.Text = "🏷 " .. (st.data.tags[other] or 0) .. " à confirmer     🏷 " .. (st.data.tags[mine] or 0) .. " à refuser"
	end
	if st.state == "live" and endFrame.Visible then endFrame.Visible = false end
	if board.Visible then renderBoard() end
end)

local ghostHp, ghostT = 100, 0
player.CharacterAdded:Connect(function(char)
	deathFrame.Visible = false
	ghostHp = 100
	local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
	if not hum then return end
	local last = hum.Health
	hum.HealthChanged:Connect(function(hp)
		if hp < last then ghostT = os.clock() + 0.45 end
		last = hp
	end)
end)

RunService.RenderStepped:Connect(function(dt: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local hp = if hum then math.max(0, hum.Health) else 0
	local maxHp = if hum then hum.MaxHealth else 100
	local frac = hp / maxHp
	local t = os.clock()
	-- spectateur (après la kill-cam, sans réapparition) : le voile rouge de l'écran de mort ne reste pas sur la vue
	if deathFrame.Visible and S.spectate ~= nil then deathFrame.Visible = false end
	-- vie : chiffre (rouge et qui pulse sous 30), jauge, traînée blanche qui rattrape la vie restante
	hpText.Text = tostring(math.ceil(hp))
	hpText.TextColor3 = if hp > 0 and hp < 30 then (if t % 0.8 < 0.4 then rgb(0xff5050) else rgb(0xff8080)) else C.text
	hpBar.Size = UDim2.fromScale(frac, 1)
	local hpPct = frac * 100
	if hpPct >= ghostHp or hp <= 0 then ghostHp = hpPct elseif t > ghostT then ghostHp = math.max(hpPct, ghostHp - dt * 70) end
	hpGhost.Size = UDim2.fromScale(ghostHp / 100, 1)
	-- bouclier
	local shield = char and char:GetAttribute("Shield")
	local sh = if typeof(shield) == "number" then shield else 0
	shieldText.Text = tostring(sh)
	shieldBar.Size = UDim2.fromScale(sh / Config.SHIELD_MAX, 1)
	-- voiles rouges
	hurtAlpha = math.max(0, hurtAlpha - dt / 0.7)
	setVeil(hurtVeil, hurtAlpha * 0.85)
	-- sous 30 PV, le bord bat plus vite et plus fort quand la santé baisse (src/8I_lowhp.js : période 1,1 s -> 0,7 s)
	local lowK = clamp(1 - hp / 30, 0, 1)
	lowPhase += dt * 2 * math.pi / (1.1 - 0.4 * lowK)
	setVeil(lowVeil, if hp > 0 and hp < 30 then (0.35 + 0.25 * math.sin(lowPhase)) * (0.85 + 0.35 * lowK) else 0)
	local prot = char and char:GetAttribute("ProtectedUntil")
	protectLabel.Text = if typeof(prot) == "number" and prot > workspace:GetServerTimeNow() then "◇ Protection d'apparition" else ""

	-- arme en main
	local key = player:GetAttribute("Weapon")
	local w = typeof(key) == "string" and Config.WEAPONS[key] or nil
	wpanel.Visible = w ~= nil
	if w then
		local k = key :: string
		local skin, camo = mySkin(k)
		local skinId = tostring(skin) .. "/" .. tostring(camo)
		if panelKey ~= k or panelSkin ~= skinId then
			panelKey = k; panelSkin = skinId
			for _, c in ipairs(wIconHolder:GetChildren()) do c:Destroy() end
			weaponIcon(wIconHolder, k, Vector2.new(120, 52), nil, skin, camo)
			wName.Text = spaced(string.upper(w.name), 2)
			pipMax = -1
		end
		local mag = player:GetAttribute("Mag") :: number? or 0
		if w.melee then
			magText.Text = "—"; reserveText.Text = ""
		else
			magText.Text = tostring(mag)
			reserveText.Text = "/ " .. tostring(player:GetAttribute("Reserve") or 0)
			reserveText.Position = UDim2.new(1, -176 + magText.AbsoluteSize.X + 4, 0, 36)
		end
		magText.TextColor3 = if not w.melee and mag <= math.ceil(w.mag * 0.2) then rgb(0xff6b6b) else C.text
		-- balles du chargeur
		local maxPips = if w.melee then 0 else math.min(w.mag, 50)
		if maxPips ~= pipMax then
			pipMax = maxPips
			for _, p in ipairs(pipList) do p:Destroy() end
			pipList = {}
			local pw = if maxPips > 36 then 2 else 3
			for i = 1, maxPips do pipList[i] = make("Frame", { Size = UDim2.fromOffset(pw, 6), BackgroundColor3 = C.gold, LayoutOrder = i }, pips) end
		end
		local shown = if w.mag > 50 then math.ceil(mag / w.mag * 50) else mag
		for i, p in ipairs(pipList) do p.BackgroundTransparency = if i <= shown then 0 else 0.8 end
		-- recharge sous le viseur
		local reloading = player:GetAttribute("Reloading") == true
		relBar.Visible = reloading
		if reloading then
			local started = player:GetAttribute("ReloadStart") :: number? or t
			local dur = player:GetAttribute("ReloadDur")          -- durée réelle (accessoires, atouts) : WeaponController
			relFill.Size = UDim2.fromScale(clamp((t - started) / math.max(if typeof(dur) == "number" and dur > 0 then dur else w.reload, 0.1), 0, 1), 1)
		end
	else
		relBar.Visible = false
	end
	-- emplacements
	local loadout = string.split(tostring(player:GetAttribute("Loadout") or ""), ",")
	local slot = player:GetAttribute("Slot") :: number? or 1
	for i, s in ipairs(slots) do
		local k = loadout[i]
		local wk = k and Config.WEAPONS[k]
		s.frame.Visible = wk ~= nil
		if wk then
			local skin, camo = mySkin(k)
			local id = tostring(skin) .. "/" .. tostring(camo)
			if s.key ~= k or s.skin ~= id then
				s.key = k; s.skin = id
				if s.icon then s.icon:Destroy() end
				s.icon = weaponIcon(s.frame, k, Vector2.new(46, 18), { Position = UDim2.fromOffset(20, 4) }, skin, camo)
			end
			local on = i == slot
			s.border.Transparency = if on then 0 else 1
			s.num.TextColor3 = if on then C.text else C.dim
		end
	end
	-- haut : soldats en vie, chrono pressé
	if inMatch and lastState then
		local alive: { [string]: number } = {}
		for _, so in ipairs(soldierList()) do if so.alive and so.team then alive[so.team] = (alive[so.team] or 0) + 1 end end
		local l, r = lastState.teams[2], lastState.teams[1]
		aliveL.Text = (alive[l] or 0) .. " en vie"; aliveR.Text = (alive[r] or 0) .. " en vie"
		timerLabel.TextColor3 = if lastState.state == "live" and lastState.timeLeft <= 30 then (if t % 1 < 0.5 then rgb(0xff5050) else rgb(0xff9090)) else C.text
	end
	-- radar
	if inMatch then drawRadar(dt) end
	-- direction des tirs reçus
	local cf = camera.CFrame
	for _, d in ipairs(dirs) do
		d.t += dt
		if d.t > 1.6 then d.arc.BackgroundTransparency = 1; d.chev.TextTransparency = 1; continue end
		if d.att and d.att:IsA("Model") then
			local r = d.att:FindFirstChild("HumanoidRootPart") :: BasePart?
			if r then d.from = r.Position end
		end
		local rel = cf:VectorToObjectSpace(d.from - cf.Position)
		d.holder.Rotation = math.deg(math.atan2(rel.X, -rel.Z))
		local a = d.k * (if d.t < 1 then 1 else 1 - (d.t - 1) / 0.6)
		d.arc.BackgroundTransparency = 1 - a; d.chev.TextTransparency = 1 - a
	end
	updateNumbers(dt)
	local showXh = ModeConfig.CENTER_DOT and player:GetAttribute("Aiming") ~= true and hp > 0
	local style, col = S.opt.xhStyle or "dot", S.opt.xhColor or C.text
	dot.Visible = showXh and (style == "dot" or style == "circle")
	xhCross.Visible = showXh and style == "cross"
	xhCircle.Visible = showXh and style == "circle"
	dot.BackgroundColor3 = col; xhRing.Color = col
	for _, b in ipairs(xhBars) do b.BackgroundColor3 = col end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="805">
        <Properties>
          <string name="Name">KillFxController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/KillFxController (LocalScript)
-- Joue les effets d'élimination (KillFxConfig) : le corps de l'ennemi éliminé disparaît en confettis, en pixels,
-- s'envole, gèle, se fait foudroyer… Tout est local et purement visuel : chaque client joue l'effet de son côté.
-- Le corps réel est seulement masqué (LocalTransparencyModifier) : le serveur le supprime ensuite comme d'habitude.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local fxEvent = ReplicatedStorage:WaitForChild("KillFx") :: RemoteEvent

local fxFolder = Instance.new("Folder"); fxFolder.Name = "KillFxLocal"; fxFolder.Parent = workspace

-- ---------- outils ----------
type Snap = { cf: CFrame, size: Vector3, color: Color3 }

local function snapshot(char: Model): { Snap }
	local list = {}
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") and d.Name ~= "HumanoidRootPart" and not d:FindFirstAncestor("HeldWeapon") and d.Transparency < 0.9 then
			table.insert(list, { cf = d.CFrame, size = d.Size, color = d.Color })
		end
	end
	return list
end

local function hideBody(char: Model)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("BasePart") then d.LocalTransparencyModifier = 1
		elseif d:IsA("Decal") then pcall(function() (d :: any).LocalTransparencyModifier = 1 end) end
	end
end

local function sound(id: string, pos: Vector3, volume: number, pitch: number)
	local a = Instance.new("Attachment"); a.WorldPosition = pos; a.Parent = workspace.Terrain
	local s = Instance.new("Sound"); s.SoundId = id; s.Volume = volume; s.PlaybackSpeed = pitch
	s.RollOffMaxDistance = 220; s.Parent = a
	s:Play()
	Debris:AddItem(a, 4)
end

local function newPart(props: { [string]: any }): Part
	local p = Instance.new("Part")
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	for k, v in pairs(props) do (p :: any)[k] = v end
	p.Parent = fxFolder
	return p
end

local function tween(o: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- copie « fantôme » de chaque partie du corps (sert à plusieurs effets)
local function ghostCopies(snaps: { Snap }, color: Color3?, material: Enum.Material, transparency: number): { Part }
	local out = {}
	for _, s in ipairs(snaps) do
		table.insert(out, newPart({ CFrame = s.cf, Size = s.size, Color = color or s.color, Material = material, Transparency = transparency }))
	end
	return out
end

local function burstEmitter(pos: Vector3, props: { [string]: any }, count: number, life: number)
	local holder = newPart({ Size = Vector3.one, Transparency = 1, Position = pos })
	local pe = Instance.new("ParticleEmitter")
	pe.Rate = 0; pe.Enabled = true
	for k, v in pairs(props) do (pe :: any)[k] = v end
	pe.Parent = holder
	pe:Emit(count)
	Debris:AddItem(holder, life)
end

local function light(pos: Vector3, color: Color3, range: number, brightness: number, t: number)
	local holder = newPart({ Size = Vector3.one, Transparency = 1, Position = pos })
	local l = Instance.new("PointLight"); l.Color = color; l.Range = range; l.Brightness = brightness; l.Parent = holder
	tween(l, t, { Brightness = 0 })
	Debris:AddItem(holder, t + 0.1)
end

local RAINBOW = ColorSequence.new({
	ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 80, 80)), ColorSequenceKeypoint.new(0.25, Color3.fromRGB(255, 210, 60)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(80, 255, 140)), ColorSequenceKeypoint.new(0.75, Color3.fromRGB(80, 170, 255)),
	ColorSequenceKeypoint.new(1, Color3.fromRGB(220, 90, 255)),
})

-- ---------- effets ----------
local EFFECTS: { [string]: (Model, Vector3, { Snap }) -> () } = {}

-- Confettis : le corps éclate en une pluie de confettis multicolores
EFFECTS.confetti = function(char, pos, _snaps)
	hideBody(char)
	burstEmitter(pos, { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = RAINBOW, Lifetime = NumberRange.new(1.2, 2),
		Speed = NumberRange.new(14, 30), SpreadAngle = Vector2.new(180, 180), Acceleration = Vector3.new(0, -25, 0), Drag = 2,
		Size = NumberSequence.new(0.5, 0.2), Rotation = NumberRange.new(0, 360), RotSpeed = NumberRange.new(-300, 300) }, 120, 3)
	sound("rbxasset://sounds/electronicpingshort.wav", pos, 0.7, 1.8)
end

-- Désintégration pixel : le corps se décompose en petits cubes de sa couleur
EFFECTS.pixels = function(char, pos, snaps)
	hideBody(char)
	local made = 0
	for _, s in ipairs(snaps) do
		local n = math.clamp(math.floor(s.size.Magnitude * 2), 3, 10)
		for _ = 1, n do
			if made >= 70 then break end
			made += 1
			local offset = Vector3.new((math.random() - 0.5) * s.size.X, (math.random() - 0.5) * s.size.Y, (math.random() - 0.5) * s.size.Z)
			local cube = newPart({ Size = Vector3.one * 0.45, CFrame = s.cf * CFrame.new(offset), Color = s.color, Material = Enum.Material.SmoothPlastic })
			cube.Anchored = false; cube.CanCollide = true
			cube.AssemblyLinearVelocity = ((cube.Position - pos).Unit + Vector3.new(0, 0.8, 0)) * (10 + math.random() * 14)
			task.delay(0.9 + math.random() * 0.5, function() tween(cube, 0.6, { Transparency = 1, Size = Vector3.one * 0.1 }) end)
			Debris:AddItem(cube, 2.2)
		end
	end
	sound("rbxasset://sounds/clickfast.wav", pos, 0.8, 0.7)
end

-- Envol céleste : une silhouette lumineuse monte vers le ciel dans un rayon de lumière
EFFECTS.ascend = function(char, pos, snaps)
	hideBody(char)
	local gold = Color3.fromRGB(255, 236, 170)
	for _, p in ipairs(ghostCopies(snaps, gold, Enum.Material.Neon, 0.25)) do
		tween(p, 2.4, { CFrame = p.CFrame + Vector3.new(0, 26, 0), Transparency = 1 }, Enum.EasingStyle.Sine, Enum.EasingDirection.In)
		Debris:AddItem(p, 2.5)
	end
	local beam = newPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(80, 5, 5), CFrame = CFrame.new(pos + Vector3.new(0, 38, 0)) * CFrame.Angles(0, 0, math.rad(90)),
		Color = gold, Material = Enum.Material.Neon, Transparency = 0.55 })
	tween(beam, 2.4, { Transparency = 1, Size = Vector3.new(80, 1, 1) })
	Debris:AddItem(beam, 2.5)
	burstEmitter(pos, { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(gold), Lifetime = NumberRange.new(1.5, 2.2),
		Speed = NumberRange.new(4, 10), SpreadAngle = Vector2.new(40, 40), Acceleration = Vector3.new(0, 12, 0), Size = NumberSequence.new(0.6, 0) }, 60, 3)
	light(pos, gold, 22, 4, 2.2)
	sound("rbxasset://sounds/victory.wav", pos, 0.45, 1.5)
end

-- Coup de foudre : un éclair tombe du ciel, le corps est carbonisé puis s'effondre en cendres
EFFECTS.lightning = function(char, pos, snaps)
	hideBody(char)
	local blue = Color3.fromRGB(150, 210, 255)
	local top = pos + Vector3.new(math.random(-6, 6), 70, math.random(-6, 6))
	local prev = top
	for i = 1, 7 do
		local t = i / 7
		local nextPos = top:Lerp(pos, t) + (if i < 7 then Vector3.new(math.random(-4, 4), 0, math.random(-4, 4)) else Vector3.zero)
		local len = (nextPos - prev).Magnitude
		local seg = newPart({ Size = Vector3.new(0.6, 0.6, len), CFrame = CFrame.lookAt(prev, nextPos) * CFrame.new(0, 0, -len / 2), Color = blue, Material = Enum.Material.Neon })
		tween(seg, 0.45, { Transparency = 1 })
		Debris:AddItem(seg, 0.5)
		prev = nextPos
	end
	light(pos, blue, 40, 8, 0.6)
	local burnt = ghostCopies(snaps, Color3.fromRGB(28, 28, 30), Enum.Material.Slate, 0)
	task.delay(0.7, function()
		for _, p in ipairs(burnt) do
			p.Anchored = false; p.CanCollide = true
			p.AssemblyLinearVelocity = Vector3.new(math.random(-4, 4), 2, math.random(-4, 4))
			tween(p, 1.2, { Transparency = 1, Size = p.Size * 0.4 })
			Debris:AddItem(p, 1.3)
		end
		burstEmitter(pos, { Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(Color3.fromRGB(60, 60, 64)),
			Lifetime = NumberRange.new(1, 1.6), Speed = NumberRange.new(2, 6), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(2, 5),
			Transparency = NumberSequence.new(0.3, 1) }, 25, 2)
	end)
	sound("rbxasset://sounds/Rocket shot.wav", pos, 1, 0.6)
end

-- Statue de glace : le corps gèle sur place puis vole en éclats
EFFECTS.ice = function(char, pos, snaps)
	hideBody(char)
	local frozen = ghostCopies(snaps, Color3.fromRGB(175, 225, 255), Enum.Material.Ice, 0.15)
	sound("rbxasset://sounds/swordhit.wav", pos, 0.7, 1.7)
	task.delay(1.3, function()
		for _, p in ipairs(frozen) do
			for _ = 1, 3 do
				local shard = newPart({ Size = p.Size * Vector3.new(0.45, 0.45, 0.45), CFrame = p.CFrame * CFrame.Angles(math.random() * 3, math.random() * 3, 0),
					Color = p.Color, Material = Enum.Material.Ice, Transparency = 0.15 })
				shard.Anchored = false; shard.CanCollide = true
				shard.AssemblyLinearVelocity = ((shard.Position - pos).Unit + Vector3.new(0, 0.6, 0)) * (12 + math.random() * 10)
				tween(shard, 1.4, { Transparency = 1 })
				Debris:AddItem(shard, 1.5)
			end
			p:Destroy()
		end
		sound("rbxasset://sounds/clickfast.wav", pos, 0.9, 1.3)
	end)
end

-- Trou noir : le corps est aspiré en tournoyant dans une sphère sombre
EFFECTS.blackhole = function(char, pos, snaps)
	hideBody(char)
	local purple = Color3.fromRGB(150, 70, 255)
	local core = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Position = pos, Color = Color3.new(0, 0, 0), Material = Enum.Material.Neon })
	local ring = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.one * 0.2, Position = pos, Color = purple, Material = Enum.Material.Neon, Transparency = 0.6 })
	tween(core, 0.35, { Size = Vector3.one * 5 }, Enum.EasingStyle.Back)
	tween(ring, 0.35, { Size = Vector3.one * 7 }, Enum.EasingStyle.Back)
	for _, p in ipairs(ghostCopies(snaps, nil, Enum.Material.SmoothPlastic, 0)) do
		tween(p, 1.1, { CFrame = CFrame.new(pos) * CFrame.Angles(math.random() * 6, math.random() * 6, math.random() * 6), Size = Vector3.one * 0.1 },
			Enum.EasingStyle.Quad, Enum.EasingDirection.In)
		Debris:AddItem(p, 1.15)
	end
	task.delay(1.2, function()
		tween(core, 0.3, { Size = Vector3.one * 0.1 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		tween(ring, 0.3, { Size = Vector3.one * 0.1, Transparency = 1 })
		burstEmitter(pos, { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(purple), Lifetime = NumberRange.new(0.5, 0.9),
			Speed = NumberRange.new(20, 30), SpreadAngle = Vector2.new(180, 180), Size = NumberSequence.new(0.5, 0) }, 50, 1.5)
	end)
	Debris:AddItem(core, 1.6); Debris:AddItem(ring, 1.6)
	light(pos, purple, 18, 3, 1.5)
	sound("rbxasset://sounds/electronicpingshort.wav", pos, 0.8, 0.45)
end

-- Pluie de citrouilles : le corps éclate en citrouilles qui rebondissent (code HALLOWEEN25)
EFFECTS.pumpkins = function(char, pos, _snaps)
	hideBody(char)
	local orange = Color3.fromRGB(255, 122, 26)
	for i = 1, 8 do
		local a = i / 8 * math.pi * 2
		local pk = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.6, 1.3, 1.6), Position = pos + Vector3.new(0, 1, 0), Color = orange, Material = Enum.Material.SmoothPlastic })
		local stem = newPart({ Size = Vector3.new(0.25, 0.45, 0.25), Color = Color3.fromRGB(70, 130, 40), CFrame = pk.CFrame * CFrame.new(0, 0.75, 0) })
		stem.Anchored = false; stem.Massless = true
		local w = Instance.new("WeldConstraint"); w.Part0 = pk; w.Part1 = stem; w.Parent = pk
		pk.Anchored = false; pk.CanCollide = true
		pk.AssemblyLinearVelocity = Vector3.new(math.cos(a) * 14, 22 + math.random() * 8, math.sin(a) * 14)
		task.delay(2.2, function() tween(pk, 0.5, { Transparency = 1 }); tween(stem, 0.5, { Transparency = 1 }) end)
		Debris:AddItem(pk, 2.8)
	end
	light(pos, orange, 16, 3, 1.5)
	sound("rbxasset://sounds/swordhit.wav", pos, 0.6, 0.8)
end

-- Esprit du groupe : un esprit turquoise s'élève en ondulant (récompense du groupe Roblox)
EFFECTS.spirit = function(char, pos, snaps)
	hideBody(char)
	local teal = Color3.fromRGB(80, 255, 220)
	for _, p in ipairs(ghostCopies(snaps, teal, Enum.Material.ForceField, 0.1)) do
		local start = p.CFrame
		task.spawn(function()
			local t0 = os.clock()
			while p.Parent and os.clock() - t0 < 2.2 do
				local t = os.clock() - t0
				p.CFrame = start + Vector3.new(math.sin(t * 5) * 1.2, t * 9, math.cos(t * 4) * 0.6)
				p.Transparency = math.min(1, 0.1 + t / 2.2)
				task.wait()
			end
			p:Destroy()
		end)
	end
	burstEmitter(pos, { Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(teal), Lifetime = NumberRange.new(1.2, 2),
		Speed = NumberRange.new(2, 5), SpreadAngle = Vector2.new(60, 60), Acceleration = Vector3.new(0, 6, 0), Size = NumberSequence.new(1.5, 3),
		Transparency = NumberSequence.new(0.5, 1) }, 30, 2.5)
	light(pos, teal, 18, 3, 2)
	sound("rbxasset://sounds/electronicpingshort.wav", pos, 0.6, 1.2)
end

-- ---------- effets de l'événement d'Halloween (src/8W_halloween.js HWFX) : le corps reste, l'effet s'y ajoute ----------
local RunService = game:GetService("RunService")
-- petite boucle d'animation : fn(t) renvoie false quand c'est fini
local function animate(life: number, fn: (number, number) -> ())
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt)
		local t = os.clock() - t0
		if t >= life then conn:Disconnect(); fn(life, dt); return end
		fn(t, dt)
	end)
end
local BAT = Color3.fromRGB(11, 7, 16)
-- Nuée de chauves-souris : 22 chauves-souris s'échappent en battant des ailes, lueur violette
EFFECTS.bats = function(_char, pos, _snaps)
	local origin = pos + Vector3.new(0, 1.5, 0)
	for _ = 1, 22 do
		local body = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.35, 0.3, 0.45), Color = BAT, Material = Enum.Material.SmoothPlastic,
			Position = origin + Vector3.new(math.random() - 0.5, math.random() - 0.6, math.random() - 0.5) * 0.8 })
		local wl = newPart({ Size = Vector3.new(0.9, 0.05, 0.4), Color = BAT, Material = Enum.Material.SmoothPlastic })
		local wr = newPart({ Size = Vector3.new(0.9, 0.05, 0.4), Color = BAT, Material = Enum.Material.SmoothPlastic })
		local eye = newPart({ Size = Vector3.new(0.18, 0.06, 0.04), Color = Color3.fromRGB(255, 48, 48), Material = Enum.Material.Neon })
		local a, sp, vy, sw, fl = math.random() * math.pi * 2, 4 + math.random() * 6, 3.5 + math.random() * 5.5, (math.random() - 0.5) * 6, 16 + math.random() * 8
		local life = 1.4 + math.random() * 0.8
		local p0 = body.Position
		animate(life, function(t, _dt)
			if t >= life then body:Destroy(); wl:Destroy(); wr:Destroy(); eye:Destroy(); return end
			local aa = a + sw * t * 0.4
			local p = p0 + Vector3.new(math.cos(aa) * sp * t, vy * t * (1 - t / life * 0.25), math.sin(aa) * sp * t)
			local cf = CFrame.lookAt(p, p + Vector3.new(math.cos(aa), 0.2, math.sin(aa)))
			local flap = math.sin(t * fl) * 0.9
			body.CFrame = cf
			wl.CFrame = cf * CFrame.new(-0.45, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(-0.2, 0, 0)
			wr.CFrame = cf * CFrame.new(0.45, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(0.2, 0, 0)
			eye.CFrame = cf * CFrame.new(0, 0.05, -0.22)
			local fade = math.clamp((life - t) / 0.4, 0, 1)
			body.Transparency = 1 - fade; wl.Transparency = 1 - fade; wr.Transparency = 1 - fade; eye.Transparency = 1 - fade
		end)
	end
	burstEmitter(origin, { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(Color3.fromRGB(138, 61, 255)),
		LightEmission = 1, Lifetime = NumberRange.new(0.7, 1.2), Speed = NumberRange.new(1, 3), SpreadAngle = Vector2.new(180, 180),
		Size = NumberSequence.new(1.6, 0.2), Transparency = NumberSequence.new(0.2, 1) }, 10, 1.5)
	sound("rbxasset://sounds/electronicpingshort.wav", pos, 0.5, 2.6)
end
-- Âme damnée : un crâne spectral vert monte en spirale, traînée d'étincelles vertes
EFFECTS.soul = function(_char, pos, _snaps)
	local green = Color3.fromRGB(109, 255, 122)
	local base = pos + Vector3.new(0, 1, 0)
	local skull = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(1.3, 1.3, 1.3), Color = Color3.fromRGB(190, 255, 200), Material = Enum.Material.Neon, Transparency = 0.15 })
	local jaw = newPart({ Size = Vector3.new(0.75, 0.4, 0.6), Color = Color3.fromRGB(190, 255, 200), Material = Enum.Material.Neon, Transparency = 0.15 })
	local eyes: { { p: Part, x: number } } = {}
	for _, sx in ipairs({ -0.25, 0.25 }) do
		table.insert(eyes, { p = newPart({ Shape = Enum.PartType.Ball, Size = Vector3.new(0.34, 0.4, 0.2), Color = Color3.fromRGB(10, 58, 24), Material = Enum.Material.SmoothPlastic }), x = sx })
	end
	local glow = Instance.new("PointLight"); glow.Color = green; glow.Range = 14; glow.Brightness = 3; glow.Parent = skull
	local cam = workspace.CurrentCamera
	animate(2.4, function(t, _dt)
		if t >= 2.4 then skull:Destroy(); jaw:Destroy(); for _, e in ipairs(eyes) do e.p:Destroy() end; return end
		local sc = 0.5 + t * 0.45
		local p = base + Vector3.new(math.cos(t * 5) * 0.35 * t * 3.6, t * 1.3 * 3.6, math.sin(t * 5) * 0.35 * t * 3.6)
		local look = if cam then cam.CFrame.Position else p + Vector3.new(0, 0, -1)
		local cf = CFrame.lookAt(p, Vector3.new(look.X, p.Y, look.Z))
		skull.Size = Vector3.new(1.3, 1.3, 1.3) * sc; skull.CFrame = cf
		jaw.Size = Vector3.new(0.75, 0.4, 0.6) * sc; jaw.CFrame = cf * CFrame.new(0, -0.6 * sc, -0.1 * sc)
		for _, e in ipairs(eyes) do e.p.Size = Vector3.new(0.34, 0.4, 0.2) * sc; e.p.CFrame = cf * CFrame.new(e.x * sc, 0.05 * sc, -0.55 * sc) end
		local fade = 1 - math.clamp((2.4 - t) / 0.6, 0, 1)
		skull.Transparency = 0.15 + fade * 0.85; jaw.Transparency = skull.Transparency
		for _, e in ipairs(eyes) do e.p.Transparency = fade end
		glow.Brightness = 3 * (1 - fade)
	end)
	burstEmitter(base - Vector3.new(0, 2, 0), { Texture = "rbxasset://textures/particles/sparkles_main.dds", Color = ColorSequence.new(green, Color3.fromRGB(184, 255, 176)),
		LightEmission = 1, Lifetime = NumberRange.new(1, 1.8), Speed = NumberRange.new(4, 9), SpreadAngle = Vector2.new(25, 25),
		Acceleration = Vector3.new(0, 4, 0), Drag = 1, Size = NumberSequence.new(0.6, 0.1), Transparency = NumberSequence.new(0, 1) }, 36, 2.2)
	light(base, green, 18, 3, 1.6)
	sound("rbxasset://sounds/electronicpingshort.wav", pos, 0.7, 0.55)
end
-- Pierre tombale : une tombe « R.I.P. » au nom de l'adversaire sort de terre, mottes de terre, lueur verte
EFFECTS.grave = function(char, pos, _snaps)
	local cam = workspace.CurrentCamera
	local from = if cam then cam.CFrame.Position else pos + Vector3.new(0, 0, 5)
	local away = Vector3.new(pos.X - from.X, 0, pos.Z - from.Z)
	away = if away.Magnitude > 0.01 then away.Unit else Vector3.new(0, 0, 1)
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude; params.FilterDescendantsInstances = { fxFolder, char }
	local hit = workspace:Raycast(pos + Vector3.new(0, 2, 0), Vector3.new(0, -14, 0), params)
	local ground = if hit then hit.Position.Y else pos.Y - 3
	local at = Vector3.new(pos.X, ground, pos.Z) + away * 3.2
	local stone = Color3.fromRGB(176, 180, 176)
	local slab = newPart({ Size = Vector3.new(2.9, 2.7, 0.7), Color = stone, Material = Enum.Material.Slate })
	local top = newPart({ Shape = Enum.PartType.Cylinder, Size = Vector3.new(0.7, 2.9, 2.9), Color = stone, Material = Enum.Material.Slate })
	local gui = Instance.new("SurfaceGui"); gui.Face = Enum.NormalId.Front; gui.CanvasSize = Vector2.new(256, 240); gui.LightInfluence = 1; gui.Parent = slab
	local rip = Instance.new("TextLabel"); rip.BackgroundTransparency = 1; rip.Size = UDim2.new(1, 0, 0.45, 0); rip.Font = Enum.Font.Garamond
	rip.TextScaled = true; rip.TextColor3 = Color3.fromRGB(42, 42, 46); rip.Text = "R.I.P."; rip.Parent = gui
	local nm = Instance.new("TextLabel"); nm.BackgroundTransparency = 1; nm.Position = UDim2.fromScale(0, 0.45); nm.Size = UDim2.new(1, 0, 0.3, 0)
	nm.Font = Enum.Font.Garamond; nm.TextScaled = true; nm.TextColor3 = Color3.fromRGB(42, 42, 46); nm.Text = string.upper(string.sub(char.Name, 1, 12)); nm.Parent = gui
	local face = CFrame.lookAt(at, Vector3.new(from.X, at.Y, from.Z)) * CFrame.Angles(0, 0, (math.random() - 0.5) * 0.16)
	animate(3.2, function(t, _dt)
		if t >= 3.2 then slab:Destroy(); top:Destroy(); return end
		local k = if t < 0.45 then -1 + (1 - (1 - t / 0.45) ^ 3) elseif t > 2.6 then -math.min(1, (t - 2.6) / 0.6) else 0
		local y = 1.35 + k * 4
		slab.CFrame = face * CFrame.new(0, y, 0)
		top.CFrame = face * CFrame.new(0, y + 1.35, 0) * CFrame.Angles(0, math.pi / 2, 0)
	end)
	burstEmitter(at + Vector3.new(0, 0.3, 0), { Color = ColorSequence.new(Color3.fromRGB(74, 58, 40), Color3.fromRGB(46, 36, 26)), Lifetime = NumberRange.new(0.6, 1.1),
		Speed = NumberRange.new(8, 16), SpreadAngle = Vector2.new(50, 50), Acceleration = Vector3.new(0, -40, 0), Size = NumberSequence.new(0.35, 0.2) }, 26, 1.5)
	burstEmitter(at + Vector3.new(0, 0.6, 0), { Texture = "rbxasset://textures/particles/smoke_main.dds", Color = ColorSequence.new(Color3.fromRGB(74, 154, 96)),
		LightEmission = 0.6, Lifetime = NumberRange.new(1.5, 2.5), Speed = NumberRange.new(0.5, 1.5), Size = NumberSequence.new(2, 3.5), Transparency = NumberSequence.new(0.5, 1) }, 10, 3)
	light(at + Vector3.new(0, 4, 0) - away * 2.8, Color3.fromRGB(154, 255, 176), 16, 3, 3.2)
	sound("rbxasset://sounds/collide.wav", at, 0.9, 0.5)
end

-- ---------- réception ----------
fxEvent.OnClientEvent:Connect(function(id: string, char: Model?, pos: Vector3, _killerId: number)
	local fn = EFFECTS[id]
	if not fn or typeof(pos) ~= "Vector3" then return end
	local snaps = if char and char.Parent then snapshot(char) else {}
	local ok, err = pcall(fn, char or Instance.new("Model"), pos, snaps)
	if not ok then warn("[KillFx] effet", id, err) end
end)

-- Aperçu depuis la boutique ou le casier : _G.PreviewKillFx("ice", position, personnage)
_G.PreviewKillFx = function(id: string, pos: Vector3, char: Model?)
	local fn = EFFECTS[id]
	if fn then fn(char or Instance.new("Model"), pos, if char then snapshot(char) else {}) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="806">
        <Properties>
          <string name="Name">KillcamController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/KillcamController (LocalScript)
-- KILL-CAM façon Call of Duty, comme le jeu web (src/8R_killcam.js + 6A_replay.js) :
-- quand on se fait éliminer en match à mort par équipe, on revoit les dernières secondes par les yeux du tueur,
-- avec son arme et ses bras en vue subjective, au ralenti autour du tir. La cible est zoomée quand le tueur la vise,
-- surlignée en rouge seulement quand un mur la cache, et un repère avec son nom flotte au-dessus d'elle.
-- ESPACE ou clic pour passer. La réapparition attend la fin de la kill-cam (KillcamHold, MatchService).
--
-- Enregistrement : chaque client garde en mémoire les 4 dernières secondes de tous les soldats (position de chaque
-- pièce du corps, regard, arme) et des tirs. À la mort, on fait des copies des soldats et on les rejoue.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local S = require(ReplicatedStorage.Shared.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local deathRemote = ReplicatedStorage:WaitForChild("DeathInfo") :: RemoteEvent
local tracerRemote = ReplicatedStorage:WaitForChild("Tracer") :: RemoteEvent
local holdRemote = ReplicatedStorage:WaitForChild("KillcamHold", 30) :: RemoteEvent?
local pitchRemote = ReplicatedStorage:WaitForChild("AimPitch", 30) :: UnreliableRemoteEvent?

local REC_DT = 1 / 20          -- 20 images par seconde
local KEEP = 4                 -- secondes gardées
local BEFORE, AFTER = 2.2, 0.5 -- fenêtre rejouée autour de l'élimination (web : 2,2 s avant, 0,6 s après)
local WAIT = 0.6               -- petite pause sur l'écran de mort avant la kill-cam (l'enregistrement continue)
local WORLD_SCALE = 2.9        -- arme tenue (même valeur que WeaponService)
local GRIP = CFrame.new(0, -0.1, 0) * CFrame.Angles(math.rad(-90), 0, 0)
local BASE_FOV = 70

-- ---------- regard envoyé au serveur (sert à la kill-cam des autres) ----------
local lastPitch, pitchT = 99, 0
RunService.Heartbeat:Connect(function(dt: number)
	pitchT += dt
	if pitchT < 0.1 or not pitchRemote then return end
	pitchT = 0
	-- kill-cam, arrivée, spectateur, mode photo : la caméra n'est pas notre regard
	if S.kc ~= nil or camera.CameraType ~= Enum.CameraType.Custom then return end
	local p = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
	if math.abs(p - lastPitch) > 0.01 then lastPitch = p; (pitchRemote :: UnreliableRemoteEvent):FireServer(p) end
end)

-- ---------- enregistrement ----------
type Snap = { cf: { [BasePart]: CFrame }, pitch: number, key: string?, speed: number, grounded: boolean, vy: number, alive: boolean }
type Frame = { t: number, m: { [Model]: Snap } }
local frames: { Frame } = {}
type Shot = { t: number, from: Vector3, to: Vector3, shooter: Instance? }
local shots: { Shot } = {}
local recording = true

local function soldiers(): { Model }
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		if c and c.Parent then table.insert(list, c) end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then for _, b in ipairs(bots:GetChildren()) do if b:IsA("Model") then table.insert(list, b) end end end
	return list
end

-- pièces du corps (sans l'arme tenue, refaite à part avec WeaponModels)
local function bodyParts(model: Model): { BasePart }
	local out = {}
	local held = model:FindFirstChild("HeldWeapon")
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") and not (held and d:IsDescendantOf(held)) and d ~= held then table.insert(out, d) end
	end
	return out
end

local function snapshot(model: Model): Snap?
	local root = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = model:FindFirstChildOfClass("Humanoid")
	if not root or not hum then return nil end
	local cf = {}
	for _, p in ipairs(bodyParts(model)) do cf[p] = p.CFrame end
	local held = model:FindFirstChild("HeldWeapon")
	local key = held and held:GetAttribute("Key")
	local v = root.AssemblyLinearVelocity
	return { cf = cf, pitch = (model:GetAttribute("Pitch") :: number?) or 0, key = if typeof(key) == "string" then key else nil,
		speed = Vector3.new(v.X, 0, v.Z).Magnitude, grounded = hum.FloorMaterial ~= Enum.Material.Air, vy = v.Y, alive = hum.Health > 0 }
end

local recAcc = 0
RunService.Heartbeat:Connect(function(dt: number)
	if not recording then return end
	recAcc += dt
	if recAcc < REC_DT then return end
	recAcc = 0
	local t = os.clock()
	local f: Frame = { t = t, m = {} }
	for _, m in ipairs(soldiers()) do
		local s = snapshot(m)
		if s then f.m[m] = s end
	end
	table.insert(frames, f)
	while #frames > 0 and frames[1].t < t - KEEP do table.remove(frames, 1) end
	while #shots > 0 and shots[1].t < t - KEEP do table.remove(shots, 1) end
end)

tracerRemote.OnClientEvent:Connect(function(origin: Vector3, endPos: Vector3, shooter: Instance?)
	if recording then table.insert(shots, { t = os.clock(), from = origin, to = endPos, shooter = shooter }) end
end)

-- ---------- interface (mêmes éléments que #rpov du web) ----------
local C = { red = Color3.fromRGB(255, 70, 85), text = Color3.new(1, 1, 1), dim = Color3.fromRGB(200, 205, 215) }
local gui = Instance.new("ScreenGui"); gui.Name = "Killcam"; gui.IgnoreGuiInset = true; gui.ResetOnSpawn = false
gui.DisplayOrder = 40; gui.Enabled = false; gui.Parent = player:WaitForChild("PlayerGui")
local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if class == "TextLabel" then o.BackgroundTransparency = 1; o.Font = Enum.Font.GothamBlack; o.TextColor3 = C.text end
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end   -- UICorner, UIStroke… n'ont pas de bordure (l'erreur arrêtait toute la kill-cam)
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
make("Frame", { Size = UDim2.fromScale(1, 0.1), BackgroundColor3 = Color3.new() }, gui)
make("Frame", { Size = UDim2.fromScale(1, 0.1), Position = UDim2.fromScale(0, 0.9), BackgroundColor3 = Color3.new() }, gui)
local tag = make("Frame", { Position = UDim2.fromScale(0.04, 0.125), Size = UDim2.fromOffset(260, 22), BackgroundTransparency = 1 }, gui)
local recDot = make("Frame", { Size = UDim2.fromOffset(12, 12), Position = UDim2.fromOffset(0, 5), BackgroundColor3 = Color3.fromRGB(255, 42, 58) }, tag)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, recDot)
make("TextLabel", { Position = UDim2.fromOffset(22, 0), Size = UDim2.new(1, -22, 1, 0), Text = "K I L L - C A M", TextSize = 16,
	TextXAlignment = Enum.TextXAlignment.Left, TextStrokeTransparency = 0.6 }, tag)
local who = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.fromScale(0.5, 0.87), Size = UDim2.new(1, 0, 0, 36),
	TextSize = 28, RichText = true, Text = "", TextStrokeTransparency = 0.5 }, gui)
-- carte de joueur du tueur (bannière + emblème choisis dans le Profil, Shared/PlayerCard), au-dessus de son nom
local PlayerCard = require(ReplicatedStorage.Shared.PlayerCard)
local cardBox = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 0.87, -40), Size = UDim2.fromOffset(320, 77), BackgroundTransparency = 1 }, gui)
local pg = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.894), Size = UDim2.new(0.4, 0, 0, 3),
	BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.8 }, gui)
local pgFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.red }, pg)
make("TextLabel", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(0.96, 0, 0.96, 0), Size = UDim2.fromOffset(300, 16),
	Text = "ESPACE — PASSER", TextSize = 12, Font = Enum.Font.GothamBold, TextColor3 = C.dim, TextTransparency = 0.3,
	TextXAlignment = Enum.TextXAlignment.Right }, gui)

-- repère au-dessus de la cible : nom sur fond rouge + chevron qui rebondit
local marker = Instance.new("BillboardGui"); marker.Name = "KillcamTarget"; marker.AlwaysOnTop = true
marker.Size = UDim2.fromOffset(160, 46); marker.StudsOffsetWorldSpace = Vector3.new(0, 2.6, 0); marker.LightInfluence = 0
local mName = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0), Size = UDim2.fromOffset(0, 20),
	AutomaticSize = Enum.AutomaticSize.X, BackgroundTransparency = 0.2, BackgroundColor3 = Color3.fromRGB(255, 59, 75), TextSize = 13, Text = "" }, marker)
make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, mName)
make("UICorner", { CornerRadius = UDim.new(0, 3) }, mName)
local chevron = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 20), Size = UDim2.fromOffset(30, 22),
	Text = "▼", TextSize = 20, TextColor3 = Color3.fromRGB(255, 59, 75), TextStrokeTransparency = 0.4 }, marker)

-- ---------- rediffusion ----------
type Ghost = { model: Model, map: { [BasePart]: BasePart }, alpha: { [BasePart]: number }, gun: Model?, gunKey: string?, hand: BasePart?, src: Model, skin: number?, camo: string? }
local KC = {
	on = false, setup = false, rt = 0, prev = 0, t0 = 0, t1 = 0, tk = 0, hold = 0, wait = 0, blood = false, zoom = 1,
	killer = nil :: Model?, victim = nil :: Model?, ghosts = {} :: { [Model]: Ghost }, hidden = {} :: { BasePart },
	guis = {} :: { ScreenGui }, info = nil :: any, highlight = nil :: Highlight?, rpShots = {} :: { Shot },
	skin = nil :: number?, camo = nil :: string?, savedType = Enum.CameraType.Custom, savedFov = BASE_FOV,
}

-- copie d'un soldat : pièces ancrées, sans articulations, sans scripts ; reliée pièce à pièce à l'original
local function makeGhost(src: Model): Ghost?
	local was = src.Archivable
	src.Archivable = true
	local ok, copy = pcall(function() return src:Clone() end)
	src.Archivable = was
	if not ok or not copy then return nil end
	local model = copy :: Model
	local held = model:FindFirstChild("HeldWeapon"); if held then held:Destroy() end
	local a, b = src:GetDescendants(), model:GetDescendants()
	-- même ordre des descendants des deux côtés, sauf l'arme retirée de la copie
	local srcHeld = src:FindFirstChild("HeldWeapon")
	local filtered = {}
	for _, d in ipairs(a) do if not (srcHeld and (d == srcHeld or d:IsDescendantOf(srcHeld))) then table.insert(filtered, d) end end
	local map: { [BasePart]: BasePart } = {}
	for i, d in ipairs(b) do
		local o = filtered[i]
		if d:IsA("BasePart") and o and o:IsA("BasePart") then map[o] = d end
	end
	for _, d in ipairs(b) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Script") or d:IsA("LocalScript") or d:IsA("ModuleScript")
			or d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("Sound") or d:IsA("ForceField") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.LocalTransparencyModifier = 0
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			d.EvaluateStateMachine = false
		end
	end
	model.Name = "Killcam_" .. src.Name
	local alpha: { [BasePart]: number } = {}
	for _, c in pairs(map) do alpha[c] = c.Transparency end
	local g: Ghost = { model = model, map = map, alpha = alpha, src = src, hand = (model:FindFirstChild("RightHand") or model:FindFirstChild("Right Arm")) :: BasePart?,
		skin = srcHeld and srcHeld:GetAttribute("Skin") :: number?, camo = srcHeld and srcHeld:GetAttribute("Camo") :: string? }
	return g
end

local function setGhostGun(g: Ghost, key: string?)
	if g.gunKey == key then return end
	g.gunKey = key
	if g.gun then g.gun:Destroy(); g.gun = nil end
	if not key or not Config.WEAPONS[key] then return end
	local ok, m = pcall(WeaponModels.build, key, WORLD_SCALE)
	if ok and m then
		SkinPaint.apply(m, g.skin, g.camo)
		m.Parent = g.model; g.gun = m
	end
end

local function frameAt(t: number): (Frame?, Frame?, number)
	if #frames == 0 then return nil, nil, 0 end
	local i = 1
	while i < #frames - 1 and frames[i + 1].t < t do i += 1 end
	local a, b = frames[i], frames[math.min(#frames, i + 1)]
	local k = if b.t > a.t then math.clamp((t - a.t) / (b.t - a.t), 0, 1) else 0
	return a, b, k
end

local function hideLive(on: boolean)
	if on then
		KC.hidden = {}
		for _, m in ipairs(soldiers()) do
			for _, p in ipairs(m:GetDescendants()) do
				if p:IsA("BasePart") and p.LocalTransparencyModifier < 1 then p.LocalTransparencyModifier = 1; table.insert(KC.hidden, p) end
			end
		end
	else
		for _, p in ipairs(KC.hidden) do if p.Parent then p.LocalTransparencyModifier = 0 end end
		KC.hidden = {}
	end
end

local function hideHud(on: boolean)
	local pgui = player:FindFirstChildOfClass("PlayerGui")
	if not pgui then return end
	if on then
		KC.guis = {}
		for _, g in ipairs(pgui:GetChildren()) do
			if g:IsA("ScreenGui") and g ~= gui and g.Enabled then g.Enabled = false; table.insert(KC.guis, g) end
		end
	else
		for _, g in ipairs(KC.guis) do if g.Parent then g.Enabled = true end end
		KC.guis = {}
	end
end

local function stop()
	if not KC.on then return end
	KC.on = false
	recording = true
	S.kc = nil
	if S.onSkin then S.onSkin() end
	gui.Enabled = false
	(marker :: any).Parent = nil; (marker :: any).Adornee = nil
	if KC.highlight then KC.highlight:Destroy(); KC.highlight = nil end
	for _, g in pairs(KC.ghosts) do g.model:Destroy() end
	KC.ghosts = {}
	hideLive(false)
	hideHud(false)
	-- la caméra n'a été prise qu'à la fin de la petite pause (finishSetup) : avant, rien à rendre
	if KC.setup then
		KC.setup = false
		camera.CameraType = if KC.savedType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else KC.savedType
		camera.FieldOfView = KC.savedFov
	end
	if holdRemote then holdRemote:FireServer(false) end
end

local function begin(info: any)
	local killer = info.killerChar
	if typeof(killer) ~= "Instance" or not killer:IsA("Model") or killer == player.Character then return end
	if #frames < 10 then return end
	KC.tk = os.clock()
	if KC.tk - frames[1].t < 0.6 then return end
	KC.info = info; KC.killer = killer :: Model; KC.victim = player.Character
	local held = killer:FindFirstChild("HeldWeapon")
	KC.skin = held and held:GetAttribute("Skin") :: number?
	KC.camo = held and held:GetAttribute("Camo") :: string?
	KC.on = true; KC.wait = WAIT; KC.hold = 0; KC.blood = false; KC.zoom = 1
	if holdRemote then holdRemote:FireServer(true) end
	-- copies des soldats enregistrés (faites tout de suite : le corps du tueur ou d'un bot peut disparaître)
	local seen: { [Model]: boolean } = {}
	for _, f in ipairs(frames) do for m in pairs(f.m) do seen[m] = true end end
	for m in pairs(seen) do
		if m.Parent then
			local g = makeGhost(m)
			if g then KC.ghosts[m] = g end
		end
	end
	local kname = tostring(info.killer or killer.Name)
	local vname = tostring(info.victimName or player.DisplayName)
	who.Text = string.format('%s  <font color="#9aa6b8">[%s]</font>  <font color="#ff4655">%s</font>%s', kname, tostring(info.weapon or ""), vname,
		if info.headshot then '  <font color="#ff4655">· TÊTE</font>' else "")
	mName.Text = vname
	cardBox:ClearAllChildren()
	local kp = Players:GetPlayerFromCharacter(killer)
	local cb, ce = PlayerCard.decode(kp and kp:GetAttribute("Card"))
	local kt = kp and kp:GetAttribute("Title")
	pcall(PlayerCard.render, cardBox, { banner = cb, emblem = ce, name = kname, title = if typeof(kt) == "string" then kt elseif kp then nil else "Bot",
		level = kp and kp:GetAttribute("CardLevel"), size = 320 })
end

local function finishSetup()
	-- fin de la pause : on passe en rediffusion
	recording = false
	KC.t0 = math.max(frames[1].t, KC.tk - BEFORE)
	KC.t1 = math.min(frames[#frames].t, KC.tk + AFTER)
	KC.rt = KC.t0; KC.prev = KC.t0
	KC.rpShots = table.clone(shots)
	for _, g in pairs(KC.ghosts) do g.model.Parent = workspace end
	hideLive(true); hideHud(true)
	KC.savedType = camera.CameraType; KC.savedFov = camera.FieldOfView; KC.setup = true
	camera.CameraType = Enum.CameraType.Scriptable
	gui.Enabled = true
	local vg = KC.victim and KC.ghosts[KC.victim]
	if vg then
		local h = Instance.new("Highlight"); h.FillColor = Color3.fromRGB(255, 48, 64); h.FillTransparency = 0.55
		h.OutlineColor = Color3.fromRGB(255, 48, 64); h.OutlineTransparency = 0.2; h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
		h.Enabled = false; h.Adornee = vg.model; h.Parent = vg.model
		KC.highlight = h
		marker.Adornee = (vg.model:FindFirstChild("Head") or vg.model.PrimaryPart) :: any
		marker.Parent = player:FindFirstChildOfClass("PlayerGui")
	end
	S.kc = { key = nil, skin = KC.skin, camo = KC.camo }
end

local function tracer(from: Vector3, to: Vector3)
	local len = (to - from).Magnitude
	if len < 1 then return end
	local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
	p.Material = Enum.Material.Neon; p.Color = Color3.fromRGB(255, 190, 120)
	p.Size = Vector3.new(0.06, 0.06, len); p.CFrame = CFrame.lookAt(from, to) * CFrame.new(0, 0, -len / 2)
	p.Transparency = 0.15; p.Parent = workspace
	TweenService:Create(p, TweenInfo.new(0.25), { Transparency = 1 }):Play()
	Debris:AddItem(p, 0.3)
end

local function blood(at: Vector3, head: boolean)
	local a = Instance.new("Attachment"); a.WorldPosition = at; a.Parent = workspace.Terrain
	local e = Instance.new("ParticleEmitter"); e.Color = ColorSequence.new(Color3.fromRGB(150, 10, 18)); e.LightEmission = 0
	e.Size = NumberSequence.new(0.35, 0); e.Speed = NumberRange.new(6, 14); e.SpreadAngle = Vector2.new(60, 60)
	e.Lifetime = NumberRange.new(0.25, 0.5); e.Acceleration = Vector3.new(0, -40, 0); e.Rate = 0; e.Parent = a
	e:Emit(if head then 22 else 12)
	Debris:AddItem(a, 1.2)
end

local losParams = RaycastParams.new(); losParams.FilterType = Enum.RaycastFilterType.Exclude

RunService:BindToRenderStep("Killcam", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	if not KC.on then return end
	if KC.wait > 0 then
		KC.wait -= dt
		if KC.wait <= 0 then finishSetup() end
		return
	end
	-- vitesse : normale, ralenti autour du tir, puis normale (comme le web)
	local near = math.abs(KC.rt - KC.tk)
	local sp = if near < 0.55 then 0.28 elseif near < 1 then 0.55 else 1
	KC.prev = KC.rt; KC.rt = math.min(KC.t1, KC.rt + dt * sp)
	local a, b, k = frameAt(KC.rt)
	if not a or not b then stop(); return end
	-- soldiers
	for src, g in pairs(KC.ghosts) do
		local sa, sb = a.m[src], b.m[src] or a.m[src]
		if not sa then
			g.model.Parent = nil
		else
			g.model.Parent = workspace
			for o, c in pairs(g.map) do
				local ca, cb = sa.cf[o], sb and sb.cf[o]
				if ca then c.CFrame = if cb then ca:Lerp(cb, k) else ca; c.Transparency = g.alpha[c] else c.Transparency = 1 end
			end
			setGhostGun(g, sa.key)
			if g.gun and g.hand then WeaponModels.place(g.gun, g.hand.CFrame * GRIP) end
		end
	end
	-- tirs rejoués
	local kg = KC.killer and KC.ghosts[KC.killer]
	for _, s in ipairs(KC.rpShots) do
		if s.t > KC.prev and s.t <= KC.rt then
			local mine = s.shooter == KC.killer
			local key = if mine then S.kc and S.kc.key else s.shooter and s.shooter:GetAttribute("Weapon")
			local w = typeof(key) == "string" and Config.WEAPONS[key]
			tracer(if mine and S.muzzle then S.muzzle else s.from, s.to)
			if w then
				local snd = ModeConfig.SOUNDS.fire[if w.melee then "melee" else w.cat] or ModeConfig.SOUNDS.fire.rifle
				if mine then Sfx.play(snd); S.shot:Fire(key) else Sfx.play(snd, s.from, 0.45) end
			end
		end
	end
	-- caméra : les yeux du tueur
	local ka = KC.killer and a.m[KC.killer]
	local kb = KC.killer and b.m[KC.killer] or ka
	if not ka or not kg then stop(); return end
	local head = kg.model:FindFirstChild("Head") :: BasePart?
	local root = kg.model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not head or not root then stop(); return end
	for _, c in pairs(kg.map) do c.Transparency = 1 end      -- sinon on verrait l'intérieur de sa tête
	if kg.gun then for _, c in ipairs(kg.gun:GetDescendants()) do if c:IsA("BasePart") then c.LocalTransparencyModifier = 1 end end end
	local pitch = ka.pitch + ((kb and kb.pitch or ka.pitch) - ka.pitch) * k
	local look = root.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local eye = head.Position + Vector3.new(0, 0.25, 0)
	camera.CFrame = CFrame.new(eye) * CFrame.fromOrientation(pitch, yaw, 0)
	-- l'arme du tueur en vue subjective
	if S.kc then
		S.kc.key = ka.key
		S.speed = ka.speed; S.grounded = ka.grounded; S.vy = ka.vy; S.aiming = false
	end
	-- la cible : zoom selon la distance quand le tueur la vise, silhouette rouge seulement derrière un mur
	local vg = KC.victim and KC.ghosts[KC.victim]
	local vHead = vg and (vg.model:FindFirstChild("Head") :: BasePart?)
	local tz = 1
	if vHead and vHead.Transparency < 1 then
		local to = vHead.Position - eye
		local d = to.Magnitude
		if d > 3 and to.Unit:Dot(camera.CFrame.LookVector) > 0.94 then tz = math.clamp(d / 20, 1, 2.6) end
		if KC.highlight then
			local ignore: { Instance } = {}
			for _, g in pairs(KC.ghosts) do table.insert(ignore, g.model) end
			for _, m in ipairs(soldiers()) do table.insert(ignore, m) end
			losParams.FilterDescendantsInstances = ignore
			KC.highlight.Enabled = workspace:Raycast(eye, to, losParams) ~= nil
		end
		marker.Enabled = true
	else
		marker.Enabled = false
		if KC.highlight then KC.highlight.Enabled = false end
	end
	KC.zoom += (tz - KC.zoom) * math.min(1, dt * 5)
	camera.FieldOfView += (BASE_FOV / KC.zoom - camera.FieldOfView) * math.min(1, dt * 18)
	chevron.Position = UDim2.new(0.5, 0, 0, 20 + math.abs(math.sin(os.clock() * 4.5)) * 4)
	recDot.BackgroundTransparency = if os.clock() % 1 < 0.5 then 0 else 0.8
	-- l'impact
	if not KC.blood and KC.rt >= KC.tk and vHead then
		KC.blood = true
		blood(vHead.Position - (if KC.info.headshot then Vector3.zero else Vector3.new(0, 1.2, 0)), KC.info.headshot == true)
		if KC.info.headshot then Sfx.play("hs") end
	end
	pgFill.Size = UDim2.fromScale(math.clamp((KC.rt - KC.t0) / math.max(0.01, KC.t1 - KC.t0), 0, 1), 1)
	if KC.rt >= KC.t1 then
		KC.hold += dt
		if KC.hold > 1 then stop() end
	end
end)

-- ---------- déclenchement ----------
deathRemote.OnClientEvent:Connect(function(info: any)
	if typeof(info) ~= "table" or not info.killcam or KC.on then return end
	if player:GetAttribute("KillcamOff") == true then return end
	begin(info)
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or not KC.on or KC.wait > 0 then return end   -- pas quand on tape dans le chat
	if input.KeyCode == Enum.KeyCode.Space or input.KeyCode == Enum.KeyCode.ButtonA or input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		stop()
	end
end)

-- réapparition, fin de partie, téléportation au salon : on coupe proprement
player.CharacterAdded:Connect(function() stop() end)
player:GetAttributeChangedSignal("Zone"):Connect(function() stop() end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="807">
        <Properties>
          <string name="Name">LaunchNews</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/LaunchNews (LocalScript)
-- Fenêtre « QUOI DE NEUF ? » au lancement (écran d'actualités des FPS : saison, mode de la semaine, nouveautés), par-dessus
-- le menu principal, UNE fois par version des nouveautés (MenuConfig.NEWS_VERSION) : la version vue est gardée dans le
-- profil (remote « Career », action « news », vérifiée par CareerService). Montre aussi la carte de joueur.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Modes = require(ReplicatedStorage.Shared.Modes)
local PlayerCard = require(ReplicatedStorage.Shared.PlayerCard)
local MenuDir = script.Parent:WaitForChild("Menu")
local K = require(MenuDir:WaitForChild("Kit"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function call(name: string, ...: any): any
	local r = ReplicatedStorage:WaitForChild(name, 10)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local ok, res = pcall((r :: RemoteFunction).InvokeServer, r :: RemoteFunction, ...)
	return if ok then res else nil
end

local shown = false
local function show(cd: any)
	if shown then return end
	shown = true
	local gui = make("ScreenGui", { Name = "LaunchNews", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 26, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
	local dim = make("TextButton", { Text = "", Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 1, AutoButtonColor = false, Modal = true }, gui)
	local panel = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(620, 0), AutomaticSize = Enum.AutomaticSize.Y,
		BackgroundTransparency = 0, BackgroundColor3 = C.white }, gui)
	K.gradient(panel, K.rgb(0x151f33), K.rgb(0x0a0f1a), 90)
	K.corner(panel, 14); K.stroke(panel, C.accent, 1, 0.5); K.pad(panel, 26, 22); K.vlist(panel, 10)
	local sc = make("UIScale", { Scale = 0.85 }, panel)
	-- petits écrans : la fenêtre se réduit pour tenir
	local cam = workspace.CurrentCamera
	local fit = if cam then math.clamp(math.min(cam.ViewportSize.X / 700, cam.ViewportSize.Y / 640), 0.55, 1) else 1
	text(panel, { LayoutOrder = 1, Text = "📰  " .. spaced("QUOI DE NEUF ?", 2), Font = K.BLACK, TextSize = 26, Size = UDim2.new(1, 0, 0, 32), TextWrapped = false })
	local feat = Modes.featured()
	local fm = Modes.LIST[feat]
	text(panel, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 18), TextSize = 13, TextColor3 = C.gold, Font = K.BLACK, TextWrapped = false,
		Text = "★ " .. string.upper(X.SEASON.name) .. (if fm then '   <font color="#8da0bd">·</font>   MODE DE LA SEMAINE : ' .. string.upper((string.gsub(fm.n, "%s*%(.*%)", ""))) .. " (XP ×2)" else "") })
	-- carte de joueur
	if typeof(cd) == "table" and typeof(cd.card) == "table" then
		local holder = make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 84) }, panel)
		local title = player:GetAttribute("Title")
		local card = PlayerCard.render(holder, { banner = cd.card.b, emblem = cd.card.e, name = player.DisplayName, title = if typeof(title) == "string" then title else nil,
			level = player:GetAttribute("CardLevel"), size = 340 })
		card.AnchorPoint = Vector2.new(0.5, 0); card.Position = UDim2.fromScale(0.5, 0)
	end
	-- nouveautés (les 5 premières : les plus récentes)
	for i = 1, math.min(5, #MenuConfig.NEWS) do
		local n = MenuConfig.NEWS[i]
		local row = make("Frame", { LayoutOrder = 10 + i, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.94, BackgroundColor3 = C.white }, panel)
		K.corner(row, 8); K.pad(row, 10, 8)
		text(row, { Text = n.ic, TextSize = 22, Size = UDim2.fromOffset(34, 34), TextXAlignment = Enum.TextXAlignment.Center })
		local tx = make("Frame", { Position = UDim2.fromOffset(44, 0), Size = UDim2.new(1, -44, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, row)
		K.vlist(tx, 2)
		text(tx, { LayoutOrder = 1, Text = n.t .. '  <font size="9" color="#ff4655">' .. spaced("NOUVEAU", 1) .. "</font>", Font = K.BLACK, TextSize = 14,
			Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
		K.para(tx, n.d, 12, C.dim, 2)
		-- arrivée en cascade
		local rs = make("UIScale", { Scale = 0.9 }, row)
		TweenService:Create(rs, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.15 + i * 0.06), { Scale = 1 }):Play()
	end
	local closing = false
	local function close()
		if closing then return end
		closing = true
		task.spawn(call, "Career", "news", MenuConfig.NEWS_VERSION)
		TweenService:Create(sc, TweenInfo.new(0.18), { Scale = 0.85 * fit }):Play()
		TweenService:Create(dim, TweenInfo.new(0.18), { BackgroundTransparency = 1 }):Play()
		task.delay(0.2, function() gui:Destroy() end)
	end
	local go = K.btn(panel, "▶  " .. spaced("C'EST PARTI !", 2), "primary", close, { LayoutOrder = 30, Size = UDim2.new(1, 0, 0, 48), TextSize = 16, Name = "NewsGo" })
	K.shine(go, 2.4, 0.25)
	dim.Activated:Connect(close)
	K.overlay(gui, close, function() return go end)
	TweenService:Create(dim, TweenInfo.new(0.25), { BackgroundTransparency = 0.45 }):Play()
	TweenService:Create(sc, TweenInfo.new(0.4, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = fit }):Play()
	pcall(function() require(MenuDir:WaitForChild("Fx")).confetti(panel, 26) end)
end

-- au premier affichage du menu principal (hors partie), une fois la carrière reçue
task.spawn(function()
	local mm = playerGui:WaitForChild("MainMenu", 60)
	if not mm or not mm:IsA("ScreenGui") then return end
	local checking = false
	local function check()
		if shown or checking or not mm.Enabled or player:GetAttribute("Zone") == "match" then return end
		checking = true
		task.delay(1.2, function()
			-- deux essais : la demande peut tomber pile en même temps que celle du Profil (cadence limitée côté serveur)
			for _ = 1, 2 do
				if shown or not mm.Enabled then break end
				local cd = call("Career", "get")
				if typeof(cd) == "table" then
					if cd.newsSeen ~= MenuConfig.NEWS_VERSION then show(cd) end
					break
				end
				task.wait(1)
			end
			checking = false
		end)
	end
	mm:GetPropertyChangedSignal("Enabled"):Connect(check)
	check()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="808">
        <Properties>
          <string name="Name">LoadoutUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/LoadoutUI (LocalScript)
-- Menu de chargement (touche B ou bouton « 🔫 Armes ») : choisir son arme principale et son pistolet.
-- Les armes non débloquées sont affichées avec un cadenas et leur prix en pièces (achat dans la Boutique).
-- Le serveur revérifie tout (SetLoadout dans MatchService) ; le choix est gardé dans le profil et appliqué à la prochaine apparition.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)

local player = Players.LocalPlayer
local setLoadout = ReplicatedStorage:WaitForChild("SetLoadout", 30) :: RemoteFunction?
local getProfile = ReplicatedStorage:WaitForChild("GetProfile") :: RemoteFunction

local C = {
	bg = Color3.fromRGB(13, 18, 29), panel = Color3.fromRGB(22, 29, 44), card = Color3.fromRGB(30, 38, 56), text = Color3.new(1, 1, 1),
	dim = Color3.fromRGB(150, 160, 180), accent = Color3.fromRGB(255, 70, 85), green = Color3.fromRGB(80, 230, 140), gold = Color3.fromRGB(255, 200, 60),
}
local CAT_NAME = { pistol = "Pistolet", smg = "Mitraillette", shotgun = "Fusil à pompe", rifle = "Fusil d'assaut", sniper = "Précision", lmg = "Mitrailleuse" }
local CAT_ORDER = { "rifle", "smg", "shotgun", "sniper", "lmg", "pistol" }

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if class == "TextLabel" or class == "TextButton" then o.Font = Enum.Font.GothamBold; o.TextColor3 = C.text; o.BorderSizePixel = 0 end
	if class == "TextLabel" then o.BackgroundTransparency = 1 end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end

local gui = make("ScreenGui", { Name = "LoadoutUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 14 }, player:WaitForChild("PlayerGui"))
local openBtn = make("TextButton", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -170, 0, 164), BackgroundColor3 = C.accent,
	Text = "🔫 Armes (B)", TextSize = 18, Font = Enum.Font.GothamBlack }, gui)
corner(openBtn)

local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(0.8, 0, 0.8, 0),
	BackgroundColor3 = C.bg, Visible = false, ZIndex = 50 }, gui)
corner(win, 14); make("UIStroke", { Color = C.accent, Thickness = 2 }, win)
make("UISizeConstraint", { MaxSize = Vector2.new(1100, 720) }, win)
make("TextLabel", { Size = UDim2.new(1, -80, 0, 50), Position = UDim2.fromOffset(24, 10), Text = "CHARGEMENT", TextSize = 28, Font = Enum.Font.GothamBlack,
	TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.accent, ZIndex = 51 }, win)
local hint = make("TextLabel", { Size = UDim2.new(1, -48, 0, 20), Position = UDim2.fromOffset(24, 56), Text = "", TextSize = 14, TextColor3 = C.dim,
	TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 51 }, win)
local close = make("TextButton", { Size = UDim2.fromOffset(40, 40), Position = UDim2.new(1, -54, 0, 14), BackgroundColor3 = C.panel, Text = "✕", TextSize = 20,
	Modal = true, ZIndex = 52 }, win)   -- Modal : libère le curseur en vue à la première personne
corner(close)
require(ReplicatedStorage.Shared.Icons).closeButton(close, 16)   -- la croix U+2715 donne un carré vide

make("TextLabel", { Size = UDim2.new(1, -48, 0, 16), Position = UDim2.new(0, 24, 1, -18), TextSize = 11, TextColor3 = C.dim,
	Text = "Modèles d'armes : série « Low-Poly » de TastyTony (Sketchfab), licence CC BY 4.0", TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 51 }, win)

-- onglets
local tabs = make("Frame", { Size = UDim2.new(1, -48, 0, 40), Position = UDim2.fromOffset(24, 84), BackgroundTransparency = 1, ZIndex = 51 }, win)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, tabs)
local list = make("ScrollingFrame", { Size = UDim2.new(1, -48, 1, -160), Position = UDim2.fromOffset(24, 134), BackgroundTransparency = 1, BorderSizePixel = 0,
	ScrollBarThickness = 6, AutomaticCanvasSize = Enum.AutomaticSize.Y, CanvasSize = UDim2.new(), ZIndex = 51 }, win)
make("UIGridLayout", { CellSize = UDim2.fromOffset(240, 150), CellPadding = UDim2.fromOffset(12, 12), SortOrder = Enum.SortOrder.LayoutOrder }, list)

local state = { tab = "primary", profile = nil :: any }

local function bar(parent: Instance, y: number, label: string, frac: number, color: Color3)
	make("TextLabel", { Size = UDim2.fromOffset(70, 14), Position = UDim2.fromOffset(12, y), Text = label, TextSize = 12, TextColor3 = C.dim,
		TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 53 }, parent)
	local back = make("Frame", { Size = UDim2.new(1, -96, 0, 6), Position = UDim2.fromOffset(84, y + 4), BackgroundColor3 = C.panel, BorderSizePixel = 0, ZIndex = 53 }, parent)
	corner(back, 3)
	local fill = make("Frame", { Size = UDim2.fromScale(math.clamp(frac, 0.04, 1), 1), BackgroundColor3 = color, BorderSizePixel = 0, ZIndex = 54 }, back)
	corner(fill, 3)
end

local function owned(key: string): boolean
	return Catalog.STARTER_WEAPONS[key] == true or (state.profile ~= nil and Catalog.ownsWeapon(state.profile, key))
end

local function current(slot: number): string
	local attr = player:GetAttribute(if slot == 0 then "Primary" else "Secondary")
	if typeof(attr) == "string" then return attr end
	local t = player:GetAttribute("Team")
	local team = if typeof(t) == "string" then t else nil
	local base = team and ModeConfig.TDM.loadout[team]
	if base then return if slot == 0 then base.primary else base.secondary end
	return if slot == 0 then "galil" else "glock"
end

local render: () -> ()

local function choose(key: string)
	if not setLoadout then return end
	local ok = setLoadout:InvokeServer(key)
	hint.Text = if ok then "✅ " .. Config.WEAPONS[key].name .. " choisi : tu l'auras à ta prochaine apparition." else "Cette arme n'est pas encore débloquée."
	hint.TextColor3 = if ok then C.green else C.accent
	render()
end

-- onglets Armurier / Viseurs (panneaux de l'Arsenal du web)
local host = make("Frame", { Size = UDim2.new(1, -48, 1, -160), Position = UDim2.fromOffset(24, 134), BackgroundTransparency = 1, ClipsDescendants = true,
	Visible = false, ZIndex = 51 }, win)
local panel: { destroy: () -> (), refresh: () -> () }? = nil
local panelTab: string? = nil
local Panels: any = nil
pcall(function() Panels = require(ReplicatedStorage.Shared.ArsenalPanels) end)

render = function()
	local isPanel = state.tab == "arms" or state.tab == "sights"
	list.Visible = not isPanel; host.Visible = isPanel
	if panel and panelTab ~= state.tab then pcall(panel.destroy); panel = nil; panelTab = nil end
	if isPanel then
		if not panel and Panels then
			local ok, p = pcall(Panels[state.tab], host)
			if ok then panel = p; panelTab = state.tab else warn("ArsenalPanels:", p) end
		end
		for _, b in ipairs(tabs:GetChildren()) do
			if b:IsA("TextButton") then b.BackgroundColor3 = if b.Name == state.tab then C.accent else C.panel end
		end
		return
	end
	for _, c in ipairs(list:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	local slot = if state.tab == "primary" then 0 else 1
	local selected = current(slot)
	local keys = {}
	for key, w in pairs(Config.WEAPONS) do if w.slot == slot and not w.melee then table.insert(keys, key) end end
	table.sort(keys, function(a, b)
		local wa, wb = Config.WEAPONS[a], Config.WEAPONS[b]
		local ca, cb = table.find(CAT_ORDER, wa.cat) or 9, table.find(CAT_ORDER, wb.cat) or 9
		if ca ~= cb then return ca < cb end
		return wa.price < wb.price
	end)
	for i, key in ipairs(keys) do
		local w = Config.WEAPONS[key]
		local have = owned(key)
		local isSel = key == selected
		local card = make("TextButton", { LayoutOrder = i, BackgroundColor3 = if isSel then Color3.fromRGB(60, 30, 38) else C.card, Text = "", AutoButtonColor = have, ZIndex = 52 }, list)
		corner(card, 10)
		if isSel then make("UIStroke", { Color = C.accent, Thickness = 2 }, card) end
		make("TextLabel", { Size = UDim2.new(1, -24, 0, 24), Position = UDim2.fromOffset(12, 8), Text = w.name, TextSize = 18, Font = Enum.Font.GothamBlack,
			TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = if have then C.text else C.dim, ZIndex = 53 }, card)
		make("TextLabel", { Size = UDim2.new(1, -24, 0, 16), Position = UDim2.fromOffset(12, 32), Text = CAT_NAME[w.cat] or w.cat, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = C.dim, ZIndex = 53 }, card)
		bar(card, 56, "Dégâts", w.dmg * w.pellets / 115, C.accent)
		bar(card, 74, "Cadence", w.rpm / 1000, C.gold)
		bar(card, 92, "Précision", 1 - math.min(1, w.spread / 2), C.green)
		bar(card, 110, "Mobilité", (w.speed - 0.75) / 0.3, Color3.fromRGB(74, 163, 255))
		local status = if isSel then "✔ ÉQUIPÉE" elseif have then "Choisir" else ("🔒 " .. Catalog.weaponPrice(key) .. " 💰 · Boutique")
		make("TextLabel", { Size = UDim2.new(1, -24, 0, 18), Position = UDim2.new(0, 12, 1, -24), Text = status, TextSize = 13,
			TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = if isSel then C.accent elseif have then C.green else C.gold, ZIndex = 53 }, card)
		card.Activated:Connect(function() if have and not isSel then choose(key) end end)
	end
	for _, b in ipairs(tabs:GetChildren()) do
		if b:IsA("TextButton") then b.BackgroundColor3 = if b.Name == state.tab then C.accent else C.panel end
	end
end

for _, t in ipairs({ { "primary", "Arme principale" }, { "secondary", "Pistolet" }, { "arms", "Armurier" }, { "sights", "Viseurs" } }) do
	local b = make("TextButton", { Name = t[1], Size = UDim2.fromOffset(180, 40), BackgroundColor3 = C.panel, Text = t[2], TextSize = 16, ZIndex = 52 }, tabs)
	corner(b)
	b.Activated:Connect(function() state.tab = t[1]; render() end)
end

local function setOpen(on: boolean)
	win.Visible = on
	player:SetAttribute("UiOpen", on)
	if on then
		hint.Text = "Clique sur une arme pour la prendre à ta prochaine apparition."; hint.TextColor3 = C.dim
		task.spawn(function()
			local data = getProfile:InvokeServer()
			state.profile = data and data.profile
			if Panels then Panels.reload() end
			render()
		end)
		render()
	end
end
openBtn.Activated:Connect(function() setOpen(not win.Visible) end)
close.Activated:Connect(function() setOpen(false) end)
ContextActionService:BindAction("Loadout", function(_, st)
	if player:GetAttribute("Zone") == "match" then return Enum.ContextActionResult.Pass end   -- en partie, B = boutique (BuyMenu)
	if st == Enum.UserInputState.Begin then setOpen(not win.Visible) end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.B, Enum.KeyCode.DPadLeft)
player:GetAttributeChangedSignal("Primary"):Connect(function() if win.Visible then render() end end)

-- ---------- menu principal (MainMenu) : bouton caché pendant que le menu est ouvert, fenêtre ouvrable depuis le menu ----------
-- comme le web : pas de bouton « Armes » en partie (la boutique s'ouvre avec B), et rien par-dessus le menu
local function refreshOpenBtn()
	local inMatch = player:GetAttribute("Zone") == "match"
	openBtn.Visible = player:GetAttribute("MenuOpen") ~= true and not inMatch
	if inMatch and win.Visible then setOpen(false) end
end
player:GetAttributeChangedSignal("MenuOpen"):Connect(refreshOpenBtn)
player:GetAttributeChangedSignal("Zone"):Connect(refreshOpenBtn)
refreshOpenBtn()
gui.DisplayOrder = 30   -- au-dessus du menu (19)
require(ReplicatedStorage.Shared.ClientState).panels.loadout = function() setOpen(not win.Visible) end
-- B / Échap / Retour arrière ferment la fenêtre (avant le menu) ; à la manette, la sélection arrive sur la croix
require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit")).overlay(win, function() setOpen(false) end, function() return close end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="809">
        <Properties>
          <string name="Name">LobbyUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/LobbyUI (LocalScript)
-- Interface de lobby minimale : profil (niveau/XP/pièces), récompense quotidienne, défis, ouverture de caisses.
-- À habiller avec ton propre design (ScreenGui dans StarterGui, ViewportFrame pour l'animation 3D des caisses).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer
local getProfile = ReplicatedStorage:WaitForChild("GetProfile") :: RemoteFunction
local claimDaily = ReplicatedStorage:WaitForChild("ClaimDaily") :: RemoteFunction
local openBox = ReplicatedStorage:WaitForChild("OpenBox") :: RemoteFunction

local gui = Instance.new("ScreenGui"); gui.Name = "LobbyUI"; gui.ResetOnSpawn = false; gui.Parent = player:WaitForChild("PlayerGui")

local function label(text: string, y: number): TextLabel
	local l = Instance.new("TextLabel"); l.Size = UDim2.fromOffset(420, 30); l.Position = UDim2.fromOffset(20, y)
	l.BackgroundTransparency = 0.3; l.BackgroundColor3 = Color3.fromRGB(13, 18, 29); l.TextColor3 = Color3.new(1, 1, 1)
	l.Font = Enum.Font.GothamBold; l.TextSize = 18; l.TextXAlignment = Enum.TextXAlignment.Left; l.Text = text; l.Parent = gui
	return l
end

local function button(text: string, y: number, cb: () -> ()): TextButton
	local b = Instance.new("TextButton"); b.Size = UDim2.fromOffset(260, 36); b.Position = UDim2.fromOffset(20, y)
	b.BackgroundColor3 = Color3.fromRGB(255, 70, 85); b.TextColor3 = Color3.new(1, 1, 1); b.Font = Enum.Font.GothamBlack; b.TextSize = 16
	b.Text = text; b.Parent = gui; b.Activated:Connect(cb)
	return b
end

local profileLabel = label("Chargement…", 20)
local function refresh()
	local data = getProfile:InvokeServer()
	if not data then return end
	profileLabel.Text = string.format("Niv. %d  •  %d/%d XP  •  💰 %d  •  📦 %d", data.level, data.xp, data.xpNeed, data.profile.coins, (data.profile.boxes.std or 0) + (data.profile.boxes.prem or 0))
	return data
end

local data = refresh()
if data and data.daily.canClaim then
	button("🎁 Récupérer la récompense du jour", 60, function()
		local res = claimDaily:InvokeServer()
		if res then print("Récompense jour", res.day, res.reward) end
		refresh()
	end)
end

for i, id in ipairs({ "std", "prem" }) do
	local def = Config.BOXES[id]
	local odds = {}
	for r, w in ipairs(def.weights) do table.insert(odds, Config.RARITY[r].name .. " " .. w .. "%") end
	label(def.name .. " — " .. table.concat(odds, " • "), 110 + (i - 1) * 80)         -- probabilités visibles (obligatoire)
	button("Ouvrir " .. def.name, 142 + (i - 1) * 80, function()
		local res = openBox:InvokeServer(id)
		if res and res.ok then
			print("Tirage :", Config.RARITY[res.rarity].name, res.item.kind, res.duplicate and "(doublon)" or "")
			-- animation 3D d'ouverture du web (src/8V_crate.js) : caisse qui tombe, loquets, lumière, ouverture, objet révélé
			require(ReplicatedStorage.Shared.CrateOpening).play(nil, res, id)
		else
			warn("Ouverture impossible :", res and res.err)
		end
		refresh()
	end)
end

-- Remplacée par le menu principal (MainMenu : profil, récompense du jour, défis, Arsenal › Caisses) : on la cache.
gui.Enabled = false
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="810">
        <Properties>
          <string name="Name">LoyaltyUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/LoyaltyUI (LocalScript)
-- Centre des cadeaux (temps de jeu, série, fidélité, bonus), fenêtre Premium (avantages, couleur de pseudo, offres en Robux),
-- notifications « Cadeau débloqué ! » et « Bon retour ! », pseudo Premium en couleur dans le chat.
-- Le serveur (LoyaltyService, ShopService) vérifie tout ; ici on ne fait qu'afficher. Même contenu que la version web (8W_loyalty.js).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local TextChatService = game:GetService("TextChatService")
local MarketplaceService = game:GetService("MarketplaceService")
local L = require(ReplicatedStorage.Shared.LoyaltyConfig)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
-- présentation commune avec le menu, le passe et la boutique (fond dégradé bleu nuit, croix, B / Échap pour fermer)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))

local player = Players.LocalPlayer
local loyGet = ReplicatedStorage:WaitForChild("Loy_Get") :: RemoteFunction
local loyClaim = ReplicatedStorage:WaitForChild("Loy_Claim") :: RemoteFunction
local vipSetColor = ReplicatedStorage:WaitForChild("Vip_SetColor") :: RemoteFunction
local shopBuy = ReplicatedStorage:WaitForChild("ShopBuy") :: RemoteFunction

local DARK = Color3.fromRGB(13, 18, 29)
local PANEL = Color3.fromRGB(22, 29, 44)
local PURPLE = Color3.fromRGB(122, 44, 255)
local GOLD = Color3.fromRGB(255, 196, 40)
local MUTED = Color3.fromRGB(70, 80, 100)
local GREEN = Color3.fromRGB(125, 255, 159)

local gui = Instance.new("ScreenGui"); gui.Name = "LoyaltyUI"; gui.ResetOnSpawn = false; gui.Parent = player:WaitForChild("PlayerGui")

local function make(className: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(className)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end   -- pas de liseré gris d'origine (style du menu)
	if className == "TextLabel" or className == "TextButton" then
		o.Font = Enum.Font.GothamBold
		o.TextColor3 = Color3.new(1, 1, 1)
		o.RichText = true
	end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o: Instance, r: number) make("UICorner", { CornerRadius = UDim.new(0, r) }, o) end
local function stroke(o: Instance, c: Color3, t: number) make("UIStroke", { Color = c, Thickness = t, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o) end
local function gradient(o: Instance, a: Color3, b: Color3) make("UIGradient", { Color = ColorSequence.new(a, b), Rotation = 20 }, o) end

local function rewardText(r: any): string
	local t = {}
	if r.coins then table.insert(t, "+" .. r.coins .. " pièces") end
	if r.box then table.insert(t, (r.n or 1) .. (if r.box == "prem" then " Caisse Premium" else " Caisse Standard")) end
	if r.boost then table.insert(t, "Boost XP ×1,5 (" .. r.boost .. " parties)") end
	if r.title then table.insert(t, "Titre « " .. L.TITLES[r.title] .. " »") end
	return table.concat(t, " • ")
end

-- Petit rebond « tape-à-l'œil » sur un objet
-- (un seul UIScale par objet, réutilisé : avant, chaque ouverture en ajoutait un). Les fenêtres (780 × 520) rétrécissent
-- pour tenir dans l'écran : sur un téléphone à l'horizontale, le haut et la croix de fermeture sortaient de l'écran.
local function pop(o: GuiObject)
	local s = o:FindFirstChild("Pop") :: UIScale?
	if not s then s = make("UIScale", { Name = "Pop" }, o) end
	local k = 1
	if o.Parent == gui then
		local area = gui.AbsoluteSize
		if area.X > 0 and area.Y > 0 then k = math.min(1, (area.X - 16) / o.Size.X.Offset, (area.Y - 16) / o.Size.Y.Offset) end
	end
	local sc = s :: UIScale
	sc.Scale = 0.3 * k
	TweenService:Create(sc, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = k }):Play()
end
local function wiggle(o: GuiObject)
	task.spawn(function()
		while o.Parent do
			TweenService:Create(o, TweenInfo.new(0.12), { Rotation = -6 }):Play(); task.wait(0.12)
			TweenService:Create(o, TweenInfo.new(0.12), { Rotation = 6 }):Play(); task.wait(0.12)
			TweenService:Create(o, TweenInfo.new(0.12), { Rotation = 0 }):Play(); task.wait(1.6)
		end
	end)
end

-- ---------- boutons (sous le bouton Boutique de ShopUI) ----------
local giftBtn = make("TextButton", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -170, 0, 68), BackgroundColor3 = PURPLE,
	Text = "🎁 Cadeaux", TextSize = 18, Font = Enum.Font.GothamBlack }, gui)
corner(giftBtn, 8); gradient(giftBtn, Color3.fromRGB(255, 255, 255), Color3.fromRGB(190, 160, 255))
local badge = make("TextLabel", { Size = UDim2.fromOffset(24, 24), Position = UDim2.new(1, -12, 0, -10), BackgroundColor3 = Color3.fromRGB(255, 70, 85),
	Text = "", TextSize = 13, Visible = false }, giftBtn)
corner(badge, 12)
local vipBtn = make("TextButton", { Size = UDim2.fromOffset(150, 40), Position = UDim2.new(1, -170, 0, 116), BackgroundColor3 = GOLD,
	Text = "⭐ Premium", TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = Color3.fromRGB(42, 26, 0) }, gui)
corner(vipBtn, 8)
local vipGrad = make("UIGradient", { Color = ColorSequence.new({ ColorSequenceKeypoint.new(0, Color3.fromRGB(255, 179, 0)),
	ColorSequenceKeypoint.new(0.5, Color3.fromRGB(255, 246, 201)), ColorSequenceKeypoint.new(1, Color3.fromRGB(255, 157, 0)) }) }, vipBtn)
TweenService:Create(vipGrad, TweenInfo.new(2.5, Enum.EasingStyle.Linear, Enum.EasingDirection.InOut, -1), { Offset = Vector2.new(1, 0) }):Play()

-- ---------- fenêtre générique ----------
-- voile sombre derrière la fenêtre ouverte (comme le passe, le calendrier et la boutique) ; un clic dessus la ferme
local veil = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.rgb(0x05080e), BackgroundTransparency = 0.35, Text = "",
	AutoButtonColor = false, Modal = true, Visible = false, BorderSizePixel = 0 }, gui)
local wins: { Frame } = {}
local function syncVeil()
	local any = false
	for _, w in ipairs(wins) do if w.Visible then any = true end end
	veil.Visible = any
end
veil.Activated:Connect(function() for _, w in ipairs(wins) do w.Visible = false end end)
local function window(title: string, accent: Color3, tint: Color3): (Frame, ScrollingFrame)
	local win = make("Frame", { Size = UDim2.fromOffset(780, 520), Position = UDim2.fromScale(0.5, 0.5), AnchorPoint = Vector2.new(0.5, 0.5),
		BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, BorderSizePixel = 0 }, gui)
	K.corner(win, 16); K.gradient(win, tint, K.rgb(0x0b111c), 90); K.stroke(win, accent, 1.5, 0.45)
	K.text(win, { Size = UDim2.new(1, -90, 0, 34), Position = UDim2.fromOffset(26, 16), Text = K.spaced(title, 2), TextSize = 24, Font = K.BLACK,
		TextColor3 = accent, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	local close = K.btn(win, "✕", "dark", function() win.Visible = false end,
		{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(40, 40), TextSize = 18 })
	local body = K.scroll(win, { Size = UDim2.new(1, -40, 1, -80), Position = UDim2.fromOffset(20, 66) })
	make("UIListLayout", { Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, body)
	table.insert(wins, win)
	win:GetPropertyChangedSignal("Visible"):Connect(syncVeil)
	-- B / Échap / Retour arrière ferment la fenêtre ; à la manette, la sélection arrive sur la croix
	K.overlay(win, function() win.Visible = false end, function() return close end)
	return win, body
end
local function section(body: Instance, order: number, title: string, height: number): Frame
	local f = make("Frame", { Size = UDim2.new(1, -8, 0, height), BackgroundColor3 = PANEL, BackgroundTransparency = 0.25, LayoutOrder = order, BorderSizePixel = 0 }, body)
	K.corner(f, 12); K.stroke(f, Color3.new(1, 1, 1), 1, 0.92)
	make("TextLabel", { Size = UDim2.new(1, -24, 0, 26), Position = UDim2.fromOffset(12, 6), BackgroundTransparency = 1, Text = title,
		TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left }, f)
	return f
end
local function row(parent: Instance, y: number): Frame
	local r = make("Frame", { Size = UDim2.new(1, -24, 0, 104), Position = UDim2.fromOffset(12, y), BackgroundTransparency = 1 }, parent)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, r)
	return r
end

local giftWin, giftBody = window("🎁 CENTRE DES CADEAUX", Color3.fromRGB(201, 164, 255), K.rgb(0x1f1436))
local vipWin, vipBody = window("⭐ STRIKE PREMIUM", GOLD, K.rgb(0x2a1e08))
local state: any = nil
local renderGifts: () -> ()

local function refreshState()
	state = loyGet:InvokeServer()
	if not state then return end
	badge.Visible = #state.pending > 0
	badge.Text = tostring(#state.pending)
	vipBtn.Text = if state.vip then "⭐ Premium · " .. state.vipDaysLeft .. " j" else "⭐ Premium"
end

local function isPending(kind: string, i: number): boolean
	for _, p in ipairs(state.pending) do if p[1] == kind and p[2] == i then return true end end
	return false
end

-- Carte de cadeau : verrouillé (gris), prêt (doré, il bouge, clic = récupérer), reçu (✔)
local function giftCard(parent: Instance, icon: string, title: string, text: string, kind: string, i: number, done: boolean, progress: number?)
	local ready = isPending(kind, i)
	local f = make("TextButton", { Size = UDim2.fromOffset(112, 104), BackgroundColor3 = if ready then Color3.fromRGB(60, 40, 10) else DARK,
		Text = "", AutoButtonColor = ready }, parent)
	corner(f, 10); stroke(f, if ready then GOLD elseif done then GREEN else MUTED, if ready then 2 else 1)
	local ic = make("TextLabel", { Size = UDim2.new(1, 0, 0, 34), Position = UDim2.fromOffset(0, 4), BackgroundTransparency = 1, Text = icon, TextSize = 28,
		TextTransparency = if ready or done then 0 else 0.5 }, f)
	make("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 38), BackgroundTransparency = 1, Text = title, TextSize = 13 }, f)
	make("TextLabel", { Size = UDim2.new(1, -8, 0, 34), Position = UDim2.fromOffset(4, 54), BackgroundTransparency = 1, Text = text, TextSize = 10,
		TextWrapped = true, TextColor3 = Color3.fromRGB(197, 209, 228) }, f)
	local foot = if ready then "RÉCUPÉRER" elseif done then "✔ REÇU" else ""
	if foot ~= "" then
		make("TextLabel", { Size = UDim2.new(1, 0, 0, 14), Position = UDim2.new(0, 0, 1, -16), BackgroundTransparency = 1, Text = foot, TextSize = 11,
			TextColor3 = if ready then GOLD else GREEN }, f)
	elseif progress then
		local bar = make("Frame", { Size = UDim2.new(1, -16, 0, 4), Position = UDim2.new(0, 8, 1, -10), BackgroundColor3 = MUTED, BorderSizePixel = 0 }, f)
		make("Frame", { Size = UDim2.fromScale(math.clamp(progress, 0, 1), 1), BackgroundColor3 = Color3.fromRGB(255, 122, 26), BorderSizePixel = 0 }, bar)
	end
	if ready then
		wiggle(ic)
		f.AutoButtonColor = false; f.Selectable = true
		K.juice(f, 0.05)   -- survol / manette : grossit un peu, son d'interface
		f.Activated:Connect(function()
			local r = loyClaim:InvokeServer(kind, i)
			if r then pop(f) end
			refreshState(); renderGifts()
		end)
	end
end

renderGifts = function()
	for _, c in ipairs(giftBody:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	if not state then return end
	local nextG
	for _, g in ipairs(L.PLAYTIME_GIFTS) do if state.minutes < g.minutes then nextG = g; break end end
	local s1 = section(giftBody, 1, string.format("⏱ CADEAUX DE TEMPS DE JEU · %d min aujourd'hui · %s", state.minutes,
		if nextG then "prochain dans " .. (nextG.minutes - state.minutes) .. " min" else "tous débloqués !"), 146)
	local r1 = row(s1, 36)
	for i, g in ipairs(L.PLAYTIME_GIFTS) do
		giftCard(r1, g.icon, g.minutes .. " MIN", rewardText(g.reward), "pt", i, table.find(state.got, i) ~= nil, state.minutes / g.minutes)
	end
	local s2 = section(giftBody, 2, string.format("🔥 SÉRIE DE CONNEXION · %d jour(s) d'affilée%s", state.streak,
		if state.vip then " · ⭐ un jour manqué par semaine pardonné" else ""), 146)
	local r2 = row(s2, 36)
	for i, g in ipairs(L.STREAK_GOALS) do
		giftCard(r2, g.icon, g.days .. " JOURS", rewardText(g.reward), "st", i, table.find(state.streakGot, g.days) ~= nil, state.streak / g.days)
	end
	local t = L.TIERS[state.tier]
	local s3 = section(giftBody, 3, string.format('💠 RANG DE FIDÉLITÉ : <font color="#%s">%s</font> · %d jour(s) de jeu · +%d %% XP permanent',
		t.color:ToHex(), string.upper(t.name), state.days, t.xp), 146)
	local r3 = row(s3, 36)
	for i, x in ipairs(L.TIERS) do
		if x.reward then
			giftCard(r3, "💠", x.name, x.days .. " j · +" .. x.xp .. " % XP · " .. rewardText(x.reward), "tier", i, table.find(state.tiers, i) ~= nil, state.days / x.days)
		end
	end
	local s4 = section(giftBody, 4, "✨ BONUS ACTIFS", 110)
	local lines = {
		"💠 Fidélité +" .. t.xp .. " % XP",
		"⚡ Boost XP ×1,5 : " .. (if state.boost > 0 then state.boost .. " partie(s)" else "aucun"),
		"🏆 Première victoire du jour : " .. (if state.firstWinAvailable then "+" .. L.FIRST_WIN.xp .. " XP dispo" else "déjà prise"),
		"⭐ Premium : " .. (if state.vip then "+20 % XP et pièces · " .. state.vipDaysLeft .. " j" else "inactif"),
	}
	make("TextLabel", { Size = UDim2.new(1, -24, 0, 70), Position = UDim2.fromOffset(12, 34), BackgroundTransparency = 1, Text = table.concat(lines, "\n"),
		TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, s4)
	if isPending("vip", 0) then
		local b = make("TextButton", { Size = UDim2.fromOffset(250, 34), Position = UDim2.new(1, -262, 0, 40), BackgroundColor3 = GOLD,
			Text = "🎁 Cadeau Premium du jour : +" .. L.VIP.daily.coins, TextSize = 14, TextColor3 = Color3.fromRGB(42, 26, 0) }, s4)
		corner(b, 6); wiggle(b)
		b.Activated:Connect(function() loyClaim:InvokeServer("vip", 0); refreshState(); renderGifts() end)
	end
end

local function renderVip()
	for _, c in ipairs(vipBody:GetChildren()) do if c:IsA("Frame") then c:Destroy() end end
	if not state then return end
	local perks = {
		{ "🌈", "Couleur de pseudo exclusive", "Ton pseudo brille avec une étoile ⭐ dans le chat et le tableau des scores." },
		{ "⚡", "+20 % d'XP et +20 % de pièces", "À chaque fin de partie, en plus des autres bonus." },
		{ "🎁", "Cadeau Premium chaque jour", "+" .. L.VIP.daily.coins .. " pièces dans le Centre des cadeaux." },
		{ "🛡", "Série protégée", "Un jour manqué par semaine ne remet pas ta série à zéro." },
		{ "📦", "1 Caisse Premium offerte", "À chaque achat, plus le titre « ⭐ Premium »." },
	}
	local p = section(vipBody, 1, if state.vip then "⭐ PREMIUM ACTIF · encore " .. state.vipDaysLeft .. " jour(s)" else "AVANTAGES", 34 + #perks * 34)
	for i, k in ipairs(perks) do
		make("TextLabel", { Size = UDim2.new(1, -24, 0, 30), Position = UDim2.fromOffset(12, 4 + i * 34), BackgroundTransparency = 1,
			Text = k[1] .. '  <b>' .. k[2] .. '</b>  <font color="#8da0bd">' .. k[3] .. "</font>", TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left }, p)
	end
	local c = section(vipBody, 2, "COULEUR DE TON PSEUDO · aperçu : " .. L.richName(player), 90)
	local cr = make("Frame", { Size = UDim2.new(1, -24, 0, 40), Position = UDim2.fromOffset(12, 40), BackgroundTransparency = 1 }, c)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, cr)
	for _, col in ipairs(L.VIP.colors) do
		local b = make("TextButton", { Size = UDim2.fromOffset(130, 36), BackgroundColor3 = DARK, Text = "⭐ " .. col.name, TextSize = 14, TextColor3 = col.color }, cr)
		corner(b, 6); stroke(b, if state.vipColor == col.id then GOLD else MUTED, if state.vipColor == col.id then 2 else 1)
		if col.id == "rainbow" then gradient(b, Color3.fromRGB(255, 70, 85), Color3.fromRGB(74, 163, 255)) end
		b.Activated:Connect(function()
			if not state.vip then return end
			vipSetColor:InvokeServer(col.id); refreshState(); renderVip()
		end)
	end
	local o = section(vipBody, 3, "OFFRES (jours cumulables)", 100)
	local orow = make("Frame", { Size = UDim2.new(1, -24, 0, 54), Position = UDim2.fromOffset(12, 38), BackgroundTransparency = 1 }, o)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 10) }, orow)
	for _, off in ipairs(L.VIP.offers) do
		-- numéro du produit : celui de ProductIds.lua (repris par ShopCatalog), pas la valeur par défaut de LoyaltyConfig
		local it = Catalog.get(off.id)
		local pid = if it then it.productId or 0 else off.productId
		local b = make("TextButton", { Size = UDim2.fromOffset(330, 54), BackgroundColor3 = if pid > 0 then GOLD else MUTED,
			Text = string.format("%s%s · R$ %d", if off.best then "🔥 " else "", off.name, off.robux), TextSize = 17,
			TextColor3 = if pid > 0 then Color3.fromRGB(42, 26, 0) else Color3.new(1, 1, 1) }, orow)
		corner(b, 8)
		if pid > 0 then
			b.Activated:Connect(function() shopBuy:InvokeServer(off.id) end)   -- ShopService ouvre la fenêtre de paiement
		else
			b.Text ..= " · bientôt disponible"
		end
	end
end

giftBtn.Activated:Connect(function()
	vipWin.Visible = false
	giftWin.Visible = not giftWin.Visible
	if giftWin.Visible then refreshState(); renderGifts(); pop(giftWin) end
end)
vipBtn.Activated:Connect(function()
	giftWin.Visible = false
	vipWin.Visible = not vipWin.Visible
	if vipWin.Visible then refreshState(); renderVip(); pop(vipWin) end
end)
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, _id: number, purchased: boolean)
	if userId == player.UserId and purchased then task.wait(1); refreshState(); if vipWin.Visible then renderVip() end end
end)

-- ---------- notifications ----------
local function banner(icon: string, title: string, text: string)
	local f = make("Frame", { Size = UDim2.fromOffset(460, 76), Position = UDim2.new(0.5, 0, 0, -90), AnchorPoint = Vector2.new(0.5, 0),
		BackgroundColor3 = Color3.fromRGB(42, 22, 64) }, gui)
	corner(f, 10); stroke(f, GOLD, 2)
	local ic = make("TextLabel", { Size = UDim2.fromOffset(60, 76), BackgroundTransparency = 1, Text = icon, TextSize = 36 }, f)
	make("TextLabel", { Size = UDim2.new(1, -70, 0, 26), Position = UDim2.fromOffset(64, 10), BackgroundTransparency = 1, Text = title, TextSize = 17,
		TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left }, f)
	make("TextLabel", { Size = UDim2.new(1, -70, 0, 34), Position = UDim2.fromOffset(64, 36), BackgroundTransparency = 1, Text = text, TextSize = 12,
		TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(229, 220, 255) }, f)
	wiggle(ic)
	TweenService:Create(f, TweenInfo.new(0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Position = UDim2.new(0.5, 0, 0, 80) }):Play()
	task.delay(4.5, function()
		TweenService:Create(f, TweenInfo.new(0.4), { Position = UDim2.new(0.5, 0, 0, -90) }):Play()
		task.wait(0.5); f:Destroy()
	end)
end

player:GetAttributeChangedSignal("LoyaltyGiftReady"):Connect(function()
	local m = player:GetAttribute("LoyaltyGiftReady")
	for _, g in ipairs(L.PLAYTIME_GIFTS) do
		if g.minutes == m then banner(g.icon, "CADEAU DÉBLOQUÉ !", m .. " min de jeu aujourd'hui · " .. rewardText(g.reward) .. " · bouton 🎁 Cadeaux") end
	end
	refreshState()
end)
player:GetAttributeChangedSignal("LoyaltyWelcomeBack"):Connect(function()
	banner("🎉", "BON RETOUR !", "Tu nous as manqué. Cadeau : " .. rewardText(L.BACK_GIFT))
	refreshState()
end)

-- ---------- pseudo Premium en couleur dans le chat ----------
TextChatService.OnIncomingMessage = function(message: TextChatMessage)
	local props = Instance.new("TextChatMessageProperties")
	local src = message.TextSource
	local who = src and Players:GetPlayerByUserId(src.UserId)
	if who and who:GetAttribute("Vip") then props.PrefixText = L.richName(who) .. " :" end
	return props
end

task.spawn(refreshState)
task.spawn(function() while true do task.wait(60); refreshState() end end)   -- le badge suit les minutes jouées

-- ---------- menu principal (MainMenu) : ses boutons CADEAUX et PREMIUM ouvrent ces fenêtres ----------
giftBtn.Visible = false; vipBtn.Visible = false
gui.DisplayOrder = 30   -- au-dessus du menu
local panels = require(ReplicatedStorage.Shared.ClientState).panels
panels.gifts = function()
	vipWin.Visible = false
	giftWin.Visible = not giftWin.Visible
	if giftWin.Visible then refreshState(); renderGifts(); pop(giftWin) end
end
panels.vip = function()
	giftWin.Visible = false
	vipWin.Visible = not vipWin.Visible
	if vipWin.Visible then refreshState(); renderVip(); pop(vipWin) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="811">
        <Properties>
          <string name="Name">MainMenu</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/MainMenu (LocalScript)
-- Menu principal du jeu web (index.html #menu, src/87_nav.js, src/87d_lobby.js) : plein écran par-dessus le lobby,
-- logo STRIKE ARENA, navigation Accueil / Jouer / Arsenal / Profil / Réglages, encart du profil (niveau, XP, pièces,
-- caisses, BONUS DU JOUR), boutons BOUTIQUE, CADEAUX et PREMIUM. Chaque rubrique est un module de Menu/ (Home, Play, Arsenal, Profile, Settings).
-- Sous les onglets : une ligne « RUBRIQUE › SOUS-PARTIE · phrase d'aide » (TABS), pour savoir tout de suite où l'on est.
-- Organisation (une action principale par écran) :
--   ACCUEIL   JOUER (partie en ligne), partie rapide, avec des amis · saison, bonus du jour · défis · nouveautés, codes, communauté
--   JOUER     EN LIGNE / AVEC DES AMIS · 1 Mode · 2 Carte · 3 Jouer (parties en cours, réglages si une partie est créée)
--   ARSENAL   Armes · Viseurs · Tenues et effets (tenues, danses, sprays, effets d'élimination, traînées) · Caisses
--   PROFIL    Progression (rang, événement, saison) · Statistiques · Pseudo et titre
--   RÉGLAGES  Général · Point de visée · Son · Touches · Accessibilité (les mêmes que dans la pause)
-- S'ouvre à l'arrivée au lobby et au retour d'une partie ; se rouvre avec le bouton en haut à gauche, la touche P ou la croix
-- bas de la manette. En partie, P ouvre la pause (PauseMenu : Reprendre, Options, Menu principal, Quitter la partie),
-- d'où l'on rejoint ce menu, avec « Reprendre » et « Quitter la partie ». Le serveur vérifie tout (MatchService, PartyService, MenuService…).
-- Effets du web (src/8A_juice.js, src/87d_lobby.js) : fond animé avec deux lueurs, onglets qui glissent en fondu,
-- cartes qui apparaissent en cascade, menu qui s'ouvre en zoomant, pastille qui bat ; survol et clic des boutons dans Menu/Kit.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local TweenService = game:GetService("TweenService")

local Modes = require(ReplicatedStorage.Shared.Modes)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local S = require(ReplicatedStorage.Shared.ClientState)
local MenuDir = script.Parent:WaitForChild("Menu")
local K = require(MenuDir:WaitForChild("Kit"))
local Options = require(MenuDir:WaitForChild("Options"))
local Icons = require(ReplicatedStorage.Shared.Icons)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

-- ---------- serveur ----------
local function rf(name: string): RemoteFunction?
	local r = ReplicatedStorage:FindFirstChild(name)
	return if r and r:IsA("RemoteFunction") then r else nil
end
-- appel protégé : nil si le remote n'existe pas ou si le serveur plante
local function call(name: string, ...: any): ...any
	local r = rf(name) or (ReplicatedStorage:WaitForChild(name, 5) :: RemoteFunction?)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local res = table.pack(pcall(r.InvokeServer, r, ...))
	if not res[1] then warn("[MainMenu]", name, res[2]); return nil end
	return table.unpack(res, 2, res.n)
end

-- ---------- interface ----------
local bgGui = make("ScreenGui", { Name = "MainMenuBg", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 18, Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
-- voile du web : sombre à gauche (là où sont les panneaux), le lobby reste visible derrière (plus sombre que le web :
-- les panneaux et les textes 3D du lobby brouillaient la lecture du menu)
local veil = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1) }, bgGui)
make("UIGradient", { Color = ColorSequence.new(K.rgb(0x05080e), K.rgb(0x0b1220)), Transparency = NumberSequence.new({
	NumberSequenceKeypoint.new(0, 0.06), NumberSequenceKeypoint.new(0.55, 0.2), NumberSequenceKeypoint.new(1, 0.32) }), Rotation = 0 }, veil)
local veil2 = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0, BackgroundColor3 = Color3.new(1, 1, 1) }, bgGui)
make("UIGradient", { Color = ColorSequence.new(K.rgb(0x05080e), K.rgb(0x2a1608)), Transparency = NumberSequence.new(0.35, 0.75), Rotation = -90 }, veil2)
-- fond animé du web (#menu::before) : une lueur rouge en bas à gauche, une bleue en haut à droite, qui dérivent lentement
-- (14 s, aller-retour). Une lueur = cercles concentriques très transparents : plus dense au centre, fondue sur les bords.
local glows: { { Frame } } = {}
local function glow(pos: UDim2, size: number, color: Color3, drift: UDim2): { Frame }
	local holder = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromScale(size, size), SizeConstraint = Enum.SizeConstraint.RelativeXX }, bgGui)
	local rings = {}
	for i = 1, 7 do
		local f = i / 7
		local r = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromScale(f, f),
			BackgroundTransparency = 0.972, BackgroundColor3 = color }, holder)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, r)
		table.insert(rings, r)
	end
	TweenService:Create(holder, TweenInfo.new(14, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true),
		{ Position = pos + drift, Size = UDim2.fromScale(size * 1.08, size * 1.08) }):Play()
	table.insert(glows, rings)
	return rings
end
glow(UDim2.fromScale(0.15, 1.05), 0.75, C.accent, UDim2.fromScale(0.03, -0.04))
glow(UDim2.fromScale(0.9, -0.08), 0.6, C.blue, UDim2.fromScale(-0.03, 0.03))
pcall(function() require(MenuDir:WaitForChild("Fx")).ambient(bgGui) end)   -- poussières lumineuses et éclats (Menu/Fx)
-- Halloween (#menu.theme-hw::before) : orange et violet
local function glowTheme(hw: boolean)
	local cols = if hw then { C.orange, K.rgb(0x8a3dff) } else { C.accent, C.blue }
	for i, rings in ipairs(glows) do for _, r in ipairs(rings) do r.BackgroundColor3 = cols[i] end end
end

local gui = make("ScreenGui", { Name = "MainMenu", ResetOnSpawn = false, DisplayOrder = 19, Enabled = false, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
local root = make("Frame", { Name = "Root", Size = UDim2.fromOffset(1600, 900), AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0) }, gui)
local uiScale = make("UIScale", {}, root)
local modal = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1), Modal = true, Selectable = false }, gui)   -- libère la souris

-- bouton pour rouvrir le menu depuis le lobby
local openGui = make("ScreenGui", { Name = "MainMenuButton", ResetOnSpawn = false, DisplayOrder = 8 }, playerGui)
local openBtn = K.btn(openGui, "☰  " .. spaced("MENU", 1) .. '  <font color="#8da0bd" size="11">P</font>', "dark", nil,
	{ Position = UDim2.fromOffset(16, 10), Size = UDim2.fromOffset(132, 40), TextSize = 14, Visible = false })

-- ---------- état ----------
-- rubriques : n = nom de l'onglet, help = phrase d'aide ; subs = sous-parties { id (clé gardée dans ctx.sub), n (nom affiché), help }
type Sub = { id: string, n: string, help: string }
local TABS: { { id: string, n: string, ic: string, help: string?, subs: { Sub }? } } = {
	{ id = "home", n = "ACCUEIL", ic = "⌂", help = "Lance une partie, récupère tes cadeaux et relève les défis du jour." },
	{ id = "play", n = "JOUER", ic = "▶", help = "Trois étapes : choisis un mode, puis une carte, puis appuie sur JOUER." },
	{ id = "arsenal", n = "ARSENAL", ic = "◆", subs = {
		{ id = "Armes", n = "Armes", help = "Choisis tes armes, compare leurs statistiques et mets-leur un skin." },
		{ id = "Viseurs", n = "Viseurs", help = "L'optique posée sur chaque arme et le réticule qu'on voit dedans." },
		{ id = "Casier", n = "Tenues et effets", help = "Tenue du soldat, danses (T), sprays (J), effets d'élimination et traînées de balles." },
		{ id = "Caisses", n = "Caisses", help = "Ouvre des caisses pour gagner des skins, des danses et des tenues." },
	} },
	{ id = "profile", n = "PROFIL", ic = "★", subs = {
		{ id = "Progression", n = "Progression", help = "Ton rang, l'événement en cours et la saison. Les défis sont sur l'Accueil." },
		{ id = "Statistiques", n = "Statistiques", help = "Tes résultats : parties, victoires, précision et armes préférées." },
		{ id = "Style", n = "Pseudo et titre", help = "La couleur de ton pseudo et le titre affiché à côté de ton nom." },
	} },
	{ id = "settings", n = "RÉGLAGES", ic = "⚙", subs = MenuConfig.SETTINGS_TABS },
}
local PAGES: { [string]: any } = {}
for _, id in ipairs({ "Home", "Play", "Arsenal", "Profile", "Settings" }) do
	local m = MenuDir:WaitForChild(id, 10)
	if m and m:IsA("ModuleScript") then
		local ok, res = pcall(require, m)
		if ok then PAGES[string.lower(id)] = res else warn("[MainMenu] module " .. id, res) end
	end
end

local ctx: any = {
	K = K, call = call, player = player,
	data = nil :: any, loy = nil :: any, shop = nil :: any,
	tab = "home", sub = { arsenal = "Armes", profile = "Progression", settings = "Général" } :: { [string]: string },
	play = Modes.sanitize({}), friends = false,
	party = { id = nil :: string?, members = {} :: { any } },
	W = 1600, H = 900, newsSeen = false, busy = false,
}
ctx.play.mode = "bomb"; ctx.play.map = "village"; ctx.play.diff = 3; ctx.play.size = 5; ctx.play.limit = Modes.defaultLimit("bomb")
local open = false

local function zone(): string
	local z = player:GetAttribute("Zone")
	return if typeof(z) == "string" then z else ""
end
ctx.zone = zone
function ctx.inMatch(): boolean return zone() == "match" end

-- ---------- message court ----------
local toastLabel = text(root, { Name = "Toast", AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -44), Size = UDim2.fromOffset(640, 40),
	BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x0b111c), TextXAlignment = Enum.TextXAlignment.Center, TextSize = 15, ZIndex = 80, Visible = false })
K.corner(toastLabel, 10); K.stroke(toastLabel, C.white, 1, 0.85)
local toastN = 0
function ctx.toast(msg: string, color: Color3?)
	toastN += 1
	local my = toastN
	toastLabel.Text = msg; toastLabel.TextColor3 = color or C.text; toastLabel.Visible = true
	task.delay(3.2, function() if my == toastN then toastLabel.Visible = false end end)
end

-- ---------- réglages : Menu/Options (appliqués côté client, gardés dans le profil, partagés avec la pause) ----------
ctx.opts = Options.v
ctx.applyOpts = Options.apply
local saveTokens: { [string]: number } = {}
function ctx.save(kind: string)   -- enregistre dans le profil, une seconde après le dernier changement
	if kind == "opts" then Options.save(); return end
	saveTokens[kind] = (saveTokens[kind] or 0) + 1
	local my = saveTokens[kind]
	task.delay(1, function()
		if saveTokens[kind] ~= my then return end
		local payload = if kind == "play" then table.clone(ctx.play) else ctx.opts
		if kind == "play" then payload.friends = ctx.friends end
		call("MenuSave", kind, payload)
	end)
end

-- ---------- données ----------
local headerRefs: any = {}
local render: () -> ()
local loadedOnce = false
function ctx.refresh(andRender: boolean?)
	local d = call("GetProfile")
	if d then
		ctx.data = d
		if not loadedOnce then
			loadedOnce = true
			local menu = d.profile and d.profile.menu
			if typeof(menu) == "table" then
				if typeof(menu.play) == "table" then
					ctx.play = Modes.sanitize(menu.play); ctx.friends = menu.play.friends == true
				end
			end
			Options.load(d.profile)   -- anciens réglages (menu.opts) puis toutes les options (profile.options), appliqués
		end
		glowTheme(d.eventActive == true)
	end
	ctx.loy = call("Loy_Get") or ctx.loy
	ctx.ch = call("GetChallenges") or ctx.ch          -- défis du jour / de la semaine, avec leurs textes (pool complet du web)
	ctx.ev = call("EventStatus") or ctx.ev            -- événement d'Halloween (citrouilles, paliers)
	if headerRefs.update then headerRefs.update() end
	if andRender ~= false and open then render() end
end
-- défis, récompense du jour, cadeaux, nouveautés : la pastille sur « Accueil »
function ctx.pending(): number
	local n = 0
	local d = ctx.data
	if d and d.profile then
		local ch = ctx.ch
		for _, m in ipairs(ch and ch.daily or d.profile.missions and d.profile.missions.list or {}) do if m.done and not m.claimed then n += 1 end end
		for _, m in ipairs(ch and ch.weekly or d.profile.wmis and d.profile.wmis.list or {}) do if m.done and not m.claimed then n += 1 end end
		if d.daily and d.daily.canClaim then n += 1 end
	end
	if ctx.loy and ctx.loy.pending then n += #ctx.loy.pending end
	if not ctx.newsSeen then n += 1 end
	return n
end

-- caisses gagnées pas encore ouvertes (pastille sur « Arsenal » et sur « Caisses »)
function ctx.boxCount(): number
	local b = ctx.data and ctx.data.profile and ctx.data.profile.boxes
	if typeof(b) ~= "table" then return 0 end
	return (tonumber(b.std) or 0) + (tonumber(b.prem) or 0)
end

-- fenêtres des autres interfaces (ShopUI, LoyaltyUI, CommunityUI, LoadoutUI) : registre de ClientState
function ctx.panel(name: string): boolean
	local f = S.panels[name]
	if f then task.spawn(f); return true end
	ctx.toast("Bientôt disponible", C.gold)
	return false
end

-- récompense du jour (bouton RÉCOMPENSE et carte « Cadeau du jour ») : ouvre le calendrier de connexion (DailyUI)
-- s'il est chargé ; sinon récupère directement comme avant
function ctx.claimDaily()
	local cal = S.panels.daily
	if cal then task.spawn(cal); return end
	local d = ctx.data
	if d and d.daily and not d.daily.canClaim then
		ctx.toast("Déjà récupérée · série de " .. tostring(d.daily.streak) .. " jour(s) · reviens demain", C.dim); return
	end
	local res = call("ClaimDaily")
	if res and res.reward then
		local r = res.reward
		local parts = {}
		if r.coins then table.insert(parts, "+" .. r.coins .. " 💰") end
		if r.box then table.insert(parts, "1 caisse") end
		if r.dance then table.insert(parts, "danse") end
		ctx.toast("🎁 Jour " .. tostring(res.day) .. " : " .. table.concat(parts, " · "), C.gold)
	end
	ctx.refresh()
end

-- passe de combat : la fenêtre du passe (PassUI) si elle est chargée, sinon l'onglet Progression du profil
function ctx.openPass()
	local f = S.panels.pass
	if f then task.spawn(f) else ctx.go("profile", "Progression") end
end

-- ---------- lancer une partie ----------
function ctx.leaveMatch()
	call("MatchLeave")
end
local function launch(fn: () -> (boolean?, string?))
	if ctx.busy then return end
	ctx.busy = true
	if ctx.inMatch() then call("MatchLeave"); task.wait(0.4) end
	ctx.toast("Lancement de la partie…", C.gold)
	local ok, err = fn()
	ctx.busy = false
	if ok then ctx.close() else ctx.toast("❌ " .. tostring(err or "Impossible de lancer la partie"), C.accent) end
end
function ctx.startPlay()
	if ctx.friends and ctx.party.id and player:GetAttribute("PartyLeader") ~= true then
		ctx.toast("Seul le chef du groupe lance la partie", C.gold); return
	end
	local s = table.clone(ctx.play)
	s.private = ctx.friends and ctx.party.id ~= nil
	launch(function() return call("MatchCreate", s) end)
end
function ctx.quick(mode: string?)
	launch(function() return call("MatchQuick", mode) end)
end
function ctx.join(id: number)
	launch(function() return call("MatchJoin", id) end)
end

-- groupe d'amis (PartyService)
local partyEv = ReplicatedStorage:WaitForChild("PartyUpdate", 10) :: RemoteEvent?
if partyEv then
	partyEv.OnClientEvent:Connect(function(id: string?, names: { any })
		ctx.party.id = id; ctx.party.members = names or {}
		if open and ctx.tab == "play" then render() end
	end)
end

-- ---------- mise à l'échelle (téléphones) ----------
local function computeScale()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	local inset = GuiService:GetGuiInset()
	local w, h = vp.X, math.max(200, vp.Y - inset.Y)
	-- base 1280 × 720 (taille du texte du web sur un écran de portable) ; au-delà de 1600 de large, le menu reste
	-- centré au lieu de s'étirer sur tout l'écran (fenêtres Studio très larges, écrans 21:9)
	local s = math.clamp(math.min(w / 1280, h / 720), 0.6, 1.6)
	-- AccessibilityController pose un UIScale « AccessScale » sur chaque ScreenGui : le menu, lui, doit tenir dans l'écran
	local acc = gui:FindFirstChild("AccessScale")
	uiScale.Scale = s / (if acc and acc:IsA("UIScale") and acc.Scale > 0 then acc.Scale else 1)
	ctx.W, ctx.H = math.min(math.floor(w / s), 1600), math.floor(h / s)
	root.Size = UDim2.fromOffset(ctx.W, ctx.H)
end

-- ---------- en-tête : logo, navigation, profil ----------
local header = make("Frame", { Name = "Header", Size = UDim2.new(1, 0, 0, 90) }, root)
local subRow = make("Frame", { Name = "SubRow", Size = UDim2.new(1, -56, 0, 40), Position = UDim2.fromOffset(28, 96) }, root)
-- en partie : bandeau « PARTIE EN COURS » (mode photo, reprendre, quitter) sur sa propre ligne, sous les sous-onglets
local matchRow = make("Frame", { Name = "MatchRow", Size = UDim2.new(1, -56, 0, 36), Position = UDim2.fromOffset(28, 140), Visible = false }, root)
local body = make("Frame", { Name = "Body", Size = UDim2.new(1, -56, 1, -170), Position = UDim2.fromOffset(28, 140), ClipsDescendants = true }, root)
-- en haut de chaque page : « RUBRIQUE › SOUS-PARTIE   phrase d'aide » ; la page elle-même est dessinée dans « pageBox »
local helpBar = text(body, { Name = "HelpBar", Size = UDim2.new(1, 0, 0, 22), TextSize = 13, TextColor3 = C.white, Font = K.MED, TextWrapped = false,
	TextTruncate = Enum.TextTruncate.AtEnd, Text = "" })
local pageBox = make("Frame", { Name = "Page", Position = UDim2.fromOffset(0, 30), Size = UDim2.new(1, 0, 1, -30), ClipsDescendants = true }, body)
local footer = text(root, { Name = "Footer", AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 28, 1, -8), Size = UDim2.new(1, -56, 0, 16),
	TextSize = 11, TextColor3 = C.mute, Font = K.MED, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
	Text = 'P : menu (en partie : pause)  •  Échap · B : retour  •  LB / RB : rubriques  •  Tous les réglages sont sauvegardés automatiquement  •  <u>Crédits</u> : modèles d\'armes « Low-Poly » de TastyTony (CC BY 4.0)' })
local navButtons: { [string]: TextButton } = {}

-- Mise en page de l'en-tête (barre du haut du web : logo | navigation | encart du profil, puis BOUTIQUE / CADEAUX /
-- PREMIUM sous l'encart). Tout a une taille fixe : rien ne grandit avec son texte, donc rien ne se chevauche.
--   large (W >= 1552, écrans 21:9) : logo, onglets et profil sur une ligne ; sous-onglets à gauche et boutons à droite dessous
--   normal (16:9, 4:3, 1024 à 1920 px : W vaut 1280 avec l'UIScale) : logo et profil, puis onglets à gauche et boutons à droite
--   étroit (téléphone en hauteur) : profil, onglets, puis boutons ; le logo est caché
local TAB_W, TAB_H = 132, 42   -- barre : 5 onglets + écarts de 2 + marge intérieure de 4 de chaque côté = 676
local LOGO_W, PBOX_W, SHOP_W = 340, 440, 380
local function buildHeader()
	K.clear(header)
	navButtons = {}
	local W = ctx.W
	-- téléphone en hauteur : les onglets rétrécissent pour tenir dans la largeur
	local tabW = math.min(TAB_W, math.floor((W - 56 - 8 - 2 * (#TABS - 1)) / #TABS))
	local NAV_W = #TABS * tabW + (#TABS - 1) * 2 + 8
	local wide = W >= 28 + LOGO_W + 20 + NAV_W + 20 + PBOX_W + 28
	local narrow = W < 28 + LOGO_W + 16 + PBOX_W + 28
	local shopBeside = W >= 28 + NAV_W + 16 + SHOP_W + 28   -- boutons sur la ligne des onglets
	-- logo
	local logo = make("Frame", { Position = UDim2.fromOffset(28, 20), Size = UDim2.fromOffset(LOGO_W, 50), Visible = not narrow }, header)
	local barL = make("Frame", { Size = UDim2.fromOffset(4, 44), BackgroundTransparency = 0, BackgroundColor3 = C.white }, logo)
	K.gradient(barL, C.orange, C.accent, 90)
	K.fit(text(logo, { Position = UDim2.fromOffset(18, -2), Size = UDim2.new(1, -18, 0, 32), Font = K.BLACK, TextSize = 29, TextWrapped = false,
		Text = spaced("STRIKE", 2) .. '   <font color="#ff8a3a">' .. spaced("ARENA", 2) .. "</font>" }), 29, 16)
	local nModes, nMaps = 0, #Modes.MAPS
	for _ in pairs(Modes.LIST) do nModes += 1 end
	K.fit(text(logo, { Position = UDim2.fromOffset(19, 32), Size = UDim2.new(1, -19, 0, 14), Font = K.BOLD, TextSize = 10, TextColor3 = C.dim, TextWrapped = false,
		Text = spaced("FPS TACTIQUE  •  " .. nModes .. " MODES  •  " .. nMaps .. " CARTES  •  BOTS IA", 1) }), 10, 7)
	-- encart du profil (en haut à droite ; à gauche sur un téléphone en hauteur)
	local pw = math.min(PBOX_W, W - 56)
	local pbox = make("Frame", { AnchorPoint = Vector2.new(if narrow then 0 else 1, 0), Position = if narrow then UDim2.fromOffset(28, 16) else UDim2.new(1, -28, 0, 16),
		Size = UDim2.fromOffset(pw, 62), BackgroundTransparency = 0.15, BackgroundColor3 = C.deep }, header)
	K.corner(pbox, 6); K.stroke(pbox, C.white, 1, 0.9)
	local d = ctx.data
	local lvl = if d then d.level else 1
	local badge = K.levelBadge(pbox, lvl, 38); badge.Position = UDim2.fromOffset(12, 12)
	-- colonnes de l'encart : niveau 12-50 · pseudo et XP 60-190 · pièces et caisses 198-280 · BONUS DU JOUR (148) à droite
	local nameL = text(pbox, { Position = UDim2.fromOffset(60, 8), Size = UDim2.fromOffset(130, 18), Font = K.BLACK, TextSize = 15, TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = K.esc(player.DisplayName) })
	local xpBar = K.bar(pbox, if d then d.xp / math.max(1, d.xpNeed) else 0, { Position = UDim2.fromOffset(60, 30), Size = UDim2.fromOffset(110, 5) })
	local xpL = text(pbox, { Position = UDim2.fromOffset(60, 38), Size = UDim2.fromOffset(130, 14), TextSize = 10, TextColor3 = C.dim, TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = if d then K.fmt(d.xp) .. " / " .. K.fmt(d.xpNeed) .. " XP" else "…" })
	-- pièces : la pièce est dessinée (Shared/Icons), l'emoji pièce du web donne un carré vide dans Roblox
	Icons.coin(pbox, 16, { Position = UDim2.fromOffset(198, 10) })
	local coinsL = text(pbox, { Position = UDim2.fromOffset(220, 8), Size = UDim2.fromOffset(62, 20), Font = K.BLACK, TextSize = 15, TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = "…" })
	local boxL = text(pbox, { Position = UDim2.fromOffset(198, 34), Size = UDim2.fromOffset(84, 18), Font = K.BOLD, TextSize = 12, TextColor3 = C.sub, TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = "" })
	-- bonus du jour (ClaimDaily) : rouge quand il attend, discret une fois récupéré
	local canClaim = d ~= nil and d.daily ~= nil and d.daily.canClaim == true
	local rew = K.btn(pbox, "📅  BONUS DU JOUR", if canClaim or not d then "primary" else "alt", ctx.claimDaily,
		{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(148, 40), TextSize = 12, Name = "DailyBonus" })
	K.fit(rew, 12, 8)
	if canClaim or not d then K.setBtnColor(rew, K.rgb(0xff5f48)) end
	if pw < 420 then   -- téléphone : plus de place pour les pièces que pour le bouton
		rew.Size = UDim2.fromOffset(math.max(90, pw - 292), 40)
	end
	-- navigation : onglets de taille fixe (l'onglet choisi ne s'étire plus sur toute la barre)
	local navY = if wide then 20 else 86
	local navX = if wide then math.floor((28 + LOGO_W + 20 + (W - 28 - PBOX_W - 20)) / 2 - NAV_W / 2) else 28
	local nav = make("Frame", { Position = UDim2.fromOffset(navX, navY), Size = UDim2.fromOffset(NAV_W, 50), BackgroundTransparency = 0.4, BackgroundColor3 = C.deep }, header)
	K.corner(nav, 12); K.stroke(nav, C.white, 1, 0.93); K.pad(nav, 4); K.hlist(nav, 2)
	for i, t in ipairs(TABS) do
		local on = ctx.tab == t.id
		local b = K.btn(nav, t.ic .. "  " .. spaced(t.n, 1), if on then "primary" else "ghost", function()
			ctx.go(t.id)
		end, { LayoutOrder = i, Size = UDim2.fromOffset(tabW, TAB_H), TextSize = 13, BackgroundTransparency = if on then 0 else 1,
			TextColor3 = if on then C.white else K.rgb(0xc5d1e4), TextWrapped = false })
		K.pad(b, 8, 0); K.fit(b, 13, 9)
		local st = b:FindFirstChildOfClass("UIStroke"); if st then st:Destroy() end
		-- pastilles : ce qui attend sur l'Accueil (défis finis, bonus, cadeaux, nouveautés), caisses à ouvrir dans l'Arsenal
		local n = if t.id == "home" then ctx.pending() elseif t.id == "arsenal" then ctx.boxCount() else 0
		if n > 0 and not on then   -- comme le web : pas de pastille sur la rubrique ouverte
			local dot = text(b, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 6, 0, -2), Size = UDim2.fromOffset(17, 17), Text = tostring(math.min(n, 99)),
				BackgroundTransparency = 0, BackgroundColor3 = if t.id == "home" then C.gold else C.blue, TextColor3 = if t.id == "home" then C.ink else C.white,
				Font = K.BLACK, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = b.ZIndex + 1 })
			K.corner(dot, 9); K.beat(dot)   -- bat comme la pastille .ndot du web
		end
		navButtons[t.id] = b
	end
	-- CADEAUX, BOUTIQUE et PREMIUM : sous l'encart (large), au bout de la ligne des onglets, ou sur leur propre ligne
	local shopY = if wide then 86 elseif shopBeside then navY + 9 else navY + 58
	local row = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -28, 0, shopY), Size = UDim2.fromOffset(SHOP_W, 32) }, header)
	local lay = K.hlist(row, 10); lay.HorizontalAlignment = Enum.HorizontalAlignment.Right
	K.fit(K.btn(row, "🛒  " .. spaced("BOUTIQUE", 1), "alt", function() ctx.panel("shop") end, { Size = UDim2.fromOffset(124, 30), TextSize = 11, LayoutOrder = 1 }), 11, 8)
	local giftB = K.btn(row, "🎁  " .. spaced("CADEAUX", 1), "purple", function() ctx.panel("gifts") end, { Size = UDim2.fromOffset(118, 30), TextSize = 11, LayoutOrder = 2 })
	local vipB = K.btn(row, "⭐  " .. spaced("PREMIUM", 1), "gold", function() ctx.panel("vip") end, { Size = UDim2.fromOffset(118, 30), TextSize = 11, LayoutOrder = 3 })
	K.fit(giftB, 11, 8); K.fit(vipB, 11, 8)
	K.setBtnColor(vipB, K.rgb(0xffc53a))
	local giftDot = text(giftB, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 6, 0, -6), Size = UDim2.fromOffset(18, 18), BackgroundTransparency = 0,
		BackgroundColor3 = C.accent, TextXAlignment = Enum.TextXAlignment.Center, Font = K.BLACK, TextSize = 10, Text = "", Visible = false, ZIndex = giftB.ZIndex + 1 })
	K.corner(giftDot, 9)
	headerRefs.update = function()
		local dd = ctx.data
		if dd then
			badge:Destroy(); badge = K.levelBadge(pbox, dd.level, 38); badge.Position = UDim2.fromOffset(12, 12)
			local fill = xpBar:FindFirstChild("Fill") :: Frame?
			if fill then fill.Size = UDim2.fromScale(math.clamp(dd.xp / math.max(1, dd.xpNeed), 0, 1), 1) end
			xpL.Text = K.fmt(dd.xp) .. " / " .. K.fmt(dd.xpNeed) .. " XP"
			local b = dd.profile.boxes or {}
			coinsL.Text = K.fmt(dd.profile.coins or 0)
			boxL.Text = "📦  " .. tostring((b.std or 0) + (b.prem or 0)) .. " caisse" .. (if (b.std or 0) + (b.prem or 0) > 1 then "s" else "")
			local title = player:GetAttribute("Title")
			nameL.Text = K.esc(player.DisplayName) .. (if typeof(title) == "string" then '  <font size="10" color="#ffd23a">' .. K.esc(title) .. "</font>" else "")
		end
		local lp = ctx.loy and ctx.loy.pending and #ctx.loy.pending or 0
		giftDot.Visible = lp > 0; giftDot.Text = tostring(lp)
		if ctx.loy and ctx.loy.vip then vipB.Text = "⭐  " .. spaced("PREMIUM", 1) .. " · " .. tostring(ctx.loy.vipDaysLeft) .. " j" end
	end
	headerRefs.update()
	-- disposition verticale : ligne des sous-onglets, bandeau « partie en cours » (en partie), puis la page
	local subY = if wide then 86 elseif shopBeside then navY + 58 else shopY + 40
	header.Size = UDim2.new(1, 0, 0, subY)
	-- en large, les sous-onglets partagent leur ligne avec les boutons de droite
	subRow.Position = UDim2.fromOffset(28, subY)
	subRow.Size = UDim2.new(1, if wide then -(56 + SHOP_W + 16) else -56, 0, 36)
	local top = subY + 42
	matchRow.Visible = ctx.inMatch()
	matchRow.Position = UDim2.fromOffset(28, top)
	if ctx.inMatch() then top += 42 end
	body.Position = UDim2.fromOffset(28, top); body.Size = UDim2.new(1, -56, 1, -(top + 30))
	footer.Visible = ctx.W >= 900
end

-- ---------- sous-onglets (Armes / Viseurs…) et bandeau « partie en cours » ----------
local function buildSubRow()
	K.clear(subRow); K.clear(matchRow)
	local t: any = nil
	for _, x in ipairs(TABS) do if x.id == ctx.tab then t = x end end
	local row = make("Frame", { Size = UDim2.fromScale(1, 1), AutomaticSize = Enum.AutomaticSize.None }, subRow)
	K.hlist(row, 8)
	if t and t.subs then
		for i, s in ipairs(t.subs) do
			local on = ctx.sub[t.id] == s.id
			local b = K.btn(row, spaced(s.n, 1), if on then "white" else "dark", function() if ctx.sub[t.id] ~= s.id then ctx.goSub(t.id, s.id) end end,
				{ LayoutOrder = i, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 32), TextSize = 13, Font = K.BLACK })
			K.pad(b, 16, 0); K.corner(b, 16)
			local c = b:FindFirstChildOfClass("UICorner"); if c then c.CornerRadius = UDim.new(0, 16) end
			-- « Caisses » : nombre de caisses à ouvrir
			local nb = if s.id == "Caisses" then ctx.boxCount() else 0
			if nb > 0 then b.Text ..= '  <font color="' .. (if on then "#2c7fe0" else "#4aa3ff") .. '">● ' .. nb .. "</font>" end
		end
	end
	-- ligne d'aide : où l'on est et à quoi sert cette page
	if t then
		local subDef: Sub? = nil
		for _, s in ipairs(t.subs or {}) do if s.id == ctx.sub[t.id] then subDef = s end end
		local where = t.n .. (if subDef then "  ›  " .. K.upper(subDef.n) else "")
		helpBar.Text = "<b>" .. spaced(where, 1) .. '</b>    <font color="#b8c5da">' .. K.esc(if subDef then subDef.help else (t.help or "")) .. "</font>"
	end
	-- en partie : on peut reprendre ou quitter
	if ctx.inMatch() then
		local strip = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.new(0, math.min(760, ctx.W - 56), 0, 36),
			BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x2a0f14) }, matchRow)
		K.corner(strip, 8); K.stroke(strip, C.accent, 1, 0.5); K.pad(strip, 12, 0, 4, 0)
		local mm = player:GetAttribute("MatchMode")
		local mdef = if typeof(mm) == "string" then Modes.LIST[mm] else nil
		text(strip, { Size = UDim2.new(1, -420, 1, 0), TextSize = 12, Font = K.BLACK, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
			Text = '<font color="#ff4655">●</font>  ' .. spaced("PARTIE EN COURS", 1) .. (if mdef then '  <font color="#b8c5da">· ' .. mdef.n .. "</font>" else "") })
		K.btn(strip, "📷  MODE PHOTO", "alt", function()
			ctx.close()
			local ok, err = pcall(function() require(ReplicatedStorage.Shared.PhotoMode).enter() end)
			if not ok then warn("[MainMenu] PhotoMode", err) end
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -280, 0.5, 0), Size = UDim2.fromOffset(124, 28), TextSize = 11 })
		K.btn(strip, "▶  REPRENDRE", "primary", function() ctx.close() end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -150, 0.5, 0), Size = UDim2.fromOffset(124, 28), TextSize = 12 })
		K.btn(strip, "QUITTER LA PARTIE", "dark", function()
			ctx.leaveMatch(); ctx.go("home")
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(146, 28), TextSize = 11 })
	end
end

-- ---------- rendu d'une rubrique ----------
local function scrollPositions(): { [string]: Vector2 }
	local out = {}
	for _, d in ipairs(pageBox:GetDescendants()) do if d:IsA("ScrollingFrame") then out[d.Name] = d.CanvasPosition end end
	return out
end
-- changement d'onglet (dir = -1 / 1) : la page arrive en glissant et en fondu (tpin du web), puis ses cartes en cascade.
-- Le fondu passe par un CanvasGroup le temps de l'animation ; ensuite la page est remise directement dans « pageBox »
-- (un CanvasGroup permanent rendrait le texte un peu flou).
local fadeN, fadeAt = 0, 0
local function animateIn(host: CanvasGroup, dir: number)
	fadeN += 1; fadeAt = os.clock()
	local my = fadeN
	host.GroupTransparency = 1
	host.Position = UDim2.fromOffset(28 * dir, 0)
	task.defer(function()
		if not host.Parent then return end
		K.cascade(host)
		local tw = K.tween(host, 0.28, { GroupTransparency = 0, Position = UDim2.fromOffset(0, 0) }, Enum.EasingStyle.Quint)
		tw.Completed:Connect(function()
			if my ~= fadeN or host.Parent ~= pageBox then return end
			for _, c in ipairs(host:GetChildren()) do c.Parent = pageBox end
			host:Destroy()
		end)
	end)
end
local function renderWith(dir: number?)
	if not open then return end
	local keep = scrollPositions()
	buildHeader(); buildSubRow()
	K.clear(pageBox)
	local host: GuiObject = pageBox
	if dir then host = make("CanvasGroup", { Name = "PageFade", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 }, pageBox) end
	local pageFn = PAGES[ctx.tab]
	if pageFn then
		local ok, err = pcall(pageFn, ctx, host, ctx.sub[ctx.tab])
		if not ok then
			warn("[MainMenu] rubrique " .. ctx.tab, err)
			text(host, { Text = "Cette rubrique n'a pas pu s'afficher.", TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 30) })
		end
	end
	if dir and host:IsA("CanvasGroup") then animateIn(host, dir) end
	task.defer(function()
		for _, d in ipairs(pageBox:GetDescendants()) do
			if d:IsA("ScrollingFrame") and keep[d.Name] then d.CanvasPosition = keep[d.Name] end
		end
	end)
end
-- un rafraîchissement (profil reçu juste après l'ouverture…) attend la fin de l'animation au lieu de la couper
local renderLater = false
render = function()
	if pageBox:FindFirstChild("PageFade") and os.clock() - fadeAt < 1 then
		if not renderLater then
			renderLater = true
			task.delay(0.35, function() renderLater = false; render() end)
		end
		return
	end
	renderWith(nil)
end
ctx.render = function() render() end

local function tabIndex(id: string): number
	for i, t in ipairs(TABS) do if t.id == id then return i end end
	return 1
end
-- sous-onglet (Armes / Viseurs…, Général / Son…) : glisse depuis le côté où il se trouve
function ctx.goSub(tab: string, s: string)
	local t = TABS[tabIndex(tab)]
	local function at(id: string?): number
		for i, x in ipairs(t.subs or {}) do if x.id == id then return i end end
		return 1
	end
	local old, new = at(ctx.sub[tab]), at(s)
	ctx.sub[tab] = s
	renderWith(if new >= old then 1 else -1)
end

function ctx.go(tab: string, sub: string?)
	local dir = if tabIndex(tab) >= tabIndex(ctx.tab) then 1 else -1
	local changed = tab ~= ctx.tab or (sub ~= nil and sub ~= ctx.sub[tab])
	if tab ~= ctx.tab then
		for _, d in ipairs(pageBox:GetDescendants()) do if d:IsA("ScrollingFrame") then d.CanvasPosition = Vector2.zero end end
	end
	if ctx.tab == "home" then ctx.newsSeen = true end
	ctx.tab = tab
	if sub then ctx.sub[tab] = sub end
	if changed then renderWith(dir) else render() end
	if UserInputService.GamepadEnabled and navButtons[tab] then GuiService.SelectedObject = navButtons[tab] end
end

-- ---------- ouverture / fermeture ----------
local controls: any = nil
task.spawn(function()
	local ps = player:WaitForChild("PlayerScripts")
	local pm = ps:WaitForChild("PlayerModule", 10)
	if pm and pm:IsA("ModuleScript") then
		local ok, m = pcall(require, pm)
		if ok and m and (m :: any).GetControls then controls = (m :: any):GetControls() end
	end
end)

local function tabStep(dir: number)
	local idx = 1
	for i, t in ipairs(TABS) do if t.id == ctx.tab then idx = i end end
	ctx.go(TABS[(idx - 1 + dir) % #TABS + 1].id)
end
local function bindOpenActions(on: boolean)
	if on then
		-- « retour » : une rubrique revient à l'Accueil ; sur l'Accueil, B referme le menu (Échap et Retour arrière
		-- n'y font rien : Échap ouvre aussi le menu de Roblox). Une fenêtre ouverte par-dessus (passe, boutique…)
		-- se ferme d'abord : elle écoute ces touches à une priorité plus haute (Kit.overlay).
		ContextActionService:BindActionAtPriority("MainMenuBack", function(_, st, input)
			if K.overlayOpen() then return Enum.ContextActionResult.Pass end
			if ctx.tab ~= "home" then
				if st == Enum.UserInputState.Begin then ctx.go("home") end
				return Enum.ContextActionResult.Sink
			end
			if input.KeyCode ~= Enum.KeyCode.ButtonB then return Enum.ContextActionResult.Pass end
			if st == Enum.UserInputState.Begin then ctx.close() end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.ButtonB, Enum.KeyCode.Escape, Enum.KeyCode.Backspace)
		ContextActionService:BindActionAtPriority("MainMenuTabs", function(_, st, input)
			if st == Enum.UserInputState.Begin then tabStep(if input.KeyCode == Enum.KeyCode.ButtonR1 then 1 else -1) end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.ButtonL1, Enum.KeyCode.ButtonR1)
	else
		ContextActionService:UnbindAction("MainMenuBack")
		ContextActionService:UnbindAction("MainMenuTabs")
	end
end

-- interface de partie (vie, munitions, minicarte…) et chat cachés derrière le menu, comme sur le web
local HUD_GUIS = { "MatchHud", "ModeHud", "ZombieBrHud", "GrenadeHud", "MedalHud", "PerkDrink", "PickupToast", "Scope" }
local hiddenHud: { ScreenGui } = {}
local function hideHud(on: boolean)
	if on then
		for _, n in ipairs(HUD_GUIS) do
			local g = playerGui:FindFirstChild(n)
			if g and g:IsA("ScreenGui") and g.Enabled then g.Enabled = false; table.insert(hiddenHud, g) end
		end
	else
		for _, g in ipairs(hiddenHud) do if g.Parent then g.Enabled = true end end
		table.clear(hiddenHud)
	end
	pcall(function()
		local TextChatService = game:GetService("TextChatService")
		local win = TextChatService:FindFirstChildOfClass("ChatWindowConfiguration")
		local bar = TextChatService:FindFirstChildOfClass("ChatInputBarConfiguration")
		if win then win.Enabled = not on end
		if bar then bar.Enabled = not on end
	end)
end
-- textes 3D du lobby (classements, « Duel 1v1 0/2 », remise à zéro…) : SurfaceGui et BillboardGui coupés tant que le menu
-- est ouvert, sinon ils se lisent à travers le voile et brouillent les cartes du menu ; rallumés à la fermeture
local hidden3d: { LayerCollector } = {}
local function hide3d(on: boolean)
	if on then
		for _, d in ipairs(workspace:GetDescendants()) do
			-- seulement ceux qui portent du texte (pas les étoiles du ciel de MapAmbience)
			if (d:IsA("SurfaceGui") or d:IsA("BillboardGui")) and d.Enabled and d:FindFirstChildWhichIsA("TextLabel", true) then
				d.Enabled = false; table.insert(hidden3d, d)
			end
		end
	else
		for _, g in ipairs(hidden3d) do if g.Parent then g.Enabled = true end end
		table.clear(hidden3d)
	end
end
local function setOpen(on: boolean)
	if on and zone() == "duel" then return end
	if on == open then return end
	open = on
	S.menuOpen = on
	hideHud(on)
	if not on or zone() == "lobby" then hide3d(on) end
	gui.Enabled = on; bgGui.Enabled = on; modal.Visible = on
	openBtn.Visible = not on and zone() == "lobby"
	player:SetAttribute("UiOpen", on)
	player:SetAttribute("MenuOpen", on)   -- les boutons des autres interfaces se cachent pendant ce temps
	if controls then pcall(function() if on then controls:Disable() else controls:Enable() end end) end
	bindOpenActions(on)
	if on then
		computeScale()
		-- ouverture : le menu arrive en zoomant légèrement (sbIn du web), la page et ses cartes en fondu et en cascade
		local s = uiScale.Scale
		uiScale.Scale = s * 0.965
		K.tween(uiScale, 0.32, { Scale = s }, Enum.EasingStyle.Quint)
		renderWith(1)
		task.spawn(function() ctx.refresh(true) end)
		if UserInputService.GamepadEnabled and navButtons[ctx.tab] then GuiService.SelectedObject = navButtons[ctx.tab] end
	else
		if ctx.tab == "home" then ctx.newsSeen = true end
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then GuiService.SelectedObject = nil end
	end
end
function ctx.open(tab: string?, sub: string?)
	if tab then ctx.tab = tab; if sub then ctx.sub[tab] = sub end end
	setOpen(true)
end
function ctx.close() setOpen(false) end
function ctx.isOpen(): boolean return open end

-- une autre interface referme son panneau et libère « UiOpen » : le menu, lui, est toujours ouvert
player:GetAttributeChangedSignal("UiOpen"):Connect(function()
	if open and player:GetAttribute("UiOpen") ~= true then player:SetAttribute("UiOpen", true) end
end)

openBtn.Activated:Connect(function() setOpen(true) end)
-- P / croix bas : au lobby le menu ; en partie la pause (PauseMenu, qui s'inscrit dans S.panels), d'où l'on rejoint le menu
ContextActionService:BindAction("MainMenu", function(_, st)
	if st == Enum.UserInputState.Begin then
		local pause = S.panels.pause
		if not open and ctx.inMatch() and pause then pause() else setOpen(not open) end
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.KeyCode.P, Enum.KeyCode.DPadDown)
-- la pause ouvre le menu principal (bouton MENU PRINCIPAL) ; « settings » l'ouvre sur les Réglages
S.panels.menu = function() setOpen(true) end
S.panels.settings = function() ctx.open("settings", "Général") end
-- les autres fenêtres (passe, calendrier, boutique) demandent de rafraîchir le menu après une récupération
S.panels.menuRefresh = function() task.spawn(ctx.refresh) end

-- arrivée au lobby et retour d'une partie : le menu s'ouvre ; une partie commence : il se ferme
local lastZone = zone()
local function onZone()
	local z = zone()
	if z == "match" or z == "duel" then
		setOpen(false)
	elseif z == "lobby" and lastZone ~= "lobby" then
		task.delay(if lastZone == "" then 1.5 else 2.5, function()
			if zone() == "lobby" then ctx.tab = "home"; setOpen(true) end
		end)
	end
	openBtn.Visible = not open and z == "lobby"
	lastZone = z
	if open then render() end
end
player:GetAttributeChangedSignal("Zone"):Connect(onZone)
if zone() == "lobby" then lastZone = ""; onZone() end

-- écran redimensionné / téléphone tourné
local resizeN = 0
local function watchCamera(cam: Camera?)
	if not cam then return end
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		resizeN += 1
		local my = resizeN
		task.delay(0.25, function() if my == resizeN and open then computeScale(); render() end end)
	end)
end
watchCamera(workspace.CurrentCamera)
local function hookAccess(c: Instance)
	if c.Name == "AccessScale" and c:IsA("UIScale") then
		c:GetPropertyChangedSignal("Scale"):Connect(computeScale); computeScale()
	end
end
gui.ChildAdded:Connect(hookAccess)
for _, c in ipairs(gui:GetChildren()) do hookAccess(c) end
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() watchCamera(workspace.CurrentCamera) end)

-- achat Robux terminé, cadeau débloqué : les chiffres du profil changent
game:GetService("MarketplaceService").PromptProductPurchaseFinished:Connect(function(userId: number, _id: number, ok: boolean)
	if userId == player.UserId and ok then task.wait(1); ctx.refresh() end
end)
player:GetAttributeChangedSignal("LoyaltyGiftReady"):Connect(function() task.spawn(ctx.refresh) end)
player:GetAttributeChangedSignal("Title"):Connect(function() if headerRefs.update then headerRefs.update() end end)

-- premier chargement du profil (réglages gardés, pastilles) même si le menu est fermé
task.spawn(function()
	for _ = 1, 20 do
		ctx.refresh(false)
		if ctx.data then break end
		task.wait(1.5)
	end
end)
computeScale()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="812">
        <Properties>
          <string name="Name">MapDetailController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/MapDetailController
-- Habille côté client la carte où se trouve le joueur (dossier de Workspace avec l'attribut MapId), comme sur le web,
-- avec ReplicatedStorage/Shared/MapDress (textures, matériaux, maillages, halos) et MapExtras (terrain, flaques, saleté,
-- gravats, câbles, lampes, feu, brume) ; les autres cartes en cours ne sont pas habillées
-- (mémoire et fluidité). Ambiance de la carte où se trouve le joueur (ReplicatedStorage/Shared/MapAmbience) : ciel
-- dégradé, nuages, brouillard, lumière, post-traitement, particules (thèmes du web) ; au lobby, l'éclairage d'origine est remis.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapScene = require(ReplicatedStorage.Shared.MapScene)
local MapDress = require(ReplicatedStorage.Shared.MapDress)
local MapAmbience = require(ReplicatedStorage.Shared.MapAmbience)
local MapExtras = require(ReplicatedStorage.Shared.MapExtras)

local player = Players.LocalPlayer
local U = Config.STUDS_PER_METER

type Build = MapDress.Build
local builds: { [Instance]: Build } = {}

-- ---------- une carte ----------
local function cleanup(f: Instance)
	local b = builds[f]
	if not b then return end
	b.alive = false
	builds[f] = nil
	pcall(MapExtras.clear, b)                            -- terrain et eau remis comme avant
	if b.details then b.details:Destroy() end
	for _, em in ipairs(b.meshes) do pcall(function() em:Destroy() end) end
	for _, im in ipairs(b.images) do pcall(function() im:Destroy() end) end
end

local queue: { Build } = {}
local busy = false

local function process(b: Build)
	local info = MapScene.info(b.id)
	if not info then return end
	-- attend d'avoir reçu tout le décor du serveur
	local want = b.folder:GetAttribute("NVis")
	local t0 = os.clock()
	while b.alive and typeof(want) == "number" and os.clock() - t0 < 15 do
		local vis = b.folder:FindFirstChild("Visuals")
		if vis and #vis:GetChildren() >= want then break end
		task.wait(0.25)
	end
	if not b.alive then return end
	local details = Instance.new("Folder"); details.Name = "Details"; details.Parent = b.folder
	b.details = details
	local steps: { { any } } = { { "textures", MapDress.dressPrims }, { "halos", MapDress.buildGlows }, { "détails", MapExtras.build },
		{ "maillages", MapDress.buildMeshes } }
	for _, step in ipairs(steps) do
		local ok, err = pcall(step[2] :: any, b, info)
		if not ok then warn("[MapDetail] " .. step[1] .. " : " .. tostring(err)) end
	end
end

local function pump()
	if busy then return end
	busy = true
	task.spawn(function()
		while #queue > 0 do
			local b = table.remove(queue, 1) :: Build
			if b.alive then process(b) end
		end
		busy = false
	end)
end

local function watch(f: Instance)
	if builds[f] or not f:IsA("Folder") then return end
	local id = f:GetAttribute("MapId")
	if typeof(id) ~= "string" or not MapScene.has(id) then return end
	local origin = f:GetAttribute("Origin")
	local b: Build = { folder = f, id = id, origin = if typeof(origin) == "Vector3" then origin else Vector3.zero, alive = true, meshes = {}, images = {} }
	builds[f] = b
	f.AncestryChanged:Connect(function() if not f:IsDescendantOf(workspace) then cleanup(f) end end)
	table.insert(queue, b)
	pump()
end

workspace.ChildRemoved:Connect(function(c: Instance) cleanup(c) end)


-- ---------- ambiance : ciel, nuages, brouillard, lumière, post-traitement et particules de la carte où l'on est ----------
local current: string? = nil

-- carte du joueur : attribut MatchMap du personnage (nom du dossier), sinon la carte sous la caméra, sinon le lobby
local function myMap(): Instance?
	local char = player.Character
	local name = player:GetAttribute("MatchMap") or (char and char:GetAttribute("MatchMap"))
	if typeof(name) == "string" and name ~= "" then
		local f = workspace:FindFirstChild(name)
		if f and f:GetAttribute("MapId") then return f end
	end
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local pos = cam.CFrame.Position
	local best: Instance?, bd = nil, math.huge
	for _, f in ipairs(workspace:GetChildren()) do
		local id = f:GetAttribute("MapId")
		if f:IsA("Folder") and typeof(id) == "string" then
			local o = f:GetAttribute("Origin")
			local size = f:GetAttribute("MapSize")
			local org = if typeof(o) == "Vector3" then o else Vector3.zero
			local sz = if typeof(size) == "number" then size else 40 * 2 * U
			local c = org + Vector3.new(sz / 2, 0, sz / 2)
			local d = Vector2.new(pos.X - c.X, pos.Z - c.Z).Magnitude
			if d < sz * 0.75 and d < bd then best, bd = f, d end
		end
	end
	return best
end

task.spawn(function()
	local away = 0
	while true do
		local f = myMap()
		-- seule la carte du joueur est habillée ; les autres sont libérées (après 20 s au lobby pour la dernière)
		if f then
			away = 0
			local cur = builds[f]
			if cur and cur.id ~= f:GetAttribute("MapId") then cleanup(f) end
			watch(f)
			for g in pairs(builds) do if g ~= f then cleanup(g) end end
		else
			away += 0.5
			if away >= 20 then for g in pairs(builds) do cleanup(g) end end
		end
		local key = if f then (f.Name .. "@" .. tostring(f:GetAttribute("MapId"))) else nil
		if key ~= current then
			current = key
			if f then MapAmbience.apply(f) else MapAmbience.restore() end
		end
		task.wait(0.5)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="813">
        <Properties>
          <string name="Name">MapVoteController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/MapVoteController (LocalScript)
-- Vote de la carte suivante sur l'écran de fin (MapVote côté serveur) : trois cartes cliquables (ou touches 1, 2, 3),
-- le nombre de votes en direct, puis la carte retenue. La souris est déjà libre sur l'écran de fin (bouton Modal du HUD).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")

local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local push = ReplicatedStorage:WaitForChild("MapVote") :: RemoteEvent
local cast = ReplicatedStorage:WaitForChild("MapVoteCast") :: RemoteEvent

local GOLD, TEXT, DIM, LINE = Color3.fromRGB(255, 215, 94), Color3.fromRGB(232, 238, 249), Color3.fromRGB(141, 160, 189), Color3.fromRGB(42, 55, 80)
local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)
local HEAVY = Font.new("rbxasset://fonts/families/RobotoCondensed.json", Enum.FontWeight.Bold)
-- couleur de chaque thème de carte (ciels du web, src/41_gfx_themes.js) pour le bandeau des cartes
local THEME = {
	sand = Color3.fromRGB(214, 160, 92), industrial = Color3.fromRGB(120, 132, 150), snow = Color3.fromRGB(170, 205, 235),
	night = Color3.fromRGB(70, 96, 170), metro = Color3.fromRGB(150, 120, 90), jungle = Color3.fromRGB(80, 160, 90),
	haunt = Color3.fromRGB(120, 90, 160), halloween = Color3.fromRGB(240, 120, 40),
}

-- DisplayOrder 14 : au-dessus du bilan de la partie (RewardScreen, 13) qui le cachait en partie, sous le menu (19)
local gui = Instance.new("ScreenGui"); gui.Name = "MapVote"; gui.ResetOnSpawn = false; gui.DisplayOrder = 14
gui.IgnoreGuiInset = true; gui.Enabled = false; gui.Parent = player:WaitForChild("PlayerGui")
local root = Instance.new("Frame")
root.AnchorPoint = Vector2.new(0.5, 1); root.Position = UDim2.new(0.5, 0, 1, -128); root.Size = UDim2.fromOffset(660, 96)
root.BackgroundTransparency = 1; root.Parent = gui
-- petits écrans : même réduction que l'écran de fin de HudController (bouton « Quitter » et compte à rebours dessous)
local rootScale = Instance.new("UIScale"); rootScale.Parent = root
local function fit(): number
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	local k = math.clamp(math.min(vp.X / 1400, vp.Y / 800), 0.5, 1)
	rootScale.Scale = k
	return k
end
local head = Instance.new("TextLabel")
head.BackgroundTransparency = 1; head.Size = UDim2.new(1, 0, 0, 18); head.FontFace = FONT; head.TextSize = 13; head.TextColor3 = DIM
head.Text = "VOTE POUR LA PROCHAINE CARTE  ·  1  2  3"; head.Parent = root
local row = Instance.new("Frame"); row.Position = UDim2.fromOffset(0, 22); row.Size = UDim2.new(1, 0, 0, 72); row.BackgroundTransparency = 1; row.Parent = root
local lay = Instance.new("UIListLayout"); lay.FillDirection = Enum.FillDirection.Horizontal; lay.HorizontalAlignment = Enum.HorizontalAlignment.Center
lay.Padding = UDim.new(0, 12); lay.Parent = row

type Card = { b: TextButton, stroke: UIStroke, count: TextLabel, scale: UIScale }
local cards: { Card } = {}
local mine: number? = nil
local doneT = 0

local function vote(i: number)
	if not gui.Enabled or not cards[i] or mine == i then return end
	mine = i
	cast:FireServer(i)
	pcall(function() Sfx.play("ui", nil, 0.7) end)
	local c = cards[i]
	c.scale.Scale = 1.08
	TweenService:Create(c.scale, TweenInfo.new(0.25, Enum.EasingStyle.Back), { Scale = 1 }):Play()
end

local function build(options: { any })
	for _, c in ipairs(cards) do c.b:Destroy() end
	table.clear(cards)
	for i, o in ipairs(options) do
		local b = Instance.new("TextButton")
		b.Size = UDim2.fromOffset(204, 72); b.BackgroundColor3 = Color3.fromRGB(22, 30, 46); b.BackgroundTransparency = 0.1
		b.AutoButtonColor = false; b.Text = ""; b.LayoutOrder = i; b.Parent = row
		local cr = Instance.new("UICorner"); cr.CornerRadius = UDim.new(0, 4); cr.Parent = b
		local st = Instance.new("UIStroke"); st.Color = LINE; st.Thickness = 1.5; st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; st.Parent = b
		local sc = Instance.new("UIScale"); sc.Parent = b
		local band = Instance.new("Frame")
		band.Size = UDim2.new(0, 4, 1, 0); band.BackgroundColor3 = THEME[o.theme] or GOLD; band.BorderSizePixel = 0; band.Parent = b
		local name = Instance.new("TextLabel")
		name.BackgroundTransparency = 1; name.Position = UDim2.fromOffset(16, 10); name.Size = UDim2.new(1, -60, 0, 28)
		name.FontFace = HEAVY; name.TextSize = 24; name.TextColor3 = TEXT; name.TextXAlignment = Enum.TextXAlignment.Left
		name.Text = string.upper(o.n); name.TextTruncate = Enum.TextTruncate.AtEnd; name.Parent = b
		local sub = name:Clone(); sub.Position = UDim2.fromOffset(16, 40); sub.Size = UDim2.new(1, -60, 0, 18)
		sub.FontFace = FONT; sub.TextSize = 12; sub.TextColor3 = DIM; sub.Text = if i == 1 then "Carte actuelle" else "Touche " .. i; sub.Parent = b
		local count = name:Clone(); count.AnchorPoint = Vector2.new(1, 0.5); count.Position = UDim2.new(1, -14, 0.5, 0); count.Size = UDim2.fromOffset(40, 40)
		count.TextXAlignment = Enum.TextXAlignment.Right; count.TextSize = 30; count.TextColor3 = GOLD; count.Text = "0"; count.Parent = b
		b.MouseEnter:Connect(function() if mine ~= i then st.Color = DIM end end)
		b.MouseLeave:Connect(function() if mine ~= i then st.Color = LINE end end)
		b.Activated:Connect(function() vote(i) end)
		table.insert(cards, { b = b, stroke = st, count = count, scale = sc })
	end
end

local function paint(votes: { number })
	for i, c in ipairs(cards) do
		c.count.Text = tostring(votes[i] or 0)
		c.stroke.Color = if mine == i then GOLD else LINE
		c.stroke.Thickness = if mine == i then 2.5 else 1.5
	end
end

push.OnClientEvent:Connect(function(d: any)
	if typeof(d) ~= "table" then return end
	if d.done then
		head.Text = "PROCHAINE CARTE : " .. string.upper(tostring(d.n or d.done))
		head.TextColor3 = GOLD
		for _, c in ipairs(cards) do c.b.Active = false end
		doneT += 1
		local my = doneT
		task.delay(2.5, function() if my == doneT then gui.Enabled = false end end)
		return
	end
	if typeof(d.options) ~= "table" then return end
	local fresh = not gui.Enabled or #cards ~= #d.options
	if fresh then
		mine = d.mine
		build(d.options)
		head.Text = "VOTE POUR LA PROCHAINE CARTE  ·  1  2  3"; head.TextColor3 = DIM
		gui.Enabled = true; doneT += 1
		local k = fit()
		root.Position = UDim2.new(0.5, 0, 1, -96 * k)
		TweenService:Create(root, TweenInfo.new(0.35, Enum.EasingStyle.Quad), { Position = UDim2.new(0.5, 0, 1, -128 * k) }):Play()
	end
	if d.mine then mine = d.mine end
	paint(d.votes or {})
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or not gui.Enabled then return end
	if input.KeyCode == Enum.KeyCode.One then vote(1)
	elseif input.KeyCode == Enum.KeyCode.Two then vote(2)
	elseif input.KeyCode == Enum.KeyCode.Three then vote(3) end
end)
player:GetAttributeChangedSignal("MatchId"):Connect(function()
	if typeof(player:GetAttribute("MatchId")) ~= "number" then gui.Enabled = false end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="814">
        <Properties>
          <string name="Name">MedalController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/MedalController (LocalScript)
-- • Médailles en partie (src/8G_medals.js #medalPop) : icône, nom, « +XP », l'une après l'autre au-dessus du centre.
-- • Écran de fin : rangée des médailles du match et bilan perso (précision, têtes, dégâts, meilleure série,
--   src/8Zf_confort.js #oPerso), sous les cartes de l'écran de fin de HudController.
-- • Petits messages : défi du jour / de la semaine terminé (ChallengeDone), citrouilles ramassées (PumpkinToast).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Medals = require(ReplicatedStorage.Shared.Medals)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)

local player = Players.LocalPlayer
local GOLD = Color3.fromRGB(255, 210, 58)
local PANEL = Color3.fromRGB(15, 23, 38)
local DIM = Color3.fromRGB(141, 160, 189)

local gui = Instance.new("ScreenGui"); gui.Name = "MedalHud"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.DisplayOrder = 12
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling; gui.Parent = player:WaitForChild("PlayerGui")

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function tween(o: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?)
	TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end
local function spaced(s: string): string
	local out = {}
	for _, cp in utf8.codes(s) do table.insert(out, utf8.char(cp)) end
	return table.concat(out, "\u{200A}")   -- espace fine
end

-- ---------- médaille en partie ----------
-- web : top 21 % ; ici sous les lignes du mode (ModeHud, jusqu'à ~252 px) comme la bannière du HUD
local pop = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 262), Size = UDim2.fromOffset(320, 110), BackgroundTransparency = 1 }, gui)
local popScale = make("UIScale", { Scale = 0.6 }, pop)
local popIcon = make("TextLabel", { Size = UDim2.new(1, 0, 0, 56), BackgroundTransparency = 1, TextSize = 46, Font = Enum.Font.GothamBold, Text = "", TextTransparency = 1, TextColor3 = Color3.new(1, 1, 1) }, pop)
local popName = make("TextLabel", { Position = UDim2.fromOffset(0, 58), Size = UDim2.new(1, 0, 0, 22), BackgroundTransparency = 1, TextSize = 17, Font = Enum.Font.GothamBlack,
	TextColor3 = GOLD, Text = "", TextTransparency = 1, TextStrokeTransparency = 1 }, pop)
local popXp = make("TextLabel", { Position = UDim2.fromOffset(0, 82), Size = UDim2.new(1, 0, 0, 16), BackgroundTransparency = 1, TextSize = 13, Font = Enum.Font.GothamBold,
	TextColor3 = Color3.new(1, 1, 1), Text = "", TextTransparency = 1 }, pop)
local queue: { string } = {}
local showing = false
local function showNext()
	if showing or #queue == 0 then return end
	-- même emplacement que la grande bannière du HUD (séries, annonces) : on attend qu'elle soit partie,
	-- jamais deux titres l'un sur l'autre
	local hud = (gui.Parent :: Instance):FindFirstChild("MatchHud")
	local busy = hud and hud:GetAttribute("BanUntil")
	if typeof(busy) == "number" and busy > os.clock() then
		showing = true
		task.delay(busy - os.clock(), function() showing = false; showNext() end)
		return
	end
	pop.Position = UDim2.new(0.5, 0, 0, math.max(workspace.CurrentCamera.ViewportSize.Y * 0.2, 262))
	showing = true
	local id = table.remove(queue, 1) :: string
	local m = Medals.LIST[id]
	popIcon.Text = m.ic; popName.Text = spaced(string.upper(m.n)); popXp.Text = "+" .. m.xp .. " XP"
	popScale.Scale = 0.6
	tween(popScale, 0.25, { Scale = 1 }, Enum.EasingStyle.Back)
	for _, l in ipairs({ popIcon, popName, popXp }) do tween(l, 0.2, { TextTransparency = if l == popXp then 0.2 else 0 }) end
	tween(popName, 0.2, { TextStrokeTransparency = 0.4 })
	pcall(function() Sfx.play(ModeConfig.SOUNDS.streak) end)
	task.delay(1.15, function()
		for _, l in ipairs({ popIcon, popName, popXp }) do tween(l, 0.2, { TextTransparency = 1 }) end
		tween(popName, 0.2, { TextStrokeTransparency = 1 })
		task.delay(0.2, function() showing = false; showNext() end)
	end)
end
local popRemote = ReplicatedStorage:WaitForChild("MedalPop", 30) :: RemoteEvent?
if popRemote then
	popRemote.OnClientEvent:Connect(function(id: any)
		if typeof(id) == "string" and Medals.LIST[id] then table.insert(queue, id); showNext() end
	end)
end

-- ---------- écran de fin : médailles + bilan perso ----------
local endBox = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0.42, 162), Size = UDim2.fromOffset(780, 120), BackgroundTransparency = 1, Visible = false }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Vertical, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10), SortOrder = Enum.SortOrder.LayoutOrder }, endBox)
local function row(order: number): Frame
	local r = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order }, endBox)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 8), Wraps = true }, r)
	return r
end
local medalRow, persoRow = row(1), row(2)
local endToken = 0
local function clearRows()
	for _, r in ipairs({ medalRow, persoRow }) do for _, c in ipairs(r:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end end
end
local endRemote = ReplicatedStorage:WaitForChild("MatchEnd", 30) :: RemoteEvent?
if endRemote then
	endRemote.OnClientEvent:Connect(function(r: any)
		clearRows()
		endToken += 1
		local my = endToken
		local any = false
		for _, md in ipairs(if typeof(r.medals) == "table" then r.medals else {}) do
			any = true
			local chip = make("TextLabel", { AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 28), BackgroundColor3 = PANEL, BackgroundTransparency = 0.05,
				Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.new(1, 1, 1), RichText = true,
				Text = "  " .. md.ic .. " " .. md.n .. (if md.count > 1 then ' <font color="#ffd23a">×' .. md.count .. "</font>" else "") .. "  " }, medalRow)
			make("UICorner", { CornerRadius = UDim.new(0, 8) }, chip)
			make("UIStroke", { Color = GOLD, Transparency = 0.7, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, chip)
		end
		local b = r.bilan
		if typeof(b) == "table" then
			any = true
			local tiles = { { "PRÉCISION", if b.acc then b.acc .. " %" else "—" }, { "TÊTES", if b.hsPct then b.hsPct .. " %" else "—" },
				{ "DÉGÂTS", tostring(b.dmg or 0) }, { "MEILLEURE SÉRIE", tostring(b.streak or 0) } }
			for _, t in ipairs(tiles) do
				local f = make("Frame", { Size = UDim2.fromOffset(120, 50), BackgroundColor3 = PANEL, BackgroundTransparency = 0.05 }, persoRow)
				make("UICorner", { CornerRadius = UDim.new(0, 8) }, f)
				make("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.92, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
				make("TextLabel", { Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 12), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 10,
					TextColor3 = DIM, Text = spaced(t[1]) }, f)
				make("TextLabel", { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 19,
					TextColor3 = Color3.new(1, 1, 1), Text = t[2] }, f)
			end
		end
		endBox.Visible = any
		task.delay((tonumber(r.next) or 15) + 0.5, function() if my == endToken then endBox.Visible = false end end)
	end)
end
-- l'écran de fin se ferme quand on quitte la partie ou qu'une nouvelle commence
player:GetAttributeChangedSignal("Zone"):Connect(function() if player:GetAttribute("Zone") ~= "match" then endBox.Visible = false end end)
local stateRemote = ReplicatedStorage:WaitForChild("TDMState", 30) :: RemoteEvent?
if stateRemote then
	stateRemote.OnClientEvent:Connect(function(st: any)
		if typeof(st) == "table" and st.warmup then endBox.Visible = false end
	end)
end

-- ---------- petits messages (défis, citrouilles) ----------
local toasts = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 120), Size = UDim2.fromOffset(340, 300), BackgroundTransparency = 1 }, gui)
make("UIListLayout", { Padding = UDim.new(0, 6), HorizontalAlignment = Enum.HorizontalAlignment.Right }, toasts)
local function toast(text: string, color: Color3)
	local l = make("TextLabel", { AutomaticSize = Enum.AutomaticSize.Y, Size = UDim2.fromOffset(340, 0), BackgroundColor3 = PANEL, BackgroundTransparency = 0.1,
		Font = Enum.Font.GothamBold, TextSize = 14, TextWrapped = true, TextColor3 = Color3.new(1, 1, 1), Text = text, TextXAlignment = Enum.TextXAlignment.Left }, toasts)
	make("UIPadding", { PaddingLeft = UDim.new(0, 10), PaddingRight = UDim.new(0, 10), PaddingTop = UDim.new(0, 7), PaddingBottom = UDim.new(0, 7) }, l)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, l)
	make("UIStroke", { Color = color, Transparency = 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, l)
	task.delay(4, function()
		tween(l, 0.4, { BackgroundTransparency = 1, TextTransparency = 1 })
		task.delay(0.45, function() l:Destroy() end)
	end)
end
local doneRemote = ReplicatedStorage:WaitForChild("ChallengeDone", 30) :: RemoteEvent?
if doneRemote then
	doneRemote.OnClientEvent:Connect(function(d: any)
		if typeof(d) ~= "table" then return end
		toast((if d.weekly then "Défi de la semaine terminé : " else "Défi du jour terminé : ") .. tostring(d.text) .. "  (💰 " .. tostring(d.coins) .. " • " .. tostring(d.xp) .. " XP à récupérer)",
			if d.weekly then Color3.fromRGB(199, 125, 255) else GOLD)
		pcall(function() Sfx.play(ModeConfig.SOUNDS.streak) end)
	end)
end
local pkRemote = ReplicatedStorage:WaitForChild("PumpkinToast", 30) :: RemoteEvent?
if pkRemote then
	pkRemote.OnClientEvent:Connect(function(d: any)
		if typeof(d) ~= "table" then return end
		toast("🎃 Citrouille ramassée : " .. tostring(d.count), Color3.fromRGB(255, 138, 42))
		for _, line in ipairs(if typeof(d.lines) == "table" then d.lines else {}) do toast(tostring(line), Color3.fromRGB(255, 138, 42)) end
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="815">
        <Properties>
          <string name="Name">Menu</string>
        </Properties>
        <Item class="ModuleScript" referent="816">
          <Properties>
            <string name="Name">Arsenal</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Arsenal (ModuleScript) — rubrique « Arsenal » (src/85_menu.js, src/86_meta_ui.js)
-- Armes / Viseurs : panneaux de ReplicatedStorage/Shared/ArsenalPanels s'ils existent, sinon une version simple ici
-- (liste des armes, aperçu 3D, statistiques, skins ; viseurs et réticules). Tenues et effets (id « Casier ») : tenues,
-- danses, sprays, effets d'élimination et traînées de balles (avant dans Profil › Style), avec un aperçu du personnage.
-- Caisses : les deux caisses, probabilités affichées, ouverture animée (LootService).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local KillFxConfig = require(ReplicatedStorage.Shared.KillFxConfig)
local K = require(script.Parent.Kit)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

-- nom et symbole des sprays (SprayService.LOOK)
local SPRAY_LOOK: { [string]: { string } } = {
	smile = { "Sourire", "☺" }, heart = { "Cœur", "♥" }, skull = { "Crâne", "☠" }, bolt = { "Éclair", "⚡" },
	flame = { "Flamme", "🔥" }, crown = { "Couronne", "♛" }, target = { "Cible", "◎" }, ghost = { "Fantôme", "👻" },
}
local CAT = { { "melee", "COUTEAU" }, { "pistol", "PISTOLETS" }, { "smg", "SMG" }, { "shotgun", "POMPES" }, { "rifle", "FUSILS" }, { "sniper", "PRÉCISION" }, { "lmg", "MITRAILLEUSES" } }

-- panneaux de l'autre module (Armurier, viseurs), s'il est présent
local function panels(): any
	local shared = ReplicatedStorage:FindFirstChild("Shared")
	local m = shared and shared:FindFirstChild("ArsenalPanels")
	if not m or not m:IsA("ModuleScript") then return nil end
	local ok, res = pcall(require, m)
	return if ok then res else nil
end

-- aperçu 3D qui tourne (ViewportFrame) ; build = fabrique le modèle
local function preview(parent: Instance, props: { [string]: any }, build: () -> Model?, fov: number?, side: boolean?): ViewportFrame
	local vf = make("ViewportFrame", { BackgroundTransparency = 0, BackgroundColor3 = K.rgb(0x101a2e), Ambient = Color3.fromRGB(150, 158, 178),
		LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(0.4, -1, 0.3) }, parent)
	for k, v in pairs(props) do (vf :: any)[k] = v end
	K.gradient(vf, K.rgb(0x22355a), K.rgb(0x0b1220), 90)
	K.corner(vf, 4); K.stroke(vf, C.white, 1, 0.9)
	task.spawn(function()
		local ok, m = pcall(build)
		if not ok or not m then
			text(vf, { Text = "Aperçu indisponible", Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, TextColor3 = C.dim })
			return
		end
		if not vf.Parent then m:Destroy(); return end
		local world = make("WorldModel", {}, vf)
		m.Parent = world
		local cf, ext = m:GetBoundingBox()
		local cam = Instance.new("Camera"); cam.FieldOfView = fov or 30
		cam.Parent = vf; vf.CurrentCamera = cam
		local radius = ext.Magnitude / 2
		local dist = radius / math.tan(math.rad((fov or 30) / 2)) * 1.05
		local center = cf.Position
		local a = 0
		local conn: RBXScriptConnection
		conn = RunService.RenderStepped:Connect(function(dt: number)
			if not vf.Parent then conn:Disconnect(); return end
			a += dt * 0.6
			local dir = if side then Vector3.new(-math.cos(a * 0.5) , 0.12, math.sin(a * 0.5) * 0.6) else Vector3.new(math.sin(a), 0.15, math.cos(a))
			cam.CFrame = CFrame.lookAt(center + dir.Unit * dist, center)
			vf.LightDirection = cam.CFrame:VectorToWorldSpace(Vector3.new(0.35, -0.6, -1))   -- lumière qui suit la caméra : camo toujours éclairé
		end)
	end)
	return vf
end

local function weaponModel(key: string, skin: number?, camo: string?): () -> Model?
	return function()
		local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
		local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
		local m = WeaponModels.build(key, 1)
		pcall(SkinPaint.apply, m, skin, camo)
		return m
	end
end
-- copie du personnage du joueur (tenue portée), sinon un soldat en blocs
local function characterModel(player: Player): () -> Model?
	return function()
		local ch = player.Character
		if ch then
			local was = ch.Archivable
			ch.Archivable = true
			local ok, copy = pcall(function() return ch:Clone() end)
			ch.Archivable = was
			if ok and copy then
				for _, d in ipairs(copy:GetDescendants()) do
					if d:IsA("Script") or d:IsA("LocalScript") or d:IsA("Sound") or d:IsA("Tool") then d:Destroy()
					elseif d:IsA("BasePart") then d.Anchored = true end
				end
				local hum = copy:FindFirstChildOfClass("Humanoid")
				if hum then hum.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None end
				copy:PivotTo(CFrame.new())
				return copy
			end
		end
		local m = Instance.new("Model")
		local function part(size: Vector3, pos: Vector3, col: Color3)
			local p = Instance.new("Part"); p.Size = size; p.Position = pos; p.Color = col; p.Anchored = true; p.Material = Enum.Material.SmoothPlastic; p.Parent = m
		end
		local navy = K.rgb(0x3a4a6a)
		part(Vector3.new(2, 2, 1), Vector3.new(0, 3, 0), navy); part(Vector3.new(1.2, 1.2, 1.2), Vector3.new(0, 4.6, 0), K.rgb(0xe0b48a))
		part(Vector3.new(1, 2, 1), Vector3.new(-1.5, 3, 0), navy); part(Vector3.new(1, 2, 1), Vector3.new(1.5, 3, 0), navy)
		part(Vector3.new(1, 2, 1), Vector3.new(-0.5, 1, 0), K.rgb(0x2a3448)); part(Vector3.new(1, 2, 1), Vector3.new(0.5, 1, 0), K.rgb(0x2a3448))
		return m
	end
end

-- carte d'objet (Casier) : bord gauche de la couleur de rareté, nom, rareté, ÉQUIPÉE / cadenas
local function itemCard(parent: Instance, order: number, name: string, rarity: number, owned: boolean, equipped: boolean, cb: () -> ())
	local col = K.rarityColor(rarity)
	local b = make("TextButton", { Text = "", LayoutOrder = order, BackgroundTransparency = if owned then 0.1 else 0.35, BackgroundColor3 = if equipped then K.rgb(0x1c2740) else C.card,
		Selectable = true }, parent)
	K.stroke(b, if equipped then C.white else C.white, 1, if equipped then 0.4 else 0.93)
	make("Frame", { Size = UDim2.new(0, 3, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = col }, b)
	text(b, { Text = name, Position = UDim2.fromOffset(16, 10), Size = UDim2.new(1, -90, 0, 18), Font = K.BLACK, TextSize = 14, TextWrapped = false,
		TextTruncate = Enum.TextTruncate.AtEnd, TextColor3 = if owned then C.white else C.dim })
	text(b, { Text = spaced(string.upper(Config.RARITY[rarity] and Config.RARITY[rarity].name or ""), 1), Position = UDim2.fromOffset(16, 32), Size = UDim2.new(1, -30, 0, 14),
		TextSize = 10, Font = K.BLACK, TextColor3 = if owned then col:Lerp(C.white, 0.4) else col, TextWrapped = false })
	text(b, { Text = if equipped then spaced("ÉQUIPÉE", 1) elseif owned then "" else "🔒", AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, 10),
		Size = UDim2.fromOffset(80, 14), TextSize = 10, TextColor3 = C.green, TextXAlignment = Enum.TextXAlignment.Right, Font = K.BLACK })
	b.Activated:Connect(cb)
	b.MouseEnter:Connect(function() if not equipped then b.BackgroundColor3 = C.card2 end end)
	b.MouseLeave:Connect(function() if not equipped then b.BackgroundColor3 = C.card end end)
end

-- ======================= Armes (version simple) =======================
local function arms(ctx: any, body: Frame)
	local profile = ctx.data and ctx.data.profile
	local player = ctx.player
	local W = ctx.W - 56
	local sel = ctx.armSel
	if not sel or not Config.WEAPONS[sel] then
		local a = player:GetAttribute("Primary")
		sel = if typeof(a) == "string" and Config.WEAPONS[a] then a else "galil"
		ctx.armSel = sel
	end
	local key: string = sel
	local w = Config.WEAPONS[key]
	local function owned(k: string): boolean
		return Catalog.STARTER_WEAPONS[k] == true or (profile ~= nil and Catalog.ownsWeapon(profile, k))
	end
	-- liste à gauche
	local left = K.scroll(body, { Name = "ArmList", Size = UDim2.new(0, 200, 1, 0) })
	K.vlist(left, 4); K.pad(left, 0, 0, 8, 10)
	local o = 0
	for _, cat in ipairs(CAT) do
		local keys = {}
		for k, ww in pairs(Config.WEAPONS) do if ww.cat == cat[1] then table.insert(keys, k) end end
		table.sort(keys, function(a, b) return Config.WEAPONS[a].price < Config.WEAPONS[b].price end)
		if #keys > 0 then
			o += 1; K.label(left, cat[2], o, C.dim)
			for _, k in ipairs(keys) do
				o += 1
				local on = k == key
				local b = K.btn(left, "  " .. Config.WEAPONS[k].name .. (if owned(k) then "" else '  <font color="#ffd23a">🔒</font>'), if on then "primary" else "alt",
					function() ctx.armSel = k; ctx.render() end, { LayoutOrder = o, Size = UDim2.new(1, 0, 0, 30), TextSize = 13, Font = K.BOLD, TextXAlignment = Enum.TextXAlignment.Left })
				K.corner(b, 2)
			end
		end
	end
	-- skins à droite
	local rw = if W >= 1100 then 240 else 0
	local mid = make("Frame", { Position = UDim2.fromOffset(216, 0), Size = UDim2.new(1, -216 - (if rw > 0 then rw + 16 else 0), 1, 0) }, body)
	local equippedSkin = profile and profile.equippedSkins and profile.equippedSkins[key] or 1
	local camo = profile and profile.equipped and profile.equipped.animCamo and profile.equipped.animCamo[key]
	local midScroll = K.scroll(mid, { Name = "ArmMid" })
	K.vlist(midScroll, 10, Enum.HorizontalAlignment.Center); K.pad(midScroll, 0, 0, 6, 10)
	preview(midScroll, { Size = UDim2.new(1, 0, 0, math.max(220, ctx.H - 470)), LayoutOrder = 1 }, weaponModel(key, equippedSkin, camo), 24, true)
	text(midScroll, { Text = spaced(string.upper(w.name), 2), Font = K.BLACK, TextSize = 26, LayoutOrder = 2, TextXAlignment = Enum.TextXAlignment.Center, Size = UDim2.new(1, 0, 0, 30) })
	-- statistiques (10 tuiles comme le web)
	local stats = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, midScroll)
	K.grid(stats, UDim2.new(0.2, -8, 0, 54), 8)
	local acc = 1 - math.min(1, w.spread / 4)
	local list: { { any } } = {
		{ "DÉGÂTS", tostring(w.dmg * w.pellets), w.dmg * w.pellets / 120 }, { "CADENCE", tostring(w.rpm), w.rpm / 1000 }, { "CHARGEUR", tostring(w.mag), w.mag / 100 },
		{ "PRÉCISION", math.floor(acc * 100) .. "%", acc }, { "TÊTE", "×" .. tostring(w.hs), w.hs / 4 }, { "CONTRÔLE", math.floor((1 - math.min(1, w.recoil / 5)) * 100) .. "%", 1 - math.min(1, w.recoil / 5) },
		{ "PERFORATION", math.floor(w.armorPen * 100) .. "%", w.armorPen }, { "MOBILITÉ", string.format("%.2f", w.speed), (w.speed - 0.7) / 0.4 },
		{ "RECHARGEMENT", if w.reload > 0 then w.reload .. " s" else "—", if w.reload > 0 then 1 - w.reload / 6 else 0 },
		{ "PRIX", if owned(key) then "✔" else K.fmt(Catalog.weaponPrice(key)) .. " 💰", 1 },
	}
	for i, s in ipairs(list) do
		local t = make("Frame", { LayoutOrder = i, BackgroundTransparency = 0.1, BackgroundColor3 = C.panel }, stats)
		text(t, { Text = spaced(s[1], 1), Size = UDim2.new(1, 0, 0, 12), Position = UDim2.fromOffset(0, 8), TextSize = 9, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center })
		text(t, { Text = s[2], Size = UDim2.new(1, 0, 0, 20), Position = UDim2.fromOffset(0, 22), TextSize = 17, Font = K.BLACK, TextXAlignment = Enum.TextXAlignment.Center })
		local bar = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 6, 1, -4), Size = UDim2.new(math.clamp(tonumber(s[3]) or 0, 0.04, 1), -12, 0, 3),
			BackgroundTransparency = 0, BackgroundColor3 = C.accent }, t)
		K.corner(bar, 2)
	end
	-- équiper / acheter
	local act = make("Frame", { Size = UDim2.new(1, 0, 0, 40), LayoutOrder = 4 }, midScroll)
	K.hlist(act, 10).HorizontalAlignment = Enum.HorizontalAlignment.Center
	if w.slot == 0 or w.slot == 1 then
		local cur = player:GetAttribute(if w.slot == 0 then "Primary" else "Secondary")
		if not owned(key) then
			K.btn(act, "🔒  Débloquer · " .. K.fmt(Catalog.weaponPrice(key)) .. " 💰", "gold", function()
				local res = ctx.call("ShopBuy", "weapon_" .. key)
				ctx.toast(if res and res.ok then "✔ " .. w.name .. " débloquée !" else "Achat impossible : " .. tostring(res and res.err or "erreur"), if res and res.ok then C.green else C.accent)
				ctx.refresh()
			end, { Size = UDim2.fromOffset(240, 36), TextSize = 13, LayoutOrder = 1 })
		elseif cur == key then
			K.btn(act, "✔  " .. (if w.slot == 0 then "Arme principale" else "Pistolet") .. " équipée", "dark", nil, { Size = UDim2.fromOffset(260, 36), TextSize = 13, LayoutOrder = 1 })
		else
			K.btn(act, "Équiper comme " .. (if w.slot == 0 then "arme principale" else "pistolet"), "primary", function()
				local ok = ctx.call("SetLoadout", key)
				ctx.toast(if ok then "✔ " .. w.name .. " : tu l'auras à ta prochaine apparition" else "Impossible d'équiper cette arme", if ok then C.green else C.accent)
				ctx.render()
			end, { Size = UDim2.fromOffset(280, 36), TextSize = 13, LayoutOrder = 1 })
		end
	end
	K.btn(act, "🛒  Ouvrir la boutique", "alt", function() ctx.panel("shop") end, { Size = UDim2.fromOffset(190, 36), TextSize = 13, LayoutOrder = 2 })
	-- skins
	local skinParent: Instance = midScroll
	if rw > 0 then
		local r = K.scroll(body, { Name = "ArmSkins", Size = UDim2.new(0, rw, 1, 0), Position = UDim2.new(1, -rw, 0, 0) })
		K.vlist(r, 8); K.pad(r, 0, 0, 6, 10)
		skinParent = r
	end
	K.label(skinParent, "SKIN", 10, C.dim)
	local sg = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 11 }, skinParent)
	K.grid(sg, UDim2.new(0.5, -4, 0, 38), 6)
	if w.melee then
		K.para(skinParent, "Les couteaux se choisissent dans la Boutique.", 11, C.dim, 12)
	else
		for i, sk in ipairs(Config.SKINS) do
			local have = sk.rarity == 1 or (profile ~= nil and profile.inv.skins[key] ~= nil and table.find(profile.inv.skins[key], i) ~= nil)
			local on = equippedSkin == i
			local col = K.rarityColor(sk.rarity)
			local b = make("TextButton", { Text = "", LayoutOrder = i, BackgroundTransparency = if have then 0.1 else 0.4, BackgroundColor3 = C.panel, Selectable = true }, sg)
			K.stroke(b, if on then C.accent else C.white, if on then 2 else 1, if on then 0 else 0.92)
			make("Frame", { Size = UDim2.new(0, 2, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = col }, b)
			local dot = make("Frame", { Size = UDim2.fromOffset(14, 14), Position = UDim2.new(0, 10, 0.5, -7), BackgroundTransparency = 0, BackgroundColor3 = col }, b)
			K.corner(dot, 7)
			text(b, { Text = sk.name .. (if have then "" else " 🔒"), Position = UDim2.fromOffset(30, 0), Size = UDim2.new(1, -34, 1, 0), TextSize = 11, Font = K.MED,
				TextColor3 = if have then C.text else C.dim })
			b.Activated:Connect(function()
				if not have then ctx.toast("Skin à gagner dans les caisses ou à acheter dans la Boutique", C.gold); return end
				local ok = ctx.call("EquipSkin", key, i)
				if ok then ctx.toast("✔ " .. sk.name .. " sur " .. w.name, C.green) end
				ctx.refresh()
			end)
		end
	end
end

-- ======================= Viseurs (version simple) =======================
local function sights(ctx: any, body: Frame)
	local profile = ctx.data and ctx.data.profile
	local sc = K.scroll(body, { Name = "Sights" })
	K.vlist(sc, 10); K.pad(sc, 0, 0, 8, 10)
	local key = ctx.armSel or "galil"
	if not Config.WEAPONS[key] or Config.WEAPONS[key].melee then key = "galil" end
	local function own(id: string): boolean
		local it = Catalog.get(id)
		return it ~= nil and profile ~= nil and Catalog.owns(profile, it)
	end
	local function grid(order: number): Frame
		local g = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, sc)
		K.grid(g, UDim2.fromOffset(300, 56), 10)
		return g
	end
	K.label(sc, "RÉTICULE (POUR TOUTES LES ARMES)", 1)
	local g1 = grid(2)
	for i, r in ipairs(X.RETICLES) do
		local id = "reticle_" .. r.id
		local have = own(id)
		itemCard(g1, i, r.name, r.rarity, have, profile ~= nil and profile.equipped.reticle == r.id, function()
			if not have then ctx.panel("shop"); return end
			ctx.call("ShopEquip", id); ctx.refresh()
		end)
	end
	K.label(sc, "OPTIQUE · " .. string.upper(Config.WEAPONS[key].name) .. " (choisis l'arme dans Armes)", 3)
	local g2 = grid(4)
	for i, s in ipairs(X.SIGHTS) do
		local id = "sight_" .. s.id
		local have = own(id)
		itemCard(g2, i, s.name, s.rarity, have, profile ~= nil and profile.equipped.sights[key] == s.id, function()
			if not have then ctx.panel("shop"); return end
			ctx.call("ShopEquip", id, key); ctx.refresh()
		end)
	end
	K.para(sc, "Purement visuels : l'effet en jeu reste celui du point rouge. Les viseurs verrouillés s'achètent dans la Boutique.", 12, C.dim, 5)
end

-- ======================= Casier =======================
local function locker(ctx: any, body: Frame)
	local profile = ctx.data and ctx.data.profile
	local W = ctx.W - 56
	local kind = ctx.lockerKind or "outfits"
	local lw = if W >= 1000 then math.floor(W * 0.42) else W
	local left = K.scroll(body, { Name = "Locker", Size = UDim2.new(0, lw, 1, 0) })
	K.vlist(left, 10); K.pad(left, 0, 0, 8, 10)
	-- choix de la catégorie d'abord, puis une phrase qui dit où ça se voit en jeu
	local tabs = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, left)
	K.hlist(tabs, 6, Enum.VerticalAlignment.Center, true)
	for i, t in ipairs({ { "outfits", "👕 Tenues" }, { "dances", "💃 Danses" }, { "sprays", "🎨 Sprays" }, { "killfx", "💥 Effets d'élimination" }, { "trails", "✨ Traînées" } }) do
		K.chip(tabs, t[2], kind == t[1], function() ctx.lockerKind = t[1]; ctx.render() end, { LayoutOrder = i, Size = UDim2.fromOffset(0, 32) })
	end
	K.para(left, if kind == "dances" then "Danses et emotes : touche T en partie." elseif kind == "outfits" then "La tenue de ton soldat, visible à ta prochaine apparition."
		elseif kind == "sprays" then "Un dessin sur les murs : touche J en partie." elseif kind == "trails" then "La couleur de la traînée de tes balles."
		else "L'effet qui apparaît quand tu élimines un adversaire.", 12, C.dim, 2)
	local g = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, left)
	K.grid(g, UDim2.new(0.5, -5, 0, 56), 10)
	local status = ""
	if kind == "dances" then
		local ids = {}
		for id in pairs(Config.DANCES) do table.insert(ids, id) end
		table.sort(ids, function(a, b)
			local ra, rb = Config.DANCES[a].rarity, Config.DANCES[b].rarity
			return if ra ~= rb then ra < rb else Config.DANCES[a].name < Config.DANCES[b].name
		end)
		for i, id in ipairs(ids) do
			local dd = Config.DANCES[id]
			local have = profile ~= nil and table.find(profile.inv.dances, id) ~= nil
			local on = profile ~= nil and profile.equippedDance == id
			if on then status = "✔ Danse équipée : " .. dd.name end
			itemCard(g, i, dd.name, dd.rarity, have, on, function()
				if not have then ctx.toast("Danse à gagner dans les caisses, le cadeau du jour ou l'événement", C.gold); return end
				if ctx.call("EquipDance", id) then ctx.toast("✔ " .. dd.name .. " équipée (touche T)", C.green) end
				ctx.refresh()
			end)
		end
	elseif kind == "sprays" then
		-- sprays (SprayService) : débloqués par niveau comme sur le web (1, 1, 2, 2, 3, 3, 4, 4)
		local level = ctx.data and ctx.data.level or 1
		local cur = profile and profile.cosmetics and profile.cosmetics.spray or "smile"
		for i, id in ipairs(X.SPRAYS) do
			local look = SPRAY_LOOK[id] or { id, "?" }
			local need = 1 + (i - 1) // 2
			local have = level >= need
			if cur == id then status = "✔ Spray équipé : " .. look[1] end
			itemCard(g, i, look[2] .. "  " .. look[1] .. (if have then "" else "  · niveau " .. need), math.min(4, need), have, cur == id, function()
				if not have then ctx.toast("Débloqué au niveau " .. need, C.gold); return end
				if ctx.call("SetSpray", id) then ctx.toast("✔ " .. look[1] .. " (touche J en jeu)", C.green) end
				ctx.refresh()
			end)
		end
	elseif kind == "outfits" then
		for i, o in ipairs(Config.OUTFITS) do
			local it = Catalog.get("outfit_" .. i)
			local have = it ~= nil and profile ~= nil and Catalog.owns(profile, it)
			local on = profile ~= nil and profile.equipped.outfit == i
			if on then status = "✔ Tenue équipée : " .. o.name end
			itemCard(g, i, o.name, o.rarity, have, on, function()
				if not have then ctx.panel("shop"); return end
				if ctx.call("ShopEquip", "outfit_" .. i) then ctx.toast("✔ " .. o.name .. " : visible à ta prochaine apparition", C.green) end
				ctx.refresh()
			end)
		end
	elseif kind == "trails" then
		-- traînée de balles (boutique, X.TRAILS) : « Standard » = aucune traînée achetée
		local eqTrail = profile and profile.equipped and profile.equipped.trail or ""
		if eqTrail == "" then status = "✔ Traînée : Standard" end
		itemCard(g, 0, "Standard", 1, true, eqTrail == "", function()
			if eqTrail ~= "" then ctx.toast("La traînée standard revient en équipant « Standard » dans la Boutique", C.dim) end
		end)
		for i, t in ipairs(X.TRAILS) do
			if t ~= "" then
				local it = Catalog.get("trail_" .. t)
				local have = it ~= nil and profile ~= nil and Catalog.owns(profile, it)
				local nm = if it then (string.gsub(it.name, "^Traînée ", "")) else t
				if eqTrail == t then status = "✔ Traînée : " .. nm end
				itemCard(g, i, nm .. (if have or not it then "" else "  · " .. K.fmt(it.price) .. " 💰"), if it then it.rarity else 1, have, eqTrail == t, function()
					if not have then ctx.panel("shop"); return end
					ctx.call("ShopEquip", "trail_" .. t); ctx.refresh()
				end)
			end
		end
	else
		for i, fx in ipairs(KillFxConfig.LIST) do
			local have = fx.id == "none" or (profile ~= nil and table.find(profile.inv.killfx or {}, fx.id) ~= nil)
			local on = profile ~= nil and (profile.equipped.killFx or "none") == fx.id
			if on then status = "✔ Effet équipé : " .. fx.name end
			itemCard(g, i, fx.name, fx.rarity, have, on, function()
				if not have then
					if fx.source == "code" then ctx.toast("S'obtient avec un code promo", C.gold); ctx.panel("codes")
					elseif fx.source == "group" then ctx.toast("S'obtient en rejoignant le groupe Roblox", C.gold); ctx.panel("group")
					else ctx.panel("shop") end
					return
				end
				if ctx.call("ShopEquip", "killfx_" .. fx.id) then ctx.toast("✔ " .. fx.name, C.green) end
				ctx.refresh()
			end)
		end
	end
	-- aperçu du personnage
	if W >= 1000 then
		local pw = math.min(620, W - lw - 30)
		local right = make("Frame", { Position = UDim2.fromOffset(lw + 30, 0), Size = UDim2.new(0, pw, 1, 0) }, body)
		preview(right, { Size = UDim2.new(1, 0, 1, -50) }, characterModel(ctx.player), 32)
		if status ~= "" then
			K.btn(right, status, "primary", nil, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -4), Size = UDim2.fromOffset(0, 34),
				AutomaticSize = Enum.AutomaticSize.X, TextSize = 13, Font = K.BOLD })
		end
	end
end

-- ======================= Caisses =======================
local function crates(ctx: any, body: Frame)
	local profile = ctx.data and ctx.data.profile
	local W = ctx.W - 56
	local sc = K.scroll(body, { Name = "Crates" })
	local wide = W >= 1100
	local lay = if wide then K.hlist(sc, 18, Enum.VerticalAlignment.Top) else K.vlist(sc, 14)
	lay.SortOrder = Enum.SortOrder.LayoutOrder
	K.pad(sc, 0, 0, 8, 10)
	local cw = if wide then math.floor((W - 36 - 340) / 2) else W - 10
	for i, id in ipairs({ "std", "prem" }) do
		local def = Config.BOXES[id]
		local col = if id == "std" then C.blue else C.gold
		local f = make("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(cw, 400), BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x0c1220) }, sc)
		K.stroke(f, C.white, 1, 0.9)
		make("Frame", { Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 0, BackgroundColor3 = col }, f)
		local icon = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 26), Size = UDim2.fromOffset(128, 98), BackgroundTransparency = 0,
			BackgroundColor3 = K.rgb(0x1e2a42) }, f)
		K.corner(icon, 6); K.stroke(icon, col, 3, 0)
		make("Frame", { Size = UDim2.new(1, 0, 0, 6), Position = UDim2.fromScale(0, 0.38), BackgroundTransparency = 0, BackgroundColor3 = col }, icon)
		text(icon, { Text = "?", Size = UDim2.fromScale(1, 1), TextSize = 40, Font = K.BLACK, TextXAlignment = Enum.TextXAlignment.Center })
		text(f, { Text = spaced(string.upper(def.name), 2), Position = UDim2.fromOffset(0, 140), Size = UDim2.new(1, 0, 0, 22), Font = K.BLACK, TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center })
		local stock = profile and profile.boxes and profile.boxes[id] or 0
		text(f, { Text = "En stock : <b>" .. stock .. "</b>  •  Prix : 💰 " .. K.fmt(def.coins), Position = UDim2.fromOffset(0, 166), Size = UDim2.new(1, 0, 0, 16), TextSize = 12,
			TextColor3 = C.sub, TextXAlignment = Enum.TextXAlignment.Center })
		-- probabilités (obligatoires sur Roblox)
		for r, wgt in ipairs(def.weights) do
			local y = 196 + (r - 1) * 20
			local rc = K.rarityColor(r)
			text(f, { Text = Config.RARITY[r].name, Position = UDim2.fromOffset(18, y), Size = UDim2.fromOffset(80, 16), TextSize = 11, Font = K.BLACK, TextColor3 = if r == 1 then C.text else rc })
			local bar = make("Frame", { Position = UDim2.fromOffset(100, y + 5), Size = UDim2.fromOffset(math.max(4, wgt * 1.0), 6), BackgroundTransparency = 0, BackgroundColor3 = rc }, f)
			K.corner(bar, 3)
			text(f, { Text = wgt .. " %", Position = UDim2.fromOffset(108 + wgt, y), Size = UDim2.fromOffset(60, 16), TextSize = 11, TextColor3 = C.dim })
		end
		local can = stock > 0 or (profile ~= nil and (profile.coins or 0) >= def.coins)
		local b = K.btn(f, if stock > 0 then spaced("OUVRIR", 3) else spaced("ACHETER ET OUVRIR (💰 " .. K.fmt(def.coins) .. ")", 1), if can then "primary" else "dark", function()
			if ctx.busyCrate then return end
			ctx.busyCrate = true
			local res = ctx.call("OpenBox", id)
			if res and res.ok then
				local okA, errA = pcall(function() require(ReplicatedStorage.Shared.CrateOpening).play(nil, res, id) end)   -- ouverture 3D du web
				if not okA then warn("[MainMenu] CrateOpening", errA) end
			else ctx.toast(if res and res.err == "not_enough_coins" then "Pas assez de pièces" else "Ouverture impossible", C.accent) end
			ctx.busyCrate = false
			ctx.refresh()
		end, { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 290), Size = UDim2.fromOffset(if stock > 0 then 150 else math.min(cw - 30, 400), 50), TextSize = 16 })
		K.cut(b, 10, K.rgb(0x0c1220))
	end
	-- encarts d'information
	local info = make("Frame", { LayoutOrder = 3, Size = UDim2.fromOffset(if wide then 330 else cw, 0), AutomaticSize = Enum.AutomaticSize.Y }, sc)
	K.vlist(info, 10)
	local function box(order: number, title: string, body2: string)
		local f = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x0c1220) }, info)
		K.stroke(f, C.white, 1, 0.9); K.pad(f, 14, 12); K.vlist(f, 6)
		K.label(f, title, 1, C.dim)
		K.para(f, body2, 12, C.text, 2)
	end
	box(1, "COMMENT ÇA MARCHE", "Gagne des <b>pièces</b> et de l'<b>XP</b> en jouant, termine les défis du jour et récupère ta récompense quotidienne. Les caisses contiennent des <b>skins d'armes</b>, des <b>danses</b> et des <b>tenues</b>. Les doublons sont convertis en pièces. Probabilités affichées ; une rareté Épique est garantie toutes les "
		.. Config.PITY.epic .. " ouvertures et une Légendaire toutes les " .. Config.PITY.legend .. ". Les camos animés ✨ sont exclusifs (achat en Robux).")
	local pity = profile and profile.pity or { epic = 0, legend = 0 }
	box(2, "PITIÉ", "Épique garanti dans <b>" .. math.max(1, Config.PITY.epic - pity.epic) .. "</b> ouvertures\nLégendaire garanti dans <b>" .. math.max(1, Config.PITY.legend - pity.legend)
		.. "</b> ouvertures\nCaisses ouvertes : <b>" .. (profile and profile.opened or 0) .. "</b>")
	local owned, total = 0, 0
	for k, ww in pairs(Config.WEAPONS) do
		if not ww.melee then
			for _, sk in ipairs(Config.SKINS) do if sk.rarity > 1 then total += 1 end end
			owned += profile and profile.inv.skins[k] and #profile.inv.skins[k] or 0
		end
	end
	local nd = 0; for _ in pairs(Config.DANCES) do nd += 1 end
	box(3, "COLLECTION", "Skins débloqués : <b>" .. owned .. " / " .. total .. "</b>\nDanses : <b>" .. (profile and #profile.inv.dances or 0) .. " / " .. nd .. "</b>")
end

return function(ctx: any, body: Frame, sub: string?)
	if sub == "Viseurs" or sub == "Armes" then
		local ap = panels()
		local fn = ap and (if sub == "Armes" then ap.arms else ap.sights)
		if fn then
			local ok, err = pcall(fn, body)
			if ok then return end
			warn("[MainMenu] ArsenalPanels", err)
			K.clear(body)
		end
		if sub == "Armes" then arms(ctx, body) else sights(ctx, body) end
	elseif sub == "Casier" then
		locker(ctx, body)
	else
		crates(ctx, body)
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="817">
          <Properties>
            <string name="Name">CardPicker</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/CardPicker (ModuleScript, client) — Profil › Pseudo et titre : CARTE DE JOUEUR.
-- Aperçu de la carte (Shared/PlayerCard), puis les bannières et les emblèmes : débloqués = cliquables, verrouillés = grisés
-- avec leur condition. Le serveur (remote « Career », action « card ») vérifie le déblocage ; la carte se voit dans la kill-cam.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local PlayerCard = require(ReplicatedStorage.Shared.PlayerCard)
local K = require(script.Parent.Kit)
local Fx = require(script.Parent.Fx)
local Career = require(script.Parent.Career)
local C = K.C
local make, text = K.make, K.text

return function(ctx: any, sc: Instance, order: number)
	K.label(sc, "CARTE DE JOUEUR (VISIBLE DANS LA KILL-CAM)", order)
	if not Career.ready(ctx, sc, order + 1) then return end
	local cd = ctx.career
	local v: PlayerCard.View = cd.view
	local cur = cd.card or {}
	local selB: string = ctx.cardB or cur.b or "recrue"
	local selE: string = ctx.cardE or cur.e or "cible"
	local box = make("Frame", { LayoutOrder = order + 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, sc)
	K.vlist(box, 10)
	-- aperçu + bouton équiper
	local narrow = ctx.W - 56 < 680   -- écran étroit : bouton sous l'aperçu
	local top = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, if narrow then 130 else 96) }, box)
	local title = ctx.player:GetAttribute("Title")
	PlayerCard.render(top, { banner = selB, emblem = selE, name = ctx.player.DisplayName, title = if typeof(title) == "string" then title else nil,
		level = ctx.data and ctx.data.level, size = if narrow then 300 else 400 })
	local changed = selB ~= cur.b or selE ~= cur.e
	K.btn(top, if changed then "✔  " .. K.spaced("ÉQUIPER CETTE CARTE", 1) else "✔  " .. K.spaced("CARTE ÉQUIPÉE", 1), if changed then "primary" else "alt", function()
		if not changed then return end
		local res = ctx.call("Career", "card", selB, selE)
		if typeof(res) == "table" and res.ok then
			cd.card = { b = selB, e = selE }; ctx.cardB = nil; ctx.cardE = nil
			Fx.pop("🪪  Nouvelle carte de joueur équipée", C.gold)
			ctx.render()
		else
			ctx.toast("❌ " .. tostring(typeof(res) == "table" and res.err or "Impossible d'équiper cette carte"), C.accent)
		end
	end, { Position = if narrow then UDim2.fromOffset(0, 82) else UDim2.fromOffset(416, 24), Size = UDim2.fromOffset(230, 44), TextSize = 12 })
	-- bannières
	K.label(box, "BANNIÈRES", 2, C.dim)
	local g = make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
	K.hlist(g, 8, Enum.VerticalAlignment.Top, true)
	for i, b in ipairs(PlayerCard.BANNERS) do
		local open = PlayerCard.open(b.need, v)
		local cell = make("TextButton", { LayoutOrder = i, Text = "", Size = UDim2.fromOffset(170, 62), BackgroundTransparency = 1, AutoButtonColor = false }, g)
		local mini = PlayerCard.render(cell, { banner = b.id, emblem = selE, name = b.n, size = 170 })
		mini.Position = UDim2.fromOffset(0, 0)
		if not open then
			for _, d in ipairs(mini:GetDescendants()) do if d:IsA("TextLabel") then d.TextTransparency = 0.6 end end
			local lock = text(cell, { Text = "🔒 " .. PlayerCard.needText(b.need), Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 18), TextSize = 10,
				TextColor3 = C.dim, BackgroundTransparency = 0.25, BackgroundColor3 = C.deep, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
				TextTruncate = Enum.TextTruncate.AtEnd, ZIndex = 3 })
			K.corner(lock, 4)
		else
			text(cell, { Text = b.n, Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, 0, 0, 16), TextSize = 10, TextColor3 = if b.id == selB then C.gold else C.sub,
				TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = 3 })
		end
		if b.id == selB then K.stroke(cell, C.gold, 2, 0) end
		K.juice(cell, 0.03)
		cell.Activated:Connect(function()
			if not open then ctx.toast("🔒 " .. PlayerCard.needText(b.need), C.gold); return end
			ctx.cardB = b.id; ctx.cardE = selE; ctx.render()
		end)
	end
	-- emblèmes
	K.label(box, "EMBLÈMES", 4, C.dim)
	local eg = make("Frame", { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, box)
	K.hlist(eg, 8, Enum.VerticalAlignment.Center, true)
	for i, e in ipairs(PlayerCard.EMBLEMS) do
		local open = PlayerCard.open(e.need, v)
		local label = e.ic .. "  " .. e.n .. (if open then "" else '\n<font size="9" color="#6f819e">🔒 ' .. PlayerCard.needText(e.need) .. "</font>")
		local chip = K.chip(eg, label, e.id == selE, function()
			if not open then ctx.toast("🔒 " .. PlayerCard.needText(e.need), C.gold); return end
			ctx.cardB = selB; ctx.cardE = e.id; ctx.render()
		end, { LayoutOrder = i, Size = UDim2.fromOffset(0, if open then 40 else 46), TextColor3 = if open then C.white else C.dim })
		if not open then chip.BackgroundTransparency = 0.6 end
	end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="818">
          <Properties>
            <string name="Name">Career</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Career (ModuleScript, client) — Profil › Statistiques, sous les statistiques générales :
--   • records du stand d'entraînement (score, précision, temps de réaction moyen et meilleur) ;
--   • carrière par arme : éliminations, tirs à la tête, % de têtes, et la MAÎTRISE (camos Or, Diamant, Matière noire,
--     Shared/Mastery) avec sa progression et les boutons pour poser un camo débloqué sur l'arme.
-- Les données viennent du remote « Career » (CareerService), gardées dans ctx.career ; tout est vérifié côté serveur.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local Mastery = require(ReplicatedStorage.Shared.Mastery)
local K = require(script.Parent.Kit)
local Fx = require(script.Parent.Fx)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local Career = {}

-- charge (ou recharge) la carrière ; cb après réception
function Career.fetch(ctx: any, cb: (() -> ())?)
	if ctx.careerBusy then return end
	ctx.careerBusy = true
	task.spawn(function()
		local res = ctx.call("Career", "get")
		ctx.careerBusy = false
		if typeof(res) == "table" then
			ctx.career = res; ctx.careerT = os.clock()
			if cb then cb() end
		end
	end)
end
-- données prêtes ? sinon un message et un rendu dès qu'elles arrivent
function Career.ready(ctx: any, sc: Instance, order: number): boolean
	if ctx.career then
		if os.clock() - (ctx.careerT or 0) > 15 then Career.fetch(ctx) end   -- rafraîchit en douce (la page suivante l'affichera)
		return true
	end
	K.para(sc, "Chargement de la carrière…", 12, C.dim, order)
	Career.fetch(ctx, function() if ctx.render and ctx.tab == "profile" then ctx.render() end end)
	return false
end

local function panel(parent: Instance, order: number): Frame
	local f = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.12,
		BackgroundColor3 = K.rgb(0x0f1626) }, parent)
	K.stroke(f, C.white, 1, 0.9); K.pad(f, 16, 14); K.vlist(f, 8)
	return f
end
local function sec(x: any): string
	if typeof(x) ~= "number" then return "—" end
	return (string.gsub(string.format("%.2f", x), "%.", ",")) .. " s"
end

function Career.stats(ctx: any, sc: Instance, order: number)
	if not Career.ready(ctx, sc, order) then return end
	local cd = ctx.career
	local career = cd.career or {}
	local diamonds = Mastery.diamonds(career)
	local W = ctx.W - 56
	-- ---------- stand d'entraînement ----------
	local tr = cd.train or {}
	local tp = panel(sc, order)
	K.label(tp, "🎯 STAND D'ENTRAÎNEMENT · RECORDS", 0, C.dim)
	local row = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 58) }, tp)
	type Cell = { v: string, n: string, c: Color3 }
	local cells: { Cell } = { { v = tostring(tr.score or "—"), n = "MEILLEUR SCORE", c = C.gold }, { v = if tr.acc then tr.acc .. " %" else "—", n = "PRÉCISION", c = C.green },
		{ v = sec(tr.rt), n = "RÉACTION MOYENNE", c = C.blue }, { v = sec(tr.rtBest), n = "MEILLEURE RÉACTION", c = C.violet } }
	for j, c in ipairs(cells) do
		local cell = make("Frame", { Position = UDim2.new((j - 1) / 4, 4, 0, 0), Size = UDim2.new(0.25, -8, 1, 0), BackgroundTransparency = 0.6, BackgroundColor3 = C.navy }, row)
		K.corner(cell, 6)
		text(cell, { Text = c.v, Position = UDim2.fromOffset(0, 6), Size = UDim2.new(1, 0, 0, 26), Font = K.BLACK, TextSize = 22, TextColor3 = c.c,
			TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
		text(cell, { Text = spaced(c.n, 1), Position = UDim2.fromOffset(0, 36), Size = UDim2.new(1, 0, 0, 14), TextSize = 9, TextColor3 = C.dim,
			TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	end
	K.para(tp, "Mode Entraînement : les cibles qui réapparaissent mesurent ton temps de réaction (moyenne des 10 dernières).", 11, C.dim, 2)

	-- ---------- maîtrise et carrière par arme ----------
	local mp = panel(sc, order + 1)
	local nGold, nDark = 0, 0
	for k, rec in pairs(career) do
		if Mastery.eligible(Config.WEAPONS, k) then
			local l = Mastery.level(rec, diamonds)
			if l >= 1 then nGold += 1 end
			if l >= 3 then nDark += 1 end
		end
	end
	K.label(mp, "🥇 MAÎTRISE D'ARMES ET CARRIÈRE", 0, C.dim)
	K.para(mp, "Or : 100 éliminations et 30 tirs à la tête avec l'arme · Diamant : 300 et 120 · Matière noire : le Diamant sur 5 armes."
		.. '   <font color="#ffd23a">Or ' .. nGold .. '</font>  ·  <font color="#96e1ff">Diamant ' .. diamonds .. '</font>  ·  <font color="#be6eff">Matière noire ' .. nDark .. "</font>", 11, C.sub, 1)
	type Row = { key: string, name: string, k: number, hs: number }
	local list: { Row } = {}
	for k, w in pairs(Config.WEAPONS) do
		if Mastery.eligible(Config.WEAPONS, k) then
			local rec = career[k]
			table.insert(list, { key = k, name = w.name, k = if rec then rec.k or 0 else 0, hs = if rec then rec.hs or 0 else 0 })
		end
	end
	table.sort(list, function(a: Row, b: Row): boolean
		if a.k ~= b.k then return a.k > b.k end
		return a.name < b.name
	end)
	local all = ctx.careerAll == true
	local camos = cd.camos or {}
	for j, it in ipairs(list) do
		if not all and j > 8 then break end
		local rec = career[it.key]
		local lvl = Mastery.level(rec, diamonds)
		local goal, pk, ph = Mastery.nextGoal(rec, diamonds)
		-- écran étroit : les boutons des camos passent sur une 2e ligne
		local narrow = W < 900
		local r = make("Frame", { LayoutOrder = 10 + j, Size = UDim2.new(1, 0, 0, if narrow then 72 else 40), BackgroundTransparency = if j % 2 == 0 then 0.97 else 1,
			BackgroundColor3 = C.white }, mp)
		K.corner(r, 6)
		local ln = make("Frame", { Size = UDim2.new(if narrow then 1.45 else 1, 0, 0, 40) }, r)   -- la ligne principale (plus large : sans la colonne des camos)
		local badge = if lvl >= 3 then "🌌" elseif lvl == 2 then "💎" elseif lvl == 1 then "🥇" else "·"
		text(ln, { Text = badge .. "  " .. it.name, Position = UDim2.fromOffset(8, 0), Size = UDim2.new(0.22, 0, 1, 0), Font = K.BLACK, TextSize = 13, TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd })
		local pct = if it.k > 0 then math.floor(it.hs / it.k * 100 + 0.5) .. " %" else "—"
		text(ln, { Text = it.k .. ' <font color="#8da0bd">élim.</font>  ·  ' .. it.hs .. ' <font color="#8da0bd">têtes</font>  ·  ' .. pct, Position = UDim2.new(0.23, 0, 0, 0),
			Size = UDim2.new(0.25, 0, 1, 0), TextSize = 12, Font = K.MED, TextWrapped = false })
		-- progression vers le palier suivant (la plus lente des deux jauges)
		if goal then
			local frac = math.min(pk, ph)
			local b = K.bar(ln, frac, { Position = UDim2.new(0.49, 0, 0.5, -9), Size = UDim2.new(0.18, 0, 0, 5) }, goal.color, goal.color:Lerp(C.white, 0.4))
			b.Name = "MasteryBar"
			text(ln, { Text = goal.name .. " : " .. math.min(it.k, goal.kills) .. "/" .. goal.kills .. " · " .. math.min(it.hs, goal.hs) .. "/" .. goal.hs
				.. (if goal.needDiamonds and diamonds < goal.needDiamonds then " · " .. diamonds .. "/" .. goal.needDiamonds .. " 💎" else ""),
				Position = UDim2.new(0.49, 0, 0.5, -2), Size = UDim2.new(0.2, 0, 0, 14), TextSize = 10, TextColor3 = C.dim, TextWrapped = false })
		else
			text(ln, { Text = "Maîtrise complète", Position = UDim2.new(0.49, 0, 0, 0), Size = UDim2.new(0.2, 0, 1, 0), TextSize = 11, TextColor3 = C.violet, Font = K.BLACK })
		end
		-- camos débloqués : un bouton par camo (posé = surligné ; un 2e clic le retire)
		local bx = make("Frame", { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -6, 0.5, 0), Size = UDim2.new(0.31, 0, 0, 28) }, r)
		local lay = K.hlist(bx, 6); lay.HorizontalAlignment = Enum.HorizontalAlignment.Right
		local cur = camos[it.key]
		for ti, t in ipairs(Mastery.TIERS) do
			if lvl >= ti then
				local on = cur == t.camo
				local cb = K.chip(bx, (if on then "✔ " else "") .. t.name, on, function()
					local res = ctx.call("Career", "camo", it.key, if on then "" else t.camo)
					if typeof(res) == "table" and res.ok then
						cd.camos = res.camos or cd.camos
						Fx.pop((if on then "Camo retiré : " else "Camo " .. t.name .. " posé sur ") .. it.name, t.color)
						ctx.render()
					else
						ctx.toast("❌ " .. tostring(typeof(res) == "table" and res.err or "Impossible"), C.accent)
					end
				end, { LayoutOrder = ti, Size = UDim2.fromOffset(0, 26), TextSize = 11 }, t.color:Lerp(Color3.new(0, 0, 0), 0.35))
				cb.TextColor3 = if on then C.white else t.color
			end
		end
		if narrow then
			bx.AnchorPoint = Vector2.new(0, 1); bx.Position = UDim2.new(0, 8, 1, -4); bx.Size = UDim2.new(1, -16, 0, 26)
			lay.HorizontalAlignment = Enum.HorizontalAlignment.Left
		end
	end
	if #list > 8 then
		K.btn(mp, if all then "▴  Moins d'armes" else "▾  Toutes les armes (" .. #list .. ")", "ghost", function() ctx.careerAll = not all; ctx.render() end,
			{ LayoutOrder = 100, Size = UDim2.new(1, 0, 0, 30), TextSize = 12 })
	end
end

return Career
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="819">
          <Properties>
            <string name="Name">Fx</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Fx (ModuleScript, client) — effets du menu, branchés par des appels courts :
--   Fx.ambient(bgGui)              poussières lumineuses qui montent doucement et petits éclats au fond du menu
--   Fx.confetti(obj)               pluie de confettis qui part du centre d'un objet (récompense récupérée)
--   Fx.coins(n, obj?)              pièces qui volent vers le compteur, avec un « +n 💰 » qui défile
--   Fx.reward(obj, coins, xp)      confettis + pièces + petit message (défi récupéré)
--   Fx.pop(texte, couleur?)        petite notification qui tombe en haut de l'écran puis s'efface
--   Fx.flipOut(obj) / Fx.flipIn(obj)  carte qui s'efface / nouvelle carte qui arrive (défi changé)
--   Fx.countTo(label, a, b, fmt)   nombre qui défile dans un texte
-- Tout est dessiné dans une ScreenGui à part (« MenuFx », au-dessus du menu, jamais cliquable) : rien ne bouge la mise en page.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Fx = {}

local GOLD = Color3.fromRGB(255, 210, 58)
local COLORS = { Color3.fromRGB(255, 70, 85), GOLD, Color3.fromRGB(74, 163, 255), Color3.fromRGB(125, 255, 159), Color3.fromRGB(199, 125, 255), Color3.new(1, 1, 1) }

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0; o.Active = false; pcall(function() o.Interactable = false end) end
	if class == "TextLabel" then o.BackgroundTransparency = 1; o.Font = Enum.Font.GothamBlack; o.TextColor3 = Color3.new(1, 1, 1); o.RichText = true end
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function tween(o: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- couche des effets (créée au premier besoin)
local fxGui: ScreenGui? = nil
local function layer(): ScreenGui
	if fxGui and fxGui.Parent then return fxGui end
	local pg = Players.LocalPlayer:WaitForChild("PlayerGui")
	local g = make("ScreenGui", { Name = "MenuFx", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 30, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, pg)
	fxGui = g
	return g
end
-- position d'un objet du menu dans la couche des effets (qui ignore la barre du haut de Roblox, pas le menu)
local function absPos(o: GuiObject): Vector2
	local sg = o:FindFirstAncestorWhichIsA("ScreenGui")
	local inset = if sg and not sg.IgnoreGuiInset then game:GetService("GuiService"):GetGuiInset() else Vector2.zero
	return o.AbsolutePosition + inset
end
local function center(o: GuiObject?): Vector2
	local g = layer()
	if o and o.Parent then return absPos(o) + o.AbsoluteSize / 2 end
	return g.AbsoluteSize / 2
end
-- cadre posé exactement sur un objet (les cartes sont dans des listes : on ne leur ajoute pas d'enfant)
local function over(o: GuiObject): Frame
	local p = absPos(o)
	return make("Frame", { Position = UDim2.fromOffset(p.X, p.Y), Size = UDim2.fromOffset(o.AbsoluteSize.X, o.AbsoluteSize.Y), BackgroundTransparency = 1,
		ClipsDescendants = true, ZIndex = 4 }, layer())
end

-- ---------- fond : poussières et éclats ----------
type Mote = { f: Frame, x: number, y: number, vy: number, ph: number, amp: number }
function Fx.ambient(bg: ScreenGui)
	if bg:FindFirstChild("FxMotes") then return end
	local holder = make("Frame", { Name = "FxMotes", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 2 }, bg)
	local rng = Random.new()
	local motes: { Mote } = {}
	for i = 1, 28 do
		local s = rng:NextInteger(2, 5)
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Size = UDim2.fromOffset(s, s), BackgroundColor3 = COLORS[(i % 3) + 1]:Lerp(Color3.new(1, 1, 1), 0.5),
			BackgroundTransparency = rng:NextNumber(0.55, 0.85), ZIndex = 1 }, holder)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, f)
		table.insert(motes, { f = f, x = rng:NextNumber(), y = rng:NextNumber(), vy = rng:NextNumber(0.012, 0.035), ph = rng:NextNumber(0, 6.28), amp = rng:NextNumber(0.004, 0.018) })
	end
	-- éclat : petite étoile à 4 branches qui s'allume puis s'éteint à un endroit au hasard
	local function sparkle()
		local x, y = rng:NextNumber(0.05, 0.95), rng:NextNumber(0.1, 0.9)
		local st = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(x, y), Size = UDim2.fromOffset(14, 14), BackgroundTransparency = 1, ZIndex = 1 }, holder)
		local sc = make("UIScale", { Scale = 0.2 }, st)
		for _, r in ipairs({ 0, 90 }) do
			local b = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.new(1, 0, 0, 2), Rotation = r,
				BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.35, ZIndex = 1 }, st)
			make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0), NumberSequenceKeypoint.new(1, 1) }) }, b)
		end
		tween(sc, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
		tween(st, 1.2, { Rotation = 45 })
		task.delay(0.6, function() tween(sc, 0.5, { Scale = 0 }) end)
		task.delay(1.2, function() st:Destroy() end)
	end
	local acc = 0
	local conn = RunService.Heartbeat:Connect(function(dt: number)
		if not bg.Enabled then return end   -- menu fermé : rien ne bouge
		local t = os.clock()
		for _, m in ipairs(motes) do
			m.y -= m.vy * dt
			if m.y < -0.03 then m.y = 1.03; m.x = rng:NextNumber() end
			m.f.Position = UDim2.fromScale(m.x + math.sin(t * 0.6 + m.ph) * m.amp, m.y)
		end
		acc += dt
		if acc > 1.6 then acc = 0; if rng:NextNumber() < 0.7 then sparkle() end end
	end)
	holder.Destroying:Connect(function() conn:Disconnect() end)
end

-- ---------- confettis ----------
type Bit = { f: Frame, vx: number, vy: number, vr: number }
function Fx.confetti(at: GuiObject?, count: number?)
	local g = layer()
	local c = center(at)
	local rng = Random.new()
	local bits: { Bit } = {}
	for i = 1, count or 34 do
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(c.X, c.Y), Size = UDim2.fromOffset(rng:NextInteger(5, 9), rng:NextInteger(3, 5)),
			BackgroundColor3 = COLORS[(i % #COLORS) + 1], Rotation = rng:NextNumber(0, 360), ZIndex = 5 }, g)
		local a = rng:NextNumber(math.rad(200), math.rad(340))
		local sp = rng:NextNumber(220, 520)
		table.insert(bits, { f = f, vx = math.cos(a) * sp, vy = math.sin(a) * sp, vr = rng:NextNumber(-540, 540) })
	end
	local life = 0
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function(dt: number)
		life += dt
		for _, b in ipairs(bits) do
			b.vy += 900 * dt; b.vx *= (1 - 1.6 * dt)
			local p = b.f.Position
			b.f.Position = UDim2.fromOffset(p.X.Offset + b.vx * dt, p.Y.Offset + b.vy * dt)
			b.f.Rotation += b.vr * dt
			if life > 0.8 then b.f.BackgroundTransparency = math.min(1, (life - 0.8) / 0.6) end
		end
		if life > 1.4 then
			conn:Disconnect()
			for _, b in ipairs(bits) do b.f:Destroy() end
		end
	end)
end

-- ---------- nombre qui défile ----------
function Fx.countTo(label: TextLabel, from: number, to: number, fmt: ((number) -> string)?, dur: number?)
	local d = dur or 0.8
	local t0 = os.clock()
	local f = fmt or function(n: number): string return tostring(n) end
	local conn: RBXScriptConnection
	conn = RunService.Heartbeat:Connect(function()
		if not label.Parent then conn:Disconnect(); return end
		local k = math.clamp((os.clock() - t0) / d, 0, 1)
		k = 1 - (1 - k) ^ 3
		label.Text = f(math.floor(from + (to - from) * k + 0.5))
		if k >= 1 then conn:Disconnect() end
	end)
end

-- ---------- pièces qui volent + compteur ----------
function Fx.coins(n: number, from: GuiObject?)
	if n == 0 then return end
	local g = layer()
	local size = g.AbsoluteSize
	local target = Vector2.new(size.X - 150, 36)
	local c = center(from)
	-- le compteur : « +n 💰 » qui défile en haut à droite (ou « −n » quand on dépense)
	local lab = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(target.X, target.Y + 30), Size = UDim2.fromOffset(180, 30),
		TextSize = 22, TextColor3 = if n > 0 then GOLD else Color3.fromRGB(255, 120, 120), TextStrokeTransparency = 0.5, Text = (if n > 0 then "+" else "−") .. math.abs(n) .. " 💰", ZIndex = 6 }, g)
	local sc = make("UIScale", { Scale = 0.4 }, lab)
	local sign = if n > 0 then "+" else "−"
	if n > 0 then
		for i = 1, math.clamp(math.floor(n / 15), 4, 10) do
			local coin = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromOffset(c.X + math.random(-30, 30), c.Y + math.random(-12, 12)),
				Size = UDim2.fromOffset(24, 24), Text = "💰", TextSize = 20, ZIndex = 6 }, g)
			local delay = (i - 1) * 0.05
			task.delay(delay, function()
				local tw = tween(coin, 0.55, { Position = UDim2.fromOffset(target.X, target.Y) }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
				tw.Completed:Connect(function() coin:Destroy() end)
			end)
		end
	end
	task.delay(if n > 0 then 0.45 else 0, function()
		tween(sc, 0.3, { Scale = 1 }, Enum.EasingStyle.Back)
		Fx.countTo(lab, 0, math.abs(n), function(v: number): string return sign .. v .. " 💰" end, 0.7)
		task.delay(1.6, function()
			tween(lab, 0.4, { TextTransparency = 1, TextStrokeTransparency = 1, Position = UDim2.fromOffset(target.X, target.Y + 6) })
			task.delay(0.45, function() lab:Destroy() end)
		end)
	end)
end

-- ---------- notification ----------
local popY = 0
function Fx.pop(msg: string, color: Color3?)
	local g = layer()
	local slot = popY; popY = (popY + 1) % 3
	local y = 86 + slot * 44
	local f = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, y - 30), Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X,
		BackgroundColor3 = Color3.fromRGB(11, 17, 28), Text = msg, TextSize = 14, TextColor3 = color or Color3.new(1, 1, 1),
		TextTransparency = 1, BackgroundTransparency = 1, ZIndex = 7 }, g)
	make("UICorner", { CornerRadius = UDim.new(0, 18) }, f)
	make("UIPadding", { PaddingLeft = UDim.new(0, 18), PaddingRight = UDim.new(0, 18) }, f)
	local st = make("UIStroke", { Color = color or GOLD, Thickness = 1.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, f)
	local sc = make("UIScale", { Scale = 0.8 }, f)
	tween(f, 0.35, { Position = UDim2.new(0.5, 0, 0, y), TextTransparency = 0, BackgroundTransparency = 0.08 }, Enum.EasingStyle.Back)
	tween(st, 0.35, { Transparency = 0.35 })
	tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
	task.delay(2.4, function()
		tween(f, 0.35, { TextTransparency = 1, BackgroundTransparency = 1, Position = UDim2.new(0.5, 0, 0, y - 16) })
		tween(st, 0.35, { Transparency = 1 })
		task.delay(0.4, function() f:Destroy() end)
	end)
end

-- ---------- récompense ----------
function Fx.reward(at: GuiObject?, coins: number?, xp: number?)
	Fx.confetti(at)
	if coins and coins > 0 then Fx.coins(coins, at) end
	if xp and xp > 0 then Fx.pop("✔  Défi récupéré  ·  +" .. xp .. " XP", GOLD) end
end

-- ---------- carte remplacée ----------
local function fxScale(o: Instance): UIScale
	local s = o:FindFirstChild("FxScale")
	if s and s:IsA("UIScale") then return s end
	return make("UIScale", { Name = "FxScale" }, o)
end
-- la carte rétrécit sous un voile blanc ; le voile reste jusqu'au rendu suivant (ou 2 s au plus)
function Fx.flipOut(o: GuiObject)
	tween(fxScale(o), 0.18, { Scale = 0.86 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	local flash = over(o)
	flash.BackgroundColor3 = Color3.new(1, 1, 1)
	make("UICorner", { CornerRadius = UDim.new(0, 10) }, flash)
	tween(flash, 0.18, { BackgroundTransparency = 0.6 })
	task.delay(0.3, function() tween(flash, 0.3, { BackgroundTransparency = 1 }) end)
	task.delay(0.7, function() flash:Destroy() end)
	-- remise à l'échelle si la carte n'est pas redessinée (refus du serveur)
	task.delay(0.9, function() if o.Parent then tween(fxScale(o), 0.25, { Scale = 1 }, Enum.EasingStyle.Back) end end)
end
-- la nouvelle carte arrive en rebondissant, avec un éclair doré, un reflet et quelques confettis
function Fx.flipIn(o: GuiObject)
	local s = fxScale(o)
	s.Scale = 0.7
	tween(s, 0.45, { Scale = 1 }, Enum.EasingStyle.Back)
	task.defer(function()
		if not o.Parent then return end
		local holder = over(o)
		holder.BackgroundColor3 = GOLD; holder.BackgroundTransparency = 0.5
		make("UICorner", { CornerRadius = UDim.new(0, 10) }, holder)
		tween(holder, 0.6, { BackgroundTransparency = 1 })
		local band = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(-0.5, 0.5), Size = UDim2.fromScale(0.35, 2), Rotation = 14,
			BackgroundColor3 = Color3.new(1, 1, 1), ZIndex = 5 }, holder)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.55), NumberSequenceKeypoint.new(1, 1) }) }, band)
		task.delay(0.12, function() tween(band, 0.6, { Position = UDim2.fromScale(1.2, 0.5) }, Enum.EasingStyle.Sine) end)
		task.delay(0.9, function() holder:Destroy() end)
		Fx.confetti(o, 14)
	end)
end
-- reflet doré qui repasse sur un objet rare tant qu'il est affiché (sans lui ajouter d'enfant : listes, grilles)
function Fx.sheen(o: GuiObject, every: number?)
	local alive = true
	o.Destroying:Connect(function() alive = false end)
	task.spawn(function()
		while alive and o.Parent do
			task.wait(every or 3)
			if not (alive and o.Parent and o.Visible and o.AbsoluteSize.X > 0) then continue end
			local sg = o:FindFirstAncestorWhichIsA("ScreenGui")
			if sg and not sg.Enabled then continue end
			-- défilée hors de sa colonne : pas de reflet (il dépasserait de la zone visible)
			local sf = o:FindFirstAncestorWhichIsA("ScrollingFrame")
			if sf then
				local top, bot = sf.AbsolutePosition.Y, sf.AbsolutePosition.Y + sf.AbsoluteSize.Y
				if o.AbsolutePosition.Y < top or o.AbsolutePosition.Y + o.AbsoluteSize.Y > bot then continue end
			end
			local holder = over(o)
			make("UICorner", { CornerRadius = UDim.new(0, 10) }, holder)
			local band = make("Frame", { AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(-0.5, 0.5), Size = UDim2.fromScale(0.3, 2.2), Rotation = 14,
				BackgroundColor3 = Color3.fromRGB(255, 240, 190), ZIndex = 5 }, holder)
			make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.72), NumberSequenceKeypoint.new(1, 1) }) }, band)
			tween(band, 0.9, { Position = UDim2.fromScale(1.2, 0.5) }, Enum.EasingStyle.Sine)
			task.delay(0.95, function() holder:Destroy() end)
		end
	end)
end

return Fx
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="820">
          <Properties>
            <string name="Name">Home</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Home (ModuleScript) — rubrique « Accueil » (src/87d_lobby.js lobbyDraw)
-- colonne 1 : grande carte JOUER (partie en ligne avec le mode et la carte choisis), PARTIE RAPIDE, AVEC DES AMIS,
--             saison et bonus du jour
-- colonne 2 : défis du jour et de la semaine (récupérables ici, et seulement ici)
-- colonne 3 : nouveautés, puis « Plus » (codes promo, communauté Roblox). Cadeaux, Premium et Boutique sont dans l'en-tête.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Modes = require(ReplicatedStorage.Shared.Modes)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local K = require(script.Parent.Kit)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local function modeName(id: string): string
	local m = Modes.LIST[id]
	return if m then (string.gsub(m.n, "%s*%(.*%)", "")) else id
end
local function untilMidnight(): string
	local left = 86400 - os.time() % 86400
	local h, mn = left // 3600, (left % 3600) // 60
	return if h > 0 then string.format("%d h %02d", h, mn) else mn .. " min"
end
local function weekLeft(): string
	local t = os.time()
	local dow = (t // 86400 + 3) % 7           -- 0 = lundi
	local left = (7 - dow) * 86400 - t % 86400
	local h = math.ceil(left / 3600)
	return if h > 48 then math.ceil(h / 24) .. " j" else h .. " h"
end

local mission = K.mission

return function(ctx: any, body: Frame, _sub: string?)
	local d = ctx.data
	local profile = d and d.profile
	local W = ctx.W - 56
	local three = W >= 1100
	local cols: { GuiObject } = {}
	if three then
		local unit = (W - 36) / 3.3
		local widths = { unit * 1.3, unit, unit }
		local x = 0
		for i = 1, 3 do
			local s = K.scroll(body, { Name = "HomeCol" .. i, Size = UDim2.new(0, widths[i], 1, 0), Position = UDim2.fromOffset(x, 0) })
			K.vlist(s, 14); K.pad(s, 0, 2, 6, 10)
			cols[i] = s; x += widths[i] + 18
		end
	else
		local s = K.scroll(body, { Name = "HomeCol" })
		K.vlist(s, 14); K.pad(s, 0, 2, 6, 10)
		cols = { s, s, s }
	end

	-- ============ colonne 1 : JOUER ============
	local es: any = ctx.ev
	local hw = if es then es.active == true else (d and d.eventActive == true)
	local hero = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0, BackgroundColor3 = C.white,
		LayoutOrder = 1, ClipsDescendants = true }, cols[1])
	-- fond du web : radial-gradient rouge (orange à Halloween) en haut à gauche, bleu (violet) en bas à droite, sur un bleu nuit
	make("UIGradient", { Rotation = 35, Color = ColorSequence.new({
		ColorSequenceKeypoint.new(0, if hw then K.rgb(0x5a2a1c) else K.rgb(0x4a1c2a)),
		ColorSequenceKeypoint.new(0.42, if hw then K.rgb(0x1d1426) else K.rgb(0x151f33)),
		ColorSequenceKeypoint.new(0.78, if hw then K.rgb(0x0e0b16) else K.rgb(0x0a0f1a)),
		ColorSequenceKeypoint.new(1, if hw then K.rgb(0x2a1a4a) else K.rgb(0x10284a)) }), Transparency = NumberSequence.new(0.04) }, hero)
	K.corner(hero, 14); K.stroke(hero, if hw then K.rgb(0xff8a2a) else C.accent, 1, 0.6); K.pad(hero, 26, 24, 26, 22)
	K.vlist(hero, 10)

	local tags = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, hero)
	K.hlist(tags, 6, Enum.VerticalAlignment.Center, true)
	local function tag(txt: string, col: Color3, onClick: () -> ())
		local b = make("TextButton", { Text = txt, Font = K.BLACK, TextSize = 10, TextColor3 = col, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 24),
			BackgroundTransparency = 0.88, BackgroundColor3 = col }, tags)
		K.corner(b, 12); K.stroke(b, col, 1, 0.6); K.pad(b, 12, 0)
		b.Activated:Connect(onClick)
	end
	if hw then
		local pk: number = if es then (es.pumpkins or 0) elseif profile and profile.ev and profile.ev.id == X.EVENT.id then profile.ev.pumpkins or 0 else 0
		local evName: string = if es and es.name then es.name else X.EVENT.name
		local y, mo, da = string.match(if es and es.to then es.to else X.EVENT.to, "(%d+)-(%d+)-(%d+)")
		local days = 0
		if y then
			local endT = DateTime.fromUniversalTime(tonumber(y) :: number, tonumber(mo) :: number, tonumber(da) :: number, 23, 59, 59).UnixTimestamp
			days = math.max(0, math.ceil((endT - os.time()) / 86400))
		end
		tag("🎃  " .. spaced(string.upper(evName), 1) .. " · " .. pk .. " citrouille" .. (if pk > 1 then "s" else "") .. " · encore " .. days .. " j", C.pumpkin,
			function() ctx.go("profile", "Progression") end)
	end
	local feat = Modes.featured()
	if Modes.LIST[feat] then
		tag("★  " .. spaced("MODE DE LA SEMAINE : " .. string.upper(modeName(feat)) .. " · XP ×2", 1), C.gold, function()
			ctx.play = Modes.sanitize({ mode = feat, diff = ctx.play.diff }); ctx.save("play"); ctx.go("play")
		end)
	end
	local name = string.upper(ctx.player.DisplayName)
	text(hero, { LayoutOrder = 2, Font = K.BLACK, TextSize = 34, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LineHeight = 1.0,
		Text = spaced("PRÊT AU COMBAT,", 1) .. '\n<font color="#ff4655">' .. K.esc(spaced(name, 1)) .. "</font> ?" })
	K.para(hero, "JOUER te met dans une partie <b>en ligne</b> avec les autres joueurs. S'il en manque, des bots complètent.", 13, C.sub, 3)
	local group = ctx.friends == true and ctx.party.id ~= nil
	local sel = (if group then "Avec ton groupe" else "En ligne") .. " · " .. modeName(ctx.play.mode) .. " · " .. (Modes.MAP[ctx.play.map] and Modes.MAP[ctx.play.map].n or "")
	local play = K.btn(hero, "", "primary", function() ctx.startPlay() end, { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 92), Name = "HeroPlay" })
	text(play, { Text = "▶  " .. spaced("JOUER", 3), Font = K.BLACK, TextSize = 30, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 16),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = play.ZIndex + 1 })
	text(play, { Text = spaced(sel, 1), Font = K.BOLD, TextSize = 11, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 60),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTransparency = 0.15, ZIndex = play.ZIndex + 1 })
	K.cut(play, 14, if hw then K.rgb(0x170f1d) else K.rgb(0x111a2b))
	K.shine(play, 2.4, 0.25)   -- reflet qui revient sur JOUER (.hero::after et playglow du web)
	local row = make("Frame", { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 46) }, hero)
	local q = K.btn(row, "⚡  " .. spaced("PARTIE RAPIDE", 1), "alt", function() ctx.quick(nil) end, { Size = UDim2.new(0.5, -5, 1, 0), TextSize = 14 })
	local fr = K.btn(row, "👥  " .. spaced("AVEC DES AMIS", 1), "alt", function() ctx.friends = true; ctx.go("play") end,
		{ Size = UDim2.new(0.5, -5, 1, 0), Position = UDim2.new(0.5, 5, 0, 0), TextSize = 14 })
	K.cut(q, 10, K.rgb(0x111a2b)); K.cut(fr, 10, K.rgb(0x111a2b))
	local ch = K.btn(hero, "▸  " .. spaced("CHOISIR LE MODE ET LA CARTE", 1), "ghost", function() ctx.friends = false; ctx.go("play") end,
		{ LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 34), TextSize = 11, TextColor3 = C.sub })
	K.cut(ch, 8, K.rgb(0x0f1626))

	-- saison + bonus du jour (.lmini)
	local mini = make("Frame", { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 132) }, cols[1])
	local bp = profile and profile.bp
	local tier = if bp then math.min(X.SEASON.tiers, math.floor((bp.xp or 0) / X.SEASON.xpPerTier)) else 0
	local pc = if bp then math.floor(((bp.xp or 0) % X.SEASON.xpPerTier) / X.SEASON.xpPerTier * 100) else 0
	local sc = K.card(mini, { Size = UDim2.new(0.5, -7, 1, 0), AutomaticSize = Enum.AutomaticSize.None }, function() ctx.openPass() end)
	K.vlist(sc, 8)
	K.h4(sc, "★ " .. string.upper(X.SEASON.name), nil, 1)
	text(sc, { LayoutOrder = 2, Font = K.BLACK, TextSize = 24, Size = UDim2.new(1, 0, 0, 28), TextWrapped = false,
		Text = "Palier " .. tier .. ' <font size="13" color="#8da0bd">/ ' .. X.SEASON.tiers .. "</font>" })
	K.bar(sc, pc / 100, { LayoutOrder = 3 })
	text(sc, { LayoutOrder = 4, TextSize = 11, TextColor3 = C.dim, Text = pc .. " % vers le palier suivant · voir le passe ›", Size = UDim2.new(1, 0, 0, 14) })
	local ds = d and d.daily
	local day = if ds then ds.day else 1
	local gc = K.card(mini, { Size = UDim2.new(0.5, -7, 1, 0), Position = UDim2.new(0.5, 7, 0, 0), AutomaticSize = Enum.AutomaticSize.None }, function() ctx.claimDaily() end)
	K.vlist(gc, 8)
	K.h4(gc, "📅 BONUS DU JOUR", nil, 1)
	text(gc, { LayoutOrder = 2, Font = K.BLACK, TextSize = 24, Size = UDim2.new(1, 0, 0, 28), TextWrapped = false,
		Text = "Jour " .. day .. ' <font size="13" color="#8da0bd">/ 7</font>' })
	K.bar(gc, (if ds and ds.canClaim then day - 1 else day) / 7, { LayoutOrder = 3 })
	if ds and ds.canClaim then
		K.btn(gc, spaced("RÉCUPÉRER", 1), "gold", function() ctx.claimDaily() end, { LayoutOrder = 4, Size = UDim2.fromOffset(110, 24), TextSize = 10 })
	else
		text(gc, { LayoutOrder = 4, TextSize = 11, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 14),
			Text = "Série de " .. (if ds then ds.streak else 0) .. " jour" .. (if ds and ds.streak > 1 then "s" else "") .. " · reviens demain" })
	end

	-- ============ colonne 2 : défis ============
	local dc = K.card(cols[2], { LayoutOrder = 3 })
	K.vlist(dc, 8)
	K.h4(dc, "🎯 DÉFIS DU JOUR", "nouveaux dans " .. untilMidnight(), 0)
	for i, m in ipairs(ctx.ch and ctx.ch.daily or profile and profile.missions and profile.missions.list or {}) do mission(ctx, dc, m, i, false) end
	if not profile then K.para(dc, "Chargement du profil…", 12, C.dim, 1) end
	local wc = K.card(cols[2], { LayoutOrder = 4 })
	K.vlist(wc, 8)
	K.h4(wc, "🏆 DÉFIS DE LA SEMAINE", "nouveaux dans " .. weekLeft(), 0)
	for i, m in ipairs(ctx.ch and ctx.ch.weekly or profile and profile.wmis and profile.wmis.list or {}) do mission(ctx, wc, m, i, true) end

	-- ============ colonne 3 : cadeaux et Premium, nouveautés, puis le reste (codes, communauté) ============
	-- cadeaux de fidélité et Premium (.lmini du web, 8W_loyalty) : la carte des cadeaux brille quand il y en a à ouvrir
	-- (les boutons CADEAUX / PREMIUM de l'en-tête restent, visibles sur toutes les pages)
	local loy = ctx.loy
	local lp = if loy and loy.pending then #loy.pending else 0
	local lm = make("Frame", { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 118) }, cols[3])
	local gcard = K.card(lm, { Size = UDim2.new(0.5, -7, 1, 0), AutomaticSize = Enum.AutomaticSize.None }, function() ctx.panel("gifts") end)
	K.vlist(gcard, 6)
	K.h4(gcard, "🎁 CADEAUX", nil, 1)
	text(gcard, { LayoutOrder = 2, Font = K.BLACK, TextSize = 22, Size = UDim2.new(1, 0, 0, 26), TextWrapped = false,
		Text = if lp > 0 then lp .. ' <font size="12" color="#8da0bd">à récupérer</font>' else "✅" })
	if lp > 0 then
		local st = gcard:FindFirstChildOfClass("UIStroke")
		if st then st.Color = C.gold; st.Transparency = 0.35 end
		K.btn(gcard, spaced("OUVRIR", 1), "gold", function() ctx.panel("gifts") end, { LayoutOrder = 3, Size = UDim2.fromOffset(96, 24), TextSize = 10 })
		K.shine(gcard, 2.6, 0.18)
	else
		text(gcard, { LayoutOrder = 3, TextSize = 11, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 28), Text = "Plus tu joues, plus tu gagnes" })
	end
	local vip = loy ~= nil and loy.vip == true
	local vcard = K.card(lm, { Size = UDim2.new(0.5, -7, 1, 0), Position = UDim2.new(0.5, 7, 0, 0), AutomaticSize = Enum.AutomaticSize.None },
		function() ctx.panel("vip") end)
	K.vlist(vcard, 6)
	local vst = vcard:FindFirstChildOfClass("UIStroke"); if vst then vst.Color = C.gold; vst.Transparency = 0.65 end
	K.h4(vcard, "👑 PREMIUM", nil, 1)
	text(vcard, { LayoutOrder = 2, Font = K.BLACK, TextSize = 22, Size = UDim2.new(1, 0, 0, 26), TextWrapped = false, TextColor3 = C.gold,
		Text = if vip then "Actif" .. (if loy.vipDaysLeft then ' <font size="12" color="#8da0bd">· ' .. tostring(loy.vipDaysLeft) .. " j</font>" else "") else "Découvrir" })
	text(vcard, { LayoutOrder = 3, TextSize = 11, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 28), Text = "Récompenses et pseudo en couleur" })
	local nc = K.card(cols[3], { LayoutOrder = 6 })
	K.vlist(nc, 0)
	K.h4(nc, "📰 NOUVEAUTÉS", nil, 0)
	for i, n in ipairs(MenuConfig.NEWS) do
		local go = n.go
		local item = make(if go then "TextButton" else "Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = i,
			BackgroundTransparency = 1, BackgroundColor3 = C.white }, nc)
		if go then
			(item :: any).Text = ""; (item :: any).AutoButtonColor = false
			item.MouseEnter:Connect(function() item.BackgroundTransparency = 0.97 end)
			item.MouseLeave:Connect(function() item.BackgroundTransparency = 1 end)
			;(item :: any).Activated:Connect(function()
				if go == "friends" then ctx.friends = true; ctx.go("play")
				elseif go == "play" then ctx.friends = false; ctx.go("play")
				elseif go == "boxes" then ctx.go("arsenal", "Caisses")
				elseif go == "arms" then ctx.go("arsenal", "Armes")
				elseif go == "stats" then ctx.go("profile", "Statistiques")   -- maîtrise d'arme
				elseif go == "style" then ctx.go("profile", "Style")          -- carte de joueur
				elseif string.sub(go, 1, 5) == "mode:" then
					ctx.play = Modes.sanitize({ mode = string.sub(go, 6), diff = ctx.play.diff }); ctx.save("play"); ctx.go("play")
				end
			end)
		end
		K.corner(item, 8); K.pad(item, 4, 10)
		local ic = text(item, { Text = n.ic, TextSize = 20, Size = UDim2.fromOffset(34, 34), BackgroundTransparency = 0.95, BackgroundColor3 = C.white,
			TextXAlignment = Enum.TextXAlignment.Center })
		K.corner(ic, 9)
		local tx = make("Frame", { Position = UDim2.fromOffset(46, 0), Size = UDim2.new(1, -46, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, item)
		K.vlist(tx, 3)
		text(tx, { LayoutOrder = 1, Font = K.BLACK, TextSize = 13, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y,
			Text = n.t .. (if ctx.newsSeen then "" else '  <font size="9" color="#ff4655">' .. spaced("NOUVEAU", 1) .. "</font>") })
		K.para(tx, n.d, 11, C.dim, 2)
		if i < #MenuConfig.NEWS then
			make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, 10), Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0.95,
				BackgroundColor3 = C.white }, item)
		end
	end

	-- plus : ce qui sert rarement (avant, seulement dans les boutons du lobby, menu fermé)
	local more = K.card(cols[3], { LayoutOrder = 7 })
	K.vlist(more, 8)
	K.h4(more, "➕ PLUS", nil, 0)
	K.btn(more, "🎟  Codes promo", "alt", function() ctx.panel("codes") end, { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 34), TextSize = 13 })
	K.btn(more, "🤝  Communauté Roblox du jeu", "alt", function() ctx.panel("group") end, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 34), TextSize = 13 })
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="821">
          <Properties>
            <string name="Name">Kit</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Kit (ModuleScript, client)
-- Petits outils d'interface du menu principal, avec la présentation du jeu web (src/00_head.html, src/87d_lobby.js) :
-- palette, cartes « lcard », boutons rouges en dégradé, pastilles, jauges, curseurs, lettres espacées (letter-spacing).
local TweenService = game:GetService("TweenService")
local MenuConfig = require(game:GetService("ReplicatedStorage").Shared.MenuConfig)
local Icons = require(game:GetService("ReplicatedStorage").Shared.Icons)

local K = {}

local function rgb(h: number): Color3
	return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255))
end
K.rgb = rgb

-- palette du web (:root et styles du menu)
K.C = {
	bg = rgb(0x0b1018), panel = rgb(0x141c2c), card = rgb(0x0f1726), card2 = rgb(0x152036), deep = rgb(0x0b111c), navy = rgb(0x1a2438),
	text = rgb(0xe8eef9), white = Color3.new(1, 1, 1), dim = rgb(0x8da0bd), sub = rgb(0xb8c5da), mute = rgb(0x6f819e),
	accent = rgb(0xff4655), accent2 = rgb(0xff6b5a), accentDark = rgb(0xd8323f), gold = rgb(0xffd23a), green = rgb(0x7dff9f),
	blue = rgb(0x4aa3ff), blueDark = rgb(0x2c7fe0), purple = rgb(0x8a5bff), violet = rgb(0xc77dff), orange = rgb(0xff7a1a), pumpkin = rgb(0xffae5a),
	ink = rgb(0x111111),
}
local C = K.C
K.BLACK = Enum.Font.GothamBlack
K.BOLD = Enum.Font.GothamBold
K.MED = Enum.Font.GothamMedium

function K.make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		o.Font = K.BOLD; o.TextColor3 = C.text; o.TextSize = 14; o.RichText = true
		if class == "TextLabel" then o.BackgroundTransparency = 1 end
		if class == "TextButton" then o.AutoButtonColor = false end
	end
	if class == "Frame" or class == "ScrollingFrame" then o.BackgroundTransparency = 1 end
	for k, v in pairs(props) do o[k] = v end
	if parent then o.Parent = parent end
	return o
end
local make = K.make

function K.corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
function K.stroke(o: Instance, color: Color3?, th: number?, tr: number?): UIStroke
	return make("UIStroke", { Color = color or C.white, Thickness = th or 1, Transparency = tr or 0.92, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
function K.pad(o: Instance, l: number, t: number?, r: number?, b: number?)
	make("UIPadding", { PaddingLeft = UDim.new(0, l), PaddingTop = UDim.new(0, t or l), PaddingRight = UDim.new(0, r or l), PaddingBottom = UDim.new(0, b or t or l) }, o)
end
function K.vlist(o: Instance, gap: number?, align: Enum.HorizontalAlignment?): UIListLayout
	return make("UIListLayout", { Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder, HorizontalAlignment = align or Enum.HorizontalAlignment.Left }, o)
end
function K.hlist(o: Instance, gap: number?, valign: Enum.VerticalAlignment?, wraps: boolean?): UIListLayout
	return make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, gap or 8), SortOrder = Enum.SortOrder.LayoutOrder,
		VerticalAlignment = valign or Enum.VerticalAlignment.Center, Wraps = wraps == true }, o)
end
function K.grid(o: Instance, cell: UDim2, gap: number?): UIGridLayout
	return make("UIGridLayout", { CellSize = cell, CellPadding = UDim2.fromOffset(gap or 10, gap or 10), SortOrder = Enum.SortOrder.LayoutOrder }, o)
end
function K.gradient(o: Instance, a: Color3, b: Color3, rot: number?, ta: number?, tb: number?): UIGradient
	return make("UIGradient", { Color = ColorSequence.new(a, b), Rotation = rot or 90, Transparency = NumberSequence.new(ta or 0, tb or ta or 0) }, o)
end
function K.tween(o: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?): Tween
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end

-- ---------- effets (src/8A_juice.js, src/87d_lobby.js) : survol, clic, brillance, apparition ----------
local Sfx = require(game:GetService("ReplicatedStorage").Shared.Sfx)
local lastHover = 0
-- son d'interface (sfxUI du web) : plus discret au survol, et pas plus d'un toutes les 70 ms
function K.uiSound(hover: boolean?)
	local now = os.clock()
	if hover then
		if now - lastHover < 0.07 then return end
		lastHover = now
	end
	pcall(Sfx.play, "ui", nil, if hover then 0.3 else 0.8)
end
-- UIScale des effets (un seul par objet : survol, clic et apparition se le partagent), créé au premier besoin
function K.fxScale(o: Instance): UIScale
	local s = o:FindFirstChild("FxScale")
	if s and s:IsA("UIScale") then return s end
	return make("UIScale", { Name = "FxScale" }, o)
end
-- dans une liste ou une grille, un objet qui grossit pousse ses voisins : on grossit deux fois moins
local function inLayout(o: Instance): boolean
	local p = o.Parent
	return p ~= nil and p:FindFirstChildWhichIsA("UIGridStyleLayout") ~= nil
end
-- reflet qui traverse l'objet (.btn::after et .hero::after du web) : bande blanche en dégradé, dans un cadre qui la coupe.
-- Le dégradé est sur la bande, jamais sur un bouton qui porte son texte (il le teinterait aussi).
-- every = nil : un seul passage (survol) ; sinon recommence toutes les « every » secondes
function K.shine(o: GuiObject, every: number?, strength: number?)
	if o:FindFirstChildWhichIsA("UIGridStyleLayout") then return end   -- le cadre du reflet prendrait une place dans la liste
	-- taille automatique : la bande qui sort à droite agrandissait le bouton à chaque passage (onglet JOUER étiré sur toute la barre)
	if o.AutomaticSize ~= Enum.AutomaticSize.None then return end
	local holder = o:FindFirstChild("Shine")
	local band: Frame
	if holder and holder:FindFirstChild("Band") then
		band = (holder :: any).Band
	else
		holder = make("Frame", { Name = "Shine", Size = UDim2.fromScale(1, 1), ClipsDescendants = true, ZIndex = o.ZIndex + 1, Active = false }, o)
		band = make("Frame", { Name = "Band", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(-0.6, 0.5), Size = UDim2.fromScale(0.5, 1.6),
			BackgroundTransparency = 0, BackgroundColor3 = C.white, ZIndex = o.ZIndex + 1, Rotation = 12, Active = false }, holder)
		local a = 1 - (strength or 0.22)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, a), NumberSequenceKeypoint.new(1, 1) }) }, band)
	end
	local h = holder :: Instance
	if not every and h:GetAttribute("Loop") then return end   -- le reflet tourne déjà en boucle
	band.Position = UDim2.fromScale(-0.6, 0.5)
	if every then
		h:SetAttribute("Loop", true)
		TweenService:Create(band, TweenInfo.new(1.6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, every), { Position = UDim2.fromScale(1.1, 0.5) }):Play()
	else
		K.tween(band, 0.6, { Position = UDim2.fromScale(1.1, 0.5) }, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut)
	end
end
-- battement (pastilles .ndot du web : scale 1,18 toutes les 1,6 s)
function K.beat(o: GuiObject, to: number?, period: number?)
	TweenService:Create(K.fxScale(o), TweenInfo.new((period or 1.6) / 2, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, true), { Scale = to or 1.18 }):Play()
end
-- survol / sélection manette : léger agrandissement, lueur du bord, son ; clic : enfoncement puis rebond
function K.juice(b: GuiButton, grow: number?, shine: boolean?)
	local g = grow or 0.04
	local hovered = false
	local function target(): number
		if not hovered then return 1 end
		return 1 + (if inLayout(b) then g * 0.5 else g)
	end
	local function glow(on: boolean)
		local st = b:FindFirstChildOfClass("UIStroke")
		if st and st.Name == "Pulse" then return end
		if not st then
			if not on or b:FindFirstChild("Cut") then return end   -- coins coupés : un bord dessinerait les coins carrés
			local base = b:GetAttribute("BaseColor")
			st = make("UIStroke", { Name = "Glow", Thickness = 1.5, Transparency = 1, ApplyStrokeMode = Enum.ApplyStrokeMode.Border,
				Color = if typeof(base) == "Color3" then base:Lerp(C.white, 0.45) else C.white }, b)
		end
		local s = st :: UIStroke
		if s:GetAttribute("BaseT") == nil then s:SetAttribute("BaseT", s.Transparency) end
		local baseT = s:GetAttribute("BaseT") :: number
		K.tween(s, 0.16, { Transparency = if on then math.min(baseT, 1) - (if s.Name == "Glow" then 0.6 else math.min(0.35, baseT * 0.5)) else baseT })
	end
	local function hover(on: boolean)
		if hovered == on then return end
		hovered = on
		K.tween(K.fxScale(b), 0.16, { Scale = target() }, if on then Enum.EasingStyle.Back else Enum.EasingStyle.Quad)
		glow(on)
		if on then
			K.uiSound(true)
			if shine then K.shine(b) end
		end
	end
	b.MouseEnter:Connect(function() hover(true) end)
	b.MouseLeave:Connect(function() hover(false) end)
	b.SelectionGained:Connect(function() hover(true) end)
	b.SelectionLost:Connect(function() hover(false) end)
	b.MouseButton1Down:Connect(function() K.tween(K.fxScale(b), 0.06, { Scale = 0.95 }) end)
	b.MouseButton1Up:Connect(function() K.tween(K.fxScale(b), 0.22, { Scale = target() }, Enum.EasingStyle.Back) end)
	b.Activated:Connect(function()
		K.uiSound(false)
		-- manette / tactile : pas de MouseButton1Down, on rejoue l'enfoncement ici
		local s = K.fxScale(b)
		if s.Scale > 0.97 then
			s.Scale = 0.95
			K.tween(s, 0.22, { Scale = target() }, Enum.EasingStyle.Back)
		end
	end)
end
-- ---------- fenêtres par-dessus le menu (passe, calendrier, boutique, cadeaux, Premium) ----------
-- « Retour » partout : B (manette), Échap ou Retour arrière ferme la fenêtre du dessus avant le menu (qui écoute B à
-- une priorité plus basse) ; à la manette, la sélection entre dans la fenêtre à l'ouverture et revient où elle était
-- à la fermeture. o = la ScreenGui (propriété Enabled) ou le cadre (Visible) qui montre la fenêtre ; first = le bouton
-- sélectionné à l'ouverture (manette).
local overlays: { { o: Instance, close: () -> (), prev: GuiObject? } } = {}
local function overlayBack(_: string, st: Enum.UserInputState): Enum.ContextActionResult
	local top = overlays[#overlays]
	if not top then return Enum.ContextActionResult.Pass end
	if st == Enum.UserInputState.Begin then task.spawn(top.close) end
	return Enum.ContextActionResult.Sink
end
function K.overlay(o: Instance, close: () -> (), first: (() -> GuiObject?)?)
	local CAS = game:GetService("ContextActionService")
	local GuiService = game:GetService("GuiService")
	local UIS = game:GetService("UserInputService")
	local prop = if o:IsA("ScreenGui") then "Enabled" else "Visible"
	local function sync()
		local idx: number? = nil
		for i, e in ipairs(overlays) do if e.o == o then idx = i end end
		local shown = (o :: any)[prop] == true
		if shown and not idx then
			table.insert(overlays, { o = o, close = close, prev = GuiService.SelectedObject })
			CAS:BindActionAtPriority("MenuOverlayBack", overlayBack, false, 3100, Enum.KeyCode.ButtonB, Enum.KeyCode.Escape, Enum.KeyCode.Backspace)
			if first and UIS.GamepadEnabled then
				task.defer(function()
					local f = first()
					if f and (o :: any)[prop] == true then GuiService.SelectedObject = f end
				end)
			end
		elseif not shown and idx then
			local e = table.remove(overlays, idx)
			local sel = GuiService.SelectedObject
			if sel and sel:IsDescendantOf(o) then
				local prev = e and e.prev
				GuiService.SelectedObject = if prev and prev.Parent and prev.Visible then prev else nil
			end
			if #overlays == 0 then CAS:UnbindAction("MenuOverlayBack") end
		end
	end
	o:GetPropertyChangedSignal(prop):Connect(sync)
	sync()
end
-- une fenêtre est ouverte par-dessus le menu (le menu ne répond pas à « retour » pendant ce temps)
function K.overlayOpen(): boolean return #overlays > 0 end

-- apparition en cascade (lcIn du web : chaque carte arrive avec un léger décalage) : les cartes de la page grossissent
-- de 0,94 à 1 l'une après l'autre, de haut en bas puis de gauche à droite
function K.cascade(root: Instance, max: number?)
	local found: { GuiObject } = {}
	local function walk(o: Instance, depth: number)
		for _, c in ipairs(o:GetChildren()) do
			if #found >= (max or 14) then return end
			if c:IsA("GuiObject") and c.Visible then
				local isCard = (c:IsA("Frame") or c:IsA("TextButton")) and c:FindFirstChildOfClass("UICorner") ~= nil
					and c.AbsoluteSize.X >= 140 and c.AbsoluteSize.Y >= 56
				if isCard then table.insert(found, c)
				elseif depth < 5 then walk(c, depth + 1) end
			end
		end
	end
	walk(root, 0)
	table.sort(found, function(a, b)
		local pa, pb = a.AbsolutePosition, b.AbsolutePosition
		if math.abs(pa.Y - pb.Y) > 8 then return pa.Y < pb.Y end
		return pa.X < pb.X
	end)
	for i, c in ipairs(found) do
		local s = K.fxScale(c)
		s.Scale = 0.94
		TweenService:Create(s, TweenInfo.new(0.42, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, (i - 1) * 0.045), { Scale = 1 }):Play()
	end
end

-- lettres espacées (letter-spacing du web), comme HudController. Entre deux lettres : espaces insécables (U+00A0, même
-- largeur qu'une espace) ; seules les vraies espaces entre les mots restent sécables : un titre trop long passe à la
-- ligne entre deux mots, plus au milieu d'un mot (« DÉSAMORÇA GE »).
local NBSP = utf8.char(0xA0)
function K.spaced(s: string, n: number?): string
	local gap = string.rep(NBSP, n or 1)
	local out = {}
	for _, cp in utf8.codes(s) do table.insert(out, utf8.char(cp)) end
	return table.concat(out, gap)
end
-- majuscules avec les accents (string.upper laisse « é » en minuscule : « GéNéRAL »)
local ACCENTS: { [string]: string } = { ["à"] = "À", ["â"] = "Â", ["ä"] = "Ä", ["ç"] = "Ç", ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["ë"] = "Ë",
	["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["ö"] = "Ö", ["ù"] = "Ù", ["û"] = "Û", ["ü"] = "Ü", ["œ"] = "Œ" }
function K.upper(s: string): string
	local out = string.upper(s)
	for lo, up in pairs(ACCENTS) do out = string.gsub(out, lo, up) end
	return out
end
-- texte qui doit tenir dans sa boîte (titres sur une ligne, noms de tuiles) : TextScaled borné entre min et max px.
-- Avec TextWrapped, Roblox ne coupe qu'entre les mots tant que le mot le plus long tient à la taille minimale.
function K.fit(o: TextLabel | TextButton, max: number, min: number?)
	local c = o:FindFirstChildOfClass("UITextSizeConstraint") or make("UITextSizeConstraint", {}, o)
	c.MaxTextSize = max; c.MinTextSize = min or 8
	local ob: any = o
	ob.TextScaled = true
end
-- texte sûr pour RichText
function K.esc(s: string): string
	return (string.gsub(string.gsub(string.gsub(s, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"))
end
function K.hex(c: Color3): string return "#" .. c:ToHex() end
function K.fmt(n: number): string   -- 12 500
	local s = tostring(math.floor(n))
	local out = string.reverse((string.gsub(string.reverse(s), "(%d%d%d)", "%1 ")))
	return (string.gsub(out, "^%s+", ""))
end

function K.clear(o: Instance)
	for _, c in ipairs(o:GetChildren()) do
		if c:IsA("GuiObject") then c:Destroy() end
	end
end

function K.text(parent: Instance?, props: { [string]: any }): TextLabel
	local base: { [string]: any } = { Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true }
	for k, v in pairs(props) do base[k] = v end
	return make("TextLabel", base, parent)
end
-- texte qui prend sa hauteur tout seul (paragraphes)
function K.para(parent: Instance?, text: string, size: number?, color: Color3?, order: number?): TextLabel
	return K.text(parent, { Text = text, TextSize = size or 13, TextColor3 = color or C.sub, Font = K.MED, AutomaticSize = Enum.AutomaticSize.Y,
		Size = UDim2.new(1, 0, 0, 0), LayoutOrder = order or 0, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.15 })
end

-- coins coupés (clip-path du web) : deux triangles de la couleur du fond posés sur les coins haut-droit et bas-gauche
function K.cut(o: GuiObject, size: number?, bg: Color3?)
	local s = size or 12
	for _, at in ipairs({ { 1, 0 }, { 0, 1 } }) do
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(at[1], at[2]), Size = UDim2.fromOffset(s * 1.42, s * 1.42),
			Rotation = 45, BackgroundColor3 = bg or C.bg, BackgroundTransparency = 0, ZIndex = o.ZIndex + 2, Name = "Cut" }, o)
		f.Active = false
	end
end

-- carte du menu (.lcard) : dégradé bleu nuit translucide, bord blanc à 8 %, coins arrondis
-- onClick : la carte entière devient un bouton (cartes cliquables de l'accueil)
function K.card(parent: Instance?, props: { [string]: any }?, onClick: (() -> ())?): Frame
	local f = make(if onClick then "TextButton" else "Frame", { BackgroundTransparency = 0, BackgroundColor3 = C.white, Size = UDim2.new(1, 0, 0, 0),
		AutomaticSize = Enum.AutomaticSize.Y }, parent)
	K.gradient(f, rgb(0x121b2c), rgb(0x0b111c), 90, 0.13, 0.2)
	K.corner(f, 14); K.stroke(f)
	if onClick then
		(f :: any).Text = ""; (f :: any).Selectable = true
		-- carte cliquable : elle grossit un peu et son bord s'éclaire au survol (.mcard:hover du web)
		K.juice(f :: any, 0.02);
		(f :: any).Activated:Connect(onClick)
	end
	K.pad(f, 18, 16)
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f
end
-- titre de carte (.lcard h4) : icône + lettres espacées, petit texte à droite
-- Le titre tient sur une ligne : il rapetisse (jusqu'à 8 px) plutôt que d'être coupé ; le petit texte de droite a sa
-- place à lui (« Small », 110 px) au lieu de passer sous le titre.
function K.h4(parent: Instance, title: string, small: string?, order: number?, color: Color3?): Frame
	local row = make("Frame", { Size = UDim2.new(1, 0, 0, 20), LayoutOrder = order or 0 }, parent)
	local t = K.text(row, { Name = "Title", Text = K.spaced(title, if small then 1 else 2), Font = K.BLACK, TextSize = 12, TextColor3 = color or C.white,
		Size = UDim2.new(1, if small then -118 else 0, 1, 0), TextWrapped = false })
	K.fit(t, 12, 8)
	if small then
		K.text(row, { Name = "Small", Text = small, TextSize = 11, TextColor3 = C.dim, AnchorPoint = Vector2.new(1, 0), Size = UDim2.new(0, 110, 1, 0),
			Position = UDim2.fromScale(1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	end
	return row
end
-- petit titre de section (« DIFFICULTÉ », « JOUEURS »)
function K.label(parent: Instance, title: string, order: number?, color: Color3?): TextLabel
	local t = K.text(parent, { Text = K.spaced(title, 2), Font = K.BLACK, TextSize = 11, TextColor3 = color or C.white, LayoutOrder = order or 0,
		Size = UDim2.new(1, 0, 0, 18), TextWrapped = false })
	K.fit(t, 11, 8)
	return t
end

-- jauge (.lbar) : fond blanc à 7 %, remplissage dégradé rouge -> or
function K.bar(parent: Instance, frac: number, props: { [string]: any }?, a: Color3?, b: Color3?): Frame
	local back = make("Frame", { Size = UDim2.new(1, 0, 0, 6), BackgroundTransparency = 0.93, BackgroundColor3 = C.white }, parent)
	K.corner(back, 3)
	local fill = make("Frame", { Size = UDim2.fromScale(math.clamp(frac, 0, 1), 1), BackgroundTransparency = 0, BackgroundColor3 = C.white, Name = "Fill" }, back)
	K.corner(fill, 3); K.gradient(fill, a or C.accent, b or C.gold, 0)
	if props then for k, v in pairs(props) do (back :: any)[k] = v end end
	return back
end

-- boutons. kind : "primary" (rouge), "alt" (bleu nuit), "ghost" (transparent), "gold", "white", "blue", "purple"
export type BtnKind = string
local KINDS: { [string]: { Color3 | number } } = {
	primary = { rgb(0xff4655), rgb(0xd8323f), 0 }, alt = { rgb(0x1e2a42), rgb(0x16203a), 0 }, ghost = { rgb(0x0f1726), rgb(0x0b111c), 0.3 },
	gold = { rgb(0xffd23a), rgb(0xffb300), 0 }, white = { rgb(0xffffff), rgb(0xe8eef9), 0 }, blue = { rgb(0x4aa3ff), rgb(0x2c7fe0), 0 },
	purple = { rgb(0x7a3dff), rgb(0x5a2bd6), 0 }, green = { rgb(0x2fd27a), rgb(0x1fa35e), 0 }, dark = { rgb(0x0b111c), rgb(0x0b111c), 0.2 },
}
-- Fond uni (milieu du dégradé du web) : un UIGradient sur un bouton teinte aussi son texte, ce qui rendait
-- les libellés invisibles (texte rouge sur fond rouge).
local function kindColor(k: { any }): Color3 return (k[1] :: Color3):Lerp(k[2] :: Color3, 0.5) end
function K.btn(parent: Instance?, text: string, kind: BtnKind?, cb: (() -> ())?, props: { [string]: any }?): TextButton
	local k = KINDS[kind or "alt"] or KINDS.alt
	local dark = kind == "gold" or kind == "white"
	local b = make("TextButton", { Text = text, Font = K.BLACK, TextSize = 14, BackgroundColor3 = kindColor(k), BackgroundTransparency = k[3] :: number,
		TextColor3 = if dark then rgb(0x111111) else C.white, Size = UDim2.fromOffset(160, 40), Selectable = true }, parent)
	K.corner(b, 8)
	if kind == "ghost" or kind == "alt" or kind == "dark" then K.stroke(b, C.white, 1, 0.9) end
	if props then for key, v in pairs(props) do (b :: any)[key] = v end end
	b:SetAttribute("BaseColor", b.BackgroundColor3)
	-- bouton de taille fixe : le libellé rapetisse (jusqu'à 9 px) au lieu de déborder sur ses voisins ; il garde sa taille
	-- quand il tient (TextScaled plafonné à TextSize). Pas pour les boutons à taille automatique (ils suivent leur texte).
	if b.AutomaticSize == Enum.AutomaticSize.None and b.Text ~= "" then K.fit(b, b.TextSize, math.min(9, b.TextSize)) end
	-- bouton de fermeture : la croix U+2715 donne un carré vide dans les polices Roblox, on la dessine (Shared/Icons)
	if text == "✕" then Icons.closeButton(b, 16, b.TextColor3) end
	-- survol / sélection manette : éclaircit un peu (filter:brightness du web)
	-- (un bouton transparent, comme les onglets de la navigation, prend un léger fond au survol)
	local baseT = b.BackgroundTransparency
	local function hi(on: boolean)
		local base = b:GetAttribute("BaseColor")
		if typeof(base) == "Color3" then K.tween(b, 0.12, { BackgroundColor3 = if on then base:Lerp(C.white, 0.12) else base }) end
		if baseT >= 0.95 then K.tween(b, 0.12, { BackgroundTransparency = if on then 0.9 else baseT }) end
	end
	b.MouseEnter:Connect(function() hi(true) end)
	b.MouseLeave:Connect(function() hi(false) end)
	b.SelectionGained:Connect(function() hi(true) end)
	b.SelectionLost:Connect(function() hi(false) end)
	-- agrandissement, lueur, son ; reflet qui traverse les boutons pleins (rouge, or, bleu…)
	K.juice(b, 0.04, k[3] == 0 and kind ~= "alt" and kind ~= "white")
	if cb then b.Activated:Connect(cb) end
	return b
end
-- change la couleur de fond d'un bouton K.btn (garde l'effet de survol)
function K.setBtnColor(b: GuiObject, c: Color3)
	b:SetAttribute("BaseColor", c); b.BackgroundColor3 = c
end
function K.setKind(b: TextButton, kind: BtnKind)
	local k = KINDS[kind] or KINDS.alt
	K.setBtnColor(b, kindColor(k))
	b.BackgroundTransparency = k[3] :: number
	b.TextColor3 = if kind == "gold" or kind == "white" then rgb(0x111111) else C.white
end

-- pastille / puce (chip) : on = fond coloré
function K.chip(parent: Instance?, text: string, on: boolean, cb: (() -> ())?, props: { [string]: any }?, onColor: Color3?): TextButton
	local b = make("TextButton", { Text = text, Font = K.BOLD, TextSize = 13, AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 36),
		BackgroundTransparency = if on then 0 else 0.25, BackgroundColor3 = if on then (onColor or C.accent) else C.navy, TextColor3 = C.white, Selectable = true }, parent)
	K.corner(b, 6); K.pad(b, 14, 0)
	-- puce choisie : lueur de sa couleur (.chip.on du web) ; les autres : bord fin qui s'éclaire au survol
	if on then K.stroke(b, (onColor or C.accent):Lerp(C.white, 0.35), 1.5, 0.45) else K.stroke(b, C.white, 1, 0.92) end
	if props then for k, v in pairs(props) do (b :: any)[k] = v end end
	K.juice(b, 0.05)
	if cb then b.Activated:Connect(cb) end
	return b
end

-- curseur (input range du web) : rail fin, partie gauche rouge, rond blanc ; manette : gauche / droite quand il est sélectionné
function K.slider(parent: Instance, title: string, min: number, max: number, step: number, value: number, fmt: (number) -> string,
	onChange: (number) -> (), order: number?): Frame
	local UIS = game:GetService("UserInputService")
	local box = make("Frame", { Size = UDim2.new(1, 0, 0, 44), LayoutOrder = order or 0 }, parent)
	local head = K.text(box, { Text = "", Font = K.BLACK, TextSize = 11, Size = UDim2.new(1, 0, 0, 16), TextWrapped = false })
	local rail = make("TextButton", { Text = "", Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 6), BackgroundTransparency = 0.85,
		BackgroundColor3 = C.white, Selectable = true, AutoButtonColor = false }, box)
	K.corner(rail, 3)
	local fill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundTransparency = 0, BackgroundColor3 = C.accent }, rail)
	K.corner(fill, 3)
	local knob = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0, 0.5), Size = UDim2.fromOffset(16, 16),
		BackgroundTransparency = 0, BackgroundColor3 = C.white, ZIndex = rail.ZIndex + 1 }, rail)
	K.corner(knob, 8); K.stroke(knob, C.accent, 2, 0)
	local v = value
	local function show()
		local f = (v - min) / (max - min)
		fill.Size = UDim2.fromScale(f, 1); knob.Position = UDim2.fromScale(f, 0.5)
		head.Text = K.spaced(title, 2) .. "   " .. fmt(v)
	end
	local function set(nv: number)
		nv = math.clamp(math.floor((nv - min) / step + 0.5) * step + min, min, max)
		if math.abs(nv - v) < 1e-6 then return end
		v = nv; show(); onChange(v)
	end
	local dragging = false
	local function fromX(x: number)
		local a, w = rail.AbsolutePosition.X, rail.AbsoluteSize.X
		if w > 0 then set(min + (max - min) * math.clamp((x - a) / w, 0, 1)) end
	end
	rail.InputBegan:Connect(function(i: InputObject)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = true; fromX(i.Position.X) end
	end)
	local conns: { RBXScriptConnection } = {}
	table.insert(conns, UIS.InputChanged:Connect(function(i: InputObject)
		if dragging and (i.UserInputType == Enum.UserInputType.MouseMovement or i.UserInputType == Enum.UserInputType.Touch) then fromX(i.Position.X) end
	end))
	table.insert(conns, UIS.InputEnded:Connect(function(i: InputObject)
		if i.UserInputType == Enum.UserInputType.MouseButton1 or i.UserInputType == Enum.UserInputType.Touch then dragging = false end
	end))
	-- manette : la croix gauche / droite règle le curseur sélectionné
	rail.SelectionBehaviorLeft = Enum.SelectionBehavior.Stop; rail.SelectionBehaviorRight = Enum.SelectionBehavior.Stop
	table.insert(conns, UIS.InputBegan:Connect(function(i: InputObject)
		if game:GetService("GuiService").SelectedObject ~= rail then return end
		if i.KeyCode == Enum.KeyCode.DPadLeft or i.KeyCode == Enum.KeyCode.Left then set(v - step)
		elseif i.KeyCode == Enum.KeyCode.DPadRight or i.KeyCode == Enum.KeyCode.Right then set(v + step) end
	end))
	box.Destroying:Connect(function() for _, c in ipairs(conns) do c:Disconnect() end end)
	show()
	return box
end

-- défilement vertical (les colonnes du web ont overflow:auto)
function K.scroll(parent: Instance?, props: { [string]: any }?): ScrollingFrame
	local s = make("ScrollingFrame", { Size = UDim2.fromScale(1, 1), CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
		ScrollBarThickness = 4, ScrollBarImageColor3 = C.white, ScrollBarImageTransparency = 0.8, ScrollingDirection = Enum.ScrollingDirection.Y,
		ElasticBehavior = Enum.ElasticBehavior.WhenScrollable, Selectable = false }, parent)
	if props then for k, v in pairs(props) do (s :: any)[k] = v end end
	return s
end

-- icône ronde du niveau (le rond doré du profil)
function K.levelBadge(parent: Instance, level: number, size: number): Frame
	local f = make("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 0, BackgroundColor3 = C.white }, parent)
	K.corner(f, size // 2); K.gradient(f, rgb(0xffd23a), rgb(0xff8a1a), 135)
	K.text(f, { Text = tostring(level), Font = K.BLACK, TextSize = math.floor(size * 0.45), TextColor3 = rgb(0x2a1a00), Size = UDim2.fromScale(1, 1),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false })
	return f
end

-- rareté (Config.RARITY) -> couleur
function K.rarityColor(r: number): Color3
	return ({ rgb(0x9aa6b8), rgb(0x4aa3ff), rgb(0xb36bff), rgb(0xffb938), rgb(0xff3df0) })[r] or rgb(0x9aa6b8)
end

-- un défi (.lmis) : texte, bouton RÉCUPÉRER quand il est fini, jauge, progression et gains (Accueil et Profil)
function K.mission(ctx: any, parent: Instance, m: any, i: number, weekly: boolean)
	local f = K.make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = if m.done and not m.claimed then 0.92 else 0.97,
		BackgroundColor3 = if m.done and not m.claimed then C.gold else C.white, LayoutOrder = i }, parent)
	K.corner(f, 10); K.pad(f, 12, 10)
	K.stroke(f, if m.done and not m.claimed then C.gold else C.white, 1, if m.done and not m.claimed then 0.45 else 0.94)
	K.vlist(f, 6)
	local top = K.make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, f)
	K.text(top, { Text = m.text or MenuConfig.missionText(m.id, m.target, weekly), TextSize = 13, Font = K.MED, TextColor3 = if m.claimed then C.dim else C.text,
		Size = UDim2.new(1, -110, 0, 0), AutomaticSize = Enum.AutomaticSize.Y })
	if m.done and not m.claimed then
		K.btn(top, K.spaced("RÉCUPÉRER", 1), "gold", function()
			local res = ctx.call(if weekly then "ClaimWeekly" else "ClaimMission", m.index or i)
			if res then
				ctx.toast("✔ +" .. m.coins .. " 💰 · +" .. m.xp .. " XP", C.gold)
				pcall(function() (require :: any)(script.Parent:FindFirstChild("Fx")).reward(f, m.coins, m.xp) end)   -- confettis et pièces (Menu/Fx)
			end
			ctx.refresh()
		end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(104, 24), TextSize = 10 })
	elseif m.claimed then
		Icons.check(top, 18, C.green, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0) })   -- ✔ s'affiche en emoji gris
	end
	local bar = K.bar(f, m.progress / math.max(1, m.target), { LayoutOrder = 2 }, if m.claimed then C.green elseif weekly then C.purple else nil,
		if m.claimed then C.green elseif weekly then C.violet else nil)
	bar.Size = UDim2.new(1, 0, 0, 5)
	K.text(f, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 14), TextSize = 11, TextColor3 = C.dim, TextWrapped = false,
		Text = K.fmt(m.progress) .. " / " .. K.fmt(m.target) .. '  ·  <font color="#ffd23a">💰</font> ' .. m.coins .. "  ·  " .. m.xp .. " XP" })
	-- bouton CHANGER, défi d'arme, animations (Menu/Reroll)
	-- (chargé à la demande : Reroll utilise lui-même Kit)
	local okR, errR = pcall(function() (require :: any)(script.Parent:FindFirstChild("Reroll"))(ctx, f, top, m, i, weekly) end)
	if not okR then warn("[Kit] défi renouvelable :", errR) end
end


return K
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="822">
          <Properties>
            <string name="Name">Options</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Options (ModuleScript, client)
-- Les options du joueur, communes au menu principal (Réglages) et au panneau Options de la pause (PauseMenu) :
-- un seul état (O.v), appliqué tout de suite et enregistré dans le profil une seconde après le dernier changement.
--   Général       qualité graphique, sensibilité, sensibilité en visée, champ de vision, axe vertical inversé, FPS / ping
--   Viseur        couleur (XHCOL du web) et forme
--   Son           volume général + armes, pas, interface, ambiance, musique (Shared/Sfx.setVolume quand il existe)
--   Accessibilité daltonisme, sous-titres, taille de l'interface, secousses (AccessibilityController, événement AccessSet)
-- Où chaque réglage agit : S.opt (ClientState) pour WeaponController / HudController / PauseMenu, Lighting pour la qualité,
-- SoundService.Master ou Sfx pour les volumes. Enregistrement : MenuSave("opts") (anciens réglages, MenuService) et
-- OptionsSave (tout, OptionsService), le serveur borne chaque valeur (MenuConfig.cleanOptions).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SoundService = game:GetService("SoundService")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")

local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local S = require(ReplicatedStorage.Shared.ClientState)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local K = require(script.Parent:WaitForChild("Kit"))
local C = K.C
local make, spaced = K.make, K.spaced

local player = Players.LocalPlayer

local O = {}
O.SUBS = { "Général", "Viseur", "Son", "Accessibilité" }
local clean = MenuConfig.cleanOptions({})
O.v = clean :: { [string]: any }           -- valeurs courantes (fov, sens, aimSens, quality, vol… ; access à part)
O.access = clean.access :: { [string]: any }
O.v.access = nil
local changedEv = Instance.new("BindableEvent")
O.changed = changedEv.Event                -- après chaque application

-- ---------- application ----------
-- volume général : groupe « Master » (les sons sans groupe y sont rangés), comme avant l'arrivée de Sfx.setVolume
local master = SoundService:FindFirstChild("Master") :: SoundGroup?
if not master then
	local g = Instance.new("SoundGroup"); g.Name = "Master"; g.Parent = SoundService; master = g
end
local function adopt(s: Instance)
	if s:IsA("Sound") and s.SoundGroup == nil then s.SoundGroup = master end
end
for _, where in ipairs({ workspace, SoundService }) do
	for _, d in ipairs(where:GetDescendants()) do adopt(d) end
	where.DescendantAdded:Connect(adopt)
end
local disabledFx: { [Instance]: boolean } = {}
local function xhColor(i: number): Color3
	return K.rgb(MenuConfig.XH_COLORS[i] or 0xffffff)
end
O.xhColor = xhColor

function O.apply()
	local o = O.v
	S.opt.fov = o.fov; S.opt.sens = o.sens; S.opt.aimSens = o.aimSens
	S.opt.invertY = o.invertY == true
	S.opt.xhColor = xhColor(o.xhColor); S.opt.xhStyle = o.xhStyle
	S.opt.showFps = o.showFps == true; S.opt.showPing = o.showPing == true
	-- armes réalistes / stylisées : l'arme en main est refaite tout de suite (web : VM.gk = null)
	if S.opt.realGuns ~= (o.realGuns ~= false) then
		S.opt.realGuns = o.realGuns ~= false
		if S.onSkin then task.spawn(S.onSkin :: () -> ()) end
	end
	-- volumes : Sfx.setVolume règle lui-même le groupe Master (1 = niveau d'origine, 70 % du curseur)
	if (Sfx :: any).setVolume then
		local setVolume = (Sfx :: any).setVolume
		pcall(setVolume, "master", o.vol / 0.7)
		for _, g in ipairs(MenuConfig.VOLUME_GROUPS) do pcall(setVolume, g[2], o[g[1]]) end
	elseif master then
		master.Volume = o.vol / 0.7
	end
	-- qualité : 1 sans ombres ni halos, 2 ombres, 3 ombres + halos + rayons
	Lighting.GlobalShadows = o.quality >= 2
	for _, e in ipairs(Lighting:GetChildren()) do
		if e:IsA("BloomEffect") or e:IsA("SunRaysEffect") then
			if o.quality < 3 and e.Enabled then e.Enabled = false; disabledFx[e] = true
			elseif o.quality >= 3 and disabledFx[e] then e.Enabled = true; disabledFx[e] = nil end
		end
	end
	changedEv:Fire()
end

-- ---------- chargement (profil reçu par GetProfile) ----------
function O.load(profile: any)
	if typeof(profile) ~= "table" then return end
	local src: { [string]: any } = {}
	local menu = profile.menu
	if typeof(menu) == "table" and typeof(menu.opts) == "table" then
		for k, v in pairs(menu.opts) do src[k] = v end                 -- anciens réglages (MenuService)
	end
	if typeof(profile.options) == "table" then
		for k, v in pairs(profile.options) do src[k] = v end           -- toutes les options (OptionsService)
	end
	local c = MenuConfig.cleanOptions(src)
	for k, v in pairs(c) do if k ~= "access" then O.v[k] = v end end
	if typeof(profile.options) == "table" and typeof(profile.options.access) == "table" then O.access = c.access end
	O.apply()
end

-- accessibilité : ce qu'AccessibilityController a en ce moment (attribut « Access »)
local function readAccess()
	local raw = player:GetAttribute("Access")
	if typeof(raw) == "string" then
		local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and typeof(data) == "table" then
			local c = MenuConfig.cleanOptions({ access = data }).access
			for k, v in pairs(c) do O.access[k] = v end
		end
	end
end
readAccess()
player:GetAttributeChangedSignal("Access"):Connect(readAccess)

-- ---------- enregistrement ----------
local function invoke(name: string, ...: any): any
	local r = ReplicatedStorage:FindFirstChild(name) or ReplicatedStorage:WaitForChild(name, 5)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local ok, res = pcall(r.InvokeServer, r, ...)
	if not ok then warn("[Options]", name, res); return nil end
	return res
end
local saveToken = 0
function O.save()   -- une seconde après le dernier changement
	saveToken += 1
	local my = saveToken
	task.delay(1, function()
		if saveToken ~= my then return end
		local payload: { [string]: any } = table.clone(O.v)
		payload.access = table.clone(O.access)
		invoke("MenuSave", "opts", { fov = O.v.fov, sens = O.v.sens, aimSens = O.v.aimSens, vol = O.v.vol, quality = O.v.quality })
		task.wait(0.6)   -- MenuService et OptionsService acceptent un enregistrement par demi-seconde
		if saveToken == my then invoke("OptionsSave", payload) end
	end)
end
local function changed() O.apply(); O.save() end
O.set = function(key: string, value: any) O.v[key] = value; changed() end

function O.reset()
	local c = MenuConfig.cleanOptions({})
	for k, v in pairs(c) do if k ~= "access" then O.v[k] = v end end
	changed()
end

-- ---------- interface (Réglages du menu et Options de la pause) ----------
local QUALITY = { "Basse", "Moyenne", "Haute" }

local function chips(parent: Instance, order: number, items: { { any } }, cur: any, pick: (any) -> ())
	local r = make("Frame", { Size = UDim2.new(1, 0, 0, 36), LayoutOrder = order }, parent)
	K.hlist(r, 6)
	for i, it in ipairs(items) do
		K.chip(r, it[2], cur == it[1], function() pick(it[1]) end, { LayoutOrder = i })
	end
	return r
end
local function column(parent: Instance, W: number): (Frame, Frame)
	local two = W >= 900
	local cols = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, parent)
	if two then K.hlist(cols, 36, Enum.VerticalAlignment.Top) else K.vlist(cols, 14) end
	local cw = if two then math.min(440, (W - 40) // 2) else W - 10
	local a = make("Frame", { Size = UDim2.fromOffset(cw, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, cols)
	local b = make("Frame", { Size = UDim2.fromOffset(cw, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, cols)
	K.vlist(a, 10); K.vlist(b, 10)
	return a, b
end
local ONOFF: { { any } } = { { false, "Non" }, { true, "Oui" } }

local function general(sc: Instance, W: number, rerender: () -> ())
	local o = O.v
	local a, b = column(sc, W)
	K.label(a, "QUALITÉ GRAPHIQUE", 1)
	chips(a, 2, { { 1, QUALITY[1] }, { 2, QUALITY[2] }, { 3, QUALITY[3] } }, o.quality, function(v) O.set("quality", v); rerender() end)
	K.para(a, "Basse : sans ombres ni halos. Moyenne : ombres. Haute : ombres, halos et rayons de soleil. (Le niveau de détail Roblox se règle aussi dans le menu Échap.)", 11, C.dim, 3)
	K.slider(a, "SENSIBILITÉ EN VISÉE", 0.2, 2, 0.05, o.aimSens, function(v) return string.format("×%.2f", v) end, function(v) O.set("aimSens", v) end, 4)
	K.label(a, "INVERSER L'AXE VERTICAL", 5)
	chips(a, 6, ONOFF, o.invertY == true, function(v) O.set("invertY", v); rerender() end)
	K.slider(b, "SENSIBILITÉ", 0.1, 4, 0.05, o.sens, function(v) return string.format("%.2f", v) end, function(v) O.set("sens", v) end, 1)
	K.slider(b, "CHAMP DE VISION", 60, 110, 1, o.fov, function(v) return math.floor(v) .. "°" end, function(v) O.set("fov", v) end, 2)
	K.label(b, "AFFICHER LES FPS", 3)
	chips(b, 4, ONOFF, o.showFps == true, function(v) O.set("showFps", v); rerender() end)
	K.label(b, "AFFICHER LE PING", 5)
	chips(b, 6, ONOFF, o.showPing == true, function(v) O.set("showPing", v); rerender() end)
	K.label(b, "ARMES", 7)
	chips(b, 8, { { true, "Réalistes" }, { false, "Stylisés" } }, o.realGuns ~= false, function(v) O.set("realGuns", v); rerender() end)
	K.para(b, "Réalistes : AK, M4, AWP et Desert Eagle avec leurs vraies textures, quand l'arme n'a pas de skin.", 11, C.dim, 9)
	K.btn(sc, spaced("RÉTABLIR PAR DÉFAUT", 1), "dark", function() O.reset(); rerender() end,
		{ LayoutOrder = 2, Size = UDim2.fromOffset(220, 32), TextSize = 11 })
end

-- aperçu du viseur : point, croix ou cercle de la couleur choisie
local function drawReticle(parent: Instance, style: string, col: Color3)
	local function piece(size: UDim2, pos: UDim2)
		local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = size, BackgroundTransparency = 0, BackgroundColor3 = col }, parent)
		K.stroke(f, Color3.new(0, 0, 0), 1, 0.4)
		return f
	end
	if style == "dot" then
		K.corner(piece(UDim2.fromOffset(6, 6), UDim2.fromScale(0.5, 0.5)), 3)
	elseif style == "cross" then
		for _, d in ipairs({ { 0, -12 }, { 0, 12 }, { -12, 0 }, { 12, 0 } }) do
			piece(if d[1] == 0 then UDim2.fromOffset(2, 10) else UDim2.fromOffset(10, 2), UDim2.new(0.5, d[1], 0.5, d[2]))
		end
	elseif style == "circle" then
		local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(26, 26) }, parent)
		K.corner(ring, 13); K.stroke(ring, col, 2, 0)
		K.corner(piece(UDim2.fromOffset(4, 4), UDim2.fromScale(0.5, 0.5)), 2)
	end
end
local function reticle(sc: Instance, W: number, rerender: () -> ())
	local o = O.v
	local a, b = column(sc, W)
	K.label(a, "COULEUR DU VISEUR", 1)
	local sw = make("Frame", { Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 2 }, a)
	K.hlist(sw, 8)
	for i, hex in ipairs(MenuConfig.XH_COLORS) do
		local on = o.xhColor == i
		local c = make("TextButton", { Text = "", Size = UDim2.fromOffset(32, 32), BackgroundTransparency = 0, BackgroundColor3 = K.rgb(hex), LayoutOrder = i,
			Selectable = true, AutoButtonColor = false }, sw)
		K.corner(c, 16); K.stroke(c, C.white, if on then 3 else 1, if on then 0 else 0.7)
		K.juice(c, 0.12)
		c.Activated:Connect(function() O.set("xhColor", i); rerender() end)
	end
	K.label(a, "FORME", 3)
	local styles = {}
	for _, st in ipairs(MenuConfig.XH_STYLES) do table.insert(styles, { st[1], st[2] }) end
	chips(a, 4, styles, o.xhStyle, function(v) O.set("xhStyle", v); rerender() end)
	-- aperçu (le web dessine le viseur sur une grille sombre)
	local prev = make("Frame", { Size = UDim2.new(1, 0, 0, 150), BackgroundTransparency = 0.2, BackgroundColor3 = K.rgb(0x0b111c), LayoutOrder = 1 }, b)
	K.corner(prev, 10); K.stroke(prev)
	for i = 1, 13 do
		make("Frame", { Position = UDim2.fromScale(i / 14, 0), Size = UDim2.new(0, 1, 1, 0), BackgroundTransparency = 0.95, BackgroundColor3 = C.white }, prev)
	end
	drawReticle(prev, o.xhStyle, xhColor(o.xhColor))
	K.para(b, "Aperçu du viseur affiché au centre de l'écran en partie.", 11, C.dim, 2)
end

local function sound(sc: Instance, W: number, _rerender: () -> ())
	local o = O.v
	local a, b = column(sc, W)
	local pct = function(v: number) return math.floor(v * 100 + 0.5) .. "%" end
	K.slider(a, "VOLUME GÉNÉRAL", 0, 1, 0.05, o.vol, pct, function(v) O.set("vol", v) end, 1)
	K.para(a, "70 % = le volume d'origine du jeu.", 11, C.dim, 2)
	local has = (Sfx :: any).setVolume ~= nil
	for i, g in ipairs(MenuConfig.VOLUME_GROUPS) do
		K.slider(b, g[3], 0, 2, 0.05, o[g[1]], pct, function(v)
			O.set(g[1], v)
			if g[2] == "ui" then K.uiSound(false) end
		end, i)
	end
	if not has then K.para(b, "Les volumes par catégorie s'appliqueront avec la prochaine mise à jour des sons.", 11, C.dim, 10) end
end

local function access(sc: Instance, _W: number, rerender: () -> ())
	local ps = player:FindFirstChild("PlayerScripts")
	local ac = ps and ps:FindFirstChild("AccessibilityController")
	local ev = ac and ac:FindFirstChild("AccessSet")
	local cur = O.access
	local function set(key: string, value: any)
		cur[key] = value
		if ev and ev:IsA("BindableEvent") then ev:Fire(key, value) end
		O.save()
	end
	K.label(sc, "MODE DALTONIEN", 1)
	chips(sc, 2, { { "none", "Aucun" }, { "deut", "Deutéranopie" }, { "prot", "Protanopie" }, { "trit", "Tritanopie" } }, cur.colorblind,
		function(v) set("colorblind", v); rerender() end)
	K.label(sc, "SOUS-TITRES DES SONS (tirs entendus, avec la direction)", 3)
	chips(sc, 4, { { true, "Affichés" }, { false, "Masqués" } }, cur.subtitles == true, function(v) set("subtitles", v); rerender() end)
	local box = make("Frame", { Size = UDim2.fromOffset(440, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 5 }, sc)
	K.vlist(box, 10)
	K.slider(box, "TAILLE DE L'INTERFACE", 0.7, 1.4, 0.05, tonumber(cur.hudScale) or 1, function(v) return string.format("×%.2f", v) end, function(v) set("hudScale", v) end, 1)
	K.slider(box, "SECOUSSES DE L'ÉCRAN", 0, 1, 0.1, tonumber(cur.shake) or 1, function(v) return math.floor(v * 100 + 0.5) .. "%" end, function(v) set("shake", v) end, 2)
	if not (ev and ev:IsA("BindableEvent")) then K.para(sc, "Accessibilité indisponible pour le moment.", 11, C.accent, 6) end
end

-- sub : un des O.SUBS ; W : largeur disponible ; rerender : redessine (une puce a changé)
function O.build(sc: Instance, W: number, sub: string?, rerender: () -> ())
	if sub == "Viseur" then reticle(sc, W, rerender)
	elseif sub == "Son" then sound(sc, W, rerender)
	elseif sub == "Accessibilité" then access(sc, W, rerender)
	else general(sc, W, rerender) end
end

O.apply()
return O
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="823">
          <Properties>
            <string name="Name">Play</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Play (ModuleScript) — rubrique « Jouer » (src/87b_playui.js, src/85_menu.js, src/87d_lobby.js)
-- Interrupteur EN LIGNE / AVEC DES AMIS, avec une phrase qui dit ce que ça change, puis trois étapes :
--   1 MODE   tuiles des modes (pastille « 👤 n » : joueurs en ligne dans ce mode)
--   2 CARTE  vignettes vues de dessus et description
--   3 JOUER  le gros bouton JOUER (MatchCreate -> MatchService.playOnline : rejoint une partie publique du mode où il reste
--            de la place, sinon en crée une), ce qu'il va faire, PARTIE RAPIDE, les parties en cours (MatchList, joueurs humains),
--            puis les réglages « si une nouvelle partie est créée » : niveau des bots, places, et « Plus d'options »
--            (camp, limite, économie, modificateurs, classé).
-- Avec des amis : le groupe (PartyService) ; avec un groupe, la partie est privée (settings.private) et le chef la lance pour tous.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local SocialService = game:GetService("SocialService")
local Modes = require(ReplicatedStorage.Shared.Modes)
local MapData = require(ReplicatedStorage.Shared.MapData)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local K = require(script.Parent.Kit)
local Icons = require(ReplicatedStorage.Shared.Icons)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local function modeName(id: string): string
	local m = Modes.LIST[id]
	return if m then (string.gsub(m.n, "%s*%(.*%)", "")) else id
end

-- ---------- vignettes des cartes (drawMapThumb du web, src/20_maps.js) ----------
local TH: { [string]: { [string]: number } } = {
	night = { bg = 0x1a2438, w = 0x5a6a86, h = 0x3a4a6a, x = 0xd39a2b, l = 0x6a7a96, p = 0x4a6a9a },
	metro = { bg = 0x3a3f47, w = 0x9aa4b4, h = 0x7a8494, x = 0xc9a23a, l = 0x7a8494, p = 0x6a8ab0 },
	jungle = { bg = 0x4a7a3a, w = 0x8a9a7a, h = 0x7a8a6a, x = 0x6a7a5a, l = 0x9aa48a, p = 0xc9b070 },
	range = { bg = 0x7a8088, w = 0xcfd5dd, h = 0x8d97a6, x = 0xd39a2b, l = 0x8d97a6, p = 0x6e8fb5 },
	snow = { bg = 0xe8eef6, w = 0x7f8998, h = 0x8a5a38, x = 0x6f7a8a, l = 0xffffff, p = 0xb08a5a },
	sand = { bg = 0xc9b18a, w = 0xf0e6cc, h = 0xc56a3e, x = 0x8c6a3a, l = 0xa89b78, p = 0xe0c070 },
	industrial = { bg = 0x566070, w = 0xcfd5dd, h = 0x8d97a6, x = 0xd39a2b, l = 0x8d97a6, p = 0x6e8fb5 },
	haunt = { bg = 0x1e2a22, w = 0x6a4a40, h = 0x5a3a30, x = 0x6a5030, l = 0x7d8580, p = 0x5a5048 },
}
TH.halloween = TH.haunt
-- Plan vu de dessus en cadres : chaque bloc de cases de même couleur devient un rectangle (fusion gloutonne : une case
-- s'étend vers la droite puis vers le bas tant que la couleur reste la même), 100 à 300 cadres par carte au lieu de 1 600.
-- Le modèle de chaque carte est construit une fois (positions en fractions : il sert à toutes les tailles), puis cloné.
-- (Plus d'EditableImage : non autorisée dans Studio sans réglage, elle donnait la vignette de secours, et elle prend sur
-- la mémoire déjà comptée des EditableMesh.)
local thumbTemplates: { [string]: Frame | false } = {}
local function cellColor(g: any, th: { [string]: number }, i: number): number?
	local t = g.type[i]
	if g.ramp and g.ramp[i] ~= 0 then return 0xd9b45a end
	if t == 1 or t == 8 then return th.w end
	if t == 3 or t == 7 then return th.h end
	if t == 2 or t == 9 then return th.x end
	if t == 4 or t == 5 then return th.l end
	if t == 6 then return th.p end
	if g.ceil and g.ceil[i] < 90 then   -- couvert : 18 % plus sombre (rgba(0,0,0,.18) du web)
		local r, gg, b = bit32.rshift(th.bg, 16), bit32.band(bit32.rshift(th.bg, 8), 255), bit32.band(th.bg, 255)
		return bit32.lshift(math.floor(r * 0.82), 16) + bit32.lshift(math.floor(gg * 0.82), 8) + math.floor(b * 0.82)
	end
	if t ~= 0 then return th.w end
	return nil   -- sol : la couleur de fond de la vignette
end
local function thumbTemplate(id: string): Frame?
	local cached = thumbTemplates[id]
	if cached == false then return nil end
	if cached then return cached :: Frame end
	thumbTemplates[id] = false
	local info = Modes.MAP[id]
	if not (MapData :: any)[id] or not info then return nil end
	local okG, g = pcall(MapData.buildGrid, id)
	if not okG or not g or not g.type then return nil end
	local N = MapData.N
	local th = TH[info.theme] or TH.industrial
	local col: { [number]: number } = {}
	for i = 0, N * N - 1 do
		local c = cellColor(g, th, i)
		if c then col[i] = c end
	end
	local done: { [number]: boolean } = {}
	local tpl = make("Frame", { Name = "Plan", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1 })
	for z = 0, N - 1 do
		for x = 0, N - 1 do
			local i = z * N + x
			local c = col[i]
			if c and not done[i] then
				local w = 1
				while x + w < N and col[i + w] == c and not done[i + w] do w += 1 end
				local h = 1
				while z + h < N do
					local ok = true
					for k = 0, w - 1 do
						local j = (z + h) * N + x + k
						if col[j] ~= c or done[j] then ok = false; break end
					end
					if not ok then break end
					h += 1
				end
				for dz = 0, h - 1 do for k = 0, w - 1 do done[(z + dz) * N + x + k] = true end end
				-- + 1 px : pas de fente entre deux blocs voisins à cause des arrondis
				make("Frame", { Position = UDim2.fromScale(x / N, z / N), Size = UDim2.new(w / N, 1, h / N, 1), BackgroundTransparency = 0,
					BackgroundColor3 = K.rgb(c), Active = false }, tpl)
			end
		end
	end
	thumbTemplates[id] = tpl
	return tpl
end
local function thumb(parent: Instance, id: string, size: number): Frame
	local info = Modes.MAP[id]
	local th = TH[info and info.theme or ""] or TH.industrial
	local f = make("Frame", { Size = UDim2.fromOffset(size, size), BackgroundTransparency = 0, BackgroundColor3 = K.rgb(th.bg), ClipsDescendants = true }, parent)
	K.corner(f, 6)
	local tpl = thumbTemplate(id)
	if tpl then
		tpl:Clone().Parent = f
	else
		-- carte sans plan : vignette de couleur avec le nom
		K.gradient(f, K.rgb(th.bg), K.rgb(th.w), 135, 0, 0.3)
		text(f, { Text = info and info.n or id, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = K.BLACK, TextSize = math.max(10, size // 9),
			TextColor3 = K.rgb(th.h), TextTransparency = 0.2 })
	end
	local md = (MapData :: any)[id]
	if md and not (info and info.zombie) then
		local N = MapData.N
		for _, s in ipairs(md.sites or {}) do
			local r = (s.r or 7) / N * size
			local ring = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale((s.cx + 0.5) / N, (s.cz + 0.5) / N), Size = UDim2.fromOffset(r, r) }, f)
			K.corner(ring, math.floor(r)); K.stroke(ring, C.accent, 2, 0.1)
			text(ring, { Text = s.n, Size = UDim2.fromScale(1, 1), TextXAlignment = Enum.TextXAlignment.Center, Font = K.BLACK, TextSize = math.max(9, size // 11),
				TextColor3 = C.accent, TextStrokeTransparency = 0.6 })
		end
		text(f, { Text = "CT", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(20 / N, 5 / N), Size = UDim2.fromOffset(30, 14), Font = K.BLACK,
			TextSize = math.max(8, size // 16), TextColor3 = C.blue, TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6 })
		text(f, { Text = "T", AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(20 / N, 36 / N), Size = UDim2.fromOffset(30, 14), Font = K.BLACK,
			TextSize = math.max(8, size // 16), TextColor3 = K.rgb(0xff7a4a), TextXAlignment = Enum.TextXAlignment.Center, TextStrokeTransparency = 0.6 })
	end
	return f
end
-- ambiance de la carte en un mot (petite ligne sous le nom de la vignette)
local THEME_NAME: { [string]: string } = { sand = "Désert", industrial = "Industriel", snow = "Neige", night = "De nuit", metro = "Souterrain",
	jungle = "Jungle", range = "Entraînement", haunt = "Hanté", halloween = "Hanté" }
local function mapTag(id: string): string
	local info = Modes.MAP[id]
	local md = (MapData :: any)[id]
	local parts = { THEME_NAME[info and info.theme or ""] or "" }
	local ns = if md and md.sites then #md.sites else 0
	if info and info.zombie then table.insert(parts, "Zombies")
	elseif ns > 0 then table.insert(parts, ns .. " sites de bombe") end
	return table.concat(parts, " · ")
end

-- titre d'étape « (1) MODE », avec une phrase d'aide courte dessous
local function step(parent: Instance, n: number, title: string, order: number, help: string?)
	local row = make("Frame", { Size = UDim2.new(1, 0, 0, if help then 42 else 26), LayoutOrder = order }, parent)
	local b = text(row, { Text = tostring(n), Size = UDim2.fromOffset(22, 22), Position = UDim2.fromOffset(0, 2), BackgroundTransparency = 0, BackgroundColor3 = C.accent,
		TextXAlignment = Enum.TextXAlignment.Center, Font = K.BLACK, TextSize = 12 })
	K.corner(b, 11)
	text(row, { Text = spaced(title, 2), Position = UDim2.fromOffset(32, 0), Size = UDim2.new(1, -32, 0, 26), Font = K.BLACK, TextSize = 14, TextWrapped = false })
	if help then
		text(row, { Text = help, Position = UDim2.fromOffset(32, 24), Size = UDim2.new(1, -32, 0, 16), TextSize = 11, Font = K.MED, TextColor3 = C.dim, TextWrapped = false,
			TextTruncate = Enum.TextTruncate.AtEnd })
	end
end

-- état d'une partie de la liste (MatchService : loading, warmup, live, intermission, over)
local STATE_TEXT: { [string]: string } = { loading = "démarre", warmup = "échauffement", live = "en cours", intermission = "entre deux manches", over = "terminée" }
local function people(n: number): string return n .. " joueur" .. (if n > 1 then "s" else "") end

local DIFF_COL = { 0x7dff9f, 0xc6ff5a, 0xffd23a, 0xff9a3a, 0xff4655 }
local matchToken = 0

return function(ctx: any, body: Frame, _sub: string?)
	local p = ctx.play
	local player = ctx.player
	local W = ctx.W - 56
	local friends = ctx.friends == true
	local inParty = ctx.party.id ~= nil
	local leader = not inParty or player:GetAttribute("PartyLeader") == true
	local privateGame = friends and inParty   -- partie privée du groupe (settings.private) : toujours une nouvelle partie
	local function set(changes: { [string]: any })
		for k, v in pairs(changes) do p[k] = v end
		local s = Modes.sanitize(p)
		for k, v in pairs(s) do p[k] = v end
		-- comme sur le web : pas de partie classée avec des modificateurs ni hors des modes classés
		if next(p.mut) ~= nil or not X.RANKED_MODES[p.mode] then p.ranked = false end
		ctx.save("play"); ctx.render()
	end

	-- ---------- EN LIGNE / AVEC DES AMIS ----------
	local tog = make("Frame", { Size = UDim2.fromOffset(398, 44), BackgroundTransparency = 0, BackgroundColor3 = C.deep }, body)
	K.corner(tog, 12); K.stroke(tog, C.white, 1, 0.9); K.pad(tog, 4); K.hlist(tog, 4)
	local function togBtn(label: string, on: boolean, kind: string, order: number, w: number, cb: () -> ())
		local b = K.btn(tog, label, if on then kind else "ghost", cb, { LayoutOrder = order, Size = UDim2.fromOffset(w, 36), TextSize = 12,
			BackgroundTransparency = if on then 0 else 1, TextColor3 = if on then (if kind == "white" then C.ink else C.white) else C.dim })
		local st = b:FindFirstChildOfClass("UIStroke"); if st then st:Destroy() end
	end
	togBtn("🌐  " .. spaced("EN LIGNE", 1), not friends, "white", 1, 150, function() ctx.friends = false; ctx.save("play"); ctx.render() end)
	togBtn("👥  " .. spaced("AVEC DES AMIS", 1) .. (if inParty then '  <font color="#7dff9f">' .. #ctx.party.members .. "</font>" else ""), friends, "blue", 2, 232,
		function() ctx.friends = true; ctx.save("play"); ctx.render() end)
	-- ce que veut dire le choix, en une phrase
	local helpText = if not friends then "<b>En ligne</b> : tu joues avec les autres joueurs du serveur. S'il en manque, des bots complètent les places."
		elseif inParty then "<b>Avec des amis</b> : ton groupe joue dans une partie rien qu'à vous. Des bots prennent les places vides."
		else "<b>Avec des amis</b> : crée un groupe et invite tes amis. Tant que tu n'as pas de groupe, tu joues en ligne."
	local narrow = W < 900
	text(body, { Text = helpText, Position = if narrow then UDim2.fromOffset(0, 50) else UDim2.fromOffset(414, 0), Size = if narrow then UDim2.new(1, 0, 0, 34) else UDim2.new(1, -414, 0, 44),
		TextSize = 13, Font = K.MED, TextColor3 = C.sub, TextWrapped = true })

	-- ---------- colonnes : 1 MODE · 2 CARTE · 3 JOUER ----------
	local top = if narrow then 92 else 58
	local area = make("Frame", { Position = UDim2.fromOffset(0, top), Size = UDim2.new(1, 0, 1, -top) }, body)
	local c1: GuiObject, c2: GuiObject, c3: GuiObject
	local w1, w2, w3: number
	if W >= 1250 then
		w1, w3 = 330, 340
		w2 = W - w1 - w3 - 52
		c1 = K.scroll(area, { Name = "PlayMode", Size = UDim2.new(0, w1, 1, 0) })
		c2 = K.scroll(area, { Name = "PlayMap", Size = UDim2.new(0, w2, 1, 0), Position = UDim2.fromOffset(w1 + 26, 0) })
		c3 = K.scroll(area, { Name = "PlayCfg", Size = UDim2.new(0, w3, 1, 0), Position = UDim2.new(1, -w3, 0, 0) })
	elseif W >= 860 then
		w3 = 340; w1 = W - w3 - 30; w2 = w1
		local left = K.scroll(area, { Name = "PlayLeft", Size = UDim2.new(0, w1, 1, 0) })
		K.vlist(left, 18)
		c1 = make("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, left)
		c2 = make("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, left)
		c3 = K.scroll(area, { Name = "PlayCfg", Size = UDim2.new(0, w3, 1, 0), Position = UDim2.new(1, -w3, 0, 0) })
	else
		w1, w2, w3 = W, W, W
		local all = K.scroll(area, { Name = "PlayAll" })
		K.vlist(all, 18)
		c1 = make("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, all)
		c2 = make("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, all)
		c3 = make("Frame", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3 }, all)
	end
	for _, c in ipairs({ c1, c2, c3 }) do K.vlist(c, 12); K.pad(c, 0, 0, 6, 12) end
	local guest = friends and inParty and not leader   -- les invités ne choisissent pas : le chef décide

	-- ---------- 1 MODE ----------
	step(c1, 1, "MODE", 1, if guest then "Le chef du groupe choisit." else "Comment veux-tu jouer ?")
	local tiles = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, c1)
	local cell = math.floor((w1 - 6 - 20) / 3)
	K.grid(tiles, UDim2.fromOffset(cell, 112), 10)
	local feat = Modes.featured()
	local order = 0
	local liveBadges: { [string]: TextLabel } = {}   -- « 👤 3 » : joueurs en ligne dans ce mode (mis à jour avec la liste)
	for _, grp in ipairs(Modes.GROUPS) do
		for _, id in ipairs(grp[2]) do
			local m = Modes.LIST[id]
			if m then
				order += 1
				local on = p.mode == id
				local b = make("TextButton", { Text = "", LayoutOrder = order, BackgroundTransparency = 0, BackgroundColor3 = if on then m.c:Lerp(C.card, 0.82) else C.card,
					Selectable = true, Active = not guest }, tiles)
				K.corner(b, 10); K.stroke(b, if on then m.c else C.white, 2, if on then 0 else 0.93)
				-- couleur du mode (--c du web) : halo derrière l'icône (drop-shadow) et liseré en bas de la tuile
				local halo = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 34), Size = UDim2.fromOffset(46, 46),
					BackgroundTransparency = if on then 0.72 else 0.88, BackgroundColor3 = m.c }, b)
				K.corner(halo, 23)
				local band = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -1), Size = UDim2.new(if on then 0.7 else 0.34, 0, 0, 3),
					BackgroundTransparency = if on then 0 else 0.45, BackgroundColor3 = m.c }, b)
				K.corner(band, 2)
				text(b, { Text = m.ic, Size = UDim2.new(1, 0, 0, 40), Position = UDim2.fromOffset(0, 14), TextSize = 30, TextXAlignment = Enum.TextXAlignment.Center })
				-- nom sans espaces entre les lettres : Roblox ne coupe la ligne qu'entre les mots, et le texte rapetisse (12 à 8 px)
				-- si un mot est trop long (« DÉSAMORÇAGE RAPIDE », « MATCH À MORT PAR ÉQUIPE »)
				K.fit(text(b, { Text = K.upper(modeName(id)), Size = UDim2.new(1, -12, 0, 40), Position = UDim2.fromOffset(6, 60), TextSize = 12, Font = K.BLACK,
					TextXAlignment = Enum.TextXAlignment.Center, TextYAlignment = Enum.TextYAlignment.Top, LineHeight = 1.05, TextWrapped = true }), 12, 8)
				if id == feat then
					local x2 = text(b, { Text = "XP ×2", Size = UDim2.fromOffset(46, 16), Position = UDim2.new(1, -52, 0, 6), BackgroundTransparency = 0, BackgroundColor3 = C.gold,
						TextColor3 = C.ink, Font = K.BLACK, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center })
					K.corner(x2, 4)
				end
				local lb = text(b, { Text = "", Size = UDim2.fromOffset(40, 16), Position = UDim2.fromOffset(6, 6), BackgroundTransparency = 0, BackgroundColor3 = K.rgb(0x1f3a26),
					TextColor3 = C.green, Font = K.BLACK, TextSize = 9, TextXAlignment = Enum.TextXAlignment.Center, Visible = false })
				K.corner(lb, 4)
				liveBadges[id] = lb
				if friends and id == "train" then b.BackgroundTransparency = 0.6 end
				if not guest then
					b.Activated:Connect(function()
						local maps = Modes.mapsFor(id)
						set({ mode = id, map = if table.find(maps, p.map) then p.map else maps[1], limit = Modes.defaultLimit(id) })
					end)
				end
				b.MouseEnter:Connect(function() if not on then b.BackgroundColor3 = C.card2; K.tween(band, 0.16, { Size = UDim2.new(0.6, 0, 0, 3) }) end end)
				b.MouseLeave:Connect(function() if not on then b.BackgroundColor3 = C.card; K.tween(band, 0.16, { Size = UDim2.new(0.34, 0, 0, 3) }) end end)
				if not guest then K.juice(b, 0.05) end   -- survol / manette : la tuile grossit, son d'interface, enfoncement au clic
			end
		end
	end
	K.para(c1, Modes.LIST[p.mode] and ("<b>" .. modeName(p.mode) .. "</b> : " .. Modes.LIST[p.mode].desc) or "", 12, C.sub, 3)
	local legend = K.para(c1, '<font color="#7dff9f">👤 3</font> = joueurs en ligne dans ce mode en ce moment.', 11, C.mute, 4)
	legend.Visible = false

	-- ---------- 2 CARTE ----------
	step(c2, 2, "CARTE", 1, if guest then "Le chef du groupe choisit." else "Où veux-tu jouer ?")
	local maps = Modes.mapsFor(p.mode)
	local mgrid = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, c2)
	local single = #maps == 1
	local per = if single then 1 elseif w2 >= 560 then 4 elseif w2 >= 400 then 3 else 2
	local cw = if single then math.min(420, w2 - 10) else math.floor((w2 - 8 - (per - 1) * 10) / per)
	local th = cw - 16
	K.grid(mgrid, UDim2.fromOffset(cw, th + 56), 10)
	for i, id in ipairs(maps) do
		local on = p.map == id
		local b = make("TextButton", { Text = "", LayoutOrder = i, BackgroundTransparency = 0, BackgroundColor3 = C.card, Selectable = true, Active = not guest }, mgrid)
		K.corner(b, 10); K.stroke(b, if on then C.accent else C.white, 2, if on then 0 else 0.93)
		local t = thumb(b, id, th); t.Position = UDim2.fromOffset(8, 8)
		if on then   -- carte choisie : pastille rouge avec une coche dessinée, en plus du bord rouge
			local ok = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 12), Size = UDim2.fromOffset(24, 24), BackgroundTransparency = 0,
				BackgroundColor3 = C.accent, ZIndex = t.ZIndex + 2 }, b)
			K.corner(ok, 12)
			Icons.check(ok, 16, C.white, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
		end
		K.fit(text(b, { Text = spaced(K.upper(Modes.MAP[id].n), 1), Position = UDim2.fromOffset(6, th + 14), Size = UDim2.new(1, -12, 0, 18), Font = K.BLACK, TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false }), 12, 8)
		K.fit(text(b, { Text = mapTag(id), Position = UDim2.fromOffset(6, th + 34), Size = UDim2.new(1, -12, 0, 14), Font = K.MED, TextSize = 11, TextColor3 = C.dim,
			TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false }), 11, 8)
		if not guest then b.Activated:Connect(function() set({ map = id }) end); K.juice(b, 0.04) end
		b.MouseEnter:Connect(function() b.BackgroundColor3 = C.card2 end)
		b.MouseLeave:Connect(function() b.BackgroundColor3 = C.card end)
	end
	local desc = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 3, BackgroundTransparency = 0.2, BackgroundColor3 = C.deep }, c2)
	K.corner(desc, 8); K.pad(desc, 12, 12)
	K.para(desc, Modes.MAP[p.map] and ("<b>" .. Modes.MAP[p.map].n .. "</b> : " .. Modes.MAP[p.map].desc) or "", 12, C.sub)

	-- ---------- 3 JOUER ----------
	step(c3, 3, "JOUER", 1, if guest then "Le chef lance la partie pour tout le groupe." else "Lance la partie ou rejoins-en une.")

	-- le groupe d'amis (PartyService)
	if friends then
		local fb = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2, BackgroundTransparency = 0, BackgroundColor3 = C.white }, c3)
		K.gradient(fb, K.rgb(0x132036), K.rgb(0x0d1626), 90); K.corner(fb, 12); K.stroke(fb, C.blue, 1, 0.6); K.pad(fb, 14)
		K.vlist(fb, 8)
		K.h4(fb, "👥 TON GROUPE", if inParty then #ctx.party.members .. " / 5" else nil, 0, K.rgb(0x9fd0ff))
		if not inParty then
			K.para(fb, "1. Crée un groupe.  2. Invite tes amis Roblox : ils arrivent ici et entrent dans ton groupe.  3. Choisis le mode et la carte, puis JOUER lance la partie pour tout le monde.", 12, C.sub, 1)
			K.btn(fb, "➕  " .. spaced("CRÉER UN GROUPE", 1), "blue", function()
				ctx.call("PartyCreate"); task.wait(0.3); ctx.render()
			end, { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 44), TextSize = 14 })
			-- groupes ouverts sur ce serveur
			local others = {}
			for _, q in ipairs(Players:GetPlayers()) do
				if q ~= player and q:GetAttribute("PartyLeader") == true and typeof(q:GetAttribute("Party")) == "string" then table.insert(others, q) end
			end
			if #others > 0 then
				K.label(fb, "OU REJOINS UN GROUPE DE CE SERVEUR", 3, C.dim)
				for i, q in ipairs(others) do
					local r = make("Frame", { Size = UDim2.new(1, 0, 0, 36), LayoutOrder = 3 + i, BackgroundTransparency = 0.94, BackgroundColor3 = C.white }, fb)
					K.corner(r, 8); K.pad(r, 10, 0, 4, 0)
					text(r, { Text = "👑 " .. K.esc(q.DisplayName), Size = UDim2.new(1, -110, 1, 0), TextSize = 13, TextWrapped = false })
					K.btn(r, spaced("REJOINDRE", 1), "blue", function()
						local ok = ctx.call("PartyJoin", q:GetAttribute("Party"))
						ctx.toast(if ok then "✔ Tu as rejoint le groupe de " .. q.DisplayName else "Groupe plein ou fermé", if ok then C.green else C.accent)
					end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(100, 28), TextSize = 10 })
				end
			end
		else
			for i, m in ipairs(ctx.party.members) do
				local r = make("Frame", { Size = UDim2.new(1, 0, 0, 34), LayoutOrder = i, BackgroundTransparency = 0.94, BackgroundColor3 = C.white }, fb)
				K.corner(r, 8); K.pad(r, 10, 0)
				text(r, { Text = K.esc(tostring(m.name)) .. (if m.userId == player.UserId then '  <font color="#8da0bd">(toi)</font>' else ""), Size = UDim2.new(1, -60, 1, 0), TextSize = 13,
					TextWrapped = false })
				if m.leader then
					text(r, { Text = spaced("CHEF", 1), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(60, 34), TextColor3 = C.gold,
						Font = K.BLACK, TextSize = 10, TextXAlignment = Enum.TextXAlignment.Right })
				end
			end
			for i = #ctx.party.members + 1, 5 do
				local r = make("Frame", { Size = UDim2.new(1, 0, 0, 30), LayoutOrder = i, BackgroundTransparency = 0.97, BackgroundColor3 = C.white }, fb)
				K.corner(r, 8); K.pad(r, 10, 0)
				text(r, { Text = "Place libre : invite un ami", Size = UDim2.fromScale(1, 1), TextSize = 12, Font = K.MED, TextColor3 = C.mute })
			end
			K.btn(fb, "✉  " .. spaced("INVITER DES AMIS", 1), "blue", function()
				local ok, can = pcall(function() return SocialService:CanSendGameInviteAsync(player) end)
				if ok and not can then ctx.toast("Les invitations ne sont pas disponibles sur ce compte", C.gold); return end
				local opts = Instance.new("ExperienceInviteOptions")
				opts.PromptMessage = "Rejoins mon groupe sur Strike Arena !"
				opts.LaunchData = "party:" .. tostring(ctx.party.id)
				local okP = pcall(function() SocialService:PromptGameInvite(player, opts) end)
				if not okP then ctx.toast("Invitation impossible pour le moment", C.accent) end
			end, { LayoutOrder = 10, Size = UDim2.new(1, 0, 0, 42), TextSize = 13 })
			K.btn(fb, spaced("QUITTER LE GROUPE", 1), "dark", function()
				ctx.call("PartyLeave"); ctx.party.id = nil; ctx.party.members = {}; ctx.render()
			end, { LayoutOrder = 11, Size = UDim2.new(1, 0, 0, 32), TextSize = 11 })
			if guest then
				K.para(fb, "Le chef du groupe choisit le mode et la carte, puis lance la partie pour tout le monde. Reste dans le lobby !", 12, K.rgb(0xcfe5ff), 12)
			end
		end
	end
	if guest then return end

	-- JOUER : l'action principale de l'écran
	local def = Modes.LIST[p.mode]
	local label = if privateGame then "JOUER AVEC LE GROUPE" else "JOUER"
	local pb = K.btn(c3, "", "primary", function() ctx.startPlay() end, { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 78), Name = "PlayGo" })
	text(pb, { Text = "▶  " .. spaced(label, if privateGame then 2 else 4), Font = K.BLACK, TextSize = if privateGame then 20 else 28, Size = UDim2.new(1, 0, 0, 34),
		Position = UDim2.fromOffset(0, 12), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = pb.ZIndex + 1 })
	text(pb, { Text = spaced(modeName(p.mode) .. " · " .. (Modes.MAP[p.map] and Modes.MAP[p.map].n or ""), 1), Font = K.BOLD, TextSize = 11, Size = UDim2.new(1, 0, 0, 16),
		Position = UDim2.fromOffset(0, 50), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTransparency = 0.15, ZIndex = pb.ZIndex + 1 })
	K.cut(pb, 12, K.rgb(0x0b111c))
	K.shine(pb, 2.4, 0.25)   -- reflet qui revient sur JOUER (playglow du web)
	-- ce que fera JOUER (mis à jour avec la liste des parties)
	local alone = p.mode == "train" or next(p.mut) ~= nil   -- MatchService : l'Entraînement et les modificateurs restent seuls
	local status = K.para(c3, "", 12, C.sub, 4)
	local function showStatus(list: { any }?)
		if privateGame then
			status.Text = "🔒 Une partie privée est créée pour ton groupe, avec les réglages ci-dessous."
		elseif p.mode == "train" then
			status.Text = "🎯 L'Entraînement se joue seul : une nouvelle partie est créée."
		elseif alone then
			status.Text = "🧪 Avec des modificateurs, une nouvelle partie est créée (les autres peuvent la rejoindre)."
		else
			local n, humans = 0, 0
			local l: { any } = list or {}
			for _, m in ipairs(l) do
				if m.mode == p.mode and m.state ~= "over" and m.players < m.max then n += 1; humans += m.players end
			end
			status.Text = if n > 0 then '🌐 <font color="#7dff9f">' .. people(humans) .. "</font> en " .. modeName(p.mode) .. " : JOUER te place dans une de ces parties."
				else "🌐 Personne en " .. modeName(p.mode) .. " pour l'instant : JOUER crée une partie que les autres pourront rejoindre."
		end
	end
	showStatus(ctx.matchList)
	-- PARTIE RAPIDE : la deuxième façon de jouer, bien visible
	if not friends then
		local qb = K.btn(c3, "", "alt", function() ctx.quick(nil) end, { LayoutOrder = 5, Size = UDim2.new(1, 0, 0, 56) })
		text(qb, { Text = "⚡  " .. spaced("PARTIE RAPIDE", 2), Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 8), Font = K.BLACK, TextSize = 16,
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = qb.ZIndex + 1 })
		text(qb, { Text = spaced("mode et carte au hasard", 1), Size = UDim2.new(1, 0, 0, 14), Position = UDim2.fromOffset(0, 34), TextSize = 10, TextColor3 = C.dim,
			TextXAlignment = Enum.TextXAlignment.Center, ZIndex = qb.ZIndex + 1 })
		K.cut(qb, 10, K.rgb(0x0b111c))
	end

	-- parties en cours (MatchList) : joueurs humains, rejoignables
	local listBox: Frame? = nil
	local countL: TextLabel? = nil
	if not privateGame then
		local mc = K.card(c3, { LayoutOrder = 6 })
		local st = mc:FindFirstChildOfClass("UIStroke"); if st then st.Color = C.green; st.Transparency = 0.7 end
		K.vlist(mc, 6)
		-- « n joueurs en ligne » a sa place à droite du titre (il passait dessous)
		local h = K.h4(mc, "🌐 PARTIES EN COURS", "…", 0, C.green)
		countL = h:FindFirstChild("Small") :: TextLabel?
		K.para(mc, "Les joueurs comptés sont des vrais joueurs ; les bots ne sont pas comptés.", 11, C.dim, 1)
		local lb = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 2 }, mc)
		K.vlist(lb, 6)
		K.para(lb, "Recherche…", 12, C.dim)
		listBox = lb
	end
	matchToken += 1
	local myToken = matchToken
	local function fill(list: { any })
		-- pastilles des tuiles de mode
		local per: { [string]: number } = {}
		for _, m in ipairs(list) do if m.state ~= "over" then per[m.mode] = (per[m.mode] or 0) + m.players end end
		local any = false
		for id, lbl in pairs(liveBadges) do
			local n = per[id] or 0
			lbl.Visible = n > 0; lbl.Text = "👤 " .. n
			any = any or n > 0
		end
		legend.Visible = any
		showStatus(list)
		local box = listBox
		if not box then return end
		K.clear(box)
		local total = 0
		for _, m in ipairs(list) do total += m.players end
		if countL then countL.Text = people(total) .. " en ligne" end
		if #list == 0 then
			K.para(box, "Aucune partie pour l'instant. Appuie sur JOUER : ta partie apparaîtra ici pour les autres.", 12, C.dim)
			return
		end
		-- le mode choisi d'abord, puis les plus remplies
		local sorted = table.clone(list)
		table.sort(sorted, function(a, b)
			local sa, sb = (if a.mode == p.mode then 1000 else 0) + a.players, (if b.mode == p.mode then 1000 else 0) + b.players
			return sa > sb
		end)
		for i, m in ipairs(sorted) do
			if i > 8 then break end
			local mine = m.mode == p.mode
			local r = make("Frame", { Size = UDim2.new(1, 0, 0, 46), LayoutOrder = i, BackgroundTransparency = if mine then 0.9 else 0.95, BackgroundColor3 = if mine then C.green else C.white }, box)
			K.corner(r, 8); K.pad(r, 10, 0, 6, 0)
			local md = Modes.LIST[m.mode]
			local tl = if m.timeLeft and m.timeLeft >= 0 then string.format(" · %d:%02d", m.timeLeft // 60, m.timeLeft % 60) else ""
			local diff = Modes.DIFFS[m.diff or 3]
			text(r, { Size = UDim2.new(1, -112, 0, 18), Position = UDim2.fromOffset(0, 5), Font = K.BLACK, TextSize = 12, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
				Text = (if md then md.ic .. " " else "") .. K.esc(tostring(m.modeName)) .. '  <font color="#8da0bd">· ' .. K.esc(tostring(m.mapName)) .. "</font>" })
			text(r, { Size = UDim2.new(1, -112, 0, 14), Position = UDim2.fromOffset(0, 25), TextSize = 10, TextColor3 = C.dim, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd,
				Text = '<font color="#7dff9f">👤 ' .. m.players .. " / " .. m.max .. "</font> · bots " .. (if diff then diff.n else "") .. tl
					.. " · " .. (STATE_TEXT[tostring(m.state)] or tostring(m.state)) })
			local full = m.players >= m.max or m.state == "over"
			K.btn(r, if full then "PLEINE" else spaced("REJOINDRE", 1), if full then "dark" else "green", if full then nil else function() ctx.join(m.id) end,
				{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(100, 30), TextSize = 10 })
		end
	end
	if ctx.matchList then fill(ctx.matchList) end
	task.spawn(function()
		while area.Parent and myToken == matchToken and ctx.isOpen() do   -- (la page quitte son cadre de fondu : on suit « area »)
			local list = ctx.call("MatchList")
			if not area.Parent or myToken ~= matchToken then return end
			if typeof(list) == "table" then ctx.matchList = list; fill(list)
			elseif listBox then K.clear(listBox); K.para(listBox, "Liste indisponible pour le moment.", 12, C.dim) end
			task.wait(6)
		end
	end)

	-- ---------- réglages : seulement si une nouvelle partie est créée ----------
	local cfg = K.card(c3, { LayoutOrder = 7 })
	K.vlist(cfg, 8)
	K.h4(cfg, if privateGame then "⚙ RÉGLAGES DE LA PARTIE" else "⚙ RÉGLAGES D'UNE NOUVELLE PARTIE", nil, 0)
	K.para(cfg, if privateGame then "Ils comptent pour la partie de ton groupe." else "Si tu rejoins une partie en cours, ce sont ses réglages qui comptent.", 11, C.dim, 0)
	local function chips(order: number, parent: Instance?): Frame
		local f = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = order }, parent or cfg)
		K.hlist(f, 6, Enum.VerticalAlignment.Center, true)
		return f
	end
	-- difficulté des bots
	K.label(cfg, "NIVEAU DES BOTS", 1)
	local dRow = chips(2)
	for i, dd in ipairs(Modes.DIFFS) do
		local on = p.diff == i
		local col = K.rgb(DIFF_COL[i])
		local b = make("TextButton", { Text = spaced(K.upper(dd.n), 0), Font = K.BLACK, TextSize = 10, TextColor3 = if on then C.white else col, LayoutOrder = i,
			Size = UDim2.new(0.2, -5, 0, 36), BackgroundTransparency = 0, BackgroundColor3 = if on then col:Lerp(C.card, 0.75) else C.card, Selectable = true }, dRow)
		K.corner(b, 8); K.stroke(b, col, if on then 2 else 1, if on then 0 else 0.7)
		make("Frame", { Size = UDim2.new(1, -12, 0, 2), Position = UDim2.fromOffset(6, 0), BackgroundTransparency = 0, BackgroundColor3 = col }, b)
		K.juice(b, 0.05)
		b.Activated:Connect(function() set({ diff = i }) end)
	end
	K.para(cfg, (Modes.DIFFS[p.diff] and Modes.DIFFS[p.diff].desc) or "", 11, C.dim, 3)
	-- nombre de places
	K.label(cfg, if p.mode == "zombies" then "JOUEURS (COOP)" elseif def.team then "TAILLE DES ÉQUIPES" else "NOMBRE DE PLACES", 4)
	local sRow = chips(5)
	for i, n in ipairs(Modes.sizes(p.mode)) do
		local lab = if p.mode == "zombies" then n .. " joueur" .. (if n > 1 then "s" else "") elseif def.team then n .. " v " .. n else n .. " joueurs"
		K.chip(sRow, lab, p.size == n, function() set({ size = n }) end, { LayoutOrder = i })
	end
	-- plus d'options : camp, limite, économie, modificateurs, partie classée (rangés ici, résumés sur le bouton)
	local extras = {}
	if p.ranked and next(p.mut) == nil and X.RANKED_MODES[p.mode] then table.insert(extras, "Classé") end
	local nMut = 0; for _ in pairs(p.mut) do nMut += 1 end
	if nMut > 0 then table.insert(extras, nMut .. " modificateur" .. (if nMut > 1 then "s" else "")) end
	local more = ctx.moreOpen == true
	local mb = K.btn(cfg, (if more then "▾  " else "▸  ") .. spaced("PLUS D'OPTIONS", 2) .. (if #extras > 0 then '   <font color="#ffd23a">' .. table.concat(extras, " · ") .. "</font>" else ""),
		"ghost", function() ctx.moreOpen = not more; ctx.render() end,
		{ LayoutOrder = 6, Size = UDim2.new(1, 0, 0, 30), TextSize = 11, TextXAlignment = Enum.TextXAlignment.Left, BackgroundTransparency = 1, TextColor3 = C.dim })
	local mst = mb:FindFirstChildOfClass("UIStroke"); if mst then mst:Destroy() end
	make("Frame", { Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0.92, BackgroundColor3 = C.white, Position = UDim2.fromOffset(0, -3) }, mb)
	if more then
		local o = 7
		if def.team and p.mode ~= "zombies" then
			K.label(cfg, "TON CAMP", o, C.dim); o += 1
			local r = chips(o); o += 1
			for i, sd in ipairs({ { "t", "Attaquants (T)" }, { "ct", "Défenseurs (CT)" }, { "rnd", "Au hasard" } }) do
				K.chip(r, sd[2], p.side == sd[1], function() set({ side = sd[1] }) end, { LayoutOrder = i })
			end
		end
		if #def.limits > 0 then
			K.label(cfg, K.upper(def.limitLabel), o, C.dim); o += 1
			local r = chips(o); o += 1
			for i, l in ipairs(def.limits) do K.chip(r, tostring(l), p.limit == l, function() set({ limit = l }) end, { LayoutOrder = i }) end
		end
		if p.mode == "bomb" then
			K.label(cfg, "ARGENT ET ACHATS", o, C.dim); o += 1
			local r = chips(o); o += 1
			K.chip(r, "Réaliste", p.eco == 1, function() set({ eco = 1 }) end, { LayoutOrder = 1 })
			K.chip(r, "Armes libres", p.eco == 0, function() set({ eco = 0 }) end, { LayoutOrder = 2 })
		end
		-- modificateurs
		K.label(cfg, "MODIFICATEURS", 20, C.dim)
		K.para(cfg, "Des règles amusantes. Avec un modificateur, une nouvelle partie est toujours créée.", 11, C.dim, 21)
		local mg = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 22 }, cfg)
		K.grid(mg, UDim2.new(1 / 3, -6, 0, 62), 8)
		local active = {}
		for i, mu in ipairs(Modes.MUTATORS) do
			local on = p.mut[mu.k] == true
			if on then table.insert(active, mu.ic .. " " .. mu.d) end
			local b = make("TextButton", { Text = "", LayoutOrder = i, BackgroundTransparency = 0, BackgroundColor3 = if on then C.accent:Lerp(C.card, 0.7) else C.card, Selectable = true }, mg)
			K.corner(b, 8); K.stroke(b, if on then C.accent else C.white, if on then 2 else 1, if on then 0 else 0.92)
			text(b, { Text = mu.ic, Size = UDim2.new(1, 0, 0, 24), Position = UDim2.fromOffset(0, 6), TextSize = 18, TextXAlignment = Enum.TextXAlignment.Center })
			text(b, { Text = spaced(K.upper(mu.n), 0), Size = UDim2.new(1, -6, 0, 26), Position = UDim2.fromOffset(3, 32), TextSize = 9, Font = K.BLACK,
				TextXAlignment = Enum.TextXAlignment.Center, LineHeight = 1.0 })
			K.juice(b, 0.05)
			b.Activated:Connect(function()
				local mut = table.clone(p.mut); mut[mu.k] = if on then nil else true
				set({ mut = mut })
			end)
		end
		if #active > 0 then K.para(cfg, table.concat(active, "\n"), 11, C.dim, 23) end
		-- classé (web : cfg.ranked) : seulement dans les modes classés, désactivé avec des modificateurs
		if X.RANKED_MODES[p.mode] then
			local blocked = next(p.mut) ~= nil
			K.label(cfg, "PARTIE CLASSÉE", 24, C.dim)
			local rr = chips(25)
			local rb = K.chip(rr, (if p.ranked and not blocked then "🏆  " else "") .. spaced("CLASSÉ", 1), p.ranked == true and not blocked,
				if blocked then nil else function() set({ ranked = not p.ranked }) end, { LayoutOrder = 1, Name = "Ranked", Font = K.BLACK, TextSize = 12 }, C.gold)
			if blocked then rb.AutoButtonColor = false; rb.TextTransparency = 0.5; rb.Selectable = false end
			K.para(cfg, if blocked then "Indisponible avec des modificateurs." else "La victoire et la défaite comptent pour ton rang (PR). Tu joues avec ceux qui ont aussi choisi Classé.",
				11, C.dim, 26)
		end
	end
	-- résumé de la partie qui serait créée
	local sum = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 30, BackgroundTransparency = 0.15, BackgroundColor3 = C.panel }, cfg)
	K.corner(sum, 4); K.pad(sum, 16, 10)
	make("Frame", { Size = UDim2.new(0, 3, 1, 20), Position = UDim2.fromOffset(-16, -10), BackgroundTransparency = 0, BackgroundColor3 = C.gold }, sum)
	local size = if p.mode == "zombies" then p.size .. " joueur" .. (if p.size > 1 then "s" else "") elseif def.team then p.size .. " v " .. p.size else p.size .. " joueurs"
	local lim = if p.limit then " · " .. string.lower(def.limitLabel) .. " : " .. p.limit else ""
	K.para(sum, "<b>" .. modeName(p.mode) .. "</b> · " .. (Modes.MAP[p.map] and Modes.MAP[p.map].n or "") .. " · bots " .. Modes.DIFFS[p.diff].n .. " · " .. size .. lim
		.. (if p.ranked and next(p.mut) == nil and X.RANKED_MODES[p.mode] then " · <b>Classé</b>" else ""), 12, C.text)
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="824">
          <Properties>
            <string name="Name">Profile</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Profile (ModuleScript) — rubrique « Profil » (src/66_progress.js, src/86_meta_ui.js, src/8W_showcase.js)
-- Progression : classement, événement d'Halloween, passe de saison (ProgressService). Les défis sont sur l'Accueil
--               (un lien y mène) : avant, ils étaient aux deux endroits.
-- Statistiques : 8 tuiles, par mode, par carte, armes les plus efficaces (profil de GetProfile)
-- Pseudo et titre (id « Style ») : pseudo, couleur de pseudo Premium (LoyaltyService), titre de profil (MenuService).
--               La traînée de balles est rangée dans Arsenal › Tenues et effets, avec les autres effets.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local X = require(ReplicatedStorage.Shared.ConfigExtra)
local Modes = require(ReplicatedStorage.Shared.Modes)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local L = require(ReplicatedStorage.Shared.LoyaltyConfig)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local K = require(script.Parent.Kit)
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local function panel(parent: Instance, order: number, props: { [string]: any }?): Frame
	local f = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.12, BackgroundColor3 = K.rgb(0x0f1626) }, parent)
	K.stroke(f, C.white, 1, 0.9); K.pad(f, 16, 14); K.vlist(f, 8)
	if props then for k, v in pairs(props) do (f :: any)[k] = v end end
	return f
end
local function rewardText(r: any): string
	local t = {}
	if r.coins then table.insert(t, "+" .. r.coins .. " pièces") end
	if r.box then table.insert(t, "1 " .. (if r.box == "prem" then "Caisse Premium" else "Caisse Standard")) end
	if r.item then table.insert(t, "Skin " .. string.lower(Config.RARITY[r.rarity or 2].name)) end
	if r.dance then table.insert(t, "Danse " .. (Config.DANCES[r.dance] and Config.DANCES[r.dance].name or r.dance)) end
	return table.concat(t, " • ")
end

-- ======================= Progression =======================
local function progression(ctx: any, sc: ScrollingFrame)
	local d = ctx.data
	local profile = d and d.profile
	if not profile then K.para(sc, "Chargement du profil…", 13, C.dim); return end
	local W = ctx.W - 56
	-- défis : sur l'Accueil (un seul endroit), avec le nombre à récupérer
	local ready, total = 0, 0
	for _, list in ipairs({ ctx.ch and ctx.ch.daily or profile.missions and profile.missions.list or {}, ctx.ch and ctx.ch.weekly or profile.wmis and profile.wmis.list or {} }) do
		for _, m in ipairs(list) do total += 1; if m.done and not m.claimed then ready += 1 end end
	end
	local top = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 40) }, sc)
	text(top, { Text = "🎯  Défis du jour et de la semaine : " .. total .. (if ready > 0 then '  ·  <font color="#ffd23a">' .. ready .. " à récupérer</font>" else ""),
		Size = UDim2.new(1, -230, 1, 0), TextSize = 13, Font = K.MED, TextColor3 = C.sub, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	K.btn(top, spaced("VOIR LES DÉFIS", 1) .. "  ▸", if ready > 0 then "gold" else "alt", function() ctx.go("home") end,
		{ AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(210, 34), TextSize = 12 })
	-- classement
	local rank = profile.rank or { rp = 0, best = 0 }
	local rc = panel(sc, 2)
	local row = make("Frame", { Size = UDim2.new(1, 0, 0, 56), LayoutOrder = 1 }, rc)
	text(row, { Text = "🏅", TextSize = 34, Size = UDim2.fromOffset(50, 56) })
	text(row, { Text = spaced(string.upper(X.rankName(rank.rp or 0)), 2), Position = UDim2.fromOffset(56, 0), Size = UDim2.new(0.5, 0, 0, 30), Font = K.BLACK, TextSize = 24,
		TextColor3 = K.rgb(0xd08a4a), TextWrapped = false })
	text(row, { Text = ((rank.rp or 0) % X.RANK_RP_PER_DIVISION) .. " / " .. X.RANK_RP_PER_DIVISION .. " PR — meilleur : " .. X.rankName(rank.best or 0), Position = UDim2.fromOffset(56, 30),
		Size = UDim2.new(0.5, 0, 0, 14), TextSize = 11, TextColor3 = C.dim, TextWrapped = false })
	local bar = K.bar(row, ((rank.rp or 0) % X.RANK_RP_PER_DIVISION) / X.RANK_RP_PER_DIVISION, { Position = UDim2.fromOffset(56, 48), Size = UDim2.fromOffset(240, 5) })
	bar.Name = "RankBar"
	if W >= 900 then
		text(row, { Text = "Les parties compétitives, en équipe et de capture de zone contre des bots comptent pour le classement.", AnchorPoint = Vector2.new(1, 0),
			Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.4, 0, 1, 0), TextSize = 11, TextColor3 = C.sub })
	end
	-- événement
	local es: any = ctx.ev
	if (es and es.active) or (not es and d.eventActive) then
		local ev = make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x1d1408) }, sc)
		K.stroke(ev, C.orange, 1, 0.5); K.corner(ev, 8); K.pad(ev, 16, 14); K.vlist(ev, 8)
		local own = profile.ev and profile.ev.id == X.EVENT.id
		local pk: number = if es then (es.pumpkins or 0) elseif own then profile.ev.pumpkins or 0 else 0
		local claimed = if own then profile.ev.claimed or {} else {}
		local evName: string = if es and es.name then es.name else X.EVENT.name
		local evTo: string = if es and es.to then es.to else X.EVENT.to
		text(ev, { LayoutOrder = 1, Text = "🎃  " .. spaced("ÉVÉNEMENT : " .. string.upper(evName), 2), Font = K.BLACK, TextSize = 15, Size = UDim2.new(1, 0, 0, 20) })
		local y, mo, da = string.match(evTo, "(%d+)-(%d+)-(%d+)")
		K.para(ev, "Ramasse les citrouilles cachées sur les cartes jusqu'au " .. (if y then tostring(da) .. "/" .. tostring(mo) .. "/" .. tostring(y) else evTo) .. ". Citrouilles : <b>" .. pk .. "</b>", 12, C.text, 2)
		local gr = make("Frame", { LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, ev)
		K.hlist(gr, 8, Enum.VerticalAlignment.Center, true)
		local goals: { any } = if es and es.goals then es.goals else X.EVENT.goals
		for i, g in ipairs(goals) do
			local got = if es and es.goals then g.done == true else table.find(claimed, g.n) ~= nil
			local label = if es and es.goals and g.text then g.text else rewardText(g)
			local chip = text(gr, { LayoutOrder = i, Text = g.n .. " → " .. label .. (if got then "  ✔" else ""), AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 32),
				TextSize = 12, Font = K.BLACK, BackgroundTransparency = 0.2, BackgroundColor3 = if got then K.rgb(0x1f3a26) else C.navy, TextColor3 = if got then C.green else C.text, TextWrapped = false })
			K.pad(chip, 12, 0); K.stroke(chip, C.white, 1, 0.9)
		end
	end
	-- passe de saison
	local bp = profile.bp or { xp = 0, premium = false, claimedFree = {}, claimedPremium = {} }
	local tier = math.min(X.SEASON.tiers, math.floor((bp.xp or 0) / X.SEASON.xpPerTier))
	local sh = make("Frame", { LayoutOrder = 4, Size = UDim2.new(1, 0, 0, 36) }, sc)
	text(sh, { Text = "🎟  " .. spaced(string.upper(X.SEASON.name) .. " — PALIER " .. tier .. " / " .. X.SEASON.tiers, 2), Font = K.BLACK, TextSize = 15, Size = UDim2.new(1, -330, 1, 0), TextWrapped = false })
	if not bp.premium then
		K.btn(sh, "🎟  Passe de saison Premium — " .. K.fmt(X.SEASON.premiumCoins) .. " 💰", "alt", function()
			local ok = ctx.call("BP_BuyPremium")
			ctx.toast(if ok then "✔ Passe Premium débloqué !" else "Pas assez de pièces (ou Robux dans la Boutique)", if ok then C.gold else C.accent)
			ctx.refresh()
		end, { AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, 0, 0.5, 0), Size = UDim2.fromOffset(310, 32), TextSize = 12 })
	else
		text(sh, { Text = "🎟 PASSE DE SAISON PREMIUM ACTIF", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0, 300, 1, 0), TextColor3 = C.gold, Font = K.BLACK,
			TextXAlignment = Enum.TextXAlignment.Right })
	end
	local sp = panel(sc, 5)
	K.bar(sp, ((bp.xp or 0) % X.SEASON.xpPerTier) / X.SEASON.xpPerTier, { LayoutOrder = 1 })
	text(sp, { LayoutOrder = 2, Text = "Prochain palier : " .. ((bp.xp or 0) % X.SEASON.xpPerTier) .. " / " .. X.SEASON.xpPerTier .. " XP", TextSize = 11, TextColor3 = C.sub, Size = UDim2.new(1, 0, 0, 14) })
	local strip = K.scroll(sp, { Name = "SeasonTiers", LayoutOrder = 3, Size = UDim2.new(1, 0, 0, 150), ScrollingDirection = Enum.ScrollingDirection.X,
		AutomaticCanvasSize = Enum.AutomaticSize.X })
	K.hlist(strip, 8, Enum.VerticalAlignment.Top)
	for t = 1, X.SEASON.tiers do
		local reached = t <= tier
		local f = make("Frame", { LayoutOrder = t, Size = UDim2.fromOffset(132, 138), BackgroundTransparency = if reached then 0.1 else 0.4, BackgroundColor3 = C.card }, strip)
		K.corner(f, 6); K.stroke(f, if reached then C.gold else C.white, 1, if reached then 0.5 else 0.92)
		text(f, { Text = "PALIER " .. t, Size = UDim2.new(1, 0, 0, 16), Position = UDim2.fromOffset(0, 6), TextSize = 10, Font = K.BLACK, TextColor3 = if reached then C.gold else C.dim,
			TextXAlignment = Enum.TextXAlignment.Center })
		for j, prem in ipairs({ false, true }) do
			local r = X.bpReward(t, prem)
			local list = if prem then bp.claimedPremium or {} else bp.claimedFree or {}
			local got = table.find(list, t) ~= nil
			local y = 26 + (j - 1) * 56
			text(f, { Text = (if prem then "⭐ " else "") .. rewardText(r), Position = UDim2.fromOffset(6, y), Size = UDim2.new(1, -12, 0, 26), TextSize = 10, Font = K.MED,
				TextColor3 = if prem then C.gold else C.text, TextXAlignment = Enum.TextXAlignment.Center })
			if got then
				text(f, { Text = "✔ REÇU", Position = UDim2.fromOffset(0, y + 28), Size = UDim2.new(1, 0, 0, 20), TextSize = 10, TextColor3 = C.green, Font = K.BLACK,
					TextXAlignment = Enum.TextXAlignment.Center })
			elseif reached and (not prem or bp.premium) then
				K.btn(f, "RÉCUPÉRER", "gold", function()
					local res = ctx.call("BP_Claim", t, prem)
					if res then ctx.toast("✔ Palier " .. t .. " : " .. rewardText(res.reward or r), C.gold) end
					ctx.refresh()
				end, { Position = UDim2.fromOffset(14, y + 28), Size = UDim2.new(1, -28, 0, 22), TextSize = 10 })
			else
				text(f, { Text = "🔒", Position = UDim2.fromOffset(0, y + 28), Size = UDim2.new(1, 0, 0, 20), TextSize = 12, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center })
			end
		end
	end
end

-- ======================= Statistiques =======================
local function statistics(ctx: any, sc: ScrollingFrame)
	local profile = ctx.data and ctx.data.profile
	local s = profile and profile.stats or {}
	local W = ctx.W - 56
	local function n(k: string): number return tonumber(s[k]) or 0 end
	local hasMatches = n("matches") > 0
	local tiles: { { any } } = {
		{ tostring(n("matches")), "PARTIES", C.blue },
		{ if hasMatches then math.floor(n("wins") / n("matches") * 100 + 0.5) .. " %" else "—", "VICTOIRES", C.green },
		{ if n("deaths") > 0 or n("kills") > 0 then string.format("%.2f", n("kills") / math.max(1, n("deaths"))) else "—", "RATIO K/D", C.accent },
		{ if n("shots") > 0 then math.floor(n("hits") / n("shots") * 100 + 0.5) .. " %" else "—", "PRÉCISION", C.gold },
		{ if n("kills") > 0 then math.floor(n("hs") / n("kills") * 100 + 0.5) .. " %" else "—", "HEADSHOTS", K.rgb(0xff7a3a) },
		{ if hasMatches then tostring(math.floor(n("dmg") / n("matches"))) else "—", "DÉGÂTS / PARTIE", C.violet },
		{ tostring(n("bestStreak")), "MEILLEURE SÉRIE", C.gold },
		{ string.format("%dh%02d", n("seconds") // 3600, (n("seconds") % 3600) // 60), "TEMPS DE JEU", C.blue },
	}
	local g = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, sc)
	local per = if W >= 1000 then 4 else 2
	K.grid(g, UDim2.new(1 / per, -9, 0, 80), 12)
	for i, t in ipairs(tiles) do
		local f = make("Frame", { LayoutOrder = i, BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x0f1626) }, g)
		K.stroke(f, C.white, 1, 0.9)
		make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 0, BackgroundColor3 = t[3] }, f)
		text(f, { Text = t[1], Position = UDim2.fromOffset(0, 12), Size = UDim2.new(1, 0, 0, 32), Font = K.BLACK, TextSize = 28, TextXAlignment = Enum.TextXAlignment.Center })
		text(f, { Text = spaced(t[2], 2), Position = UDim2.fromOffset(0, 50), Size = UDim2.new(1, 0, 0, 14), TextSize = 10, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center })
	end
	local row = make("Frame", { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, sc)
	local two = W >= 1000
	if two then K.hlist(row, 14, Enum.VerticalAlignment.Top) else K.vlist(row, 12) end
	local left = panel(row, 1, { Size = UDim2.new(if two then 0.5 else 1, if two then -7 else 0, 0, 0) })
	local function line(parent: Instance, order: number, name: string, rec: any)
		local r = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 20) }, parent)
		text(r, { Text = name, Size = UDim2.new(0.25, 0, 1, 0), TextSize = 12, Font = K.MED, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		local m = if typeof(rec) == "table" then tonumber(rec.m) or 0 else 0
		local w = if typeof(rec) == "table" then tonumber(rec.w) or 0 else 0
		local b = K.bar(r, if m > 0 then w / m else 0, { Position = UDim2.new(0.27, 0, 0.5, -3), Size = UDim2.new(0.6, 0, 0, 6) }, C.green, C.green)
		b.Name = "Bar"
		text(r, { Text = if m > 0 then w .. " / " .. m .. " V" else "—", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.12, 0, 1, 0),
			TextSize = 11, TextXAlignment = Enum.TextXAlignment.Right, TextColor3 = C.sub })
	end
	K.label(left, "PAR MODE", 0, C.dim)
	local o = 0
	for _, grp in ipairs(Modes.GROUPS) do
		for _, id in ipairs(grp[2]) do o += 1; line(left, o, Modes.LIST[id].n, s.byMode and s.byMode[id]) end
	end
	o += 1; K.label(left, "PAR CARTE", o, C.dim)
	for _, m in ipairs(Modes.MAPS) do o += 1; line(left, o, m.n, s.byMap and s.byMap[m.id]) end
	local right = panel(row, 2, { Size = UDim2.new(if two then 0.5 else 1, if two then -7 else 0, 0, 0) })
	K.label(right, "ARMES LES PLUS EFFICACES (éliminations)", 0, C.dim)
	local ws = {}
	for k, v in pairs(s.byWeapon or {}) do if Config.WEAPONS[k] and (tonumber(v) or 0) > 0 then table.insert(ws, { k, tonumber(v) or 0 }) end end
	table.sort(ws, function(a, b) return a[2] > b[2] end)
	if #ws == 0 then K.para(right, "Joue des parties pour voir tes armes favorites.", 12, C.sub, 1) end
	for i = 1, math.min(8, #ws) do
		local r = make("Frame", { LayoutOrder = i, Size = UDim2.new(1, 0, 0, 24) }, right)
		text(r, { Text = i .. ". " .. Config.WEAPONS[ws[i][1]].name, Size = UDim2.new(0.4, 0, 1, 0), TextSize = 13, Font = K.BLACK, TextWrapped = false })
		K.bar(r, ws[i][2] / ws[1][2], { Position = UDim2.new(0.42, 0, 0.5, -3), Size = UDim2.new(0.45, 0, 0, 6) })
		text(r, { Text = tostring(ws[i][2]), AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.new(0.12, 0, 1, 0), TextSize = 12,
			TextXAlignment = Enum.TextXAlignment.Right })
	end
	-- records d'entraînement, carrière par arme et maîtrise (Menu/Career)
	local okC, errC = pcall(function() require(script.Parent.Career).stats(ctx, sc, 3) end)
	if not okC then warn("[Profile] carrière :", errC) end
end

-- ======================= Style =======================
local function style(ctx: any, sc: ScrollingFrame)
	local d = ctx.data
	local profile = d and d.profile
	local player = ctx.player
	local function chips(order: number): Frame
		local f = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, sc)
		K.hlist(f, 8, Enum.VerticalAlignment.Center, true)
		return f
	end
	-- choix avec niveau requis (sous-texte gris quand c'est verrouillé)
	local function choice(parent: Instance, order: number, label: string, on: boolean, lockText: string?, cb: () -> (), color: Color3?)
		local b = K.chip(parent, if lockText then label .. '\n<font size="9" color="#6f819e">' .. lockText .. "</font>" else label, on, cb,
			{ LayoutOrder = order, Size = UDim2.fromOffset(0, if lockText then 46 else 40), TextColor3 = color or (if lockText then C.dim else C.white) })
		if lockText then b.BackgroundTransparency = 0.6 end
	end
	K.label(sc, "PSEUDO", 1)
	local nb = text(sc, { LayoutOrder = 2, Text = "  " .. K.esc(player.DisplayName) .. '   <font color="#6f819e" size="11">(ton nom d\'affichage Roblox)</font>', Size = UDim2.fromOffset(460, 40),
		BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x111a2e), TextSize = 15, TextWrapped = false })
	K.stroke(nb, C.white, 1, 0.88)
	-- couleur de pseudo (Premium)
	local loy = ctx.loy
	K.label(sc, "COULEUR DU PSEUDO (PREMIUM)", 3)
	local cr = chips(4)
	for i, col in ipairs(L.VIP.colors) do
		local on = loy ~= nil and loy.vip and loy.vipColor == col.id
		choice(cr, i, "⭐ " .. col.name, on, if loy and loy.vip then nil else "Premium", function()
			if not (loy and loy.vip) then ctx.panel("vip"); return end
			ctx.call("Vip_SetColor", col.id); ctx.refresh()
		end, col.color)
	end
	-- titre de profil
	K.label(sc, "TITRE DE PROFIL", 5)
	local tr = chips(6)
	local cur = profile and profile.cosmetics and profile.cosmetics.title or ""
	local level = d and d.level or 1
	local function setTitle(id: string)
		if ctx.call("SetTitle", id) then ctx.toast(if id == "" then "Titre retiré" else "✔ Titre équipé", C.green) end
		ctx.refresh()
	end
	choice(tr, 0, "—", cur == "", nil, function() setTitle("") end)
	for i, t in ipairs(MenuConfig.TITLES) do
		local locked = level < t.lvl
		choice(tr, i, t.n, cur == t.id, if locked then "Niveau " .. t.lvl else nil, function()
			if locked then ctx.toast("Débloqué au niveau " .. t.lvl, C.gold); return end
			setTitle(t.id)
		end)
	end
	for i, id in ipairs(loy and loy.titles or {}) do
		if L.TITLES[id] then choice(tr, 100 + i, L.TITLES[id], cur == id, nil, function() setTitle(id) end, C.gold) end
	end
	-- carte de joueur : bannière et emblème (Menu/CardPicker)
	local okP, errP = pcall(function() require(script.Parent.CardPicker)(ctx, sc, 7) end)
	if not okP then warn("[Profile] carte de joueur :", errP) end
	K.para(sc, "La traînée de balles, les tenues, les danses et les effets se choisissent dans <b>Arsenal › Tenues et effets</b>.", 12, C.dim, 9)
end

return function(ctx: any, body: Frame, sub: string?)
	local sc = K.scroll(body, { Name = "Profile" .. tostring(sub) })
	K.vlist(sc, 14); K.pad(sc, 0, 0, 8, 12)
	if sub == "Statistiques" then statistics(ctx, sc)
	elseif sub == "Style" then style(ctx, sc)
	else progression(ctx, sc) end
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="825">
          <Properties>
            <string name="Name">Reroll</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Reroll (ModuleScript, client) — défis renouvelables, branché par Kit.mission :
--   • bouton « CHANGER » sur chaque défi du jour pas encore terminé (1 changement gratuit par jour, ensuite des pièces :
--     prix et nombre restant donnés par le serveur, GetChallenges.reroll ; un changement payant se confirme d'un 2e clic) ;
--   • la carte s'efface, le serveur tire un autre défi (remote RerollChallenge, tout est vérifié là-bas), puis la nouvelle
--     carte arrive en rebondissant (Menu/Fx) ;
--   • étiquette « DÉFI D'ARME DU JOUR » sur le 3e défi, reflet doré sur les défis prêts à récupérer.
local K = require(script.Parent.Kit)
local Fx = require(script.Parent.Fx)
local C = K.C

return function(ctx: any, card: Frame, top: Frame, m: any, i: number, weekly: boolean)
	local idx = m.index or i
	local key = (if weekly then "w" else "d") .. idx
	if ctx.fxIn == key then ctx.fxIn = nil; Fx.flipIn(card) end
	if m.weapon then
		K.text(card, { LayoutOrder = 0, Text = "🔫  " .. K.spaced("DÉFI D'ARME DU JOUR", 1), Font = K.BLACK, TextSize = 9, TextColor3 = C.gold,
			Size = UDim2.new(1, 0, 0, 12), TextWrapped = false })
	end
	if m.done and not m.claimed then Fx.sheen(card, 2.6) end
	if weekly or m.done or m.claimed then return end
	local rr = ctx.ch and ctx.ch.reroll
	if not rr or (rr.left or 0) <= 0 then return end
	local cost: number = rr.cost or 0
	local label = if cost <= 0 then "🔄  " .. K.spaced("CHANGER", 1) .. '  <font color="#7dff9f">gratuit</font>'
		else "🔄  " .. K.spaced("CHANGER", 1) .. '  <font color="#ffd23a">' .. cost .. " 💰</font>"
	local armed = false
	local b: TextButton
	b = K.btn(top, label, "alt", function()
		if ctx.rerolling then return end
		-- payant : un premier clic demande confirmation (3 s)
		if cost > 0 and not armed then
			armed = true
			b.Text = K.spaced("CONFIRMER", 1) .. '  <font color="#ffd23a">−' .. cost .. " 💰</font>"
			K.setBtnColor(b, K.rgb(0x7a3dff))
			task.delay(3, function()
				if armed and b.Parent then armed = false; b.Text = label; K.setBtnColor(b, K.rgb(0x1a2540)) end
			end)
			return
		end
		armed = false
		ctx.rerolling = true
		Fx.flipOut(card)
		local res = ctx.call("RerollChallenge", idx)
		ctx.rerolling = false
		if typeof(res) == "table" and res.ok then
			ctx.fxIn = key
			Fx.pop("🔄  Nouveau défi : " .. tostring(res.text), C.gold)
			if (res.cost or 0) > 0 then Fx.coins(-(res.cost :: number), b) end
			ctx.refresh()
		else
			ctx.toast("❌ " .. tostring(typeof(res) == "table" and res.err or "Impossible de changer ce défi"), C.accent)
		end
	end, { Name = "Reroll", AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0), Size = UDim2.fromOffset(104, 24), TextSize = 9 })
end
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="826">
          <Properties>
            <string name="Name">Settings</string>
            <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/Menu/Settings (ModuleScript) — rubrique « Réglages » (src/85_menu.js, src/68_access.js)
-- Général, Point de visée (id « Viseur »), Son, Accessibilité : Menu/Options (le même panneau que dans la pause, réglages
-- appliqués tout de suite et gardés dans le profil). Touches : les commandes du jeu Roblox. Noms et phrases d'aide des onglets :
-- MenuConfig.SETTINGS_TABS (la ligne d'aide est dessinée par MainMenu au-dessus de la page).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local K = require(script.Parent.Kit)
local Options = require(script.Parent.Options)
local C = K.C
local make, text = K.make, K.text

local function keys(ctx: any, sc: ScrollingFrame)
	local W = ctx.W - 56
	K.para(sc, "Les commandes du jeu Roblox (clavier · manette). Sur téléphone, les boutons tactiles s'affichent à l'écran.", 12, C.sub, 0)
	local g = make("Frame", { Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, LayoutOrder = 1 }, sc)
	K.grid(g, UDim2.new(if W >= 1000 then 0.5 else 1, -10, 0, 42), 8)
	for i, k in ipairs(MenuConfig.KEYS) do
		local r = make("Frame", { LayoutOrder = i, BackgroundTransparency = 0.1, BackgroundColor3 = K.rgb(0x111a2e) }, g)
		K.stroke(r, C.white, 1, 0.92); K.pad(r, 12, 0, 8, 0)
		text(r, { Text = k[1], Size = UDim2.new(1, -300, 1, 0), TextSize = 13, Font = K.MED, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		for j = 1, 2 do
			local box = text(r, { Text = k[j + 1], AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, if j == 1 then -126 else 0, 0.5, 0), Size = UDim2.fromOffset(if j == 1 then 160 else 118, 28),
				BackgroundTransparency = 0, BackgroundColor3 = K.rgb(0x1a2744), TextColor3 = if j == 1 then C.gold else C.blue, Font = K.BLACK, TextSize = 11,
				TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
			K.stroke(box, C.white, 1, 0.9)
		end
	end
end

return function(ctx: any, body: Frame, sub: string?)
	local sc = K.scroll(body, { Name = "Settings" .. tostring(sub) })
	K.vlist(sc, 14); K.pad(sc, 0, 4, 8, 12)
	if sub == "Touches" then keys(ctx, sc)
	else Options.build(sc, ctx.W - 56, sub, ctx.render) end
end
]]></string>
          </Properties>
        </Item>
      </Item>
      <Item class="LocalScript" referent="827">
        <Properties>
          <string name="Name">ModeHud</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ModeHud (LocalScript)
-- Interface des modes à objectifs, comme le web : lit la ligne « data » de TDMState (MatchService) et le dossier de la
-- carte de la partie.
--   Compétitif / Désamorçage rapide / Duel (Modes/rounds) : boutique (touche B pendant la phase d'achat, #buy du web),
--     argent, décompte 3-2-1, barre de pose / désamorçage (maintenir E), bombe portée / posée (chrono et bips),
--     marqueurs des sites A et B (grenades et mines : GrenadeController), positions révélées du Duel.
--   Capture de zone : état de la zone pour ton équipe, marqueur de la zone.
--   Domination : les trois drapeaux A B C (couleur, progression), texte du drapeau où tu te trouves (#domHud).
--   Capture du drapeau : état des deux drapeaux, « RAMÈNE LE DRAPEAU À TA BASE » (#ctfHud), marqueurs.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Modes = require(ReplicatedStorage.Shared.Modes)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local stateRemote = ReplicatedStorage:WaitForChild("TDMState") :: RemoteEvent

local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local C = {
	text = rgb(0xe8eef9), dim = rgb(0x8da0bd), gold = rgb(0xffd75e), good = rgb(0x7dff9f), bad = rgb(0xff6b6b),
	yellow = rgb(0xffd23a), bomb = rgb(0xffb938), panel = rgb(0x0e131e), panel2 = rgb(0x161e2e), line = rgb(0x2a3750), accent = rgb(0xff4655),
	Attaquants = rgb(0xff7a4a), ["Défenseurs"] = rgb(0x4aa3ff),
}
local T, CT = "Attaquants", "Défenseurs"
local ROUND_MODES = { bomb = true, rapid = true, duel = true, gunfight = true }
local function teamColor(t: string?): Color3 return (t and (C :: any)[t]) or C.text end
local function other(t: string?): string return if t == T then CT else T end

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 4) }, o) end
local function label(parent: Instance, props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = C.text, TextSize = 15, Text = "", TextStrokeTransparency = 0.5 }
	for k, v in pairs(props) do (base :: any)[k] = v end
	return make("TextLabel", base, parent)
end

local gui = make("ScreenGui", { Name = "ModeHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 11, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

-- ---------- état reçu ----------
local st: any = nil          -- dernier TDMState de ma partie
local data: any = nil        -- st.data (m.data.public du mode)
local mode = ""
local inMatch = false
local recvAt = 0
local function myTeam(): string? return player:GetAttribute("Team") :: string? end
local function myRoot(): BasePart?
	local ch = player.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not ch or not h or h.Health <= 0 then return nil end
	return ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local function remote(name: string): Instance? return ReplicatedStorage:FindFirstChild(name) end

-- ---------- panneau d'objectif (sous la ligne du mode du HUD) ----------
local objFrame = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 146), Size = UDim2.fromOffset(560, 64), BackgroundTransparency = 1, Visible = false }, gui)
local objLine = label(objFrame, { Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBlack })
local objSub = label(objFrame, { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 18), TextSize = 13, TextColor3 = C.dim })
local objCall = label(objFrame, { Position = UDim2.fromOffset(0, 42), Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBlack, TextColor3 = C.yellow })
-- drapeaux de Domination : trois ronds A B C avec la progression de capture
local domRow = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 146), Size = UDim2.fromOffset(140, 38), BackgroundTransparency = 1, Visible = false }, gui)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, HorizontalAlignment = Enum.HorizontalAlignment.Center, Padding = UDim.new(0, 10) }, domRow)
local domIcons: { { box: Frame, txt: TextLabel, bar: Frame, stroke: UIStroke } } = {}
for i, n in ipairs({ "A", "B", "C" }) do
	local box = make("Frame", { Size = UDim2.fromOffset(34, 34), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.5, ClipsDescendants = true, LayoutOrder = i }, domRow)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, box)
	local stroke = make("UIStroke", { Thickness = 3, Color = C.text, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, box)
	local txt = label(box, { Size = UDim2.fromScale(1, 1), Text = n, TextSize = 17, Font = Enum.Font.GothamBlack })
	local bar = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(0, 0, 0, 4), BackgroundColor3 = C.text }, box)
	domIcons[i] = { box = box, txt = txt, bar = bar, stroke = stroke }
end

-- ---------- argent, barre d'action, décompte ----------
local moneyLabel = label(gui, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -132), Size = UDim2.fromOffset(220, 26), TextSize = 22,
	Font = Enum.Font.GothamBlack, TextColor3 = rgb(0x7dff9f), TextXAlignment = Enum.TextXAlignment.Left, Visible = false })
local useWrap = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.68), Size = UDim2.fromOffset(320, 44), BackgroundTransparency = 1, Visible = false }, gui)
local useMsg = label(useWrap, { Size = UDim2.new(1, 0, 0, 20), TextSize = 15, Font = Enum.Font.GothamBlack, TextColor3 = C.bomb })
local useBack = make("Frame", { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 10), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4 }, useWrap)
corner(useBack, 5)
local useFill = make("Frame", { Size = UDim2.fromScale(0, 1), BackgroundColor3 = C.bomb }, useBack)
corner(useFill, 5)
local useHint = label(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.72), Size = UDim2.fromOffset(500, 22), TextSize = 16, TextColor3 = C.text, Visible = false })
local countdown = label(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.42), Size = UDim2.fromOffset(200, 120), TextSize = 96,
	Font = Enum.Font.GothamBlack, TextColor3 = C.gold, Text = "", TextTransparency = 1, TextStrokeTransparency = 1 })
local bombPanel = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 208), Size = UDim2.fromOffset(250, 34), BackgroundColor3 = Color3.fromRGB(60, 10, 10),
	BackgroundTransparency = 0.25, Visible = false }, gui)
corner(bombPanel, 5)
local bombText = label(bombPanel, { Size = UDim2.fromScale(1, 1), TextSize = 18, Font = Enum.Font.GothamBlack, TextColor3 = C.bomb })

-- ---------- boutons tactiles ----------
local touch = UserInputService.TouchEnabled
local function touchButton(text: string, pos: UDim2): TextButton
	local b = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = pos, Size = UDim2.fromOffset(78, 78), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.45,
		Text = text, TextColor3 = C.text, TextSize = 14, Font = Enum.Font.GothamBlack, Visible = false, AutoButtonColor = true }, gui)
	make("UICorner", { CornerRadius = UDim.new(1, 0) }, b)
	make("UIStroke", { Color = C.text, Transparency = 0.5, Thickness = 2, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, b)
	return b
end
local buyTouch = touchButton("ACHAT", UDim2.new(1, -230, 1, -260))
local useTouch = touchButton("E", UDim2.new(1, -140, 1, -300))

-- ---------- boutique (#buy du web) ----------
local buyWin = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.52), Size = UDim2.new(0.94, 0, 0.74, 0), BackgroundColor3 = C.panel,
	BackgroundTransparency = 0.06, Visible = false, ZIndex = 40 }, gui)
corner(buyWin, 6)
make("UISizeConstraint", { MaxSize = Vector2.new(1180, 640) }, buyWin)
make("UIStroke", { Color = C.line, Thickness = 1.5 }, buyWin)
local buyTitle = label(buyWin, { Position = UDim2.fromOffset(18, 10), Size = UDim2.new(0.5, 0, 0, 30), Text = "BOUTIQUE", TextSize = 24, Font = Enum.Font.GothamBlack,
	TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 41 })
local buyMoney = label(buyWin, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -60, 0, 10), Size = UDim2.fromOffset(260, 30), TextSize = 24, Font = Enum.Font.GothamBlack,
	TextColor3 = rgb(0x7dff9f), TextXAlignment = Enum.TextXAlignment.Right, ZIndex = 41 })
local buyClose = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 10), Size = UDim2.fromOffset(36, 30), BackgroundColor3 = C.panel2,
	Text = "✕", TextColor3 = C.text, TextSize = 18, Font = Enum.Font.GothamBlack, ZIndex = 41 }, buyWin)
corner(buyClose)
require(ReplicatedStorage.Shared.Icons).closeButton(buyClose, 13)   -- la croix U+2715 donne un carré vide
local buyInfo = label(buyWin, { Position = UDim2.new(0, 18, 1, -30), Size = UDim2.new(1, -36, 0, 22), TextSize = 13, TextColor3 = C.dim,
	TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 41 })
local buyGrid = make("ScrollingFrame", { Position = UDim2.fromOffset(12, 48), Size = UDim2.new(1, -24, 1, -84), BackgroundTransparency = 1, ScrollBarThickness = 6,
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.XY, ScrollingDirection = Enum.ScrollingDirection.XY, ZIndex = 41 }, buyWin)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8) }, buyGrid)

local buyState: any = nil
local buyOpen = false
local buyButtons: { { b: TextButton, k: string, n: string, price: number, slot: number? } } = {}
local function column(title: string, order: number): Frame
	local col = make("Frame", { Size = UDim2.fromOffset(170, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, LayoutOrder = order, ZIndex = 41 }, buyGrid)
	make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, col)
	label(col, { Size = UDim2.new(1, 0, 0, 20), Text = string.upper(title), TextSize = 13, Font = Enum.Font.GothamBlack, TextColor3 = C.dim,
		TextXAlignment = Enum.TextXAlignment.Left, LayoutOrder = 0, ZIndex = 41, TextStrokeTransparency = 1 })
	return col
end
local function itemButton(col: Frame, k: string, n: string, price: number, slot: number?, order: number)
	local b = make("TextButton", { Size = UDim2.new(1, 0, 0, 46), BackgroundColor3 = C.panel2, Text = "", AutoButtonColor = true, LayoutOrder = order, ZIndex = 42 }, col)
	corner(b)
	label(b, { Name = "N", Position = UDim2.fromOffset(8, 4), Size = UDim2.new(1, -16, 0, 20), Text = n, TextSize = 14, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 43, TextStrokeTransparency = 1 })
	label(b, { Name = "P", Position = UDim2.fromOffset(8, 24), Size = UDim2.new(1, -16, 0, 18), Text = "", TextSize = 12, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 43, TextStrokeTransparency = 1 })
	table.insert(buyButtons, { b = b, k = k, n = n, price = price, slot = slot })
	b.MouseButton1Click:Connect(function()
		local fn = remote("ModeBuy") :: RemoteFunction?
		if not fn then return end
		local ok, res = pcall(function() return fn:InvokeServer(k) end)
		if ok and res then
			buyState = res
			pcall(function() Sfx.play(if res.ok then "buy" else "deny") end)
		end
	end)
end
for i, cat in ipairs(Modes.BUY_CATS) do
	local col = column(cat.n, i)
	for j, k in ipairs(cat.list) do
		local w = Config.WEAPONS[k]
		itemButton(col, k, w.name, w.price, w.slot, j)
	end
end
local equip = column("Équipement", 99)
for j, it in ipairs(Modes.BUY_ITEMS) do itemButton(equip, it.k, it.n, it.price, nil, j) end

local function owned(k: string): boolean
	local s = buyState
	if not s then return false end
	if k == "armor" then return (s.armor or 0) >= 100 elseif k == "shield1" then return (s.shield or 0) >= 25
	elseif k == "shield2" then return (s.shield or 0) >= 50 elseif k == "kit" then return s.kit == true
	elseif k == "frag" then return (s.frag or 0) >= 1 elseif k == "flash" then return (s.flash or 0) >= 2
	elseif k == "smoke" then return (s.smoke or 0) >= 1 elseif k == "mine" then return (s.mine or 0) >= 2 end
	return s.primary == k or s.secondary == k
end
local function renderBuy()
	local s = buyState
	if not s then return end
	buyTitle.Text = if mode == "duel" then "CHOISIS TON ARME" elseif s.pistol then "BOUTIQUE — MANCHE AU PISTOLET" else "BOUTIQUE"
	buyMoney.Text = if s.free then "" else "$" .. tostring(s.money)
	buyInfo.Text = "Barres : dégâts · cadence · précision — le bouclier absorbe les dégâts avant le gilet et la santé. B ou Échap pour fermer."
	for _, e in ipairs(buyButtons) do
		local isKit = e.k == "kit"
		e.b.Visible = not isKit or (s.team == CT and s.bombMode)
		local own = owned(e.k)
		local pistolLock = s.pistol and e.slot == 0
		local can = (s.free or (s.money or 0) >= e.price) and not own and not pistolLock and s.phase == "freeze"
		local p = e.b:FindFirstChild("P") :: TextLabel
		p.Text = if own then "ÉQUIPÉ" elseif pistolLock then "MANCHE PISTOLET" elseif s.free then "GRATUIT" else "$" .. e.price
		p.TextColor3 = if own then C.good elseif can then C.gold else C.dim
		e.b.BackgroundColor3 = if own then rgb(0x1d3a2a) else C.panel2
		e.b.BackgroundTransparency = if can or own then 0 else 0.45
		e.b.Active = can; e.b.AutoButtonColor = can
	end
end
local function setBuy(on: boolean)
	if on == buyOpen then return end
	buyOpen = on
	buyWin.Visible = on
	player:SetAttribute("UiOpen", if on then true else nil)
	if on then
		task.spawn(function()
			local fn = remote("ModeBuy") :: RemoteFunction?
			if not fn then return end
			local ok, res = pcall(function() return fn:InvokeServer(nil) end)
			if ok and res then buyState = res; renderBuy() end
		end)
	end
end
buyClose.MouseButton1Click:Connect(function() setBuy(false) end)
buyTouch.MouseButton1Click:Connect(function() setBuy(not buyOpen) end)

local function roundPhase(): string? return if ROUND_MODES[mode] and data and data.kind == "rounds" then data.phase else nil end
-- 77 % : sous la bannière d'élimination (58 %), les messages du mode (64-66 %) et la barre de pose (68-72 %)
local toastLabel = label(gui, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.77), Size = UDim2.fromOffset(600, 24), TextSize = 17, TextColor3 = C.bad, Text = "" })
local toastToken = 0
local function toast(text: string)
	toastToken += 1
	local my = toastToken
	toastLabel.Text = text
	task.delay(1.6, function() if my == toastToken then toastLabel.Text = "" end end)
end

-- ---------- touches : B (boutique), E (poser / désamorcer) ----------
-- la touche B et la fenêtre de la boutique sont dans BuyMenu.client.lua (copie de #buy du web, tous les modes)

local holding = false
local function setUse(on: boolean)
	if on == holding then return end
	holding = on
	local ev = remote("ModeUse") :: RemoteEvent?
	if ev then ev:FireServer(on) end
end
-- Manette : « utiliser » est sur X comme dans Call of Duty (B reste « s'accroupir » / glisser). X sert aussi à recharger :
-- on ne le prend que si le serveur propose une action ici (UseHint) ou qu'une pose est en cours (UseProg), sinon il recharge.
local padUse = false
ContextActionService:BindActionAtPriority("ModeUse", function(_, state, input)
	if not inMatch or not ROUND_MODES[mode] then padUse = false; return Enum.ContextActionResult.Pass end
	if input.KeyCode == Enum.KeyCode.ButtonX then
		if state == Enum.UserInputState.Begin then
			if typeof(player:GetAttribute("UseHint")) ~= "string" and typeof(player:GetAttribute("UseProg")) ~= "number" then return Enum.ContextActionResult.Pass end
			padUse = true; setUse(true)
		elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then
			if not padUse then return Enum.ContextActionResult.Pass end
			padUse = false; setUse(false)
		end
		return Enum.ContextActionResult.Sink
	end
	if state == Enum.UserInputState.Begin then setUse(true) elseif state == Enum.UserInputState.End or state == Enum.UserInputState.Cancel then setUse(false) end
	return Enum.ContextActionResult.Sink
end, false, Enum.ContextActionPriority.High.Value, Enum.KeyCode.E, Enum.KeyCode.ButtonX)
useTouch.InputBegan:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then setUse(true) end
end)
useTouch.InputEnded:Connect(function(i)
	if i.UserInputType == Enum.UserInputType.Touch or i.UserInputType == Enum.UserInputType.MouseButton1 then setUse(false) end
end)

-- ---------- marqueurs dans le monde (sites, bombe, zone, drapeaux) ----------
local markerFolder = Instance.new("Folder"); markerFolder.Name = "ModeMarkers"; markerFolder.Parent = workspace.CurrentCamera
local markers: { [string]: { part: Part, bb: BillboardGui, txt: TextLabel, stroke: UIStroke } } = {}
local seen: { [string]: boolean } = {}
local function marker(id: string, pos: Vector3, text: string, color: Color3, size: number?)
	seen[id] = true
	local mk = markers[id]
	if not mk then
		local p = Instance.new("Part"); p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Transparency = 1
		p.Size = Vector3.new(0.2, 0.2, 0.2); p.Parent = markerFolder
		local bb = make("BillboardGui", { AlwaysOnTop = true, Size = UDim2.fromOffset(size or 34, size or 34), LightInfluence = 0, Adornee = p }, p)
		local txt = label(bb, { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(0, 0, 0), BackgroundTransparency = 0.4, TextScaled = true, Font = Enum.Font.GothamBlack, TextStrokeTransparency = 1 })
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, txt)
		local stroke = make("UIStroke", { Thickness = 2.5, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, txt)
		mk = { part = p, bb = bb, txt = txt, stroke = stroke }
		markers[id] = mk
	end
	mk.part.Position = pos
	mk.txt.Text = text; mk.txt.TextColor3 = color; mk.stroke.Color = color
end
local function sweepMarkers()
	for id, mk in pairs(markers) do
		if not seen[id] then mk.part:Destroy(); markers[id] = nil end
	end
	table.clear(seen)
end

-- positions révélées (Duel) : contour des ennemis
local revealed: { [Model]: Highlight } = {}
local function setReveal(on: boolean)
	local want: { [Model]: boolean } = {}
	if on then
		local mine, id = myTeam(), player:GetAttribute("MatchId")
		for _, p in ipairs(Players:GetPlayers()) do
			if p ~= player and p.Character and p:GetAttribute("MatchId") == id and p:GetAttribute("Team") ~= mine then want[p.Character] = true end
		end
		local bots = workspace:FindFirstChild("Bots")
		if bots then
			for _, b in ipairs(bots:GetChildren()) do
				if b:IsA("Model") and b:GetAttribute("MatchId") == id and b:GetAttribute("Team") ~= mine then want[b] = true end
			end
		end
	end
	for ch, h in pairs(revealed) do if not want[ch] or not ch.Parent then h:Destroy(); revealed[ch] = nil end end
	for ch in pairs(want) do
		if not revealed[ch] then
			revealed[ch] = make("Highlight", { FillColor = rgb(0xff7ad9), FillTransparency = 0.7, OutlineColor = rgb(0xff7ad9), DepthMode = Enum.HighlightDepthMode.AlwaysOnTop }, ch)
		end
	end
end

-- ---------- réception de l'état ----------
local lastPhaseKey = ""
stateRemote.OnClientEvent:Connect(function(s: any)
	inMatch = player:GetAttribute("Zone") == "match" and s.id == player:GetAttribute("MatchId") and s.state ~= "intermission"
	if not inMatch then st = nil; data = nil; mode = ""; return end
	st = s; data = s.data; mode = s.mode or ""; recvAt = os.clock()
	if buyOpen and (roundPhase() ~= "freeze" or s.state ~= "live") then setBuy(false) end
	-- nouvelle phase : on relit son inventaire (grenades, argent) auprès du serveur
	local key = tostring(data and data.round) .. ":" .. tostring(roundPhase())
	if roundPhase() and key ~= lastPhaseKey then
		lastPhaseKey = key
		task.spawn(function()
			local fn = remote("ModeBuy") :: RemoteFunction?
			if not fn then return end
			local ok, res = pcall(function() return fn:InvokeServer(nil) end)
			if ok and res then buyState = res end
		end)
	end
end)
player:GetAttributeChangedSignal("Zone"):Connect(function()
	if player:GetAttribute("Zone") ~= "match" then inMatch = false; st = nil; data = nil; mode = ""; setBuy(false) end
end)
player.CharacterAdded:Connect(function() setUse(false) end)

-- ---------- affichage, chaque image ----------
local lastCount, beepAt = -1, 0
local function pct(x: number): string return tostring(math.floor(x * 100 + 0.5)) .. " %" end

local function drawRounds(d: any, dtSince: number)
	local mine = myTeam()
	local char = player.Character
	local phase = d.phase
	-- argent
	local money = player:GetAttribute("Money")
	moneyLabel.Visible = typeof(money) == "number"
	moneyLabel.Text = if typeof(money) == "number" then (if money >= 16000 and mode ~= "bomb" then "$16000" else "$" .. tostring(money)) else ""
	if buyOpen then renderBuy() end
	buyTouch.Visible = false   -- bouton ACHAT : BuyMenu
	-- décompte 3-2-1 avant « C'EST PARTI »
	local left = math.max(0, (d.left or 0) - dtSince)
	if phase == "freeze" and left <= 3.2 and left > 0 then
		local n = math.ceil(left)
		if n ~= lastCount then lastCount = n; pcall(function() Sfx.play("tick") end) end
		countdown.Text = tostring(n); countdown.TextTransparency = 0; countdown.TextStrokeTransparency = 0.4
	else
		lastCount = -1; countdown.TextTransparency = 1; countdown.TextStrokeTransparency = 1
	end
	-- objectif personnel
	objFrame.Visible = true
	local b = d.bomb or {}
	local hasBomb = char ~= nil and char:GetAttribute("HasBomb") == true
	objLine.Text = ""; objSub.Text = ""; objCall.Text = ""
	if phase == "freeze" then
		objLine.Text = if mode == "gunfight" then "Mêmes armes pour tous : " .. tostring(d.kit or "…") elseif mode == "duel" then "Touche B : choisis ton arme" else "Touche B : boutique" .. (if d.pistol then " — pistolets uniquement" else "")
		objLine.TextColor3 = C.gold
	elseif phase == "live" and d.bombMode then
		if b.state == "planted" then
			objLine.Text = if mine == CT then "DÉSAMORCEZ LA BOMBE — SITE " .. tostring(b.site) else "DÉFENDEZ LA BOMBE — SITE " .. tostring(b.site)
			objLine.TextColor3 = C.bomb
		elseif hasBomb then
			objLine.Text = "💣 TU AS LA BOMBE — pose-la sur un site (maintiens E)"; objLine.TextColor3 = C.bomb
		elseif mine == T then
			objLine.Text = if b.state == "dropped" then "💣 BOMBE LÂCHÉE — récupère-la" elseif b.carrier then "💣 Bombe portée par " .. b.carrier else "Attaquez un site"
			objLine.TextColor3 = teamColor(T)
		else
			objLine.Text = "Défendez les sites A et B"; objLine.TextColor3 = teamColor(CT)
		end
	elseif phase == "live" and d.revealed then
		objLine.Text = "POSITIONS RÉVÉLÉES"; objLine.TextColor3 = rgb(0xff7ad9)
	end
	-- bombe posée : chrono et bips de plus en plus rapides (web : clamp(t / 40, 0.12, 1) × 0.9 s)
	if b.state == "planted" and b.left then
		local bl = math.max(0, b.left - dtSince)
		bombPanel.Visible = true
		bombText.Text = "💣 SITE " .. tostring(b.site) .. " — " .. string.format("%.1f", bl) .. " s"
		local now = os.clock()
		if now >= beepAt and bl > 0 then
			beepAt = now + math.clamp(bl / 40, 0.12, 1) * 0.9
			pcall(function() Sfx.play("beep", b.pos, 1.1) end)
		end
	else
		bombPanel.Visible = false
	end
	-- pose / désamorçage
	local prog = player:GetAttribute("UseProg")
	local msg = player:GetAttribute("UseMsg")
	local hint = player:GetAttribute("UseHint")
	useWrap.Visible = typeof(prog) == "number"
	if typeof(prog) == "number" then useFill.Size = UDim2.fromScale(prog, 1); useMsg.Text = if typeof(msg) == "string" then msg else "" end
	useHint.Visible = typeof(hint) == "string" and not useWrap.Visible
	-- à la manette, l'indication nomme le bouton X au lieu de la touche E
	local lit = UserInputService:GetLastInputType()
	local pad = lit == Enum.UserInputType.Gamepad1 or lit == Enum.UserInputType.Gamepad2
	useHint.Text = if typeof(hint) == "string" then (if pad then (hint:gsub("Maintenez E", "Maintenez X")) else hint) else ""
	useTouch.Visible = touch and (useWrap.Visible or useHint.Visible)
	-- marqueurs : sites, bombe
	if d.bombMode then
		for _, s in ipairs(d.sites or {}) do
			local here = b.state == "planted" and b.site == s.n
			marker("site" .. s.n, s.pos + Vector3.new(0, 9, 0), s.n, if here then C.bomb else C.text)
		end
		if b.pos and (b.state == "planted" or (b.state == "dropped" and mine == T)) then
			marker("bomb", b.pos + Vector3.new(0, 4, 0), "💣", C.bomb, 30)
		end
	end
	setReveal(d.revealed == true and phase == "live")
end

local function drawKoth(d: any)
	local mine = myTeam()
	objFrame.Visible = true
	objLine.Text = if d.contested then "ZONE DISPUTÉE" elseif d.owner == nil then "ZONE LIBRE — allez dessus !"
		elseif d.owner == mine then "VOTRE ÉQUIPE TIENT LA ZONE" else "L'ENNEMI TIENT LA ZONE"
	objLine.TextColor3 = if d.contested then C.yellow elseif d.owner then teamColor(d.owner) else C.text
	objSub.Text = "Prochaine zone " .. tostring(d.moveLeft or 0) .. " s"
	local r = myRoot()
	objCall.Text = if r and d.pos and (Vector3.new(r.Position.X - d.pos.X, 0, r.Position.Z - d.pos.Z)).Magnitude < (d.r or 0) then "TU ES DANS LA ZONE" else ""
	if d.pos then marker("koth", d.pos + Vector3.new(0, 12, 0), "⚑", if d.owner then teamColor(d.owner) elseif d.contested then C.yellow else C.text) end
end

local function drawDom(d: any)
	local mine = myTeam()
	domRow.Visible = true
	objFrame.Visible = true
	objFrame.Position = UDim2.new(0.5, 0, 0, 188)
	objLine.Text = ""; objSub.Text = ""; objCall.Text = ""
	local r = myRoot()
	for i, f in ipairs(d.flags or {}) do
		local icon = domIcons[i]
		if icon then
			local col = if f.contested then C.yellow elseif f.owner then teamColor(f.owner) else C.text
			icon.stroke.Color = col; icon.txt.TextColor3 = col
			icon.bar.Size = UDim2.new(f.prog or 0, 0, 0, 4)
			icon.bar.BackgroundColor3 = if f.cap then teamColor(f.cap) else C.text
		end
		marker("dom" .. f.n, f.pos + Vector3.new(0, 3.2 * Config.STUDS_PER_METER + 2, 0), f.n, if f.contested then C.yellow elseif f.owner then teamColor(f.owner) else C.text)
		if r and (Vector3.new(r.Position.X - f.pos.X, 0, r.Position.Z - f.pos.Z)).Magnitude < (d.r or 12) then
			objLine.Text = if f.contested then "DRAPEAU " .. f.n .. " DISPUTÉ" elseif f.owner == mine then "DRAPEAU " .. f.n .. " TENU"
				else "CAPTURE DE " .. f.n .. " — " .. pct(f.prog or 0)
			objLine.TextColor3 = C.text
		end
	end
end

local function drawCtf(d: any)
	local mine = myTeam() or T
	local flags = d.flags or {}
	local me, them = flags[mine], flags[other(mine)]
	if not me or not them then return end
	objFrame.Visible = true
	local function st(f: any): string
		if f.state == "home" then return "à la base" end
		if f.state == "dropped" then return "à terre " .. tostring(f.back or 0) .. " s" end
		if f.carrierUserId == player.UserId then return "TU LE PORTES" end
		return "porté par " .. tostring(f.carrier)
	end
	objLine.Text = "🚩 Le nôtre : " .. st(me); objLine.TextColor3 = teamColor(mine)
	objSub.Text = "🚩 Le leur : " .. st(them); objSub.TextColor3 = teamColor(other(mine))
	local char = player.Character
	local carrying = char ~= nil and char:GetAttribute("HasFlag") ~= nil
	objCall.Text = if carrying then "RAMÈNE LE DRAPEAU À TA BASE" .. (if me.state ~= "home" then " — RÉCUPÈRE D'ABORD LE TIEN" else "") else ""
	objCall.TextTransparency = if carrying then 0.25 + 0.25 * math.sin(os.clock() * 6) else 0
	for team, f in pairs(flags) do
		if not (f.state == "carried" and f.carrierUserId == player.UserId) then
			marker("ctf" .. team, f.pos + Vector3.new(0, 11, 0), "🚩", teamColor(team), 30)
		end
	end
end

RunService.RenderStepped:Connect(function()
	objFrame.Visible = false; domRow.Visible = false; objFrame.Position = UDim2.new(0.5, 0, 0, 146)
	objSub.TextColor3 = C.dim; objCall.TextTransparency = 0
	moneyLabel.Visible = false; useWrap.Visible = false; useHint.Visible = false; bombPanel.Visible = false
	buyTouch.Visible = false; useTouch.Visible = false
	local d = data
	if inMatch and st and st.state == "live" and not st.warmup and d then
		local since = os.clock() - recvAt
		if d.kind == "rounds" then drawRounds(d, since)
		elseif d.kind == "koth" then drawKoth(d)
		elseif d.kind == "dom" then drawDom(d)
		elseif d.kind == "ctf" then drawCtf(d) end
	end
	if not (d and d.kind == "rounds" and d.revealed) then setReveal(false) end
	if not (inMatch and d and d.kind == "rounds") then countdown.TextTransparency = 1; countdown.TextStrokeTransparency = 1 end
	sweepMarkers()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="828">
        <Properties>
          <string name="Name">MovementController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/MovementController (LocalScript)
-- Déplacements façon Call of Duty, mêmes règles que le jeu web (src/60m_move.js) :
--   Maj : sprint (reste actif tant qu'on avance) ; double appui : sprint tactique (jauge 3 s, recharge 5 s)
--   C ou Ctrl : s'accroupir ; en sprintant : glissade (0,8 s), un saut pendant la glissade l'annule en gardant l'élan
--   Saut face à un rebord (caisse, muret, plateforme), même en plein saut : escalade (enjamber ou se hisser)
-- Tirer ou viser coupe le sprint ; l'arme met un court instant à revenir (on ne tire pas en sprintant).
-- En plus, façon Call of Duty : inertie (on prend sa vitesse en ~0,3 s, plus vite au freinage), glissade dirigée
-- à la souris qui ralentit peu à peu, réception lourde qui freine un instant, jauge du sprint tactique sous le viseur.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local S = require(ReplicatedStorage.Shared.ClientState)
local A = require(ReplicatedStorage.Shared.Attachments)    -- mobilité des accessoires de l'armurier

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local MV = { SPR = 1.36, TAC = 1.62, TAC_DUR = 3, TAC_REC = 5, SLIDE_T = 0.8, SLIDE_CD = 0.9, OUT = 0.13, OUT_TAC = 0.24, CROUCH = 0.55 }
local BASE_SPEED = 16
local SLIDE_MIN = 30           -- vitesse de départ minimale d'une glissade (studs/s)
local CROUCH_CAM = -1.4        -- caméra abaissée accroupi
local SLIDE_CAM = -1.9
local STUDS = Config.STUDS_PER_METER
local HARD_LAND = -16 * STUDS  -- chute plus rapide que 16 m/s : réception lourde (on freine un instant)

local function smooth01(x: number): number x = math.clamp(x, 0, 1); return x * x * (3 - 2 * x) end
-- façon Call of Duty, selon la famille de l'arme en main : temps pour sortir du sprint avant de pouvoir tirer
-- (« sprint-to-fire ») et vitesse de marche en pleine visée
local OUT_CAT: { [string]: number } = { melee = 0.5, pistol = 0.75, smg = 0.85, rifle = 1, shotgun = 1, sniper = 1.4, lmg = 1.5 }
local ADS_MOVE: { [string]: number } = { pistol = 0.85, smg = 0.82, rifle = 0.75, shotgun = 0.78, sniper = 0.6, lmg = 0.62 }
local function catOf(): string
	local w = S.weapon and Config.WEAPONS[S.weapon]
	return if w then (if w.melee then "melee" else w.cat) else "rifle"
end

local st = { tacE = 1, lastTap = -9, slideT = 0, slideCd = 0, slideDir = Vector3.zero, slideV = 0, slideV0 = 0, camY = 0, camV = 0, crouchKey = false,
	jl = 0, ws = BASE_SPEED, fall = 0, heavyT = 0 }
local slideVel: LinearVelocity? = nil

local Sfx = require(ReplicatedStorage.Shared.Sfx)
local function sound(def: any) Sfx.play(def) end

local function parts(): (Humanoid?, BasePart?)
	local char = player.Character
	if not char then return nil, nil end
	return char:FindFirstChildOfClass("Humanoid"), char:FindFirstChild("HumanoidRootPart") :: BasePart?
end

local function stopSprint()
	if not S.sprint then return end
	S.fireBlockedUntil = math.max(S.fireBlockedUntil, os.clock() + (if S.tactical then MV.OUT_TAC else MV.OUT) * (OUT_CAT[catOf()] or 1))
	S.sprint = false; S.tactical = false
end

local function endSlide()
	S.slide = false
	if slideVel then slideVel:Destroy(); slideVel = nil end
end

-- une scène tient la caméra (arrivée en hélico / véhicule, kill-cam) ou un panneau est ouvert (pause, boutique, photo) :
-- ni sprint, ni accroupi, ni glissade, ni escalade (sinon on ressortait de la scène accroupi ou en plein geste)
local function blocked(): boolean
	return S.kc ~= nil or player:GetAttribute("UiOpen") == true
end

local function forwardInput(hum: Humanoid): boolean
	local md = hum.MoveDirection
	if md.Magnitude < 0.1 then return false end
	local look = camera.CFrame.LookVector
	return Vector3.new(look.X, 0, look.Z).Unit:Dot(md.Unit) > 0.5
end

-- ---------- escalade ----------
-- Comme mvLedge / mvMantle du web : un rebord entre 0,56 et 2,15 m devant soi, avec de la place pour se tenir debout.
-- Rebord bas (muret, barrière, caisse basse) : on l'enjambe s'il y a du vide derrière, sinon on monte dessus ;
-- rebord haut : on se hisse (mains sur le rebord, arme baissée : ViewmodelController / SoldierAnim).
-- Le mouvement est interpolé (le corps monte puis avance), le Humanoid passe en état Physics le temps du geste.
type Mantle = { t: number, dur: number, p0: Vector3, p1: Vector3, peak: number, over: boolean, rot: CFrame }
local mt: Mantle? = nil
local LOW_REL = 1.15                -- au-dessus (m) : rebord haut, on se hisse à deux mains

local function isBody(r: RaycastResult): boolean
	local m = r.Instance:FindFirstAncestorOfClass("Model")
	return m ~= nil and m:FindFirstChildOfClass("Humanoid") ~= nil
end

local function tryMantle(hum: Humanoid, root: BasePart): boolean
	if mt or S.mantle then return false end
	local look = camera.CFrame.LookVector
	local fwd = Vector3.new(look.X, 0, look.Z)
	if fwd.Magnitude < 0.1 then return false end
	fwd = fwd.Unit
	local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character :: Instance, camera }
	local stand = hum.HipHeight + root.Size.Y / 2                 -- hauteur du centre du corps au-dessus des pieds
	local feet = root.Position - Vector3.new(0, stand, 0)
	-- un obstacle juste devant : genoux, taille ou poitrine (le plus proche)
	local wall: RaycastResult? = nil
	for _, y in ipairs({ 1.2, 2.8, 4.6 }) do
		local r = workspace:Raycast(feet + Vector3.new(0, y, 0), fwd * 3.2, params)
		if r and not isBody(r) and (not wall or r.Distance < (wall :: RaycastResult).Distance) then wall = r end
	end
	if not wall then return false end
	-- son dessus : entre 0,56 et 2,15 m (comme le web), à peu près plat
	local d = wall.Distance
	local top = workspace:Raycast(feet + fwd * (d + 0.9) + Vector3.new(0, 8.4, 0), Vector3.new(0, -8.4, 0), params)
	if not top or isBody(top) or top.Normal.Y < 0.7 then return false end
	local h = top.Position.Y - feet.Y
	local rel = h / STUDS
	if rel < 0.56 or rel > 2.15 then return false end
	-- place pour se tenir debout au-dessus du rebord, et pas de plafond au-dessus de nous
	if workspace:Raycast(top.Position + Vector3.new(0, 0.2, 0), Vector3.new(0, 5.2, 0), params) then return false end
	if workspace:Raycast(root.Position, Vector3.new(0, h + 1.5, 0), params) then return false end
	local p0 = root.Position
	local edge = feet + fwd * (d + 1.5)                         -- bien posé sur le dessus, pas au bord…
	local deep = workspace:Raycast(Vector3.new(edge.X, top.Position.Y + 1, edge.Z), Vector3.new(0, -1.6, 0), params)
	if not deep then edge = feet + fwd * (d + 0.9) end          -- …sauf si le dessus est étroit
	local onTop = Vector3.new(edge.X, top.Position.Y + stand + 0.05, edge.Z)
	local m: Mantle = { t = 0, dur = 0.26 + 0.12 * rel, p0 = p0, p1 = onTop, peak = onTop.Y, over = false,
		rot = root.CFrame.Rotation }
	-- rebord bas et étroit (muret, barrière) : vide derrière, on passe par-dessus et on retombe de l'autre côté
	if rel <= LOW_REL then
		local beyond = feet + fwd * (d + 2.8)
		local clear = not workspace:Raycast(top.Position + Vector3.new(0, 2.6, 0) - fwd * (d + 0.9), fwd * (d + 3.4), params)
		local far = workspace:Raycast(beyond + Vector3.new(0, h + 1, 0), Vector3.new(0, -(h + 6), 0), params)
		if clear and far and not isBody(far) and far.Position.Y < top.Position.Y - 1.5 then
			m.over = true
			m.p1 = Vector3.new(far.Position.X, math.max(far.Position.Y + stand, p0.Y - 3), far.Position.Z)
			m.peak = top.Position.Y + stand + 0.6
			m.dur = 0.42 + 0.08 * rel
		end
	end
	endSlide(); stopSprint()
	mt = m
	S.mantle = true; S.mantleT = os.clock(); S.mantleDur = m.dur; S.mantleHigh = rel > LOW_REL and not m.over
	S.fireBlockedUntil = math.max(S.fireBlockedUntil, os.clock() + m.dur + 0.05)
	S.crouch = false
	pcall(function() hum:ChangeState(Enum.HumanoidStateType.Physics) end)
	root.AssemblyLinearVelocity = Vector3.zero
	-- le bruit des mains sur le rebord est joué par AmbienceController (Sfx.foley("climb")) : pas de doublon ici
	return true
end

-- position du corps pendant l'escalade (0..1) : monter d'abord, avancer ensuite (mvMantle du web)
local function mantlePos(m: Mantle, a: number): Vector3
	if m.over then
		-- enjamber : on monte au-dessus du rebord en avançant, puis on redescend de l'autre côté
		local fw = smooth01(a)
		local y = if a < 0.45 then m.p0.Y + (m.peak - m.p0.Y) * smooth01(a / 0.45)
			else m.peak + (m.p1.Y - m.peak) * smooth01((a - 0.45) / 0.55) ^ 1.6
		local xz = m.p0:Lerp(m.p1, fw)
		return Vector3.new(xz.X, y, xz.Z)
	end
	local up = smooth01(math.min(1, a / 0.55))
	local fw = smooth01(math.clamp((a - 0.28) / 0.72, 0, 1))
	local xz = m.p0:Lerp(m.p1, fw)
	return Vector3.new(xz.X, m.p0.Y + (m.p1.Y + 0.12 - m.p0.Y) * up, xz.Z)
end

local function endMantle(hum: Humanoid?, root: BasePart?)
	local m = mt
	mt = nil
	S.mantle = false
	if not m or not hum or not root then return end
	if hum.Health > 0 then
		root.CFrame = CFrame.new(m.p1) * m.rot
		root.AssemblyLinearVelocity = if m.over then m.rot.LookVector * 6 else Vector3.zero
		pcall(function() hum:ChangeState(if m.over then Enum.HumanoidStateType.Freefall else Enum.HumanoidStateType.Running) end)
		st.jl = os.clock() + 0.35                -- pas de saut tout de suite après (mvState.jl du web)
		Sfx.play("land", nil, 0.3)
	end
end

local function mantleStep(dt: number)
	local m = mt
	if not m then return end
	local hum, root = parts()
	if not hum or not root or hum.Health <= 0 then endMantle(nil, nil); return end
	m.t += dt
	local a = math.min(1, m.t / m.dur)
	if a >= 1 then endMantle(hum, root); return end
	root.CFrame = CFrame.new(mantlePos(m, a)) * m.rot
	root.AssemblyLinearVelocity = Vector3.zero
end

-- ---------- commandes ----------
local function onSprint(_: string, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	local hum = parts()
	if not hum or S.slide or S.mantle or blocked() or not forwardInput(hum) then return Enum.ContextActionResult.Pass end
	local t = os.clock()
	if S.sprint and t - st.lastTap < 0.35 and st.tacE > 0.3 then S.tactical = true end
	S.sprint = true; S.crouch = false; st.lastTap = t
	return Enum.ContextActionResult.Pass
end

local function onCrouch(_: string, state: Enum.UserInputState)
	if state == Enum.UserInputState.Begin then
		st.crouchKey = true
		if S.mantle or blocked() then return Enum.ContextActionResult.Sink end
		local hum, root = parts()
		if hum and root and S.sprint and st.slideCd <= 0 and hum.FloorMaterial ~= Enum.Material.Air then
			local v = Vector3.new(root.AssemblyLinearVelocity.X, 0, root.AssemblyLinearVelocity.Z)
			if v.Magnitude > BASE_SPEED * 0.95 then
				-- glissade : vitesse imposée qui décroît, caméra basse, arme inclinée (viewmodel)
				S.slide = true; st.slideT = 0; st.slideCd = MV.SLIDE_CD
				st.slideDir = v.Unit; st.slideV = math.max(v.Magnitude * 1.22, SLIDE_MIN); st.slideV0 = st.slideV
				S.sprint = false; S.tactical = false
				local att = root:FindFirstChild("RootAttachment") :: Attachment?
				if att then
					local lv = Instance.new("LinearVelocity"); lv.Attachment0 = att
					lv.VelocityConstraintMode = Enum.VelocityConstraintMode.Plane
					lv.PrimaryTangentAxis = Vector3.xAxis; lv.SecondaryTangentAxis = Vector3.zAxis
					lv.RelativeTo = Enum.ActuatorRelativeTo.World
					lv.MaxForce = 1e6; lv.PlaneVelocity = Vector2.new(st.slideDir.X, st.slideDir.Z) * st.slideV
					lv.Parent = root
					slideVel = lv
				end
				sound(ModeConfig.SOUNDS.slide)
				return Enum.ContextActionResult.Sink
			end
		end
		S.crouch = not S.crouch                  -- appui = bascule accroupi / debout
		if S.crouch then stopSprint() end
	elseif state == Enum.UserInputState.End then
		st.crouchKey = false
	end
	return Enum.ContextActionResult.Sink
end

ContextActionService:BindAction("Sprint", onSprint, true, Enum.KeyCode.LeftShift, Enum.KeyCode.ButtonL3)
ContextActionService:BindAction("Crouch", onCrouch, true, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.ButtonB)
ContextActionService:SetTitle("Sprint", "Sprint"); ContextActionService:SetTitle("Crouch", "Accr.")
ContextActionService:SetPosition("Sprint", UDim2.new(1, -230, 1, -120)); ContextActionService:SetPosition("Crouch", UDim2.new(1, -230, 1, -60))

-- saut : annule la glissade (en gardant l'élan) ou lance une escalade
UserInputService.JumpRequest:Connect(function()
	local hum, root = parts()
	if not hum or not root or hum.WalkSpeed == 0 or S.mantle or blocked() then return end
	if S.slide and st.slideT > 0.08 then
		local keep = st.slideDir * st.slideV
		endSlide()
		S.crouch = false
		hum:ChangeState(Enum.HumanoidStateType.Jumping)
		root.AssemblyLinearVelocity = Vector3.new(keep.X, root.AssemblyLinearVelocity.Y, keep.Z)
		return
	end
	if S.crouch then S.crouch = false end
	-- en avançant (ou à l'arrêt face au rebord), pas en reculant
	if os.clock() > st.jl and (forwardInput(hum) or hum.MoveDirection.Magnitude < 0.1) then tryMantle(hum, root) end
end)

-- ---------- jauge du sprint tactique (mvHud du web) : petite barre sous le viseur ----------
-- (10 px sous la barre de recharge de HudController, posée à +46 : les deux se superposaient)
local tacGui = Instance.new("ScreenGui"); tacGui.Name = "TacBar"; tacGui.ResetOnSpawn = false; tacGui.IgnoreGuiInset = true
tacGui.DisplayOrder = 4; tacGui.Parent = player:WaitForChild("PlayerGui")
local tacBg = Instance.new("Frame"); tacBg.AnchorPoint = Vector2.new(0.5, 0); tacBg.Position = UDim2.new(0.5, 0, 0.5, 56)
tacBg.Size = UDim2.fromOffset(64, 4); tacBg.BackgroundColor3 = Color3.new(0, 0, 0); tacBg.BackgroundTransparency = 1
tacBg.BorderSizePixel = 0; tacBg.Parent = tacGui
local tacCorner = Instance.new("UICorner"); tacCorner.CornerRadius = UDim.new(0, 3); tacCorner.Parent = tacBg
local tacFill = Instance.new("Frame"); tacFill.Size = UDim2.fromScale(1, 1); tacFill.BackgroundColor3 = Color3.fromRGB(255, 179, 92)
tacFill.BackgroundTransparency = 1; tacFill.BorderSizePixel = 0; tacFill.Parent = tacBg
local fillCorner = Instance.new("UICorner"); fillCorner.CornerRadius = UDim.new(0, 3); fillCorner.Parent = tacFill
local tacShow = 0
local function tacHud(dt: number, alive: boolean)
	local show = alive and (S.tactical or st.tacE < 0.999)
	tacShow += ((if show then 1 else 0) - tacShow) * math.min(1, dt * 7)
	tacBg.BackgroundTransparency = 1 - tacShow * 0.5
	tacFill.BackgroundTransparency = 1 - tacShow
	tacFill.Size = UDim2.fromScale(st.tacE, 1)
end

-- ---------- boucle ----------
-- l'escalade déplace le corps juste avant la physique (le Humanoid est en état Physics pendant le geste)
local okPre = pcall(function() RunService.PreSimulation:Connect(mantleStep) end)
if not okPre then RunService.Stepped:Connect(function(_, dt: number) mantleStep(dt) end) end

RunService.RenderStepped:Connect(function(dt: number)
	local hum, root = parts()
	if not hum or not root or hum.Health <= 0 then
		S.sprint = false; S.tactical = false; S.crouch = false; endSlide()
		if mt then endMantle(nil, nil) end
		tacHud(dt, false)
		return
	end
	st.slideCd = math.max(0, st.slideCd - dt)
	-- l'arrivée prend la main en plein geste : on termine l'escalade, on coupe glissade, sprint et accroupi
	if S.kc ~= nil then
		if mt then endMantle(hum, root) end
		if S.slide then endSlide() end
		S.sprint = false; S.tactical = false; S.crouch = false
	end
	local v = root.AssemblyLinearVelocity
	S.speed = Vector3.new(v.X, 0, v.Z).Magnitude; S.vy = v.Y
	S.grounded = hum.FloorMaterial ~= Enum.Material.Air
	if mt then S.speed = 0; S.vy = 0; S.grounded = true end      -- pendant l'escalade : ni balancement ni « réception »

	-- escalade en plein saut : touche de saut tenue face à un rebord, pas en pleine montée (mvTryMantle du web)
	if not mt and not S.grounded and hum.Jump and hum.WalkSpeed > 0 and not blocked() and os.clock() > st.jl and v.Y < 4.5 * STUDS and forwardInput(hum) then
		tryMantle(hum, root)
	end

	-- réception lourde : après une grosse chute, on freine un court instant (comme les jeux COD)
	if not S.grounded then st.fall = math.min(st.fall, v.Y)
	else
		if st.fall < HARD_LAND then st.heavyT = 0.3 end
		st.fall = 0
	end
	st.heavyT = math.max(0, st.heavyT - dt)

	-- ce qui coupe le sprint : ne plus avancer, viser, tirer (WeaponController), s'accroupir
	if S.sprint and (not forwardInput(hum) or S.aiming or S.firing) then stopSprint() end
	if S.tactical then
		st.tacE -= dt / MV.TAC_DUR
		if st.tacE <= 0 then st.tacE = 0; S.tactical = false end
	else
		st.tacE = math.min(1, st.tacE + dt / MV.TAC_REC)
	end
	S.tacE = st.tacE
	tacHud(dt, true)

	-- glissade (mvSlide du web) : la vitesse décroît en k² jusqu'à 45 % de la course, on l'infléchit un peu à la souris
	if S.slide then
		st.slideT += dt
		local k = math.min(1, st.slideT / MV.SLIDE_T)
		st.slideV = st.slideV0 + (BASE_SPEED * 0.45 - st.slideV0) * k * k
		local look = camera.CFrame.LookVector
		local yv = Vector3.new(look.X, 0, look.Z)
		if yv.Magnitude > 0.1 then
			local nd = st.slideDir + (yv.Unit - st.slideDir) * math.min(1, dt * 0.8)
			if nd.Magnitude > 1e-3 then st.slideDir = nd.Unit end
		end
		if slideVel then slideVel.PlaneVelocity = Vector2.new(st.slideDir.X, st.slideDir.Z) * st.slideV end
		if k >= 1 or (not S.grounded and st.slideT > 0.15) then
			endSlide()
			S.crouch = st.crouchKey               -- touche encore enfoncée : on finit accroupi
		end
	end

	-- vitesse : le serveur met WalkSpeed à 0 pour figer un joueur (fin de partie, décompte d'un duel) : on n'y touche pas
	if hum.WalkSpeed > 0 then
		local w = S.weapon and Config.WEAPONS[S.weapon]
		-- poids de l'arme (vitesses du web : M249 plus lente, couteau plus rapide…) × mobilité des accessoires
		local mult = (if w and S.weapon then w.speed * A.modsOf(A.activeOf(player, S.weapon)).mob else 1)
		if S.sprint then mult *= if S.tactical then MV.TAC else MV.SPR
		elseif S.crouch then mult *= MV.CROUCH end
		-- visée : on ralentit au fil de la mise en joue (visée lissée du viewmodel), plus fort avec une arme lourde
		if not S.sprint then mult *= 1 + ((ADS_MOVE[catOf()] or 0.75) - 1) * math.clamp(S.adsT, 0, 1) end
		if st.heavyT > 0 then mult *= 0.55 end
		local ch = hum.Parent
		local target = BASE_SPEED * mult * ((ch and ch:GetAttribute("SpeedMult") :: number?) or 1)   -- modificateur « Turbo »
		-- inertie : on repart d'un peu plus de la moitié de la vitesse et on monte vite, on freine plus vite encore ;
		-- en l'air on garde son élan (saut en sprint)
		if math.abs(hum.WalkSpeed - st.ws) > 0.5 then st.ws = hum.WalkSpeed end     -- changée par un autre script
		if S.grounded and hum.MoveDirection.Magnitude < 0.1 then
			st.ws = math.min(target, BASE_SPEED * 0.55 * mult)
		elseif S.grounded then
			st.ws += (target - st.ws) * math.min(1, dt * (if target > st.ws then 7 else 14))
		elseif target > st.ws then
			st.ws += (target - st.ws) * math.min(1, dt * 2)        -- en l'air : on accélère à peine
		end
		st.ws = math.max(st.ws, 0.1)
		hum.WalkSpeed = st.ws
	end

	-- caméra plus basse accroupi / en glissade : ressort amorti (départ et arrivée en douceur, sans à-coup),
	-- descente plus vive en glissade, relevé un peu plus lent que l'accroupi (on « pousse » sur les jambes)
	local camTarget = if S.slide then SLIDE_CAM elseif S.crouch then CROUCH_CAM else 0
	local k = if S.slide then 260 elseif camTarget < st.camY then 150 else 110
	local sd = math.min(dt, 1 / 30)
	st.camV += ((camTarget - st.camY) * k - st.camV * 2 * math.sqrt(k)) * sd
	st.camY += st.camV * sd
	if st.camY < SLIDE_CAM - 0.2 then st.camY = SLIDE_CAM - 0.2; st.camV = 0 elseif st.camY > 0.05 then st.camY = 0.05; st.camV = 0 end
	hum.CameraOffset = Vector3.new(0, st.camY, 0)
end)

player.CharacterAdded:Connect(function()
	S.sprint = false; S.tactical = false; S.crouch = false; S.mantle = false; mt = nil; endSlide()
	st.tacE = 1; st.camY = 0; st.camV = 0; st.ws = BASE_SPEED; st.fall = 0; st.heavyT = 0
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="829">
        <Properties>
          <string name="Name">NetController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/NetController (LocalScript)
-- Ping (affiché + envoyé au serveur pour la compensation de latence) et prédiction côté client :
-- le traceur et le recul sont joués immédiatement ; le marqueur de touche attend la confirmation du serveur
-- (HitFeedback). Si le serveur refuse le tir (pas de munition, cadence), la munition affichée est corrigée.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Stats = game:GetService("Stats")

local pingFn = ReplicatedStorage:WaitForChild("Ping") :: RemoteFunction
local pingReport = ReplicatedStorage:WaitForChild("PingReport") :: RemoteEvent
local player = Players.LocalPlayer

local gui = Instance.new("ScreenGui"); gui.Name = "NetHud"; gui.ResetOnSpawn = false; gui.DisplayOrder = 60; gui.Parent = player:WaitForChild("PlayerGui")
local label = Instance.new("TextLabel"); label.BackgroundTransparency = 1; label.AnchorPoint = Vector2.new(1, 0); label.Position = UDim2.new(1, -10, 0, 6)
label.Size = UDim2.fromOffset(180, 20); label.Font = Enum.Font.GothamMedium; label.TextSize = 12; label.TextXAlignment = Enum.TextXAlignment.Right
label.TextColor3 = Color3.fromRGB(190, 200, 215); label.Parent = gui

local smoothed = 0.06
task.spawn(function()
	while true do
		local t0 = os.clock()
		local ok = pcall(function() pingFn:InvokeServer() end)
		if ok then
			local rtt = os.clock() - t0
			smoothed = smoothed * 0.7 + rtt * 0.3
			pingReport:FireServer(smoothed)
		end
		task.wait(2)
	end
end)

RunService.RenderStepped:Connect(function(dt: number)
	local ms = math.floor(smoothed * 1000)
	local fps = math.floor(1 / math.max(dt, 1e-3))
	label.Text = string.format("%d ms · %d FPS", ms, math.clamp(fps, 0, 999))
	label.TextColor3 = if ms < 60 then Color3.fromRGB(125, 255, 159) elseif ms < 120 then Color3.fromRGB(255, 215, 94) else Color3.fromRGB(255, 70, 85)
end)

-- Réconciliation : le serveur est la référence pour les munitions
local ammo = { mag = nil :: number? }
local hit = ReplicatedStorage:WaitForChild("HitFeedback") :: RemoteEvent
hit.OnClientEvent:Connect(function(headshot: boolean, kill: boolean)
	-- ici : afficher le hitmarker (rouge si kill, doré si headshot) et jouer le son
	player:SetAttribute("LastHit", os.clock())
	player:SetAttribute("LastHitHead", headshot)
	player:SetAttribute("LastHitKill", kill)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="830">
        <Properties>
          <string name="Name">PassUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/PassUI (LocalScript)
-- Fenêtre du PASSE DE COMBAT (façon Fortnite / Call of Duty) : les 30 paliers de la saison sur une piste qui défile,
-- rangée GRATUITE en haut, rangée PREMIUM (dorée, cadenas tant qu'elle n'est pas débloquée) en bas, aperçu 3D des skins
-- des paliers Premium, barre d'XP vers le palier suivant, « TOUT RÉCUPÉRER », déblocage du Premium en pièces ou en Robux
-- (« Bientôt disponible » tant que le produit n'est pas créé dans ProductIds).
-- S'ouvre par S.panels.pass : carte Saison de l'accueil, bouton « VOIR LE PASSE » du bilan de fin de partie.
-- Serveur : BP_State, BP_Claim, BP_ClaimAll, BP_BuyPremium (ProgressService) et ShopBuy (ShopService) vérifient tout.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local MarketplaceService = game:GetService("MarketplaceService")
local Config = require(ReplicatedStorage.Shared.Config)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local ItemPreview = require(ReplicatedStorage.Shared.ItemPreview)
local S = require(ReplicatedStorage.Shared.ClientState)
local Icons = require(ReplicatedStorage.Shared.Icons)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local function call(name: string, ...: any): any
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local ok, res = pcall((r :: RemoteFunction).InvokeServer, r :: RemoteFunction, ...)
	return if ok then res else nil
end

local gui = make("ScreenGui", { Name = "PassUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 32,   -- au-dessus du calendrier (31)
	Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local veil = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.rgb(0x05080e), BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false, Modal = true }, gui)
local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1120, 600), BackgroundTransparency = 0,
	BackgroundColor3 = C.white }, gui)
K.corner(win, 16); K.gradient(win, K.rgb(0x18122e), K.rgb(0x0b111c), 90); K.stroke(win, C.violet, 1.5, 0.5)
local winScale = make("UIScale", { Scale = 1 }, win)
local function fit()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	winScale.Scale = math.clamp(math.min((vp.X - 24) / 1120, (vp.Y - 24) / 600), 0.45, 1.2)
end

-- en-tête
local titleL = text(win, { Position = UDim2.fromOffset(28, 18), Size = UDim2.new(1, -420, 0, 30), Font = K.BLACK, TextSize = 26, TextWrapped = false,
	Text = "🎟  " .. spaced("PASSE DE COMBAT", 2) })
local seasonL = text(win, { Position = UDim2.fromOffset(30, 50), Size = UDim2.new(1, -420, 0, 18), TextSize = 13, TextColor3 = C.violet, TextWrapped = false, Text = "" })
local tierL = text(win, { Position = UDim2.fromOffset(28, 78), Size = UDim2.fromOffset(300, 34), Font = K.BLACK, TextSize = 30, TextWrapped = false, Text = "" })
local xpBar = K.bar(win, 0, { Position = UDim2.fromOffset(30, 118), Size = UDim2.fromOffset(420, 8) }, C.purple, C.violet)
local xpL = text(win, { Position = UDim2.fromOffset(30, 130), Size = UDim2.fromOffset(420, 14), TextSize = 11, TextColor3 = C.dim, TextWrapped = false, Text = "" })
local closeB = K.btn(win, "✕", "dark", function() gui.Enabled = false end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(40, 40), TextSize = 18 })
local actions = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -70, 0, 18), Size = UDim2.fromOffset(560, 130) }, win)
K.vlist(actions, 8, Enum.HorizontalAlignment.Right)
local toastL = text(win, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.fromOffset(700, 20), TextSize = 13, TextColor3 = C.gold,
	TextXAlignment = Enum.TextXAlignment.Center, Text = "" })
local toastN = 0
local function toast(msg: string, col: Color3?)
	toastN += 1
	local my = toastN
	toastL.Text = msg; toastL.TextColor3 = col or C.gold
	task.delay(3.5, function() if my == toastN then toastL.Text = "" end end)
end
-- libellés des deux rangées (78 px : la rangée de paliers commence à 110 px, « ⭐ P  R  E  M… » mordait sur la 1re case)
text(win, { Position = UDim2.fromOffset(28, 168), Size = UDim2.fromOffset(78, 16), Font = K.BLACK, TextSize = 11, TextColor3 = C.sub, Text = spaced("GRATUIT", 1),
	TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
text(win, { Position = UDim2.fromOffset(28, 368), Size = UDim2.fromOffset(78, 16), Font = K.BLACK, TextSize = 11, TextColor3 = C.gold, Text = "⭐ " .. spaced("PREMIUM", 1),
	TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
local track = K.scroll(win, { Position = UDim2.fromOffset(110, 160), Size = UDim2.new(1, -130, 0, 400), ScrollingDirection = Enum.ScrollingDirection.X,
	AutomaticCanvasSize = Enum.AutomaticSize.X, ScrollBarThickness = 6 })
K.hlist(track, 10, Enum.VerticalAlignment.Top)

local state: any = nil
local render: () -> ()

local function rewardLabel(r: any, item: any): (string, string)
	if r.item and item then
		local sk = Config.SKINS[item.skin]
		local w = Config.WEAPONS[item.weapon]
		return "🎨", (if sk then sk.name else "Skin") .. " · " .. (if w then w.name else item.weapon)
	end
	if r.box then return "📦", (if r.box == "prem" then "Caisse Premium" else "Caisse Standard") .. (if r.coins then " + " .. r.coins .. " 💰" else "") end
	if r.coins then return "💰", K.fmt(r.coins) .. " pièces" end
	return "•", ""
end

local function claim(t: number, prem: boolean)
	local res = call("BP_Claim", t, prem)
	if res then
		local _, txt = rewardLabel(res.reward or {}, res.item)
		toast("✔ Palier " .. t .. " : " .. txt .. (if res.item and res.item.duplicate then " (déjà possédé : pièces rendues)" else ""))
		pcall(function() K.uiSound(false) end)
	else
		toast("Impossible de récupérer ce palier", C.accent)
	end
	state = call("BP_State") or state
	render()
	local f = S.panels.menuRefresh; if f then task.spawn(f) end
end

local function cell(parent: Instance, t: number, prem: boolean, y: number)
	local def = state.tiers[t]
	local r = if prem then def.prem else def.free
	local reached = t <= state.tier
	local list = if prem then state.claimedPremium else state.claimedFree
	local got = table.find(list or {}, t) ~= nil
	local locked = prem and not state.premium
	local ready = reached and not got and not locked
	local accent = if prem then C.gold else C.blue
	local f = make("Frame", { Position = UDim2.fromOffset(0, y), Size = UDim2.fromOffset(124, 180), BackgroundTransparency = 0, BackgroundColor3 = C.white }, parent)
	K.corner(f, 10)
	K.gradient(f, if prem then K.rgb(0x3a2a0a) else K.rgb(0x16233a), K.rgb(0x0b111c), 90, if reached then 0 else 0.35, if reached then 0 else 0.35)
	K.stroke(f, if ready then C.gold elseif got then C.green else accent, if ready then 2 else 1, if ready then 0 elseif reached then 0.4 else 0.8)
	local ic, txt = rewardLabel(r, def.item)
	if r.item and def.item then
		local box = make("Frame", { Position = UDim2.fromOffset(6, 10), Size = UDim2.new(1, -12, 0, 78) }, f)
		ItemPreview.weapon(box, def.item.weapon, def.item.skin, nil, nil, false)
		local rar = Config.RARITY[r.rarity or 2]
		text(f, { Position = UDim2.fromOffset(6, 86), Size = UDim2.new(1, -12, 0, 12), TextSize = 9, Font = K.BLACK, TextColor3 = rar and rar.color or C.white,
			TextXAlignment = Enum.TextXAlignment.Center, Text = spaced(string.upper(rar and rar.name or ""), 1) })
	else
		text(f, { Position = UDim2.fromOffset(0, 18), Size = UDim2.new(1, 0, 0, 60), TextSize = 44, TextXAlignment = Enum.TextXAlignment.Center, Text = ic })
	end
	text(f, { Position = UDim2.fromOffset(6, 100), Size = UDim2.new(1, -12, 0, 34), TextSize = 11, Font = K.BOLD, TextXAlignment = Enum.TextXAlignment.Center,
		TextYAlignment = Enum.TextYAlignment.Top, Text = txt, TextColor3 = if prem then C.gold else C.text })
	if got then
		text(f, { Position = UDim2.new(0, 12, 1, -36), Size = UDim2.new(1, 0, 0, 26), TextSize = 13, Font = K.BLACK, TextColor3 = C.green,
			TextXAlignment = Enum.TextXAlignment.Center, Text = spaced("REÇU", 1) })
		-- coche verte dessinée devant « REÇU » (le ✔ texte sort en emoji gris)
		Icons.check(f, 16, C.green, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, -26, 1, -23) })
	elseif ready then
		local b = K.btn(f, spaced("RÉCUPÉRER", 1), "gold", function() claim(t, prem) end,
			{ AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -8), Size = UDim2.new(1, -16, 0, 28), TextSize = 11 })
		K.beat(b, 1.05, 1)
	else
		text(f, { Position = UDim2.new(0, 0, 1, -36), Size = UDim2.new(1, 0, 0, 26), TextSize = 16, TextColor3 = C.dim,
			TextXAlignment = Enum.TextXAlignment.Center, Text = if locked then "🔒" else "Palier " .. t })
	end
	if locked then
		make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.55, BackgroundColor3 = K.rgb(0x05080e), ZIndex = 3 }, f)
		text(f, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.4), Size = UDim2.fromOffset(40, 40), TextSize = 28, ZIndex = 4,
			TextXAlignment = Enum.TextXAlignment.Center, Text = "🔒" })
	end
end

local function buildActions()
	K.clear(actions)   -- le UIListLayout (créé une fois) reste
	local claimable = 0
	for t = 1, state.tier do
		if not table.find(state.claimedFree or {}, t) then claimable += 1 end
		if state.premium and not table.find(state.claimedPremium or {}, t) then claimable += 1 end
	end
	local row1 = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 44) }, actions)
	local l1 = K.hlist(row1, 10); l1.HorizontalAlignment = Enum.HorizontalAlignment.Right
	if not state.premium then
		local it = Catalog.get("pass_premium")
		local live = it ~= nil and (it.productId or 0) > 0
		local rb = K.btn(row1, "⭐  " .. spaced("PREMIUM", 1) .. "  ·  R$ " .. tostring(state.premiumRobux), if live then "gold" else "dark", function()
			local res = call("ShopBuy", "pass_premium")
			if not (res and res.ok) then toast((res and res.err or "Bientôt disponible") .. " — le Premium s'obtient aussi avec des pièces", C.gold) end
		end, { LayoutOrder = 2, Size = UDim2.fromOffset(230, 42), TextSize = 13 })
		if not live then rb.Text = "⭐  PREMIUM · R$ " .. tostring(state.premiumRobux) .. '  <font size="10">bientôt disponible</font>' end
		local enough = (state.coins or 0) >= state.premiumCoins
		K.btn(row1, "⭐  " .. spaced("PREMIUM", 1) .. "  ·  " .. K.fmt(state.premiumCoins) .. " 💰", if enough then "purple" else "dark", function()
			local ok = call("BP_BuyPremium")
			if ok then toast("✔ Passe Premium débloqué ! Tous les paliers Premium atteints sont à récupérer.") else toast("Pas assez de pièces (" .. K.fmt(state.coins or 0) .. " / " .. K.fmt(state.premiumCoins) .. ")", C.accent) end
			state = call("BP_State") or state; render()
			local f = S.panels.menuRefresh; if f then task.spawn(f) end
		end, { LayoutOrder = 1, Size = UDim2.fromOffset(230, 42), TextSize = 13 })
	else
		text(row1, { LayoutOrder = 1, Size = UDim2.fromOffset(300, 42), Font = K.BLACK, TextSize = 15, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Right,
			TextWrapped = false, Text = "⭐ " .. spaced("PREMIUM ACTIF", 1) })
	end
	local row2 = make("Frame", { LayoutOrder = 2, Size = UDim2.new(1, 0, 0, 40) }, actions)
	local l2 = K.hlist(row2, 10); l2.HorizontalAlignment = Enum.HorizontalAlignment.Right
	if claimable > 0 then
		local b = K.btn(row2, "🎁  " .. spaced("TOUT RÉCUPÉRER", 1) .. " (" .. claimable .. ")", "green", function()
			local res = call("BP_ClaimAll")
			if typeof(res) == "table" and #res > 0 then toast("✔ " .. #res .. " récompense(s) récupérée(s) !") else toast("Rien à récupérer pour l'instant", C.dim) end
			state = call("BP_State") or state; render()
			local f = S.panels.menuRefresh; if f then task.spawn(f) end
		end, { Size = UDim2.fromOffset(260, 38), TextSize = 13 })
		K.beat(b, 1.04, 1.1)
	end
	if not state.premium then
		K.para(actions, "Le Premium débloque la rangée dorée : caisse Premium au palier 1, un skin tous les 5 paliers (rare, épique puis légendaire) et plus de pièces.", 11, C.dim, 3).TextXAlignment = Enum.TextXAlignment.Right
	end
end

render = function()
	if not state then return end
	seasonL.Text = string.upper(state.name)
	tierL.Text = "PALIER " .. state.tier .. ' <font size="16" color="#8da0bd">/ ' .. state.max .. "</font>"
	local inTier = if state.tier >= state.max then state.xpPerTier else state.xp % state.xpPerTier
	local fill = xpBar:FindFirstChild("Fill") :: Frame?
	if fill then fill.Size = UDim2.fromScale(math.clamp(inTier / state.xpPerTier, 0, 1), 1) end
	xpL.Text = if state.tier >= state.max then "Passe terminé : bravo !" else K.fmt(inTier) .. " / " .. K.fmt(state.xpPerTier) .. " XP vers le palier " .. (state.tier + 1) .. "  ·  l'XP des parties fait avancer le passe"
	buildActions()
	local cp: any = track.CanvasPosition
	local keepX = if typeof(cp) == "Vector2" then cp.X else 0   -- garde le défilement d'un rendu à l'autre
	K.clear(track)
	for t = 1, state.max do
		local col = make("Frame", { LayoutOrder = t, Size = UDim2.fromOffset(124, 392) }, track)
		local reached = t <= state.tier
		local num = text(col, { Position = UDim2.fromOffset(0, 186), Size = UDim2.new(1, 0, 0, 20), Font = K.BLACK, TextSize = 13, TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if t == state.tier + 1 then C.gold elseif reached then C.white else C.dim, Text = tostring(t) })
		if t == state.tier + 1 then num.Text = "▶ " .. t end
		cell(col, t, false, 0)
		cell(col, t, true, 210)
	end
	task.defer(function()
		if keepX > 0 then track.CanvasPosition = Vector2.new(keepX, 0)
		else track.CanvasPosition = Vector2.new(math.max(0, (state.tier - 2) * 134), 0) end
	end)
end

local function open()
	fit()
	gui.Enabled = true
	state = call("BP_State")
	if not state then toast("Chargement du passe…", C.dim); task.wait(1); state = call("BP_State") end
	track.CanvasPosition = Vector2.zero
	render()
	-- petite entrée qui rebondit (sur l'échelle d'adaptation à l'écran : un seul UIScale par cadre)
	local target = winScale.Scale
	winScale.Scale = target * 0.9; K.tween(winScale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
end
veil.Activated:Connect(function() gui.Enabled = false end)
-- B / Échap / Retour arrière ferment le passe (avant le menu) ; à la manette, la sélection arrive sur la croix
K.overlay(gui, function() gui.Enabled = false end, function() return closeB end)
local _t = titleL
S.panels.pass = function()
	if gui.Enabled then gui.Enabled = false else open() end
end
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, _id: number, ok: boolean)
	if userId == player.UserId and ok and gui.Enabled then task.wait(1.2); state = call("BP_State") or state; render() end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="831">
        <Properties>
          <string name="Name">PauseMenu</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/PauseMenu (LocalScript)
-- Pause en partie (menu Échap du web) : REPRENDRE (action principale), RÉGLAGES, MENU PRINCIPAL, puis plus petits
-- MODE PHOTO et QUITTER LA PARTIE (deuxième appui pour confirmer).
-- S'ouvre avec P ou la croix bas (MainMenu passe la main ici quand on est en partie, via S.panels.pause), avec Échap
-- (Roblox ouvre aussi son propre menu : en le refermant, on retrouve la pause) et avec le bouton ⏸ sur téléphone.
-- Le panneau Réglages est celui du menu principal (Menu/Options, mêmes onglets : MenuConfig.SETTINGS_TABS) : chaque réglage s'applique tout de suite
-- et est enregistré dans le profil. La partie continue derrière (jeu en ligne) : on ne peut ni tirer ni bouger pendant la pause.
-- Affiche aussi les compteurs FPS / ping en haut à droite quand ils sont activés dans les options.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local GuiService = game:GetService("GuiService")
local RunService = game:GetService("RunService")

local Modes = require(ReplicatedStorage.Shared.Modes)
local MenuConfig = require(ReplicatedStorage.Shared.MenuConfig)
local S = require(ReplicatedStorage.Shared.ClientState)
local MenuDir = script.Parent:WaitForChild("Menu")
local K = require(MenuDir:WaitForChild("Kit"))
local Options = require(MenuDir:WaitForChild("Options"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local function zone(): string
	local z = player:GetAttribute("Zone")
	return if typeof(z) == "string" then z else ""
end
local function invoke(name: string, ...: any): any
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local ok, res = pcall(r.InvokeServer, r, ...)
	if not ok then warn("[PauseMenu]", name, res); return nil end
	return res
end

-- ---------- interface ----------
local gui = make("ScreenGui", { Name = "PauseMenu", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 25, Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, playerGui)
-- voile : sombre, un peu plus à gauche et en bas (comme le fond du menu)
local dim = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, BackgroundColor3 = K.rgb(0x05080e) }, gui)
make("UIGradient", { Transparency = NumberSequence.new(0, 0.25), Rotation = -30 }, dim)
local modal = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1), Modal = true, Selectable = false, Visible = false }, gui)
-- panneau : un CanvasGroup pour le fondu d'ensemble, un UIScale pour tenir dans l'écran (et l'effet de zoom à l'ouverture)
local panel = make("CanvasGroup", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(420, 470),
	GroupTransparency = 1 }, gui)
K.corner(panel, 14); K.stroke(panel, C.white, 1, 0.88)
-- fond en dégradé sur un cadre à part : un UIGradient posé sur le CanvasGroup teinterait tout son contenu
local bg = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.04, BackgroundColor3 = C.white }, panel)
K.gradient(bg, K.rgb(0x141d30), K.rgb(0x0b111c), 90)
local fit = make("UIScale", {}, panel)
-- barre rouge en haut (bord des panneaux du web)
local topBar = make("Frame", { Size = UDim2.new(1, 0, 0, 3), BackgroundTransparency = 0, BackgroundColor3 = C.white, ZIndex = 5 }, panel)
K.gradient(topBar, C.orange, C.accent, 0)
local content = make("Frame", { Size = UDim2.fromScale(1, 1) }, panel)

-- compteurs FPS / ping et bouton pause tactile (toujours là, hors du panneau)
local hud = make("ScreenGui", { Name = "PauseHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 9 }, playerGui)
local perf = text(hud, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0, 8), Size = UDim2.fromOffset(200, 18), TextSize = 12, Font = K.BOLD,
	TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, TextStrokeTransparency = 0.5, Visible = false })
local touchBtn = K.btn(hud, "⏸", "dark", nil, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -12, 0.3, 0), Size = UDim2.fromOffset(48, 48),
	TextSize = 20, Visible = false, Name = "PauseButton" })
K.corner(touchBtn, 24)
local c = touchBtn:FindFirstChildOfClass("UICorner"); if c then c.CornerRadius = UDim.new(0, 24) end

-- ---------- état ----------
local open = false
local view = "main"
local optSub = Options.SUBS[1]
local lastToggle = 0

local controls: any = nil
task.spawn(function()
	local ps = player:WaitForChild("PlayerScripts")
	local pm = ps:WaitForChild("PlayerModule", 10)
	if pm and pm:IsA("ModuleScript") then
		local ok, m = pcall(require, pm)
		if ok and m and (m :: any).GetControls then controls = (m :: any):GetControls() end
	end
end)

local function computeFit(): number
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	local s = math.clamp(math.min(vp.X / 1280, vp.Y / 720), 0.6, 1.6)
	local acc = gui:FindFirstChild("AccessScale")   -- UIScale posé par AccessibilityController sur chaque ScreenGui
	return s / (if acc and acc:IsA("UIScale") and acc.Scale > 0 then acc.Scale else 1)
end
-- taille du panneau options : grande, mais dans l'écran
local function optionsSize(s: number): Vector2
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1280, 720)
	return Vector2.new(math.min(900, vp.X / s - 40), math.min(620, vp.Y / s - 40))
end

local setOpen: (boolean) -> ()
local render: () -> ()

-- les boutons de la vue principale arrivent l'un après l'autre
local function stagger(list: { GuiObject })
	for i, b in ipairs(list) do
		local sc = K.fxScale(b)
		sc.Scale = 0.85
		game:GetService("TweenService"):Create(sc, TweenInfo.new(0.32, Enum.EasingStyle.Back, Enum.EasingDirection.Out, 0, false, 0.05 + (i - 1) * 0.04), { Scale = 1 }):Play()
	end
end

local quitArmed = 0
local function mainView(animate: boolean)
	panel.Size = UDim2.fromOffset(420, 470)
	K.pad(content, 28, 26, 28, 22)
	K.vlist(content, 10, Enum.HorizontalAlignment.Center)
	text(content, { Text = spaced("PAUSE", 4), Font = K.BLACK, TextSize = 34, Size = UDim2.new(1, 0, 0, 40), TextXAlignment = Enum.TextXAlignment.Center,
		TextWrapped = false, LayoutOrder = 1 })
	local mm = player:GetAttribute("MatchMode")
	local mdef = if typeof(mm) == "string" then Modes.LIST[mm] else nil
	text(content, { Text = '<font color="#ff4655">●</font>  ' .. spaced("PARTIE EN COURS", 1) .. (if mdef then "  ·  " .. mdef.n else ""), TextSize = 11, TextColor3 = C.dim,
		Size = UDim2.new(1, 0, 0, 18), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, LayoutOrder = 2 })
	text(content, { Text = "La partie continue pendant la pause.", TextSize = 11, TextColor3 = C.mute, Size = UDim2.new(1, 0, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, LayoutOrder = 3 })
	local list: { GuiObject } = {}
	local function add(label: string, kind: string, cb: () -> (), h: number?): TextButton
		local b = K.btn(content, label, kind, cb, { Size = UDim2.new(1, 0, 0, h or 46), TextSize = if h then 12 else 14, LayoutOrder = 10 + #list })
		table.insert(list, b)
		return b
	end
	local resume = add("▶  " .. spaced("REPRENDRE", 2), "primary", function() setOpen(false) end, 54)
	resume.TextSize = 16
	add("⚙  " .. spaced("RÉGLAGES", 2), "alt", function() view = "options"; render() end)
	add("☰  " .. spaced("MENU PRINCIPAL", 2), "alt", function()
		setOpen(false)
		local m = S.panels.menu
		if m then task.spawn(m) end
	end)
	add("📷  " .. spaced("MODE PHOTO", 2), "dark", function()
		setOpen(false)
		local ok, err = pcall(function() require(ReplicatedStorage.Shared.PhotoMode).enter() end)
		if not ok then warn("[PauseMenu] PhotoMode", err) end
	end, 38)
	-- quitter : deuxième appui pour confirmer (le web demande aussi une confirmation)
	local quit: TextButton
	quit = add(spaced("QUITTER LA PARTIE", 1), "dark", function()
		if os.clock() - quitArmed < 3 then
			quitArmed = 0
			setOpen(false)
			task.spawn(invoke, "MatchLeave")
		else
			quitArmed = os.clock()
			quit.Text = spaced("CONFIRMER ?", 2); quit.TextColor3 = C.accent
			task.delay(3, function()
				if quit.Parent and os.clock() - quitArmed >= 3 then quit.Text = spaced("QUITTER LA PARTIE", 1); quit.TextColor3 = C.white end
			end)
		end
	end, 38)
	text(content, { Text = "P · Échap · B pour reprendre", TextSize = 11, TextColor3 = C.mute, Size = UDim2.new(1, 0, 0, 16),
		TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, LayoutOrder = 40 })
	if animate then stagger(list) end
	if UserInputService.GamepadEnabled then GuiService.SelectedObject = resume end
end

local function optionsView(slide: number?)
	local s = computeFit()
	local size = optionsSize(s)
	panel.Size = UDim2.fromOffset(size.X, size.Y)
	-- en-tête : retour, titre, onglets
	local back = K.btn(content, "◀  " .. spaced("RETOUR", 1), "dark", function() view = "main"; render() end,
		{ Position = UDim2.fromOffset(20, 18), Size = UDim2.fromOffset(110, 32), TextSize = 11 })
	text(content, { Text = spaced("RÉGLAGES", 3), Font = K.BLACK, TextSize = 22, Position = UDim2.fromOffset(146, 18), Size = UDim2.fromOffset(240, 32), TextWrapped = false })
	local tabs = make("Frame", { Position = UDim2.fromOffset(20, 62), Size = UDim2.new(1, -40, 0, 36) }, content)
	K.hlist(tabs, 6)
	for i, sub in ipairs(Options.SUBS) do
		local def = MenuConfig.settingsTab(sub)
		K.chip(tabs, spaced(if def then def.n else sub, 1), sub == optSub, function()
			if sub == optSub then return end
			local old = table.find(Options.SUBS, optSub) or 1
			optSub = sub
			render()
			-- le contenu glisse depuis le côté de l'onglet choisi
			local area = content:FindFirstChild("Area")
			if area and area:IsA("GuiObject") then
				area.Position = UDim2.fromOffset(20 + (if i > old then 30 else -30), 128)
				K.tween(area, 0.26, { Position = UDim2.fromOffset(20, 128) }, Enum.EasingStyle.Quint)
			end
		end, { LayoutOrder = i })
	end
	-- phrase d'aide de l'onglet
	local cur = MenuConfig.settingsTab(optSub)
	text(content, { Text = if cur then cur.help else "", Position = UDim2.fromOffset(20, 102), Size = UDim2.new(1, -40, 0, 18), TextSize = 12, Font = K.MED,
		TextColor3 = C.sub, TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
	local area = make("Frame", { Name = "Area", Position = UDim2.fromOffset(20 + (slide or 0), 128), Size = UDim2.new(1, -40, 1, -144) }, content)
	local sc = K.scroll(area, { Name = "Opt" .. optSub })
	K.vlist(sc, 14); K.pad(sc, 0, 4, 8, 12)
	Options.build(sc, math.floor(size.X - 50), optSub, function() render() end)
	if slide then K.tween(area, 0.26, { Position = UDim2.fromOffset(20, 128) }, Enum.EasingStyle.Quint) end
	if UserInputService.GamepadEnabled then GuiService.SelectedObject = back end
end

local lastView = ""
render = function()
	if not open then return end
	-- garder la position de défilement quand une puce redessine la page
	local keep: Vector2? = nil
	local old = content:FindFirstChild("Area")
	local oldSc = old and old:FindFirstChildWhichIsA("ScrollingFrame")
	if oldSc and oldSc.Name == "Opt" .. optSub then keep = oldSc.CanvasPosition end
	for _, ch in ipairs(content:GetChildren()) do ch:Destroy() end
	local changed = view ~= lastView
	lastView = view
	if view == "options" then optionsView(if changed then 30 else nil) else mainView(changed) end
	if keep then
		local area = content:FindFirstChild("Area")
		local sc = area and area:FindFirstChildWhichIsA("ScrollingFrame")
		if sc then task.defer(function() sc.CanvasPosition = keep :: Vector2 end) end
	end
end

-- ---------- ouverture / fermeture ----------
local function bindActions(on: boolean)
	if on then
		ContextActionService:BindActionAtPriority("PauseBack", function(_, st)
			if st == Enum.UserInputState.Begin then
				if view == "options" then view = "main"; render() else setOpen(false) end
			end
			return Enum.ContextActionResult.Sink
		end, false, 3000, Enum.KeyCode.ButtonB)
	else
		ContextActionService:UnbindAction("PauseBack")
	end
end

local closeN = 0
setOpen = function(on: boolean)
	if on and (zone() ~= "match" or S.menuOpen) then return end
	if on == open then return end
	lastToggle = os.clock()
	open = on
	closeN += 1
	local my = closeN
	modal.Visible = on
	touchBtn.Visible = false
	player:SetAttribute("UiOpen", if on then true else nil)   -- WeaponController : pas de tir, souris visible
	if controls then pcall(function() if on then controls:Disable() else controls:Enable() end end) end
	bindActions(on)
	if on then
		view = "main"; lastView = ""; quitArmed = 0
		gui.Enabled = true
		local s = computeFit()
		render()
		-- arrivée : voile qui s'assombrit, panneau qui apparaît en fondu en grossissant un peu
		dim.BackgroundTransparency = 1
		K.tween(dim, 0.2, { BackgroundTransparency = 0.4 })
		panel.GroupTransparency = 1
		fit.Scale = s * 0.92
		K.tween(panel, 0.22, { GroupTransparency = 0 })
		K.tween(fit, 0.34, { Scale = s }, Enum.EasingStyle.Back)
	else
		if GuiService.SelectedObject and GuiService.SelectedObject:IsDescendantOf(gui) then GuiService.SelectedObject = nil end
		K.tween(dim, 0.14, { BackgroundTransparency = 1 })
		K.tween(panel, 0.14, { GroupTransparency = 1 })
		K.tween(fit, 0.14, { Scale = computeFit() * 0.96 })
		task.delay(0.15, function()
			if my == closeN and not open then gui.Enabled = false; for _, ch in ipairs(content:GetChildren()) do ch:Destroy() end end
		end)
	end
end
local function toggle()
	if os.clock() - lastToggle < 0.25 then return end   -- Échap peut arriver deux fois (touche + menu Roblox)
	setOpen(not open)
end
S.panels.pause = toggle

-- Échap : Roblox garde la touche pour son menu ; quand il s'ouvre en partie, la pause s'ouvre dessous
GuiService.MenuOpened:Connect(function()
	if not open and zone() == "match" and not S.menuOpen then toggle() end
end)
UserInputService.InputBegan:Connect(function(input: InputObject)
	if input.KeyCode == Enum.KeyCode.Escape and (open or zone() == "match") then toggle() end
end)
touchBtn.Activated:Connect(function() setOpen(true) end)

-- une autre interface relâche « UiOpen » pendant la pause : on le reprend
player:GetAttributeChangedSignal("UiOpen"):Connect(function()
	if open and player:GetAttribute("UiOpen") ~= true then player:SetAttribute("UiOpen", true) end
end)
-- fin de partie : la pause se ferme
player:GetAttributeChangedSignal("Zone"):Connect(function()
	if open and zone() ~= "match" then setOpen(false) end
end)
-- écran redimensionné : le panneau suit
local function watchCamera(cam: Camera?)
	if not cam then return end
	cam:GetPropertyChangedSignal("ViewportSize"):Connect(function()
		if open then fit.Scale = computeFit(); if view == "options" then render() end end
	end)
end
watchCamera(workspace.CurrentCamera)
workspace:GetPropertyChangedSignal("CurrentCamera"):Connect(function() watchCamera(workspace.CurrentCamera) end)

-- ---------- compteurs FPS / ping, bouton tactile ----------
local frames, acc = 0, 0
RunService.RenderStepped:Connect(function(dt: number)
	frames += 1; acc += dt
	if acc < 0.5 then return end
	local fps = frames / acc
	frames, acc = 0, 0
	local parts = {}
	if S.opt.showFps then
		local col = if fps >= 50 then "#7dff9f" elseif fps >= 30 then "#ffd23a" else "#ff4655"
		table.insert(parts, '<font color="' .. col .. '">' .. math.floor(fps + 0.5) .. "</font> FPS")
	end
	if S.opt.showPing then
		local ok, ping = pcall(function() return player:GetNetworkPing() end)
		local ms = if ok and typeof(ping) == "number" then math.floor(ping * 1000 + 0.5) else 0
		local col = if ms <= 80 then "#7dff9f" elseif ms <= 160 then "#ffd23a" else "#ff4655"
		table.insert(parts, '<font color="' .. col .. '">' .. ms .. "</font> ms")
	end
	perf.Visible = #parts > 0
	perf.Text = table.concat(parts, "  ·  ")
	touchBtn.Visible = UserInputService.TouchEnabled and not open and zone() == "match" and not S.menuOpen
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="832">
        <Properties>
          <string name="Name">PerkDrinkController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/PerkDrinkController (LocalScript)
-- Animation de la boisson d'atout (src/8U_perkdrink.js), lancée par PerkDrinkService (remote PerkDrink) :
--   • vue subjective (soi) : l'arme descend et disparaît (0 – 0,3 s), le flacon de la couleur de l'atout sort par le bas
--     (0,28 s), petite gorgée d'essai, la capsule saute (0,7 s), on porte le flacon à la bouche et on boit (le liquide
--     baisse de 1,02 à 1,6 s, glouglous), « ahh » + lueur de la couleur de l'atout sur les bords de l'écran (1,6 s),
--     le flacon est jeté (1,84 s) et l'arme revient (1,85 s). Ni tir ni visée pendant 2,3 s (ClientState.drinkUntil).
--   • vu par les autres : le flacon dans la main, porté à la bouche et incliné, le liquide qui baisse.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local Config = require(ReplicatedStorage.Shared.Config)
local S = require(ReplicatedStorage.Shared.ClientState)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local okZ, Z = pcall(require, ReplicatedStorage.Shared:WaitForChild("ZombieConfig", 5) :: ModuleScript)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local U = Config.STUDS_PER_METER
local GOLDM = Color3.fromRGB(216, 178, 90)

local function perkOf(key: string): (Color3, string, string)
	local p = okZ and Z and (Z :: any).PERKS and (Z :: any).PERKS[key]
	if p then return p.c, p.ic or "?", p.n or key end
	return Color3.new(1, 1, 1), "?", key
end

local function snd(id: string, pitch: number, vol: number, at: Vector3?)
	pcall(function() Sfx.play({ id = id, volume = vol, pitch = pitch }, at) end)
end

-- ---------- flacon ----------
type Bottle = { folder: Model, parts: { { p: BasePart, off: CFrame } }, liq: BasePart, cap: BasePart, scale: number, liqH: number }
local function newPart(parent: Instance, size: Vector3, color: Color3, mat: Enum.Material?, shape: Enum.PartType?, transp: number?): BasePart
	local p = Instance.new("Part")
	p.Size = size; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic; p.Transparency = transp or 0
	if shape then p.Shape = shape end
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.Parent = parent
	return p
end
-- s = taille en mètres du flacon (0,2 m sur le web) ; origine = fond du flacon, axe Y = goulot
local function bottle(key: string, sc: number, parent: Instance): Bottle
	local col, ic = perkOf(key)
	local m = Instance.new("Model"); m.Name = "PerkBottle"
	local k = sc * U
	local cyl = CFrame.Angles(0, 0, math.pi / 2)   -- un cylindre Roblox est couché sur X : on le redresse
	local parts = {}
	local function add(p: BasePart, off: CFrame) table.insert(parts, { p = p, off = off }) end
	local glass = col:Lerp(Color3.new(1, 1, 1), 0.25)
	add(newPart(m, Vector3.new(0.118 * k, 0.072 * k, 0.072 * k), glass, Enum.Material.Glass, Enum.PartType.Cylinder, 0.55), CFrame.new(0, 0.059 * k, 0) * cyl)
	add(newPart(m, Vector3.new(0.03 * k, 0.06 * k, 0.06 * k), glass, Enum.Material.Glass, Enum.PartType.Cylinder, 0.55), CFrame.new(0, 0.128 * k, 0) * cyl)
	add(newPart(m, Vector3.new(0.045 * k, 0.024 * k, 0.024 * k), glass, Enum.Material.Glass, Enum.PartType.Cylinder, 0.5), CFrame.new(0, 0.165 * k, 0) * cyl)
	local label = newPart(m, Vector3.new(0.06 * k, 0.0745 * k, 0.0745 * k), Color3.fromRGB(22, 17, 12), Enum.Material.SmoothPlastic, Enum.PartType.Cylinder)
	add(label, CFrame.new(0, 0.06 * k, 0) * cyl)
	local sg = Instance.new("SurfaceGui"); sg.Face = Enum.NormalId.Front; sg.CanvasSize = Vector2.new(64, 64); sg.LightInfluence = 0.5; sg.Parent = label
	local t = Instance.new("TextLabel"); t.Size = UDim2.fromScale(1, 1); t.BackgroundColor3 = col; t.BackgroundTransparency = 0.2; t.Text = ic
	t.TextScaled = true; t.Font = Enum.Font.GothamBlack; t.TextColor3 = Color3.new(1, 1, 1); t.Parent = sg
	add(newPart(m, Vector3.new(0.004 * k, 0.025 * k, 0.025 * k), GOLDM, Enum.Material.Metal, Enum.PartType.Cylinder), CFrame.new(0, 0.188 * k, 0) * cyl)
	local cap = newPart(m, Vector3.new(0.012 * k, 0.029 * k, 0.029 * k), GOLDM, Enum.Material.Metal, Enum.PartType.Cylinder)
	add(cap, CFrame.new(0, 0.204 * k, 0) * cyl)
	local liq = newPart(m, Vector3.new(0.096 * k, 0.064 * k, 0.064 * k), col, Enum.Material.Neon, Enum.PartType.Cylinder, 0.1)
	add(liq, CFrame.new(0, 0.052 * k, 0) * cyl)
	m.Parent = parent
	return { folder = m, parts = parts, liq = liq, cap = cap, scale = k, liqH = 0.096 * k }
end
local function place(b: Bottle, base: CFrame, level: number)
	for _, e in ipairs(b.parts) do
		if e.p == b.liq then
			local h = math.max(0.002 * b.scale, b.liqH * level)
			e.p.Size = Vector3.new(h, e.p.Size.Y, e.p.Size.Z)
			e.p.CFrame = base * CFrame.new(0, 0.004 * b.scale + h / 2, 0) * CFrame.Angles(0, 0, math.pi / 2)
			e.p.Transparency = if level < 0.02 then 1 else 0.1
		else
			e.p.CFrame = base * e.off
		end
	end
end

local function smooth(x: number): number x = math.clamp(x, 0, 1); return x * x * (3 - 2 * x) end
local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end

-- ---------- lueur sur les bords de l'écran ----------
local gui = Instance.new("ScreenGui"); gui.Name = "PerkDrink"; gui.IgnoreGuiInset = true; gui.ResetOnSpawn = false; gui.DisplayOrder = 7
gui.Parent = player:WaitForChild("PlayerGui")
local glow = Instance.new("Frame"); glow.Size = UDim2.fromScale(1, 1); glow.BackgroundTransparency = 1; glow.BorderSizePixel = 0; glow.Parent = gui
local stroke = Instance.new("UIStroke"); stroke.Thickness = 90; stroke.Transparency = 1; stroke.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; stroke.Parent = glow
local function screenGlow(col: Color3)
	stroke.Color = col; stroke.Transparency = 0.25
	TweenService:Create(stroke, TweenInfo.new(1.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Transparency = 1 }):Play()
end

-- ---------- vue subjective ----------
type Fly = { p: Bottle | BasePart, cf: CFrame, v: Vector3, spin: Vector3, t: number, life: number }
local me: { on: boolean, t0: number, key: string, b: Bottle?, capOff: boolean, glug: number, ahh: boolean, tossed: boolean }? = nil
local flying: { Fly } = {}

local function pose(t: number): (Vector3, number, number)
	local a = smooth((t - 0.28) / 0.3)    -- sort par le bas
	local b = smooth((t - 0.78) / 0.3)    -- monte à la bouche
	local d = smooth((t - 1.62) / 0.22)   -- redescend pour être jeté
	local x, y, z = lerp(0.24, 0.1, a), lerp(-0.52, -0.2, a), lerp(-0.42, -0.47, a)
	local rx, rz = lerp(-0.4, 0.18, a), lerp(0.5, 0.22, a)
	x = lerp(x, 0.055, b); y = lerp(y, 0.012, b); z = lerp(z, -0.25, b)
	rx = lerp(rx, 1.95, b); rz = lerp(rz, 0.1, b)
	if t > 0.6 and t < 0.74 then local j = math.sin((t - 0.6) / 0.14 * math.pi); rx -= j * 0.25; y += j * 0.012 end
	if b > 0.9 and d < 0.05 then local g = math.sin((t - 1.08) * 14); y += g * 0.004; rx += g * 0.04 end
	x = lerp(x, 0.34, d); y = lerp(y, -0.32, d); z = lerp(z, -0.42, d); rx = lerp(rx, 0.6, d); rz = lerp(rz, -0.9, d)
	return Vector3.new(x, y, z) * U, rx, rz
end

local function stopMine()
	if me and me.b and not me.tossed then me.b.folder:Destroy() end
	me = nil
end

local function startMine(key: string, dur: number)
	stopMine()
	local now = os.clock()
	S.drinkUntil = now + dur; S.drinkHideUntil = now + 1.85
	S.aiming = false; S.inspectStart = -1
	me = { on = true, t0 = now, key = key, b = nil, capOff = false, glug = 0, ahh = false, tossed = false }
	snd("rbxasset://sounds/swoosh.wav", 1.3, 0.35)
end

RunService:BindToRenderStep("PerkDrink", Enum.RenderPriority.Camera.Value + 3, function(dt: number)
	-- objets lancés (capsule, flacon) : dans le repère de la caméra
	for i = #flying, 1, -1 do
		local f = flying[i]
		f.t += dt
		f.v += Vector3.new(0, -3.2 * U * dt, 0)
		f.cf = (f.cf + f.v * dt) * CFrame.Angles(f.spin.X * dt, f.spin.Y * dt, f.spin.Z * dt)
		local world = camera.CFrame * f.cf
		if typeof(f.p) == "Instance" then (f.p :: BasePart).CFrame = world else place(f.p :: Bottle, world, 0) end
		if f.t > f.life then
			if typeof(f.p) == "Instance" then (f.p :: BasePart):Destroy() else (f.p :: Bottle).folder:Destroy() end
			table.remove(flying, i)
		end
	end
	local d = me
	if not d then return end
	local ch = player.Character
	local h = ch and ch:FindFirstChildOfClass("Humanoid")
	if not h or h.Health <= 0 or player:GetAttribute("Zone") ~= "match" then S.drinkUntil = 0; S.drinkHideUntil = 0; stopMine(); return end
	local t = os.clock() - d.t0
	if t >= 2.3 then stopMine(); return end
	if t < 0.28 or d.tossed then return end
	if not d.b then d.b = bottle(d.key, 0.88, camera) end
	local b = d.b :: Bottle
	local pos, rx, rz = pose(t)
	local local_ = CFrame.new(pos) * CFrame.fromEulerAnglesXYZ(rx, 0, rz)
	local level = 1 - math.clamp((t - 1.02) / 0.58, 0, 1)
	place(b, camera.CFrame * local_, level)
	b.cap.Transparency = if d.capOff then 1 else 0
	if not d.capOff and t >= 0.7 then
		d.capOff = true
		snd("rbxasset://sounds/clickfast.wav", 2.2, 0.6)
		local c = newPart(camera, b.cap.Size, GOLDM, Enum.Material.Metal, Enum.PartType.Cylinder)
		table.insert(flying, { p = c, cf = local_ * CFrame.new(0, 0.205 * b.scale, 0), v = Vector3.new(-0.35, 0.9, -0.1) * U, spin = Vector3.new(18, 9, 4), t = 0, life = 0.8 })
	end
	if t > 1.05 and t < 1.6 then
		d.glug -= dt
		if d.glug <= 0 then d.glug = 0.17; snd("rbxasset://sounds/swoosh.wav", 0.35 + math.random() * 0.08, 0.3) end
	end
	if t >= 1.6 and not d.ahh then
		d.ahh = true
		local col = perkOf(d.key)
		screenGlow(col)
		snd("rbxasset://sounds/electronicpingshort.wav", 0.6, 0.4)
	end
	if t >= 1.84 and not d.tossed then
		d.tossed = true
		snd("rbxasset://sounds/swoosh.wav", 1.6, 0.3)
		task.delay(0.42, function() snd("rbxasset://sounds/clickfast.wav", 3, 0.35) end)
		table.insert(flying, { p = b, cf = local_, v = Vector3.new(0.9, 0.6, -0.4) * U, spin = Vector3.new(9, 3, 11), t = 0, life = 0.7 })
	end
end)

-- ---------- vu par les autres ----------
type Other = { p: Player, b: Bottle?, t0: number, dur: number, key: string }
local others: { [Player]: Other } = {}
RunService.RenderStepped:Connect(function()
	for p, o in pairs(others) do
		local ch = p.Character
		local head = ch and ch:FindFirstChild("Head") :: BasePart?
		local root = ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
		local t = os.clock() - o.t0
		if not head or not root or t >= o.dur * 0.8 then
			if o.b then o.b.folder:Destroy() end
			others[p] = nil
		else
			if not o.b then o.b = bottle(o.key, 1.3, workspace) end
			local k = smooth(math.min(1, t / 0.6)) * (1 - smooth((t - o.dur * 0.8 + 0.3) / 0.3))
			local rx = lerp(0.15, 2.1, k)
			local face = CFrame.new(head.Position) * root.CFrame.Rotation
			local hand = face * CFrame.new(lerp(0.9, 0.2, k), lerp(-2.6, -0.45, k), lerp(-0.9, -1.0, k))
			place(o.b :: Bottle, hand * CFrame.Angles(rx, 0, lerp(0.25, 0.05, k)) * CFrame.new(0, -0.12 * U * 1.3 * 0.5, 0), 1 - k * 0.85)
		end
	end
end)

local ev = ReplicatedStorage:WaitForChild("PerkDrink") :: RemoteEvent
ev.OnClientEvent:Connect(function(p: Player, key: string, dur: number)
	if p == player then startMine(key, dur)
	else
		local o = others[p]
		if o and o.b then o.b.folder:Destroy() end
		others[p] = { p = p, b = nil, t0 = os.clock(), dur = dur, key = key }
	end
end)
Players.PlayerRemoving:Connect(function(p: Player)
	local o = others[p]
	if o and o.b then o.b.folder:Destroy() end
	others[p] = nil
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="833">
        <Properties>
          <string name="Name">PhotoController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/PhotoController (LocalScript)
-- Entrée provisoire du mode photo (src/8Z_photo.js) : touche F4. Le menu pause pourra appeler
-- require(ReplicatedStorage.Shared.PhotoMode).enter() à la place.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local PhotoMode = require(ReplicatedStorage.Shared.PhotoMode)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= Enum.KeyCode.F4 then return end
	PhotoMode.toggle()
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="834">
        <Properties>
          <string name="Name">RewardScreen</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/RewardScreen (LocalScript)
-- Récompenses qui se voient, façon Call of Duty / Fortnite :
--   • BILAN DE LA PARTIE (écran de fin, à droite des cartes de HudController) : chaque gain d'XP ligne par ligne
--     (participation, éliminations, victoire, mode de la semaine, week-end XP ×2, médailles…), bonus de fidélité,
--     total d'XP et de pièces qui défilent, barre de niveau qui se remplit (et repart à zéro à chaque niveau gagné),
--     avancée du passe de combat, défis terminés pendant la partie, rappel de la première victoire du jour.
--     Données : résumé MatchEnd → recap (ServerScriptService/RecapService).
--   • NIVEAU SUPÉRIEUR : grande fenêtre avec le nouveau niveau, la récompense débloquée et le prochain gros palier
--     (remote « LevelUp » de RewardService). En fin de partie, elle attend que la barre de niveau ait fini de se remplir.
-- Rien n'est crédité ici : tout l'a déjà été par le serveur.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local S = require(ReplicatedStorage.Shared.ClientState)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local gui = make("ScreenGui", { Name = "RewardScreen", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 13,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

-- texte d'une récompense de niveau ou de palier : { coins, box, n, dance }
local function rewardText(r: any): string
	if typeof(r) ~= "table" then return "" end
	local t = {}
	if r.coins then table.insert(t, "💰 " .. K.fmt(r.coins) .. " pièces") end
	if r.box then table.insert(t, "📦 " .. (if (r.n or 1) > 1 then r.n .. " " else "") .. (if r.box == "prem" then "Caisse Premium" else "Caisse Standard")) end
	if r.dance and Config.DANCES[r.dance] then table.insert(t, "💃 Danse « " .. Config.DANCES[r.dance].name .. " »") end
	return table.concat(t, "   ")
end

-- taille de l'écran : les panneaux rétrécissent sur les petits écrans (téléphones)
local function screenScale(): number
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	return math.clamp(math.min(vp.X / 1700, vp.Y / 860), 0.55, 1)
end

-- =====================================================================================
-- BILAN DE LA PARTIE
-- =====================================================================================
local recap = make("Frame", { Name = "Recap", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -18, 0.56, 0), Size = UDim2.fromOffset(330, 0),
	AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 0.06, BackgroundColor3 = K.rgb(0x0b111c), Visible = false, ZIndex = 2 }, gui)
K.corner(recap, 12); K.stroke(recap, C.gold, 1.5, 0.55); K.pad(recap, 16, 14)
K.gradient(recap, K.rgb(0x141e31), K.rgb(0x0a0f19), 90)
local recapScale = make("UIScale", { Scale = 1 }, recap)
K.vlist(recap, 6)
local recapToken = 0
local animating = false     -- barre de niveau en train de se remplir : la fenêtre NIVEAU SUPÉRIEUR attend

local function row(order: number, h: number?): Frame
	return make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, h or 20) }, recap)
end
local function fadeIn(o: GuiObject, delay: number)
	local lbls = {}
	if o:IsA("TextLabel") then table.insert(lbls, o) end
	for _, d in ipairs(o:GetDescendants()) do if d:IsA("TextLabel") then table.insert(lbls, d) end end
	for _, l in ipairs(lbls) do (l :: TextLabel).TextTransparency = 1 end
	task.delay(delay, function()
		for _, l in ipairs(lbls) do if l.Parent then K.tween(l, 0.25, { TextTransparency = 0 }) end end
	end)
end
-- nombre qui défile de 0 à n
local function countUp(l: TextLabel, n: number, fmt: (number) -> string, dur: number, delay: number)
	task.delay(delay, function()
		local t0 = os.clock()
		while l.Parent and os.clock() - t0 < dur do
			l.Text = fmt(math.floor(n * (os.clock() - t0) / dur))
			task.wait(1 / 30)
		end
		if l.Parent then l.Text = fmt(n) end
	end)
end

local levelQueue: { any } = {}
local showLevelUp: () -> ()

local function buildRecap(rc: any)
	K.clear(recap)
	recapToken += 1
	local my = recapToken
	recapScale.Scale = screenScale()
	recap.Visible = true
	local order = 0
	local function nextOrder(): number order += 1; return order end
	local delay = 0.9
	local function step(d: number): number delay += d; return delay end

	-- titre + étiquettes des bonus actifs
	local head = row(nextOrder(), 24)
	text(head, { Text = spaced("BILAN DE LA PARTIE", 2), Font = K.BLACK, TextSize = 15, TextColor3 = C.gold, Size = UDim2.fromScale(1, 1), TextWrapped = false })
	local tags: { { t: string, c: Color3 } } = {}
	if rc.weekend then table.insert(tags, { t = "WEEK-END XP ×2", c = C.violet }) end
	if rc.featured then table.insert(tags, { t = "MODE DE LA SEMAINE ×2", c = C.blue }) end
	if rc.firstWin then table.insert(tags, { t = "1RE VICTOIRE DU JOUR", c = C.gold }) end
	if #tags > 0 then
		local tr = make("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, recap)
		K.hlist(tr, 6, nil, true)
		for i, tg in ipairs(tags) do
			local chip = text(tr, { LayoutOrder = i, Text = spaced(tg.t, 1), Font = K.BLACK, TextSize = 10, TextColor3 = C.ink, AutomaticSize = Enum.AutomaticSize.X,
				Size = UDim2.fromOffset(0, 20), BackgroundTransparency = 0, BackgroundColor3 = tg.c, TextWrapped = false })
			K.corner(chip, 4); K.pad(chip, 8, 0)
			K.beat(chip, 1.06, 1.2)
		end
	end
	-- XP ligne par ligne
	for _, l in ipairs(if typeof(rc.lines) == "table" then rc.lines else {}) do
		local r = row(nextOrder(), 18)
		text(r, { Text = tostring(l.t), TextSize = 13, Font = K.MED, TextColor3 = C.sub, Size = UDim2.new(1, -90, 1, 0), TextWrapped = false, TextTruncate = Enum.TextTruncate.AtEnd })
		text(r, { Text = "+" .. K.fmt(tonumber(l.xp) or 0) .. " XP", TextSize = 13, Font = K.BLACK, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
			Size = UDim2.new(0, 90, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
		fadeIn(r, step(0.12))
		task.delay(delay, function() if my == recapToken then K.uiSound(true) end end)
	end
	for _, b in ipairs(if typeof(rc.bonus) == "table" then rc.bonus else {}) do
		local r = text(recap, { LayoutOrder = nextOrder(), Text = tostring(b), TextSize = 12, Font = K.BOLD, TextColor3 = C.gold, Size = UDim2.new(1, 0, 0, 0),
			AutomaticSize = Enum.AutomaticSize.Y })
		fadeIn(r, step(0.12))
	end
	-- totaux
	make("Frame", { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 1), BackgroundTransparency = 0.85, BackgroundColor3 = C.white }, recap)
	local tot = row(nextOrder(), 34)
	local xpL = text(tot, { Text = "+0 XP", Font = K.BLACK, TextSize = 26, Size = UDim2.new(0.55, 0, 1, 0), TextWrapped = false })
	local coinL = text(tot, { Text = "+0 💰", Font = K.BLACK, TextSize = 22, TextColor3 = C.gold, AnchorPoint = Vector2.new(1, 0), Position = UDim2.fromScale(1, 0),
		Size = UDim2.new(0.45, 0, 1, 0), TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false })
	countUp(xpL, tonumber(rc.xp) or 0, function(n) return "+" .. K.fmt(n) .. " XP" end, 0.9, step(0.15))
	countUp(coinL, tonumber(rc.coins) or 0, function(n) return "+" .. K.fmt(n) .. ' <font size="16">💰</font>' end, 0.9, delay)
	text(recap, { LayoutOrder = nextOrder(), Text = "Total : " .. K.fmt(tonumber(rc.coinsTotal) or 0) .. " pièces", TextSize = 11, TextColor3 = C.dim, Size = UDim2.new(1, 0, 0, 14) })

	-- barre de niveau : de « from » à « to », un tour complet par niveau gagné
	local from, to = rc.from or { level = 1, xp = 0, need = 1 }, rc.to or { level = 1, xp = 0, need = 1 }
	local lv = row(nextOrder(), 44)
	local badgeHolder = make("Frame", { Size = UDim2.fromOffset(40, 40) }, lv)
	local badge = K.levelBadge(badgeHolder, from.level, 40)
	local lvlL = text(lv, { Text = "NIVEAU " .. from.level, Font = K.BLACK, TextSize = 13, Position = UDim2.fromOffset(52, 2), Size = UDim2.new(1, -52, 0, 16), TextWrapped = false })
	local bar = K.bar(lv, from.xp / math.max(1, from.need), { Position = UDim2.fromOffset(52, 22), Size = UDim2.new(1, -52, 0, 8) }, C.blue, C.gold)
	local fill = bar:FindFirstChild("Fill") :: Frame
	local xpTxt = text(lv, { Text = K.fmt(from.xp) .. " / " .. K.fmt(from.need) .. " XP", TextSize = 10, TextColor3 = C.dim, Position = UDim2.fromOffset(52, 32),
		Size = UDim2.new(1, -52, 0, 12), TextWrapped = false })
	animating = true
	task.delay(step(0.5), function()
		if my ~= recapToken then return end
		local level = from.level
		local levels = math.max(0, (to.level or level) - level)
		for _ = 1, levels do
			if my ~= recapToken then break end
			K.tween(fill, 0.55, { Size = UDim2.fromScale(1, 1) }); task.wait(0.6)
			level += 1
			badge:Destroy(); badge = K.levelBadge(badgeHolder, level, 40)
			local sc = make("UIScale", { Scale = 1.6 }, badge); K.tween(sc, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)
			lvlL.Text = "NIVEAU " .. level .. '  <font color="#ffd23a">▲</font>'
			pcall(function() Sfx.play(ModeConfig.SOUNDS.streak) end)
			fill.Size = UDim2.fromScale(0, 1)
		end
		if my ~= recapToken then return end
		K.tween(fill, 0.7, { Size = UDim2.fromScale(math.clamp(to.xp / math.max(1, to.need), 0, 1), 1) })
		xpTxt.Text = K.fmt(to.xp) .. " / " .. K.fmt(to.need) .. " XP  ·  encore " .. K.fmt(math.max(0, to.need - to.xp)) .. " XP"
		task.wait(0.8)
		animating = false
		showLevelUp()
	end)

	-- passe de combat
	local bp = rc.bp
	if typeof(bp) == "table" then
		local pr = row(nextOrder(), 40)
		text(pr, { Text = "🎟 PASSE DE COMBAT · PALIER " .. bp.tier .. " / " .. bp.max .. (if (bp.gained or 0) > 0 then '  <font color="#7dff9f">+' .. bp.gained .. "</font>" else ""),
			Font = K.BLACK, TextSize = 12, Size = UDim2.new(1, 0, 0, 16), TextWrapped = false })
		K.bar(pr, bp.frac or 0, { Position = UDim2.fromOffset(0, 20), Size = UDim2.new(1, 0, 0, 5) }, C.purple, C.violet)
		if (bp.claimable or 0) > 0 then
			text(pr, { Text = "🎁 " .. bp.claimable .. " récompense(s) à récupérer", TextSize = 11, TextColor3 = C.gold, Position = UDim2.fromOffset(0, 28), Size = UDim2.new(1, -110, 0, 12), TextWrapped = false })
		end
		local b = K.btn(pr, spaced("VOIR LE PASSE", 1), "purple", function() local f = S.panels.pass; if f then task.spawn(f) end end,
			{ AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, 0, 0, 26), Size = UDim2.fromOffset(104, 16), TextSize = 9, Modal = true })
		fadeIn(pr, step(0.1)); local _ = b
	end
	-- défis terminés pendant la partie
	for _, c in ipairs(if typeof(rc.challenges) == "table" then rc.challenges else {}) do
		local r = text(recap, { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 11, Font = K.BOLD,
			TextColor3 = if c.weekly then C.violet else C.green,
			Text = "✔ " .. (if c.weekly then "Défi de la semaine" else "Défi du jour") .. " : " .. K.esc(tostring(c.text)) .. '  <font color="#ffd23a">💰 ' .. tostring(c.coins) .. " · " .. tostring(c.xp) .. " XP</font> à récupérer" })
		fadeIn(r, step(0.1))
	end
	if rc.firstWinLeft and not rc.firstWin then
		local r = text(recap, { LayoutOrder = nextOrder(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, TextSize = 11, TextColor3 = C.dim,
			Text = "🏆 Première victoire du jour encore à prendre : +100 XP, +25 pièces" })
		fadeIn(r, step(0.1))
	end
	-- apparition du panneau
	recap.Position = UDim2.new(1, 40, 0.56, 0)
	K.tween(recap, 0.45, { Position = UDim2.new(1, -18, 0.56, 0) }, Enum.EasingStyle.Quint)
end

local endRemote = ReplicatedStorage:WaitForChild("MatchEnd", 30) :: RemoteEvent?
if endRemote then
	endRemote.OnClientEvent:Connect(function(r: any)
		if typeof(r) ~= "table" or typeof(r.recap) ~= "table" then return end
		buildRecap(r.recap)
		local my = recapToken
		task.delay((tonumber(r.next) or 15) + 0.5, function() if my == recapToken then recap.Visible = false end end)
	end)
end
-- quitter la partie ou une nouvelle partie : le bilan disparaît
local function hideRecap() recapToken += 1; recap.Visible = false; animating = false end
player:GetAttributeChangedSignal("Zone"):Connect(function()
	if player:GetAttribute("Zone") ~= "match" then hideRecap(); task.defer(function() showLevelUp() end) end
end)
local stateRemote = ReplicatedStorage:WaitForChild("TDMState", 30) :: RemoteEvent?
if stateRemote then
	stateRemote.OnClientEvent:Connect(function(st: any)
		if typeof(st) == "table" and st.warmup and recap.Visible then hideRecap() end
	end)
end

-- =====================================================================================
-- NIVEAU SUPÉRIEUR
-- =====================================================================================
local veil = make("TextButton", { Name = "LevelUp", Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.rgb(0x05080e), BackgroundTransparency = 1, Text = "",
	AutoButtonColor = false, Visible = false, ZIndex = 20 }, gui)
local card = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.45), Size = UDim2.fromOffset(460, 300), BackgroundTransparency = 0,
	BackgroundColor3 = C.white, ZIndex = 21 }, veil)
K.corner(card, 18); K.gradient(card, K.rgb(0x1d2a45), K.rgb(0x0b111c), 90); K.stroke(card, C.gold, 2, 0.2)
local cardScale = make("UIScale", { Scale = 1 }, card)
-- rayons qui tournent derrière le badge
local rays = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 94), Size = UDim2.fromOffset(220, 220), ZIndex = 21 }, card)
for i = 1, 8 do
	local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(14, 200), Rotation = i * 22.5,
		BackgroundTransparency = 0.9, BackgroundColor3 = C.gold, ZIndex = 21 }, rays)
	K.corner(f, 7)
end
local title = text(card, { Text = spaced("NIVEAU SUPÉRIEUR", 3), Font = K.BLACK, TextSize = 26, TextColor3 = C.gold, Position = UDim2.fromOffset(0, 16),
	Size = UDim2.new(1, 0, 0, 30), TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, ZIndex = 23 })
local badgeBox = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 56), Size = UDim2.fromOffset(76, 76), ZIndex = 23 }, card)
local rewardL = text(card, { Text = "", Font = K.BLACK, TextSize = 17, Position = UDim2.fromOffset(20, 150), Size = UDim2.new(1, -40, 0, 44),
	TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 23 })
local nextL = text(card, { Text = "", TextSize = 12, TextColor3 = C.dim, Position = UDim2.fromOffset(20, 200), Size = UDim2.new(1, -40, 0, 32),
	TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 23 })
local okBtn = K.btn(card, spaced("SUPER !", 2), "gold", nil, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(160, 36),
	TextSize = 13, ZIndex = 23, Modal = true })
local luToken = 0
local showing = false
local function closeLevelUp()
	if not showing then return end
	luToken += 1
	showing = false
	K.tween(veil, 0.2, { BackgroundTransparency = 1 })
	K.tween(cardScale, 0.2, { Scale = 0.7 })
	task.delay(0.2, function()
		veil.Visible = false
		showLevelUp()
	end)
end
okBtn.Activated:Connect(closeLevelUp)
veil.Activated:Connect(closeLevelUp)
task.spawn(function()
	while true do
		task.wait(1 / 30)
		if veil.Visible then rays.Rotation = (rays.Rotation + 0.6) % 360 end
	end
end)

showLevelUp = function()
	if showing or animating or #levelQueue == 0 then return end
	if player:GetAttribute("Zone") == "match" and not recap.Visible then
		-- en pleine partie (défi récupéré, médaille…) : on attend la fin de la partie pour ne pas gêner
		return
	end
	local d = table.remove(levelQueue, 1)
	showing = true
	luToken += 1
	local my = luToken
	local ups = if typeof(d.ups) == "table" then d.ups else {}
	local last = ups[#ups] or { level = d.level }
	K.clear(badgeBox)
	local b = K.levelBadge(badgeBox, tonumber(last.level) or 1, 76)
	b.ZIndex = 23
	for _, c in ipairs(b:GetDescendants()) do if c:IsA("GuiObject") then c.ZIndex = 24 end end
	title.Text = spaced(if #ups > 1 then "+" .. #ups .. " NIVEAUX !" else "NIVEAU SUPÉRIEUR", 3)
	local lines = {}
	for _, u in ipairs(ups) do table.insert(lines, rewardText(u.reward)) end
	rewardL.Text = "Récompense débloquée\n" .. table.concat(lines, "   ")
	local ms = d.milestone
	nextL.Text = if typeof(ms) == "table" then "Prochain gros palier : niveau " .. tostring(ms.level) .. " — " .. rewardText(ms.reward) else ""
	veil.Visible = true; veil.BackgroundTransparency = 1
	K.tween(veil, 0.3, { BackgroundTransparency = 0.45 })
	cardScale.Scale = 0.4 * screenScale()
	K.tween(cardScale, 0.45, { Scale = screenScale() }, Enum.EasingStyle.Back)
	pcall(function() Sfx.play(ModeConfig.SOUNDS.streak) end)
	task.delay(6, function() if my == luToken then closeLevelUp() end end)
end

local luRemote = ReplicatedStorage:WaitForChild("LevelUp", 30) :: RemoteEvent?
if luRemote then
	luRemote.OnClientEvent:Connect(function(d: any)
		if typeof(d) ~= "table" then return end
		table.insert(levelQueue, d)
		-- MatchEnd arrive juste après : on laisse le bilan démarrer avant d'afficher quoi que ce soit
		task.delay(0.6, showLevelUp)
	end)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="835">
        <Properties>
          <string name="Name">ShieldController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ShieldController (LocalScript)
-- Bouclier et objets à ramasser, comme le jeu web :
--   * les objets (cristal de bouclier, cube de santé, boîte de munitions) tournent et flottent au-dessus de leur anneau ;
--   * message « +25 bouclier » / « +35 santé » / « Munitions » et son quand on en ramasse un ;
--   * étincelles bleues (au lieu du sang) quand une balle frappe un soldat qui a encore du bouclier.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local tracerRemote = ReplicatedStorage:WaitForChild("Tracer") :: RemoteEvent

-- ---------- objets qui tournent ----------
type Spin = { model: Model, core: BasePart, parts: { [BasePart]: CFrame }, base: Vector3, phase: number }
local spins: { [Model]: Spin } = {}

local function track(m: Instance)
	if not m:IsA("Model") or m:GetAttribute("Pickup") == nil or spins[m] then return end
	local core = m:WaitForChild("Core", 5) :: BasePart?
	if not core or not m.Parent then return end
	local parts: { [BasePart]: CFrame } = {}
	for _, p in ipairs(m:GetChildren()) do
		if p:IsA("BasePart") and p.Name ~= "Ring" and p.Name ~= "Zone" then parts[p] = core.CFrame:ToObjectSpace(p.CFrame) end
	end
	spins[m] = { model = m, core = core, parts = parts, base = core.Position, phase = core.Position.X }
	m.AncestryChanged:Connect(function() if not m:IsDescendantOf(workspace) then spins[m] = nil end end)
end
workspace.DescendantAdded:Connect(function(d: Instance) if d:IsA("Model") and d.Name:sub(1, 7) == "Pickup_" then task.spawn(track, d) end end)
for _, d in ipairs(workspace:GetDescendants()) do if d:IsA("Model") and d.Name:sub(1, 7) == "Pickup_" then task.spawn(track, d) end end

local U = require(ReplicatedStorage.Shared.Config).STUDS_PER_METER   -- flottement de 10 cm comme le web
RunService.RenderStepped:Connect(function()
	local t = os.clock()
	for _, s in pairs(spins) do
		local cf = CFrame.new(s.base + Vector3.new(0, math.sin(t * 2 + s.phase) * 0.1 * U, 0)) * CFrame.Angles(0, t * 1.6, 0)
		for p, off in pairs(s.parts) do
			if p.Name == "Core" and s.model:GetAttribute("Pickup") == "shield" then p.CFrame = cf * CFrame.Angles(math.rad(45), 0, math.rad(35.26))
			else p.CFrame = cf * (if p.Name == "Core" then CFrame.identity else off) end
		end
	end
end)

-- ---------- message de ramassage ----------
local gui = Instance.new("ScreenGui"); gui.Name = "PickupToast"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.DisplayOrder = 12
gui.Parent = player:WaitForChild("PlayerGui")
local toast = Instance.new("TextLabel"); toast.AnchorPoint = Vector2.new(0.5, 0); toast.Position = UDim2.new(0.5, 0, 0.62, 0)
toast.Size = UDim2.fromOffset(300, 30); toast.BackgroundTransparency = 1; toast.Font = Enum.Font.GothamBlack; toast.TextSize = 20
toast.TextColor3 = Color3.new(1, 1, 1); toast.TextStrokeTransparency = 0.5; toast.TextTransparency = 1; toast.Text = ""; toast.Parent = gui
local TOAST: { [string]: { any } } = { shield = { "+25 bouclier", Color3.fromRGB(95, 214, 255), "pickup" }, health = { "+35 santé", Color3.fromRGB(255, 120, 130), "heal" },
	ammo = { "Munitions", Color3.fromRGB(255, 215, 94), "pickup" } }
local toastId = 0
local remote = ReplicatedStorage:WaitForChild("PickupToast", 30) :: RemoteEvent?
if remote then
	remote.OnClientEvent:Connect(function(kind: string)
		local d = TOAST[kind]
		if not d then return end
		toastId += 1
		local my = toastId
		toast.Text = d[1]; toast.TextColor3 = d[2]; toast.TextTransparency = 0; toast.Position = UDim2.new(0.5, 0, 0.62, 0)
		TweenService:Create(toast, TweenInfo.new(1.4), { Position = UDim2.new(0.5, 0, 0.6, 0) }):Play()
		Sfx.play(d[3])
		task.delay(1.1, function() if my == toastId then TweenService:Create(toast, TweenInfo.new(0.3), { TextTransparency = 1 }):Play() end end)
	end)
end

-- ---------- étincelles bleues sur un bouclier touché ----------
local function soldiers(): { Model }
	local list = {}
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(list, p.Character) end end
	local bots = workspace:FindFirstChild("Bots")
	if bots then for _, b in ipairs(bots:GetChildren()) do if b:IsA("Model") then table.insert(list, b) end end end
	return list
end

local function sparks(at: Vector3, dir: Vector3)
	local a = Instance.new("Attachment"); a.WorldPosition = at; a.Parent = workspace.Terrain
	a.WorldCFrame = CFrame.lookAt(at, at - dir)
	local e = Instance.new("ParticleEmitter")
	e.Color = ColorSequence.new(Color3.fromRGB(150, 230, 255), Color3.fromRGB(40, 150, 255))
	e.LightEmission = 1; e.LightInfluence = 0
	e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35), NumberSequenceKeypoint.new(1, 0) })
	e.Speed = NumberRange.new(8, 18); e.SpreadAngle = Vector2.new(55, 55); e.Lifetime = NumberRange.new(0.15, 0.35)
	e.Acceleration = Vector3.new(0, -25, 0); e.Rate = 0; e.EmissionDirection = Enum.NormalId.Front; e.Parent = a
	e:Emit(10)
	-- éclat de la bulle du bouclier
	local flash = Instance.new("Part"); flash.Shape = Enum.PartType.Ball; flash.Anchored = true; flash.CanCollide = false; flash.CanQuery = false
	flash.CanTouch = false; flash.CastShadow = false; flash.Material = Enum.Material.Neon; flash.Color = Color3.fromRGB(90, 200, 255)
	flash.Transparency = 0.45; flash.Size = Vector3.new(0.6, 0.6, 0.6); flash.Position = at; flash.Parent = workspace
	TweenService:Create(flash, TweenInfo.new(0.18), { Size = Vector3.new(2.2, 2.2, 2.2), Transparency = 1 }):Play()
	Debris:AddItem(flash, 0.2); Debris:AddItem(a, 0.6)
end

tracerRemote.OnClientEvent:Connect(function(origin: Vector3, endPos: Vector3, shooter: Instance?)
	for _, m in ipairs(soldiers()) do
		if m ~= shooter then
			local sh = m:GetAttribute("Shield")
			local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
			if typeof(sh) == "number" and sh > 0 and root and (root.Position - endPos).Magnitude < 3.5 then
				sparks(endPos, (endPos - origin).Unit)
				return
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="836">
        <Properties>
          <string name="Name">ShopUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ShopUI (LocalScript)
-- BOUTIQUE (façon Fortnite / Arsenal) : onglets en haut, contenu à gauche, aperçu de l'objet choisi à droite.
--  · « À la une » : pack de départ (offre unique, disparaît une fois acheté), offre vedette -40 %, 4 offres du jour -25 %
--    avec le compte à rebours, promo du passe de combat Premium, passe de jeu XP ×2.
--  · « Pièces » : lots de pièces présentés comme dans les grands jeux (bonus en % par rapport au plus petit lot,
--    étiquettes POPULAIRE / MEILLEURE VALEUR), puis caisses Premium.
--  · Aperçu : cliquer une carte montre l'arme en 3D (avec le skin ou le camo animé) avant d'acheter.
-- Un produit Robux dont le numéro vaut 0 dans ProductIds affiche « Bientôt disponible » et ne s'achète pas.
-- Le serveur (ShopService) vérifie chaque achat ; ici on ne fait qu'afficher.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local MarketplaceService = game:GetService("MarketplaceService")
local Config = require(ReplicatedStorage.Shared.Config)
local Catalog = require(ReplicatedStorage.Shared.ShopCatalog)
local ItemPreview = require(ReplicatedStorage.Shared.ItemPreview)
local S = require(ReplicatedStorage.Shared.ClientState)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local getShop = ReplicatedStorage:WaitForChild("GetShop") :: RemoteFunction
local shopBuy = ReplicatedStorage:WaitForChild("ShopBuy") :: RemoteFunction
local shopEquip = ReplicatedStorage:WaitForChild("ShopEquip") :: RemoteFunction
local equipSkin = ReplicatedStorage:WaitForChild("EquipSkin") :: RemoteFunction

local SOON = "Bientôt disponible"
local W, H = 1060, 620

-- ---------- Fenêtre ----------
local gui = make("ScreenGui", { Name = "ShopUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 30, Enabled = true,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local veil = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.rgb(0x05080e), BackgroundTransparency = 0.35, Text = "",
	AutoButtonColor = false, Modal = true, Visible = false }, gui)
local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(W, H),
	BackgroundTransparency = 0, BackgroundColor3 = C.white, Visible = false }, gui)
K.corner(win, 16); K.gradient(win, K.rgb(0x141c2c), K.rgb(0x0b111c), 90); K.stroke(win, C.white, 1, 0.85)
local winScale = make("UIScale", { Scale = 1 }, win)
local function fit()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	winScale.Scale = math.clamp(math.min((vp.X - 24) / W, (vp.Y - 24) / H), 0.45, 1.2)
end

text(win, { Position = UDim2.fromOffset(26, 16), Size = UDim2.fromOffset(400, 32), Font = K.BLACK, TextSize = 28, TextWrapped = false,
	Text = "🛒  " .. spaced("BOUTIQUE", 3) })
local coinsLabel = text(win, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -72, 0, 20), Size = UDim2.fromOffset(260, 26), Font = K.BLACK,
	TextSize = 20, TextColor3 = C.gold, TextXAlignment = Enum.TextXAlignment.Right, TextWrapped = false, Text = "…" })
-- pièce dessinée juste à gauche du montant (l'emoji pièce du web donne un carré vide dans Roblox)
local coinIcon = require(ReplicatedStorage.Shared.Icons).coin(win, 20, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -110, 0, 23) })
coinsLabel:GetPropertyChangedSignal("TextBounds"):Connect(function()
	coinIcon.Position = UDim2.new(1, -72 - coinsLabel.TextBounds.X - 8, 0, 23)
end)
local function close() win.Visible = false; veil.Visible = false end
K.btn(win, "✕", "dark", close, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 14), Size = UDim2.fromOffset(42, 42), TextSize = 18 })
veil.Activated:Connect(close)

local tabBar = make("Frame", { Position = UDim2.fromOffset(24, 62), Size = UDim2.new(1, -48, 0, 36) }, win)
K.hlist(tabBar, 6)
local toast = text(win, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 26, 1, -10), Size = UDim2.new(1, -360, 0, 20), TextSize = 14,
	Font = K.BOLD, TextColor3 = C.gold, TextWrapped = false, Text = "" })

-- contenu (gauche) et aperçu (droite)
local body = K.scroll(win, { Position = UDim2.fromOffset(24, 110), Size = UDim2.new(1, -350, 1, -150) })
K.pad(body, 2, 2, 10, 10); K.vlist(body, 10)
local side = make("Frame", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -24, 0, 110), Size = UDim2.new(0, 300, 1, -134),
	BackgroundTransparency = 0, BackgroundColor3 = C.white }, win)
K.corner(side, 14); K.gradient(side, K.rgb(0x1a2438), K.rgb(0x0b111c), 90, 0.1, 0.15); K.stroke(side, C.white, 1, 0.88)

-- ---------- État ----------
local state: any = nil
local fetchedAt = 0
local currentTab = "featured"
local selected: any = nil
local gunKeys = {}
for _, k in ipairs(Catalog.WEAPON_KEYS) do if not Config.WEAPONS[k].melee then table.insert(gunKeys, k) end end
local weaponIndex = table.find(gunKeys, "ak") or 1
local countdowns: { TextLabel } = {}

local render: () -> ()
local renderSide: () -> ()

local function refresh()
	local ok, res = pcall(getShop.InvokeServer, getShop)
	if ok and res then state = res; fetchedAt = os.clock() end
	if state then coinsLabel.Text = K.fmt(state.coins) end
	render()
end

local function say(msg: string, color: Color3?)
	toast.Text = msg; toast.TextColor3 = color or C.gold
	task.delay(3.5, function() if toast.Text == msg then toast.Text = "" end end)
end

local function leftText(): string
	if not state then return "" end
	local s = math.max(0, (state.secondsToReset or 0) - math.floor(os.clock() - fetchedAt))
	return string.format("%d h %02d min %02d s", s // 3600, s % 3600 // 60, s % 60)
end

local function iconFor(it: any): string
	local k = it.kind
	if k == "weapon" then return "🔫" elseif k == "skin" then return "🎨" elseif k == "sight" then return "🔭" elseif k == "reticle" then return "➕"
	elseif k == "outfit" then return "👕" elseif k == "trail" then return "✨" elseif k == "killfx" then return "💥" elseif k == "vip" then return "👑"
	elseif k == "exclusive" then return "🌈" elseif k == "gamepass" then return "⚡" elseif it.once then return "🎁"
	elseif k == "devproduct" then return if it.premium then "⭐" elseif it.box then "📦" else "💰" end
	return "🏷"
end

local function offerOf(id: string): any
	if not state then return nil end
	for _, o in ipairs(state.offers) do if o.id == id then return o end end
	return nil
end

-- achat Robux : Roblox affiche sa propre fenêtre de paiement, le serveur crédite dans ProcessReceipt
local function robuxBuy(it: any)
	local ok, res = pcall(shopBuy.InvokeServer, shopBuy, it.id)
	if ok and res and res.err then say(res.err, C.accent2) end
end

-- Libellé, style et action du bouton d'un objet
local function actionFor(it: any): (string, string, (() -> ())?)
	local owned = state and state.owned[it.id]
	if it.kind == "gamepass" then
		if state and state.passes and state.passes[it.id] then return "Possédé ✔", "dark", nil end
		if (it.passId or 0) <= 0 then return SOON, "dark", nil end
		return "R$ " .. it.robux, "green", function() robuxBuy(it) end
	end
	if it.once and owned then return "Déjà acheté ✔", "dark", nil end
	if it.kind == "devproduct" or it.kind == "vip" then   -- vip = abonnement Premium, se rachète pour ajouter des jours
		if (it.productId or 0) <= 0 then return SOON, "dark", nil end
		return "R$ " .. it.robux, "green", function() robuxBuy(it) end
	end
	if it.kind == "exclusive" and not owned then                 -- exclusif : Robux uniquement
		if (it.productId or 0) <= 0 then return SOON, "dark", nil end
		return "R$ " .. it.robux, "green", function() robuxBuy(it) end
	end
	if it.kind == "killfx" and not owned and it.source ~= "coins" then   -- effet d'élimination exclusif, de code ou de groupe
		if it.source == "code" then return "Code 🔑", "dark", nil end
		if it.source == "group" then return "Groupe 👥", "dark", nil end
		if it.source == "event" then return "Événement 🎃", "dark", nil end
		if (it.productId or 0) <= 0 then return SOON, "dark", nil end
		return "R$ " .. it.robux, "green", function() robuxBuy(it) end
	end
	if not owned then
		if it.event then return "Événement 🎃", "dark", nil end
		local o = offerOf(it.id)
		local price = if o then o.price else it.price
		return "💰 " .. K.fmt(price), if state and state.coins >= price then "primary" else "alt", function()
			local ok, res = pcall(shopBuy.InvokeServer, shopBuy, it.id)
			if ok and res and res.ok then say("Acheté : " .. it.name .. " !", C.green); pcall(function() K.uiSound(false) end)
			else say("Achat impossible : " .. (if ok and res and res.err then res.err else "erreur"), C.accent2) end
			refresh()
		end
	end
	local eq = state.equipped
	local weapon = gunKeys[weaponIndex]
	local isEquipped = (it.kind == "outfit" and eq.outfit == it.outfit) or (it.kind == "reticle" and eq.reticle == it.reticle)
		or (it.kind == "trail" and eq.trail == it.trail) or (it.kind == "sight" and (eq.sights or {})[weapon] == it.sight)
		or (it.kind == "skin" and state.equippedSkins[it.weapon] == it.skin)
		or (it.kind == "exclusive" and it.camo ~= nil and (eq.animCamo or {})[weapon] == it.camo)
		or (it.kind == "killfx" and (eq.killFx or "none") == it.fx)
	if isEquipped then return "Équipé ✔", "dark", nil end
	if it.kind == "weapon" or it.kind == "misc" or (it.kind == "exclusive" and not it.camo) then return "Possédé ✔", "dark", nil end
	return "Équiper", "blue", function()
		local ok, res
		if it.kind == "skin" then ok, res = pcall(equipSkin.InvokeServer, equipSkin, it.weapon, it.skin)
		else ok, res = pcall(shopEquip.InvokeServer, shopEquip, it.id, weapon) end
		if not (ok and res) then say("Impossible d'équiper cet objet", C.accent2) end
		refresh()
	end
end

local function select(it: any)
	selected = it
	renderSide()
end

-- étiquette de coin (-25 %, POPULAIRE…)
local function tag(parent: Instance, str: string, color: Color3, dark: boolean?)
	local t = text(parent, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(0, 20), AutomaticSize = Enum.AutomaticSize.X,
		Font = K.BLACK, TextSize = 11, TextWrapped = false, BackgroundTransparency = 0, BackgroundColor3 = color, Text = " " .. str .. " ",
		TextColor3 = if dark then C.ink else C.white, TextXAlignment = Enum.TextXAlignment.Center, ZIndex = 3 })
	K.corner(t, 6); K.pad(t, 6, 0, 6, 0)
	return t
end

-- carte d'objet de la grille : bande de rareté, icône, nom, prix barré pour les offres, bouton
local function card(it: any, parent: Instance, order: number, size: UDim2?): Frame
	local rc = K.rarityColor(it.rarity or 1)
	local f = make("TextButton", { LayoutOrder = order, Size = size or UDim2.fromOffset(0, 0), BackgroundTransparency = 0, BackgroundColor3 = C.white,
		Text = "", AutoButtonColor = false, Selectable = true }, parent)
	K.corner(f, 12); K.gradient(f, rc:Lerp(K.rgb(0x0b111c), 0.72), K.rgb(0x0b111c), 90)
	K.stroke(f, if selected == it then C.white else rc, if selected == it then 2 else 1, if selected == it then 0.1 else 0.55)
	f.Activated:Connect(function() select(it) end)
	K.juice(f :: any, 0.03)   -- survol / manette : la carte grossit un peu, son d'interface (comme les cartes du menu)
	make("Frame", { Size = UDim2.new(1, 0, 0, 4), BackgroundTransparency = 0, BackgroundColor3 = rc }, f)
	text(f, { Position = UDim2.fromOffset(10, 12), Size = UDim2.new(1, -20, 0, 40), TextSize = 34, TextXAlignment = Enum.TextXAlignment.Left, Text = iconFor(it) })
	text(f, { Position = UDim2.fromOffset(12, 56), Size = UDim2.new(1, -24, 0, 34), Font = K.BOLD, TextSize = 13, TextYAlignment = Enum.TextYAlignment.Top,
		TextTruncate = Enum.TextTruncate.AtEnd, Text = it.name })
	local o = offerOf(it.id)
	if o and not (state and state.owned[it.id]) then
		tag(f, "-" .. o.off .. " %", if o.featured then C.gold else C.accent, o.featured)
		text(f, { Position = UDim2.fromOffset(12, 88), Size = UDim2.new(1, -24, 0, 14), TextSize = 11, TextColor3 = C.mute, TextWrapped = false,
			Text = "au lieu de " .. K.fmt(o.was) .. " 💰" })
	end
	local label, kind, cb = actionFor(it)
	K.btn(f, label, kind, cb or function() select(it) end, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -20, 0, 32),
		TextSize = if #label > 14 then 11 else 13, AutoButtonColor = cb ~= nil })
	return f :: any
end

local function section(title: string, small: string?, order: number, color: Color3?): Frame
	local row = K.h4(body, title, small, order, color)
	row.Size = UDim2.new(1, 0, 0, 24)
	return row
end
local function gridBox(order: number, cell: UDim2): Frame
	local g = make("Frame", { LayoutOrder = order, Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, body)
	K.grid(g, cell, 10)
	return g
end

-- ---------- Onglet « À la une » ----------
local function renderFeatured()
	local n = 0
	local function nx(): number n += 1; return n end
	-- pack de départ (une seule fois par compte)
	local st = Catalog.get(Catalog.STARTER.id)
	if st and not state.owned[st.id] then
		local b = make("TextButton", { LayoutOrder = nx(), Size = UDim2.new(1, 0, 0, 150), BackgroundTransparency = 0, BackgroundColor3 = C.white,
			Text = "", AutoButtonColor = false }, body)
		K.corner(b, 14); K.gradient(b, K.rgb(0x5a3a08), K.rgb(0x1a1206), 0); K.stroke(b, C.gold, 2, 0.2)
		b.Activated:Connect(function() select(st) end)
		K.juice(b :: any, 0.015)
		text(b, { Position = UDim2.fromOffset(20, 14), Size = UDim2.fromOffset(120, 120), TextSize = 86, TextXAlignment = Enum.TextXAlignment.Center, Text = "🎁" })
		text(b, { Position = UDim2.fromOffset(150, 16), Size = UDim2.new(1, -360, 0, 26), Font = K.BLACK, TextSize = 22, TextColor3 = C.gold, TextWrapped = false,
			Text = spaced("PACK DE DÉPART", 2) })
		text(b, { Position = UDim2.fromOffset(150, 44), Size = UDim2.new(1, -360, 0, 16), TextSize = 12, TextColor3 = C.sub, TextWrapped = false,
			Text = "Offre unique : une seule fois par compte !" })
		for i, l in ipairs(Catalog.STARTER.lines) do
			text(b, { Position = UDim2.fromOffset(150 + ((i - 1) % 2) * 190, 70 + (i - 1) // 2 * 24), Size = UDim2.fromOffset(186, 20), Font = K.BOLD, TextSize = 13,
				TextWrapped = false, Text = "✔ " .. l })
		end
		tag(b, "VALEUR ×4", C.accent)
		local label, kind, cb = actionFor(st)
		local btn = K.btn(b, label, if kind == "green" then "gold" else kind, cb, { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -18, 1, -18),
			Size = UDim2.fromOffset(190, 46), TextSize = if #label > 14 then 13 else 18 })
		if cb then K.beat(btn, 1.05, 1.2) end
		K.shine(b, 3, 0.25)
	end
	-- offres du jour : vedette (-40 %) + 4 offres (-25 %)
	local cd = section("🔥 OFFRES DU JOUR", "nouvelles offres dans " .. leftText(), nx(), C.gold)
	for _, c in ipairs(cd:GetChildren()) do
		if c:IsA("TextLabel") and string.sub(c.Text, 1, 9) == "nouvelles" then table.insert(countdowns, c) end
	end
	local row = make("Frame", { LayoutOrder = nx(), Size = UDim2.new(1, 0, 0, 0), AutomaticSize = Enum.AutomaticSize.Y }, body)
	K.hlist(row, 10, Enum.VerticalAlignment.Top, true)
	local feat, daily = nil, {}
	for _, o in ipairs(state.offers) do
		local it = Catalog.get(o.id)
		if it then if o.featured then feat = it else table.insert(daily, it) end end
	end
	if feat then
		local f = card(feat, row, 0, UDim2.fromOffset(200, 290))
		K.stroke(f, C.gold, 2, 0.1)
		text(f, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 12, 1, -50), Size = UDim2.new(1, -24, 0, 14), Font = K.BLACK, TextSize = 11, TextColor3 = C.gold,
			TextWrapped = false, Text = "★ " .. spaced("OFFRE VEDETTE", 1) })
		if feat.weapon and (feat.kind == "weapon" or feat.kind == "skin") then
			local holder = make("Frame", { Position = UDim2.fromOffset(6, 104), Size = UDim2.new(1, -12, 0, 116) }, f)
			ItemPreview.weapon(holder, feat.weapon, if feat.kind == "skin" then feat.skin else nil, nil, nil, true)
		end
		K.shine(f, 2.6, 0.25)
	end
	local grid = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, -210, 0, 290) }, row)
	K.grid(grid, UDim2.new(0.5, -5, 0, 140), 10)
	for i, it in ipairs(daily) do card(it, grid, i) end
	-- passe de combat Premium et passe de jeu XP ×2
	section("⭐ ACCÉLÈRE TA PROGRESSION", nil, nx())
	local promo = make("Frame", { LayoutOrder = nx(), Size = UDim2.new(1, 0, 0, 120) }, body)
	K.hlist(promo, 10)
	local pass = make("TextButton", { Size = UDim2.new(0.5, -5, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = C.white, Text = "", AutoButtonColor = false }, promo)
	K.corner(pass, 14); K.gradient(pass, K.rgb(0x4a2a8a), K.rgb(0x0b111c), 0); K.stroke(pass, C.violet, 1.5, 0.3)
	text(pass, { Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 22), Font = K.BLACK, TextSize = 16, TextWrapped = false, Text = "🎖 " .. spaced("PASSE DE COMBAT PREMIUM", 1) })
	text(pass, { Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 34), TextSize = 12, TextColor3 = C.sub,
		Text = "Débloque la ligne Premium : skins, caisses et pièces à chaque palier." })
	K.btn(pass, "VOIR LE PASSE", "purple", function() local f = S.panels.pass; if f then close(); f() end end,
		{ AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -12), Size = UDim2.fromOffset(150, 32), TextSize = 12 })
	pass.Activated:Connect(function() local it = Catalog.get("pass_premium"); if it then select(it) end end)
	K.juice(pass :: any, 0.02)
	for _, g in ipairs(Catalog.GAMEPASSES) do
		local it = Catalog.get(g.id)
		if it then
			local gp = make("TextButton", { Size = UDim2.new(0.5, -5, 1, 0), BackgroundTransparency = 0, BackgroundColor3 = C.white, Text = "", AutoButtonColor = false }, promo)
			K.corner(gp, 14); K.gradient(gp, K.rgb(0x0a4a5a), K.rgb(0x0b111c), 0); K.stroke(gp, C.blue, 1.5, 0.3)
			gp.Activated:Connect(function() select(it) end)
			K.juice(gp :: any, 0.02)
			text(gp, { Position = UDim2.fromOffset(16, 14), Size = UDim2.new(1, -32, 0, 22), Font = K.BLACK, TextSize = 16, TextWrapped = false, Text = "⚡ " .. spaced(K.upper(it.name), 1) })
			text(gp, { Position = UDim2.fromOffset(16, 40), Size = UDim2.new(1, -32, 0, 34), TextSize = 12, TextColor3 = C.sub, Text = it.desc })
			local label, kind, cb = actionFor(it)
			K.btn(gp, label, kind, cb, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 16, 1, -12), Size = UDim2.fromOffset(170, 32), TextSize = 12 })
		end
	end
end

-- ---------- Onglet « Pièces » ----------
local function renderCoins()
	local base = Catalog.get("coins_s")
	local rate = if base and base.robux > 0 then base.coins / base.robux else 0
	section("💰 LOTS DE PIÈCES", "Les pièces achètent armes, skins, viseurs et tenues", 1, C.gold)
	local g = gridBox(2, UDim2.new(0.25, -8, 0, 230))
	local n = 0
	for _, it in ipairs(Catalog.ITEMS) do
		if it.tab == "robux" and it.coins then
			n += 1
			local tagName = Catalog.BUNDLE_TAGS[it.id]
			local f = make("TextButton", { LayoutOrder = n, BackgroundTransparency = 0, BackgroundColor3 = C.white, Text = "", AutoButtonColor = false }, g)
			K.corner(f, 14)
			K.gradient(f, if tagName then K.rgb(0x4a3108) else K.rgb(0x1a2438), K.rgb(0x0b111c), 90)
			K.stroke(f, if tagName then C.gold elseif selected == it then C.white else C.white, if tagName then 2 else 1, if tagName then 0.15 else 0.85)
			f.Activated:Connect(function() select(it) end)
			K.juice(f :: any, 0.03)
			-- plus le lot est gros, plus la pile de pièces est haute
			text(f, { Position = UDim2.fromOffset(0, 26), Size = UDim2.new(1, 0, 0, 70), TextSize = 30 + n * 8, TextXAlignment = Enum.TextXAlignment.Center,
				Text = string.rep("💰", math.min(n, 3)) })
			text(f, { Position = UDim2.fromOffset(0, 104), Size = UDim2.new(1, 0, 0, 30), Font = K.BLACK, TextSize = 26, TextXAlignment = Enum.TextXAlignment.Center,
				TextWrapped = false, Text = K.fmt(it.coins) })
			text(f, { Position = UDim2.fromOffset(0, 134), Size = UDim2.new(1, 0, 0, 16), Font = K.BOLD, TextSize = 12, TextColor3 = C.sub,
				TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Text = "pièces" })
			local bonus = if rate > 0 then math.floor((it.coins / it.robux / rate - 1) * 100 + 0.5) else 0
			if bonus > 0 then
				text(f, { Position = UDim2.fromOffset(0, 154), Size = UDim2.new(1, 0, 0, 16), Font = K.BLACK, TextSize = 13, TextColor3 = C.green,
					TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false, Text = "+" .. bonus .. " % de pièces en plus" })
			end
			if tagName then
				local t = tag(f, tagName, C.gold, true)
				t.AnchorPoint = Vector2.new(0.5, 0); t.Position = UDim2.new(0.5, 0, 0, -2)
				K.shine(f, 3, 0.2)
			end
			local label, kind, cb = actionFor(it)
			K.btn(f, label, kind, cb, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -24, 0, 36),
				TextSize = if #label > 14 then 11 else 15 })
		end
	end
	section("📦 CAISSES ET AUTRES", nil, 3)
	local g2 = gridBox(4, UDim2.fromOffset(170, 150))
	n = 0
	for _, it in ipairs(Catalog.ITEMS) do
		if it.tab == "robux" and not it.coins then n += 1; card(it, g2, n) end
	end
end

-- ---------- Autres onglets : grille d'objets ----------
local function renderGrid()
	local n = 0
	if currentTab == "skins" or currentTab == "sights" or currentTab == "exclusive" then
		local bar = make("Frame", { LayoutOrder = 0, Size = UDim2.new(1, 0, 0, 36) }, body)
		K.hlist(bar, 8, Enum.VerticalAlignment.Center)
		K.btn(bar, "◀", "alt", function() weaponIndex = (weaponIndex - 2) % #gunKeys + 1; render() end, { Size = UDim2.fromOffset(36, 36), LayoutOrder = 1 })
		text(bar, { LayoutOrder = 2, Size = UDim2.fromOffset(240, 36), Font = K.BLACK, TextSize = 16, TextXAlignment = Enum.TextXAlignment.Center, TextWrapped = false,
			Text = Config.WEAPONS[gunKeys[weaponIndex]].name })
		K.btn(bar, "▶", "alt", function() weaponIndex = weaponIndex % #gunKeys + 1; render() end, { Size = UDim2.fromOffset(36, 36), LayoutOrder = 3 })
		text(bar, { LayoutOrder = 4, Size = UDim2.fromOffset(260, 36), TextSize = 12, TextColor3 = C.dim, TextWrapped = false,
			Text = if currentTab == "exclusive" then "Arme utilisée pour l'aperçu et l'équipement" else "Arme choisie" })
	end
	local g = gridBox(1, UDim2.fromOffset(170, 150))
	local weapon = gunKeys[weaponIndex]
	for _, it in ipairs(Catalog.ITEMS) do
		if it.tab == currentTab and (it.kind ~= "skin" or it.weapon == weapon) then
			n += 1
			card(it, g, n)
		end
	end
end

-- ---------- Aperçu (droite) ----------
renderSide = function()
	K.clear(side)
	local it = selected
	if not it or not state then
		text(side, { Position = UDim2.fromOffset(20, 0), Size = UDim2.new(1, -40, 1, 0), TextSize = 14, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Center,
			Text = "Touche un objet pour le voir en détail avant de l'acheter." })
		return
	end
	local rc = K.rarityColor(it.rarity or 1)
	local stage = make("Frame", { Position = UDim2.fromOffset(12, 12), Size = UDim2.new(1, -24, 0, 210), BackgroundTransparency = 0, BackgroundColor3 = C.white }, side)
	K.corner(stage, 12); K.gradient(stage, rc:Lerp(K.rgb(0x0b111c), 0.55), K.rgb(0x0b111c), 90)
	local key: string? = nil
	local skin: number? = nil
	local camo: string? = nil
	if it.kind == "weapon" and not Config.WEAPONS[it.weapon].melee then key = it.weapon
	elseif it.kind == "weapon" then key = it.weapon
	elseif it.kind == "skin" then key = it.weapon; skin = it.skin
	elseif it.kind == "exclusive" then key = gunKeys[weaponIndex]; camo = it.camo or (it.camos and it.camos[1]) end
	if key then
		ItemPreview.weapon(stage, key, skin, camo, nil, true)
	else
		text(stage, { Size = UDim2.fromScale(1, 1), TextSize = 96, TextXAlignment = Enum.TextXAlignment.Center, Text = iconFor(it) })
	end
	local rar = Config.RARITY[it.rarity or 1]
	text(side, { Position = UDim2.fromOffset(16, 232), Size = UDim2.new(1, -32, 0, 16), Font = K.BLACK, TextSize = 11, TextColor3 = rc, TextWrapped = false,
		Text = spaced(K.upper(if rar and rar.name then rar.name else (if (it.rarity or 1) >= 5 then "Exclusif" else "")), 1) })
	text(side, { Position = UDim2.fromOffset(16, 250), Size = UDim2.new(1, -32, 0, 46), Font = K.BLACK, TextSize = 18, TextYAlignment = Enum.TextYAlignment.Top,
		Text = it.name })
	-- détails selon le type
	local lines = {}
	if it.once then for _, l in ipairs(Catalog.STARTER.lines) do table.insert(lines, "✔ " .. l) end; table.insert(lines, "Une seule fois par compte") end
	if it.desc then table.insert(lines, it.desc) end
	if it.coins and not it.once then table.insert(lines, K.fmt(it.coins) .. " pièces créditées tout de suite") end
	if it.boxes and not it.once then table.insert(lines, it.boxes .. " caisse" .. (if it.boxes > 1 then "s" else "") .. " Premium à ouvrir dans Cadeaux") end
	if it.premium then table.insert(lines, "Débloque toute la ligne Premium du passe de combat de la saison") end
	if it.days then table.insert(lines, it.days .. " jours de Premium : +20 % XP et pièces, pseudo en couleur, cadeau quotidien") end
	if it.kind == "exclusive" then table.insert(lines, "Camo animé sur toutes tes armes · s'obtient seulement ici") end
	if it.kind == "weapon" then table.insert(lines, "Débloquée pour toujours dans l'Arsenal") end
	if it.kind == "skin" then table.insert(lines, "Skin pour " .. Config.WEAPONS[it.weapon].name) end
	local o = offerOf(it.id)
	if o and not state.owned[it.id] then table.insert(lines, "Offre du jour : -" .. o.off .. " % (" .. K.fmt(o.was) .. " → " .. K.fmt(o.price) .. " 💰)") end
	local info = make("Frame", { Position = UDim2.fromOffset(16, 300), Size = UDim2.new(1, -32, 1, -360) }, side)
	K.vlist(info, 4)
	for i, l in ipairs(lines) do K.para(info, l, 12, C.sub, i) end
	local label, kind, cb = actionFor(it)
	local b = K.btn(side, label, kind, cb, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -12), Size = UDim2.new(1, -24, 0, 44),
		TextSize = if #label > 14 then 13 else 17, AutoButtonColor = cb ~= nil })
	if cb and kind ~= "blue" then K.beat(b, 1.04, 1.2) end
end

-- ---------- Rendu ----------
local tabButtons: { [string]: TextButton } = {}
render = function()
	K.clear(body)   -- garde le UIListLayout et le UIPadding (K.clear n'enlève que les GuiObject)
	table.clear(countdowns)
	for id, b in pairs(tabButtons) do K.setKind(b, if id == currentTab then "primary" else "alt") end
	if not state then
		K.para(body, "Chargement de la boutique…", 14, C.dim, 1)
		renderSide()
		return
	end
	if currentTab == "featured" then renderFeatured()
	elseif currentTab == "robux" then renderCoins()
	else renderGrid() end
	renderSide()
end

for i, tab in ipairs(Catalog.TABS) do
	local b = K.btn(tabBar, tab.name, "alt", function()
		currentTab = tab.id; selected = nil; body.CanvasPosition = Vector2.zero; render()
	end, { LayoutOrder = i, Size = UDim2.fromOffset(0, 36), AutomaticSize = Enum.AutomaticSize.X, TextSize = 12 })
	K.pad(b, 12, 0, 12, 0)
	tabButtons[tab.id] = b
end

-- compte à rebours des offres du jour (rafraîchit la boutique au changement de jour)
task.spawn(function()
	while true do
		task.wait(1)
		if win.Visible and state then
			local t = leftText()
			for _, l in ipairs(countdowns) do if l.Parent then l.Text = "nouvelles offres dans " .. t end end
			if (state.secondsToReset or 0) - (os.clock() - fetchedAt) <= 0 then refresh() end
		end
	end
end)

-- Après un achat Robux, Roblox crédite côté serveur : on rafraîchit quand la fenêtre de paiement se ferme
MarketplaceService.PromptProductPurchaseFinished:Connect(function(userId: number, _productId: number, purchased: boolean)
	if userId == player.UserId and purchased and win.Visible then task.wait(1); refresh() end
end)
MarketplaceService.PromptGamePassPurchaseFinished:Connect(function(p: Player, _passId: number, purchased: boolean)
	if p == player and purchased and win.Visible then task.wait(1); refresh() end
end)

-- B / Échap / Retour arrière ferment la boutique (avant le menu) ; à la manette, la sélection arrive sur l'onglet en cours
K.overlay(win, close, function() return tabButtons[currentTab] end)

-- ---------- menu principal (MainMenu) : bouton « BOUTIQUE » du menu ----------
S.panels.shop = function()
	if win.Visible then close(); return end
	fit()
	win.Visible = true; veil.Visible = true
	render()
	-- petite entrée qui rebondit (sur l'échelle d'adaptation à l'écran : un seul UIScale par cadre)
	local target = winScale.Scale
	winScale.Scale = target * 0.92; K.tween(winScale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
	task.spawn(refresh)
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="837">
        <Properties>
          <string name="Name">SoldierController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/SoldierController (LocalScript)
-- Les soldats du jeu web sur Roblox, pour tout le monde (joueurs, bots, soi-même pour la kill-cam) :
--   habillage : soldat réaliste de l'équipe (T orange / CT bleu / chacun-pour-soi teinté) ou tenue de la boutique
--     (SoldierModels), soudé pièce par pièce aux membres R15, qui sont cachés (sur ce client seulement) ;
--   animation : la pose est recalculée à chaque image comme sur le web (SoldierAnim) et appliquée aux Motor6D
--     (Motor6D.Transform, après les animations Roblox) : marche/course selon la vitesse, accroupi, glissade, sprint,
--     saut et réception, visée (regard), recharge, recul, bras qui tiennent l'arme, danses, mort si pas de ragdoll.
-- Notre propre corps reste caché à la première personne (comme sur le web) : seul le viewmodel est visible.
-- Si EditableMesh est refusé, le R15 garde son apparence mais bouge quand même comme le soldat du web.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponInfo = require(ReplicatedStorage.Shared.WeaponInfo)
local S = require(ReplicatedStorage.Shared.ClientState)
local Look = require(ReplicatedStorage.Shared.SoldierLook)
local Anim = require(ReplicatedStorage.Shared.SoldierAnim)
local Models = require(ReplicatedStorage.Shared.SoldierModels)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local K = Look.K
local SPEED_K = 5.2 / 16          -- studs/s -> m/s du web (vitesse de base 16 studs/s = course du web 5,2 m/s)
local GRIP = CFrame.new(0, -0.1, 0) * CFrame.Angles(math.rad(-90), 0, 0)   -- arme dans la main (WeaponService)
local FAR = 400                   -- au-delà : plus d'animation
local animRemote = ReplicatedStorage:WaitForChild("SoldierAnim", 30) :: UnreliableRemoteEvent?
local tracerRemote = ReplicatedStorage:WaitForChild("Tracer", 30) :: RemoteEvent?

type D = {
	char: Model, hum: Humanoid, hrp: BasePart, own: boolean, look: Look.LookInfo, rest: Look.Rest,
	N: { [BasePart]: CFrame }, joints: { Look.Joint }, parts: { [string]: BasePart }, BN: { [string]: CFrame },
	anim: Anim.State, rh: { Weld }, items: { BasePart }, dressed: boolean,
	visYaw: number?, visY: number?, pitch: number, fire: number, lastShot: number, hurt: boolean, hp: number,
	weapon: string?, dieDir: number, dead: boolean, gunShown: boolean?, conns: { RBXScriptConnection }, hideConn: boolean,
}
local active: { [Model]: D } = {}

local function scaled(cf: CFrame): CFrame return CFrame.new(cf.Position * K) * cf.Rotation end
local function hash(s: string): number local h = 7; for i = 1, #s do h = (h * 31 + string.byte(s, i)) % 1000003 end; return h end

-- ---------- mains sur l'arme (repère de l'arme, m) : comme userData.right / left des armes du web ----------
local function hands(key: string?): (Vector3, Vector3?)
	local w = key and Config.WEAPONS[key]
	if not w then return Vector3.new(0, -0.03, 0.012), Vector3.new(0, 0.015, -0.25) end
	if w.melee then return Vector3.new(0, 0, 0.04), nil end
	local inf = WeaponInfo[key :: string]
	local l = inf and inf.left
	if l and (math.abs(l[3]) > 0.01 or math.abs(l[2]) > 0.01) then return Vector3.new(0, -0.03, 0.012), Vector3.new(l[1], l[2], l[3]) end
	return Vector3.new(0, -0.03, 0.012), Vector3.new(-0.012, -0.04, 0.02)        -- pistolet : main gauche sous la droite
end

-- ---------- cacher le R15 ----------
local function hide(d: D, inst: Instance)
	if inst:IsA("BasePart") then
		if inst == d.hrp or table.find(d.items, inst) or inst:FindFirstAncestor("HeldWeapon") or inst.Name == "HeldWeapon" then return end
		inst.Transparency = 1
	elseif inst:IsA("Decal") then
		inst.Transparency = 1
	end
end

local function weld(p0: BasePart, p1: BasePart, c0: CFrame): Weld
	p1.CFrame = p0.CFrame * c0
	local w = Instance.new("Weld"); w.Name = "SoldatWeld"; w.Part0 = p0; w.Part1 = p1; w.C0 = c0; w.Parent = p1
	return w
end

local function dress(d: D)
	local ok, items = pcall(Models.parts, d.look, hash(d.char.Name))     -- légère variation de teinte par soldat
	if not ok then warn("[SoldierController]", items); return end
	if not items or not d.char.Parent or active[d.char] ~= d then return end
	-- sans articulations Motor6D (par ex. « Avatar Joint Upgrade » de Roblox), rien ne peut être soudé :
	-- on garde alors l'avatar R15 visible au lieu d'un soldat invisible
	local found = 0
	for _, it in ipairs(items) do if d.parts[it.seg] then found += 1 end end
	if found < #items / 2 then
		warn("[SoldierController] articulations introuvables sur " .. d.char.Name .. " (" .. found .. "/" .. #items .. ") : avatar R15 gardé")
		return
	end
	local folder = Instance.new("Folder"); folder.Name = "SoldatWeb"
	for _, it in ipairs(items) do
		local part = d.parts[it.seg]
		if part then
			it.part.Parent = folder
			table.insert(d.items, it.part)
			if it.seg == "RightHand" then
				table.insert(d.rh, weld(part, it.part, GRIP * it.offset))   -- C0 complet posé à chaque image (décalage de la main sur l'arme)
			else
				weld(part, it.part, d.N[part]:Inverse() * scaled(d.rest.B[it.seg]) * it.offset)
			end
			it.part:SetAttribute("Offset", it.offset)
		end
	end
	folder.Parent = d.char
	d.dressed = true
	for _, x in ipairs(d.char:GetDescendants()) do hide(d, x) end
	if d.hideConn then return end
	d.hideConn = true
	table.insert(d.conns, d.char.DescendantAdded:Connect(function(x)
		if x:IsA("BasePart") or x:IsA("Decal") then task.defer(hide, d, x) end
	end))
end

local function forget(char: Model)
	local d = active[char]
	if not d then return end
	active[char] = nil
	for _, c in ipairs(d.conns) do c:Disconnect() end
end

local redress: (Model?) -> ()
local function track(char: Model)
	if active[char] then return end
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10) :: Humanoid?
		local hrp = char:WaitForChild("HumanoidRootPart", 10) :: BasePart?
		if not hum or not hrp or not char:WaitForChild("UpperTorso", 10) or not char:WaitForChild("RightHand", 10) or active[char] then return end
		task.wait()                                   -- toutes les articulations sont arrivées
		local look = Look.look(char)
		local N, joints = Look.natural(char, hum, hrp)
		local rest = Look.rest(look.rig)
		local parts, BN = {}, {}
		for p, cf in pairs(N) do
			parts[p.Name] = p
			local B = rest.B[p.Name]
			if B then BN[p.Name] = scaled(B):Inverse() * cf end
		end
		local d: D = {
			char = char, hum = hum, hrp = hrp, own = char == player.Character, look = look, rest = rest,
			N = N, joints = joints, parts = parts, BN = BN, anim = Anim.new(hash(char.Name)), rh = {}, items = {}, dressed = false,
			visYaw = nil, visY = nil, pitch = 0, fire = 0, lastShot = -99, hurt = false, hp = hum.Health,
			weapon = nil, dieDir = math.random(0, 3), dead = false, gunShown = nil, conns = {}, hideConn = false,
		}
		active[char] = d
		table.insert(d.conns, hum.HealthChanged:Connect(function(h)
			if h < d.hp then d.hurt = true end
			d.hp = h
		end))
		if not Players:GetPlayerFromCharacter(char) then table.insert(d.conns, char:GetAttributeChangedSignal("Team"):Connect(function() redress(char) end)) end
		table.insert(d.conns, char.AncestryChanged:Connect(function() if not char:IsDescendantOf(workspace) then forget(char) end end))
		dress(d)
	end)
end

-- refait l'habillage d'un personnage déjà suivi (tenue ou équipe changée)
redress = function(c: Model?)
	if c and active[c] then
		local d = active[c] :: D
		local f = c:FindFirstChild("SoldatWeb"); if f then f:Destroy() end
		d.items = {}; d.rh = {}; d.look = Look.look(c); d.rest = Look.rest(d.look.rig)
		for p2, cf in pairs(d.N) do local B = d.rest.B[p2.Name]; if B then d.BN[p2.Name] = scaled(B):Inverse() * cf end end
		task.spawn(dress, d)
	end
end
-- tenue changée (attribut Outfit) : on refait l'habillage au prochain personnage ; tout de suite si on peut
local function watchPlayer(p: Player)
	p.CharacterAdded:Connect(track)
	if p.Character then track(p.Character) end
	p:GetAttributeChangedSignal("Outfit"):Connect(function() redress(p.Character) end)
	p:GetAttributeChangedSignal("Team"):Connect(function() redress(p.Character) end)   -- Infecté : on change de camp en cours de partie
end
for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
local function watchBots(f: Instance)
	f.ChildAdded:Connect(function(m) if m:IsA("Model") then track(m) end end)
	for _, m in ipairs(f:GetChildren()) do if m:IsA("Model") then track(m) end end
end
local botsFolder = workspace:FindFirstChild("Bots")
if botsFolder then watchBots(botsFolder) end
workspace.ChildAdded:Connect(function(c: Instance) if c.Name == "Bots" and c:IsA("Folder") then watchBots(c) end end)

-- tirs : recul, arme levée ; l'à-coup suit l'arme tenue (fusil à pompe et sniper secouent l'épaule, pistolet sec)
local KICK: { [string]: number } = { sniper = 1.6, shotgun = 1.6, lmg = 1.2, rifle = 1, smg = 0.8, pistol = 0.75 }
local function kickOf(d: D): number
	local key = d.char:GetAttribute("Weapon")
	local w = typeof(key) == "string" and Config.WEAPONS[key]
	return if w then KICK[w.cat] or 1 else 1
end
if tracerRemote then
	(tracerRemote :: RemoteEvent).OnClientEvent:Connect(function(_, _, shooter: Instance?)
		local d = shooter and active[shooter :: Model]
		if d then d.fire = kickOf(d); d.lastShot = os.clock() end
	end)
end
S.onShot:Connect(function()
	if S.kc then return end                  -- tirs du tueur rejoués par la kill-cam : pas le recul de notre corps
	local c = player.Character
	local d = c and active[c]
	if d then d.fire = kickOf(d); d.lastShot = os.clock() end
end)

-- ---------- état envoyé au serveur (les autres voient nos glissades, sprints…) ----------
local lastBits, bitsT = -1, 0
local function myBits(): number
	local b = 0
	if S.slide then b += Anim.SLIDE end
	-- comme anBits du web : la pose de sprint ne s'affiche qu'au-dessus de 80 % de la course
	if S.sprint and S.speed * SPEED_K > 5.2 * 0.8 then b += Anim.SPR; if S.tactical then b += Anim.TAC end end
	if S.mantle then b += Anim.MANT end
	if S.crouch then b += Anim.CROUCH end
	if S.aiming then b += Anim.AIM end
	return b
end

-- ---------- pose ----------
local rayParams = RaycastParams.new(); rayParams.FilterType = Enum.RaycastFilterType.Exclude
local function onGround(d: D): boolean
	if d.own then return d.hum.FloorMaterial ~= Enum.Material.Air end
	local st = d.hum:GetState()
	if st == Enum.HumanoidStateType.Jumping or st == Enum.HumanoidStateType.Freefall then return false end
	rayParams.FilterDescendantsInstances = { d.char }
	local h = d.hum.HipHeight + d.hrp.Size.Y / 2 + 1.2
	return workspace:Raycast(d.hrp.Position, Vector3.new(0, -h, 0), rayParams) ~= nil
end

local function angDiff(a: number, b: number): number local x = (b - a) % (2 * math.pi); if x > math.pi then x -= 2 * math.pi end; return x end

local function setGun(d: D, on: boolean)
	if d.own or d.gunShown == on then return end
	d.gunShown = on
	local held = d.char:FindFirstChild("HeldWeapon")
	if not held then return end
	for _, x in ipairs(held:GetDescendants()) do if x:IsA("BasePart") then x.LocalTransparencyModifier = if on then 0 else 1 end end
end

local function update(d: D, dt: number, t: number)
	local char, hum, hrp = d.char, d.hum, d.hrp
	local alive = hum.Health > 0
	if not alive and not d.dead then
		d.dead = true
		-- la main droite procédurale suit l'avant-bras pendant le ragdoll ; l'arme tombe des mains (comme le web)
		local la = d.parts.RightLowerArm
		for _, w in ipairs(d.rh) do
			local p1 = w.Part1
			if p1 and la then local c0 = la.CFrame:Inverse() * p1.CFrame; w.Part0 = la; w.C0 = c0 end
		end
		d.rh = {}
		setGun(d, false)
	end
	if char:GetAttribute("Ragdoll") then return end            -- articulations remplacées par le serveur
	local look = hrp.CFrame.LookVector
	local yaw = math.atan2(-look.X, -look.Z)
	local v = hrp.AssemblyLinearVelocity
	local flat = Vector3.new(v.X, 0, v.Z)
	local grounded = onGround(d)
	local bits = if d.own then myBits() else (char:GetAttribute("Anim") :: number? or 0)
	-- bots qui foncent (au-delà de la course) : pose de sprint, comme sur le web (pas les zombies)
	if not d.own and not Players:GetPlayerFromCharacter(char) and not char:GetAttribute("Zombie")
		and bit32.band(bits, Anim.SPR) == 0 and flat.Magnitude * SPEED_K > 5.2 * 1.05 then bits += Anim.SPR end
	-- regard : caméra pour soi, attribut Pitch (≈10 fois par seconde) lissé pour les autres
	local pitch = if d.own then math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1)) else (char:GetAttribute("Pitch") :: number? or 0)
	d.pitch += (pitch - d.pitch) * math.min(1, dt * 12)
	-- arme et recharge
	local key = char:GetAttribute("Weapon") :: string?
	if key ~= d.weapon then
		if d.weapon ~= nil then d.anim.swT = 0.35 end
		d.weapon = key; d.gunShown = nil
	end
	local right, left = hands(key)
	local reload, reloadMax = 0, 0
	local w = key and Config.WEAPONS[key]
	if w and w.reload > 0 then
		if d.own then
			-- durée réelle (accessoires, atouts) envoyée par le serveur, comme le viewmodel
			local dur = if S.reloadDur > 0 then S.reloadDur else w.reload
			if S.reloading then reloadMax = dur; reload = math.max(0, dur - (os.clock() - S.reloadStart)) end
		else
			local r0 = char:GetAttribute("ReloadT")
			if typeof(r0) == "number" then reloadMax = w.reload; reload = math.max(0, w.reload - (workspace:GetServerTimeNow() - r0)) end
		end
	end
	-- danse (attribut Dance posé par le serveur) : s'arrête si on bouge ou à la fin
	local dance: string? = nil
	local danceT = 0
	local dn, d0 = char:GetAttribute("Dance"), char:GetAttribute("DanceT")
	if typeof(dn) == "string" and typeof(d0) == "number" and Config.DANCES[dn] then
		danceT = workspace:GetServerTimeNow() - d0
		if danceT < Config.DANCES[dn].length and not (danceT > 0.45 and flat.Magnitude * SPEED_K > 1) then dance = dn end
	end
	local ready = bit32.band(bits, Anim.AIM) ~= 0 or os.clock() - d.lastShot < 2.5 or (d.own and alive)
	local st: Anim.Input = {
		speed = flat.Magnitude * SPEED_K, lf = v:Dot(look) * SPEED_K, lr = v:Dot(hrp.CFrame.RightVector) * SPEED_K,
		yaw = yaw, pitch = d.pitch, onGround = grounded, vy = v.Y / Config.STUDS_PER_METER,
		crouch = bit32.band(bits, Anim.CROUCH) ~= 0, bits = bits, alive = alive, ready = ready,
		alert = if os.clock() - d.lastShot < 3 then 1 else 0, hurt = d.hurt, fire = d.fire,
		reload = reload, reloadMax = reloadMax, dance = dance, danceT = danceT, seated = if hum.Sit then 1 else 0,
		dieDir = d.dieDir, right = right, left = left,
	}
	d.hurt = false; d.fire = 0
	local pose = Anim.step(d.anim, st, dt, t)
	setGun(d, pose.gunVisible and alive)
	-- rotation et hauteur lissées (pas de demi-tour sec des bots, marches d'escalier adoucies), comme syncRigs du web
	local yOff, yawOff = 0, 0
	if not d.own then
		if d.visYaw == nil or not alive then d.visYaw = yaw else d.visYaw = (d.visYaw :: number) + angDiff(d.visYaw :: number, yaw) * (1 - math.exp(-dt * 16)) end
		yawOff = angDiff(yaw, d.visYaw :: number)
		local y = hrp.Position.Y
		if d.visY == nil or not grounded or math.abs(y - (d.visY :: number)) > 1.2 * K then d.visY = y
		else d.visY = (d.visY :: number) + (y - (d.visY :: number)) * (1 - math.exp(-dt * 16)) end
		yOff = ((d.visY :: number) - y) / K
	end
	local root = CFrame.new(0, yOff, 0) * CFrame.Angles(0, yawOff, 0) * pose.root
	-- repères des os (m, repère du soldat)
	local F: { [string]: CFrame } = {}
	local spine = pose.spine
	local A = pose.arm
	if d.look.rig == "real" then
		local R = Look.Rig.real
		local b = R.bones
		local Dp = pose.hips.Rotation
		local Pp = pose.hips.Position + R.pelOff
		F.LowerTorso = CFrame.new(Pp) * Dp
		local Ds = spine.Rotation
		local Ps = Pp + Dp * (b.spine - b.pelvis)
		F.UpperTorso = CFrame.new(Ps) * Ds
		local Pn = Ps + Ds * (b.neck - b.spine)
		local Ph = Pn + pose.neck.Rotation * (b.head - b.neck)
		F.Head = CFrame.new(Ph) * pose.head.Rotation
		for _, k in ipairs({ "L", "R" }) do
			local s: string = if k == "L" then "Left" else "Right"
			local Pt = Pp + Dp * (b["thigh" .. k] - b.pelvis)
			local Dt = pose.th[k].Rotation
			local Pc = Pt + Dt * (b["calf" .. k] - b["thigh" .. k])
			local Dc = pose.sh[k].Rotation
			local Pf = Pc + Dc * (b["foot" .. k] - b["calf" .. k])
			F[s .. "UpperLeg"] = CFrame.new(Pt) * Dt; F[s .. "LowerLeg"] = CFrame.new(Pc) * Dc; F[s .. "Foot"] = CFrame.new(Pf) * pose.ft[k].Rotation
			-- bras : IK sur les vraies longueurs du modèle, main sur la cible de la main procédurale (syncRealBody du web)
			local arm, a = R.arm[k], A[k]
			local Su = Ps + Ds * (b["uarm" .. k] - b.spine)
			local Ht = spine * a.H
			local El, Hc = Anim.ik2(Su, Ht, arm.la, arm.lb, Ds * a.pole)
			local Du = Anim.fromTo(arm.dU, (El - Su).Unit)          -- écart à la pose de repos (bras en croix)
			local Pf2 = Su + Du * (b["farm" .. k] - b["uarm" .. k])
			local dF = Hc - Pf2
			local Dfa = Anim.fromTo(arm.dF, if dF.Magnitude > 1e-5 then dF.Unit else Vector3.new(0, -1, 0))
			F[s .. "UpperArm"] = CFrame.new(Su) * Du; F[s .. "LowerArm"] = CFrame.new(Pf2) * Dfa
			F[s .. "Hand"] = CFrame.new(Pf2 + Dfa * (b["hand" .. k] - b["farm" .. k])) * Dfa
		end
	else
		F.LowerTorso = pose.hips; F.UpperTorso = spine; F.Head = pose.head
		for _, k in ipairs({ "L", "R" }) do
			local s: string = if k == "L" then "Left" else "Right"
			F[s .. "UpperLeg"] = pose.th[k]; F[s .. "LowerLeg"] = pose.sh[k]; F[s .. "Foot"] = pose.ft[k]
			local a = A[k]
			local du, df = a.E - a.S, a.H - a.E
			F[s .. "UpperArm"] = spine * CFrame.new(a.S) * Anim.fromTo(Vector3.new(0, -1, 0), if du.Magnitude > 1e-5 then du.Unit else Vector3.new(0, -1, 0))
			F[s .. "LowerArm"] = spine * CFrame.new(a.E) * Anim.fromTo(Vector3.new(0, -1, 0), if df.Magnitude > 1e-5 then df.Unit else Vector3.new(0, -1, 0))
			F[s .. "Hand"] = spine * CFrame.new(a.H) * a.q
		end
	end
	-- cibles des pièces R15 (studs, repère du soldat) ; main droite : l'arme soudée tombe sur le porte-arme du web
	local T: { [BasePart]: CFrame } = { [hrp] = Look.rootOffset(hum, hrp) }
	for name, f in pairs(F) do
		local p = d.parts[name]
		if p and name ~= "RightHand" and d.BN[name] then T[p] = scaled(root * f) * d.BN[name] end
	end
	local rhp = d.parts.RightHand
	if rhp then
		local a = A.R
		local hand = scaled(root * spine * CFrame.new(a.H) * a.q)
		local off = CFrame.new(-right * K)
		T[rhp] = hand * off * GRIP:Inverse()
		for _, wld in ipairs(d.rh) do
			local p1 = wld.Part1
			local o = p1 and p1:GetAttribute("Offset")
			wld.C0 = GRIP * off:Inverse() * (if typeof(o) == "CFrame" then o else CFrame.identity)
		end
	end
	for _, j in ipairs(d.joints) do
		local m = j.m
		if m.Parent then
			local t0 = T[j.p0]
			local t1 = T[j.p1]
			if t0 and not t1 then t1 = t0 * d.N[j.p0]:Inverse() * d.N[j.p1]; T[j.p1] = t1 end
			if t0 and t1 then m.Transform = Look.jointC0(m):Inverse() * t0:Inverse() * t1 * Look.jointC1(m) end
		end
	end
end

local clock = 0
local function step(dt: number)
	clock += dt
	local camPos = camera.CFrame.Position
	for char, d in pairs(active) do
		if not char.Parent or not d.hrp.Parent then forget(char)
		elseif (d.hrp.Position - camPos).Magnitude < FAR or d.own then
			local ok, err = pcall(function() update(d, math.min(dt, 0.1), clock); return true end)
			if not ok then warn("[SoldierController]", err); forget(char) end
		end
	end
	-- notre état d'animation pour les autres (à chaque changement, et une fois par seconde)
	bitsT += dt
	local b = myBits()
	if animRemote and (b ~= lastBits or bitsT > 1) then lastBits = b; bitsT = 0; (animRemote :: UnreliableRemoteEvent):FireServer(b) end
end
-- PreSimulation (= Stepped) : après les animations Roblox, avant la physique ; Motor6D.Transform l'emporte
local ok = pcall(function() RunService.PreSimulation:Connect(step) end)
if not ok then RunService.Stepped:Connect(function(_, dt) step(dt) end) end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="838">
        <Properties>
          <string name="Name">SpectateController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/SpectateController (LocalScript)
-- Spectateur après la mort, comme dans CS et Valorant : une fois la kill-cam finie, si on attend encore sa
-- réapparition (Recherche et destruction, manches, Élimination…), la caméra suit un coéquipier en vie.
-- Clic gauche / droit (ou flèches, gâchettes de la manette) : coéquipier suivant / précédent.
-- On ne regarde jamais un adversaire : la liste ne contient que des soldats de son équipe dans sa partie.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local S = require(ReplicatedStorage.Shared.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local DELAY = 2.5          -- secondes après la mort (et après la kill-cam) avant de passer en spectateur

local gui = Instance.new("ScreenGui"); gui.Name = "Spectate"; gui.ResetOnSpawn = false; gui.DisplayOrder = 8
gui.IgnoreGuiInset = true; gui.Enabled = false; gui.Parent = player:WaitForChild("PlayerGui")
local bar = Instance.new("TextLabel")
bar.AnchorPoint = Vector2.new(0.5, 1); bar.Position = UDim2.new(0.5, 0, 1, -150); bar.Size = UDim2.fromOffset(520, 44)
bar.BackgroundColor3 = Color3.fromRGB(14, 19, 30); bar.BackgroundTransparency = 0.25; bar.BorderSizePixel = 0; bar.RichText = true
bar.FontFace = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold); bar.TextSize = 16
bar.TextColor3 = Color3.fromRGB(232, 238, 249); bar.Text = ""; bar.Parent = gui
local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 4); corner.Parent = bar

local watching: Model? = nil
local deadSince: number? = nil

local function myHumanoid(): Humanoid?
	return player.Character and player.Character:FindFirstChildOfClass("Humanoid")
end
local function alive(m: Model): boolean
	local h = m:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0 and m:FindFirstChild("HumanoidRootPart") ~= nil
end

-- coéquipiers en vie de la même partie (joueurs puis bots), dans un ordre stable
local function mates(): { Model }
	local id, team = player:GetAttribute("MatchId"), player:GetAttribute("Team")
	local list = {}
	if typeof(id) ~= "number" or typeof(team) ~= "string" or string.sub(team, 1, 5) == "solo:" then return list end
	for _, p in ipairs(Players:GetPlayers()) do
		if p ~= player and p:GetAttribute("MatchId") == id and p:GetAttribute("Team") == team and p.Character and alive(p.Character) then
			table.insert(list, p.Character)
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, b in ipairs(bots:GetChildren()) do
			if b:IsA("Model") and b:GetAttribute("MatchId") == id and b:GetAttribute("Team") == team and alive(b) then table.insert(list, b) end
		end
	end
	return list
end

local function nameOf(m: Model): string
	local p = Players:GetPlayerFromCharacter(m)
	return if p then p.DisplayName else "[BOT] " .. m.Name
end

local function watch(m: Model?)
	watching = m
	S.spectate = m                        -- HudController : l'écran de mort s'efface
	if m then
		-- caméra libre placée derrière l'épaule (en vue FPS verrouillée, suivre un autre Humanoid mettrait l'œil dans sa tête)
		camera.CameraType = Enum.CameraType.Scriptable
		local n = #mates()
		bar.Text = 'SPECTATEUR  <font color="#ffd75e">' .. nameOf(m) .. "</font>"
			.. (if n > 1 then '   <font color="#8da0bd" size="13">clic : changer (' .. n .. ")</font>" else "")
		gui.Enabled = true
	else
		gui.Enabled = false
		if camera.CameraType == Enum.CameraType.Scriptable and S.kc == nil then camera.CameraType = Enum.CameraType.Custom end
		local h = myHumanoid()
		if h then camera.CameraSubject = h end
	end
end

local function step(dir: number)
	local list = mates()
	-- personne à suivre : on ne rend la caméra qu'une fois (sinon on la reposait à chaque image)
	if #list == 0 then if watching then watch(nil) end; return end
	local i = (watching and table.find(list, watching)) or 0
	watch(list[(i - 1 + dir) % #list + 1])
end

RunService.Heartbeat:Connect(function()
	local h = myHumanoid()
	local dead = typeof(player:GetAttribute("MatchId")) == "number" and (not h or h.Health <= 0)
	if not dead then
		deadSince = nil
		if watching then watch(nil) end
		return
	end
	if S.kc ~= nil then deadSince = os.clock(); if watching then watch(nil) end; return end   -- la kill-cam a la caméra
	deadSince = deadSince or os.clock()
	if os.clock() - (deadSince :: number) < DELAY then return end
	if not watching or not watching.Parent or not alive(watching) then step(1) end
end)

-- au-dessus de l'épaule droite, dans la direction où regarde le coéquipier (attribut Pitch des soldats pour la hauteur)
RunService:BindToRenderStep("Spectate", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
	local m = watching
	if not m then return end
	local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local pitch = m:GetAttribute("Pitch")
	local p = Players:GetPlayerFromCharacter(m)
	if typeof(pitch) ~= "number" and p then pitch = p:GetAttribute("Pitch") end
	local look = (root.CFrame * CFrame.Angles(math.clamp(if typeof(pitch) == "number" then pitch else 0, -1.2, 1.2), 0, 0)).LookVector
	local eye = root.Position + Vector3.new(0, 2.4, 0)
	local want = CFrame.lookAt(eye - look * 9 + root.CFrame.RightVector * 2.2 + Vector3.new(0, 1.2, 0), eye + look * 30)
	camera.CFrame = camera.CFrame:Lerp(want, math.min(1, dt * 10))
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or not watching then return end
	local t, k = input.UserInputType, input.KeyCode
	if t == Enum.UserInputType.MouseButton1 or k == Enum.KeyCode.Right or k == Enum.KeyCode.ButtonR1 then step(1)
	elseif t == Enum.UserInputType.MouseButton2 or k == Enum.KeyCode.Left or k == Enum.KeyCode.ButtonL1 then step(-1) end
end)
player.CharacterAdded:Connect(function() deadSince = nil; if watching then watch(nil) end end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="839">
        <Properties>
          <string name="Name">SprayController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/SprayController (LocalScript)
-- Touche J : spray sur le mur visé (src/64_extras.js). Le serveur (SprayService) vérifie la distance, le mur et le délai,
-- puis pose le spray pour tout le monde. Choix du spray : RemoteFunction SetSpray (menu Style, port du menu).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")

local G = require(ReplicatedStorage.Shared.Grenades)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local sprayEv = ReplicatedStorage:WaitForChild("Spray") :: RemoteEvent
local toast = ReplicatedStorage:WaitForChild("SprayToast") :: RemoteEvent

local gui = Instance.new("ScreenGui"); gui.Name = "SprayToast"; gui.ResetOnSpawn = false; gui.DisplayOrder = 11; gui.Parent = player:WaitForChild("PlayerGui")
local label = Instance.new("TextLabel")
label.AnchorPoint = Vector2.new(0.5, 0); label.Position = UDim2.new(0.5, 0, 0.62, 0); label.Size = UDim2.fromOffset(300, 24)
label.BackgroundTransparency = 1; label.Font = Enum.Font.GothamBold; label.TextSize = 15; label.TextColor3 = Color3.new(1, 1, 1)
label.TextStrokeTransparency = 0.4; label.Text = ""; label.Parent = gui
local stamp = 0
toast.OnClientEvent:Connect(function(txt: string)
	label.Text = txt
	stamp += 1
	local mine = stamp
	task.delay(1.6, function() if stamp == mine then label.Text = "" end end)
end)

local lastAsk = 0
UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed or input.KeyCode ~= Enum.KeyCode.J then return end
	if player:GetAttribute("UiOpen") == true or os.clock() - lastAsk < 0.3 then return end
	lastAsk = os.clock()
	sprayEv:FireServer(camera.CFrame.LookVector)
end)

sprayEv.OnClientEvent:Connect(function(_who: Player, at: Vector3)
	pcall(function() Sfx.play(G.SFX.smoke, at, 0.25) end)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="840">
        <Properties>
          <string name="Name">ViewmodelController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ViewmodelController (LocalScript)
-- Bras + arme en vue à la première personne, repris du jeu web (src/55_vm.js, 55c_inspect.js) :
-- position hanche → visée, balancement de marche en « 8 », respiration, traînée de la souris, inclinaison en pas
-- de côté, atterrissage, recul sur ressort, sortie d'arme, sprint / sprint tactique / glissade / escalade,
-- recharge en phases (bascule, chargeur dehors qui tombe, chargeur neuf, claque, armement à vide),
-- inspection (touche V), coup de couteau, éclair de bouche, douilles, lunette des fusils de précision.
-- Aussi : sortie d'arme amortie avec figure des skins Épiques et plus (55c_inspect.js), main droite qui arme la culasse
-- à vide, chargeur vide qui tombe dans la vue, crosse masquée en visée, et la caméra du web (90_main.js placeCamera) :
-- balancement de tête, roulis en pas de côté et en glissade, plongeon à l'atterrissage, champ élargi en sprint.
-- Façon Call of Duty en plus : escalade avec la main gauche (ou les deux mains sur un rebord haut) posée sur le rebord,
-- arme baissée et caméra qui plonge vers l'avant ; recharge tactique (chargeur encore entamé rangé par la main gauche)
-- ou à vide (chargeur lâché qui tombe, puis armement) ; bras gauche qui balance en sprint tactique ; arme qui vibre en
-- glissade. Le balancement de tête et le plongeon d'atterrissage suivent le réglage « Secousses de l'écran ».
-- Les distances sont en mètres comme sur le web (1 m = 1 stud ici : tout est relatif à la caméra).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Debris = game:GetService("Debris")
local HttpService = game:GetService("HttpService")

local Config = require(ReplicatedStorage.Shared.Config)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local S = require(ReplicatedStorage.Shared.ClientState)
local A = require(ReplicatedStorage.Shared.Attachments)
local ReticleGui = require(ReplicatedStorage.Shared.ReticleGui)
local ShotFx = require(ReplicatedStorage.Shared.ShotFx)          -- douilles éjectées (effets de tir du web)
local HandModels = require(ReplicatedStorage.Shared.HandModels)  -- gants modelés et manches exportés du web

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local VM_SCALE = 1.12                                   -- le web agrandit les modèles 3D de 12 % en vue subjective
local FOV_K = math.tan(math.rad(35)) / math.tan(math.rad(30))   -- le web dessine l'arme à 60° de champ, Roblox est à 70°
local STUDS_PER_M = Config.STUDS_PER_METER
local NO_MAG_SHOW = { p90 = true, m249 = true }         -- trop gros pour être montrés en inspection (comme sur le web)
-- temps de visée selon la famille d'arme (façon Call of Duty : pistolet vif, mitrailleuse et précision lourds)
local ADS_CAT: { [string]: number } = { pistol = 0.8, smg = 0.88, rifle = 1, shotgun = 1.05, sniper = 1.25, lmg = 1.32 }

local function clamp(x: number, a: number, b: number): number return math.max(a, math.min(b, x)) end
local function lerp(a: number, b: number, t: number): number return a + (b - a) * t end
local function smooth01(x: number): number x = clamp(x, 0, 1); return x * x * (3 - 2 * x) end

local Sfx = require(ReplicatedStorage.Shared.Sfx)
local function sfx(name: string, vol: number?) Sfx.play(name, nil, vol) end

-- réglage d'accessibilité « Secousses de l'écran » (attribut Access, AccessibilityController) : 0 = tête immobile
local shakeK = 1
local function readShake()
	shakeK = 1
	local raw = player:GetAttribute("Access")
	if typeof(raw) ~= "string" then return end
	local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
	if ok and typeof(data) == "table" and typeof(data.shake) == "number" then shakeK = clamp(data.shake, 0, 1) end
end
player:GetAttributeChangedSignal("Access"):Connect(readShake)
readShake()

-- ---------- rig : dossier sous la caméra ----------
local rig = Instance.new("Folder"); rig.Name = "Viewmodel"; rig.Parent = camera

local function part(name: string, size: Vector3, color: Color3, mat: Enum.Material?): Part
	local p = Instance.new("Part"); p.Name = name; p.Size = size; p.Color = color; p.Material = mat or Enum.Material.SmoothPlastic
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false; p.Parent = rig
	return p
end

local GLOVE = Color3.fromRGB(34, 36, 40)
-- manches : diamètres des cônes du web (SG.uarm / SG.farm, ×1,15 dans place()) ; poignet : bande de manche (cR / cL)
local ARM_U, ARM_F, CUFF_D, CUFF_L = 0.132, 0.112, 0.118, 0.054
local arms = {
	uR = part("UpperR", Vector3.new(0.34, ARM_U, ARM_U), Color3.new()), fR = part("ForeR", Vector3.new(0.3, ARM_F, ARM_F), Color3.new()),
	uL = part("UpperL", Vector3.new(0.34, ARM_U, ARM_U), Color3.new()), fL = part("ForeL", Vector3.new(0.3, ARM_F, ARM_F), Color3.new()),
	cR = part("CuffR", Vector3.new(CUFF_L, CUFF_D, CUFF_D), Color3.fromRGB(45, 48, 40)), cL = part("CuffL", Vector3.new(CUFF_L, CUFF_D, CUFF_D), Color3.fromRGB(45, 48, 40)),
	hR = part("HandR", Vector3.new(0.075, 0.09, 0.11), GLOVE), hL = part("HandL", Vector3.new(0.075, 0.09, 0.11), GLOVE),
}
-- vrais cylindres (axe X) : un SpecialMesh « Cylinder » s'affiche en pavé sur Roblox (manches et poignets en blocs)
for _, k in ipairs({ "uR", "fR", "uL", "fL", "cR", "cL" }) do arms[k].Shape = Enum.PartType.Cylinder end
-- hR / hL : simples repères invisibles, les gants modelés (ci-dessous) s'y accrochent
arms.hR.Transparency = 1; arms.hL.Transparency = 1
for _, k in ipairs({ "uR", "fR", "uL", "fL" }) do arms[k].Material = Enum.Material.Fabric end
arms.cR.Material = Enum.Material.Fabric; arms.cL.Material = Enum.Material.Fabric

-- ---------- gants tactiques modelés (src/55b_hands.js) ----------
-- paume arrondie, quatre doigts en trois phalanges enroulés autour de la poignée, pouce opposé,
-- coque des jointures, sangle de poignet ; la main gauche est le reflet de la droite.
-- mirrored : maillage déjà reflété (gants exportés du web, HandModels), sinon pièce symétrique de la main droite
type GPiece = { p: BasePart, at: CFrame, mat: string, mirrored: boolean? }
local function newGlove(): { GPiece }
	local list: { GPiece } = {}
	local function add(p: BasePart, at: CFrame, mat: string)
		p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false; p.Massless = true
		p.Material = if mat == "pad" then Enum.Material.SmoothPlastic else Enum.Material.Fabric
		p.Parent = rig
		table.insert(list, { p = p, at = at, mat = mat })
	end
	-- pavé arrondi « gonflé » (puffGeo du web) : rayon r = round × plus petite demi-taille ; sans maillage, il est
	-- refait en pièces simples (somme d'un pavé et d'une boule) : 3 pavés + 12 cylindres d'arêtes + 8 boules de coins,
	-- les pièces de longueur nulle (axe entièrement arrondi) sont sautées. Plus de coins vifs « en blocs ».
	local function puff(size: Vector3, pos: Vector3, ry: number, round: number, mat: string)
		local h = size / 2
		local r = math.min(h.X, h.Y, h.Z) * round
		local function inner(x: number): number return if x - r < 0.0008 then 0 else x - r end
		local i = Vector3.new(inner(h.X), inner(h.Y), inner(h.Z))
		local at = CFrame.new(pos) * CFrame.Angles(0, ry, 0)
		local function piece(p: BasePart, cf: CFrame) p.Name = "Gant"; add(p, at * cf, mat) end
		local function signs(x: number): { number } return if x > 0 then { -x, x } else { 0 } end
		-- cœur : un pavé par axe, gonflé de r sur cet axe
		for _, s in ipairs({ Vector3.new(h.X, i.Y, i.Z), Vector3.new(i.X, h.Y, i.Z), Vector3.new(i.X, i.Y, h.Z) }) do
			if s.X > 1e-4 and s.Y > 1e-4 and s.Z > 1e-4 then
				local p = Instance.new("Part"); p.Size = s * 2; piece(p, CFrame.identity)
			end
		end
		-- arêtes : cylindres de rayon r (axe X du cylindre tourné sur l'axe de l'arête)
		local function edge(len: number, rot: CFrame, offs: { Vector3 })
			if len <= 1e-4 then return end
			for _, o in ipairs(offs) do
				local c = Instance.new("Part"); c.Shape = Enum.PartType.Cylinder; c.Size = Vector3.new(len, r * 2, r * 2)
				piece(c, CFrame.new(o) * rot)
			end
		end
		local ex, ey, ez = {}, {}, {}
		for _, a in ipairs(signs(i.Y)) do for _, b in ipairs(signs(i.Z)) do table.insert(ex, Vector3.new(0, a, b)) end end
		for _, a in ipairs(signs(i.X)) do for _, b in ipairs(signs(i.Z)) do table.insert(ey, Vector3.new(a, 0, b)) end end
		for _, a in ipairs(signs(i.X)) do for _, b in ipairs(signs(i.Y)) do table.insert(ez, Vector3.new(a, b, 0)) end end
		edge(i.X * 2, CFrame.identity, ex)
		edge(i.Y * 2, CFrame.Angles(0, 0, math.pi / 2), ey)
		edge(i.Z * 2, CFrame.Angles(0, math.pi / 2, 0), ez)
		-- coins
		for _, x in ipairs(signs(i.X)) do for _, y in ipairs(signs(i.Y)) do for _, z in ipairs(signs(i.Z)) do
			local b = Instance.new("Part"); b.Shape = Enum.PartType.Ball; b.Size = Vector3.one * (r * 2)
			piece(b, CFrame.new(x, y, z))
		end end end
	end
	-- capsule (cylindre + deux demi-sphères) de longueur totale L, axe = up
	local function caps(center: Vector3, up: Vector3, r: number, L: number, mat: string)
		-- axe X du cylindre le long de up
		local side = up:Cross(if math.abs(up.Z) < 0.9 then Vector3.zAxis else Vector3.xAxis).Unit
		local axis = CFrame.fromMatrix(Vector3.zero, up, side)
		local h = math.max(0, L / 2 - r)
		if h > 1e-4 then
			local c = Instance.new("Part"); c.Name = "Gant"; c.Shape = Enum.PartType.Cylinder; c.Size = Vector3.new(h * 2, r * 2, r * 2)
			add(c, CFrame.new(center) * axis, mat)
		end
		for _, sgn in ipairs({ -1, 1 }) do
			local b = Instance.new("Part"); b.Name = "Gant"; b.Shape = Enum.PartType.Ball; b.Size = Vector3.new(r * 2, r * 2, r * 2)
			add(b, CFrame.new(center + up * (h * sgn)), mat)
		end
	end
	local function seg(a: Vector3, b: Vector3, r: number, mat: string)
		local d = b - a
		caps((a + b) / 2, d.Unit, r, d.Magnitude + r * 1.6, mat)
	end
	local R, D = 0.026, math.pi / 180
	local function P(phi: number, y: number, rr: number?): Vector3
		local k = rr or R
		return Vector3.new(math.cos(phi) * k, y, math.sin(phi) * k)
	end
	puff(Vector3.new(0.028, 0.084, 0.07), Vector3.new(0.03, -0.036, 0.018), -0.62, 1, "fab")      -- paume + dos
	puff(Vector3.new(0.012, 0.07, 0.026), Vector3.new(0.046, -0.034, -0.006), -0.35, 0.9, "pad")  -- coque des jointures
	puff(Vector3.new(0.03, 0.05, 0.02), Vector3.new(0.03, -0.03, 0.05), -0.9, 0.6, "strap")       -- sangle du poignet
	local F = {
		{ y = -0.008, L = { 0.042, 0.026, 0.021 }, r = 0.0088 }, { y = -0.027, L = { 0.046, 0.029, 0.022 }, r = 0.0092 },
		{ y = -0.046, L = { 0.043, 0.027, 0.021 }, r = 0.0088 }, { y = -0.063, L = { 0.034, 0.021, 0.018 }, r = 0.0076 },
	}
	for _, f in ipairs(F) do
		local phi = -14 * D
		local a = P(phi, f.y)
		caps(a, Vector3.yAxis, f.r * 1.12, f.r * 2.4, "fab")                                -- jointure
		for i, L in ipairs(f.L) do
			local i0 = i - 1
			phi += -L / R * (if i0 > 0 then 1.05 else 0.95)
			local b = P(phi, f.y - 0.002 * i0, R - 0.002 * i0)
			seg(a, b, f.r * (1 - i0 * 0.1), if i0 == 2 then "palm" else "fab")
			a = b
		end
	end
	do  -- pouce
		local a = Vector3.new(0.03, -0.03, 0.042)
		local pts = { P(118 * D, -0.004, 0.03), P(168 * D, 0.004, 0.028), P(205 * D, 0.008, 0.026) }
		local rr = { 0.0125, 0.0105, 0.0095 }
		for i, b in ipairs(pts) do seg(a, b, rr[i], "fab"); a = b end
	end
	return list
end
local WRIST = Vector3.new(0.032, -0.032, 0.07)        -- le bras s'arrête au poignet du gant
local gloveR, gloveL = newGlove(), newGlove()
-- reflet en x (main gauche) : position (-x, y, z), rotation S·R·S
local function mirror(c: CFrame): CFrame
	local x, y, z, r00, r01, r02, r10, r11, r12, r20, r21, r22 = c:GetComponents()
	return CFrame.new(-x, y, z, r00, -r01, -r02, -r10, r11, r12, -r20, r21, r22)
end
local LEFT_FLAT = CFrame.new(0, -0.006, 0) * CFrame.Angles(math.pi / 2, 0, 0)   -- main gauche à plat sous le garde-main
local LEFT_VERT = CFrame.Angles(0, 0.7, 0)                                        -- main gauche autour d'une poignée verticale
local leftAt: { CFrame } = {}
local leftVert: boolean? = nil
local function setLeftHold(vert: boolean)
	if leftVert == vert then return end
	leftVert = vert
	local inner = if vert then LEFT_VERT else LEFT_FLAT
	for i, g in ipairs(gloveL) do leftAt[i] = if g.mirrored then mirror(inner) * g.at else mirror(inner * g.at) end
end
setLeftHold(false)
local function leftWrist(): Vector3
	local w = (if leftVert then LEFT_VERT else LEFT_FLAT) * WRIST
	return Vector3.new(-w.X, w.Y, w.Z)
end
local gloveLook = ""
local function setGloveColor(glove: Color3)
	local key = glove:ToHex()
	if key == gloveLook then return end
	gloveLook = key
	local col = {
		fab = glove:Lerp(Color3.new(1, 1, 1), 0.08), palm = Color3.new(glove.R * 0.75, glove.G * 0.75, glove.B * 0.75),
		pad = Color3.new(0.025, 0.027, 0.03), strap = Color3.new(glove.R * 0.6, glove.G * 0.6, glove.B * 0.6),
	}
	for _, list in ipairs({ gloveR, gloveL }) do
		for _, g in ipairs(list) do g.p.Color = (col :: any)[g.mat] end
	end
end
local gParts: { BasePart } = {}
for _, g in ipairs(gloveR) do table.insert(gParts, g.p) end
for _, g in ipairs(gloveL) do table.insert(gParts, g.p) end
local gCFs: { CFrame } = table.create(#gParts)
local function placeGloves(rootR: CFrame, rootL: CFrame?, hiddenCF: CFrame)
	local n = 0
	for _, g in ipairs(gloveR) do n += 1; gCFs[n] = rootR * g.at end
	for i in ipairs(gloveL) do n += 1; gCFs[n] = if rootL then rootL * leftAt[i] else hiddenCF end
	workspace:BulkMoveTo(gParts, gCFs, Enum.BulkMoveMode.FireCFrameChanged)
end
-- gants et manches exportés du web (HandModels) : dès que MeshUploader les a envoyés, ils remplacent les ~200 pièces
-- arrondies ci-dessus par 8 maillages (4 matières × 2 mains) et les manches cylindriques par les cônes du soldat
local MANCHE_U, MANCHE_F = 0.063 * 2 * 1.15, 0.054 * 2 * 1.15   -- diamètre en haut des cônes (×1,15 de place() du web)
local sleeveMesh = false
task.spawn(function()
	local b = HandModels.build()
	if not b then return end
	for _, g in ipairs(gloveR) do g.p:Destroy() end
	for _, g in ipairs(gloveL) do g.p:Destroy() end
	table.clear(gloveR); table.clear(gloveL); table.clear(gParts); table.clear(gCFs)
	for _, g in ipairs(b.R) do g.p.Parent = rig; table.insert(gloveR, { p = g.p :: BasePart, at = g.at, mat = g.mat, mirrored = nil } :: GPiece) end
	for _, g in ipairs(b.L) do g.p.Parent = rig; table.insert(gloveL, { p = g.p :: BasePart, at = g.at, mat = g.mat, mirrored = true } :: GPiece) end
	for _, g in ipairs(gloveR) do table.insert(gParts, g.p) end
	for _, g in ipairs(gloveL) do table.insert(gParts, g.p) end
	local was = leftVert
	leftVert = nil; setLeftHold(was == true)
	gloveLook = ""
	if b.u and b.f then
		local A = arms :: any
		for _, k in ipairs({ "uR", "uL", "fR", "fL" }) do
			local src = if string.sub(k, 1, 1) == "u" then b.u else b.f
			local mp = (src :: MeshPart):Clone()
			mp.Name = A[k].Name; mp.Color = A[k].Color; mp.CFrame = A[k].CFrame; mp.Parent = rig
			A[k]:Destroy(); A[k] = mp
		end
		b.u:Destroy(); b.f:Destroy()
		sleeveMesh = true
	end
end)
local flash = part("Flash", Vector3.new(0.12, 0.12, 0.12), Color3.fromRGB(255, 214, 140), Enum.Material.Neon)
flash.Shape = Enum.PartType.Ball
local flashLight = Instance.new("PointLight"); flashLight.Color = Color3.fromRGB(255, 200, 120); flashLight.Range = 14; flashLight.Brightness = 0; flashLight.Parent = flash
-- reflet qui balaie l'arme (inspection, sortie des skins Légendaires) : INS_LIGHT du web, une simple lumière
local glint = part("Glint", Vector3.new(0.02, 0.02, 0.02), Color3.new(), nil)
glint.Transparency = 1
local glintLight = Instance.new("PointLight"); glintLight.Color = Color3.fromRGB(255, 241, 214); glintLight.Range = 0.9; glintLight.Brightness = 0
glintLight.Shadows = false; glintLight.Parent = glint

-- lunette (fusils de précision en visée)
local scopeGui = Instance.new("ScreenGui"); scopeGui.Name = "Scope"; scopeGui.IgnoreGuiInset = true; scopeGui.ResetOnSpawn = false
scopeGui.DisplayOrder = 5; scopeGui.Enabled = false; scopeGui.Parent = player:WaitForChild("PlayerGui")
do
	local ring = Instance.new("Frame"); ring.AnchorPoint = Vector2.new(0.5, 0.5); ring.Position = UDim2.fromScale(0.5, 0.5)
	ring.Size = UDim2.fromScale(0.9, 0.9); ring.BackgroundTransparency = 1; ring.Parent = scopeGui
	local ar = Instance.new("UIAspectRatioConstraint"); ar.Parent = ring
	local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0.5, 0); corner.Parent = ring
	local stroke = Instance.new("UIStroke"); stroke.Thickness = 2000; stroke.Color = Color3.new(); stroke.Parent = ring
end
-- réticule de la lunette : forme + couleur choisies dans Arsenal › Viseurs (scopeRetUpdate du web)
local scopeRet = Instance.new("Frame"); scopeRet.Name = "Ret"; scopeRet.Size = UDim2.fromScale(1, 1); scopeRet.BackgroundTransparency = 1
scopeRet.Parent = scopeGui
local scopeKey = ""
local function scopeRetUpdate(optic: string?)
	local o = optic or "scope"
	local sh, col = A.retOf(o, player)
	local vs = camera.ViewportSize
	local k = sh .. col .. vs.X .. "x" .. vs.Y
	if k == scopeKey then return end
	scopeKey = k
	for _, c in ipairs(scopeRet:GetChildren()) do c:Destroy() end
	ReticleGui.draw(scopeRet, vs.X / 2, vs.Y / 2, vs.Y * .335, sh, col, true)
end

-- ---------- état ----------
local VM = {
	key = nil :: string?, model = nil :: Model?, magParts = {} :: { BasePart }, magC = Vector3.zero, magDir = Vector3.new(0.18, -1, 0).Unit,
	left = Vector3.zero, twoHand = true, sightY = 0.06, muzzle = Vector3.zero, hasMag = false, hasBolt = false, pistol = false,
	kick = 0, kv = 0, sx = 0, sy = 0, sxv = 0, syv = 0, land = 0, lv = 0, strafe = 0, bph = 0, ads = 0,
	spr = 0, tac = 0, sld = 0, mnt = 0, mhi = 0,
	drawT = 0, drawMax = 0.35, flashT = 0, swingT = 0, boltT = 0, pumpT = 0,
	relKey = 0, relSnd = 0, relDrop = false, relEmpty = false, inspSnd = 0,
	sig = "", att = {} :: { string }, mods = A.neutral(), noFlash = false,
	lastLook = Vector3.new(0, 0, -1), prevGround = true, airVy = 0,
	relShells = 3, boltC = Vector3.zero, boltX = 0, stock = {} :: { BasePart },
	drawQ = 0, drawFl = false, drawK = "long", drawRack = false, glintK = 0, glintX = 0,
	-- caméra (placeCamera du web) : ressort d'atterrissage, phase du balancement, tangage déjà ajouté, champ posé
	camL = 0, camLv = 0, camAir = 0, camGround = true, camPit = 0, fovSet = -1, fovBase = 70,
	-- visée linéaire avant la courbe adoucie, traînée de la souris filtrée (inertie), calage sur les pas entendus
	adsL = 0, stx = 0, sty = 0, lastStep = 0, phErr = 0, stepK = 0,
}
-- chargeurs vides qui tombent : copies ancrées, déplacées dans le repère de la caméra (vmDropsUpdate du web)
type Drop = { parts: { BasePart }, rel: { CFrame }, pos: Vector3, r0: CFrame, ang: Vector3, v: Vector3, s: Vector3, t: number }
local drops: { Drop } = {}

-- durée de sortie (drawDur du web) : skins Épiques et plus (rareté 3+) font une petite figure, plus longue
local function drawDur(key: string): number
	local w = Config.WEAPONS[key]
	local q = 0
	if not S.kc then
		local sk = player:GetAttribute("Skin_" .. key)
		local def = if typeof(sk) == "number" then Config.SKINS[sk] else nil
		if def and (sk :: number) > 1 then q = def.rarity - 1 end
		if player:GetAttribute("Camo_" .. key) ~= nil then q = math.max(q, 3) end   -- camos animés : exclusifs
	end
	VM.drawQ = q; VM.drawFl = q >= 2; VM.drawRack = false
	VM.drawK = if w and w.melee then "knife" elseif w and w.cat == "pistol" then "pistol" else "long"
	return if VM.drawFl then (if VM.drawK == "long" then 0.95 else 0.8) else 0.5
end

-- skin de l'arme en main : le nôtre, ou celui du tueur pendant la kill-cam
local setGun: (key: string) -> ()
local function applySkin(initial: boolean?)
	if not VM.model or not VM.key then return end
	local model = VM.model
	local wasReal = model:GetAttribute("Real")
	if S.kc then SkinPaint.apply(model, S.kc.skin, S.kc.camo)
	else SkinPaint.apply(model, player:GetAttribute("Skin_" .. VM.key) :: number?, player:GetAttribute("Camo_" .. VM.key) :: string?) end
	-- le skin (ou Réglages › Armes) a fait passer l'arme du modèle réaliste au stylisé ou l'inverse : pièces, chargeur,
	-- culasse, ligne de visée et main gauche sont relus en refabriquant l'arme en main
	if not initial and VM.model == model and model:GetAttribute("Real") ~= wasReal and VM.key then task.spawn(setGun, VM.key) end
end
player.AttributeChanged:Connect(function(name: string)
	if VM.key and (name == "Skin_" .. VM.key or name == "Camo_" .. VM.key) then applySkin() end
end)
S.onSkin = applySkin

-- la fabrication d'une arme attend Roblox (CreateMeshPartAsync) : elle se fait hors de la boucle d'affichage
-- signature : arme + accessoires de l'armurier + réticules (une nouvelle combinaison reconstruit l'arme en main)
local function sigOf(key: string): string
	if S.kc then return key end
	local s = key .. "|" .. tostring(player:GetAttribute("Att_" .. key))
	for o in pairs(A.RET_DEF) do s ..= tostring(player:GetAttribute("Ret_" .. o)) end
	return s
end
local building: string? = nil
setGun = function(key: string)
	local sig = sigOf(key)
	if building == sig then return end
	building = sig
	local att = if S.kc then {} else A.activeOf(player, key)
	local ok, m = pcall(WeaponModels.build, key, VM_SCALE, att, { ret = function(o: string) return A.retOf(o, player) end })
	if building ~= sig then if ok and m then (m :: Model):Destroy() end return end   -- une autre arme a été demandée entre-temps
	building = nil
	if not ok then warn("[Viewmodel]", m) return end
	if VM.model then VM.model:Destroy() end
	local model = m :: Model
	for _, c in ipairs(model:GetChildren()) do if c:IsA("BasePart") then c.CastShadow = false end end
	model.Parent = rig
	VM.model = model; VM.key = key; VM.sig = sig
	VM.att = att; VM.mods = A.modsOf(att); VM.noFlash = model:GetAttribute("NoFlash") == true
	applySkin(true)
	local w = Config.WEAPONS[key]
	VM.pistol = w.cat == "pistol"
	VM.twoHand = not w.melee
	VM.sightY = (model:GetAttribute("SightY") :: number?) or 0.06
	local grip = model.PrimaryPart :: BasePart
	local la = grip:FindFirstChild("LeftHand") :: Attachment?
	VM.left = if la then la.Position else Vector3.zero
	if VM.pistol or VM.left.Magnitude < 0.01 then VM.left = Vector3.new(-0.01, -0.035, 0.005) end   -- pistolet : main gauche sous la droite
	local mz = grip:FindFirstChild("Muzzle") :: Attachment?
	VM.muzzle = if mz then mz.Position else Vector3.new(0, 0.03, -0.4)
	VM.magParts = {}; VM.hasBolt = false; VM.stock = {}
	local sum, n = Vector3.zero, 0
	local bsum, bn, bx = Vector3.zero, 0, -math.huge
	for _, c in ipairs(model:GetChildren()) do
		if c:IsA("BasePart") then
			local off = c:GetAttribute("Offset")
			local pos = if typeof(off) == "CFrame" then off.Position else nil
			if c:GetAttribute("Piece") == "mag" then
				table.insert(VM.magParts, c)
				if pos then sum += pos; n += 1 end
			elseif c:GetAttribute("Piece") == "bolt" then
				VM.hasBolt = true
				if pos then bsum += pos; bn += 1; bx = math.max(bx, pos.X + c.Size.X / 2) end
			end
			-- crosse (pièce entièrement derrière la poignée) : masquée en visée, vue de près elle boucherait l'écran
			if pos and not w.melee and c:GetAttribute("Piece") ~= "mag" and pos.Z - c.Size.Z / 2 > 0 then table.insert(VM.stock, c) end
		end
	end
	-- levier d'armement : à droite de la culasse (rackC du web), la main droite vient le tirer
	VM.boltC = if bn > 0 then bsum / bn else Vector3.new(0, 0.03, -0.02)
	VM.boltX = if bn > 0 then bx - VM.boltC.X + 0.012 else 0.03
	VM.hasMag = n > 0
	VM.magC = if n > 0 then sum / n else Vector3.new(0, -0.08, -0.05)
	VM.magDir = if key == "p90" then Vector3.new(0, 0.55, 0.85).Unit else Vector3.new(0.18, -1, 0).Unit
	VM.drawMax = drawDur(key)
	VM.drawT = VM.drawMax
end

-- ---------- événements ----------
S.onDraw:Connect(function(key: string)
	if key ~= VM.key then task.spawn(setGun, key) else VM.drawMax = drawDur(key); VM.drawT = VM.drawMax end
	sfx("draw", 0.6)
end)
S.onShot:Connect(function(key: string)
	local w = Config.WEAPONS[key]
	if not w then return end
	if VM.drawFl then VM.drawT = 0 end              -- tirer coupe la figure de sortie (vmFire du web)
	if w.melee then VM.swingT = 0.38; sfx("knife", 0.5); return end
	VM.kv += (if w.cat == "sniper" or w.cat == "shotgun" then 22 elseif w.cat == "pistol" then 14 else 12) * (1 - 0.45 * VM.ads)
	VM.flashT = 0.05
	if w.cat == "sniper" and not w.auto then VM.boltT = 0.8; task.delay(0.38, sfx, "bolt", 0.6) end
	if w.cat == "shotgun" and not w.auto then VM.pumpT = 0.6; task.delay(0.3, sfx, "pump", 0.6) end
	-- douille éjectée à droite : vraie douille du décor qui rebondit (ShotFx), partie de la fenêtre d'éjection
	if VM.model and (w.cat ~= "shotgun" or w.auto) then
		local grip = VM.model.PrimaryPart :: BasePart
		ShotFx.ownShell((grip.CFrame * CFrame.new(0.03, 0.04, -0.05)).Position)
	end
end)
S.onReload:Connect(function(_key: string, empty: boolean)
	VM.relSnd = 0; VM.relDrop = false; VM.relEmpty = empty
	-- pompe : nombre de cartouches glissées une à une, fixé au début de la recharge
	local w = VM.key and Config.WEAPONS[VM.key]
	VM.relShells = if w then clamp(w.mag - S.mag, 1, 4) else 3
	if not VM.hasMag and not (w and w.cat == "shotgun") then sfx("reload", 0.8) end
end)

-- chargeur vide qui tombe (vmDropMag du web) : copie des pièces lâchée dans la vue, 0,9 m/s le long du puits,
-- gravité de 7 m/s² dans le repère de la caméra, rotation au hasard ; disparaît après 1,2 s ou sous l'écran
local function dropMag(gunCF: CFrame, magAnim: CFrame)
	local g0 = gunCF * magAnim * CFrame.new(VM.magC)          -- centre du chargeur, repère de la caméra
	local d: Drop = { parts = {}, rel = {}, pos = g0.Position, r0 = g0.Rotation, ang = Vector3.zero, t = 0,
		v = gunCF:VectorToWorldSpace(VM.magDir) * 0.9 - Vector3.new(0.15, 0, 0),
		s = Vector3.new((math.random() - 0.5) * 6, (math.random() - 0.5) * 4, 4 + math.random() * 3) }
	for _, p in ipairs(VM.magParts) do
		local off = p:GetAttribute("Offset")
		local c = p:Clone(); c.Anchored = true; c.CanCollide = false; c.Parent = rig
		table.insert(d.parts, c)
		table.insert(d.rel, CFrame.new(-VM.magC) * (if typeof(off) == "CFrame" then off else CFrame.identity))
	end
	table.insert(drops, d)
end
local function dropsUpdate(dt: number, camCF: CFrame)
	for i = #drops, 1, -1 do
		local d = drops[i]
		d.t += dt; d.v -= Vector3.new(0, 7 * dt, 0); d.pos += d.v * dt; d.ang += d.s * dt
		if d.t > 1.2 or d.pos.Y < -1.2 then
			for _, p in ipairs(d.parts) do p:Destroy() end
			table.remove(drops, i)
		else
			local base = camCF * CFrame.new(d.pos) * d.r0 * CFrame.fromEulerAnglesXYZ(d.ang.X, d.ang.Y, d.ang.Z)
			for j, p in ipairs(d.parts) do p.CFrame = base * d.rel[j] end
		end
	end
end

-- reflet (inspectGlint du web) : intensité en cloche, la lumière passe de gauche à droite devant l'arme
local function inspectGlint(a: number)
	local x = clamp((a - 0.04) / 0.3, 0, 1)
	VM.glintK = math.sin(x * math.pi); VM.glintX = lerp(-0.25, 0.45, x)
end

-- ---------- inspection (clés du web : [instant, px, py, pz, rx, ry, rz]) ----------
local TAU = math.pi * 2
local INSK = {
	mag = { { 0, 0, 0, 0, 0, 0, 0 }, { .08, -.03, .03, -.02, .2, 1.05, .45 }, { .22, -.045, .035, -.03, .26, 1.32, .52 }, { .31, .015, .02, -.02, .1, -.5, -.55 },
		{ .39, -.01, 0, -.02, .15, .38, .32 }, { .78, -.01, -.02, 0, .1, .3, .26 }, { .83, -.01, -.012, 0, .02, .26, .2 }, { .9, -.01, 0, 0, .06, .2, .12 }, { 1, 0, 0, 0, 0, 0, 0 } },
	plain = { { 0, 0, 0, 0, 0, 0, 0 }, { .12, -.03, .03, -.03, .22, 1.1, .45 }, { .4, -.05, .04, -.04, .28, 1.35, .55 }, { .55, .02, .02, -.02, .1, -.5, -.6 },
		{ .8, .01, .02, -.02, .15, -.62, -.5 }, { 1, 0, 0, 0, 0, 0, 0 } },
	knife = { { 0, 0, 0, 0, 0, 0, 0 }, { .12, -.06, .06, -.04, .3, .2, .2 }, { .5, -.08, .07, -.05, .3, .3, .2 + TAU * 2 }, { .72, -.08, .06, -.06, .2, 1.3, .3 + TAU * 2 },
		{ .88, -.06, .05, -.05, .25, -.4, TAU * 2 - .3 }, { 1, 0, 0, 0, 0, 0, TAU * 2 } },
}
local INSD = { mag = 4.4, plain = 3, knife = 2.2 }

local function inspectKind(): string
	local w = VM.key and Config.WEAPONS[VM.key]
	if w and w.melee then return "knife" end
	return if VM.hasMag and not NO_MAG_SHOW[VM.key or ""] then "mag" else "plain"
end

-- ---------- IK des bras (épaule → coude → poignet), comme place() du web ----------
local function seg(p: BasePart, a: Vector3, b: Vector3, thick: number)
	local d = b - a
	local L = math.max(d.Magnitude, 1e-3)
	p.Size = Vector3.new(L, thick, thick)        -- cylindre : axe X
	p.CFrame = CFrame.lookAt((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
end
local function placeArm(up: BasePart, fore: BasePart, cuff: BasePart, hand: Vector3, sx: number, ads: number, camCF: CFrame)
	local sh = Vector3.new(sx * (0.3 - 0.06 * ads), -0.5 - 0.14 * ads, -0.05)
	local LU, LF = 0.34, 0.3
	local d0 = (hand - sh).Magnitude
	local k = math.max(1, d0 / (LU + LF - 0.01))
	local lu, lf, d = LU * k, LF * k, math.max(d0, 1e-4)
	local dir = (hand - sh) / d
	local a = (lu * lu - lf * lf + d * d) / (2 * d)
	local h = math.sqrt(math.max(0, lu * lu - a * a))
	local pole = Vector3.new(sx * 0.8, -1, 0.2)
	pole = (pole - dir * pole:Dot(dir)).Unit
	local el = sh + dir * a + pole * h
	local function w(v: Vector3): Vector3 return camCF:PointToWorldSpace(v) end
	seg(up, w(sh), w(el), if sleeveMesh then MANCHE_U else ARM_U)
	seg(fore, w(el), w(hand), if sleeveMesh then MANCHE_F else ARM_F)
	cuff.CFrame = CFrame.lookAt(w(el:Lerp(hand, 0.9)), w(hand)) * CFrame.Angles(0, math.rad(90), 0)   -- axe X du cylindre le long de l'avant-bras
end

local function setVisible(on: boolean)
	for _, c in ipairs(rig:GetDescendants()) do
		if c:IsA("BasePart") then c.LocalTransparencyModifier = if on then 0 else 1 end
	end
end

-- ---------- boucle ----------
RunService:BindToRenderStep("Viewmodel", Enum.RenderPriority.Camera.Value + 2, function(dt: number)
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local kc = S.kc                         -- kill-cam : l'arme du tueur, dans ses mains (KillcamController)
	local key = if kc then kc.key else S.weapon
	local alive = if kc then key ~= nil else hum ~= nil and hum.Health > 0 and key ~= nil and camera.CameraType == Enum.CameraType.Custom
	if not alive or not key then
		setVisible(false); scopeGui.Enabled = false; S.muzzle = nil
		-- la caméra a été reprise (kill-cam, arrivée, spectateur, photo) : le tangage ajouté par nous n'y est plus,
		-- il ne faut pas le retirer au retour (la vue partait de travers)
		if kc or camera.CameraType ~= Enum.CameraType.Custom then VM.camPit = 0 end
		return
	end
	if not kc and os.clock() < S.drinkHideUntil then setVisible(false); scopeGui.Enabled = false; S.muzzle = nil; return end   -- boisson d'atout : arme rangée
	if key ~= VM.key then
		if building ~= sigOf(key) then task.spawn(setGun, key) end
		setVisible(false); return
	end
	if VM.sig ~= sigOf(key) and building ~= sigOf(key) then task.spawn(setGun, key) end   -- accessoires changés : on garde l'ancienne le temps de reconstruire
	local model = VM.model
	if not model then return end
	local w = Config.WEAPONS[key]
	local t = os.clock()

	-- visée (lissée), poids des postures de déplacement
	-- façon Call of Duty : la visée avance à vitesse constante (≈ 0,2 s, 0,34 s à la lunette, selon la famille d'arme
	-- et les accessoires : mods.ads), puis passe par une courbe douce aux deux bouts ; on quitte la visée un peu plus vite
	local adsDur = (if A.sightOv(key, VM.att) then 0.34 else 0.2) * (ADS_CAT[w.cat] or 1) / math.max(0.25, VM.mods.ads)
	local aimOn = S.aiming and not w.melee
	VM.adsL = clamp(VM.adsL + (if aimOn then dt else -dt * 1.25) / adsDur, 0, 1)
	VM.ads = smooth01(VM.adsL)
	S.adsT = VM.ads
	local ads = VM.ads
	-- mvWeights du web : le sprint ne compte qu'au-dessus de 80 % de la course, chaque posture a sa vitesse de transition
	local function follow(cur: number, on: boolean, rate: number): number return cur + ((if on then 1 else 0) - cur) * math.min(1, dt * rate) end
	local running = S.speed / STUDS_PER_M > 5.2 * 0.8
	VM.spr = follow(VM.spr, S.sprint and not S.tactical and running, 9); VM.tac = follow(VM.tac, S.tactical and running, 9)
	VM.sld = follow(VM.sld, S.slide, 12); VM.mnt = follow(VM.mnt, S.mantle, 14)
	VM.mhi = follow(VM.mhi, S.mantle and S.mantleHigh, 14)
	-- avancement de l'escalade 0..1 (MovementController), -1 hors escalade
	local mA = if S.mantle and S.mantleDur > 0 then clamp((t - S.mantleT) / S.mantleDur, 0, 1) else -1
	local mBump = if mA >= 0 then math.sin(mA * math.pi) else 0

	-- ressorts : recul, traînée de la souris, atterrissage, pas de côté
	local sd = math.min(dt, 0.033)
	VM.kv += (-VM.kick * 300 - VM.kv * 26) * sd; VM.kick = clamp(VM.kick + VM.kv * sd, -0.3, 1.4)
	VM.flashT = math.max(0, VM.flashT - dt); VM.drawT = math.max(0, VM.drawT - dt); VM.swingT = math.max(0, VM.swingT - dt)
	VM.boltT = math.max(0, VM.boltT - dt); VM.pumpT = math.max(0, VM.pumpT - dt)
	local spdMs = S.speed / STUDS_PER_M
	local spd = clamp(spdMs / 5.2, 0, 1.3)
	VM.bph += dt * spdMs * 1.7
	-- pas entendu (AmbienceController) : le creux du balancement (pied posé) est recalé dessus en douceur,
	-- et l'arme comme la tête marquent un petit à-coup du pied qui se pose
	if S.stepAt ~= VM.lastStep then
		VM.lastStep = S.stepAt
		if S.grounded and t - S.stepAt < 0.1 then
			VM.phErr = ((math.pi * 0.75 - VM.bph) + math.pi * 0.5) % math.pi - math.pi * 0.5
			VM.stepK = 1
		end
	end
	do local c = VM.phErr * math.min(1, dt * 9); VM.bph += c; VM.phErr -= c end
	VM.stepK *= math.exp(-dt * 13)
	-- direction du regard sans le plongeon d'atterrissage ajouté par nous (sinon l'arme traînerait derrière)
	local look = (camera.CFrame * CFrame.Angles(-VM.camPit, 0, 0)).LookVector
	local yaw0 = math.atan2(-VM.lastLook.X, -VM.lastLook.Z); local yaw1 = math.atan2(-look.X, -look.Z)
	local dyaw = (yaw1 - yaw0 + math.pi) % TAU - math.pi
	local dp = math.asin(clamp(look.Y, -1, 1)) - math.asin(clamp(VM.lastLook.Y, -1, 1))
	VM.lastLook = look
	local id = 1 / math.max(dt, 1e-3)
	local tx, ty = clamp(dyaw * id * 0.016, -0.07, 0.07), clamp(-dp * id * 0.016, -0.055, 0.055)
	-- inertie : la cible de la traînée est filtrée (l'arme part un peu après la souris), le ressort est un peu plus mou
	local lp = math.min(1, dt * 14)
	VM.stx += (tx - VM.stx) * lp; VM.sty += (ty - VM.sty) * lp
	VM.sxv += ((VM.stx - VM.sx) * 120 - VM.sxv * 16) * sd; VM.sx += VM.sxv * sd
	VM.syv += ((VM.sty - VM.sy) * 120 - VM.syv * 16) * sd; VM.sy += VM.syv * sd
	local vyMs = S.vy / STUDS_PER_M
	if S.grounded and not VM.prevGround and VM.airVy < -2 then VM.lv -= math.min(2.2, -VM.airVy * 0.22); sfx("land", 0.6) end
	VM.airVy = if S.grounded then 0 else vyMs; VM.prevGround = S.grounded
	VM.lv += (-VM.land * 220 - VM.lv * 19) * sd; VM.land += VM.lv * sd
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local lat = 0
	if root and not kc then
		lat = camera.CFrame.RightVector:Dot(root.AssemblyLinearVelocity) / STUDS_PER_M
		VM.strafe += (clamp(lat / 5, -1, 1) - VM.strafe) * (1 - math.exp(-dt * 8))
	end

	-- caméra du web (placeCamera) : la tête balance en marchant, roule un peu en pas de côté et en glissade,
	-- plonge à l'atterrissage puis revient ; le champ s'élargit en sprint / sprint tactique / glissade.
	-- La caméra Roblox repart chaque image de sa direction : le roulis et la position sont reposés à chaque fois,
	-- le tangage n'est ajouté que par différence (comme le recul de WeaponController).
	if kc then VM.camPit = 0 end            -- la kill-cam pose la caméra elle-même
	if not kc then
		if not S.grounded then VM.camAir = vyMs end
		if S.grounded and not VM.camGround and VM.camAir < -2.5 then VM.camLv -= math.min(1.6, -VM.camAir * 0.16) end
		VM.camGround = S.grounded; if S.grounded then VM.camAir = 0 end
		VM.camLv += (-VM.camL * 190 - VM.camLv * 20) * sd; VM.camL += VM.camLv * sd
		local roll = -clamp(lat / 5.2, -1, 1) * 0.012 * spdMs / 5 + VM.sld * 0.055
		local bobX, bobY = 0, 0
		if S.grounded then
			-- même phase que l'arme (calée sur les pas) : la tête est au plus bas quand le pied se pose
			local ph = VM.bph
			local a = clamp(spdMs / 5, 0, 1.3) * shakeK
			bobY = math.sin(ph * 2) * 0.016 * a - VM.stepK * 0.005 * shakeK; bobX = math.sin(ph) * 0.011 * a
			roll += math.sin(ph) * (0.0035 + VM.tac * 0.006) * a                 -- sprint tactique : la tête roule davantage
		end
		-- escalade : la tête plonge vers le rebord et roule un peu du côté de la main posée
		roll += mBump * 0.035 * (0.4 + 0.6 * shakeK)
		local land = VM.camL * (0.35 + 0.65 * shakeK)
		bobY += land - VM.camL                                 -- plongeon d'atterrissage réduit avec les secousses
		local pit = land * 0.35 - mBump * (0.07 + VM.mhi * 0.05)
		local cf = camera.CFrame
		local flatR = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
		flatR = if flatR.Magnitude > 1e-3 then flatR.Unit else Vector3.xAxis
		local off = (flatR * bobX + Vector3.yAxis * (bobY + VM.camL)) * STUDS_PER_M
		camera.CFrame = CFrame.new(off) * cf * CFrame.Angles(pit - VM.camPit, 0, 0) * CFrame.Angles(0, 0, roll)
		VM.camPit = pit
		-- champ : WeaponController le repose à chaque image ; s'il ne l'a pas fait, on repart de notre base
		local fov = camera.FieldOfView
		if math.abs(fov - VM.fovSet) < 1e-4 then fov = VM.fovBase end
		VM.fovBase = fov
		-- (en partant du champ choisi dans les Réglages, et rien en visée : le zoom de l'arme reste exact)
		VM.fovSet = fov * (1 + (VM.spr * 0.06 + VM.tac * 0.1 + VM.sld * 0.07) * (1 - ads))
		camera.FieldOfView = VM.fovSet
	end

	-- marche en « 8 » + respiration
	local bobk = 1 - ads * 0.88
	local ph = VM.bph
	local bx, by, br = math.sin(ph) * 0.009 * spd * bobk, (math.sin(ph * 2) * 0.5 - 0.25) * 0.012 * spd * bobk, math.sin(ph) * 0.018 * spd * bobk
	local idle = (1 - clamp(spd, 0, 1)) * (1 - ads * 0.8)
	local brY, brX = math.sin(t * 1.7) * 0.0028 * idle, math.sin(t * 0.9) * 0.0018 * idle

	-- position de base : hanche (ramenée pour un champ de 60° comme le web) → visée (exacte)
	local adsZ = -0.46 + (if A.optOf(VM.att) then 0.08 else 0)     -- optique : arme un peu plus près de l'œil
	local px = lerp(0.19 / FOV_K, 0, ads)
	local py = lerp(-0.162 / FOV_K, -VM.sightY, ads)
	local pz = lerp(-0.47 / FOV_K, adsZ, ads)
	local rx, ry, rz = 0.02 * (1 - ads), 0.06 * (1 - ads), -0.05 * (1 - ads)
	local sw = 1 - ads * 0.75
	px += bx + brX + VM.sx * sw; py += by + brY + VM.sy * sw + (if S.crouch then 0.015 * (1 - ads) else 0)
	ry += VM.sx * 1.6 * sw; rx += VM.sy * 1.2 * sw; rz += br - VM.sx * 1.2 * sw - VM.strafe * 0.06 * (1 - ads * 0.7)
	if not S.grounded then local a = clamp(-vyMs * 0.005, -0.035, 0.03); py += a * (1 - ads * 0.6); rx -= a * 1.5 end
	py += VM.land * 0.1; rx += VM.land * 0.35
	-- pied qui se pose (pas entendu) : l'arme plonge à peine et revient
	local stk = VM.stepK * (1 - ads * 0.85) * clamp(spd, 0, 1)
	py -= stk * 0.006; rx -= stk * 0.012; rz += stk * 0.006 * (if math.sin(VM.bph) > 0 then 1 else -1)
	px -= VM.strafe * 0.008 * (1 - ads)                    -- pas de côté : l'arme glisse un peu à l'opposé
	-- recul
	local kk = VM.kick
	pz += kk * 0.055; rx += kk * 0.09; rz += math.sin(t * 47) * math.max(0, kk) * 0.012; py += kk * 0.01
	-- sortie de l'arme (drawPose du web) : arrive du bas, dépasse un peu, se pose ;
	-- skins Épiques et plus : pistolet qui fait un tour autour du pontet, couteau qui tournoie, fusil basculé puis armé
	VM.glintK = 0
	local drawSpin = 0
	if VM.drawT > 0 then
		local a = 1 - VM.drawT / VM.drawMax
		local up = clamp(a / (if VM.drawFl then 0.45 else 0.75), 0, 1)
		local e = 1 - up
		local ov = math.sin(up * math.pi) * (1 - up) * 0.6
		py += -e * e * 0.3 + ov * 0.02; rx += -e * e * 0.95 + ov * 0.12; px += e * e * 0.06; rz += e * 0.25
		if VM.drawFl then
			local f = clamp((a - 0.3) / 0.55, 0, 1)
			local s = smooth01(f)
			if VM.drawK == "pistol" then
				drawSpin = s * TAU; py += math.sin(f * math.pi) * 0.05; pz -= math.sin(f * math.pi) * 0.03
			elseif VM.drawK == "knife" then
				rz += s * TAU * 2; py += math.sin(f * math.pi) * 0.04
			else
				local b = math.sin(f * math.pi)
				rz += b * 0.9; ry += b * 0.35; py += b * 0.03; px -= b * 0.03
				if VM.hasBolt and not VM.pistol and a > 0.78 and not VM.drawRack then VM.drawRack = true; VM.boltT = 0.8; sfx("rack", 0.5) end
			end
			if VM.drawQ >= 3 then inspectGlint(clamp((a - 0.2) * 0.75, 0, 1)) end
		end
		if a < 0.05 then VM.drawRack = false end
	end
	-- lancer de grenade / pose de mine (vmThrow du web)
	local thr = t - S.throwStart
	if thr >= 0 and thr < 0.7 then local a = math.sin(thr / 0.7 * math.pi); py -= a * .32; rx -= a * .4 end
	-- couteau
	if VM.swingT > 0 then
		local a = 1 - VM.swingT / 0.38
		local s = math.sin(a * math.pi)
		rz += s * 1.1; ry += s * 0.7; px -= s * 0.18; rx -= s * 0.5; pz -= s * 0.06
	end
	-- inspection
	local ins: any = nil
	if S.inspectStart > 0 then
		if ads > 0.3 or S.reloading then S.inspectStart = -1; VM.inspSnd = 0
		else
			local kind = inspectKind()
			local a = (t - S.inspectStart) / INSD[kind]
			if a >= 1 then S.inspectStart = -1; VM.inspSnd = 0
			else
				local K = INSK[kind]
				local i = 1
				while i < #K - 1 and a > K[i + 1][1] do i += 1 end
				local A, B = K[i], K[i + 1]
				local f = smooth01((a - A[1]) / (B[1] - A[1]))
				local v = table.create(6)
				for j = 1, 6 do v[j] = A[j + 1] + (B[j + 1] - A[j + 1]) * f end
				px += v[1]; py += v[2]; pz += v[3]; rx += v[4] + math.sin(a * 23) * 0.006; ry += v[5]; rz += v[6] + math.sin(a * 17 + 1) * 0.008
				ins = { a = a, kind = kind, lh = 0, out = 0, hold = 0, tilt = 0 }
				if kind == "mag" then
					local function sg(x0: number, x1: number): number return smooth01((a - x0) / (x1 - x0)) end
					ins.lh = sg(0.36, 0.42) * (1 - sg(0.82, 0.9))
					ins.out = sg(0.42, 0.48) * (1 - sg(0.76, 0.8))
					ins.hold = sg(0.47, 0.56) * (1 - sg(0.69, 0.77))
					ins.tilt = math.sin(clamp((a - 0.56) / 0.13, 0, 1) * math.pi) * 0.35
					if a > 0.79 and a < 0.84 then py += -0.012 * math.sin((a - 0.79) / 0.05 * math.pi) end
					local function snd(k: number, at: number, n: string, vol: number)
						if VM.inspSnd < k and a >= at then VM.inspSnd = k; sfx(n, vol) end
					end
					snd(1, 0.37, "magout", 0.35); snd(2, 0.43, "magout", 0.7); snd(3, 0.79, "magin", 0.85)
				elseif kind == "knife" and VM.inspSnd < 1 and a > 0.14 then VM.inspSnd = 1; sfx("knife", 0.3) end
				inspectGlint(a)
			end
		end
	end
	-- sprint (arme en travers), sprint tactique (arme levée), glissade (inclinée), escalade (arme baissée)
	do
		local s, T, L, Mn = VM.spr * (1 - ads), VM.tac * (1 - ads), VM.sld, VM.mnt
		local sb = math.sin(VM.bph * 0.9)
		px += -s * 0.045 + s * sb * 0.014; py += -s * 0.05 + s * math.abs(sb) * 0.012; rx -= s * 0.3; ry += s * 0.62; rz += s * 0.38
		rz += s * sb * 0.05; rx += s * math.abs(sb) * 0.03                      -- l'arme ballotte au rythme des foulées
		px += T * (0.1 + sb * 0.01); py += T * (-0.015 + math.abs(sb) * 0.015); rx += T * 0.8; rz -= T * 0.6; ry -= T * 0.12
		rz += L * 0.32; py -= L * 0.03; px -= L * 0.02
		-- glissade : l'arme vibre sur le sol, puis se redresse en fin de glissade
		rz += L * math.sin(t * 31) * 0.006; py += L * math.sin(t * 27 + 1) * 0.0035; rx += L * math.sin(t * 23) * 0.004
		-- escalade : arme baissée sur la droite (rebord bas) ou sortie de la vue (rebord haut, les deux mains se hissent)
		py -= Mn * 0.22; rx -= Mn * 0.7; px += Mn * 0.03
		py -= VM.mhi * 0.42; rz -= VM.mhi * 0.5; px += VM.mhi * 0.06
	end
	-- rechargement en phases
	local rl = -1
	local leftOff = 0
	-- durée réelle envoyée par le serveur (accessoires et atouts) : sinon, avec Speed Cola, la recharge finissait
	-- avant l'animation et le son « chargeur dedans » ne venait jamais
	local reloadDur = if S.reloadDur > 0 then S.reloadDur else w.reload * VM.mods.rel
	if S.reloading and reloadDur > 0 then
		rl = clamp((t - S.reloadStart) / reloadDur, 0, 1)
		local tilt = smooth01(rl / 0.16) * (1 - smooth01((rl - 0.84) / 0.16))
		local function bump(c: number, w2: number): number return math.exp(-((rl - c) / w2) ^ 2) end
		local slap, rack = bump(0.74, 0.035), if VM.relEmpty then bump(0.87, 0.04) else 0
		local mw = if VM.hasMag then tilt else 0
		rx += tilt * 0.12 + mw * 0.1 + slap * -0.08 + rack * 0.06
		rz += tilt * (if VM.hasMag then -0.42 else 0.48) + slap * 0.06
		ry -= tilt * 0.1 - mw * 0.22
		px -= tilt * 0.02 + mw * 0.07; py -= tilt * 0.055 - mw * 0.05 - slap * 0.014; pz += rack * 0.028 - tilt * 0.02
		leftOff = if VM.hasMag then tilt else 0
		-- étapes de recharge (Sfx.reloadStep : "out" / "in" / "bolt" / "shell"), calées sur la durée de recharge
		local function snd(i: number, at: number, step: string)
			if VM.relSnd < i and rl >= at then VM.relSnd = i; Sfx.reloadStep(w.cat, step, nil, 0.8) end
		end
		if VM.hasMag then
			snd(1, 0.28, "out"); snd(2, 0.71, "in")
			if VM.relEmpty and VM.hasBolt then snd(3, if VM.pistol then 0.84 else 0.85, "bolt") end
		elseif w.cat == "shotgun" then
			local n = VM.relShells
			local aa = clamp((rl - 0.15) / 0.65, 0, 0.999)
			local i = math.floor(aa * n)
			local ph2 = aa * n % 1
			if rl > 0.15 and rl < 0.8 then
				leftOff = math.sin(ph2 * math.pi) * 0.6
				if VM.relSnd <= i and ph2 > 0.55 then VM.relSnd = i + 1; Sfx.reloadStep(w.cat, "shell", nil, 0.7) end
			end
			if VM.relEmpty and VM.hasBolt then snd(99, 0.85, "bolt") end   -- à vide : on pompe à la fin
		end
	end

	local gunCF = CFrame.new(px, py, pz) * CFrame.fromEulerAnglesXYZ(rx, ry, rz)
	-- tour du pistolet : autour de la main (doigt dans le pontet), la main et le bras ne tournent pas
	local gunDraw = gunCF
	if drawSpin ~= 0 then
		local piv = Vector3.new(0.005, -0.035, 0.02) + Vector3.new(0, -0.012, -0.02) * VM_SCALE
		gunDraw = gunCF * CFrame.new(piv) * CFrame.Angles(drawSpin, 0, 0) * CFrame.new(-piv)
	end

	-- pièces mobiles : chargeur (recharge / inspection), culasse ou glissière
	local pieces: { [string]: CFrame } = {}
	local magVisible = true
	local magPos = VM.magC
	if VM.hasMag then
		local out, tw = 0, 0
		if rl >= 0 then
			if rl < 0.26 then out = 0
			elseif rl < 0.36 then out = smooth01((rl - 0.26) / 0.1)
			elseif rl < 0.46 then
				-- à vide le chargeur est lâché (il tombe dans la vue) ; recharge tactique : la main gauche l'emporte vers la poche
				out = 1 + smooth01((rl - 0.36) / 0.1) * 1.4; magVisible = not VM.relEmpty and rl < 0.42
			elseif rl < 0.58 then out = 2.4 - smooth01((rl - 0.46) / 0.12) * 1.25; tw = 1 - smooth01((rl - 0.5) / 0.08)
			elseif rl < 0.72 then out = 1.15 * (1 - smooth01((rl - 0.58) / 0.14)) end
		end
		local off = VM.magDir * out * 0.2
		local rot = CFrame.fromEulerAnglesXYZ(tw * 0.5, 0, tw * 0.35)
		-- repère du centre du chargeur (repère de l'arme), rotation autour de ce centre
		local center = CFrame.new(VM.magC + off) * rot
		if ins and ins.kind == "mag" and (ins.out > 0 or ins.hold > 0) then
			-- inspection (inspectMag du web) : glissé hors du puits, puis amené devant les yeux, haut du chargeur
			-- tourné vers la caméra et cartouches vers le haut, tourné un peu pour les montrer
			center = CFrame.new(VM.magC + VM.magDir * ins.out * 0.24)
			if ins.hold > 0 then
				local tilt = CFrame.Angles(0, ins.tilt, 0)
				local iA = tilt * Vector3.new(0, 0.45, 1).Unit
				local iB = tilt * Vector3.new(0.25, 1, -0.35).Unit
				local c2 = iA:Cross(iB).Unit
				iB = c2:Cross(iA).Unit
				local up, fw = Vector3.yAxis, Vector3.new(0, 0, -1)
				local Rq = CFrame.fromMatrix(Vector3.zero, iA, iB, c2) * CFrame.fromMatrix(Vector3.zero, up, fw, up:Cross(fw)):Inverse()
				local hold = gunCF:Inverse() * CFrame.new(Vector3.new(-0.04, -0.06, -0.28) / FOV_K) * Rq
				center = center:Lerp(hold, ins.hold)
			end
			magPos = center:PointToWorldSpace(Vector3.new(0, -0.02, 0)) + Vector3.new(0, 0.02, 0)   -- la main le tient par le bas
		else
			magPos = VM.magC + off
		end
		pieces.mag = center * CFrame.new(-VM.magC)
		if rl >= 0.36 and not VM.relDrop and VM.relEmpty then VM.relDrop = true; dropMag(gunCF, pieces.mag) end
	end
	if VM.hasBolt then
		local pull = 0
		if rl >= 0 and VM.relEmpty then
			pull = if rl < 0.82 then 0 elseif rl < 0.87 then smooth01((rl - 0.82) / 0.05) elseif rl < 0.895 then 1 - smooth01((rl - 0.87) / 0.025) else 0
		end
		if VM.pistol then
			local lockBack = (rl < 0 and S.mag <= 0) or (rl >= 0 and VM.relEmpty and rl < 0.84)
			pieces.bolt = CFrame.new(0, 0, math.max(kk * 0.03, if lockBack then 0.028 else 0))
		else
			local bt = math.max(if VM.boltT > 0 then math.sin((1 - VM.boltT / 0.8) * math.pi) else 0, pull)
			-- fusil à verrou : le levier pivote avant de reculer (rotation autour de la culasse)
			local turn = if w.cat == "sniper" then bt * 0.8 else 0
			pieces.bolt = CFrame.new(0, 0, bt * 0.06) * CFrame.new(VM.boltC) * CFrame.Angles(0, 0, turn) * CFrame.new(-VM.boltC)
		end
	end

	-- lunette : en visée avec un fusil de précision, l'arme disparaît derrière l'oculaire
	local scoped = ads > 0.92 and not w.melee and A.sightOv(key, VM.att)
	scopeGui.Enabled = scoped
	if scoped then scopeRetUpdate(A.optOf(VM.att)) end
	setVisible(not scoped)
	if ads >= 0.55 then for _, p in ipairs(VM.stock) do p.LocalTransparencyModifier = 1 end end

	-- placement dans le monde
	local camCF = camera.CFrame
	local world = camCF * gunDraw
	WeaponModels.place(model, world, pieces)
	dropsUpdate(dt, camCF)
	glint.CFrame = camCF * CFrame.new(VM.glintX, 0.05, -0.25)
	glintLight.Brightness = VM.glintK * 2.4
	if not magVisible then for _, p in ipairs(VM.magParts) do p.LocalTransparencyModifier = 1 end end

	-- mains : droite sur la poignée, gauche sur le garde-main (va chercher le chargeur pendant la recharge)
	local rightL = gunCF:PointToWorldSpace(Vector3.new(0.005, -0.035, 0.02))
	local leftLocal = VM.left - Vector3.new(0, leftOff * 0.12, 0)
	if rl >= 0 and VM.hasMag then
		local k = if rl < 0.15 then rl / 0.15 elseif rl > 0.8 then (1 - rl) / 0.2 else 1
		leftLocal = leftLocal:Lerp(magPos - Vector3.new(0, 0.02, 0), smooth01(k))
		-- armement d'une arme longue vide : la main droite lâche la poignée et tire le levier d'armement
		if VM.relEmpty and VM.hasBolt and not VM.pistol and VM.twoHand and rl >= 0.76 then
			local kin = smooth01((rl - 0.76) / 0.06)
			local bolt = pieces.bolt or CFrame.identity
			local hp = gunCF * bolt * (VM.boltC + Vector3.new(VM.boltX, 0, 0))
			rightL = rightL:Lerp(hp, kin * (if rl < 0.92 then 1 else smooth01((1 - rl) / 0.08)))
		end
	end
	if ins and ins.lh > 0 then leftLocal = leftLocal:Lerp(magPos - Vector3.new(0, 0.02, 0), ins.lh) end
	local leftL = gunCF:PointToWorldSpace(leftLocal)
	local handRot = gunCF.Rotation
	local rotR, rotL = handRot, handRot
	-- sprint tactique : la main gauche lâche le garde-main et balance au rythme de la course (arme tenue haute)
	local pump = if VM.twoHand and rl < 0 and not ins then VM.tac * (1 - ads) * (1 - VM.mnt) else 0
	if pump > 0.001 then
		local sb = math.sin(VM.bph * 0.9)
		local swing = Vector3.new(-0.2 + sb * 0.02, -0.3 + sb * 0.07, -0.34 - sb * 0.1) / FOV_K
		leftL = leftL:Lerp(swing, smooth01(pump))
		rotL = handRot:Lerp(CFrame.Angles(0.5 + sb * 0.4, 0.3, 0.2), smooth01(pump))
	end
	-- escalade : la main gauche (et la droite sur un rebord haut) vient se poser à plat sur le rebord ; le corps monte,
	-- le rebord descend donc dans la vue sous la paume, qui pousse jusqu'à la fin du geste
	local plant = false
	if mA >= 0 and VM.twoHand then
		local reach = smooth01(mA / 0.2) * (1 - smooth01((mA - 0.8) / 0.2))
		local push = smooth01((mA - 0.12) / 0.6)
		local ly, lz = lerp(0.03, -0.34, push), lerp(-0.5, -0.3, push)
		local palmL = CFrame.Angles(-0.25, 0.15, 0) * CFrame.Angles(0, 0, -math.pi / 2)    -- paume vers le bas, doigts vers l'avant
		local palmR = CFrame.Angles(-0.25, -0.15, 0) * CFrame.Angles(0, 0, math.pi / 2)
		leftL = leftL:Lerp(Vector3.new(-0.15, ly, lz), reach)
		rotL = rotL:Lerp(palmL, reach)
		plant = reach > 0.5
		local rk = reach * VM.mhi
		if rk > 0.001 then
			rightL = rightL:Lerp(Vector3.new(0.13, ly + 0.01, lz - 0.02), rk)
			rotR = handRot:Lerp(palmR, rk)
		end
	end
	arms.hR.CFrame = camCF * (CFrame.new(rightL) * rotR)
	-- poignée verticale : la main gauche se referme autour, paume tournée vers l'arrière
	-- (même tenue pour la main posée sur un rebord : c'est le reflet de la main droite)
	setLeftHold(plant or (model:GetAttribute("LeftV") == true and rl < 0 and not (ins and ins.lh > 0.3)))
	arms.hL.CFrame = camCF * (CFrame.new(leftL) * rotL)
	local hidden = camCF * CFrame.new(0, -3, 0)
	placeGloves(arms.hR.CFrame, if VM.twoHand then arms.hL.CFrame else nil, hidden)
	placeArm(arms.uR, arms.fR, arms.cR, rightL + rotR:VectorToWorldSpace(WRIST), 1, ads, camCF)
	if VM.twoHand then
		placeArm(arms.uL, arms.fL, arms.cL, leftL + rotL:VectorToWorldSpace(leftWrist()), -1, ads, camCF)
	else
		arms.uL.CFrame = hidden; arms.fL.CFrame = hidden; arms.cL.CFrame = hidden; arms.hL.CFrame = hidden
	end
	-- tenue du web (lookMats) : T = treillis sable et gants coyote, CT (et chacun pour soi) = bleu marine et gants noirs
	local myTeam = player:GetAttribute("Team")
	local isT = myTeam == "Attaquants"
	local sleeve = if isT then Color3.fromRGB(169, 148, 104) else Color3.fromRGB(43, 58, 82)
	arms.uR.Color = sleeve; arms.fR.Color = sleeve; arms.uL.Color = sleeve; arms.fL.Color = sleeve
	local cuff = if isT then Color3.fromRGB(74, 74, 50) else Color3.fromRGB(27, 31, 39)
	arms.cR.Color = cuff; arms.cL.Color = cuff
	setGloveColor(if isT then Color3.fromRGB(138, 122, 85) else Color3.fromRGB(21, 24, 29))

	-- éclair de bouche
	local muzzleW = world:PointToWorldSpace(VM.muzzle)
	S.muzzle = muzzleW
	flash.CFrame = CFrame.new(muzzleW)
	local on = VM.flashT > 0 and not w.melee and not VM.noFlash      -- silencieux / cache-flamme : pas de flamme
	flash.Size = Vector3.one * (0.08 + math.random() * 0.06)
	-- lumière de bouche (muzzleLight du web) : pic au départ du coup puis extinction en 50 ms, teinte qui vacille du
	-- blanc chaud à l'orange ; elle se reflète sur le métal de l'arme (SurfaceAppearance de WeaponMaterials)
	local k = math.clamp(VM.flashT / 0.05, 0, 1)
	flashLight.Brightness = if on then 1.5 + 5 * k * k else 0
	if on then flashLight.Color = Color3.fromRGB(255, 200 + math.random(0, 30), 110 + math.random(0, 50)) end
	flash.LocalTransparencyModifier = if on and not scoped then 0.1 else 1
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="841">
        <Properties>
          <string name="Name">WeaponController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/WeaponController (LocalScript)
-- Commandes de tir en vue à la première personne : tir (auto / coup par coup), visée (clic droit), recharge (R),
-- armes 1/2/3 et molette, manette (RT/LT/X/Y) et bouton tactile. Recul de caméra, éclair de bouche, traceurs,
-- impacts et sons. Le serveur (WeaponService) reste la seule référence pour les munitions et les dégâts :
-- le client prédit la munition puis se recale sur AmmoState.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local S = require(ReplicatedStorage.Shared.ClientState)      -- partagé avec MovementController et ViewmodelController
local A = require(ReplicatedStorage.Shared.Attachments)      -- effets des accessoires de l'armurier (recul, zoom, son)

local fireRemote = ReplicatedStorage:WaitForChild("FireWeapon") :: RemoteEvent
local switchRemote = ReplicatedStorage:WaitForChild("SwitchWeapon") :: RemoteEvent
local reloadRemote = ReplicatedStorage:WaitForChild("ReloadWeapon") :: RemoteEvent
local ammoState = ReplicatedStorage:WaitForChild("AmmoState") :: RemoteEvent
local tracerRemote = ReplicatedStorage:WaitForChild("Tracer") :: RemoteEvent

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local BASE_FOV = 70

local W = {
	weapon = nil :: string?, mag = 0, reserve = 0, reloading = false, slot = 1, loadout = {} :: { string },
	nextShot = 0, firing = false, fresh = false, aiming = false, matchLive = true,
	recoilPitch = 0, recoilYaw = 0, appliedPitch = 0, appliedYaw = 0, spray = 0, lastShot = -9, lastPitch = nil :: number?, fov = BASE_FOV, reloadStart = 0, menu = false,
}

-- Mode menu (touche M) : libère la souris en vue à la première personne pour cliquer sur la boutique,
-- le profil ou les caisses. Un bouton « Modal » invisible suffit à Roblox pour débloquer le curseur.
local menuGui = Instance.new("ScreenGui"); menuGui.Name = "MenuCursor"; menuGui.ResetOnSpawn = false; menuGui.Parent = player:WaitForChild("PlayerGui")
local modal = Instance.new("TextButton"); modal.Modal = true; modal.BackgroundTransparency = 1; modal.Text = ""; modal.Size = UDim2.fromOffset(1, 1)
modal.Visible = false; modal.Parent = menuGui

-- ---------- attributs lus par le HUD ----------
local function publish()
	player:SetAttribute("Weapon", W.weapon or "")
	player:SetAttribute("Mag", W.mag)
	player:SetAttribute("Reserve", W.reserve)
	player:SetAttribute("Reloading", W.reloading)
	player:SetAttribute("ReloadStart", W.reloadStart)
	player:SetAttribute("ReloadDur", S.reloadDur)
	player:SetAttribute("Slot", W.slot)
	player:SetAttribute("Loadout", table.concat(W.loadout, ","))
	player:SetAttribute("Aiming", W.aiming)
	S.weapon = W.weapon; S.mag = W.mag; S.reserve = W.reserve; S.aiming = W.aiming
	S.reloading = W.reloading; S.reloadStart = W.reloadStart
end

-- ---------- sons ----------
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local function playSound(def: any, at: Vector3?, vol: number?) Sfx.play(def, at, vol) end

local function fireSound(key: string): any
	local w = Config.WEAPONS[key]
	return ModeConfig.SOUNDS.fire[if w.melee then "melee" else w.cat] or ModeConfig.SOUNDS.fire.rifle
end

-- ---------- effets visuels ----------
-- balle traçante, impacts, trous de balle, sang, flamme et douilles des autres : ShotFx (effets du web)
local ShotFx = require(ReplicatedStorage.Shared.ShotFx)
local function tracer(from: Vector3, to: Vector3, shooter: Player?)
	if (to - from).Magnitude < 1 then return end
	ShotFx.tracer(from, to, ShotFx.trailColor(shooter))     -- traînée cosmétique équipée (boutique)
	ShotFx.impact(from, to)
	Sfx.impact(from, to)                               -- bruit d'impact selon le matériau touché
end

local lastFlash: { [Instance]: number } = setmetatable({}, { __mode = "k" }) :: any
local function muzzleFlash(char: Model?, origin: Vector3, endPos: Vector3)
	-- un seul éclair par coup (le pompe envoie une trajectoire par plomb)
	if char then
		if os.clock() - (lastFlash[char] or -1) < 0.03 then return end
		lastFlash[char] = os.clock()
	end
	local held = char and char:FindFirstChild("HeldWeapon")
	local key = held and held:GetAttribute("Key")
	local noFlash = held ~= nil and typeof(key) == "string" and A.modsOf(A.list(key, A.decode(held:GetAttribute("Att")), nil, true)).noFlash == true
	local muzzle = held and held:FindFirstChild("Muzzle", true)
	local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	if root and math.random() < 0.5 and (root.Position - camera.CFrame.Position).Magnitude < 25 * Config.STUDS_PER_METER then
		ShotFx.shell(origin - Vector3.new(0, 0.2 * Config.STUDS_PER_METER, 0), root.CFrame.RightVector)
	end
	if noFlash then return end                         -- silencieux / cache-flamme : pas de flamme
	-- flamme en étoile et fumée (plus grosse au pompe et au fusil de précision) ; douille une fois sur deux (plus haut)
	local w = typeof(key) == "string" and Config.WEAPONS[key] or nil
	local at = if muzzle and muzzle:IsA("Attachment") then muzzle.WorldPosition elseif muzzle and muzzle:IsA("BasePart") then muzzle.Position else origin
	local dir = endPos - origin
	ShotFx.muzzle(at, dir, w ~= nil and (w.cat == "sniper" or w.cat == "shotgun"))
	if not muzzle then return end
	local light = Instance.new("PointLight"); light.Color = Color3.fromRGB(255, 200, 120); light.Range = 10; light.Brightness = 4
	light.Parent = muzzle
	Debris:AddItem(light, 0.05)
end

-- ---------- état serveur ----------
ammoState.OnClientEvent:Connect(function(info: any)
	local changedWeapon = info.weapon ~= W.weapon
	if info.reloading and not W.reloading then
		W.reloadStart = os.clock()
		-- durée envoyée par le serveur (accessoires, atout Speed Cola…) : l'animation et ses sons finissent avec la recharge
		local w = info.weapon and Config.WEAPONS[info.weapon]
		S.reloadDur = if typeof(info.reloadDur) == "number" then info.reloadDur
			elseif w then w.reload * A.modsOf(A.activeOf(player, info.weapon)).rel else 0
		S.reloadEmpty = W.mag <= 0; S.inspectStart = -1
		S.reload:Fire(info.weapon, S.reloadEmpty)       -- le viewmodel joue l'animation et ses sons (chargeur dehors / dedans)
	end
	W.weapon = info.weapon; W.mag = info.mag; W.reserve = info.reserve; W.reloading = info.reloading
	W.slot = info.slot; W.loadout = info.loadout
	if changedWeapon then W.aiming = false end
	publish()
	if changedWeapon and info.weapon then S.inspectStart = -1; S.draw:Fire(info.weapon) end
end)

tracerRemote.OnClientEvent:Connect(function(origin: Vector3, endPos: Vector3, shooter: Instance?)
	if shooter and shooter == player.Character then return end -- nos propres traceurs sont déjà dessinés
	tracer(origin, endPos, Players:GetPlayerFromCharacter(shooter :: any))
	if shooter then
		local key = shooter:GetAttribute("Weapon")
		if typeof(key) == "string" and Config.WEAPONS[key] then
			local held = shooter:FindFirstChild("HeldWeapon")
			local m = A.modsOf(A.list(key, A.decode(held and held:GetAttribute("Att")), nil, true))
			playSound(fireSound(key), origin, m.snd)          -- silencieux : tir à 35 % du volume
			Sfx.bulletPass(origin, endPos, Config.WEAPONS[key].cat)   -- claquement si la balle frôle la caméra
		end
		muzzleFlash(shooter :: Model, origin, endPos)
	end
end)

local stateRemote = ReplicatedStorage:WaitForChild("TDMState", 5) :: RemoteEvent?
if stateRemote then
	stateRemote.OnClientEvent:Connect(function(st: any) W.matchLive = st.state == "live" end)
end

-- ---------- tir ----------
-- motif de recul du web (recoilPat de 60_game.js) : montée, oscillation et dérive propres à chaque arme
local RECP: { [string]: any } = {}
local RECBASE = { pistol = { 1.6, .03, .35, .5 }, smg = { 1.4, .05, .45, .55 }, rifle = { 1.9, .075, .55, .45 }, lmg = { 1.7, .06, .4, .6 },
	sniper = { 2.4, 0, .15, .2 }, shotgun = { 2.2, 0, .2, .3 } }
local function recoilPat(k: string): any
	if RECP[k] then return RECP[k] end
	local h = 0
	for i = 1, #k do h = (h * 31 + string.byte(k, i)) % 4294967296 end
	local function r(i: number): number return bit32.band(bit32.rshift(h, i * 3), 7) / 7 end
	local w = Config.WEAPONS[k]
	local b = (w and RECBASE[w.cat]) or { 1.9, .07, .5, .5 }
	local p = { up = b[1] * (.85 + r(1) * .3), climb = b[2], a = b[3] * (.7 + r(2) * .6), f = .45 + r(3) * .5, ph = r(4) * 6,
		kick = 5 + math.round(r(5) * 5), drift = (r(6) - .5) * 2, jit = b[4] }
	RECP[k] = p
	return p
end

local function alive(): boolean
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0
end
-- une scène tient la caméra (kill-cam, arrivée) ou un panneau est ouvert (pause, boutique, mode photo…) :
-- les touches de l'arme ne font rien (R, V, molette, visée)
local function busy(): boolean
	return S.kc ~= nil or player:GetAttribute("UiOpen") == true
end

local function tryFire()
	local key = W.weapon
	-- la pause entre deux parties ne bloque que les joueurs du match (pas le lobby ni les duels)
	local blocked = not W.matchLive and player:GetAttribute("Zone") == "match"
	if not key or not alive() or blocked or W.menu or busy() then return end
	-- on ne tire pas en sprintant ni pendant une escalade ; à la sortie du sprint l'arme met un instant à revenir
	if S.sprint or S.mantle or os.clock() < S.fireBlockedUntil or os.clock() < S.drinkUntil then return end
	local w = Config.WEAPONS[key]
	if not w.auto and not W.fresh then return end
	local t = os.clock()
	if t < W.nextShot or W.reloading then return end
	if not w.melee and W.mag <= 0 then
		if W.fresh then playSound(ModeConfig.SOUNDS.empty) end
		W.fresh = false
		if W.reserve > 0 then reloadRemote:FireServer() end
		return
	end
	W.fresh = false
	local rateMult = player.Character and player.Character:GetAttribute("RateMult")    -- Zombies : Double Détente
	W.nextShot = t + 60 / (w.rpm * (if typeof(rateMult) == "number" then rateMult else 1))
	local cf = camera.CFrame
	fireRemote:FireServer(cf.Position, cf.LookVector, W.aiming)
	if not w.melee then
		W.mag -= 1
		local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
		params.FilterDescendantsInstances = { player.Character :: Instance }
		local r = workspace:Raycast(cf.Position, cf.LookVector * 400, params)
		local muzzle = S.muzzle or (cf.Position + cf.LookVector * 1.5 - cf.UpVector * 0.4 + cf.RightVector * 0.5)
		tracer(muzzle, if r then r.Position else cf.Position + cf.LookVector * 400, player)
	end
	S.inspectStart = -1
	S.shot:Fire(key)                                   -- recul de l'arme, éclair et douille dans le viewmodel
	local m = A.modsOf(A.activeOf(player, key))
	playSound(fireSound(key), nil, m.snd)
	-- recul du web : décalage de visée qui monte avec la rafale puis revient au centre
	W.spray = math.min(W.spray + 1, 30); W.lastShot = t
	local rp, n = recoilPat(key), W.spray
	local pat = (math.sin(n * rp.f + rp.ph) * rp.a + (if n > rp.kick then rp.drift * (n - rp.kick) * .12 else 0)) * w.recoil
	W.recoilPitch += w.recoil * m.rec * (rp.up + math.min(n, 12) * rp.climb) * (if W.aiming then 0.75 else 1)
	W.recoilYaw -= (pat + (math.random() - .5) * w.recoil * rp.jit) * m.rec * m.recH
	publish()
end

-- ---------- commandes (clavier/souris, manette, tactile) ----------
local function onFire(_: string, st: Enum.UserInputState)
	if st == Enum.UserInputState.Begin then W.firing = true; W.fresh = true
	elseif st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then W.firing = false end
	S.firing = W.firing                                -- coupe le sprint (MovementController), souris, manette ou tactile
	return Enum.ContextActionResult.Sink
end
local function onAim(_: string, st: Enum.UserInputState)
	local key = W.weapon
	if not key or Config.WEAPONS[key].melee then return Enum.ContextActionResult.Pass end
	W.aiming = st == Enum.UserInputState.Begin and os.clock() >= S.drinkUntil and not busy() and not W.menu   -- pas de visée pendant la boisson d'atout
	publish()
	return Enum.ContextActionResult.Sink
end
local function onInspect(_: string, st: Enum.UserInputState)
	if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if W.weapon and not W.reloading and not W.aiming and alive() and not busy() then
		S.inspectStart = if S.inspectStart > 0 then -1 else os.clock()     -- 2e appui : on arrête l'inspection
	end
	return Enum.ContextActionResult.Sink
end
local function onReload(_: string, st: Enum.UserInputState)
	if st == Enum.UserInputState.Begin and alive() and not busy() then reloadRemote:FireServer() end
	return Enum.ContextActionResult.Sink
end
local function switchTo(slot: number)
	if slot < 1 or slot > #W.loadout or slot == W.slot then return end
	W.aiming = false
	switchRemote:FireServer(slot)
end
local function onSwitch(name: string, st: Enum.UserInputState, input: InputObject)
	if st ~= Enum.UserInputState.Begin and input.UserInputType ~= Enum.UserInputType.MouseWheel then return Enum.ContextActionResult.Pass end
	-- molette dans une liste de la boutique ou du menu (curseur libre) : on fait défiler, on ne change pas d'arme
	if busy() or W.menu then return Enum.ContextActionResult.Pass end
	if name == "Slot1" then switchTo(1) elseif name == "Slot2" then switchTo(2) elseif name == "Slot3" then switchTo(3)
	elseif name == "NextWeapon" then
		local dir = if input.UserInputType == Enum.UserInputType.MouseWheel and input.Position.Z > 0 then -1 else 1
		local n = math.max(1, #W.loadout)
		switchTo((W.slot - 1 + dir) % n + 1)
	end
	return Enum.ContextActionResult.Sink
end

local function onMenu(_: string, st: Enum.UserInputState)
	if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	W.menu = not W.menu; W.firing = false; W.aiming = false
	modal.Visible = W.menu
	player:SetAttribute("MenuOpen", W.menu)
	publish()
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("Menu", onMenu, false, Enum.KeyCode.M, Enum.KeyCode.ButtonStart)
ContextActionService:BindAction("Fire", onFire, true, Enum.UserInputType.MouseButton1, Enum.KeyCode.ButtonR2)
ContextActionService:BindAction("Aim", onAim, true, Enum.UserInputType.MouseButton2, Enum.KeyCode.ButtonL2)
ContextActionService:BindAction("Reload", onReload, true, Enum.KeyCode.R, Enum.KeyCode.ButtonX)
ContextActionService:BindAction("Inspect", onInspect, false, Enum.KeyCode.V, Enum.KeyCode.DPadUp)
ContextActionService:BindAction("Slot1", onSwitch, false, Enum.KeyCode.One)
ContextActionService:BindAction("Slot2", onSwitch, false, Enum.KeyCode.Two)
ContextActionService:BindAction("Slot3", onSwitch, false, Enum.KeyCode.Three)
ContextActionService:BindAction("NextWeapon", onSwitch, true, Enum.UserInputType.MouseWheel, Enum.KeyCode.ButtonY)
ContextActionService:SetTitle("Fire", "Tir"); ContextActionService:SetTitle("Aim", "Viser")
ContextActionService:SetTitle("Reload", "R"); ContextActionService:SetTitle("NextWeapon", "Arme")
ContextActionService:SetPosition("Fire", UDim2.new(1, -150, 1, -190))

-- ---------- caméra : première personne, visée, recul ----------
player.CameraMode = Enum.CameraMode.LockFirstPerson
local baseSens = UserInputService.MouseDeltaSensitivity

RunService.RenderStepped:Connect(function()
	-- visée lâchée quand un panneau s'ouvre ou qu'une boisson d'atout commence en pleine visée
	if W.aiming and (busy() or os.clock() < S.drinkUntil) then W.aiming = false; publish() end
	if W.firing then tryFire() end
end)

RunService:BindToRenderStep("WeaponCamera", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	if S.kc then W.lastPitch = nil; return end   -- la kill-cam tient la caméra
	local key = W.weapon
	local w = key and Config.WEAPONS[key]
	-- zoom du web : champ / lerp(1, zoom du viseur, visée) ; sensibilité 1/zoom à la lunette, −25 % en visée sinon,
	-- × « sensibilité en visée » (menu Réglages, ou attribut AdsSens) comme src/8Zf_confort.js ; champ choisi dans les Réglages
	local base = S.opt.fov
	local ads = if w and not w.melee then S.adsT else 0
	local att = if key then A.activeOf(player, key) else {}
	local zoom = if key and w and not w.melee then A.sightZoom(key, A.modsOf(att)) else 1
	local targetFov = base / (1 + (zoom - 1) * ads)
	W.fov += (targetFov - W.fov) * math.min(1, dt * 18)
	camera.FieldOfView = W.fov
	local scoped = key ~= nil and ads > 0.92 and A.sightOv(key, att)
	local adsSens = player:GetAttribute("AdsSens")
	local aimS = (if typeof(adsSens) == "number" then adsSens else 1) * S.opt.aimSens
	local am = 1 + (aimS - 1) * math.clamp(ads, 0, 1)
	UserInputService.MouseDeltaSensitivity = baseSens * S.opt.sens * S.opt.wsens * (if scoped then 1 / zoom else 1 - .25 * ads) * am
	-- le recul est un décalage visuel ajouté après la caméra Roblox, qui revient tout seul
	-- La caméra Roblox repart de la direction de la frame précédente : on n'ajoute donc que la différence,
	-- sinon chaque frame recopiait tout le recul et la visée partait au plafond.
	local now = os.clock()
	local dr = if now - W.lastShot < .2 then 3.5 else 9
	W.recoilPitch -= W.recoilPitch * math.min(1, dt * dr); W.recoilYaw -= W.recoilYaw * math.min(1, dt * dr)
	if now - W.lastShot > .25 then W.spray = math.max(0, W.spray - dt * 18) end
	local dP, dY = W.recoilPitch - W.appliedPitch, W.recoilYaw - W.appliedYaw
	W.appliedPitch, W.appliedYaw = W.recoilPitch, W.recoilYaw
	-- axe vertical inversé (Options) : on renverse ce que la caméra Roblox vient de tourner en hauteur cette frame
	local pitchNow = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
	if S.opt.invertY and W.lastPitch and camera.CameraType == Enum.CameraType.Custom then
		local moved = pitchNow - W.lastPitch
		local target = math.clamp(W.lastPitch - moved, -1.35, 1.35)
		dP += math.deg(target - pitchNow)
	end
	camera.CFrame = camera.CFrame * CFrame.Angles(math.rad(dP), math.rad(dY), 0)
	W.lastPitch = math.asin(math.clamp(camera.CFrame.LookVector.Y, -1, 1))
	UserInputService.MouseIconEnabled = W.menu or player:GetAttribute("UiOpen") == true   -- panneaux Codes / Groupe du lobby
end)

player.CharacterAdded:Connect(function()
	W.firing = false; W.aiming = false; W.recoilPitch = 0; W.recoilYaw = 0; W.appliedPitch = 0; W.appliedYaw = 0; W.spray = 0; W.lastPitch = nil
	player.CameraMode = Enum.CameraMode.LockFirstPerson
	publish()
end)
publish()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="842">
        <Properties>
          <string name="Name">WeaponVisuals</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/WeaponVisuals (LocalScript)
-- Arme vue en 3e personne (autres joueurs et bots) : le serveur ne pose qu'une poignée invisible « HeldWeapon » ;
-- ici on y soude la vraie arme du jeu web, fabriquée localement par WeaponModels. Notre propre arme est dans le viewmodel.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local A = require(ReplicatedStorage.Shared.Attachments)
local WORLD_SCALE = 2.9          -- même valeur que WeaponService

local player = Players.LocalPlayer

local function dress(held: Instance)
	if not held:IsA("BasePart") or held:GetAttribute("Custom") == true then return end
	local key = held:GetAttribute("Key")
	if typeof(key) ~= "string" then return end
	local char = held.Parent
	if char == player.Character then return end
	task.defer(function()
		if not held.Parent then return end
		-- accessoires de l'armurier (attribut Att de la poignée) et réticules du propriétaire
		local owner = Players:GetPlayerFromCharacter(char :: any)
		local att = A.list(key, A.decode(held:GetAttribute("Att")), nil, true)
		local ok, model = pcall(WeaponModels.build, key, WORLD_SCALE, att, { ret = function(o: string) return A.retOf(o, owner) end })
		if not ok or not model then warn("[WeaponVisuals]", key, model) return end
		WeaponModels.weldTo(model, held :: BasePart, (held :: BasePart).CFrame)
		SkinPaint.apply(model, held:GetAttribute("Skin") :: number?, held:GetAttribute("Camo") :: string?)
		model.Parent = held
	end)
end

workspace.DescendantAdded:Connect(function(d)
	if d.Name == "HeldWeapon" then dress(d) end
end)
for _, d in ipairs(workspace:GetDescendants()) do
	if d.Name == "HeldWeapon" then dress(d) end
end
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="843">
        <Properties>
          <string name="Name">WeatherController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/WeatherController (LocalScript)
-- Pluie (ParticleEmitter qui suit la caméra), éclairs (flash + tonnerre) selon l'attribut Workspace.Weather.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local SoundService = game:GetService("SoundService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Sfx = require(ReplicatedStorage.Shared.Sfx)

local camera = workspace.CurrentCamera

local rainPart = Instance.new("Part")
-- ignorée des rayons (tirs, caméra, viseur) et des ombres : sinon on tirait dans un plafond invisible 30 studs au-dessus
rainPart.Anchored = true; rainPart.CanCollide = false; rainPart.CanQuery = false; rainPart.CanTouch = false; rainPart.CastShadow = false
rainPart.Transparency = 1; rainPart.Size = Vector3.new(60, 1, 60); rainPart.Name = "Pluie"
local rain = Instance.new("ParticleEmitter")
rain.Texture = "rbxasset://textures/particles/sparkles_main.dds"; rain.Rate = 0; rain.Lifetime = NumberRange.new(1.2)
rain.Speed = NumberRange.new(90); rain.EmissionDirection = Enum.NormalId.Bottom; rain.Size = NumberSequence.new(0.1, 0.1)
rain.Transparency = NumberSequence.new(0.5); rain.Color = ColorSequence.new(Color3.fromRGB(180, 200, 225)); rain.Orientation = Enum.ParticleOrientation.VelocityParallel
rain.Parent = rainPart; rainPart.Parent = workspace

-- son de pluie en boucle : seulement si un numéro est donné (un Sound à rbxassetid://0 remplit la Sortie d'erreurs)
local RAIN_ID = 0
local rainSound: Sound? = nil
if RAIN_ID ~= 0 then
	local s = Instance.new("Sound")
	s.SoundId = "rbxassetid://" .. RAIN_ID; s.Looped = true; s.Volume = 0.35; s.Parent = SoundService
	rainSound = s
end

local function refresh()
	local w = workspace:GetAttribute("Weather")
	local raining = w == "rain" or w == "storm"
	rain.Rate = if w == "storm" then 900 elseif raining then 450 else 0
	local rs = rainSound
	if rs then
		if raining and not rs.IsPlaying then rs:Play() elseif not raining then rs:Stop() end
	end
end
workspace:GetAttributeChangedSignal("Weather"):Connect(refresh)
refresh()

local nextLightning = os.clock() + 8
RunService.RenderStepped:Connect(function()
	local cam = workspace.CurrentCamera or camera
	rainPart.CFrame = CFrame.new(cam.CFrame.Position + Vector3.new(0, 30, 0))
	if workspace:GetAttribute("Weather") == "storm" and os.clock() > nextLightning then
		nextLightning = os.clock() + 7 + math.random() * 9
		local old = Lighting.Brightness
		Lighting.Brightness = old + 3
		task.delay(0.1, function() Lighting.Brightness = old + 1 end)
		task.delay(0.22, function() Lighting.Brightness = old end)
		task.delay(0.3 + math.random() * 1.2, function() Sfx.play({ sheet = "boom" }, nil, 0.7) end)   -- tonnerre : explosion lointaine de la planche
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="844">
        <Properties>
          <string name="Name">ZombieBrHud</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/ZombieBrHud (LocalScript)
-- Ce que voit le joueur en Zombies et en Bataille royale (web : zHud / zHudUpdate de src/69_zombies.js, zDownUpdate de
-- src/69z_extra.js, brUpdate / variantRadar de src/61_variants.js, orage de src/42_haunt.js) :
--   Zombies : numéro de manche « Black Ops » (bâtons rouges), points (+gains), atouts bus, bonus actifs, écran « À TERRE »,
--             textes des invites (E) selon ce que le joueur possède, contenu de la boîte mystère.
--   Bataille royale : mur de la zone, alerte hors zone, cercle de la zone sur le radar, armes posées au sol.
--   Asile hanté : éclairs et tonnerre par-dessus l'éclairage de la carte (MapDetailController).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ProximityPromptService = game:GetService("ProximityPromptService")

local Config = require(ReplicatedStorage.Shared.Config)
local Z = require(ReplicatedStorage.Shared.ZombieConfig)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local Sfx = require(ReplicatedStorage.Shared.Sfx)


local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local U = Config.STUDS_PER_METER
local RADAR, RANGE = 184, 31 * U  -- mêmes valeurs que le radar de HudController

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local i = Instance.new(class)
	for k, v in pairs(props) do (i :: any)[k] = v end
	if parent then i.Parent = parent end
	return i
end
local function fmtPts(n: number): string
	local s = tostring(math.floor(n))
	local out = s:reverse():gsub("(%d%d%d)", "%1 "):reverse()
	return (out:gsub("^%s+", ""))
end

local gui = make("ScreenGui", { Name = "ZombieBrHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 11 }, player:WaitForChild("PlayerGui"))

-- ---------- Zombies : manche, points, atouts, bonus (bas gauche, au-dessus de la vie) ----------
local zRoot = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 26, 1, -170), Size = UDim2.fromOffset(320, 190), BackgroundTransparency = 1, Visible = false }, gui)
local zRound = make("TextLabel", { Size = UDim2.fromOffset(320, 72), BackgroundTransparency = 1, Font = Enum.Font.Antique, TextSize = 68, Text = "",
	TextColor3 = Color3.fromRGB(179, 18, 27), TextStrokeColor3 = Color3.fromRGB(48, 0, 0), TextStrokeTransparency = 0.2, TextXAlignment = Enum.TextXAlignment.Left }, zRoot)
local zPts = make("TextLabel", { Position = UDim2.fromOffset(0, 76), Size = UDim2.fromOffset(200, 32), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 26,
	Text = "0", TextColor3 = Color3.fromRGB(255, 215, 94), TextStrokeTransparency = 0.4, TextXAlignment = Enum.TextXAlignment.Left }, zRoot)
local zPerks = make("Frame", { Position = UDim2.fromOffset(0, 112), Size = UDim2.fromOffset(320, 34), BackgroundTransparency = 1 }, zRoot)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, zPerks)
local zFx = make("TextLabel", { Position = UDim2.fromOffset(0, 150), Size = UDim2.fromOffset(320, 40), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 13,
	Text = "", RichText = true, TextColor3 = Color3.new(1, 1, 1), TextStrokeTransparency = 0.5, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top }, zRoot)

local function gain(n: number)
	local l = make("TextLabel", { Position = UDim2.fromOffset(zPts.TextBounds.X + 10, 76), Size = UDim2.fromOffset(80, 20), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack, TextSize = 16, Text = "+" .. n, TextColor3 = Color3.fromRGB(255, 233, 160), TextStrokeTransparency = 0.5,
		TextXAlignment = Enum.TextXAlignment.Left }, zRoot)
	local t0 = os.clock()
	local conn: RBXScriptConnection
	conn = RunService.RenderStepped:Connect(function()
		local k = (os.clock() - t0) / 0.9
		if k >= 1 then conn:Disconnect(); l:Destroy(); return end
		l.Position = UDim2.fromOffset(zPts.TextBounds.X + 10 + k * 26, 76 - k * 26)
		l.TextTransparency = k; l.TextStrokeTransparency = 0.5 + k * 0.5
	end)
end
local gainRemote = ReplicatedStorage:WaitForChild("ZombieGain", 30) :: RemoteEvent?
if gainRemote then gainRemote.OnClientEvent:Connect(function(n: number) if typeof(n) == "number" then gain(n) end end) end

local function drawPerks()
	for _, c in ipairs(zPerks:GetChildren()) do if c:IsA("TextLabel") then c:Destroy() end end
	local v = player:GetAttribute("ZPerks")
	if typeof(v) ~= "string" or v == "" then return end
	for k in v:gmatch("[^,]+") do
		local p = Z.PERKS[k]
		if p then
			local i = make("TextLabel", { Size = UDim2.fromOffset(34, 34), BackgroundColor3 = p.c, Font = Enum.Font.GothamBlack, TextSize = 15, Text = p.ic, TextColor3 = Color3.new(1, 1, 1) }, zPerks)
			make("UICorner", { CornerRadius = UDim.new(1, 0) }, i)
			make("UIStroke", { Color = Color3.new(1, 1, 1), Transparency = 0.6, Thickness = 2 }, i)
		end
	end
end
player:GetAttributeChangedSignal("ZPerks"):Connect(drawPerks)

-- « À TERRE » au centre
local downLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.3), Size = UDim2.fromOffset(600, 80), BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack, TextSize = 32, RichText = true, Text = "", TextColor3 = Color3.fromRGB(255, 70, 85), TextStrokeTransparency = 0.3, Visible = false }, gui)
local downVeil = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.fromRGB(120, 0, 0), BackgroundTransparency = 0.75, Visible = false, ZIndex = 0 }, gui)

-- ---------- Bataille royale : alerte hors zone ----------
local outLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.fromScale(0.5, 0.2), Size = UDim2.fromOffset(600, 34), BackgroundTransparency = 1,
	Font = Enum.Font.GothamBlack, TextSize = 24, Text = "⚠ VOUS ÊTES HORS DE LA ZONE", TextColor3 = Color3.fromRGB(255, 80, 80), TextStrokeTransparency = 0.3, Visible = false }, gui)

-- ==========================================================================================
-- État de la partie
-- ==========================================================================================
local st: any = nil
local function myFolder(): Instance?
	local n = player:GetAttribute("MatchMap")
	return if typeof(n) == "string" then workspace:FindFirstChild(n) else nil
end
local function inMatch(): boolean
	return player:GetAttribute("Zone") == "match" and st ~= nil and st.id == player:GetAttribute("MatchId")
end
local stateRemote = ReplicatedStorage:WaitForChild("TDMState") :: RemoteEvent
stateRemote.OnClientEvent:Connect(function(s: any)
	st = s
	-- armes prodiges connues du client (tir, viewmodel) dès la première partie Zombies, pas avant (menus, boutique)
	if s and s.mode == "zombies" then Z.registerWeapons() end
end)

-- ==========================================================================================
-- Invites (touche E) : texte selon ce que possède le joueur (zInteractFor du web)
-- ==========================================================================================
local shown: { [ProximityPrompt]: boolean } = {}
local function has(attr: string, key: string): boolean
	local v = player:GetAttribute(attr)
	if typeof(v) ~= "string" then return false end
	for k in v:gmatch("[^,]+") do if k == key then return true end end
	return false
end
local function wname(k: string?): string
	local w = k and Config.WEAPONS[k]
	return if w then w.name else (k or "?")
end
local function refreshPrompt(pp: ProximityPrompt)
	local kind = pp:GetAttribute("ZKind")
	if kind == "wall" then
		local key, price = pp:GetAttribute("Weapon") :: string, pp:GetAttribute("Price") :: number
		local own = has("ZOwn", key)
		pp.ActionText = (if own then "Munitions " else "Acheter ") .. wname(key) .. " — " .. (if own then math.floor(price / 2 + 0.5) else price) .. " pts"
	elseif kind == "box" then
		local box = pp:FindFirstAncestorOfClass("Model")
		local state = box and box:GetAttribute("BoxState")
		local price = (st and st.data and st.data.z and st.data.z.boxPrice) or Z.BOX_PRICE
		if state == "idle" then pp.ActionText = "Boîte mystère — " .. price .. " pts"; pp.Enabled = true
		elseif state == "ready" and box and box:GetAttribute("BoxOwner") == player.UserId then pp.ActionText = "Prendre " .. wname(box:GetAttribute("BoxWeapon") :: string?); pp.Enabled = true
		else pp.ActionText = "Boîte mystère…" end
	elseif kind == "perk" then
		local key = pp:GetAttribute("Perk") :: string
		local p = Z.PERKS[key]
		if p then pp.ActionText = if has("ZPerks", key) then p.n .. " (déjà bu)" else p.n .. " — " .. p.price .. " pts" end
	elseif kind == "pap" then
		local w = player.Character and player.Character:GetAttribute("Weapon")
		if typeof(w) ~= "string" or w == "knife" then pp.ActionText = "Forge Arcane : prends une arme en main"
		elseif has("ZPap", w) then pp.ActionText = wname(w) .. " est déjà améliorée"
		else pp.ActionText = "Forge Arcane : améliorer " .. wname(w) .. " — " .. Z.PAP_PRICE .. " pts" end
	elseif kind == "revive" then
		-- pas d'invite sur soi-même ; Second Souffle : réanimation 2× plus rapide
		local char = player.Character
		if char and pp:IsDescendantOf(char) then pp.Enabled = false; return end
		pp.HoldDuration = if has("ZPerks", "revive") then 1.5 else 3
		pp.ActionText = "Maintiens : réanimer"
	end
end
ProximityPromptService.PromptShown:Connect(function(pp: ProximityPrompt)
	if pp:GetAttribute("ZKind") then shown[pp] = true; refreshPrompt(pp) end
end)
ProximityPromptService.PromptHidden:Connect(function(pp: ProximityPrompt) shown[pp] = nil end)
-- l'invite de réanimation n'apparaît jamais sur soi
workspace.DescendantAdded:Connect(function(d: Instance)
	if d:IsA("ProximityPrompt") and d:GetAttribute("ZKind") == "revive" then
		task.defer(function() local c = player.Character; if c and d:IsDescendantOf(c) then d.Enabled = false end end)
	end
end)

-- ==========================================================================================
-- Boîte mystère : armes qui défilent, puis l'arme tirée (ou le nounours)
-- ==========================================================================================
local SHOW_SCALE = 2.9 * 1.5
local boxShow: Model? = nil
local boxShowKey: string? = nil
local lastSwap = 0
local function setShow(key: string?)
	if boxShowKey == key and boxShow then return end
	if boxShow then boxShow:Destroy(); boxShow = nil end
	boxShowKey = key
	if not key then return end
	if key == "teddy" then
		local m = Instance.new("Model")
		local fur = Color3.fromRGB(138, 90, 53)
		local function ball(name: string, d: number, off: Vector3)
			local p = make("Part", { Name = name, Shape = Enum.PartType.Ball, Size = Vector3.new(d, d, d) * U, Color = fur, Material = Enum.Material.Fabric, Anchored = true,
				CanCollide = false, CanQuery = false, CastShadow = false }, m)
			p:SetAttribute("Off", off * U)
		end
		ball("Body", 0.36, Vector3.new(0, 0, 0)); ball("Head", 0.26, Vector3.new(0, 0.27, 0)); ball("EarL", 0.1, Vector3.new(-0.1, 0.38, 0)); ball("EarR", 0.1, Vector3.new(0.1, 0.38, 0))
		m.Parent = workspace
		boxShow = m
		return
	end
	local ok, model = pcall(WeaponModels.build, key, SHOW_SCALE)
	if ok and model then model.Parent = workspace; boxShow = model end
end
local function updateBox(folder: Instance)
	local z = folder:FindFirstChild("Zombies")
	local box = z and z:FindFirstChild("MysteryBox") :: Model?
	local base = box and box:FindFirstChild("Base") :: BasePart?
	local lid = box and box:FindFirstChild("Lid") :: BasePart?
	if not box or not base then setShow(nil); return end
	local state = box:GetAttribute("BoxState")
	local t0 = box:GetAttribute("BoxT")
	local t = workspace:GetServerTimeNow() - (if typeof(t0) == "number" then t0 else 0)
	if lid then
		local closed = lid:GetAttribute("Closed")
		if typeof(closed) == "CFrame" then
			local hinge = closed * CFrame.new(0, 0, 0.385 * U)
			lid.CFrame = if state == "idle" then closed else hinge * CFrame.Angles(math.rad(70), 0, 0) * CFrame.new(0, 0, -0.385 * U)
		end
	end
	local y = 0.8
	if state == "roll" then
		if os.clock() - lastSwap > 0.08 + t * 0.06 and t < 4 then
			lastSwap = os.clock()
			setShow(Z.BOXPOOL[math.random(#Z.BOXPOOL)])
		end
		y = 0.8 + math.min(1, t / 4) * 0.6
	elseif state == "ready" then
		local k = box:GetAttribute("BoxWeapon")
		setShow(if typeof(k) == "string" then k else nil)
		y = 1.4 - math.min(0.6, (t - 4.2) / 9 * 0.6)
	elseif state == "teddy" then
		setShow("teddy")
		y = 1.4 + math.max(0, t - 4.2) * 1.4
	else
		setShow(nil)
	end
	if boxShow then
		local cf = CFrame.new(base.Position + Vector3.new(0, (y - 0.31) * U, 0)) * CFrame.Angles(0, os.clock() * (if state == "teddy" then 3 else 0.6), 0)
		if boxShowKey == "teddy" then
			for _, p in ipairs(boxShow:GetChildren()) do
				local off = p:GetAttribute("Off")
				if p:IsA("BasePart") and typeof(off) == "Vector3" then p.CFrame = cf * CFrame.new(off) end
			end
		else
			WeaponModels.place(boxShow, cf * CFrame.Angles(0, math.rad(90), 0))
		end
	end
end

-- ==========================================================================================
-- Bataille royale : mur de la zone (panneaux fins visibles des deux côtés), armes au sol
-- ==========================================================================================
local SEG = 48
local wall: { BasePart } = {}
local wallFolder: Folder? = nil
local zoneC, zoneR = Vector3.zero, 0
local function ensureWall()
	if wallFolder and wallFolder.Parent then return end
	local f = Instance.new("Folder"); f.Name = "BrZoneWall"
	wall = {}
	for i = 1, SEG do
		wall[i] = make("Part", { Name = "Wall", Anchored = true, CanCollide = false, CanQuery = false, CanTouch = false, CastShadow = false, Material = Enum.Material.Neon,
			Color = Z.ZONE_COLOR, Transparency = 0.8, Size = Vector3.new(1, 14 * U, 0.2) }, f)
	end
	f.Parent = workspace
	wallFolder = f
end
local function dropWall()
	if wallFolder then wallFolder:Destroy(); wallFolder = nil end
	wall = {}
	zoneR = 0
end
local function updateWall(br: any, dt: number, pulse: number)
	ensureWall()
	local target = Vector3.new(br.x, 0, br.z)
	if zoneR <= 0 then zoneC, zoneR = target, br.r end
	local k = math.min(1, dt * 2.5)
	zoneC = zoneC:Lerp(target, k); zoneR += (br.r - zoneR) * k
	local folder = myFolder()
	local origin = folder and folder:GetAttribute("Origin")
	local y0 = if typeof(origin) == "Vector3" then origin.Y else 0
	local r = math.max(0.05, zoneR)
	local w = 2 * math.pi * r / SEG * 1.02
	local parts, cfs = {}, {}
	for i = 1, SEG do
		local a = (i - 0.5) / SEG * math.pi * 2
		local p = Vector3.new(zoneC.X + math.cos(a) * r, y0 + 7 * U, zoneC.Z + math.sin(a) * r)
		wall[i].Size = Vector3.new(w, 14 * U, 0.2)
		wall[i].Transparency = 0.8 + pulse * 0.04
		table.insert(parts, wall[i]); table.insert(cfs, CFrame.lookAt(p, Vector3.new(zoneC.X, p.Y, zoneC.Z)))
	end
	workspace:BulkMoveTo(parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
end

local lootModels: { [Instance]: Model } = {}
local function updateLoot(folder: Instance)
	local brf = folder:FindFirstChild("BattleRoyale")
	if not brf then return end
	local t = os.clock()
	for _, it in ipairs(brf:GetChildren()) do
		local key = it:GetAttribute("LootKey")
		local core: BasePart? = if it:IsA("Model") then it.PrimaryPart else nil
		if typeof(key) == "string" and core then
			local gm = lootModels[it]
			if not gm then
				local ok, model = pcall(WeaponModels.build, key, 2.9 * 1.15)
				if ok and model then model.Parent = it; lootModels[it] = model; gm = model end
			end
			if gm then WeaponModels.place(gm, CFrame.new(core.Position) * CFrame.Angles(0, t * 1.6, 0)) end
		end
	end
	for it, gm in pairs(lootModels) do if not it.Parent then gm:Destroy(); lootModels[it] = nil end end
end

-- cercle de la zone sur le radar de HudController (cadre « Radar »)
local radarRing: Frame? = nil
local function radarFrame(): Frame?
	local hud = player.PlayerGui:FindFirstChild("MatchHud")
	return hud and hud:FindFirstChild("Radar", true) :: Frame?
end
local function updateRadar(show: boolean)
	local rf = radarFrame()
	if not show or not rf then if radarRing then radarRing.Visible = false end return end
	if not radarRing or radarRing.Parent ~= rf then
		if radarRing then radarRing:Destroy() end
		local f = make("Frame", { Name = "ZoneRing", AnchorPoint = Vector2.new(0.5, 0.5), BackgroundTransparency = 1, ZIndex = 4 }, rf)
		make("UICorner", { CornerRadius = UDim.new(1, 0) }, f)
		make("UIStroke", { Color = Z.ZONE_COLOR, Thickness = 3 }, f)
		radarRing = f
	end
	local ring = radarRing :: Frame
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then ring.Visible = false; return end
	local look = camera.CFrame.LookVector
	local fwd = Vector3.new(look.X, 0, look.Z)
	if fwd.Magnitude < 1e-3 then fwd = Vector3.new(0, 0, -1) end
	fwd = fwd.Unit
	local right = Vector3.new(-fwd.Z, 0, fwd.X)
	local half = RADAR / 2
	local pps = half / RANGE
	local d = Vector3.new(zoneC.X - root.Position.X, 0, zoneC.Z - root.Position.Z)
	ring.Visible = true
	ring.Position = UDim2.fromOffset(half + d:Dot(right) * pps, half - d:Dot(fwd) * pps)
	ring.Size = UDim2.fromOffset(2 * zoneR * pps, 2 * zoneR * pps)
end

-- ==========================================================================================
-- Asile hanté : éclairs (flash bleuté) puis tonnerre
-- ==========================================================================================
local nextFlash = -1
local function storm()
	local t = os.clock()
	if nextFlash < 0 then nextFlash = t + 6 + math.random() * 8 end
	if t < nextFlash then return end
	nextFlash = t + 9 + math.random() * 13
	local old = Lighting.Brightness
	local oldShift = Lighting.ColorShift_Top
	Lighting.Brightness = old + 3.2; Lighting.ColorShift_Top = Color3.fromRGB(191, 212, 255)
	task.delay(0.08, function() Lighting.Brightness = old + 0.4 end)
	task.delay(0.16, function() Lighting.Brightness = old + 2.4 end)
	task.delay(0.24, function() Lighting.Brightness = old + 1 end)
	task.delay(0.45, function() Lighting.Brightness = old; Lighting.ColorShift_Top = oldShift end)
	task.delay(0.6 + math.random() * 1.6, function() pcall(function() Sfx.play("boom", nil, 0.35) end) end)
end

-- ==========================================================================================
-- Boucle
-- ==========================================================================================
RunService.RenderStepped:Connect(function(dt: number)
	local live = inMatch()
	local mode = if live then st.mode else nil
	local data = live and st.data or nil
	local folder = if live then myFolder() else nil
	-- Zombies
	local zd = data and data.z
	zRoot.Visible = mode == "zombies" and zd ~= nil
	if mode == "zombies" and zd then
		zRound.Text = Z.tally(zd.wave)
		local pts = player:GetAttribute("ZPts")
		zPts.Text = fmtPts(if typeof(pts) == "number" then pts else 0)
		local fx = {}
		if zd.insta > 0 then table.insert(fx, '<font color="#ff3a3a">☠ MORT INSTANTANÉE ' .. zd.insta .. "</font>") end
		if zd.dbl > 0 then table.insert(fx, '<font color="#ffd23a">×2 POINTS ' .. zd.dbl .. "</font>") end
		if zd.fire > 0 then table.insert(fx, '<font color="#7fe0ff">$ VENTE DE FEU ' .. zd.fire .. "</font>") end
		zFx.Text = table.concat(fx, "<br/>")
		for pp in pairs(shown) do if pp.Parent then refreshPrompt(pp) else shown[pp] = nil end end
		if folder then updateBox(folder) end
	else
		setShow(nil)
	end
	local char = player.Character
	local downed = mode == "zombies" and char ~= nil and char:GetAttribute("Downed") == true
	downLabel.Visible = downed; downVeil.Visible = downed
	if downed and char then
		local dt2 = char:GetAttribute("DownT")
		downLabel.Text = 'À TERRE<br/><font size="16" color="#ffffff">' .. (if typeof(dt2) == "number" then dt2 else 30) .. " s — un allié doit te réanimer</font>"
	end
	-- Bataille royale
	local br = data and data.br
	if mode == "br" and br and st.state == "live" then
		updateWall(br, dt, math.sin(os.clock() * 2))
		local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
		outLabel.Visible = root ~= nil and Vector3.new(root.Position.X - zoneC.X, 0, root.Position.Z - zoneC.Z).Magnitude > zoneR
		updateRadar(true)
		if folder then updateLoot(folder) end
	else
		if wallFolder then dropWall() end
		outLabel.Visible = false
		updateRadar(false)
	end
	-- orage sur l'Asile
	if folder and folder:GetAttribute("MapId") == "asile" then storm() else nextFlash = -1 end
end)
]]></string>
        </Properties>
      </Item>
    </Item>
  </Item>
  <Item class="Workspace" referent="845">
    <Properties>
      <string name="Name">Workspace</string>
      <token name="AvatarJointUpgrade_Serialized">2</token>
      <bool name="NeedsPivotMigration">false</bool>
      <bool name="StreamingEnabled">false</bool>
    </Properties>
