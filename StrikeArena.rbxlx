  <Item class="StarterPlayer" referent="788">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterCharacterScripts" referent="789">
      <Properties>
        <string name="Name">StarterCharacterScripts</string>
      </Properties>
      <Item class="Script" referent="790">
        <Properties>
          <string name="Name">Health</string>
          <token name="RunContext">0</token>
          <string name="Source"><![CDATA[--!strict
-- StarterCharacterScripts/Health (Script)
-- Remplace le script « Health » que Roblox met dans chaque personnage (1 % de vie par seconde, sans arrêt) :
-- la régénération du jeu web est faite par ServerScriptService/RegenService (3 s sans dégâts, puis 20 PV/s).
]]></string>
        </Properties>
      </Item>
    </Item>
    <Item class="StarterPlayerScripts" referent="791">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
      <Item class="LocalScript" referent="792">
        <Properties>
          <string name="Name">AccessibilityController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/AccessibilityController (LocalScript)
-- Daltonisme (ColorCorrection), taille du HUD (UIScale), sous-titres sonores directionnels (tirs entendus),
-- secousses réduites, sensibilité par arme. Réglages stockés dans l'attribut "Access" (JSON) ou profil serveur.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local Lighting = game:GetService("Lighting")
local HttpService = game:GetService("HttpService")

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local DEFAULTS = { colorblind = "none", subtitles = false, hudScale = 1, shake = 1, weaponSens = {} :: { [string]: number } }
local settings = table.clone(DEFAULTS)

local cc = Instance.new("ColorCorrectionEffect"); cc.Parent = Lighting
-- Approximation par teinte/saturation (Roblox n'expose pas de matrice 3x3) — suffisant pour différencier rouge/vert/bleu
local CB = {
	none = { Color3.new(1, 1, 1), 0 },
	deut = { Color3.fromRGB(255, 235, 200), 0.1 },    -- deutéranopie : accentue jaune/bleu
	prot = { Color3.fromRGB(255, 225, 215), 0.1 },
	trit = { Color3.fromRGB(235, 245, 255), 0.05 },
}

local gui = Instance.new("ScreenGui"); gui.Name = "AccessHud"; gui.ResetOnSpawn = false; gui.DisplayOrder = 50; gui.Parent = player:WaitForChild("PlayerGui")
local subs = Instance.new("Frame"); subs.BackgroundTransparency = 1; subs.AnchorPoint = Vector2.new(0.5, 1); subs.Position = UDim2.new(0.5, 0, 1, -200); subs.Size = UDim2.fromOffset(360, 100); subs.Parent = gui
local list = Instance.new("UIListLayout"); list.VerticalAlignment = Enum.VerticalAlignment.Bottom; list.HorizontalAlignment = Enum.HorizontalAlignment.Center; list.Padding = UDim.new(0, 3); list.Parent = subs

local function apply()
	local cb = CB[settings.colorblind] or CB.none
	cc.TintColor = cb[1]; cc.Saturation = cb[2]
	for _, g in ipairs((player:FindFirstChild("PlayerGui") :: Instance):GetChildren()) do
		if g:IsA("ScreenGui") and g ~= gui then
			local s = g:FindFirstChild("AccessScale") or Instance.new("UIScale"); s.Name = "AccessScale"; (s :: UIScale).Scale = settings.hudScale; s.Parent = g
		end
	end
end

-- chargement des réglages (envoyés par le serveur dans l'attribut "Access")
local function load()
	local raw = player:GetAttribute("Access")
	if typeof(raw) == "string" then
		local ok, data = pcall(HttpService.JSONDecode, HttpService, raw)
		if ok and typeof(data) == "table" then for k, v in pairs(data) do (settings :: any)[k] = v end end
	end
	apply()
end
player:GetAttributeChangedSignal("Access"):Connect(load)
load()

-- sous-titres sonores : chaque tir ennemi (événement Tracer) devient une ligne « ◀ Tir · 23 m »
local tracer = ReplicatedStorage:WaitForChild("Tracer") :: RemoteEvent
tracer.OnClientEvent:Connect(function(origin: Vector3)
	if not settings.subtitles then return end
	local root = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not root then return end
	local to = origin - root.Position
	local d = to.Magnitude / 3.571
	if d < 1.5 or d > 60 then return end
	local look = camera.CFrame.LookVector * Vector3.new(1, 0, 1)
	local angle = math.deg(math.atan2((look:Cross(to * Vector3.new(1, 0, 1))).Y, look:Dot(to * Vector3.new(1, 0, 1))))
	local arrow = if math.abs(angle) < 30 then "▲" elseif math.abs(angle) > 150 then "▼" elseif angle > 0 then "◀" else "▶"
	local l = Instance.new("TextLabel"); l.AutomaticSize = Enum.AutomaticSize.XY; l.BackgroundColor3 = Color3.new(0, 0, 0); l.BackgroundTransparency = 0.35
	l.Font = Enum.Font.GothamBold; l.TextSize = 14; l.TextColor3 = Color3.new(1, 1, 1); l.Text = string.format(" %s Tir · %d m ", arrow, math.floor(d)); l.Parent = subs
	Instance.new("UICorner", l).CornerRadius = UDim.new(0, 4)
	task.delay(1.4, function() l:Destroy() end)
end)

-- sensibilité par arme : multiplie la sensibilité souris quand l'arme équipée a un réglage
local function currentWeapon(): string?
	local c = player.Character; local tool = c and c:FindFirstChildOfClass("Tool")
	return tool and tool.Name or nil
end
-- (le multiplicateur passe par ClientState : WeaponController calcule la sensibilité finale avec celle du menu)
local S = require(ReplicatedStorage.Shared.ClientState)
game:GetService("RunService").RenderStepped:Connect(function()
	local w = currentWeapon()
	S.opt.wsens = (w and settings.weaponSens[w]) or 1
end)

-- API pour l'interface de réglages
local setEvent = Instance.new("BindableEvent"); setEvent.Name = "AccessSet"; setEvent.Parent = script
setEvent.Event:Connect(function(key: string, value: any)
	(settings :: any)[key] = value; apply()
	player:SetAttribute("Access", HttpService:JSONEncode(settings))
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="793">
        <Properties>
          <string name="Name">AdminController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/AdminController (LocalScript)
-- Panneau admin (src/8M_admin.js) : touche Inser (F2 en secours). Ne s'ouvre QUE pour le propriétaire du jeu
-- (attribut AdminEligible posé par le serveur) et demande d'abord le code. Tout passe par AdminRequest : le serveur
-- revérifie les droits à chaque appel, ce script n'est qu'un affichage.
-- Onglets : Joueurs, Partie, Donner, Triche, Journal.
-- Vision à travers les murs et visée auto : ici (côté client), seulement quand le serveur répond que c'est permis
-- (visionWhy / aimWhy vides : pas de joueur humain en face, comme sur le web).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")

local Config = require(ReplicatedStorage.Shared.Config)
local S = require(ReplicatedStorage.Shared.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local PANEL = Color3.fromRGB(15, 23, 38)
local PANEL2 = Color3.fromRGB(24, 35, 56)
local DIM = Color3.fromRGB(141, 160, 189)
local GOLD = Color3.fromRGB(255, 210, 58)
local RED = Color3.fromRGB(255, 107, 107)
local GREEN = Color3.fromRGB(125, 255, 159)
local BLUE = Color3.fromRGB(159, 227, 255)

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 6) }, o) end

local request: RemoteFunction? = nil
local function ask(action: string, a: any?, b: any?): any
	request = request or ReplicatedStorage:FindFirstChild("AdminRequest") :: RemoteFunction?
	if not request then return nil end
	local ok, res = pcall(function() return (request :: RemoteFunction):InvokeServer(action, a, b) end)
	return if ok then res else nil
end

-- ---------- fenêtre ----------
local gui = make("ScreenGui", { Name = "AdminPanel", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 60, Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(600, 440),
	BackgroundColor3 = PANEL, BackgroundTransparency = 0.04 }, gui)
corner(win, 10)
make("UIStroke", { Color = GOLD, Transparency = 0.6, Thickness = 1 }, win)
make("UISizeConstraint", { MaxSize = Vector2.new(600, 440) }, win)
make("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true }, win)   -- libère la souris
make("TextLabel", { Position = UDim2.fromOffset(14, 8), Size = UDim2.new(1, -60, 0, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 17,
	TextColor3 = GOLD, TextXAlignment = Enum.TextXAlignment.Left, Text = "PANNEAU ADMIN" }, win)
local closeBtn = make("TextButton", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -8, 0, 8), Size = UDim2.fromOffset(28, 24), BackgroundColor3 = PANEL2,
	Font = Enum.Font.GothamBold, TextSize = 14, TextColor3 = Color3.new(1, 1, 1), Text = "✕" }, win)
corner(closeBtn)
require(ReplicatedStorage.Shared.Icons).closeButton(closeBtn, 11)   -- la croix U+2715 donne un carré vide
local tabBar = make("Frame", { Position = UDim2.fromOffset(10, 38), Size = UDim2.new(1, -20, 0, 28), BackgroundTransparency = 1 }, win)
make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 6) }, tabBar)
local body = make("ScrollingFrame", { Position = UDim2.fromOffset(10, 72), Size = UDim2.new(1, -20, 1, -102), BackgroundTransparency = 1, ScrollBarThickness = 5,
	CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y }, win)
local status = make("TextLabel", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 14, 1, -6), Size = UDim2.new(1, -28, 0, 20), BackgroundTransparency = 1,
	Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = DIM, TextXAlignment = Enum.TextXAlignment.Left, Text = "", TextTruncate = Enum.TextTruncate.AtEnd }, win)

local function say(txt: string, col: Color3?) status.Text = txt; status.TextColor3 = col or DIM end

local order = 0
local function clear()
	for _, c in ipairs(body:GetChildren()) do if c:IsA("GuiObject") then c:Destroy() end end
	order = 0
	if not body:FindFirstChildOfClass("UIListLayout") then make("UIListLayout", { Padding = UDim.new(0, 6), SortOrder = Enum.SortOrder.LayoutOrder }, body) end
end
local function nextOrder(): number order += 1; return order end
local function title(txt: string)
	make("TextLabel", { Size = UDim2.new(1, -8, 0, 20), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 13, TextColor3 = GOLD,
		TextXAlignment = Enum.TextXAlignment.Left, Text = string.upper(txt), LayoutOrder = nextOrder() }, body)
end
local function note(txt: string, col: Color3?)
	make("TextLabel", { Size = UDim2.new(1, -8, 0, 0), AutomaticSize = Enum.AutomaticSize.Y, BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 13,
		TextColor3 = col or DIM, TextXAlignment = Enum.TextXAlignment.Left, TextWrapped = true, Text = txt, LayoutOrder = nextOrder() }, body)
end
local function row(): Frame
	local f = make("Frame", { Size = UDim2.new(1, -8, 0, 28), BackgroundTransparency = 1, LayoutOrder = nextOrder() }, body)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5), VerticalAlignment = Enum.VerticalAlignment.Center }, f)
	return f
end
local function btn(parent: Instance, txt: string, col: Color3?, cb: () -> ()): TextButton
	local b = make("TextButton", { Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = PANEL2, Font = Enum.Font.GothamBold,
		TextSize = 12, TextColor3 = col or Color3.new(1, 1, 1), Text = txt, AutoButtonColor = true }, parent)
	make("UIPadding", { PaddingLeft = UDim.new(0, 9), PaddingRight = UDim.new(0, 9) }, b)
	corner(b, 5)
	b.Activated:Connect(cb)
	return b
end
local function cell(parent: Instance, txt: string, w: number, col: Color3?)
	make("TextLabel", { Size = UDim2.fromOffset(w, 26), BackgroundTransparency = 1, Font = Enum.Font.Gotham, TextSize = 12, TextColor3 = col or Color3.new(1, 1, 1),
		TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = txt }, parent)
end

-- ---------- état ----------
local state: any = nil
local tab = "Joueurs"
local cheats = { vision = false, aim = false, aimMode = "ads", aimStr = "strong" }
local AIM_MODES = { ads = "en visant", fire = "en tirant", always = "toujours" }
local AIM_STR = { soft = 0.08, strong = 0.25, locked = 1 }
local AIM_STR_N = { soft = "douce", strong = "forte", locked = "verrouillée" }
local render: () -> () = function() end

local function refresh()
	local s = ask("state", tab == "Journal")
	if s then state = s end
end
local function act(action: string, a: any?, b: any?)
	local r = ask(action, a, b)
	if r == nil then say("Refusé", RED)
	elseif r == false then say("Impossible", RED)
	elseif typeof(r) == "string" then say(r, GREEN)
	else say("OK", GREEN) end
	refresh(); render()
end

-- ---------- onglets ----------
local TABS = { "Joueurs", "Partie", "Donner", "Triche", "Journal" }
local tabBtns: { [string]: TextButton } = {}

local function renderLogin()
	clear()
	title("Code administrateur")
	note("Tape le code défini dans ServerScriptService/AdminConfig.")
	local r = row()
	local box = make("TextBox", { Size = UDim2.fromOffset(260, 26), BackgroundColor3 = PANEL2, Font = Enum.Font.Code, TextSize = 14, TextColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "XXXX-XXXX-XXXX-XXXX", Text = "", ClearTextOnFocus = false }, r)
	corner(box, 5)
	local function go()
		local res = ask("unlock", box.Text)
		if res and res.ok then say("Accès ouvert", GREEN); refresh(); render()
		else say(if res and res.err then res.err else "Refusé", RED) end
	end
	btn(r, "Valider", GOLD, go)
	box.FocusLost:Connect(function(enter: boolean) if enter then go() end end)
	task.defer(function() box:CaptureFocus() end)
end

local function renderPlayers()
	local g = state.game
	if g then
		local r = row()
		if g.team then
			for _, t in ipairs(g.teams) do btn(r, "+ Bot " .. t, nil, function() act("addbot", t) end) end
		else
			btn(r, "+ Bot", nil, function() act("addbot") end)
		end
		btn(r, if g.botsFrozen then "Libérer les bots" else "Figer les bots", BLUE, function() act("freeze") end)
	end
	title(if g then "Combattants de ta partie" else "Joueurs du serveur")
	for _, p in ipairs(state.players) do
		local r = row()
		local col = if p.kind == "me" then GOLD elseif p.kind == "bot" then DIM else Color3.new(1, 1, 1)
		cell(r, p.name .. (if p.kind == "bot" then " (bot)" else ""), 130, col)
		cell(r, if p.zone then tostring(p.zone) else tostring(p.team), 60, DIM)
		cell(r, p.k .. "/" .. p.d .. "  " .. (if p.alive then p.hp .. "pv" else "mort") .. (if p.ping then "  " .. p.ping .. "ms" else ""), 120, DIM)
		if g then
			if p.alive then
				btn(r, "Tuer", RED, function() act("kill", p.key) end)
				btn(r, "Soigner", GREEN, function() act("heal", p.key) end)
			elseif p.kind ~= "bot" then
				btn(r, "Réapparaître", GREEN, function() act("revive", p.key) end)
			end
			if g.team then btn(r, "Équipe", nil, function() act("team", p.key) end) end
			if p.kind ~= "me" then btn(r, if p.frozen then "Dégeler" else "Geler", BLUE, function() act("freeze1", p.key) end) end
			if p.kind == "bot" then btn(r, "Retirer", RED, function() act("rmbot", p.key) end) end
		end
		if p.kind == "player" then
			local r2 = if g then row() else r
			if g then cell(r2, "", 130) end
			btn(r2, if p.muted then "Rendre la parole" else "Muet", nil, function() act("mute", p.userId) end)
			btn(r2, "Expulser", RED, function() act("kick", p.userId) end)
			btn(r2, "Bannir", RED, function() act("ban", p.userId) end)
		end
	end
	if #state.banned > 0 then
		title("Bannis (jusqu'à la fermeture du serveur)")
		for _, b in ipairs(state.banned) do
			local r = row()
			cell(r, b.name, 200)
			btn(r, "Débannir", GREEN, function() act("unban", b.userId) end)
		end
	end
end

local function renderGame()
	local g = state.game
	if not g then note("Lance une partie pour utiliser ces commandes."); return end
	title(g.mode .. " · " .. tostring(g.map))
	local sc = {}
	if g.team then for _, t in ipairs(g.teams) do table.insert(sc, t .. " " .. tostring(g.score[t] or 0)) end end
	note("État : " .. tostring(g.state) .. (if g.round then " · manche " .. tostring(g.round) else "") .. (if g.phase then " (" .. tostring(g.phase) .. ")" else "")
		.. (if #sc > 0 then " · " .. table.concat(sc, " – ") else "") .. " · limite " .. tostring(g.limit)
		.. (if g.timeLeft >= 0 then string.format(" · %d:%02d restantes", g.timeLeft // 60, g.timeLeft % 60) else "")
		.. " · " .. g.humans .. " humain" .. (if g.humans > 1 then "s" else ""))
	local r = row()
	btn(r, "Terminer la partie", RED, function() act("endmatch") end)
	btn(r, "+1 minute", nil, function() act("time") end)
	title("Annonce à tout le serveur")
	local r2 = row()
	local box = make("TextBox", { Size = UDim2.fromOffset(360, 26), BackgroundColor3 = PANEL2, Font = Enum.Font.Gotham, TextSize = 13, TextColor3 = Color3.new(1, 1, 1),
		PlaceholderText = "Message (90 caractères max)", Text = "", ClearTextOnFocus = false }, r2)
	corner(box, 5)
	btn(r2, "Envoyer", GOLD, function() if box.Text ~= "" then act("announce", box.Text); box.Text = "" end end)
end

local function renderGive()
	local pr = state.profile
	if pr then note("Ton profil : niveau " .. tostring(pr.level) .. " · " .. tostring(pr.coins) .. " pièces · " .. tostring(pr.boxes) .. " caisses") end
	title("Débloquer")
	local r = row()
	btn(r, "Tout débloquer", GOLD, function() act("giveall") end)
	btn(r, "+5 caisses de chaque", nil, function() act("boxes") end)
	title("Pièces")
	local r2 = row()
	for _, n in ipairs({ 1000, 5000, 25000 }) do btn(r2, "+" .. n, nil, function() act("coins", n) end) end
	title("Niveaux")
	local r3 = row()
	for _, n in ipairs({ 1, 5, 10 }) do btn(r3, "+" .. n, nil, function() act("lvl", n) end) end
end

local function onOff(b: boolean): string return if b then "ACTIVÉ" else "coupé" end
local spectating: Model? = nil
local function enemyModels(): { Model }
	local list = {}
	local mid = player:GetAttribute("MatchId")
	local myTeam = player:GetAttribute("Team")
	if mid == nil then return list end
	for _, q in ipairs(Players:GetPlayers()) do
		if q ~= player and q:GetAttribute("MatchId") == mid and (q:GetAttribute("Team") ~= myTeam or myTeam == nil) and q.Character then table.insert(list, q.Character) end
	end
	local bots = workspace:FindFirstChild("Bots")
	if bots then
		for _, b in ipairs(bots:GetChildren()) do
			if b:IsA("Model") and b:GetAttribute("MatchId") == mid and b:GetAttribute("Team") ~= myTeam then table.insert(list, b) end
		end
	end
	return list
end
local function aliveModel(m: Model): boolean
	local h = m:FindFirstChildOfClass("Humanoid")
	return h ~= nil and h.Health > 0 and m.Parent ~= nil
end

local function renderCheats()
	local f = state.flags
	local why = state.cheatWhy
	if why ~= "" then note("⚠ " .. why, RED) end
	title("Serveur")
	local r = row()
	btn(r, "Immortel : " .. onOff(f.god), if f.god then GREEN else nil, function() act("god") end)
	btn(r, "Balles infinies : " .. onOff(f.ammo), if f.ammo then GREEN else nil, function() act("ammo") end)
	btn(r, "Grenades infinies : " .. onOff(f.nades), if f.nades then GREEN else nil, function() act("nades") end)
	title("Vision à travers les murs")
	if state.visionWhy ~= "" then note(state.visionWhy, RED) end
	local r2 = row()
	btn(r2, "Vision : " .. onOff(cheats.vision), if cheats.vision then GREEN else nil, function() cheats.vision = not cheats.vision; render() end)
	btn(r2, "Regarder un ennemi", nil, function()
		local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if h and h.Health > 0 then say("Seulement quand tu es éliminé", RED); return end
		local list = enemyModels()
		if #list == 0 then say("Personne à regarder", RED); return end
		local idx = (spectating and table.find(list, spectating) or 0) % #list + 1
		spectating = list[idx]
		local eh = list[idx]:FindFirstChildOfClass("Humanoid")
		if eh then camera.CameraSubject = eh; say("Tu regardes " .. list[idx].Name, GREEN) end
	end)
	title("Visée automatique")
	if state.aimWhy ~= "" then note(state.aimWhy, RED) end
	local r3 = row()
	btn(r3, "Visée auto : " .. onOff(cheats.aim), if cheats.aim then GREEN else nil, function() cheats.aim = not cheats.aim; render() end)
	btn(r3, "Quand : " .. AIM_MODES[cheats.aimMode], nil, function()
		cheats.aimMode = if cheats.aimMode == "ads" then "fire" elseif cheats.aimMode == "fire" then "always" else "ads"; render()
	end)
	btn(r3, "Force : " .. AIM_STR_N[cheats.aimStr], nil, function()
		cheats.aimStr = if cheats.aimStr == "soft" then "strong" elseif cheats.aimStr == "strong" then "locked" else "soft"; render()
	end)
	title("Prendre une arme")
	local keys = {}
	for k, w in pairs(Config.WEAPONS) do if not w.melee and (w.slot == 0 or w.slot == 1) then table.insert(keys, k) end end
	table.sort(keys, function(a, b)
		local wa, wb = Config.WEAPONS[a], Config.WEAPONS[b]
		if wa.slot ~= wb.slot then return wa.slot < wb.slot end
		return wa.name < wb.name
	end)
	local rr: Frame? = nil
	for i, k in ipairs(keys) do
		if (i - 1) % 6 == 0 then rr = row() end
		btn(rr :: Frame, Config.WEAPONS[k].name, nil, function() act("weapon", k) end)
	end
end

local function renderLog()
	local r = row()
	btn(r, "Actualiser", nil, function() refresh(); render() end)
	btn(r, "Effacer", RED, function() act("clearlog") end)
	btn(r, "Verrouiller le panneau", nil, function() ask("lock"); state = nil; render() end)
	local lines = state.log or {}
	for i = #lines, math.max(1, #lines - 80), -1 do
		local l = lines[i]
		local ok, col = pcall(Color3.fromHex, l.col)
		note(l.t .. "  " .. l.txt, if ok and l.col ~= "" then col else Color3.new(1, 1, 1))
	end
end

render = function()
	for name, b in pairs(tabBtns) do b.BackgroundColor3 = if name == tab then GOLD else PANEL2; b.TextColor3 = if name == tab then PANEL else Color3.new(1, 1, 1) end
	if player:GetAttribute("AdminUnlocked") ~= true or not state then tabBar.Visible = false; renderLogin(); return end
	tabBar.Visible = true
	clear()
	if tab == "Joueurs" then renderPlayers()
	elseif tab == "Partie" then renderGame()
	elseif tab == "Donner" then renderGive()
	elseif tab == "Triche" then renderCheats()
	else renderLog() end
end

for _, name in ipairs(TABS) do
	local b = make("TextButton", { Size = UDim2.fromOffset(100, 26), BackgroundColor3 = PANEL2, Font = Enum.Font.GothamBold, TextSize = 13,
		TextColor3 = Color3.new(1, 1, 1), Text = name }, tabBar)
	corner(b, 5)
	b.Activated:Connect(function() tab = name; refresh(); render() end)
	tabBtns[name] = b
end

local function setOpen(on: boolean)
	gui.Enabled = on
	player:SetAttribute("UiOpen", if on then true else nil)
	if on then
		if player:GetAttribute("AdminUnlocked") == true then refresh() end
		say("")
		render()
	end
end
closeBtn.Activated:Connect(function() setOpen(false) end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if input.KeyCode ~= Enum.KeyCode.Insert and input.KeyCode ~= Enum.KeyCode.F2 then return end
	if processed and not gui.Enabled then return end
	if player:GetAttribute("AdminEligible") ~= true then return end   -- joueur normal : rien
	setOpen(not gui.Enabled)
end)

-- rafraîchit l'état (raisons de coupure des triches) toutes les secondes quand le panneau ou une triche est actif
task.spawn(function()
	while true do
		task.wait(1)
		if player:GetAttribute("AdminUnlocked") == true and (gui.Enabled or cheats.vision or cheats.aim) then
			refresh()
			if gui.Enabled and tab ~= "Journal" and not UserInputService:GetFocusedTextBox() then render() end
		elseif player:GetAttribute("AdminUnlocked") ~= true then
			state = nil
		end
	end
end)

-- ---------- vision (Highlight toujours visible + nom, vie, distance) ----------
local marks: { [Model]: { hl: Highlight, bb: BillboardGui, txt: TextLabel } } = {}
local function visionOn(): boolean
	return cheats.vision and state ~= nil and state.visionWhy == "" and player:GetAttribute("AdminUnlocked") == true
end
local function clearMarks()
	for m, v in pairs(marks) do v.hl:Destroy(); v.bb:Destroy(); marks[m] = nil end
end
RunService.Heartbeat:Connect(function()
	if not visionOn() then if next(marks) then clearMarks() end; return end
	local seen: { [Model]: boolean } = {}
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	for _, m in ipairs(enemyModels()) do
		if aliveModel(m) then
			seen[m] = true
			local v = marks[m]
			if not v then
				local hl = make("Highlight", { DepthMode = Enum.HighlightDepthMode.AlwaysOnTop, FillColor = RED, FillTransparency = 0.6, OutlineColor = Color3.new(1, 1, 1), Adornee = m }, gui)
				local bb = make("BillboardGui", { Size = UDim2.fromOffset(150, 34), StudsOffset = Vector3.new(0, 3.4, 0), AlwaysOnTop = true, Adornee = m:FindFirstChild("Head") or m.PrimaryPart }, gui)
				local txt = make("TextLabel", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.new(1, 1, 1),
					TextStrokeTransparency = 0.3, Text = "" }, bb)
				v = { hl = hl, bb = bb, txt = txt }
				marks[m] = v
			end
			local h = m:FindFirstChildOfClass("Humanoid") :: Humanoid
			local root = m:FindFirstChild("HumanoidRootPart") :: BasePart?
			local dist = if me and root then math.floor((root.Position - me.Position).Magnitude / Config.STUDS_PER_METER + 0.5) else 0
			v.txt.Text = m.Name .. "\n" .. math.floor(h.Health + 0.5) .. " pv · " .. dist .. " m"
		end
	end
	for m, v in pairs(marks) do if not seen[m] then v.hl:Destroy(); v.bb:Destroy(); marks[m] = nil end end
end)

-- ---------- visée auto ----------
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local AIM_CONE = math.cos(math.rad(28))
RunService:BindToRenderStep("AdminAim", Enum.RenderPriority.Camera.Value + 1, function()
	if not cheats.aim or not state or state.aimWhy ~= "" or player:GetAttribute("AdminUnlocked") ~= true or S.kc then return end
	local ch = player.Character
	if not ch then return end
	local active = cheats.aimMode == "always" or (cheats.aimMode == "ads" and S.aiming)
		or (cheats.aimMode == "fire" and UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton1))
	if not active then return end
	local cf = camera.CFrame
	local best: Vector3? = nil
	local bestDot = AIM_CONE
	rayParams.FilterDescendantsInstances = { ch, camera }
	for _, m in ipairs(enemyModels()) do
		local head = m:FindFirstChild("Head") :: BasePart?
		if head and aliveModel(m) then
			local to = head.Position - cf.Position
			local dot = cf.LookVector:Dot(to.Unit)
			if dot > bestDot then
				local hit = workspace:Raycast(cf.Position, to, rayParams)
				if not hit or hit.Instance:IsDescendantOf(m) then best = head.Position; bestDot = dot end
			end
		end
	end
	if not best then return end
	local goal = CFrame.lookAt(cf.Position, best)
	camera.CFrame = cf:Lerp(goal, AIM_STR[cheats.aimStr])
end)

player:GetAttributeChangedSignal("AdminUnlocked"):Connect(function()
	if player:GetAttribute("AdminUnlocked") ~= true then cheats.vision = false; cheats.aim = false; state = nil; clearMarks() end
end)
player.CharacterAdded:Connect(function() spectating = nil end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="794">
        <Properties>
          <string name="Name">AmbienceController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/AmbienceController (LocalScript)
-- Tout ce qui sonne sans qu'une arme le demande :
--   * réverbération du lieu : celle de la carte, plus fermée quand un plafond est au-dessus de la caméra (souk, tunnels, hangars) ;
--   * fond sonore de la carte (vent, bourdonnement, port…) en boucle, avec des rafales, plus fort sous l'orage ;
--   * bruits de pas des joueurs et des bots selon le sol (sable, herbe, neige, pierre, bois, métal), plus forts en sprint,
--     saut et escalade du joueur ; sol sous le joueur transmis à Sfx (bruit des douilles).
-- Les pas Roblox par défaut (RbxCharacterSounds) sont coupés : ils feraient doublon avec ceux de la planche.
-- Réglages dans ModeConfig.SOUNDS (MAPS, ACOUSTICS, AMBIENCE, STEPS).
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local S = require(ReplicatedStorage.Shared.ClientState)

local player = Players.LocalPlayer
local SOUNDS: any = ModeConfig.SOUNDS
local M = 3.571                                  -- studs par mètre (Config.STUDS_PER_METER)
local HAS_SHEET = ModeConfig.SOUND_SHEET ~= 0

-- ---------- carte du joueur ----------
-- attribut MatchMap du joueur (nom du dossier de la carte), sinon la carte sous la caméra, sinon le lobby (nil)
local function currentMap(): Folder?
	local name = player:GetAttribute("MatchMap")
	if typeof(name) == "string" and name ~= "" then
		local f = workspace:FindFirstChild(name)
		if f and f:IsA("Folder") and f:GetAttribute("MapId") then return f end
	end
	local cam = workspace.CurrentCamera
	if not cam then return nil end
	local pos = cam.CFrame.Position
	for _, f in ipairs(workspace:GetChildren()) do
		if f:IsA("Folder") and typeof(f:GetAttribute("MapId")) == "string" then
			local o = f:GetAttribute("Origin")
			local size = f:GetAttribute("MapSize")
			if typeof(o) == "Vector3" and typeof(size) == "number"
				and pos.X >= o.X and pos.X <= o.X + size and pos.Z >= o.Z and pos.Z <= o.Z + size and math.abs(pos.Y - o.Y) < 200 then
				return f
			end
		end
	end
	return nil
end

local mapFolder: Folder? = nil
local mapInfo: any = nil
local covered = false

-- ---------- fond sonore ----------
type Bed = { sound: Sound, layer: any, fade: number, out: boolean, seed: number }
local beds: { Bed } = {}
local bedName: string? = nil

local function setAmbience(name: string?)
	if name == bedName then return end
	bedName = name
	for _, b in ipairs(beds) do b.out = true end
	local layers = name and SOUNDS.AMBIENCE and SOUNDS.AMBIENCE[name]
	if not layers then return end
	local group = Sfx.group("ambient")
	for i, L in ipairs(layers) do
		local s = Instance.new("Sound")
		s.Name = "Ambiance"; s.SoundId = L.id; s.Looped = true; s.Volume = 0; s.PlaybackSpeed = L.rate or 1
		if group then s.SoundGroup = group end
		local eq = Instance.new("EqualizerSoundEffect")
		eq.HighGain = L.high or 0; eq.MidGain = L.mid or 0; eq.LowGain = 0; eq.Parent = s
		s.Parent = game:GetService("SoundService")
		s.TimePosition = math.random() * 2
		s:Play()
		table.insert(beds, { sound = s, layer = L, fade = 0, out = false, seed = i * 7.3 + math.random() * 50 })
	end
end

local function updateBeds(dt: number)
	local t = os.clock()
	local w = workspace:GetAttribute("Weather")
	local weather = if w == "storm" then 1.6 elseif w == "rain" then 1.25 else 1
	local cover = if covered then 0.5 else 1
	for i = #beds, 1, -1 do
		local b = beds[i]
		if b.out then b.fade -= dt / 1.5 else b.fade = math.min(1, b.fade + dt / 2.5) end
		if b.fade <= 0 and b.out then
			b.sound:Destroy(); table.remove(beds, i)
		else
			local L = b.layer
			local gust = 1 + (L.gust or 0) * math.noise(t * 0.13, b.seed) * 1.6
			b.sound.Volume = math.max(0, (L.vol or 0.1) * gust * weather * cover * math.max(0, b.fade))
			b.sound.PlaybackSpeed = (L.rate or 1) * (1 + (L.gust or 0) * 0.08 * math.noise(t * 0.1, b.seed + 3))
		end
	end
end

-- ---------- lieu : carte, plafond, réverbération ----------
local upParams = RaycastParams.new(); upParams.FilterType = Enum.RaycastFilterType.Include
local coverVotes = 0
local function updatePlace()
	local f = currentMap()
	if f ~= mapFolder then
		mapFolder = f
		local id = f and f:GetAttribute("MapId")
		mapInfo = if typeof(id) == "string" and SOUNDS.MAPS then SOUNDS.MAPS[id] else nil
		covered = false; coverVotes = 0
		setAmbience(mapInfo and mapInfo.ambience)
	end
	if not mapFolder or not mapInfo then Sfx.setAcoustics("lobby"); return end
	local cam = workspace.CurrentCamera
	local hit = false
	if cam then
		upParams.FilterDescendantsInstances = { mapFolder }
		hit = workspace:Raycast(cam.CFrame.Position, Vector3.new(0, 18 * M, 0), upParams) ~= nil
	end
	-- deux lectures de suite avant de changer (pas de va-et-vient au bord d'un toit)
	if hit ~= covered then coverVotes += 1 else coverVotes = 0 end
	if coverVotes >= 2 then covered = hit; coverVotes = 0 end
	Sfx.setAcoustics(if covered then mapInfo.inn else mapInfo.out)
end

-- ---------- pas ----------
local MAT: { [string]: string } = {
	Sand = "sand", Ground = "sand", Mud = "sand", Salt = "sand",
	Grass = "grass", LeafyGrass = "grass",
	Snow = "snow", Ice = "snow", Glacier = "snow",
	Wood = "wood", WoodPlanks = "wood",
	Metal = "metal", CorrodedMetal = "metal", DiamondPlate = "metal", Foil = "metal",
	Concrete = "stone", Brick = "stone", Cobblestone = "stone", Granite = "stone", Marble = "stone", Slate = "stone",
	Rock = "stone", Basalt = "stone", Pavement = "stone", Limestone = "stone", Asphalt = "stone", Sandstone = "stone",
}
local function surfaceOf(part: BasePart): string
	local byMat = MAT[part.Material.Name]
	if byMat then return byMat end
	local info = mapInfo
	if not info then return "stone" end
	if part.Name == "Floor" then return info.floor or "sand" end
	if part:IsA("WedgePart") or part.Name == "Block" then return info.raised or info.floor or "stone" end
	return info.floor or "stone"
end

local DEFAULT_SOUNDS = { Running = true, Jumping = true, Landing = true, FreeFalling = true }
type Walker = { char: Model, hum: Humanoid, hrp: BasePart, t: number, foot: boolean, conns: { RBXScriptConnection } }
local walkers: { [Model]: Walker } = {}
local downParams = RaycastParams.new(); downParams.FilterType = Enum.RaycastFilterType.Exclude

local function mute(s: Instance, conns: { RBXScriptConnection })
	if s:IsA("Sound") and DEFAULT_SOUNDS[s.Name] and s.Parent and s.Parent.Name == "HumanoidRootPart" then
		s.Volume = 0
		table.insert(conns, s:GetPropertyChangedSignal("Volume"):Connect(function() if s.Volume > 0 then s.Volume = 0 end end))
	end
end

local function forget(char: Model)
	local w = walkers[char]
	if not w then return end
	walkers[char] = nil
	for _, c in ipairs(w.conns) do c:Disconnect() end
end

local function track(char: Model)
	if walkers[char] or not HAS_SHEET then return end
	task.spawn(function()
		local hum = char:WaitForChild("Humanoid", 10)
		local hrp = char:WaitForChild("HumanoidRootPart", 10)
		if not hum or not hum:IsA("Humanoid") or not hrp or not hrp:IsA("BasePart") or walkers[char] then return end
		local w: Walker = { char = char, hum = hum, hrp = hrp, t = 0, foot = false, conns = {} }
		walkers[char] = w
		for _, d in ipairs(hrp:GetChildren()) do mute(d, w.conns) end
		table.insert(w.conns, hrp.ChildAdded:Connect(function(d) mute(d, w.conns) end))
		table.insert(w.conns, char.AncestryChanged:Connect(function() if not char:IsDescendantOf(workspace) then forget(char) end end))
		if char == player.Character then
			table.insert(w.conns, hum.StateChanged:Connect(function(_, new)
				if new == Enum.HumanoidStateType.Jumping then Sfx.play("jump") end
			end))
		end
	end)
end

local function stepOf(w: Walker, dt: number, cam: Vector3)
	local own = w.char == player.Character
	if w.hum.Health <= 0 then return end
	local v = w.hrp.AssemblyLinearVelocity
	local speed = Vector3.new(v.X, 0, v.Z).Magnitude / M
	if speed < 3.2 or (own and (S.crouch or S.slide or S.mantle)) then w.t = math.min(w.t, 0.12); return end
	local d = (w.hrp.Position - cam).Magnitude / M
	if not own and d > 40 then return end
	w.t -= dt
	if w.t > 0 then return end
	-- comme le web : 0,4 s entre deux pas en marchant, 0,3 en sprint, 0,25 en sprint tactique
	w.t = if own then (if S.sprint and S.tactical then 0.25 elseif S.sprint then 0.3 else 0.4)
		else math.clamp(2 / speed, 0.25, 0.42)
	downParams.FilterDescendantsInstances = { w.char }
	local reach = w.hum.HipHeight + w.hrp.Size.Y / 2 + 1.5
	local r = workspace:Raycast(w.hrp.Position, Vector3.new(0, -reach, 0), downParams)
	if not r then return end
	local part = r.Instance
	local surface = if part:IsA("BasePart") then surfaceOf(part) else "stone"
	w.foot = not w.foot
	local vol = if own then (if S.sprint then 0.36 else 0.28) else 0.5
	local sprint = if own then S.sprint == true else speed > 6
	if own then Sfx.setGround(surface); S.stepAt = os.clock() end   -- le viewmodel cale son balancement sur ce pas
	Sfx.step(surface, if own then nil else r.Position, vol * (if w.foot then 1 else 0.9), sprint)
end

local function watchPlayer(p: Player)
	p.CharacterAdded:Connect(track)
	if p.Character then track(p.Character) end
end
for _, p in ipairs(Players:GetPlayers()) do watchPlayer(p) end
Players.PlayerAdded:Connect(watchPlayer)
local function watchBots(f: Instance)
	f.ChildAdded:Connect(function(m) if m:IsA("Model") then track(m) end end)
	for _, m in ipairs(f:GetChildren()) do if m:IsA("Model") then track(m) end end
end
local botsFolder = workspace:FindFirstChild("Bots")
if botsFolder then watchBots(botsFolder) end
workspace.ChildAdded:Connect(function(c: Instance) if c.Name == "Bots" and c:IsA("Folder") then watchBots(c) end end)

-- sol sous le joueur à l'arrêt aussi (douilles qui tombent, Sfx.setGround)
local function updateGround()
	local char = player.Character
	local hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not char or not hrp or not hrp:IsA("BasePart") then return end
	downParams.FilterDescendantsInstances = { char }
	local r = workspace:Raycast(hrp.Position, Vector3.new(0, -8, 0), downParams)
	if r and r.Instance:IsA("BasePart") then Sfx.setGround(surfaceOf(r.Instance)) end
end

-- ---------- boucle ----------
local placeT = 0
local wasMantle = false
RunService.Heartbeat:Connect(function(dt: number)
	placeT -= dt
	if placeT <= 0 then placeT = 0.4; updatePlace(); updateGround() end
	-- escalade : les mains attrapent le rebord, le corps se hisse
	local mantle = S.mantle == true
	if mantle and not wasMantle then Sfx.foley("climb") end
	wasMantle = mantle
	updateBeds(dt)
	local cam = workspace.CurrentCamera
	if not cam then return end
	local cp = cam.CFrame.Position
	for _, w in pairs(walkers) do stepOf(w, dt, cp) end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="795">
        <Properties>
          <string name="Name">BuyMenu</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/BuyMenu (LocalScript)
-- Boutique en partie, copie de #buy du jeu web (src/80_ui.js renderBuy / quickBuy / rebuy, styles .it de src/00_head.html) :
-- panneau sombre de 1100 de large, « BOUTIQUE » espacé, ⚡ ACHAT RAPIDE et 🔄 RACHETER, argent en vert, colonnes
-- Pistolets / SMG / Pompes / Fusils puis Snipers / Lourd / Équipement, cartes avec nom, prix, image de l'arme et trois
-- barres (dégâts rouge, cadence bleue, précision verte), carte verte quand l'objet est équipé, grisée quand il ne
-- s'achète pas.
-- Touche B (ou croix directionnelle gauche) dans tous les modes : modes à manches (Compétitif, Désamorçage rapide,
-- Duel) pendant la phase d'achat, avec l'argent ; autres modes = « armurerie gratuite » du web, l'arme est donnée
-- tout de suite. Rien en Course aux armes, Zombies, Arme tournante, Bataille royale et Infecté (comme le web).
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")

local Config = require(ReplicatedStorage.Shared.Config)
local Modes = require(ReplicatedStorage.Shared.Modes)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit")) :: any

local player = Players.LocalPlayer
local make, spaced = K.make, K.spaced
local rgb = K.rgb

-- couleurs du web (:root et .it)
local C = {
	panel = rgb(0x0d121d), line = rgb(0x2a3750), it = rgb(0x161f33), itHover = rgb(0x22304e), own = rgb(0x12261f), ownLine = rgb(0x3dffa8),
	text = rgb(0xffffff), dim = rgb(0x8da0bd), foot = rgb(0x7b8ca6), good = rgb(0x7dff9f), accent = rgb(0xff4655), blue = rgb(0x4aa3ff),
	chip = rgb(0x1a2438), chipText = rgb(0xc5d1e4), shield = rgb(0x5ad8ff), navy = rgb(0x1a253c),
}
local ROUND_MODES = { bomb = true, rapid = true, duel = true }
local CT = "Défenseurs"
local DIM = 0.62                 -- .it:disabled { opacity: .38 }

local function remote(): RemoteFunction?
	local r = ReplicatedStorage:FindFirstChild("ModeBuy")
	return if r and r:IsA("RemoteFunction") then r else nil
end

-- ---------- fenêtre ----------
local gui = make("ScreenGui", { Name = "BuyMenu", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 26, Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
-- .ov : voile rgba(5,8,13,.78) sur tout l'écran
make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 0.22, BackgroundColor3 = rgb(0x05080d) }, gui)
local modal = make("TextButton", { Text = "", BackgroundTransparency = 1, Size = UDim2.fromOffset(1, 1), Modal = true, Selectable = false }, gui)   -- libère la souris
local canvas = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(1600, 900) }, gui)
local scale = make("UIScale", {}, canvas)

local PW, PADX, PADY, GAP = 1100, 26, 22, 14
local CW = math.floor((PW - PADX * 2 - GAP * 3) / 4)
local panel = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(PW, 860),
	BackgroundTransparency = 0.12, BackgroundColor3 = C.panel }, canvas)
K.corner(panel, 4); K.stroke(panel, C.line, 1, 0)

-- en-tête : titre, achats rapides, argent
local title = make("TextLabel", { Position = UDim2.fromOffset(PADX, PADY), Size = UDim2.fromOffset(420, 40), Font = K.BLACK, TextSize = 26,
	TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, Text = spaced("BOUTIQUE", 2) }, panel)
local money = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -PADX, 0, PADY), Size = UDim2.fromOffset(240, 40), Font = K.BLACK,
	TextSize = 32, TextColor3 = C.good, TextXAlignment = Enum.TextXAlignment.Right, Text = "" }, panel)
local chips = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, PADY + 4), Size = UDim2.fromOffset(300, 32) }, panel)
local cl = K.hlist(chips, 6); cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
local function chip(text: string, order: number): TextButton
	local b = make("TextButton", { Text = text, Font = K.BOLD, TextSize = 13, TextColor3 = C.chipText, BackgroundColor3 = C.chip, BackgroundTransparency = 0,
		AutomaticSize = Enum.AutomaticSize.X, Size = UDim2.fromOffset(0, 32), LayoutOrder = order, Selectable = true }, chips)
	K.corner(b, 3); K.stroke(b, C.line, 1, 0); K.pad(b, 13, 0)
	b.MouseEnter:Connect(function() b.BackgroundColor3 = C.itHover end)
	b.MouseLeave:Connect(function() b.BackgroundColor3 = C.chip end)
	return b
end
local quickB = chip("⚡  " .. spaced("ACHAT RAPIDE", 0), 1)
local rebuyB = chip("🔄  " .. spaced("RACHETER", 0), 2)

-- grille (défile si l'écran est petit, comme .panel { max-height: 96vh; overflow: auto })
local TOP = PADY + 40 + 14
local FOOT = 12 + 16 + 10 + 38 + PADY
local grid = make("ScrollingFrame", { Position = UDim2.fromOffset(PADX, TOP), Size = UDim2.new(1, -PADX * 2 + 8, 1, -TOP - FOOT), BackgroundTransparency = 1,
	ScrollBarThickness = 5, ScrollBarImageColor3 = C.line, CanvasSize = UDim2.new(), AutomaticCanvasSize = Enum.AutomaticSize.Y,
	ScrollingDirection = Enum.ScrollingDirection.Y, BorderSizePixel = 0 }, panel)
local foot = make("TextLabel", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, PADX, 1, -(PADY + 38 + 10)), Size = UDim2.new(1, -PADX * 2, 0, 16),
	Font = K.MED, TextSize = 11, TextColor3 = C.foot, Text = "" }, panel)
local closeB = make("TextButton", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -PADY), Size = UDim2.fromOffset(150, 38), Font = K.BLACK,
	TextSize = 14, TextColor3 = C.text, BackgroundColor3 = C.navy, BackgroundTransparency = 0, Text = spaced("FERMER", 1), Selectable = true }, panel)
K.corner(closeB, 3); K.stroke(closeB, C.text, 1, 0.88)
closeB.MouseEnter:Connect(function() closeB.BackgroundColor3 = C.itHover end)
closeB.MouseLeave:Connect(function() closeB.BackgroundColor3 = C.navy end)

local toast = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.62), Size = UDim2.fromOffset(700, 26), Font = K.BOLD,
	TextSize = 17, TextColor3 = rgb(0xff6b6b), Text = "", TextStrokeTransparency = 0.5, BackgroundTransparency = 1 },
	make("ScreenGui", { Name = "BuyToast", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 12 }, player:WaitForChild("PlayerGui")))
local toastN = 0
local function showToast(t: string)
	toastN += 1
	local my = toastN
	toast.Text = t
	task.delay(1.8, function() if my == toastN then toast.Text = "" end end)
end

-- ---------- cartes ----------
type Card = { b: TextButton, k: string, price: number, slot: number?, name: TextLabel, tag: TextLabel, stroke: UIStroke,
	icon: ViewportFrame?, bars: { Frame }, can: boolean, own: boolean, hover: boolean }
local cards: { Card } = {}

-- image de l'arme (weaponImg du web) : modèle 3D vu de côté, canon vers la gauche
local function weaponIcon(parent: Instance, key: string, size: Vector2, pos: UDim2): ViewportFrame
	local vf = make("ViewportFrame", { Size = UDim2.fromOffset(size.X, size.Y), Position = pos, BackgroundTransparency = 1,
		Ambient = Color3.fromRGB(170, 175, 190), LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(0.4, -1, 0.3) }, parent)
	task.spawn(function()
		local ok, m = pcall(WeaponModels.build, key, 1)
		if not ok or not m or not vf.Parent then return end
		local model = m :: Model
		pcall(SkinPaint.apply, model, player:GetAttribute("Skin_" .. key) :: number?, player:GetAttribute("Camo_" .. key) :: string?)
		model.Parent = vf
		local cf, ext = model:GetBoundingBox()
		local cam = Instance.new("Camera"); cam.FieldOfView = 16
		local tv = math.tan(math.rad(8))
		local dist = math.max(ext.Y / 2 / tv, ext.Z / 2 / (tv * size.X / size.Y)) * 1.05 + ext.X
		cam.CFrame = CFrame.lookAt(cf.Position - Vector3.new(dist, 0, 0), cf.Position)
		cam.Parent = vf; vf.CurrentCamera = cam
	end)
	return vf
end

local function paint(c: Card)
	local dim = if c.can or c.own then 0 else DIM
	c.b.BackgroundColor3 = if c.own then C.own elseif c.hover and c.can then C.itHover else C.it
	c.b.BackgroundTransparency = dim * 0.6
	c.stroke.Color = if c.own then C.ownLine elseif c.hover and c.can then C.accent else C.line
	c.stroke.Transparency = dim
	c.name.TextTransparency = dim
	c.tag.TextTransparency = dim
	c.tag.TextColor3 = if c.own then C.ownLine else C.good
	if c.icon then c.icon.ImageTransparency = dim end
	for _, bar in ipairs(c.bars) do bar.BackgroundTransparency = dim end
	c.b.AutoButtonColor = false
end

local buy: (k: string) -> ()
local function newCard(parent: Instance, k: string, label: string, price: number, slot: number?, weapon: boolean, y: number): Card
	local h = if weapon then 76 else 32
	local b = make("TextButton", { Text = "", Position = UDim2.fromOffset(0, y), Size = UDim2.new(1, 0, 0, h), BackgroundTransparency = 0, BackgroundColor3 = C.it,
		Selectable = true }, parent)
	local stroke = K.stroke(b, C.line, 1, 0)
	local name = make("TextLabel", { Position = UDim2.fromOffset(10, if weapon then 7 else 0), Size = UDim2.new(1, -110, 0, if weapon then 16 else h), Font = K.BLACK,
		TextSize = 13, TextColor3 = C.text, TextXAlignment = Enum.TextXAlignment.Left, TextTruncate = Enum.TextTruncate.AtEnd, Text = label }, b)
	local tag = make("TextLabel", { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -10, 0, if weapon then 7 else 0), Size = UDim2.fromOffset(150, if weapon then 16 else h),
		Font = K.BLACK, TextSize = 12, TextColor3 = C.good, TextXAlignment = Enum.TextXAlignment.Right, Text = "" }, b)
	local c: Card = { b = b, k = k, price = price, slot = slot, name = name, tag = tag, stroke = stroke, icon = nil, bars = {}, can = false, own = false, hover = false }
	if weapon then
		c.icon = weaponIcon(b, k, Vector2.new(84, 26), UDim2.fromOffset(8, 27))
		local w = Config.WEAPONS[k]
		local pel = w.pellets or 1
		local pct = {
			math.clamp(w.dmg * (if pel > 1 then pel * 0.45 else 1) * 0.8, 8, 100),
			math.clamp(w.rpm / 10, 6, 100),
			math.clamp(100 - w.spread * 14, 8, 100),
		}
		local cols = { C.accent, C.blue, C.good }
		for i = 1, 3 do
			local bar = make("Frame", { Position = UDim2.fromOffset(10, 57 + (i - 1) * 5), Size = UDim2.new((pct[i] / 100) * (CW - 20) / CW, 0, 0, 3),
				BackgroundTransparency = 0, BackgroundColor3 = cols[i] }, b)
			K.corner(bar, 2)
			table.insert(c.bars, bar)
		end
	end
	b.MouseEnter:Connect(function() c.hover = true; paint(c) end)
	b.MouseLeave:Connect(function() c.hover = false; paint(c) end)
	b.SelectionGained:Connect(function() c.hover = true; paint(c) end)
	b.SelectionLost:Connect(function() c.hover = false; paint(c) end)
	b.Activated:Connect(function() buy(k) end)
	table.insert(cards, c)
	return c
end

-- colonnes : 4 par ligne, la hauteur d'une ligne = sa colonne la plus haute
local function column(title: string, x: number, y: number): Frame
	local col = make("Frame", { Position = UDim2.fromOffset(x, y), Size = UDim2.fromOffset(CW, 0) }, grid)
	make("TextLabel", { Size = UDim2.new(1, 0, 0, 16), Font = K.BOLD, TextSize = 10, TextColor3 = C.dim, TextXAlignment = Enum.TextXAlignment.Left,
		Text = spaced(string.upper(title), 2) }, col)
	return col
end
local cols: { { title: string, list: { any }, weapon: boolean } } = {}
for _, cat in ipairs(Modes.BUY_CATS) do table.insert(cols, { title = cat.n, list = cat.list, weapon = true }) end
table.insert(cols, { title = "ÉQUIPEMENT", list = Modes.BUY_ITEMS, weapon = false })
local kitCard: Card? = nil
local rowY = 0
local i = 1
while i <= #cols do
	local rowH = 0
	for j = 0, 3 do
		local cdef = cols[i + j]
		if not cdef then break end
		local col = column(cdef.title, j * (CW + GAP), rowY)
		local y = 22
		for _, it in ipairs(cdef.list) do
			if cdef.weapon then
				local w = Config.WEAPONS[it]
				newCard(col, it, w.name, w.price, w.slot, true, y); y += 76 + 6
			else
				local c = newCard(col, it.k, it.n, it.price, nil, false, y); y += 32 + 6
				if it.k == "kit" then kitCard = c end
			end
		end
		if not cdef.weapon then
			make("TextLabel", { Position = UDim2.fromOffset(0, y + 2), Size = UDim2.new(1, 0, 0, 34), Font = K.MED, TextSize = 11, TextColor3 = C.foot, RichText = true,
				TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top, TextWrapped = true, LineHeight = 1.25,
				Text = 'Barres : <font color="#ff4655">dégâts</font> · <font color="#4aa3ff">cadence</font> · <font color="#7dff9f">précision</font><br/>'
					.. 'Le <b><font color="#5ad8ff">bouclier</font></b> absorbe les dégâts avant le gilet et la santé.' }, col)
			y += 40
		end
		col.Size = UDim2.fromOffset(CW, y)
		rowH = math.max(rowH, y)
	end
	rowY += rowH + GAP
	i += 4
end
local GRID_H = rowY - GAP
make("Frame", { Position = UDim2.fromOffset(0, GRID_H), Size = UDim2.fromOffset(1, 1) }, grid)   -- fond de la zone qui défile

-- ---------- état ----------
local st: any = nil
local open = false
local mode = ""
local phase: string? = nil

local function owned(k: string): boolean
	local s = st
	if not s then return false end
	if k == "armor" then return (s.armor or 0) >= 100 elseif k == "shield1" then return (s.shield or 0) >= 25
	elseif k == "shield2" then return (s.shield or 0) >= 50 elseif k == "kit" then return s.kit == true
	elseif k == "frag" then return (s.frag or 0) >= 1 elseif k == "flash" then return (s.flash or 0) >= 2
	elseif k == "smoke" then return (s.smoke or 0) >= 1 elseif k == "mine" then return (s.mine or 0) >= 2 end
	return s.primary == k or s.secondary == k
end
local function render()
	local s = st
	if not s then return end
	local free = s.free == true
	title.Text = if mode == "duel" then spaced("CHOISIS TON ARME", 2)
		elseif s.dm then spaced("ARMURERIE", 2) .. '  <font size="13" color="#7dff9f">' .. spaced("GRATUITE", 1) .. "</font>"
		else spaced("BOUTIQUE", 2)
	money.Text = if free then "" else "$" .. tostring(s.money or 0)
	foot.Text = if s.dm then "B ou Échap : fermer  •  l'arme achetée est donnée tout de suite"
		else "B ou Échap : fermer  •  les achats ne sont possibles qu'en début de manche"
	for _, c in ipairs(cards) do
		local own = owned(c.k)
		local pistolLock = s.pistol == true and c.slot == 0
		c.own = own
		c.can = (free or (s.money or 0) >= c.price) and not own and not pistolLock and s.phase == "freeze"
		c.tag.Text = if own then "ÉQUIPÉ" elseif pistolLock then "MANCHE PISTOLET" elseif free then "GRATUIT" else "$" .. c.price
		paint(c)
	end
	if kitCard then kitCard.b.Visible = s.team == CT and s.bombMode == true end
end
local function fetch(k: string?): any
	local fn = remote()
	if not fn then return nil end
	local ok, res = pcall(function() return fn:InvokeServer(k) end)
	return if ok then res else nil
end
buy = function(k: string)
	if not open then return end
	local res = fetch(k)
	if not res or res.closed then return end
	st = res
	pcall(Sfx.play, if res.ok then "buy" else "deny")
	if res.msg then showToast(res.msg) end
	render()
end
local function buyQuiet(k: string): boolean
	local res = fetch(k)
	if not res or res.closed then return false end
	st = res
	return res.ok == true
end

-- ⚡ ACHAT RAPIDE (quickBuy du web) : un fusil si pas d'arme principale, gilet, bouclier, kit (CT), grenades
quickB.Activated:Connect(function()
	if not open or not st then return end
	if not st.primary then
		for _, k in ipairs({ "m4", "ak", "famas", "galil", "mp9", "ump" }) do
			if (st.free or (st.money or 0) >= Config.WEAPONS[k].price) and buyQuiet(k) then break end
		end
	end
	buyQuiet("armor")
	if st.free or (st.money or 0) >= 1000 then buyQuiet("shield2") else buyQuiet("shield1") end
	if st.team == CT and st.bombMode then buyQuiet("kit") end
	buyQuiet("frag"); buyQuiet("flash"); buyQuiet("smoke")
	pcall(Sfx.play, "buy")
	render()
end)
-- 🔄 RACHETER (rebuy du web) : les armes choisies dans l'arsenal, gilet, frag
rebuyB.Activated:Connect(function()
	if not open or not st then return end
	local p, s = player:GetAttribute("Primary"), player:GetAttribute("Secondary")
	if typeof(p) == "string" and Config.WEAPONS[p] then buyQuiet(p) end
	if typeof(s) == "string" and Config.WEAPONS[s] then buyQuiet(s) end
	buyQuiet("armor"); buyQuiet("frag")
	pcall(Sfx.play, "buy")
	render()
end)

local function fit()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	scale.Scale = math.clamp(math.min(vp.X / 1600, vp.Y / 900), 0.45, 2)
	-- panneau : hauteur du contenu, au plus 96 % de l'écran
	local need = TOP + GRID_H + FOOT
	panel.Size = UDim2.fromOffset(PW, math.min(need, math.floor(900 * 0.96)))
end

local function setOpen(on: boolean)
	if on == open then return end
	open = on
	gui.Enabled = on; modal.Visible = on
	player:SetAttribute("UiOpen", if on then true else nil)
	if on then
		fit()
		grid.CanvasPosition = Vector2.zero
		render()
		task.spawn(function()
			local res = fetch(nil)
			if not open then return end
			if not res then setOpen(false); return end
			if res.closed then setOpen(false); showToast(res.closed); return end
			st = res; render()
		end)
	end
end
closeB.Activated:Connect(function() setOpen(false) end)

local function inMatch(): boolean return player:GetAttribute("Zone") == "match" end
local function tryOpen()
	if not inMatch() or player:GetAttribute("MenuOpen") == true then return end
	mode = tostring(player:GetAttribute("MatchMode") or "")
	if ROUND_MODES[mode] and phase ~= nil and phase ~= "freeze" then showToast("Achats possibles seulement en début de manche"); return end
	setOpen(true)
end

ContextActionService:BindActionAtPriority("BuyMenu", function(_, state)
	if not inMatch() then return Enum.ContextActionResult.Pass end
	if state == Enum.UserInputState.Begin then
		if open then setOpen(false) else tryOpen() end
	end
	return Enum.ContextActionResult.Sink
end, false, Enum.ContextActionPriority.High.Value + 10, Enum.KeyCode.B, Enum.KeyCode.DPadLeft)
ContextActionService:BindActionAtPriority("BuyMenuClose", function(_, state)
	if not open then return Enum.ContextActionResult.Pass end
	if state == Enum.UserInputState.Begin then setOpen(false) end
	return Enum.ContextActionResult.Sink
end, false, Enum.ContextActionPriority.High.Value + 10, Enum.KeyCode.Escape, Enum.KeyCode.ButtonB)

-- bouton tactile ACHAT (téléphones)
local touchGui = make("ScreenGui", { Name = "BuyTouch", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 11, Enabled = UserInputService.TouchEnabled },
	player:WaitForChild("PlayerGui"))
local touchB = make("TextButton", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(1, -230, 1, -260), Size = UDim2.fromOffset(78, 78), BackgroundColor3 = Color3.new(),
	BackgroundTransparency = 0.45, Text = "ACHAT", TextColor3 = C.text, TextSize = 14, Font = K.BLACK, Visible = false }, touchGui)
make("UICorner", { CornerRadius = UDim.new(1, 0) }, touchB)
K.stroke(touchB, C.text, 2, 0.5)
touchB.Activated:Connect(function() if open then setOpen(false) else tryOpen() end end)

-- phase des modes à manches (TDMState), pour fermer la boutique quand la manche démarre
local stateRemote = ReplicatedStorage:WaitForChild("TDMState", 30)
if stateRemote and stateRemote:IsA("RemoteEvent") then
	stateRemote.OnClientEvent:Connect(function(s: any)
		if typeof(s) ~= "table" then return end
		if s.mode then mode = tostring(s.mode) end
		local d = s.data
		phase = if typeof(d) == "table" and d.kind == "rounds" then d.phase else nil
		if open and ROUND_MODES[mode] and phase ~= nil and phase ~= "freeze" then setOpen(false) end
		touchB.Visible = inMatch() and not open
	end)
end
local function onZone()
	if not inMatch() then setOpen(false); phase = nil end
	touchB.Visible = inMatch() and not open
end
player:GetAttributeChangedSignal("Zone"):Connect(onZone)
player:GetAttributeChangedSignal("MenuOpen"):Connect(function() if player:GetAttribute("MenuOpen") == true then setOpen(false) end end)
local cam = workspace.CurrentCamera
if cam then cam:GetPropertyChangedSignal("ViewportSize"):Connect(function() if open then fit() end end) end
onZone()
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="796">
        <Properties>
          <string name="Name">CinematicController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/CinematicController (LocalScript)
-- Arrivée au début d'une partie en équipe, comme le jeu web :
--   src/65_cine.js   hélicoptère : plan d'ensemble au-dessus des toits, vue à la première personne depuis la cabine
--                    (pilotes, coéquipiers sur les bancs, porte ouverte), coéquipiers qui descendent en rappel, puis notre
--                    propre descente le long de la corde jusqu'au sol (ou saut depuis la porte si le départ est couvert) ;
--   src/65b_car.js   véhicule : camion (Village, Station polaire) ou blindé (Port de nuit, Métro, Laboratoire, Asile, et
--                    toute carte où l'on démarre sous un toit) sur une route qui longe la carte : plan au bord de la route,
--                    vue assise dans la cellule, freinage, portes arrière (ou hayon) qui s'ouvrent, descente, sortie.
-- Bandes noires, titres (carte, mode, camp, puis objectif), sons (rotor, moteur, freinage, portes), flash blanc final,
-- puis la main revient au joueur en vue à la première personne. Espace, Entrée, clic ou toucher l'écran : passer.
-- Déclenchée par le serveur (ServerScriptService/ArrivalService, remote « ArrivalCinematic ») au début de chaque partie
-- en équipe, pendant « PRÉPAREZ-VOUS » : le serveur garde tout le monde immobile et attend la fin (ou le passage) de
-- la scène de chacun, puis le compte à rebours reprend.
-- Les coéquipiers (joueurs et bots) sont des copies figées de leurs soldats, posées et animées ici (assis, rappel,
-- marche) ; les vrais restent cachés à leur point de départ pendant la scène.
-- Tous les calculs sont en mètres dans le repère de la carte du web (x, z de 0 à 80, sol à 0), comme sur le web.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local SoundService = game:GetService("SoundService")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local Modes = require(ReplicatedStorage.Shared.Modes)
local S = require(ReplicatedStorage.Shared.ClientState)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local VM = require(ReplicatedStorage.Shared.VehicleModels)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local U = Config.STUDS_PER_METER
local remote = ReplicatedStorage:WaitForChild("ArrivalCinematic", math.huge) :: RemoteEvent

-- carte -> véhicule (CAR_MAPS du web) ; les autres cartes gardent l'hélicoptère, sauf départ sous un toit (blindé)
local CAR_MAPS: { [string]: string } = { metro = "blinde", labo = "blinde", asile = "blinde", harbor = "blinde", village = "camion_sable", station = "camion_vert" }

-- ---------- petits calculs (65_cine.js) ----------
local pi, sin, cos, abs, max, min = math.pi, math.sin, math.cos, math.abs, math.max, math.min
local function clamp(x: number, a: number, b: number): number return if x < a then a elseif x > b then b else x end
local function lerp(a: number, b: number, k: number): number return a + (b - a) * k end
local function easeOut(t: number): number t = clamp(t, 0, 1); return 1 - (1 - t) ^ 3 end
local function easeIO(t: number): number t = clamp(t, 0, 1); return t * t * (3 - 2 * t) end
local function angDiff(a: number, b: number): number local d = (b - a) % (2 * pi); if d > pi then d -= 2 * pi end; return d end
local function V(x: number, y: number, z: number): Vector3 return Vector3.new(x, y, z) end
local function E(x: number, y: number, z: number): CFrame return CFrame.fromEulerAnglesYXZ(x, y, z) end   -- Euler « YXZ » de three.js
-- interpolation par images-clés { temps, valeur }
local function keyAt(K: { { number } }, T: number): number
	if T <= K[1][1] then return K[1][2] end
	for i = 2, #K do
		if T <= K[i][1] then local a, b = K[i - 1], K[i]; return lerp(a[2], b[2], easeIO((T - a[1]) / (b[1] - a[1]))) end
	end
	return K[#K][2]
end
local LOOKA = { { 2.6, 0.12 }, { 3.4, 0.12 }, { 4.6, 0.85 }, { 6.2, 1.0 }, { 7.2, -0.35 }, { 7.9, -0.7 }, { 8.9, -0.8 }, { 9.5, 1.5 } }
local LOOKP = { { 2.6, -0.1 }, { 3.4, -0.12 }, { 4.6, -0.45 }, { 6.2, -0.55 }, { 7.2, -0.18 }, { 7.9, -0.38 }, { 8.9, -0.42 }, { 9.5, -1.0 } }
local CLOOKA = { { 2.4, 0.05 }, { 3.3, -0.1 }, { 4.3, -1.15 }, { 5.3, -1.25 }, { 6.0, -0.2 }, { 6.8, 2.6 } }
local CLOOKP = { { 2.4, -0.08 }, { 3.3, -0.1 }, { 4.3, -0.22 }, { 5.3, -0.2 }, { 6.0, -0.1 }, { 6.8, -0.12 } }
local ARR = 7.6              -- fin de l'approche de l'hélicoptère
local CAR_STOP = 6.0         -- arrêt du véhicule

-- ==========================================================================================
-- Interface : bandes noires, titres, « passer », flash blanc (#cine et #flashfx du web)
-- ==========================================================================================
local GAP = "\u{2009}"
local function spaced(s: string): string
	local out = {}
	for _, cp in utf8.codes(s) do table.insert(out, utf8.char(cp)) end
	return table.concat(out, GAP)
end
local gui = Instance.new("ScreenGui")
gui.Name = "ArrivalCinematic"; gui.IgnoreGuiInset = true; gui.ResetOnSpawn = false; gui.DisplayOrder = 60; gui.Enabled = false
gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
local bars: { Frame } = {}
for i = 1, 2 do
	local f = Instance.new("Frame"); f.Name = "Bar" .. i; f.BorderSizePixel = 0; f.BackgroundColor3 = Color3.new(0, 0, 0)
	f.Size = UDim2.fromScale(1, 0.11); f.Position = UDim2.fromScale(0, if i == 1 then 0 else 0.89); f.Parent = gui
	table.insert(bars, f)
end
local function label(name: string, pos: UDim2, size: UDim2, font: Enum.Font, color: Color3, maxSize: number, align: Enum.TextXAlignment): TextLabel
	local t = Instance.new("TextLabel"); t.Name = name; t.BackgroundTransparency = 1; t.Position = pos; t.Size = size
	t.Font = font; t.TextColor3 = color; t.TextScaled = true; t.TextXAlignment = align; t.TextYAlignment = Enum.TextYAlignment.Bottom
	t.TextStrokeTransparency = 0.55; t.TextStrokeColor3 = Color3.new(0, 0, 0); t.Text = ""
	local c = Instance.new("UITextSizeConstraint"); c.MaxTextSize = maxSize; c.MinTextSize = 10; c.Parent = t
	t.Parent = gui
	return t
end
-- titre : 3,4 rem, très gras, en bas à gauche ; sous-titre doré (--gold du web) ; « ESPACE — PASSER » à droite
local title = label("Title", UDim2.new(0.07, 0, 0.81, -62), UDim2.new(0.86, 0, 0, 60), Enum.Font.GothamBlack, Color3.new(1, 1, 1), 54, Enum.TextXAlignment.Left)
local sub = label("Sub", UDim2.new(0.072, 0, 0.85, -22), UDim2.new(0.8, 0, 0, 22), Enum.Font.GothamBold, Color3.fromRGB(255, 215, 94), 18, Enum.TextXAlignment.Left)
local skipLbl = label("Skip", UDim2.new(0.55, 0, 0.87, -14), UDim2.new(0.42, 0, 0, 14), Enum.Font.GothamMedium, Color3.new(1, 1, 1), 12, Enum.TextXAlignment.Right)
skipLbl.TextTransparency = 0.33; skipLbl.TextStrokeTransparency = 1
local flash = Instance.new("Frame"); flash.Name = "Flash"; flash.BorderSizePixel = 0; flash.BackgroundColor3 = Color3.new(1, 1, 1)
flash.BackgroundTransparency = 1; flash.Size = UDim2.fromScale(1, 1); flash.ZIndex = 5; flash.Parent = gui
gui.Parent = player:WaitForChild("PlayerGui")

-- titres qui glissent depuis la gauche en apparaissant (animation cinein du web, 1 s)
local titleT0 = 0
local function setTitles(a: string, b: string)
	title.Text = spaced(string.upper(a)); sub.Text = spaced(b)
	titleT0 = os.clock()
end
local function animTitles()
	local k = 1 - (1 - clamp((os.clock() - titleT0) / 1.0, 0, 1)) ^ 3
	title.TextTransparency = 1 - k; title.Position = UDim2.new(0.07, -60 * (1 - k), 0.81, -62)
	title.TextStrokeTransparency = 1 - 0.45 * k
end

-- ==========================================================================================
-- Sons : boucles du rotor et du moteur (startHeli / startEngine du web, bruit filtré modulé) et bruitages
-- ==========================================================================================
type Loop = { set: (number) -> (), tick: (number) -> (), stop: () -> () }
local function loopSound(id: string, speed: number, vol: number, high: number, mid: number, low: number): (Sound, EqualizerSoundEffect)
	local s = Instance.new("Sound"); s.SoundId = id; s.Looped = true; s.Volume = vol; s.PlaybackSpeed = speed
	local eq = Instance.new("EqualizerSoundEffect"); eq.HighGain = high; eq.MidGain = mid; eq.LowGain = low; eq.Parent = s
	s.SoundGroup = Sfx.group("ambient") or Sfx.group("master")
	s.Parent = SoundService
	s:Play()
	return s, eq
end
-- hélicoptère : souffle des pales haché à 12 Hz + grondement grave de la turbine
local function startHeli(): Loop
	local blades, beq = loopSound("rbxasset://sounds/action_falling.mp3", 0.42, 0.3, -22, -4, 6)
	local turb = loopSound("rbxasset://sounds/action_falling.mp3", 0.2, 0.15, -30, -8, 8)
	local v, t = 0.45, 0
	return {
		set = function(x: number) v = x end,
		tick = function(dt: number)
			t += dt
			local chop = 0.55 + 0.45 * sin(t * 12 * 2 * pi)
			blades.Volume = (0.12 + 0.35 * v) * (0.45 + 0.55 * chop) * 1.6
			beq.HighGain = -26 + 8 * v
			turb.Volume = (0.05 + 0.12 * v) * 1.5
		end,
		stop = function() blades:Destroy(); turb:Destroy() end,
	}
end
-- moteur : grondement dont le régime suit la vitesse
local function startEngine(): Loop
	local eng, eeq = loopSound("rbxasset://sounds/action_falling.mp3", 0.16, 0.1, -32, -10, 10)
	local road = loopSound("rbxasset://sounds/action_swim.mp3", 0.5, 0.05, -20, -6, 2)
	local v, t = 0, 0
	return {
		set = function(x: number) v = x end,
		tick = function(dt: number)
			t += dt
			local rpm = 8 + 18 * v                                     -- cognement du diesel
			eng.PlaybackSpeed = 0.14 + 0.16 * v
			eng.Volume = (0.08 + 0.12 * v) * (0.75 + 0.25 * sin(t * rpm * 2 * pi)) * 1.8
			eeq.MidGain = -12 + 6 * v
			road.Volume = 0.02 + 0.1 * v
		end,
		stop = function() eng:Destroy(); road:Destroy() end,
	}
end
-- bruitage court (sons fournis avec Roblox), coupé en fondu après len secondes
local function oneShot(id: string, speed: number, vol: number, len: number, high: number?)
	local s = Instance.new("Sound"); s.SoundId = id; s.PlaybackSpeed = speed; s.Volume = vol
	if high then local eq = Instance.new("EqualizerSoundEffect"); eq.HighGain = high; eq.MidGain = 0; eq.LowGain = 4; eq.Parent = s end
	s.SoundGroup = Sfx.group("ui") or Sfx.group("master")
	s.Parent = SoundService; s:Play()
	task.delay(len, function()
		for i = 1, 6 do if s.Parent then s.Volume = vol * (1 - i / 6); task.wait(0.04) end end
		s:Destroy()
	end)
	Debris:AddItem(s, len + 2)
end
local function sndBrake() oneShot("rbxasset://sounds/action_falling.mp3", 1.7, 0.35, 0.9, 6) end      -- frein à air
local function sndDoor()                                                                             -- portes métalliques
	oneShot("rbxasset://sounds/clickfast.wav", 0.55, 0.6, 0.3)
	task.delay(0.08, function() oneShot("rbxasset://sounds/swordhit.wav", 0.42, 0.45, 0.6, -8) end)
end
local function sndRope() Sfx.play("slide", nil, 0.8) end                                             -- glisse le long de la corde
local function sndLand() Sfx.play("land", nil, 1.1) end

-- ==========================================================================================
-- Soldats figés (copies) : assis, debout, en marche
-- ==========================================================================================
local R15 = { HumanoidRootPart = true, Head = true, UpperTorso = true, LowerTorso = true, LeftUpperArm = true, LeftLowerArm = true,
	LeftHand = true, RightUpperArm = true, RightLowerArm = true, RightHand = true, LeftUpperLeg = true, LeftLowerLeg = true,
	LeftFoot = true, RightUpperLeg = true, RightLowerLeg = true, RightFoot = true, Torso = true, ["Left Leg"] = true, ["Right Leg"] = true,
	["Left Arm"] = true, ["Right Arm"] = true }
type Ghost = {
	model: Model, body: { BasePart }, rel: { CFrame }, leg: { string }, extra: { BasePart }, host: { number }, hrel: { CFrame },
	hipL: Vector3, hipR: Vector3, kneeL: Vector3, kneeR: Vector3, thigh: number, hOff: number,
}
local function makeGhost(src: Model): Ghost?
	local hrp0 = src:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp0 then return nil end
	local was = src.Archivable
	src.Archivable = true
	local ok, copy = pcall(function() return src:Clone() end)
	src.Archivable = was
	if not ok or not copy then return nil end
	local model = copy :: Model
	model.Name = "Arrivee_" .. src.Name
	local held = model:FindFirstChild("HeldWeapon"); if held then held:Destroy() end
	local hrp = model:FindFirstChild("HumanoidRootPart") :: BasePart?
	if not hrp then model:Destroy(); return nil end
	local h0 = hrp.CFrame
	local g: Ghost = { model = model, body = {}, rel = {}, leg = {}, extra = {}, host = {}, hrel = {},
		hipL = Vector3.zero, hipR = Vector3.zero, kneeL = Vector3.zero, kneeR = Vector3.zero, thigh = 0, hOff = 3 }
	local index: { [BasePart]: number } = {}
	local all: { BasePart } = {}
	-- liens pièce -> membre porteur, lus avant de supprimer les articulations
	local link: { [BasePart]: BasePart } = {}
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("BasePart") then table.insert(all, d)
		elseif d:IsA("JointInstance") or d:IsA("WeldConstraint") then
			local a, b = (d :: any).Part0 :: BasePart?, (d :: any).Part1 :: BasePart?
			if a and b then
				if R15[a.Name] and not R15[b.Name] then link[b] = a elseif R15[b.Name] and not R15[a.Name] then link[a] = b end
			end
		end
	end
	local minY = math.huge
	for _, p in ipairs(all) do
		if R15[p.Name] and p.Parent == model then
			table.insert(g.body, p); table.insert(g.rel, h0:Inverse() * p.CFrame); index[p] = #g.body
			table.insert(g.leg, if string.find(p.Name, "Leg") or string.find(p.Name, "Foot") then (if string.sub(p.Name, 1, 4) == "Left" then "L" else "R") else "")
			if string.find(p.Name, "Foot") or p.Name == "Left Leg" or p.Name == "Right Leg" then minY = min(minY, p.Position.Y - p.Size.Y / 2) end
		end
	end
	for _, p in ipairs(all) do
		if not index[p] then
			local host = link[p]
			if not host or not index[host] then
				local best, bd = g.body[1], math.huge
				for _, b in ipairs(g.body) do local dd = (b.Position - p.Position).Magnitude; if dd < bd then best, bd = b, dd end end
				host = best
			end
			if host and index[host] then
				table.insert(g.extra, p); table.insert(g.host, index[host]); table.insert(g.hrel, host.CFrame:Inverse() * p.CFrame)
			end
		end
	end
	for _, d in ipairs(model:GetDescendants()) do
		if d:IsA("JointInstance") or d:IsA("WeldConstraint") or d:IsA("Constraint") or d:IsA("Script") or d:IsA("LocalScript")
			or d:IsA("ModuleScript") or d:IsA("Highlight") or d:IsA("BillboardGui") or d:IsA("Sound") or d:IsA("ForceField") then
			d:Destroy()
		elseif d:IsA("BasePart") then
			d.Anchored = true; d.CanCollide = false; d.CanQuery = false; d.CanTouch = false; d.LocalTransparencyModifier = 0
		elseif d:IsA("Humanoid") then
			d.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
			d.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
			d.EvaluateStateMachine = false
		end
	end
	-- hanches et genoux (haut des cuisses et des tibias), longueur de cuisse, hauteur du bassin au-dessus des semelles
	local function top(name: string): Vector3?
		local p = model:FindFirstChild(name) :: BasePart?
		if not p or not index[p] then return nil end
		return (h0:Inverse() * p.CFrame * CFrame.new(0, p.Size.Y / 2, 0)).Position
	end
	g.hipL = top("LeftUpperLeg") or V(-0.5, -1, 0); g.hipR = top("RightUpperLeg") or V(0.5, -1, 0)
	g.kneeL = top("LeftLowerLeg") or g.hipL - V(0, 1.4, 0); g.kneeR = top("RightLowerLeg") or g.hipR - V(0, 1.4, 0)
	g.thigh = (g.hipL - g.kneeL).Magnitude
	g.hOff = if minY < math.huge then h0.Position.Y - minY else 3
	return g
end

-- pose : feet = repère au niveau des semelles (studs, regard vers -Z) ; thL/thR = cuisses levées vers l'avant (rad),
-- knee = genoux pliés (rad, négatif : le tibia revient sous le genou). Renvoie les pièces et leurs repères.
local function poseGhost(g: Ghost, feet: CFrame, thL: number, thR: number, knee: number, outP: { BasePart }, outC: { CFrame })
	local th = max(thL, thR)
	local root = feet * CFrame.new(0, g.hOff - g.thigh * (1 - cos(th)), 0)
	local T1L = CFrame.new(g.hipL) * CFrame.Angles(thL, 0, 0) * CFrame.new(-g.hipL)
	local T1R = CFrame.new(g.hipR) * CFrame.Angles(thR, 0, 0) * CFrame.new(-g.hipR)
	local kL, kR = T1L * g.kneeL, T1R * g.kneeR
	local T2L = CFrame.new(kL) * CFrame.Angles(knee, 0, 0) * CFrame.new(-kL) * T1L
	local T2R = CFrame.new(kR) * CFrame.Angles(knee, 0, 0) * CFrame.new(-kR) * T1R
	local now: { CFrame } = table.create(#g.body)
	for i, p in ipairs(g.body) do
		local side = g.leg[i]
		local L = CFrame.identity
		if side ~= "" then
			local upper = string.find(p.Name, "Upper") ~= nil or p.Name == "Left Leg" or p.Name == "Right Leg"
			if side == "L" then L = if upper then T1L else T2L else L = if upper then T1R else T2R end
		end
		local cf = root * L * g.rel[i]
		now[i] = cf
		table.insert(outP, p); table.insert(outC, cf)
	end
	for i, p in ipairs(g.extra) do table.insert(outP, p); table.insert(outC, now[g.host[i]] * g.hrel[i]) end
end

-- ==========================================================================================
-- Scène
-- ==========================================================================================
local playing = false
local abortRun: (() -> ())? = nil   -- remise en état de la scène en cours (appelée aussi si elle plante)

local function run(info: any)
	if playing then return end
	playing = true
	local function done() pcall(function() remote:FireServer("done") end) end
	-- ---------- carte, joueur, équipe ----------
	local folder = workspace:FindFirstChild(tostring(player:GetAttribute("MatchMap") or ""))
	local origin = folder and folder:GetAttribute("Origin")
	local mapId = folder and folder:GetAttribute("MapId")
	local char = player.Character
	local t0 = os.clock()
	while (not char or not char:FindFirstChild("HumanoidRootPart")) and os.clock() - t0 < 4 do task.wait(0.1); char = player.Character end
	local hrp = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not folder or typeof(origin) ~= "Vector3" or typeof(mapId) ~= "string" or not char or not hrp or not hum then playing = false; done(); return end
	local O: Vector3 = origin
	local M = (folder:GetAttribute("MapSize") :: number? or MapData.N * Config.CELL * U) / U   -- côté de la carte (m)
	local function toW(p: Vector3): Vector3 return O + p * U end
	local function toL(p: Vector3): Vector3 return (p - O) / U end
	local function cfW(posL: Vector3, rot: CFrame): CFrame return CFrame.new(toW(posL)) * rot end
	-- rayons : collision de la carte, sans les murs invisibles du bord
	local hitList = {}
	local col = folder:FindFirstChild("Collision")
	for _, c in ipairs(if col then col:GetChildren() else {}) do if c:IsA("BasePart") and c.Name ~= "Border" then table.insert(hitList, c) end end
	local rp = RaycastParams.new(); rp.FilterType = Enum.RaycastFilterType.Include; rp.FilterDescendantsInstances = hitList
	-- hauteur du décor autour d'un point (cineTopAt du web)
	local function topAt(x: number, z: number, r: number): number
		local top = -1e9
		for _, d in ipairs({ { 0, 0 }, { r, 0 }, { -r, 0 }, { 0, r }, { 0, -r } }) do
			local hit = workspace:Raycast(toW(V(x + d[1], 120, z + d[2])), V(0, -140 * U, 0), rp)
			if hit then top = max(top, toL(hit.Position).Y) end
		end
		return top
	end
	-- segment dégagé de tout décor ?
	local function clear(a: Vector3, b: Vector3): boolean
		local d = b - a
		if d.Magnitude < 1e-3 then return true end
		return workspace:Raycast(toW(a), d * U, rp) == nil
	end
	local function feetOf(m: Model): (Vector3?, number)
		local r = m:FindFirstChild("HumanoidRootPart") :: BasePart?
		local h = m:FindFirstChildOfClass("Humanoid")
		if not r then return nil, 0 end
		local lv = r.CFrame.LookVector
		local off = if h then h.HipHeight + r.Size.Y / 2 else 3
		return toL(r.Position - V(0, off, 0)), math.atan2(-lv.X, -lv.Z)
	end
	local Pp, Pyaw = feetOf(char)
	if not Pp then playing = false; done(); return end
	local P: Vector3 = Pp
	local myTeam = player:GetAttribute("Team")
	local matchId = player:GetAttribute("MatchId")
	-- combattants de la partie : coéquipiers (joueurs puis bots, comme ents du web) et adversaires
	type Mate = { m: Model, pos: Vector3, yaw: number }
	local mates: { Mate } = {}
	local everyone: { Model } = {}
	for _, p in ipairs(Players:GetPlayers()) do
		local c = p.Character
		if c and p:GetAttribute("MatchId") == matchId then
			table.insert(everyone, c)
			if p ~= player and p:GetAttribute("Team") == myTeam then
				local pos, yaw = feetOf(c)
				if pos then table.insert(mates, { m = c, pos = pos, yaw = yaw }) end
			end
		end
	end
	local bots = workspace:FindFirstChild("Bots")
	for _, b in ipairs(if bots then bots:GetChildren() else {}) do
		if b:IsA("Model") and b:GetAttribute("MatchId") == matchId then
			table.insert(everyone, b)
			local h = b:FindFirstChildOfClass("Humanoid")
			if b:GetAttribute("Team") == myTeam and h and h.Health > 0 then
				local pos, yaw = feetOf(b)
				if pos then table.insert(mates, { m = b, pos = pos, yaw = yaw }) end
			end
		end
	end
	-- ---------- textes ----------
	local mode = tostring(player:GetAttribute("MatchMode") or "tdm")
	local def = Modes.LIST[mode]
	local md = MapData[mapId] :: any
	local bomb = mode == "bomb" or mode == "rapid"
	local att = myTeam == "Attaquants"
	local side = if bomb then (if att then "ATTAQUANTS" else "DÉFENSEURS") else (if att then "ÉQUIPE ORANGE" else "ÉQUIPE BLEUE")
	local limit = tonumber(info and info.limit) or 0
	local obj, objSub
	if mode == "duel" then obj, objSub = "ÉLIMINE L'ADVERSAIRE", "Premier à " .. limit .. " manches"
	elseif bomb then obj, objSub = (if att then "POSEZ LA BOMBE" else "PROTÉGEZ LES SITES"), "Site A ou B"
	elseif mode == "zombies" then obj, objSub = "SURVIVEZ", "Survis à " .. (if limit >= 99 then "l'infini" else limit .. " manches")
	else obj, objSub = "ÉLIMINEZ L'ÉQUIPE ADVERSE", "Premier à " .. limit end

	-- ---------- choix de la scène ----------
	local covered = workspace:Raycast(toW(P + V(0, 2, 0)), V(0, 60 * U, 0), rp) ~= nil   -- ceilAt < 90 du web
	local carKind = CAR_MAPS[mapId] or (if covered then "blinde" else nil)
	local veh = VM.build(carKind or "heli")
	local car = carKind ~= nil and veh.kind ~= "heli"      -- véhicule introuvable : l'hélicoptère le remplace
	veh.model.Parent = workspace
	local cx, cz = M / 2, M / 2
	local hx, hz = P.X, P.Z
	do
		local n = 1
		for _, mt in ipairs(mates) do hx += mt.pos.X; hz += mt.pos.Z; n += 1 end
		hx /= n; hz /= n
	end
	-- état commun
	local dur = 11.6
	local yaw = 0
	local poses: { [string]: CFrame } = {}
	local Hcf = CFrame.identity                       -- repère du véhicule (mètres, repère de la carte)
	local Hrot = CFrame.identity
	local function hToW(lp: Vector3): Vector3 return toW((Hcf * CFrame.new(lp)).Position) end
	-- hélicoptère
	local from, to, cruise, sideV, ext, headSm = Vector3.zero, Vector3.zero, 0, Vector3.zero, nil :: Vector3?, nil :: number?
	local heliCovered = false
	-- véhicule
	local Ept, uV, nV, dist0 = Vector3.zero, Vector3.zero, Vector3.zero, 70
	local road: Model? = nil
	local hidden: { { p: BasePart, t: number } } = {}
	local pp = { x = -0.68, z = 0.55 }
	local wheelA = 0
	if not car then
		-- point de stationnaire : la porte gauche juste au-dessus du point de départ du joueur
		local dx, dz = hx - cx, hz - cz
		local dl = math.sqrt(dx * dx + dz * dz)
		if dl < 1 then dx, dz, dl = 0, 1, 1 end
		dx /= dl; dz /= dl
		yaw = math.atan2(dx, dz)                       -- nez vers le centre de la carte
		local ox, oz = -(veh.CW + 0.35), 0.2
		hx = P.X - (ox * cos(yaw) + oz * sin(yaw)); hz = P.Z - (-ox * sin(yaw) + oz * cos(yaw))
		local hoverY = max(topAt(hx, hz, 6) + 6.5, topAt(P.X, P.Z, 1.5) + 8, P.Y + 9)
		-- arrivée de l'extérieur de la carte, côté de l'équipe, au-dessus de tout le décor
		local fx, fz = hx + dx * 120, hz + dz * 120
		cruise = hoverY
		for i = 0, 16 do local k = i / 16; cruise = max(cruise, topAt(lerp(fx, hx, k), lerp(fz, hz, k), 5) + 7) end
		from = V(fx, cruise + 6, fz); to = V(hx, hoverY, hz)
		-- départ sous un toit : pas de rappel à travers le plafond, on saute de la porte
		heliCovered = topAt(P.X, P.Z, 0.4) > P.Y + 2.6
		dur = if heliCovered then 9.8 else 11.6
		sideV = V(cos(yaw), 0, -sin(yaw))
	end
	-- position de l'hélicoptère à l'instant T (approche, arrondi, stationnaire, départ)
	local function path(T: number): Vector3
		local k = easeOut(T / ARR)
		local x, z = lerp(from.X, to.X, k), lerp(from.Z, to.Z, k)
		local sw = sin(clamp(T / ARR, 0, 1) * pi) * 7     -- léger virage en S pendant l'approche
		x += sideV.X * sw; z += sideV.Z * sw
		local y = if T < ARR * 0.7 then lerp(from.Y, cruise + 1, easeIO(T / (ARR * 0.7))) else lerp(cruise + 1, to.Y, easeIO((T - ARR * 0.7) / (ARR * 0.3)))
		if T > ARR then y += sin(T * 1.6) * 0.1; x += sin(T * 1.1) * 0.12 end
		if T > 10.4 then y += easeOut((T - 10.4) / 1.6) * 9 end
		return V(x, y, z)
	end
	if not car then
		-- plan d'ensemble : caméra au-dessus des toits, choisie pour voir l'hélico sans obstacle
		local midp = path(2.2)
		for _, sd in ipairs({ 1, -1 }) do
			for _, fw in ipairs({ -14, -24, -6 }) do
				for _, up in ipairs({ 2, 5, 9 }) do
					if not ext then
						local dx, dz = -sideV.Z, sideV.X                 -- (dx, dz) du web : sin(yaw), cos(yaw)
						local cp = V(midp.X + sideV.X * sd * 15 - dx * fw, max(midp.Y, cruise) + up, midp.Z + sideV.Z * sd * 15 - dz * fw)
						local ok = true
						for i = 0, 8 do if ok then ok = clear(cp, path(i / 8 * 2.8)) end end
						if ok then ext = cp end
					end
				end
			end
		end
	else
		-- arrêt juste à l'extérieur du bord de carte le plus proche du camp de l'équipe ; la route longe ce bord
		dur = 9.9
		local dx, dz = hx - cx, hz - cz
		if abs(dx) > abs(dz) then
			local s = if dx > 0 then 1 else -1
			nV = V(s, 0, 0); Ept = V(if s > 0 then M + 5 else -5, 0, clamp(hz, 12, M - 12)); uV = V(0, 0, if hz < cz then 1 else -1)
		else
			local s = if dz > 0 then 1 else -1
			nV = V(0, 0, s); Ept = V(clamp(hx, 12, M - 12), 0, if s > 0 then M + 5 else -5); uV = V(if hx < cx then 1 else -1, 0, 0)
		end
		yaw = math.atan2(-uV.X, -uV.Z)
		if veh.info then pp = { x = veh.info.player[1], z = veh.info.player[2] } end
		-- ruban de route (asphalte, lignes, bordures)
		local rm = Instance.new("Model"); rm.Name = "ArriveeRoute"
		local len = 140
		local rot = CFrame.Angles(0, math.atan2(uV.X, uV.Z), 0)
		local mid = Ept - uV * (len / 2 - 15)
		local function slab(name: string, w: number, h: number, l: number, at: Vector3, color: Color3, mat: Enum.Material)
			local p = Instance.new("Part"); p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
			p.Size = V(w, h, l) * U; p.CFrame = CFrame.new(toW(at)) * rot; p.Color = color; p.Material = mat
			p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth; p.Parent = rm
		end
		local nX = V(uV.Z, 0, -uV.X)                       -- perpendiculaire à la route
		slab("Asphalte", 7, 0.06, len, mid + V(0, 0.0, 0), Color3.fromRGB(58, 59, 61), Enum.Material.Asphalt)
		for _, s in ipairs({ -1, 1 }) do
			slab("Bordure", 0.3, 0.18, len, mid + nX * (s * 3.65) + V(0, 0.06, 0), Color3.fromRGB(154, 152, 144), Enum.Material.Concrete)
			slab("Rive", 0.12, 0.01, len, mid + nX * (s * 3.15) + V(0, 0.035, 0), Color3.fromRGB(235, 235, 225), Enum.Material.SmoothPlastic)
		end
		for i = 0, math.floor(len / 7) - 1 do   -- ligne médiane pointillée
			slab("Ligne", 0.12, 0.01, 3.8, Ept - uV * (i * 7 - 15 + 3.5) + V(0, 0.035, 0), Color3.fromRGB(235, 235, 225), Enum.Material.SmoothPlastic)
		end
		rm.Parent = workspace; road = rm
		-- dégage le couloir de la route : décor hors carte masqué le temps de la scène (carClear du web)
		local function inside(x: number, z: number, r: number): boolean
			local dn = (x - Ept.X) * nV.X + (z - Ept.Z) * nV.Z
			local du = -((x - Ept.X) * uV.X + (z - Ept.Z) * uV.Z)
			return dn > -4.5 and dn < 11 + r and du > -30 - r and du < 135 + r
		end
		for _, d in ipairs(folder:GetDescendants()) do
			if d:IsA("BasePart") and d.Transparency < 1 then
				local l = toL(d.Position)
				if (l.X < -1 or l.X > M + 1 or l.Z < -1 or l.Z > M + 1) and l.Y > 0.2 and d.Size.Magnitude < 120 * U and inside(l.X, l.Z, max(d.Size.X, d.Size.Z) / U / 2) then
					table.insert(hidden, { p = d, t = d.LocalTransparencyModifier }); d.LocalTransparencyModifier = 1
				end
			end
		end
	end
	local function carDist(T: number): number local k = clamp(T / CAR_STOP, 0, 1); return dist0 * (1 - (1 - (1 - k) * (1 - k))) end

	-- ---------- soldats : pilotes / chauffeur, coéquipiers ----------
	type Seat = { g: Ghost?, mate: Mate, x: number, z: number, f: number, door: number, drop: number, hidden: boolean }
	local pilots: { Ghost } = {}
	local pilotSpots: { { number } } = {}
	if car then
		if veh.info then
			if veh.info.driver then table.insert(pilotSpots, { veh.info.driver[1], veh.info.driver[2] }) end
		else table.insert(pilotSpots, { -0.5, -1.62 }) end
	else pilotSpots = { { -0.55, -2.5 }, { 0.55, -2.5 } } end
	local pilotSrc: Model = char
	for _, mt in ipairs(mates) do if not Players:GetPlayerFromCharacter(mt.m) then pilotSrc = mt.m; break end end
	for _ in ipairs(pilotSpots) do
		local g = makeGhost(pilotSrc)
		if g then g.model.Parent = workspace; table.insert(pilots, g) end
	end
	local HSEATS = { { x = 0.05, z = 1.4, f = 0 }, { x = 0.75, z = 1.4, f = 0 }, { x = -0.42, z = -1.38, f = pi }, { x = 0.42, z = -1.38, f = pi } }
	local seatsDef: { { x: number, z: number, f: number } } = HSEATS
	if car then
		seatsDef = {}
		local list = if veh.info then veh.info.seats else { { -0.72, -0.35 }, { 0.72, -0.35 }, { 0.72, 0.55 }, { 0.72, 1.45 } }
		for _, s in ipairs(list) do table.insert(seatsDef, { x = s[1], z = s[2], f = if s[1] < 0 then -pi / 2 else pi / 2 }) end
	end
	local seats: { Seat } = {}
	for i, mt in ipairs(mates) do
		local st = seatsDef[i]
		local g = if st then makeGhost(mt.m) else nil
		if g then g.model.Parent = workspace end
		local doorSide = if st and (st.x > 0 or (st.x >= 0 and st.f ~= 0)) then 1 else -1
		table.insert(seats, { g = g, mate = mt, x = if st then st.x else 0, z = if st then st.z else 0, f = if st then st.f else 0,
			door = doorSide, drop = if car then 6.3 + (i - 1) * 0.3 else 7.9 + (i - 1) * 0.35, hidden = g == nil })
	end
	-- cordes (une par coéquipier + la nôtre) et nos mains gantées
	local ropes: { Part } = {}
	local function newRope(): Part
		local r = Instance.new("Part"); r.Name = "Corde"; r.Anchored = true; r.CanCollide = false; r.CanQuery = false; r.CanTouch = false
		r.Shape = Enum.PartType.Cylinder; r.Color = Color3.fromRGB(43, 38, 32); r.Material = Enum.Material.Fabric
		r.Size = V(1, 0.05 * U, 0.05 * U); r.Transparency = 1; r.Parent = veh.model
		return r
	end
	if not car then for _ = 1, #seats + 1 do table.insert(ropes, newRope()) end end
	local function ropeSet(r: Part, a: Vector3, b: Vector3)   -- a, b en mètres (repère de la carte)
		local wa, wb = toW(a), toW(b)
		local L = (wb - wa).Magnitude
		if L < 0.01 then r.Transparency = 1; return end
		r.Size = V(L, 0.05 * U, 0.05 * U)
		r.CFrame = CFrame.lookAt((wa + wb) / 2, wb) * CFrame.Angles(0, pi / 2, 0)
		r.Transparency = 0
	end
	local hands: { Part } = {}
	if not car then
		for i = 1, 2 do
			local h = Instance.new("Part"); h.Name = "Gant" .. i; h.Anchored = true; h.CanCollide = false; h.CanQuery = false; h.CanTouch = false
			h.Size = V(0.09, 0.05, 0.11) * U; h.Color = Color3.fromRGB(38, 36, 32); h.Material = Enum.Material.Fabric; h.Transparency = 1; h.Parent = veh.model
			table.insert(hands, h)
		end
	end
	-- poussière soulevée par le rotor
	local dustPart: Part? = nil
	local dust: ParticleEmitter? = nil
	if not car then
		local dp = Instance.new("Part"); dp.Name = "Poussiere"; dp.Anchored = true; dp.CanCollide = false; dp.CanQuery = false; dp.CanTouch = false
		dp.Transparency = 1; dp.Size = V(10, 0.2, 10) * U; dp.Parent = veh.model
		local pe = Instance.new("ParticleEmitter")
		pe.Color = ColorSequence.new(Color3.fromRGB(184, 160, 120)); pe.LightEmission = 0; pe.Rate = 0
		pe.Lifetime = NumberRange.new(0.9, 1.6); pe.Speed = NumberRange.new(9, 20); pe.SpreadAngle = Vector2.new(80, 10)
		pe.EmissionDirection = Enum.NormalId.Top; pe.Acceleration = V(0, -2, 0); pe.Drag = 1.5
		pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 2.5), NumberSequenceKeypoint.new(1, 7) })
		pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.55), NumberSequenceKeypoint.new(1, 1) })
		pe.Parent = dp
		dustPart, dust = dp, pe
	end

	-- ---------- on cache les vrais soldats, l'interface, et on prend la caméra ----------
	local ltm: { [BasePart]: number } = {}
	local offs: { Instance } = {}
	local function hideReal()
		for _, m in ipairs(everyone) do
			if m.Parent then
				for _, d in ipairs(m:GetDescendants()) do
					if d:IsA("BasePart") then
						if ltm[d] == nil then ltm[d] = d.LocalTransparencyModifier end
						d.LocalTransparencyModifier = 1
					elseif (d:IsA("BillboardGui") or d:IsA("Highlight")) and (d :: any).Enabled then
						(d :: any).Enabled = false; table.insert(offs, d)        -- noms, contours d'équipe
					end
				end
			end
		end
	end
	hideReal()
	local guis: { ScreenGui } = {}
	for _, g in ipairs(player.PlayerGui:GetChildren()) do
		if g:IsA("ScreenGui") and g ~= gui and g.Enabled then g.Enabled = false; table.insert(guis, g) end
	end
	local prevKc = S.kc
	S.kc = { key = nil, skin = nil, camo = nil, arrival = true } :: any   -- comme la kill-cam : la scène tient la caméra
	local savedType, savedFov = camera.CameraType, camera.FieldOfView
	camera.CameraType = Enum.CameraType.Scriptable
	hrp.Anchored = true
	local touch = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
	skipLbl.Text = spaced(if touch then "TOUCHE L'ÉCRAN — PASSER" else "ESPACE — PASSER")
	setTitles(if md and md.name then md.name else mapId, (if def then def.n else mode) .. " — " .. side)
	flash.BackgroundTransparency = 1
	gui.Enabled = true
	local snd = if car then startEngine() else startHeli()

	-- ---------- passer ----------
	local T = 0
	local skipped = false
	local function skip()
		if skipped then return end
		skipped = true; T = max(T, dur - 0.5)
	end
	ContextActionService:BindActionAtPriority("ArriveePasser", function(_, st: Enum.UserInputState)
		if st == Enum.UserInputState.Begin then skip() end
		return Enum.ContextActionResult.Sink
	end, false, Enum.ContextActionPriority.High.Value + 50, Enum.KeyCode.Space, Enum.KeyCode.Return, Enum.KeyCode.ButtonA,
		Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2)
	local touchConn = UserInputService.TouchStarted:Connect(function() skip() end)

	-- ---------- image par image ----------
	local t2 = false
	local fired: { [string]: boolean } = {}
	local function once(k: string, f: () -> ()) if not fired[k] then fired[k] = true; f() end end
	local finished = false
	local lastEye = camera.CFrame
	-- ---------- fin : tout remettre, la main revient au joueur ----------
	-- (aussi appelé si la scène plante en route : sinon caméra Scriptable, soldat ancré et interface cachée pour de bon)
	local restored = false
	local function restore()
		if restored then return end
		restored = true; finished = true
		pcall(function() RunService:UnbindFromRenderStep("ArriveeCinematique") end)
		ContextActionService:UnbindAction("ArriveePasser")
		touchConn:Disconnect()
		snd.stop()
		for _, g in ipairs(pilots) do g.model:Destroy() end
		for _, s in ipairs(seats) do if s.g then s.g.model:Destroy() end end
		veh.model:Destroy()
		if road then road:Destroy() end
		for _, h in ipairs(hidden) do if h.p.Parent then h.p.LocalTransparencyModifier = h.t end end
		for p, t in pairs(ltm) do if p.Parent then p.LocalTransparencyModifier = t end end
		for _, d in ipairs(offs) do if d.Parent then (d :: any).Enabled = true end end
		for _, g in ipairs(guis) do if g.Parent then g.Enabled = true end end
		if (S.kc :: any) and (S.kc :: any).arrival then S.kc = prevKc end
		if hrp.Parent then hrp.Anchored = false end
		-- vue à la première personne : on regarde là où la scène finit (la caméra Roblox repart de camera.CFrame)
		local r = hrp.Parent and hrp.Position or toW(P + V(0, 1, 0))
		local look = lastEye.LookVector
		local flat = V(look.X, 0, look.Z)
		if flat.Magnitude < 1e-3 then flat = V(0, 0, -1) end
		camera.CameraType = if savedType == Enum.CameraType.Scriptable then Enum.CameraType.Custom else savedType
		camera.FieldOfView = savedFov
		camera.CFrame = CFrame.lookAt(r + V(0, 1.5, 0), r + V(0, 1.5, 0) + flat.Unit)
		if hum.Parent then camera.CameraSubject = hum end
		gui.Enabled = false
	end
	abortRun = restore
	local function seatedFeet(lx: number, lz: number, f: number): CFrame
		return CFrame.new(hToW(V(lx, veh.CF, lz))) * Hrot * CFrame.Angles(0, f, 0)
	end
	local function step(dt: number)
		T += dt
		local oP: { BasePart }, oC: { CFrame } = {}, {}
		if not car then
			-- ======== hélicoptère ========
			local pos = path(T)
			local pv = path(T + 0.05)
			local vx, vz = pv.X - pos.X, pv.Z - pos.Z
			local sp = math.sqrt(vx * vx + vz * vz) / 0.05
			local head = if sp > 2 then math.atan2(-vx, -vz) else yaw
			headSm = if headSm == nil then head else (headSm :: number) + angDiff(headSm :: number, head) * min(1, dt * 3)
			local hd = headSm :: number
			local pitch = if T < ARR - 1.2 then -clamp(sp / 40, 0, 0.16) elseif T < ARR + 0.6 then sin(clamp((T - (ARR - 1.2)) / 1.8, 0, 1) * pi) * 0.14 else 0
			local roll = cos(clamp(T / ARR, 0, 1) * pi) * 0.08 * (if T < ARR then 1 else 0) + sin(T * 1.3) * 0.02
			Hrot = E(pitch, hd, roll)
			Hcf = CFrame.new(pos) * Hrot
			poses.rotor = CFrame.Angles(0, T * 34, 0); poses.tail = CFrame.Angles(T * 44, 0, 0)
			VM.place(veh, cfW(pos, Hrot), poses)
			VM.setBeacon(veh, 1, (T % 1) < 0.12)
			for i, s in ipairs(veh.screens) do s.Transparency = 0.15 + 0.15 * sin(T * 3 + i * 2) end
			snd.set(if T < 2.6 then 0.45 else 0.95)
			-- pilotes : assis aux commandes
			for i, g in ipairs(pilots) do
				local sp2 = pilotSpots[i]
				poseGhost(g, seatedFeet(sp2[1], sp2[2], 0), 1.45, 1.45, -1.5, oP, oC)
			end
			-- coéquipiers : assis, puis rejoignent la porte et descendent en rappel
			for i, s in ipairs(seats) do
				local g = s.g
				if g then
					local mt = s.mate
					local tGo, tDoor = s.drop, s.drop + 0.4
					local tLand = tDoor + 1.3
					local dLx, dLy, dLz = s.door * (veh.CW + 0.15), veh.CF, if s.z > 0 then 0.3 else -0.5
					local rope = ropes[i]
					if T < tDoor then
						local k = easeIO((T - tGo) / 0.4)
						local f = lerp(s.f, if s.door > 0 then -pi / 2 else pi / 2, k)
						local sit = if k > 0 then 0 else 1
						poseGhost(g, seatedFeet(lerp(s.x, dLx, k), lerp(s.z, dLz, k), f), 1.45 * sit, 1.45 * sit, -1.5 * sit, oP, oC)
						rope.Transparency = 1
					elseif heliCovered then
						-- départ couvert : ils sautent de la porte et sont déjà au sol
						poseGhost(g, CFrame.new(toW(mt.pos)) * CFrame.Angles(0, mt.yaw, 0), 0, 0, 0, oP, oC)
						rope.Transparency = 1
					elseif T < tLand then
						local top = (Hcf * CFrame.new(dLx, dLy, dLz)).Position
						local k = easeIO((T - tDoor) / 1.3)
						local at = top:Lerp(mt.pos, k)
						poseGhost(g, CFrame.new(toW(at)) * CFrame.Angles(0, hd + (if s.door > 0 then -pi / 2 else pi / 2), 0), 0.25, 0.25, -0.3, oP, oC)
						ropeSet(rope, top + V(0, 0.6, 0), mt.pos)
						if k < 0.05 then once("rope" .. i, sndRope) end
					else
						poseGhost(g, CFrame.new(toW(mt.pos)) * CFrame.Angles(0, mt.yaw, 0), 0, 0, 0, oP, oC)
						local top = (Hcf * CFrame.new(dLx, dLy + 0.6, dLz)).Position
						if T < tLand + 2.2 then ropeSet(rope, top, top + V(0.1, -9, 0)) else rope.Transparency = 1 end
					end
				end
			end
			-- poussière du rotor
			if dust and dustPart then
				local on = T > ARR - 1.6 and T < 11
				dustPart.CFrame = CFrame.new(toW(V(pos.X, topAt(pos.X, pos.Z, 0) + 0.2, pos.Z)))
				dust.Rate = if on then 60 else 0
			end
		else
			-- ======== véhicule ========
			local d, d2 = carDist(T), carDist(T + 0.05)
			local v = (d - d2) / 0.05
			local vib = min(1, v / 8)
			local pos = Ept - uV * d
			local brake = if T > CAR_STOP - 1.6 and T < CAR_STOP + 0.4 then sin(clamp((T - (CAR_STOP - 1.6)) / 2, 0, 1) * pi) * 0.025 else 0
			pos += V(0, sin(T * 11) * 0.012 * vib, 0)
			Hrot = E(-brake + sin(T * 7.3) * 0.003 * vib, yaw, sin(T * 5.1) * 0.004 * vib)
			Hcf = CFrame.new(pos) * Hrot
			wheelA -= v * dt / veh.wheelR
			for _, w in ipairs({ "wheel_FL", "wheel_FR", "wheel_RL", "wheel_RR" }) do poses[w] = CFrame.Angles(wheelA, 0, 0) end
			-- portes arrière qui s'ouvrent (ou hayon du camion qui s'abaisse)
			local ko = easeIO((T - 6.0) / 0.7)
			poses.door_L = CFrame.Angles(0, -ko * 1.9, 0); poses.door_R = CFrame.Angles(0, ko * 1.9, 0)
			poses.tailgate = CFrame.Angles(ko * 1.62, 0, 0)
			VM.place(veh, cfW(pos, Hrot), poses)
			VM.setBeacon(veh, 1, ((T * 3) % 1) < 0.5); VM.setBeacon(veh, 2, ((T * 3 + 0.5) % 1) < 0.5)
			snd.set(clamp(v / 22, 0, 1))
			if T > CAR_STOP - 1.5 then once("brake", sndBrake) end
			if T > 5.95 then once("doors", sndDoor) end
			for i, g in ipairs(pilots) do
				local sp2 = pilotSpots[i]
				poseGhost(g, seatedFeet(sp2[1], sp2[2], 0), 1.45, 1.45, -1.5, oP, oC)
			end
			-- coéquipiers : assis, puis sortent par l'arrière et s'écartent vers la carte
			for i, s in ipairs(seats) do
				local g = s.g
				if g then
					local tGo, tOut = s.drop, s.drop + 0.7
					local tEnd = tOut + 1.2
					if T < tOut then
						local k = easeIO((T - tGo) / 0.7)
						local sit = if k > 0 then 0 else 1
						local walk = if k > 0 and k < 1 then sin(T * 9) * 0.45 else 0
						poseGhost(g, seatedFeet(lerp(s.x, s.x * 0.3, k), lerp(s.z, veh.Z1 + 0.3, k), lerp(s.f, pi, k)),
							1.45 * sit + max(0, walk), 1.45 * sit + max(0, -walk), -1.5 * sit, oP, oC)
					else
						local hp = (Hcf * CFrame.new(s.x * 0.3, 0, veh.Z1 + 0.8)).Position
						local k = easeIO((T - tOut) / 1.2)
						local gx = hp.X - nV.X * (2 + (i - 1) * 1.2) + uV.X * ((i - 1) - 1.5)
						local gz = hp.Z - nV.Z * (2 + (i - 1) * 1.2) + uV.Z * ((i - 1) - 1.5)
						local y = max(0, veh.CF * (1 - k * 3))
						local walk = if T < tEnd then sin(T * 9 + i) * 0.5 else 0
						poseGhost(g, CFrame.new(toW(V(lerp(hp.X, gx, k), y, lerp(hp.Z, gz, k)))) * CFrame.Angles(0, math.atan2(nV.X, nV.Z), 0),
							max(0, walk), max(0, -walk), -0.4 * abs(walk), oP, oC)
					end
				end
			end
		end
		if #oP > 0 then workspace:BulkMoveTo(oP, oC, Enum.BulkMoveMode.FireCFrameChanged) end
		snd.tick(dt)
		hideReal()
		animTitles()
		-- titres : objectif
		if T > (if car then 3.2 else 3.4) and not t2 then t2 = true; setTitles(obj, objSub) end
		if T >= dur then finished = true; return end

		-- ---------------- caméra ----------------
		local eye: CFrame
		local fov = 70
		if not car then
			for _, h in ipairs(hands) do h.Transparency = 1 end
			local pRope = ropes[#ropes]
			pRope.Transparency = 1
			local tMove, tRope, tGround = 8.9, 9.5, 11.0
			local hd = headSm :: number
			if T < 2.6 and ext then        -- plan 1 : vue d'ensemble, au-dessus des toits
				local e = ext :: Vector3
				local pos = Hcf.Position
				eye = CFrame.lookAt(toW(e + V(0, T * 0.25, 0)), toW(pos - V(0, 0.5, 0)))
				fov = lerp(40, 48, T / 2.6)
			elseif T < tRope then           -- plan 2 : à la première personne, assis dans la cabine
				local a, p = keyAt(LOOKA, T), keyAt(LOOKP, T)
				local mk = easeIO((T - tMove) / (tRope - tMove))
				local tb = if T < ARR then 1 else 0.5
				local lp = V(lerp(-0.72, -veh.CW + 0.05, mk) + sin(T * 13.1) * 0.006 * tb,
					lerp(veh.CF + 1.22, veh.CF + 1.0, mk) + sin(T * 17.3) * 0.008 * tb + sin(T * 2.1) * 0.01, lerp(1.32, 0.2, mk))
				eye = CFrame.new(hToW(lp)) * Hrot * E(p + sin(T * 9.7) * 0.004 * tb, a + sin(T * 0.7) * 0.03, sin(T * 1.9) * 0.01)
				fov = lerp(68, 74, mk)
			else                            -- plan 3 : descente en rappel, puis arrivée au sol
				local gy = P.Y
				local k = easeIO((T - tRope) / (tGround - tRope))
				local door = (Hcf * CFrame.new(-veh.CW - 0.35, veh.CF + 1.0, 0.2)).Position
				local ey = gy + 1.6
				local cam = V(lerp(door.X, P.X, k), lerp(door.Y, ey, k), lerp(door.Z, P.Z, k))
				if T > tGround then cam -= V(0, math.exp(-(T - tGround) * 7) * sin((T - tGround) * 16) * 0.08, 0); once("land", sndLand) end
				local q = E(-1.0, hd + 1.5, 0):Lerp(E(-0.05, Pyaw, 0), easeIO((T - tRope - 0.5) / 1.3))
				eye = CFrame.new(toW(cam)) * q
				fov = 74
				once("myrope", sndRope)
				-- corde devant soi + mains qui la tiennent
				local top = (Hcf * CFrame.new(-veh.CW - 0.35, veh.CF + 0.6, 0.2)).Position
				local fwd = q.LookVector; fwd = V(fwd.X, 0, fwd.Z); fwd = if fwd.Magnitude > 1e-3 then fwd.Unit else V(0, 0, -1)
				local bot = V(P.X + fwd.X * 0.4, gy, P.Z + fwd.Z * 0.4)
				if T < tGround + 0.15 then
					ropeSet(pRope, top, bot)
					local kk = clamp((top.Y - cam.Y + 0.35) / max(0.1, top.Y - bot.Y), 0, 1)
					local r = top:Lerp(bot, kk)
					local rightV = q.RightVector
					for i, h in ipairs(hands) do
						local at = r + V(0, if i == 2 then 0.12 else -0.05, 0) + rightV * (if i == 2 then -0.04 else 0.04)
						h.CFrame = CFrame.new(toW(at)) * q.Rotation * CFrame.Angles(-1.2, 0, if i == 2 then -0.4 else 0.4)
						h.Transparency = 0
					end
				end
			end
			if T < 2.6 and not ext then
				local a, p = keyAt(LOOKA, T), keyAt(LOOKP, T)
				eye = CFrame.new(hToW(V(-0.72, veh.CF + 1.22, 1.32))) * Hrot * E(p, a, 0); fov = 68
			end
		else
			if T < 2.4 then                 -- plan 1 : au bord de la route, le véhicule arrive gyrophares allumés
				local cp = V(Ept.X - uV.X * 18 + nV.X * 6.5, 1.1 + T * 0.1, Ept.Z - uV.Z * 18 + nV.Z * 6.5)
				local hp = Hcf.Position
				eye = CFrame.lookAt(toW(cp), toW(V(hp.X, 1.3, hp.Z)))
				fov = lerp(38, 46, T / 2.4)
			elseif T < 7.6 then             -- plan 2 : assis dans la cellule, on regarde la route puis les coéquipiers
				local d, d2 = carDist(T), carDist(T + 0.05)
				local vib = min(1, (d - d2) / 0.05 / 8)
				local a, p = keyAt(CLOOKA, T), keyAt(CLOOKP, T)
				local lp = V(pp.x + 0.1 + sin(T * 13.1) * 0.004 * vib, veh.CF + 1.12 + sin(T * 17.3) * 0.006 * vib, pp.z)
				eye = CFrame.new(hToW(lp)) * Hrot * E(p + sin(T * 9.7) * 0.004 * vib, a, sin(T * 1.9) * 0.006)
				fov = 70
			else                            -- plan 3 : on se lève, on sort par l'arrière et on se tourne vers l'objectif
				local k = easeIO((T - 7.6) / 1.6)
				local lp = V(lerp(pp.x + 0.1, 0, k), lerp(veh.CF + 1.12, 1.6, k), lerp(pp.z, veh.Z1 + 2.2, k))
				local q = E(-0.08, yaw + pi, 0):Lerp(E(-0.03, math.atan2(nV.X, nV.Z), 0), easeIO((T - 8.6) / 1.0))
				eye = CFrame.new(hToW(lp)) * q
				fov = 72
			end
		end
		camera.CFrame = eye; camera.FieldOfView = fov
		lastEye = eye
		-- flash blanc de transition à la fin
		if T > dur - 0.5 then flash.BackgroundTransparency = 1 - min(1, (T - (dur - 0.5)) / 0.5) end
	end
	-- après la caméra Roblox et WeaponCamera (Camera + 1) : la scène a le dernier mot
	local ok = pcall(function()
		RunService:BindToRenderStep("ArriveeCinematique", Enum.RenderPriority.Camera.Value + 10, function(dt: number)
			if finished then return end
			local okS, err = pcall(step :: any, math.min(dt, 0.1))
			if not okS then warn("[CinematicController] " .. tostring(err)); finished = true end
		end)
	end)
	if not ok then finished = true end
	local tStart = os.clock()
	while not finished and os.clock() - tStart < dur + 3 do task.wait(0.05) end
	restore()
	abortRun = nil
	gui.Enabled = true
	title.Text = ""; sub.Text = ""; skipLbl.Text = ""
	for _, b in ipairs(bars) do b.Visible = false end
	flash.BackgroundTransparency = 0.1
	Sfx.play("round")
	done()
	for i = 1, 14 do flash.BackgroundTransparency = 0.1 + 0.9 * i / 14; task.wait(0.05) end
	gui.Enabled = false
	for _, b in ipairs(bars) do b.Visible = true end
	playing = false
end

remote.OnClientEvent:Connect(function(info: any)
	task.spawn(function()
		local ok, err = pcall(run :: any, info)
		if not ok then
			warn("[CinematicController] " .. tostring(err))
			local abort = abortRun
			abortRun = nil
			if abort then abort() end
			playing = false
			pcall(function() remote:FireServer("done") end)
		end
	end)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="797">
        <Properties>
          <string name="Name">CombatFxController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/CombatFxController (LocalScript)
-- Effets de combat du web qui ne dépendent pas d'un tir :
--   * taches de sang au sol à la mort d'un soldat (stain de src/67_immersion.js), pas pour les zombies ni les cibles ;
--   * alerte santé basse (src/8I_lowhp.js) : sous 30 PV, battements de cœur de plus en plus rapides
--     (une période de 1,1 s à 30 PV, 0,7 s à 0 PV), deux coups sourds à chaque battement.
-- Le voile rouge qui bat est dessiné par HudController.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local ShotFx = require(ReplicatedStorage.Shared.ShotFx)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer

-- ---------- taches de sang ----------
local watched: { [Humanoid]: boolean } = setmetatable({}, { __mode = "k" }) :: any
local function watch(h: Humanoid)
	if watched[h] then return end
	watched[h] = true
	local was = h.Health
	h.HealthChanged:Connect(function(hp: number)
		if hp <= 0 and was > 0 then
			local m = h.Parent
			local root = m and m:FindFirstChild("HumanoidRootPart") :: BasePart?
			if m and root and m:GetAttribute("Zombie") ~= true and m:GetAttribute("Dummy") ~= true then
				ShotFx.stain(root.Position, m)
			end
		end
		was = hp
	end)
end
workspace.DescendantAdded:Connect(function(d)
	if d:IsA("Humanoid") then watch(d) end
end)
for _, d in ipairs(workspace:GetDescendants()) do
	if d:IsA("Humanoid") then watch(d) end
end

-- ---------- battements de cœur sous 30 PV ----------
local beatT = 0
RunService.Heartbeat:Connect(function(dt: number)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	local hp = if hum then hum.Health else 0
	if not hum or hp <= 0 or hp >= 30 or player:GetAttribute("Zone") == "lobby" then beatT = 0; return end
	local per = 1.1 - 0.4 * (1 - hp / 30)
	beatT -= dt
	if beatT <= 0 then
		beatT = per
		Sfx.step("stone", nil, 0.55)            -- le web joue un pas sourd (sfx('step'))
		task.delay(0.16, function()
			local h = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
			if h and h.Health > 0 then Sfx.step("stone", nil, 0.4) end
		end)
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="798">
        <Properties>
          <string name="Name">CommsController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/CommsController (LocalScript)
-- Ping et messages rapides d'équipe (TeamCommsService) :
--   • clic molette ou K : ping sur le point visé ; un ennemi visé est marqué en rouge et suivi quelques secondes.
--   • N : ouvre la liste des messages rapides, 1 à 6 pour en envoyer un (N ou Échap pour fermer).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local ContextActionService = game:GetService("ContextActionService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")

local TeamComms = require(ReplicatedStorage.Shared.TeamComms)
local Sfx = require(ReplicatedStorage.Shared.Sfx)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local pingIn = ReplicatedStorage:WaitForChild("TeamPing") :: RemoteEvent
local pingOut = ReplicatedStorage:WaitForChild("TeamPingShow") :: RemoteEvent
local chatIn = ReplicatedStorage:WaitForChild("QuickChat") :: RemoteEvent
local chatOut = ReplicatedStorage:WaitForChild("QuickChatShow") :: RemoteEvent

local GOLD, RED, TEXT = Color3.fromRGB(255, 215, 94), Color3.fromRGB(255, 70, 85), Color3.fromRGB(232, 238, 249)
local FONT = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Bold)

local gui = Instance.new("ScreenGui"); gui.Name = "TeamComms"; gui.ResetOnSpawn = false; gui.DisplayOrder = 9
gui.IgnoreGuiInset = true; gui.Parent = player:WaitForChild("PlayerGui")

local function inMatch(): boolean return typeof(player:GetAttribute("MatchId")) == "number" end
local function uiBlocked(): boolean
	return player:GetAttribute("UiOpen") == true or player:GetAttribute("MenuOpen") == true
end

-- ---------- ping ----------
local function aimedPoint(): (Vector3?, Model?)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local skip: { Instance } = { camera }                      -- le modèle de l'arme en vue FPS est rangé sous la caméra
	if player.Character then table.insert(skip, player.Character) end
	params.FilterDescendantsInstances = skip
	local cf = camera.CFrame
	local r = workspace:Raycast(cf.Position, cf.LookVector * 800, params)
	if not r then return nil, nil end
	local model = r.Instance:FindFirstAncestorOfClass("Model")
	while model and not model:FindFirstChildOfClass("Humanoid") do model = model:FindFirstAncestorOfClass("Model") end
	return r.Position, model
end

local lastAsk = 0
local function askPing()
	if not inMatch() or uiBlocked() or os.clock() - lastAsk < TeamComms.PING_COOLDOWN then return end
	local pos, model = aimedPoint()
	if not pos then return end
	lastAsk = os.clock()
	pingIn:FireServer(pos, model)
end

type Ping = { bb: BillboardGui, anchor: Part?, dist: TextLabel, born: number, life: number, target: Model? }
local pings: { Ping } = {}

local function showPing(pos: Vector3, kind: string, who: string, target: Model?)
	local enemy = kind == "enemy"
	local color = if enemy then RED else GOLD
	local anchor: Part? = nil
	local adornee: BasePart? = target and target:FindFirstChild("Head") :: BasePart?
	if not adornee then
		local a = Instance.new("Part")
		a.Anchored = true; a.CanCollide = false; a.CanQuery = false; a.CanTouch = false; a.Transparency = 1
		a.Size = Vector3.one * 0.2; a.Position = pos; a.Parent = workspace
		anchor = a; adornee = a
	end
	local bb = Instance.new("BillboardGui")
	bb.AlwaysOnTop = true; bb.LightInfluence = 0; bb.Size = UDim2.fromOffset(120, 64)
	bb.StudsOffsetWorldSpace = if target then Vector3.new(0, 2.2, 0) else Vector3.new(0, 1.2, 0)
	bb.Adornee = adornee :: BasePart; bb.Parent = gui
	-- losange façon Apex : carré tourné de 45°, avec une onde qui s'agrandit à l'arrivée
	local dia = Instance.new("Frame")
	dia.AnchorPoint = Vector2.new(0.5, 0.5); dia.Position = UDim2.new(0.5, 0, 0, 14); dia.Size = UDim2.fromOffset(14, 14)
	dia.Rotation = 45; dia.BackgroundColor3 = color; dia.BorderSizePixel = 0; dia.Parent = bb
	local st = Instance.new("UIStroke"); st.Color = Color3.new(0, 0, 0); st.Transparency = 0.4; st.Thickness = 1.5; st.Parent = dia
	local ring = Instance.new("Frame")
	ring.AnchorPoint = Vector2.new(0.5, 0.5); ring.Position = dia.Position; ring.Size = UDim2.fromOffset(14, 14); ring.Rotation = 45
	ring.BackgroundTransparency = 1; ring.Parent = bb
	local rs = Instance.new("UIStroke"); rs.Color = color; rs.Thickness = 2; rs.Parent = ring
	TweenService:Create(ring, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Size = UDim2.fromOffset(46, 46) }):Play()
	TweenService:Create(rs, TweenInfo.new(0.6, Enum.EasingStyle.Quad), { Transparency = 1 }):Play()
	local name = Instance.new("TextLabel")
	name.BackgroundTransparency = 1; name.Position = UDim2.fromOffset(0, 26); name.Size = UDim2.new(1, 0, 0, 16)
	name.FontFace = FONT; name.TextSize = 13; name.TextColor3 = color; name.TextStrokeTransparency = 0.4
	name.Text = if enemy then "ENNEMI" else string.upper(who); name.Parent = bb
	local dist = name:Clone(); dist.Position = UDim2.fromOffset(0, 42); dist.TextColor3 = TEXT; dist.TextSize = 12; dist.Text = ""; dist.Parent = bb
	table.insert(pings, { bb = bb, anchor = anchor, dist = dist, born = os.clock(),
		life = if enemy then TeamComms.PING_LIFE / 2 else TeamComms.PING_LIFE, target = target })
	pcall(function() Sfx.play(if enemy then "beep" else "tick", nil, 0.8) end)
end

pingOut.OnClientEvent:Connect(function(pos: Vector3, kind: string, who: string, target: Model?)
	showPing(pos, kind, who, target)
end)

RunService.RenderStepped:Connect(function()
	if #pings == 0 then return end
	local now, eye = os.clock(), camera.CFrame.Position
	for i = #pings, 1, -1 do
		local p = pings[i]
		local hum = p.target and p.target:FindFirstChildOfClass("Humanoid")
		local gone = not p.bb.Adornee or not p.bb.Adornee.Parent or (p.target ~= nil and (not hum or hum.Health <= 0))
		if gone or now - p.born > p.life or not inMatch() then
			p.bb:Destroy(); if p.anchor then p.anchor:Destroy() end
			table.remove(pings, i)
		else
			local ad = p.bb.Adornee :: BasePart
			p.dist.Text = math.floor((ad.Position - eye).Magnitude / 3.57 + 0.5) .. " m"   -- 1 m ≈ 3,57 studs (Config.STUDS_PER_METER)
			local fade = math.clamp((p.born + p.life - now) / 0.5, 0, 1)                    -- fondu sur la dernière demi-seconde
			for _, d in ipairs(p.bb:GetDescendants()) do
				if d:IsA("TextLabel") then d.TextTransparency = 1 - fade end
			end
		end
	end
end)

-- ---------- messages rapides ----------
local list = Instance.new("Frame")
list.AnchorPoint = Vector2.new(0, 0.5); list.Position = UDim2.new(0, 24, 0.55, 0); list.Size = UDim2.fromOffset(250, 34 + #TeamComms.LINES * 26)
list.BackgroundColor3 = Color3.fromRGB(14, 19, 30); list.BackgroundTransparency = 0.15; list.BorderSizePixel = 0; list.Visible = false; list.Parent = gui
local corner = Instance.new("UICorner"); corner.CornerRadius = UDim.new(0, 4); corner.Parent = list
local edge = Instance.new("UIStroke"); edge.Color = Color3.fromRGB(42, 55, 80); edge.Parent = list
local head = Instance.new("TextLabel")
head.BackgroundTransparency = 1; head.Position = UDim2.fromOffset(12, 6); head.Size = UDim2.new(1, -24, 0, 22)
head.FontFace = FONT; head.TextSize = 13; head.TextColor3 = GOLD; head.TextXAlignment = Enum.TextXAlignment.Left
head.Text = "MESSAGES RAPIDES"; head.Parent = list
for i, line in ipairs(TeamComms.LINES) do
	local l = head:Clone()
	l.Position = UDim2.fromOffset(12, 6 + i * 26); l.TextColor3 = TEXT; l.TextSize = 14
	l.Text = '<font color="#ffd75e">' .. i .. "</font>   " .. line; l.RichText = true; l.Parent = list
end

local KEYS = { Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six }
local open = false
local openN = 0
local function close()
	if not open then return end
	open = false; list.Visible = false
	ContextActionService:UnbindAction("QuickChatPick")
end
local function pick(_: string, st: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Sink end
	local i = table.find(KEYS, input.KeyCode)
	if i then chatIn:FireServer(i) end
	close()
	return Enum.ContextActionResult.Sink
end
local function toggle()
	if open then close(); return end
	if not inMatch() or uiBlocked() then return end
	open = true; list.Visible = true
	openN += 1
	local my = openN
	-- priorité haute : les touches 1 à 6 choisissent un message au lieu de changer d'arme
	ContextActionService:BindActionAtPriority("QuickChatPick", pick, false, Enum.ContextActionPriority.High.Value + 10,
		Enum.KeyCode.One, Enum.KeyCode.Two, Enum.KeyCode.Three, Enum.KeyCode.Four, Enum.KeyCode.Five, Enum.KeyCode.Six, Enum.KeyCode.Escape)
	task.delay(4, function() if my == openN then close() end end)   -- pas la liste rouverte entre-temps
end

-- fil des messages reçus, en bas à gauche au-dessus du chat
local feed = Instance.new("Frame")
feed.AnchorPoint = Vector2.new(0, 1); feed.Position = UDim2.new(0, 24, 0.78, 0); feed.Size = UDim2.fromOffset(420, 120)
feed.BackgroundTransparency = 1; feed.Parent = gui
local lay = Instance.new("UIListLayout"); lay.VerticalAlignment = Enum.VerticalAlignment.Bottom; lay.Padding = UDim.new(0, 2)
lay.SortOrder = Enum.SortOrder.LayoutOrder; lay.Parent = feed
local order = 0
chatOut.OnClientEvent:Connect(function(who: string, index: number)
	local line = TeamComms.LINES[index]
	if not line then return end
	order += 1
	local l = Instance.new("TextLabel")
	l.BackgroundTransparency = 1; l.Size = UDim2.new(1, 0, 0, 20); l.LayoutOrder = order; l.RichText = true
	l.FontFace = FONT; l.TextSize = 15; l.TextColor3 = TEXT; l.TextStrokeTransparency = 0.4; l.TextXAlignment = Enum.TextXAlignment.Left
	l.Text = '<font color="#7dff9f">[ÉQUIPE] ' .. who .. "</font> : " .. line; l.Parent = feed
	pcall(function() Sfx.play("ui", nil, 0.6) end)
	task.delay(5, function()
		TweenService:Create(l, TweenInfo.new(0.4), { TextTransparency = 1, TextStrokeTransparency = 1 }):Play()
		task.wait(0.45); l:Destroy()
	end)
	local kids = {}
	for _, c in ipairs(feed:GetChildren()) do if c:IsA("TextLabel") then table.insert(kids, c) end end
	if #kids > 5 then table.sort(kids, function(a, b) return a.LayoutOrder < b.LayoutOrder end); kids[1]:Destroy() end
end)

UserInputService.InputBegan:Connect(function(input: InputObject, processed: boolean)
	if processed then return end
	if input.UserInputType == Enum.UserInputType.MouseButton3 or input.KeyCode == Enum.KeyCode.K then askPing()
	elseif input.KeyCode == Enum.KeyCode.N then toggle() end
end)
player:GetAttributeChangedSignal("MatchId"):Connect(close)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="799">
        <Properties>
          <string name="Name">CommunityUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/CommunityUI (LocalScript)
-- Interface des ajouts « façon Roblox » : boutons Jouer / Lobby, panneau des codes promo, panneau du groupe Roblox,
-- rappel du like, messages et chronos du lobby (stand de tir, parcours), affichage des duels.
-- Le serveur vérifie tout (CodeService, LobbyService, DuelService) : ici on ne fait qu'afficher.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local GroupService = game:GetService("GroupService")

local CommunityConfig = require(ReplicatedStorage.Shared.CommunityConfig)
-- présentation et « retour » (B / Échap) communs avec le menu principal
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))

local player = Players.LocalPlayer

local C = {
	bg = Color3.fromRGB(13, 18, 29), panel = Color3.fromRGB(22, 29, 44), text = Color3.new(1, 1, 1), dim = Color3.fromRGB(150, 160, 180),
	red = Color3.fromRGB(255, 70, 85), blue = Color3.fromRGB(74, 163, 255), gold = Color3.fromRGB(255, 200, 60), green = Color3.fromRGB(80, 230, 140),
	purple = Color3.fromRGB(170, 90, 255), robloxGreen = Color3.fromRGB(0, 176, 111),
}

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o: any = Instance.new(class)
	if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
	if class == "TextLabel" or class == "TextButton" or class == "TextBox" then
		o.Font = Enum.Font.GothamBold; o.TextColor3 = C.text; o.BorderSizePixel = 0
	end
	if class == "TextLabel" then o.BackgroundTransparency = 1 end
	for k, v in pairs(props) do o[k] = v end
	o.Parent = parent
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 8) }, o) end
local function tween(o: Instance, t: number, props: { [string]: any })
	TweenService:Create(o, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), props):Play()
end

local gui = make("ScreenGui", { Name = "CommunityUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 12,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

-- ==========================================================================================
-- Message court en haut de l'écran
-- ==========================================================================================
local toast = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 150), Size = UDim2.fromOffset(620, 34),
	BackgroundTransparency = 0.2, BackgroundColor3 = C.bg, TextSize = 18, Text = "", Visible = false }, gui)
corner(toast, 10)
local toastToken = 0
local function showToast(text: string, color: Color3?, seconds: number?)
	toastToken += 1
	local my = toastToken
	toast.Text = text; toast.TextColor3 = color or C.text; toast.Visible = true
	toast.TextTransparency = 0; toast.BackgroundTransparency = 0.2
	task.delay(seconds or 4, function()
		if my ~= toastToken then return end
		tween(toast, 0.4, { TextTransparency = 1, BackgroundTransparency = 1 })
		task.delay(0.45, function() if my == toastToken then toast.Visible = false end end)
	end)
end

-- ==========================================================================================
-- Panneaux (libèrent la souris pendant qu'ils sont ouverts)
-- ==========================================================================================
local openPanel: Frame? = nil
local function setOpen(panel: Frame?)
	if openPanel and openPanel ~= panel then openPanel.Visible = false end
	openPanel = panel
	if panel then panel.Visible = true end
	player:SetAttribute("UiOpen", panel ~= nil)
end

local function panel(title: string, accent: Color3, height: number): (Frame, Frame)
	local f = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(440, height),
		BackgroundColor3 = Color3.new(1, 1, 1), Visible = false, ZIndex = 40 }, gui)
	-- même fenêtre que le passe, le calendrier et la boutique : dégradé teinté de la couleur du panneau, bord fin
	corner(f, 16); K.gradient(f, accent:Lerp(K.rgb(0x0b111c), 0.8), K.rgb(0x0b111c), 90)
	make("UIStroke", { Color = accent, Thickness = 1.5, Transparency = 0.4 }, f)
	make("TextLabel", { Size = UDim2.new(1, -60, 0, 44), Position = UDim2.fromOffset(20, 8), Text = title, TextSize = 24, Font = Enum.Font.GothamBlack,
		TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = accent, ZIndex = 41 }, f)
	local close = make("TextButton", { Size = UDim2.fromOffset(36, 36), Position = UDim2.new(1, -48, 0, 12), BackgroundColor3 = C.panel, Text = "✕", TextSize = 18,
		Modal = true, ZIndex = 41 }, f)   -- Modal : libère le curseur en vue à la première personne
	corner(close, 8)
	require(ReplicatedStorage.Shared.Icons).closeButton(close, 14)   -- la croix U+2715 donne un carré vide
	close.Activated:Connect(function() setOpen(nil) end)
	K.juice(close)
	-- B / Échap / Retour arrière ferment le panneau ; à la manette, la sélection arrive sur la croix
	K.overlay(f, function() if openPanel == f then setOpen(nil) end end, function() return close end)
	local body = make("Frame", { Size = UDim2.new(1, -40, 1, -70), Position = UDim2.fromOffset(20, 60), BackgroundTransparency = 1, ZIndex = 41 }, f)
	return f, body
end

local function button(parent: Instance, text: string, color: Color3, pos: UDim2, size: UDim2): TextButton
	local b = make("TextButton", { Position = pos, Size = size, BackgroundColor3 = color, Text = text, TextSize = 16, Font = Enum.Font.GothamBlack, ZIndex = 42,
		AutoButtonColor = false }, parent)
	corner(b, 8)
	K.juice(b)   -- survol, clic et son d'interface comme les boutons du menu
	return b
end

-- ---------- Codes promo ----------
local redeem = ReplicatedStorage:WaitForChild("RedeemCode") :: RemoteFunction
local codesPanel, codesBody = panel("🎟️ CODES", C.purple, 250)
make("TextLabel", { Size = UDim2.new(1, 0, 0, 36), Text = "Les codes sont annoncés sur le Discord, sur YouTube et dans la description du jeu.",
	TextSize = 13, TextColor3 = C.dim, TextWrapped = true, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 42 }, codesBody)
local codeBox = make("TextBox", { Position = UDim2.fromOffset(0, 44), Size = UDim2.new(1, -130, 0, 44), BackgroundColor3 = C.panel, PlaceholderText = "Tape un code…",
	PlaceholderColor3 = C.dim, Text = "", TextSize = 18, ClearTextOnFocus = false, ZIndex = 42 }, codesBody)
corner(codeBox, 8)
local codeBtn = button(codesBody, "VALIDER", C.purple, UDim2.new(1, -120, 0, 44), UDim2.fromOffset(120, 44))
local codeResult = make("TextLabel", { Position = UDim2.fromOffset(0, 98), Size = UDim2.new(1, 0, 0, 70), Text = "", TextSize = 15, TextWrapped = true,
	TextYAlignment = Enum.TextYAlignment.Top, TextXAlignment = Enum.TextXAlignment.Left, ZIndex = 42 }, codesBody)
local function submitCode()
	local text = codeBox.Text
	if #text == 0 then return end
	codeBtn.Text = "…"
	local res = redeem:InvokeServer(text)
	codeBtn.Text = "VALIDER"
	if res and res.ok then
		codeResult.TextColor3 = C.green
		codeResult.Text = "✅ " .. res.msg .. "\n" .. table.concat(res.lines or {}, "   ")
		codeBox.Text = ""
	else
		codeResult.TextColor3 = C.red
		codeResult.Text = "❌ " .. (res and res.msg or "Erreur")
	end
end
codeBtn.Activated:Connect(submitCode)
codeBox.FocusLost:Connect(function(enter: boolean) if enter then submitCode() end end)

-- ---------- Groupe Roblox ----------
local groupStatus = ReplicatedStorage:WaitForChild("GetGroupStatus") :: RemoteFunction
local claimGroup = ReplicatedStorage:WaitForChild("ClaimGroupReward") :: RemoteFunction
local G = CommunityConfig.GROUP
local groupPanel, groupBody = panel("👥 GROUPE ROBLOX", C.robloxGreen, 300)
make("TextLabel", { Size = UDim2.new(1, 0, 0, 70), TextWrapped = true, TextSize = 15, TextXAlignment = Enum.TextXAlignment.Left, TextYAlignment = Enum.TextYAlignment.Top,
	Text = "Rejoins le groupe du jeu et reçois " .. (G.reward.coins or 0) .. " 💰 + l'effet d'élimination « Esprit du groupe », qu'on ne trouve nulle part ailleurs.",
	ZIndex = 42 }, groupBody)
local joinBtn = button(groupBody, "REJOINDRE LE GROUPE", C.robloxGreen, UDim2.fromOffset(0, 80), UDim2.new(1, 0, 0, 44))
local claimBtn = button(groupBody, "RÉCUPÉRER MA RÉCOMPENSE", C.gold, UDim2.fromOffset(0, 132), UDim2.new(1, 0, 0, 44))
local groupResult = make("TextLabel", { Position = UDim2.fromOffset(0, 184), Size = UDim2.new(1, 0, 0, 40), Text = "", TextSize = 14, TextWrapped = true, ZIndex = 42 }, groupBody)
local function refreshGroup()
	local st = groupStatus:InvokeServer()
	if not st then return end
	if st.groupId <= 0 then
		joinBtn.Text = "GROUPE BIENTÔT DISPONIBLE"; joinBtn.BackgroundColor3 = C.panel
		claimBtn.Visible = false
	elseif st.claimed then
		claimBtn.Text = "✅ RÉCOMPENSE RÉCUPÉRÉE"; claimBtn.BackgroundColor3 = C.panel
	end
end
joinBtn.Activated:Connect(function()
	if G.id <= 0 then return end
	pcall(function() (GroupService :: any):PromptJoinAsync(G.id) end)   -- fenêtre officielle Roblox « Rejoindre le groupe »
end)
claimBtn.Activated:Connect(function()
	local res = claimGroup:InvokeServer()
	if res and res.ok then
		groupResult.TextColor3 = C.green; groupResult.Text = "✅ " .. res.msg .. "  " .. table.concat(res.lines or {}, "   ")
	else
		groupResult.TextColor3 = C.red; groupResult.Text = "❌ " .. (res and res.msg or "Erreur")
	end
	refreshGroup()
end)

-- bornes du lobby (ProximityPrompt) : le serveur demande d'ouvrir un panneau
local panels = { codes = codesPanel, group = groupPanel }
;(ReplicatedStorage:WaitForChild("OpenPanel") :: RemoteEvent).OnClientEvent:Connect(function(id: string)
	local f = panels[id]
	if not f then return end
	if id == "group" then task.spawn(refreshGroup) end
	setOpen(if openPanel == f then nil else f)
end)

-- ==========================================================================================
-- Boutons à gauche : Jouer / Lobby / Codes / Groupe (clic avec M pour libérer la souris)
-- ==========================================================================================
local joinMatch = ReplicatedStorage:WaitForChild("JoinMatch", 10) :: RemoteFunction?
local leaveMatch = ReplicatedStorage:WaitForChild("LeaveMatch", 10) :: RemoteFunction?
local side = make("Frame", { Position = UDim2.new(0, 16, 0.5, -90), Size = UDim2.fromOffset(150, 200), BackgroundTransparency = 1 }, gui)
make("UIListLayout", { Padding = UDim.new(0, 8), SortOrder = Enum.SortOrder.LayoutOrder }, side)
local function sideButton(text: string, color: Color3, order: number, cb: () -> ()): TextButton
	local b = make("TextButton", { Size = UDim2.fromOffset(150, 40), BackgroundColor3 = color, Text = text, TextSize = 15, Font = Enum.Font.GothamBlack, LayoutOrder = order }, side)
	corner(b, 8)
	b.Activated:Connect(cb)
	return b
end
local playBtn = sideButton("🎮 JOUER", C.red, 1, function()
	if joinMatch then joinMatch:InvokeServer() end
end)
local lobbyBtn = sideButton("🏠 LOBBY", C.panel, 2, function()
	if leaveMatch then leaveMatch:InvokeServer() end
end)
sideButton("🎟️ CODES", C.purple, 3, function() setOpen(if openPanel == codesPanel then nil else codesPanel) end)
sideButton("👥 GROUPE", C.robloxGreen, 4, function()
	task.spawn(refreshGroup)
	setOpen(if openPanel == groupPanel then nil else groupPanel)
end)

local queueLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -170), Size = UDim2.fromOffset(500, 28),
	TextSize = 18, TextColor3 = C.gold, Text = "", TextStrokeTransparency = 0.5 }, gui)

local function refreshZone()
	local zone = player:GetAttribute("Zone")
	playBtn.Visible = false    -- remplacés par le menu principal (JOUER, « Quitter la partie »)
	lobbyBtn.Visible = false
	side.Visible = zone ~= "duel" and zone ~= "match" and player:GetAttribute("MenuOpen") ~= true   -- comme le web : rien de ça en partie
	local q = player:GetAttribute("DuelQueued")
	queueLabel.Text = if zone == "lobby" and q then "⏳ En attente d'adversaires… reste sur la plateforme" else ""
end
player:GetAttributeChangedSignal("Zone"):Connect(refreshZone)
player:GetAttributeChangedSignal("DuelQueued"):Connect(refreshZone)
player:GetAttributeChangedSignal("MenuOpen"):Connect(refreshZone)
do   -- menu principal (MainMenu) : ouvre les panneaux Codes et Groupe
	local registry = require(ReplicatedStorage.Shared.ClientState).panels
	gui.DisplayOrder = 30   -- au-dessus du menu (qui est à 19, au-dessus du HUD de partie)
	registry.codes = function() setOpen(if openPanel == codesPanel then nil else codesPanel) end
	registry.group = function() task.spawn(refreshGroup); setOpen(if openPanel == groupPanel then nil else groupPanel) end
end
refreshZone()

-- ==========================================================================================
-- Lobby : messages, chrono du parcours, défi du stand de tir
-- ==========================================================================================
local lobbyToast = ReplicatedStorage:WaitForChild("LobbyToast", 10) :: RemoteEvent?
if lobbyToast then lobbyToast.OnClientEvent:Connect(function(text: string, color: Color3?) showToast(text, color, 5) end) end

local timerLabel = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 96), Size = UDim2.fromOffset(360, 44),
	BackgroundColor3 = C.bg, BackgroundTransparency = 0.25, TextSize = 26, Font = Enum.Font.GothamBlack, Text = "", Visible = false }, gui)
corner(timerLabel, 10)
local timer: any = nil
local lobbyTimer = ReplicatedStorage:WaitForChild("LobbyTimer", 10) :: RemoteEvent?
if lobbyTimer then
	lobbyTimer.OnClientEvent:Connect(function(t: any)
		if t.kind == "stop" then timer = nil; timerLabel.Visible = false; return end
		timer = t
		timerLabel.Visible = true
	end)
end
RunService.Heartbeat:Connect(function()
	if not timer then return end
	local now = workspace:GetServerTimeNow()
	if timer.kind == "parkour" then
		timerLabel.TextColor3 = C.green
		timerLabel.Text = string.format("🏃 %.2f s", now - timer.start)
	elseif timer.kind == "range" then
		local left = math.max(0, timer.endsAt - now)
		timerLabel.TextColor3 = if (timer.score or 0) >= timer.goal then C.green else C.gold
		timerLabel.Text = string.format("🎯 %d / %d   ·   %.1f s", timer.score or 0, timer.goal, left)
	end
end)

-- ==========================================================================================
-- Duels
-- ==========================================================================================
local duelTop = make("Frame", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 14), Size = UDim2.fromOffset(460, 70),
	BackgroundColor3 = C.bg, BackgroundTransparency = 0.2, Visible = false }, gui)
corner(duelTop, 12)
local duelMode = make("TextLabel", { Size = UDim2.new(1, 0, 0, 18), Position = UDim2.fromOffset(0, 4), TextSize = 12, TextColor3 = C.dim, Text = "" }, duelTop)
local duelMe = make("TextLabel", { Size = UDim2.new(0.42, 0, 0, 44), Position = UDim2.fromScale(0, 0.3), TextSize = 16, TextColor3 = C.blue, Text = "",
	TextXAlignment = Enum.TextXAlignment.Right }, duelTop)
local duelScore = make("TextLabel", { Size = UDim2.new(0.16, 0, 0, 44), Position = UDim2.fromScale(0.42, 0.3), TextSize = 28, Font = Enum.Font.GothamBlack, Text = "0 - 0" }, duelTop)
local duelThem = make("TextLabel", { Size = UDim2.new(0.42, 0, 0, 44), Position = UDim2.fromScale(0.58, 0.3), TextSize = 16, TextColor3 = C.red, Text = "",
	TextXAlignment = Enum.TextXAlignment.Left }, duelTop)
local bigText = make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.38), Size = UDim2.fromOffset(700, 90),
	TextSize = 64, Font = Enum.Font.GothamBlack, Text = "", TextStrokeTransparency = 0.4 }, gui)
local function flashBig(text: string, color: Color3, seconds: number)
	bigText.Text = text; bigText.TextColor3 = color; bigText.TextTransparency = 0
	local my = text
	task.delay(seconds, function() if bigText.Text == my then tween(bigText, 0.3, { TextTransparency = 1 }) end end)
end

local duelState = ReplicatedStorage:WaitForChild("DuelState", 10) :: RemoteEvent?
if duelState then
	duelState.OnClientEvent:Connect(function(s: any)
		if s.phase == "feed" then showToast(s.feed, C.text, 2.5); return end
		duelTop.Visible = true
		duelMode.Text = string.upper(s.mode or "Duel") .. "  ·  premier à " .. s.toWin .. (if (s.pot or 0) > 0 then "  ·  pot " .. s.pot .. " 💰" else "")
		duelScore.Text = s.me .. " - " .. s.them
		if s.myTeam then duelMe.Text = s.myTeam .. "  " end
		if s.theirTeam then duelThem.Text = "  " .. s.theirTeam end
		if s.phase == "countdown" then
			flashBig(if s.count == 3 then "MANCHE " .. s.round else tostring(s.count), C.gold, 0.9)
		elseif s.phase == "live" then
			flashBig("GO !", C.green, 0.8)
		elseif s.phase == "round" then
			if s.result == "win" then flashBig("MANCHE GAGNÉE", C.green, 2)
			elseif s.result == "loss" then flashBig("MANCHE PERDUE", C.red, 2)
			else flashBig("ÉGALITÉ", C.dim, 2) end
		end
	end)
end

local duelEnd = ReplicatedStorage:WaitForChild("DuelEnd", 10) :: RemoteEvent?
if duelEnd then
	duelEnd.OnClientEvent:Connect(function(r: any)
		duelTop.Visible = false
		local title = if r.draw then "ÉGALITÉ" elseif r.won then "VICTOIRE !" else "DÉFAITE"
		flashBig(title, if r.won then C.gold elseif r.draw then C.dim else C.red, 3.5)
		local elo = (if r.eloDelta >= 0 then "+" else "") .. r.eloDelta .. " Elo · " .. r.rank .. " (" .. r.elo .. ")"
		local coins = if r.coins > 0 then "  ·  +" .. r.coins .. " 💰" elseif r.stake > 0 and not r.won then "  ·  -" .. r.stake .. " 💰" else ""
		showToast(r.me .. " - " .. r.them .. "  ·  " .. elo .. coins, if r.won then C.gold else C.text, 6)
	end)
end
player:GetAttributeChangedSignal("Zone"):Connect(function()
	if player:GetAttribute("Zone") ~= "duel" then duelTop.Visible = false end
end)

-- ==========================================================================================
-- Rappel du « J'aime » (une fois par session, sans récompense)
-- ==========================================================================================
task.delay(G.likeReminderAfter, function()
	showToast("Tu t'amuses ? Mets un 👍 et ajoute Strike Arena à tes favoris, ça nous aide énormément !", C.gold, 8)
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="800">
        <Properties>
          <string name="Name">DailyUI</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/DailyUI (LocalScript)
-- CALENDRIER DE CONNEXION sur 7 jours (façon Fortnite / Call of Duty Mobile) : les 7 récompenses de la série
-- (Config.DAILY) côte à côte, jours déjà pris tamponnés ✔, jour du jour qui brille avec RÉCUPÉRER, gros lot du 7e jour,
-- paliers de série suivants (LoyaltyConfig.STREAK_GOALS, à récupérer dans les Cadeaux) et rappel des bonus du jour
-- (première victoire, XP ×2 du week-end).
-- S'ouvre tout seul la première fois qu'on ouvre le menu dans la journée si la récompense attend, et par le bouton
-- BONUS DU JOUR du menu (S.panels.daily). Le serveur (RewardService.claimDaily via ClaimDaily) vérifie tout.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Config = require(ReplicatedStorage.Shared.Config)
local L = require(ReplicatedStorage.Shared.LoyaltyConfig)
local S = require(ReplicatedStorage.Shared.ClientState)
local Icons = require(ReplicatedStorage.Shared.Icons)
local K = require(script.Parent:WaitForChild("Menu"):WaitForChild("Kit"))
local C = K.C
local make, text, spaced = K.make, K.text, K.spaced

local player = Players.LocalPlayer
local function call(name: string, ...: any): any
	local r = ReplicatedStorage:FindFirstChild(name)
	if not r or not r:IsA("RemoteFunction") then return nil end
	local ok, res = pcall((r :: RemoteFunction).InvokeServer, r :: RemoteFunction, ...)
	return if ok then res else nil
end

local gui = make("ScreenGui", { Name = "DailyUI", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 31, Enabled = false,
	ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
local veil = make("TextButton", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = K.rgb(0x05080e), BackgroundTransparency = 0.35, Text = "", AutoButtonColor = false, Modal = true }, gui)
local win = make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5), Size = UDim2.fromOffset(980, 470), BackgroundTransparency = 0,
	BackgroundColor3 = C.white }, gui)
K.corner(win, 16); K.gradient(win, K.rgb(0x2a1608), K.rgb(0x0b111c), 90); K.stroke(win, C.gold, 1.5, 0.45)
local winScale = make("UIScale", { Scale = 1 }, win)
local function fit()
	local cam = workspace.CurrentCamera
	local vp = if cam then cam.ViewportSize else Vector2.new(1600, 900)
	winScale.Scale = math.clamp(math.min((vp.X - 24) / 980, (vp.Y - 24) / 470), 0.45, 1.2)
end
text(win, { Position = UDim2.fromOffset(28, 18), Size = UDim2.new(1, -100, 0, 30), Font = K.BLACK, TextSize = 26, TextWrapped = false,
	Text = "📅  " .. spaced("CALENDRIER DE CONNEXION", 2) })
local subL = text(win, { Position = UDim2.fromOffset(30, 52), Size = UDim2.new(1, -100, 0, 18), TextSize = 13, TextColor3 = C.sub, TextWrapped = false, Text = "" })
local closeB = K.btn(win, "✕", "dark", function() gui.Enabled = false end, { AnchorPoint = Vector2.new(1, 0), Position = UDim2.new(1, -16, 0, 16), Size = UDim2.fromOffset(40, 40), TextSize = 18 })
local days = make("Frame", { Position = UDim2.fromOffset(28, 86), Size = UDim2.new(1, -56, 0, 210) }, win)
K.hlist(days, 10, Enum.VerticalAlignment.Bottom)
local foot = make("Frame", { Position = UDim2.fromOffset(28, 312), Size = UDim2.new(1, -56, 0, 140) }, win)
K.vlist(foot, 8)

local function rewardParts(r: any): (string, string)
	local ic, t = Icons.COIN, {}
	if r.coins then table.insert(t, K.fmt(r.coins) .. " pièces") end
	if r.dance then ic = "💃"; table.insert(t, "Danse « " .. (Config.DANCES[r.dance] and Config.DANCES[r.dance].name or r.dance) .. " »") end
	if r.box then ic = "📦"; table.insert(t, if r.box == "prem" then "Caisse Premium" else "Caisse Standard") end
	return ic, table.concat(t, " + ")
end

local data: any = nil
local render: () -> ()
local claimB: TextButton? = nil   -- RÉCUPÉRER du jour (sélectionné à la manette à l'ouverture)
local function claim()
	local res = call("ClaimDaily")
	if res and res.reward then
		pcall(function() K.uiSound(false) end)
		local _, t = rewardParts(res.reward)
		subL.Text = "🎁 Jour " .. tostring(res.day) .. " récupéré : " .. t .. " !"
		subL.TextColor3 = C.gold
	end
	data = call("GetProfile") or data
	render()
	local f = S.panels.menuRefresh; if f then task.spawn(f) end
end

render = function()
	K.clear(days); K.clear(foot)   -- les UIListLayout restent
	claimB = nil
	local ds = data and data.daily or { canClaim = false, day = 1, streak = 0 }
	local today = tonumber(ds.day) or 1
	for i, r in ipairs(Config.DAILY) do
		local big = i == 7
		local taken = (ds.canClaim and i < today) or (not ds.canClaim and i <= today)
		local now = ds.canClaim and i == today
		local f = make("Frame", { LayoutOrder = i, Size = UDim2.fromOffset(if big then 176 else 112, if now or big then 206 else 186), BackgroundTransparency = 0,
			BackgroundColor3 = C.white }, days)
		K.corner(f, 12)
		K.gradient(f, if big then K.rgb(0x4a3108) elseif now then K.rgb(0x3a2410) else K.rgb(0x16233a), K.rgb(0x0b111c), 90, if taken then 0.3 else 0, if taken then 0.3 else 0)
		K.stroke(f, if now then C.gold elseif big then C.gold elseif taken then C.green else C.white, if now then 2.5 else 1, if now or big then 0.1 elseif taken then 0.5 else 0.88)
		text(f, { Position = UDim2.fromOffset(0, 10), Size = UDim2.new(1, 0, 0, 16), Font = K.BLACK, TextSize = 12, TextXAlignment = Enum.TextXAlignment.Center,
			TextColor3 = if now then C.gold else C.sub, Text = spaced(if big then "JOUR 7 · GROS LOT" else "JOUR " .. i, 1) })
		local ic, t = rewardParts(r)
		-- pièces : pièce dessinée (Shared/Icons), l'emoji pièce du web donne un carré vide dans Roblox
		local icon: GuiObject
		if ic == Icons.COIN then
			local g = make("CanvasGroup", { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 64), BackgroundTransparency = 1 }, f)
			Icons.coin(g, if big then 52 else 44, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.fromScale(0.5, 0.5) })
			icon = g
		else
			icon = text(f, { Position = UDim2.fromOffset(0, 32), Size = UDim2.new(1, 0, 0, 64), TextSize = if big then 54 else 44, TextXAlignment = Enum.TextXAlignment.Center, Text = ic })
		end
		text(f, { Position = UDim2.fromOffset(6, 100), Size = UDim2.new(1, -12, 0, 40), TextSize = 12, Font = K.BOLD, TextXAlignment = Enum.TextXAlignment.Center,
			TextYAlignment = Enum.TextYAlignment.Top, Text = t })
		if taken then
			if icon:IsA("TextLabel") then icon.TextTransparency = 0.5 elseif icon:IsA("CanvasGroup") then icon.GroupTransparency = 0.5 end
			-- tampon « pris » : coche verte dessinée (le ✔ texte sort en emoji gris)
			Icons.check(f, 54, C.green, { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.5, 0, 0, 64), Rotation = -12 })
		elseif now then
			local b = K.btn(f, spaced("RÉCUPÉRER", 1), "gold", claim, { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -10), Size = UDim2.new(1, -16, 0, 34), TextSize = 12 })
			K.beat(b, 1.06, 1)
			K.shine(f, 2.2, 0.3)
			claimB = b
		else
			text(f, { AnchorPoint = Vector2.new(0, 1), Position = UDim2.new(0, 0, 1, -14), Size = UDim2.new(1, 0, 0, 16), TextSize = 11, TextColor3 = C.dim,
				TextXAlignment = Enum.TextXAlignment.Center, Text = if i == today and not ds.canClaim then "Reviens demain" else "Dans " .. (i - today + (if ds.canClaim then 0 else 0)) .. " j" })
		end
	end
	-- série et paliers de série suivants
	local streak = tonumber(ds.streak) or 0
	subL.TextColor3 = C.sub
	subL.Text = if ds.canClaim then "Ta récompense du jour t'attend ! Connecte-toi chaque jour : la série repart à zéro si tu manques un jour."
		else "Série de " .. streak .. " jour" .. (if streak > 1 then "s" else "") .. " · reviens demain pour le jour " .. (today % 7 + 1)
	local nextGoal = nil
	for _, g in ipairs(L.STREAK_GOALS) do if streak < g.days then nextGoal = g; break end end
	if nextGoal then
		local row = make("Frame", { LayoutOrder = 1, Size = UDim2.new(1, 0, 0, 36) }, foot)
		local parts = {}
		local r: any = nextGoal.reward
		if r.coins then table.insert(parts, K.fmt(r.coins) .. " pièces") end
		if r.box then table.insert(parts, if r.box == "prem" then "Caisse Premium" else "Caisse Standard") end
		if r.boost then table.insert(parts, r.boost .. " boosts d'XP") end
		if r.title and L.TITLES[r.title] then table.insert(parts, "titre « " .. L.TITLES[r.title] .. " »") end
		text(row, { Size = UDim2.new(1, 0, 0, 16), Font = K.BLACK, TextSize = 12, TextWrapped = false,
			Text = nextGoal.icon .. "  " .. spaced("PROCHAIN PALIER DE SÉRIE", 1) .. " : " .. nextGoal.days .. " jours → " .. table.concat(parts, " + ") })
		K.bar(row, streak / nextGoal.days, { Position = UDim2.fromOffset(0, 22), Size = UDim2.new(1, 0, 0, 6) })
	end
	local tips = { "🏆 Première victoire du jour : +" .. L.FIRST_WIN.xp .. " XP et +" .. L.FIRST_WIN.coins .. " pièces." }
	if data and data.weekend then table.insert(tips, 1, "⚡ C'est le week-end : XP ×2 sur toutes les parties !") end
	table.insert(tips, "⭐ Premium : un jour manqué par semaine ne casse pas ta série, et un cadeau de plus chaque jour.")
	for i, t in ipairs(tips) do K.para(foot, t, 12, if i == 1 and data and data.weekend then C.violet else C.dim, 1 + i) end
end

local function open()
	fit()
	data = call("GetProfile") or data
	gui.Enabled = true
	render()
	-- petite entrée qui rebondit (sur l'échelle d'adaptation à l'écran : un seul UIScale par cadre)
	local target = winScale.Scale
	winScale.Scale = target * 0.9; K.tween(winScale, 0.25, { Scale = target }, Enum.EasingStyle.Back)
end
veil.Activated:Connect(function() gui.Enabled = false end)
-- B / Échap / Retour arrière ferment le calendrier ; à la manette, la sélection arrive sur RÉCUPÉRER (sinon la croix)
K.overlay(gui, function() gui.Enabled = false end, function() return claimB or closeB end)
S.panels.daily = function()
	if gui.Enabled then gui.Enabled = false else task.spawn(open) end
end

-- une autre grande fenêtre est ouverte (passe de combat, boutique) : même DisplayOrder ou presque, le calendrier
-- s'empilait dessus et leurs deux voiles se superposaient
local function otherWindowOpen(): boolean
	local pg = player:FindFirstChildOfClass("PlayerGui")
	if not pg then return false end
	local pass = pg:FindFirstChild("PassUI")
	if pass and pass:IsA("ScreenGui") and pass.Enabled then return true end
	local shop = pg:FindFirstChild("ShopUI")
	if shop then
		for _, c in ipairs(shop:GetChildren()) do
			if c:IsA("TextButton") and c.Modal and c.Visible then return true end   -- voile de la boutique
		end
	end
	return false
end

-- ouverture automatique : la première fois que le menu s'ouvre au lobby avec la récompense du jour en attente
task.spawn(function()
	local shown = false
	while not shown do
		task.wait(1.5)
		if S.menuOpen and player:GetAttribute("Zone") == "lobby" and not otherWindowOpen() then
			local d = call("GetProfile")
			if d and d.daily then
				shown = true
				if d.daily.canClaim then task.wait(1); data = d; if not gui.Enabled then open() end end
			end
		end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="801">
        <Properties>
          <string name="Name">EmoteController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/EmoteController (LocalScript)
-- Touche T : joue la danse équipée (animation R15 que tu crées dans l'Animation Editor).
-- Les touches sont personnalisables : lis-les depuis le profil (profile.binds) ou ContextActionService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ContextActionService = game:GetService("ContextActionService")
local Players = game:GetService("Players")
local Config = require(ReplicatedStorage.Shared.Config)

local player = Players.LocalPlayer
local getProfile = ReplicatedStorage:WaitForChild("GetProfile") :: RemoteFunction

local current: AnimationTrack? = nil
local moveConn: RBXScriptConnection? = nil

local function stop()
	if current then current:Stop(0.2); current = nil end
	if moveConn then moveConn:Disconnect(); moveConn = nil end
end

-- la demande du profil attend le serveur : elle se fait hors de l'action (une action ne doit pas attendre)
local function play(hum: Humanoid)
	local ok, data = pcall(getProfile.InvokeServer, getProfile)
	if not ok or not data or not data.profile or hum.Health <= 0 or not hum.Parent then return end
	local def = Config.DANCES[data.profile.equippedDance]
	if not def then return end
	if def.animationId == "rbxassetid://0" then
		-- pas d'animation importée : danse procédurale du jeu web, jouée par SoldierController chez tout le monde
		local dr = ReplicatedStorage:FindFirstChild("SoldierDance") :: RemoteEvent?
		if dr then dr:FireServer(true) end
		return
	end
	stop()
	local anim = Instance.new("Animation"); anim.AnimationId = def.animationId
	local animator = hum:FindFirstChildOfClass("Animator") or Instance.new("Animator", hum)
	local track = animator:LoadAnimation(anim)
	current = track
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.2)
	task.delay(def.length, function() if current == track then stop() end end)   -- pas la danse relancée entre-temps
	-- annule si le joueur bouge
	moveConn = hum.Running:Connect(function(speed) if speed > 1 and current == track then stop() end end)
end

local function emote(_, state: Enum.UserInputState)
	if state ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or player:GetAttribute("UiOpen") == true then return Enum.ContextActionResult.Pass end
	task.spawn(play, hum)
	return Enum.ContextActionResult.Sink
end
player.CharacterAdded:Connect(stop)

-- Touche configurable : remplace Enum.KeyCode.T par la valeur du profil du joueur
ContextActionService:BindAction("Emote", emote, false, Enum.KeyCode.T)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="802">
        <Properties>
          <string name="Name">GrenadeController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/GrenadeController (LocalScript)
-- Grenades et mines côté joueur, comme le jeu web : touches G (frag), F (flash), H (fumigène), X (mine),
-- bras qui lancent (ViewmodelController, S.throwStart), trajectoire affichée (même simulation que le serveur),
-- explosion, éclair, nuage de fumée, aveuglement + sifflement d'oreilles, secousse de la caméra,
-- compteur en bas à droite (#nades du web) et alerte grenade (src/8Zf_confort.js : icône 💣 autour du viseur
-- qui indique d'où vient une frag qui va sauter près de toi).
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ContextActionService = game:GetService("ContextActionService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local G = require(ReplicatedStorage.Shared.Grenades)
local S = require(ReplicatedStorage.Shared.ClientState)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local ShotFx = require(ReplicatedStorage.Shared.ShotFx)
local M = G.M

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local fxRemote = ReplicatedStorage:WaitForChild("GrenadeFx") :: RemoteEvent
local throwRemote = ReplicatedStorage:WaitForChild("ThrowGrenade") :: RemoteEvent
local mineRemote = ReplicatedStorage:WaitForChild("PlaceMine") :: RemoteEvent
local toastRemote = ReplicatedStorage:WaitForChild("GrenadeToast") :: RemoteEvent
local flashRemote = ReplicatedStorage:WaitForChild("FlashFeedback") :: RemoteEvent

local folder = Instance.new("Folder"); folder.Name = "GrenadesFx"; folder.Parent = workspace

-- ---------- interface ----------
local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local gui = Instance.new("ScreenGui"); gui.Name = "GrenadeHud"; gui.ResetOnSpawn = false; gui.IgnoreGuiInset = true; gui.DisplayOrder = 11
gui.Parent = player:WaitForChild("PlayerGui")
-- voile blanc de la flash (#flashfx)
local white = Instance.new("Frame"); white.Size = UDim2.fromScale(1, 1); white.BackgroundColor3 = Color3.new(1, 1, 1); white.BackgroundTransparency = 1
white.BorderSizePixel = 0; white.ZIndex = 20; white.Parent = gui
-- compteur (#nades), au-dessus des emplacements d'armes du HUD
local count = Instance.new("TextLabel"); count.AnchorPoint = Vector2.new(1, 1); count.Position = UDim2.new(1, -19, 1, -152)
count.Size = UDim2.fromOffset(320, 18); count.BackgroundTransparency = 1; count.Font = Enum.Font.GothamBold; count.TextSize = 13
count.TextColor3 = rgb(0xdbe5f5); count.TextStrokeTransparency = 0.5; count.TextXAlignment = Enum.TextXAlignment.Right; count.Text = ""
count.Parent = gui
local toast = Instance.new("TextLabel"); toast.AnchorPoint = Vector2.new(.5, 1); toast.Position = UDim2.new(.5, 0, 1, -170)
toast.Size = UDim2.fromOffset(300, 30); toast.BackgroundColor3 = rgb(0x161f33); toast.BackgroundTransparency = 0.1; toast.Font = Enum.Font.GothamBold
toast.TextSize = 14; toast.TextColor3 = Color3.new(1, 1, 1); toast.Visible = false; toast.Parent = gui
do local s = Instance.new("UIStroke"); s.Color = rgb(0xffd75e); s.Parent = toast end
local toastId = 0
local function showToast(t: string)
	toastId += 1
	local my = toastId
	toast.Text = t; toast.Visible = true
	task.delay(1.8, function() if toastId == my then toast.Visible = false end end)
end
toastRemote.OnClientEvent:Connect(function(t: any) if typeof(t) == "string" then showToast(t) end end)

local function stock(): (number, number, number, number)
	local raw = player:GetAttribute("Nades")
	if typeof(raw) ~= "string" then return 0, 0, 0, 0 end
	local f, fl, sm, mn = string.match(raw, "^(%d+),(%d+),(%d+),(%d+)$")
	return tonumber(f) or 0, tonumber(fl) or 0, tonumber(sm) or 0, tonumber(mn) or 0
end
local function drawCount()
	local f, fl, sm, mn = stock()
	if player:GetAttribute("Nades") == nil then count.Text = "" return end
	local t = (if f > 0 then "●G " else "○G ") .. (if fl > 0 then "●F×" .. fl .. " " else "○F ") .. (if sm > 0 then "●H" else "○H")
	if mn > 0 then t ..= "    ◉ ×" .. mn .. " [X]" end
	count.Text = t
end
player:GetAttributeChangedSignal("Nades"):Connect(drawCount)
drawCount()

-- ---------- commandes ----------
local function canUse(): boolean
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	return hum ~= nil and hum.Health > 0 and player:GetAttribute("UiOpen") ~= true and player:GetAttribute("MenuOpen") ~= true and S.kc == nil
end
local IDX = { frag = 1, flash = 2, smoke = 3 }
local function throw(kind: string)
	if not canUse() then return end
	local n = ({ stock() })[IDX[kind]]
	if (n or 0) <= 0 then return end
	throwRemote:FireServer(kind, camera.CFrame.LookVector)
	S.throwStart = os.clock(); S.inspectStart = -1
	Sfx.play(G.SFX.throw)
end
local function onAction(name: string, st: Enum.UserInputState)
	if st ~= Enum.UserInputState.Begin then return Enum.ContextActionResult.Pass end
	if name == "NadeFrag" then throw("frag")
	elseif name == "NadeFlash" then throw("flash")
	elseif name == "NadeSmoke" then throw("smoke")
	elseif name == "NadeMine" then
		local _, _, _, mn = stock()
		if canUse() and mn > 0 then mineRemote:FireServer(); S.throwStart = os.clock() end
	end
	return Enum.ContextActionResult.Sink
end
ContextActionService:BindAction("NadeFrag", onAction, true, Enum.KeyCode.G, Enum.KeyCode.ButtonL1)
ContextActionService:BindAction("NadeFlash", onAction, false, Enum.KeyCode.F)
ContextActionService:BindAction("NadeSmoke", onAction, false, Enum.KeyCode.H)
ContextActionService:BindAction("NadeMine", onAction, false, Enum.KeyCode.X)
ContextActionService:SetTitle("NadeFrag", "GRENADE")
ContextActionService:SetPosition("NadeFrag", UDim2.new(1, -208, 1, -224))

-- ---------- grenades en vol (affichage) ----------
type Vis = { n: G.Nade, model: Model, rot: CFrame, mine: boolean }
local flying: { [number]: Vis } = {}
local shake = 0

local function emitBurst(pos: Vector3, color: Color3, n: number, speed: number, size: number, life: number)
	local a = Instance.new("Attachment"); a.WorldPosition = pos; a.Parent = workspace.Terrain
	local pe = Instance.new("ParticleEmitter"); pe.Texture = "rbxasset://textures/particles/sparkles_main.dds"; pe.Color = ColorSequence.new(color)
	pe.LightEmission = 1; pe.Size = NumberSequence.new(size, 0); pe.Speed = NumberRange.new(speed * .3, speed); pe.SpreadAngle = Vector2.new(180, 180)
	pe.Lifetime = NumberRange.new(life * .5, life); pe.Rate = 0; pe.Parent = a
	pe:Emit(n)
	Debris:AddItem(a, life + .5)
end
local function lightBurst(pos: Vector3, color: Color3, brightness: number, range: number, t: number)
	local a = Instance.new("Attachment"); a.WorldPosition = pos; a.Parent = workspace.Terrain
	local l = Instance.new("PointLight"); l.Color = color; l.Brightness = brightness; l.Range = range; l.Shadows = false; l.Parent = a
	TweenService:Create(l, TweenInfo.new(t), { Brightness = 0 }):Play()
	Debris:AddItem(a, t + .1)
end
local function explosionFx(pos: Vector3, scale: number)
	local ex = Instance.new("Explosion"); ex.Position = pos; ex.BlastRadius = 0; ex.BlastPressure = 0; ex.DestroyJointRadiusPercent = 0
	ex.ExplosionType = Enum.ExplosionType.NoCraters; ex.Visible = true; ex.Parent = workspace
	emitBurst(pos + Vector3.new(0, .3 * M, 0), rgb(0xffa040), math.floor(30 * scale), 30 * scale, .8 * M * scale, .6)
	lightBurst(pos + Vector3.new(0, M, 0), rgb(0xffa050), 8, 30 * scale, .35)
	ShotFx.explosion(pos, scale)                       -- boule de feu, fumée sombre et débris du web
	-- anneau au sol (boomRings du web)
	local ring = Instance.new("Part"); ring.Shape = Enum.PartType.Cylinder; ring.Anchored = true; ring.CanCollide = false; ring.CanQuery = false; ring.CanTouch = false
	ring.Material = Enum.Material.Neon; ring.Color = rgb(0xffd9a0); ring.Transparency = .3; ring.Size = Vector3.new(.05, 1, 1)
	ring.CFrame = CFrame.new(pos + Vector3.new(0, .15 * M, 0)) * CFrame.Angles(0, 0, math.rad(90)); ring.Parent = folder
	local d = 9 * scale * M * 2
	TweenService:Create(ring, TweenInfo.new(.6, Enum.EasingStyle.Quad), { Size = Vector3.new(.05, d, d), Transparency = 1 }):Play()
	Debris:AddItem(ring, .65)
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if me then
		local dist = Vector3.new(me.Position.X - pos.X, 0, me.Position.Z - pos.Z).Magnitude / M
		if dist < 14 then shake = math.max(shake, .7 * (1 - dist / 14)) end
	end
end
-- nuage de fumée du web : 3,6 m de rayon, émis 3,2 s, particules de 13 à 17 s, gris clair
local function smokeFx(pos: Vector3)
	local cloud = Instance.new("Part"); cloud.Anchored = true; cloud.CanCollide = false; cloud.CanQuery = false; cloud.CanTouch = false
	cloud.Transparency = 1; cloud.Size = Vector3.one * G.SMOKE_R * 2 * .85 * M; cloud.Position = pos + Vector3.new(0, .5 * M, 0); cloud.Parent = folder
	local pe = Instance.new("ParticleEmitter"); pe.Texture = "rbxasset://textures/particles/smoke_main.dds"
	pe.Shape = Enum.ParticleEmitterShape.Sphere; pe.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
	pe.Rate = 60; pe.Lifetime = NumberRange.new(13, 17); pe.Speed = NumberRange.new(.1, .9); pe.SpreadAngle = Vector2.new(180, 180)
	pe.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1.6 * M), NumberSequenceKeypoint.new(.15, 3.2 * M), NumberSequenceKeypoint.new(1, 3.8 * M) })
	pe.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(.06, .38), NumberSequenceKeypoint.new(.8, .45), NumberSequenceKeypoint.new(1, 1) })
	pe.Color = ColorSequence.new(Color3.new(.78, .8, .82)); pe.RotSpeed = NumberRange.new(-10, 10); pe.Rotation = NumberRange.new(0, 360)
	pe.Parent = cloud
	task.delay(3.2, function() pe.Enabled = false end)
	Debris:AddItem(cloud, G.SMOKE_T + 1)
end

local function removeVis(id: number)
	local v = flying[id]
	if v then v.model:Destroy(); flying[id] = nil end
end

fxRemote.OnClientEvent:Connect(function(e: any)
	if typeof(e) ~= "table" then return end
	if e.op == "throw" then
		local model = G.mesh(e.kind)
		model.Parent = folder
		local n: G.Nade = { id = e.id, kind = e.kind, p = e.p, v = e.v, t = e.t, owner = e.owner, team = e.team }
		flying[e.id] = { n = n, model = model, rot = CFrame.identity, mine = e.owner == player.Character }
		if e.owner ~= player.Character then Sfx.play(G.SFX.throw, e.p, .6) end
	elseif e.op == "boom" then
		local v = flying[e.id]
		local pos = e.p :: Vector3
		removeVis(e.id)
		if e.kind == "frag" then Sfx.play(G.SFX.boom, pos, .8); explosionFx(pos, .75)
		elseif e.kind == "flash" then
			Sfx.play(G.SFX.bang, pos, 1)
			emitBurst(pos + Vector3.new(0, .3 * M, 0), Color3.new(1, 1, .9), 10, 3 * M, .5 * M, .3)
			lightBurst(pos + Vector3.new(0, .5 * M, 0), Color3.new(1, 1, 1), 20, 40, .25)
		else Sfx.play(G.SFX.smoke, pos, .9); Sfx.play(G.SFX.pop, pos, .8); smokeFx(pos) end
		local _ = v
	elseif e.op == "mine" then
		Sfx.play(G.SFX.click, e.p, .7)
	elseif e.op == "mineOff" then
		if e.boom then Sfx.play(G.SFX.boom, e.p, .7); explosionFx(e.p, .55)
		else Sfx.play(G.SFX.click, e.p, .8); emitBurst(e.p + Vector3.new(0, .1 * M, 0), rgb(0xffd080), 8, 2 * M, .1 * M, .3) end
	end
end)

-- ---------- aveuglement (flash) + sifflement ----------
local blindT = 0
local ring = Instance.new("Sound"); ring.SoundId = "rbxasset://sounds/electronicpingshort.wav"; ring.Looped = true; ring.PlaybackSpeed = 2.6
ring.Volume = 0; ring.Parent = gui
flashRemote.OnClientEvent:Connect(function(dur: any)
	if typeof(dur) ~= "number" then return end
	blindT = math.max(blindT, dur)
	white.BackgroundTransparency = 0
	ring.Volume = .25; if not ring.IsPlaying then ring:Play() end
	TweenService:Create(ring, TweenInfo.new(math.min(5, dur * 1.6)), { Volume = 0 }):Play()
end)

-- ---------- alerte grenade ----------
type Warn = { root: Frame, icon: TextLabel, stroke: UIStroke, arrow: Frame }
local warns: { Warn } = {}
local function newWarn(): Warn
	local root = Instance.new("Frame"); root.AnchorPoint = Vector2.new(.5, .5); root.Size = UDim2.fromOffset(44, 44); root.BackgroundTransparency = 1
	root.Position = UDim2.fromScale(.5, .5); root.ZIndex = 6; root.Parent = gui
	local icon = Instance.new("TextLabel"); icon.Size = UDim2.fromScale(1, 1); icon.BackgroundColor3 = Color3.new(); icon.BackgroundTransparency = .35
	icon.Text = "💣"; icon.TextSize = 21; icon.Font = Enum.Font.GothamBold; icon.TextColor3 = Color3.new(1, 1, 1); icon.ZIndex = 6; icon.Parent = root
	local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = icon
	local st = Instance.new("UIStroke"); st.Thickness = 2; st.Color = rgb(0xffb23a); st.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; st.Parent = icon
	-- flèche (triangle) qui tourne autour de l'icône vers la grenade
	local pivot = Instance.new("Frame"); pivot.AnchorPoint = Vector2.new(.5, .5); pivot.Position = UDim2.fromScale(.5, .5); pivot.Size = UDim2.fromOffset(0, 0)
	pivot.BackgroundTransparency = 1; pivot.ZIndex = 6; pivot.Parent = root
	local arrow = Instance.new("ImageLabel"); arrow.AnchorPoint = Vector2.new(.5, 1); arrow.Position = UDim2.fromOffset(0, -24); arrow.Size = UDim2.fromOffset(14, 10)
	arrow.BackgroundTransparency = 1; arrow.Image = "rbxasset://textures/ui/Controls/DesignSystem/ArrowUp.png"; arrow.ImageColor3 = rgb(0xffb23a); arrow.ZIndex = 6
	arrow.Parent = pivot
	return { root = root, icon = icon, stroke = st, arrow = pivot }
end

local params = G.params({})
RunService.RenderStepped:Connect(function(dt: number)
	local t = os.clock()
	-- trajectoires
	local chars: { Instance } = { folder, camera }
	for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(chars, p.Character) end end
	params.FilterDescendantsInstances = chars
	for id, v in pairs(flying) do
		local n = v.n
		if n.t > 0 then
			if G.step(n, math.min(dt, 1 / 20), params) then Sfx.play(G.SFX.click, n.p, .4) end
			if n.v.Magnitude > 1 then v.rot *= CFrame.Angles(dt * 8, 0, dt * 5) end
		elseif n.t < -1 then removeVis(id) continue           -- explosion jamais reçue : on nettoie
		else n.t -= dt end
		v.model:PivotTo(CFrame.new(n.p) * v.rot)
	end
	-- voile blanc
	if blindT > 0 then
		blindT -= dt
		white.BackgroundTransparency = 1 - math.min(1, math.max(0, blindT) * 1.3)
	end
	-- alerte grenade : frag des autres, à moins de 9,5 m (et moins de 4 m de hauteur)
	local list = {}
	local me = player.Character and player.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
	if me and canUse() then
		for _, v in pairs(flying) do
			local n = v.n
			if n.kind == "frag" and not v.mine then
				local dx, dz = (n.p.X - me.Position.X) / M, (n.p.Z - me.Position.Z) / M
				local d = math.sqrt(dx * dx + dz * dz)
				if d <= G.WARN_R and math.abs(n.p.Y - me.Position.Y) / M <= 4 then table.insert(list, { n = n, dx = dx, dz = dz, d = d }) end
			end
		end
	end
	while #warns < #list do table.insert(warns, newWarn()) end
	local look = camera.CFrame.LookVector
	local fwdV = Vector3.new(look.X, 0, look.Z)
	fwdV = if fwdV.Magnitude > 1e-3 then fwdV.Unit else Vector3.new(0, 0, -1)
	local rgtV = Vector3.new(-fwdV.Z, 0, fwdV.X)
	for i, w in ipairs(warns) do
		local it = list[i]
		if not it then w.root.Visible = false; continue end
		local fwd = it.dx * fwdV.X + it.dz * fwdV.Z
		local rgt = it.dx * rgtV.X + it.dz * rgtV.Z
		local L = math.max(1e-3, math.sqrt(fwd * fwd + rgt * rgt))
		local R = if it.d < 1.2 then 0 else 118
		w.root.Visible = true
		w.root.Position = UDim2.new(.5, rgt / L * R, .5, -fwd / L * R)
		local near = it.d < 5
		local col = if near then rgb(0xff4655) else rgb(0xffb23a)
		w.stroke.Color = col; (w.arrow:FindFirstChildOfClass("ImageLabel") :: ImageLabel).ImageColor3 = col
		local alpha = .55 + .45 * math.abs(math.sin(t * (if it.n.t < 1 then 18 else 9)))
		w.icon.TextTransparency = 1 - alpha; w.icon.BackgroundTransparency = 1 - alpha * .65; w.stroke.Transparency = 1 - alpha
		w.arrow.Rotation = math.deg(math.atan2(rgt, fwd)); w.arrow.Visible = R > 0
	end
end)

-- secousse de la caméra (G.shake du web), après la caméra Roblox
-- La caméra Roblox repart de la direction de l'image précédente : on n'ajoute que la différence avec la secousse
-- déjà posée (sinon les petits angles au hasard s'additionnaient et la visée restait décalée après l'explosion)
local shX, shY = 0, 0
RunService:BindToRenderStep("GrenadeShake", Enum.RenderPriority.Camera.Value + 1, function(dt: number)
	if S.kc ~= nil or camera.CameraType ~= Enum.CameraType.Custom then
		shX, shY = 0, 0; shake *= math.exp(-dt * 4)       -- une autre scène pose la caméra elle-même
		return
	end
	local nx, ny = 0, 0
	if shake > 0.001 then
		nx, ny = (math.random() - .5) * shake * .05, (math.random() - .5) * shake * .05
		shake *= math.exp(-dt * 4)
	end
	if nx ~= shX or ny ~= shY then camera.CFrame *= CFrame.Angles(nx - shX, ny - shY, 0) end
	shX, shY = nx, ny
end)

player.CharacterAdded:Connect(function() blindT = 0; white.BackgroundTransparency = 1; shake = 0 end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="803">
        <Properties>
          <string name="Name">HalloweenController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/HalloweenController (LocalScript)
-- Animations du décor d'Halloween posé par HalloweenService (src/8W_halloween.js) :
--   • repères « HwBats » : nuée de chauves-souris qui tournent autour du repère en battant des ailes (hwBats) ;
--   • lumières « HwFlicker » des citrouilles : vacillement de bougie.
-- Tout est local (aucune Part créée ici n'existe sur le serveur).
local CollectionService = game:GetService("CollectionService")
local RunService = game:GetService("RunService")

local camera = workspace.CurrentCamera
local BAT = Color3.fromRGB(11, 7, 16)

type Bat = { body: Part, wl: Part, wr: Part, r: number, h: number, sp: number, ph: number, fl: number, sz: number }
type Flock = { anchor: BasePart, bats: { Bat }, folder: Folder }
local flocks: { [Instance]: Flock } = {}

local function part(size: Vector3, parent: Instance): Part
	local p = Instance.new("Part")
	p.Size = size; p.Color = BAT; p.Material = Enum.Material.SmoothPlastic
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.Parent = parent
	return p
end

local function addFlock(anchor: Instance)
	if not anchor:IsA("BasePart") or flocks[anchor] then return end
	local n = anchor:GetAttribute("N")
	local rad = anchor:GetAttribute("Radius")
	local count = if typeof(n) == "number" then n else 14
	local radius = if typeof(rad) == "number" then rad else 60
	local folder = Instance.new("Folder"); folder.Name = "HwBatsLocal"; folder.Parent = workspace
	local rng = Random.new()
	local bats = {}
	for _ = 1, count do
		local sz = rng:NextNumber(0.7, 1.2) * 3.5
		local b: Bat = {
			body = part(Vector3.new(sz * 0.22, sz * 0.22, sz * 0.4), folder),
			wl = part(Vector3.new(sz * 0.55, 0.08, sz * 0.32), folder),
			wr = part(Vector3.new(sz * 0.55, 0.08, sz * 0.32), folder),
			r = radius * rng:NextNumber(0.5, 1.1), h = rng:NextNumber(-2, 3) * 3.5,
			sp = rng:NextNumber(0.35, 0.7) * (if rng:NextNumber() < 0.5 then -1 else 1),
			ph = rng:NextNumber(0, math.pi * 2), fl = rng:NextNumber(14, 20), sz = sz,
		}
		b.body.Shape = Enum.PartType.Ball
		-- pas de PointLight dans les yeux : 14 à 18 lumières qui bougent par nuée (portée 2 studs, invisibles en vol)
		-- coûtaient plus que toutes les lampes de la carte en éclairage Future
		table.insert(bats, b)
	end
	flocks[anchor] = { anchor = anchor, bats = bats, folder = folder }
end
local function removeFlock(anchor: Instance)
	local f = flocks[anchor]
	if f then f.folder:Destroy(); flocks[anchor] = nil end
end
CollectionService:GetInstanceAddedSignal("HwBats"):Connect(addFlock)
CollectionService:GetInstanceRemovedSignal("HwBats"):Connect(removeFlock)
for _, a in ipairs(CollectionService:GetTagged("HwBats")) do addFlock(a) end

local flicker: { [Instance]: { l: PointLight, base: number, ph: number } } = {}
local function addLight(l: Instance)
	if l:IsA("PointLight") then flicker[l] = { l = l, base = l.Brightness, ph = math.random() * 6 } end
end
CollectionService:GetInstanceAddedSignal("HwFlicker"):Connect(addLight)
CollectionService:GetInstanceRemovedSignal("HwFlicker"):Connect(function(l: Instance) flicker[l] = nil end)
for _, l in ipairs(CollectionService:GetTagged("HwFlicker")) do addLight(l) end

RunService.RenderStepped:Connect(function()
	local t = os.clock()
	local cam = (workspace.CurrentCamera or camera).CFrame.Position
	for anchor, f in pairs(flocks) do
		if not anchor.Parent then removeFlock(anchor)
		else
			local c = f.anchor.Position
			local near = (c - cam).Magnitude < 600
			f.folder.Parent = if near then workspace else nil
			if near then
				for _, b in ipairs(f.bats) do
					local a = b.ph + t * b.sp
					local pos = c + Vector3.new(math.cos(a) * b.r, b.h + math.sin(t * 1.3 + b.ph) * 4, math.sin(a * 1.3) * b.r * 0.8)
					local a2 = a + 0.02
					local ahead = c + Vector3.new(math.cos(a2) * b.r, b.h + math.sin(t * 1.3 + b.ph) * 4, math.sin(a2 * 1.3) * b.r * 0.8)
					local dir = if b.sp > 0 then ahead - pos else pos - ahead
					local cf = CFrame.lookAt(pos, pos + (if dir.Magnitude > 1e-3 then dir else Vector3.new(0, 0, -1)))
					local flap = math.sin(t * b.fl + b.ph) * 0.9
					local half = b.sz * 0.275
					b.body.CFrame = cf
					b.wl.CFrame = cf * CFrame.new(-b.sz * 0.08, 0, 0) * CFrame.Angles(0, 0, flap) * CFrame.new(-half, 0, 0)
					b.wr.CFrame = cf * CFrame.new(b.sz * 0.08, 0, 0) * CFrame.Angles(0, 0, -flap) * CFrame.new(half, 0, 0)
				end
			end
		end
	end
	for l, v in pairs(flicker) do
		if not l.Parent then flicker[l] = nil
		else v.l.Brightness = v.base * (0.82 + 0.18 * math.sin(t * 9 + v.ph) * math.sin(t * 3.7 + v.ph)) end
	end
end)
]]></string>
        </Properties>
      </Item>
      <Item class="LocalScript" referent="804">
        <Properties>
          <string name="Name">HudController</string>
          <string name="Source"><![CDATA[--!strict
-- StarterPlayerScripts/HudController (LocalScript)
-- HUD du match à mort par équipe, avec la présentation du jeu web (index.html #hud, src/80_ui.js, src/8W_degats.js) :
--   haut : score des deux équipes (soldats en vie) et chrono ; dessous, la phase (« PRÉPAREZ-VOUS… »)
--   haut gauche : radar qui tourne avec le regard (carte, coéquipiers, ennemis repérés, objets) + nom du lieu
--   haut droite : fil des éliminations avec l'icône 3D de l'arme
--   bas gauche : ❤ vie et 🛡 bouclier (chiffre + jauge, traînée blanche des dégâts)
--   bas droite : emplacements d'armes et panneau de l'arme (icône, nom, munitions, balles du chargeur)
--   centre : marqueur de touche (blanc, doré à la tête, bleu sur bouclier, rouge + anneau à l'élimination),
--   chiffres de dégâts cumulés au-dessus de la cible, flèches de direction des tirs reçus, voile rouge, recharge
--   + bannière d'élimination et séries, écran de mort et réapparition, tableau des scores (Tab), écran de fin.
-- Fait pour le mode « tdm » (ModeConfig.MODE) : les événements TDMState, KillFeed… sont créés par TDMService.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local StarterGui = game:GetService("StarterGui")
local Debris = game:GetService("Debris")

local Config = require(ReplicatedStorage.Shared.Config)
local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local MapData = require(ReplicatedStorage.Shared.MapData)
local WeaponModels = require(ReplicatedStorage.Shared.WeaponModels)
local SkinPaint = require(ReplicatedStorage.Shared.SkinPaint)
local Sfx = require(ReplicatedStorage.Shared.Sfx)
local S = require(ReplicatedStorage.Shared.ClientState)

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local U = Config.STUDS_PER_METER

local hitRemote = ReplicatedStorage:WaitForChild("HitFeedback") :: RemoteEvent
local damagedRemote = ReplicatedStorage:WaitForChild("Damaged") :: RemoteEvent
local stateRemote = ReplicatedStorage:WaitForChild("TDMState") :: RemoteEvent
local feedRemote = ReplicatedStorage:WaitForChild("KillFeed") :: RemoteEvent
local bannerRemote = ReplicatedStorage:WaitForChild("KillBanner") :: RemoteEvent
local deathRemote = ReplicatedStorage:WaitForChild("DeathInfo") :: RemoteEvent
local endRemote = ReplicatedStorage:WaitForChild("MatchEnd") :: RemoteEvent
local leaveFn = ReplicatedStorage:WaitForChild("MatchLeave") :: RemoteFunction
local tracerRemote = ReplicatedStorage:WaitForChild("Tracer") :: RemoteEvent

-- le tableau Tab remplace la liste des joueurs de Roblox
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.PlayerList, false) end)
pcall(function() StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Backpack, false) end)

-- ---------- palette du web (:root de index.html) ----------
local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local C = {
	bg = rgb(0x090d15), panel = rgb(0x0e131e), panel2 = rgb(0x161e2e), line = rgb(0x2a3750), text = rgb(0xe8eef9), dim = rgb(0x8da0bd),
	accent = rgb(0xff4655), gold = rgb(0xffd75e), good = rgb(0x7dff9f), blue = rgb(0x4aa3ff), orange = rgb(0xff7a4a),
	red = rgb(0xff4655), green = rgb(0x7dff9f),
	Attaquants = rgb(0xff7a4a), ["Défenseurs"] = rgb(0x4aa3ff),
}
local function teamColor(t: string?): Color3 return (t and (C :: any)[t]) or C.text end
local FONT = Enum.Font.GothamBlack
-- titres du web (#banner : Bahnschrift 900, ombre douce) : police étroite et grasse
local TITLE = Font.new("rbxasset://fonts/families/RobotoCondensed.json", Enum.FontWeight.Bold)
local ITALIC = Font.new("rbxasset://fonts/families/GothamSSm.json", Enum.FontWeight.Heavy, Enum.FontStyle.Italic)

-- ---------- petits outils ----------
local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end
local function corner(o: Instance, r: number?) make("UICorner", { CornerRadius = UDim.new(0, r or 3) }, o) end
local function stroke(o: Instance, color: Color3?, th: number?, tr: number?)
	make("UIStroke", { Color = color or Color3.new(0, 0, 0), Thickness = th or 1.5, Transparency = tr or 0.3, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, o)
end
local function label(parent: Instance, props: { [string]: any }): TextLabel
	local base = { BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextColor3 = C.text, TextSize = 16, Text = "" }
	for k, v in pairs(props) do (base :: any)[k] = v end
	return make("TextLabel", base, parent)
end
-- grand titre : ombre floue sous le texte au lieu d'un gros contour noir
local function titleLabel(parent: Instance, props: { [string]: any }): TextLabel
	local l = label(parent, props)
	l.FontFace = TITLE
	l.TextStrokeTransparency = 1
	if props.TextTransparency == nil then l.TextTransparency = 0 end
	-- un UIStroke ne suit PAS TextTransparency : il restait affiché (lettres creuses « fantômes » de la
	-- dernière bannière, superposées aux suivantes) ; on le fait suivre à la main ci-dessous
	local edge = make("UIStroke", { Thickness = 1, Transparency = 0.8, Color = Color3.new(0, 0, 0) }, l)
	-- frère placé dessous (en mode Sibling un enfant passerait par-dessus le texte)
	local sh = l:Clone()
	for _, c in ipairs(sh:GetChildren()) do c:Destroy() end
	sh.Name = (l.Name or "Title") .. "Shadow"; sh.TextColor3 = Color3.new(0, 0, 0); sh.ZIndex = l.ZIndex - 1
	local shScale = make("UIScale", { Scale = 1 }, sh)
	sh.Parent = parent
	local function sync()
		sh.Text = (string.gsub(l.Text, 'color="#%x+"', 'color="#000000"'))
		local tt = l.TextTransparency
		sh.TextTransparency = 0.45 + 0.55 * tt
		edge.Transparency = 0.8 + 0.2 * tt; edge.Enabled = tt < 0.99
		sh.Position = l.Position + UDim2.fromOffset(0, 3); sh.Size = l.Size
		-- texte invisible : on cache aussi le cadre et son ombre (rien ne traîne à l'écran)
		sh.Visible = l.Visible and tt < 0.99
	end
	for _, prop in ipairs({ "Text", "TextTransparency", "Position", "Size", "Visible" }) do
		l:GetPropertyChangedSignal(prop):Connect(sync)
	end
	l.ChildAdded:Connect(function(c)
		if c:IsA("UIScale") then
			shScale.Scale = c.Scale
			c:GetPropertyChangedSignal("Scale"):Connect(function() shScale.Scale = c.Scale end)
		end
	end)
	sync()
	return l
end
local function tween(o: Instance, t: number, props: { [string]: any }, style: Enum.EasingStyle?, dir: Enum.EasingDirection?)
	local tw = TweenService:Create(o, TweenInfo.new(t, style or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props)
	tw:Play()
	return tw
end
-- lettres espacées (letter-spacing du web)
-- majuscules avec les accents (string.upper laisse « é », « î »… en minuscules)
local ACC = { ["é"] = "É", ["è"] = "È", ["ê"] = "Ê", ["à"] = "À", ["â"] = "Â", ["î"] = "Î", ["ï"] = "Ï", ["ô"] = "Ô", ["û"] = "Û", ["ù"] = "Ù", ["ç"] = "Ç" }
local function upper(s: string): string
	return (string.gsub(string.upper(s), "[\195][\128-\191]", function(c: string) return ACC[c] or c end))
end
-- espaces fines (U+200A / U+2009) : un vrai espace entre chaque lettre donnait « M A N C H E »
local GAPS = { "\u{200A}", "\u{2009}", "\u{2009}\u{200A}" }
local function spaced(s: string, n: number?): string
	local gap = GAPS[math.clamp(n or 1, 1, 3)]
	local out = {}
	for _, cp in utf8.codes(s) do table.insert(out, utf8.char(cp)) end
	return table.concat(out, gap)
end
-- fond des panneaux du web : dégradé sombre, plus transparent vers la droite
local function panelBg(o: GuiObject, vertical: boolean?)
	o.BackgroundColor3 = Color3.new(1, 1, 1)
	o.BackgroundTransparency = 0
	make("UIGradient", {
		Color = ColorSequence.new(rgb(0x121826), rgb(0x0e131e)),
		Transparency = if vertical then NumberSequence.new(0.12, 0.18) else NumberSequence.new(0.1, 0.4),
		Rotation = if vertical then 90 else 0,
	}, o)
	corner(o, 3)
end
local function playSound(def: any) Sfx.play(def) end
local function fmtTime(s: number): string return string.format("%d:%02d", s // 60, s % 60) end
local function clamp(x: number, a: number, b: number): number return math.max(a, math.min(b, x)) end

local gui = make("ScreenGui", { Name = "MatchHud", ResetOnSpawn = false, IgnoreGuiInset = true, DisplayOrder = 10, ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))

-- ---------- icône 3D d'une arme (le web dessine aussi ses icônes à partir des modèles) ----------
local function weaponIcon(parent: Instance, key: string, size: Vector2, props: { [string]: any }?, skin: number?, camo: string?): ViewportFrame
	local vf = make("ViewportFrame", { Size = UDim2.fromOffset(size.X, size.Y), BackgroundTransparency = 1, Ambient = Color3.fromRGB(170, 175, 190),
		LightColor = Color3.new(1, 1, 1), LightDirection = Vector3.new(0.4, -1, 0.3) }, parent)
	if props then for k, v in pairs(props) do (vf :: any)[k] = v end end
	task.spawn(function()
		if not Config.WEAPONS[key] then return end
		local ok, m = pcall(WeaponModels.build, key, 1)
		if not ok or not m or not vf.Parent then if ok and m then (m :: Model):Destroy() end return end
		local model = m :: Model
		SkinPaint.apply(model, skin, camo)
		model.Parent = vf
		local cf, ext = model:GetBoundingBox()
		local cam = Instance.new("Camera"); cam.FieldOfView = 16
		local aspect = size.X / size.Y
		local tv = math.tan(math.rad(8))
		local dist = math.max(ext.Y / 2 / tv, ext.Z / 2 / (tv * aspect)) * 1.12 + ext.X
		-- vue de côté, canon à gauche comme les icônes du web
		cam.CFrame = CFrame.lookAt(cf.Position - Vector3.new(dist, 0, 0), cf.Position)
		cam.Parent = vf; vf.CurrentCamera = cam
	end)
	return vf
end
-- partie du joueur (MatchService) : équipe, carte (dossier dans workspace) et son décalage
local function myTeam(): string?
	local t = player:GetAttribute("Team")
	if typeof(t) == "string" then return t end
	return player.Team and player.Team.Name or nil
end
local function myMapFolder(): Instance?
	local n = player:GetAttribute("MatchMap")
	return if typeof(n) == "string" then workspace:FindFirstChild(n) else workspace:FindFirstChild("Map")
end
local function mapOrigin(): Vector3
	local f = myMapFolder()
	local o = f and f:GetAttribute("Origin")
	return if typeof(o) == "Vector3" then o else Vector3.zero
end
local function mySkin(key: string): (number?, string?)
	return player:GetAttribute("Skin_" .. key) :: number?, player:GetAttribute("Camo_" .. key) :: string?
end

