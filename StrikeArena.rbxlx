	grid = {
		type = { {1, 0, 6, 5, 9, 4, 2, 3}, "#########################################$%%%%$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$%%%%$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$$$$$$$$$&$$$$$$$$$$$$$$$$$$$$$$'$$$$$##$$$$$$($$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$##$&$$$$($$$$$#$$$$$$$$$$$$#$$)$$$$$$$$$##$$$(($$$$$$$#$&$)$$$$(($$#$$))$$$$$$$$##$$$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$))$##$$$$$$$))$$$#$$$$$$$$$$$$#$$$$&$(($$)$##$&&$$$$$$$$$########$$####$&$$$$$$$$$&##$$$$$$$$$$$$########$$####$$$$$$$$$$$$###$$$$###$$###%%%$$$$$$$$$###$$#$$$$######$$$$###$$###%%%$$$$$$$$$###$$#$$$$#####$$$$$$**$$***%%%$$$$$$$$$%%%$$**$$$$$$##)$$$$$**$$***$$)$$$$$$$$$%%%$$**$)$$$$##$$$$$$**&$***$$$$$$$$$$$$%%%$$**$$$(($##$$(($$**$$***$$$$****$$$$***$)**$$$$$$##$$$$($**$$$$$$$$$****$$($***$$**$$$$$$##$$$$$$**$$$$$$($$****$$($***$$**$$$$$$##$)$$$$**$$***$($$****$$$$***$$$$$$$$$$##$)$$$$$$$$***$$$$****$$$$***$$$$$$'$$$##$$$$$$$$$$***$$$$$$$$$$$$***$$**$$$$$$##$$$$&$**$(***$$$$$$$$$(($$$$$$**$$$($$##$$$$$$%%$$***$$$$$$$$$$$$$$$$$**$$$$$$##$&$$$$%%$$***$))$$$$$$$$$***$$**$$$$$$##$$$$$$%%$$***$$$$$$$$$$$&***$$**$$$$$$##$$(($$%%$)***&$$&$$$$))$$***&$**))$$$$##$$$$$$**$$***$$$$$$$$$$$$***$$**$$$$$&##$$$$$$*******$$$$$$$$$$$$***$$**$$$$$$###$$$$#############$$########$$##$$$$#####$$$$#############$$########$$##$$$$####$&$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$$$$$$$$)$$$#$$$$$$$$$$$$#$&$$$$$$&$$$##$$$$$$$$)$$$#$$$$)$$)$$$$#$$$$$$$$$$$$##$$))$$$$$$$$#$$$$)$$)$$$$#$$))$$$$$$$$##$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$)$##$$$$$&$$$(($$$&$$$$$$$$$$$$$$$$(($$$)$##$$$$$$$$$$$$#$$$$$$$$$(($#$$$$$$$$$$$$##$$$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$#########################################" },
		h = { {6, 0, 2.4, 1.2, 1.1, 3.4, 0.9, 2.6, 3, 1.5, 4.6}, "#########################################$%%%%&&&$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$%%%%&&&$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$$$$$$$$$'$$$$$$$$$$$$$$$$$$$$$$($$$$$##$$$$$$)$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$##$'$$$$)$$$$$#$$$$$$$$$$$$#$$*$$$$$$$$$##$$$))$$$$$$$#$'$*$$$$))$$#$$**$$$$$$$$##$$$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$**$##$$$$$$$**$$$#$$$$$$$$$$$$#$$$$'$))$$*$##$''$$$$$$$$$########$$####$'$$$$$$$$$'##$$$$$$$$$$$$########$$####$$$$$$$$$$$$###$$$$###$$###+++,,,$$$$$$###$$#$$$$######$$$$###$$###+++,,,$$$$$$###$$#$$$$#####$$$$$$--$$---+++$$$$$$,,,+++$$--$$$$$$##*$$$$$--$$---$$*$$$$$$,,,+++$$--$*$$$$##$$$$$$--'$---$$$$$$$$$$$$+++$$--$$$))$##$$))$$--$$---$$$$----$$$$---$*--$$$$$$##$$$$)$--$$$$$$$$$----$$)$---$$--$$$$$$##$$$$$$--$$$$$$)$$----$$)$---$$--$$$$$$##$*$$$$--$$---$)$$----$$$$---$$$$$$$$$$##$*$$$$$$$$---$$$$----$$$$---$$$$$$($$$##$$$$$$$$$$---$$$$$$$$$$$$---$$--$$$$$$##$$$$'$--$)---$$$$$$$$$))$$$$$$--$$$)$$##$$$$$$%%$$---$$$$$$$$$$$$$$$$$--$$$$$$##$'$$&&%%$$---$**$$$$$$$$$---$$--$$$$$$##$$$$&&%%$$---$$$$$$$$$$$'---$$--$$$$$$##$$))$$%%$*---'$$'$$$$**$$---'$--**$$$$##$$$$$$--$$---$$$$$$$$$$$$---$$--$$$$$'##$$$$$$-------$$$$$$$$$$$$---$$--$$$$$$###$$$$#############$$########$$##$$$$#####$$$$#############$$########$$##$$$$####$'$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$##$$$$$$$$*$$$#$$$$$$$$$$$$#$'$$$$$$'$$$##$$$$$$$$*$$$#$$$$*$$*$$$$#$$$$$$$$$$$$##$$**$$$$$$$$#$$$$*$$*$$$$#$$**$$$$$$$$##$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$$*$##$$$$$'$$$))$$$'$$$$$$$$$$$$$$$$))$$$*$##$$$$$$$$$$$$#$$$$$$$$$))$#$$$$$$$$$$$$##$$$$$$$$$$$$#$$$$$$$$$$$$#$$$$$$$$$$$$#########################################" },
