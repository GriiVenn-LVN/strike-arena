-- Grille d'une carte : tableaux indexés de 0 à N*N-1 (comme G_TYPE, G_H, G_CEIL, G_RAMP, G_TAG du web) + rampes
local cache: { [string]: any } = {}
function MapData.buildGrid(id: string): any
	if cache[id] then return cache[id] end
	local m = MapData[id]
	local g: any = { ramps = m.ramps, map = m }
	for k, enc in pairs(m.grid) do
		local pal, s = enc[1], enc[2]
		local t = table.create(N * N)
		for i = 1, #s do t[i - 1] = pal[string.byte(s, i) - 34] end
		g[k] = t
	end
	cache[id] = g
	return g
end

return MapData
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="23">
        <Properties>
          <string name="Name">MapDress</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MapDress (ModuleScript, client + Studio)
-- Habillage d'une carte comme sur le web (utilisé par StarterPlayerScripts/MapDetailController, et par
-- ServerStorage/MeshUploader pour envoyer une fois sur Roblox les maillages et textures, voir MeshStore) :
--   • textures canvas du web posées sur les blocs du décor, sauf celles remplacées par un matériau PBR haute définition
--     de Roblox (MapScene.hdMaterial : enduit, briques, bois, béton, tôle… posé par le serveur) ; dessin du sol (sites,
--     zones) en calque translucide sur le matériau du sol, ombres cuites du web éclaircies ;
--   • tous les maillages non primitifs du web regroupés par matériau (peu de pièces), construits petit à petit ;
--   • halos lumineux des lampes, images du ciel.
local AssetService = game:GetService("AssetService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapScene = require(ReplicatedStorage.Shared.MapScene)
local MeshStore = require(ReplicatedStorage.Shared.MeshStore)

local MapDress = {}
local U = Config.STUDS_PER_METER
local api = { mesh = true, image = true }
MapDress.api = api
local MAXV, MAXT = 30000, 18000          -- par maillage (limites Roblox : 60 000 sommets, 20 000 triangles)

export type Build = { folder: Instance, id: string, origin: Vector3, details: Folder?, alive: boolean, meshes: { EditableMesh }, images: { EditableImage } }

-- ---------- images ----------
-- clé stable (MeshStore) : l'image envoyée est utilisée si elle existe, sinon une EditableImage
local function newImage(key: string, w: number, h: number, make: () -> buffer, b: Build?): Content?
	local ok, res, img = pcall(function()
		return MeshStore.image("m:" .. key, function(): EditableImage?
			if not api.image then return nil end
			local e = AssetService:CreateEditableImage({ Size = Vector2.new(w, h) })
			e:WritePixelsBuffer(Vector2.zero, Vector2.new(w, h), make())
			return e
		end)
	end)
	if ok then
		if img and b then table.insert(b.images, img) end
		return res
	end
	api.image = false
	warn("[MapDetail] EditableImage indisponible : coche Game Settings → Security → « Allow Mesh / Image APIs ». Cartes en couleurs unies en attendant.")
	return nil
end

-- version haute définition (ServerStorage/MapTexturesHQ, clés « t2: » / « tt2: ») : prise quand elle est déjà envoyée sur
-- Roblox (le joueur n'a pas ses pixels, seulement le numéro d'asset), ou pendant l'envoi depuis Studio (MeshUploader) ;
-- sinon la texture réduite d'avant (clés « t: » / « tt: », repli)
local function wantHD(tid: string, key: string): boolean
	if MeshStore.uploader then return MapScene.hasHD(tid) end
	return MeshStore.ids["i:m:" .. key] ~= nil
end

-- image déjà envoyée : MeshStore.image renvoie son asset sans appeler fill (pas de pixels à lire)
local function sentImage(key: string): Content?
	local res = MeshStore.image("m:" .. key, function(): EditableImage? return nil end)
	return res
end

local baseImg: { [string]: Content | false } = {}      -- textures du web (gardées pour toutes les cartes)
local upImg: { [string]: Content | false } = {}        -- les mêmes pendant l'envoi (sans reprendre une image du jeu)
local function texImage(tid: string): Content?
	local cache = if MeshStore.uploader then upImg else baseImg
	local c = cache[tid]
	if c ~= nil then return if c then c :: any else nil end
	local img: Content? = nil
	if wantHD(tid, "t2:" .. tid) then
		if MeshStore.uploader then
			local t = MapScene.textureHD(tid)
			img = t and newImage("t2:" .. tid, t.w, t.h, function() return t.rgba end)
		else
			img = sentImage("t2:" .. tid)
		end
	end
	if not img then
		local t = MapScene.texture(tid)
		img = t and newImage("t:" .. tid, t.w, t.h, function() return t.rgba end)
	end
	cache[tid] = img or false
	return img
end

local function tintKey(c: Color3): string return string.format("%02x%02x%02x", math.floor(c.R * 255 + 0.5), math.floor(c.G * 255 + 0.5), math.floor(c.B * 255 + 0.5)) end

-- texture teintée (MeshPart.TextureContent ne se teinte pas : on multiplie les pixels), propre à une carte
local function tintedImage(b: Build, cache: { [string]: Content | false }, tid: string, tint: Color3): Content?
	if tint.R > 0.98 and tint.G > 0.98 and tint.B > 0.98 then return texImage(tid) end
	local key = tid .. "|" .. tintKey(tint)
	local c = cache[key]
	if c ~= nil then return if c then c :: any else nil end
	local hd = wantHD(tid, "tt2:" .. key)
	if hd and not MeshStore.uploader then
		local sent = sentImage("tt2:" .. key)
		if sent then cache[key] = sent; return sent end
		hd = false
	end
	local t = if hd then MapScene.textureHD(tid) else MapScene.texture(tid)
	local img: Content? = nil
	if t then
		img = newImage((if hd then "tt2:" else "tt:") .. key, t.w, t.h, function()
			local n = t.w * t.h
			local out = buffer.create(n * 4)
			local r, g, bb = tint.R, tint.G, tint.B
			for i = 0, n - 1 do
				local o = i * 4
				buffer.writeu8(out, o, buffer.readu8(t.rgba, o) * r)
				buffer.writeu8(out, o + 1, buffer.readu8(t.rgba, o + 1) * g)
				buffer.writeu8(out, o + 2, buffer.readu8(t.rgba, o + 2) * bb)
				buffer.writeu8(out, o + 3, buffer.readu8(t.rgba, o + 3))
			end
			return out
		end, b)
	end
	cache[key] = img or false
	return img
end

-- détail fin du sol : gris centré sur 128 multiplié ×2 sur le web -> calque noir / blanc semi-transparent
local detailImg: { [string]: Content | false } = {}
local function detailImage(tid: string, str: number): Content?
	local key = tid .. "|" .. str
	local c = detailImg[key]
	if c ~= nil then return if c then c :: any else nil end
	local t = MapScene.texture(tid)
	local img: Content? = nil
	if t then
		img = newImage("d:" .. key, t.w, t.h, function()
			local n = t.w * t.h
			local out = buffer.create(n * 4)
			for i = 0, n - 1 do
				local m = 1 + str * (buffer.readu8(t.rgba, i * 4) * 2 / 255 - 1)
				local v, a = if m < 1 then 0 else 255, math.clamp(math.abs(m - 1), 0, 1)
				buffer.writeu8(out, i * 4, v); buffer.writeu8(out, i * 4 + 1, v); buffer.writeu8(out, i * 4 + 2, v); buffer.writeu8(out, i * 4 + 3, a * 255)
			end
			return out
		end)
	end
	detailImg[key] = img or false
	return img
end

local whiteImg: Content? = nil
local function white(): Content?
	if whiteImg then return whiteImg end
	whiteImg = newImage("white", 4, 4, function() local buf = buffer.create(4 * 4 * 4); buffer.fill(buf, 0, 255); return buf end)
	return whiteImg
end

local glowImg: Content? = nil
local function glow(): Content?      -- même dégradé que glowTex() du web
	if glowImg then return glowImg end
	local S = 64
	glowImg = newImage("glow", S, S, function()
		local buf = buffer.create(S * S * 4)
		for y = 0, S - 1 do for x = 0, S - 1 do
			local d = math.min(1, math.sqrt((x + 0.5 - S / 2) ^ 2 + (y + 0.5 - S / 2) ^ 2) / (S / 2))
			local a = if d < 0.2 then 1 - d / 0.2 * 0.3 elseif d < 0.5 then 0.7 - (d - 0.2) / 0.3 * 0.52 else 0.18 * (1 - (d - 0.5) / 0.5)
			local o = (y * S + x) * 4
			buffer.writeu8(buf, o, 255); buffer.writeu8(buf, o + 1, 255); buffer.writeu8(buf, o + 2, 255); buffer.writeu8(buf, o + 3, math.clamp(a, 0, 1) * 255)
		end end
		return buf
	end)
	return glowImg
end

-- déjà envoyées (MeshStore) : réutilisées par MapAmbience (particules, halo de la lune, feuilles qui tombent)
MapDress.glow = glow
MapDress.texture = texImage

-- ---------- décalcomanies d'usure (MapExtras) : images dessinées ici, envoyées une fois (clés « m:fx:<nom> ») ----------
-- taches, coulures d'eau sous les toits, fissures, crasse au pied des murs, deux graffitis abstraits (sans texte).
-- Dessin déterministe (graine fixe) : la même image à chaque partie, envoyée telle quelle par MeshUploader. Usure en gris
-- clair (teinte donnée par Decal.Color3 selon la carte), graffitis en couleurs.
local function fbm(seed: number, P: number): (number, number) -> number
	-- bruit de valeur répété (période P cases) sur 4 octaves, de 0 à 1
	local rng = Random.new(seed)
	local grid = table.create(P * P)
	for i = 1, P * P do grid[i] = rng:NextNumber() end
	local function at(x: number, y: number): number return grid[(y % P) * P + (x % P) + 1] end
	local function vn(u: number, v: number, f: number): number
		local x, y = u * f, v * f
		local x0, y0 = math.floor(x), math.floor(y)
		local tx, ty = x - x0, y - y0
		tx = tx * tx * (3 - 2 * tx); ty = ty * ty * (3 - 2 * ty)
		local a = at(x0, y0) + (at(x0 + 1, y0) - at(x0, y0)) * tx
		local b = at(x0, y0 + 1) + (at(x0 + 1, y0 + 1) - at(x0, y0 + 1)) * tx
		return a + (b - a) * ty
	end
	return function(u: number, v: number): number
		return vn(u, v, 4) * 0.5 + vn(u, v, 8) * 0.25 + vn(u, v, 16) * 0.15 + vn(u, v, 32) * 0.1
	end
end

-- distance d'un point à une polyligne (liste de { x, y }) en pixels
local function polyDist(pts: { { number } }, x: number, y: number): number
	local best = math.huge
	for i = 1, #pts - 1 do
		local a, b = pts[i], pts[i + 1]
		local dx, dy = b[1] - a[1], b[2] - a[2]
		local t = math.clamp(((x - a[1]) * dx + (y - a[2]) * dy) / math.max(1e-6, dx * dx + dy * dy), 0, 1)
		local ex, ey = a[1] + dx * t - x, a[2] + dy * t - y
		local d = ex * ex + ey * ey
		if d < best then best = d end
	end
	return math.sqrt(best)
end

type Painter = (u: number, v: number, x: number, y: number) -> (number, number, number, number)
local DECALS: { [string]: { w: number, h: number, make: () -> Painter } } = {
	-- tache sombre aux bords déchiquetés (huile, eau, terre)
	tache = { w = 128, h = 128, make = function(): Painter
		local n = fbm(101, 32)
		return function(u, v)
			local r = math.sqrt((u - 0.5) ^ 2 + (v - 0.5) ^ 2) * 2
			local a = math.clamp((1 - r * 1.1) * 1.6 + (n(u, v) - 0.5) * 1.4, 0, 1) ^ 1.3
			local k = 0.8 + n(v, u) * 0.4
			return 240 * k, 240 * k, 240 * k, a * 0.85
		end
	end },
	-- coulures d'eau sous le haut d'un mur (haut de l'image = haut du mur)
	coulure = { w = 128, h = 256, make = function(): Painter
		local n = fbm(202, 32)
		local cols = table.create(128)
		local rng = Random.new(203)
		for i = 1, 128 do cols[i] = 0 end
		for _ = 1, 9 do                                     -- traînées de largeurs et longueurs différentes
			local c, w, len = rng:NextNumber(0.08, 0.92), rng:NextNumber(0.02, 0.07), rng:NextNumber(0.35, 1)
			for i = 1, 128 do
				local d = math.abs((i - 0.5) / 128 - c) / w
				if d < 1 then cols[i] = math.max(cols[i], (1 - d * d) * len) end
			end
		end
		return function(u, v, x)
			local len = cols[math.clamp(x + 1, 1, 128)]
			local fade = math.clamp(1 - v / math.max(0.05, len), 0, 1)
			local a = fade ^ 1.6 * (0.55 + n(u * 0.5, v) * 0.6) + math.clamp(1 - v * 9, 0, 1) * 0.35
			return 235, 235, 235, math.clamp(a, 0, 1) * 0.7
		end
	end },
	-- fissures fines qui partent d'un point (marches aléatoires ramifiées)
	fissure = { w = 128, h = 128, make = function(): Painter
		local rng = Random.new(304)
		local lines: { { { number } } } = {}
		local function walk(x: number, y: number, ang: number, steps: number, depth: number)
			local pts = { { x, y } }
			for _ = 1, steps do
				ang += rng:NextNumber(-0.6, 0.6)
				x += math.cos(ang) * 5; y += math.sin(ang) * 5
				table.insert(pts, { x, y })
				if depth < 2 and rng:NextNumber() < 0.12 then walk(x, y, ang + rng:NextNumber(-1.2, 1.2), steps // 2, depth + 1) end
			end
			table.insert(lines, pts)
		end
		for k = 0, 2 do walk(64, 64, k * 2.1 + rng:NextNumber(-0.4, 0.4), 11, 0) end
		return function(_u, _v, x, y)
			local d = math.huge
			for _, l in ipairs(lines) do d = math.min(d, polyDist(l, x + 0.5, y + 0.5)) end
			local a = math.clamp(1.3 - d * 0.75, 0, 1)
			return 255, 255, 255, a * 0.85
		end
	end },
	-- crasse et éclaboussures au pied des murs (bas de l'image = sol)
	suie = { w = 128, h = 64, make = function(): Painter
		local n = fbm(405, 32)
		return function(u, v)
			local a = v ^ 2.2 * (0.45 + n(u, v * 0.5) * 0.8)
			local side = math.clamp(math.min(u, 1 - u) * 6, 0, 1)    -- bords fondus
			return 240, 240, 240, math.clamp(a * side, 0, 1) * 0.8
		end
	end },
	-- graffitis abstraits (trait épais cerné, coulures de peinture), usés par le bruit
	graffiti1 = { w = 256, h = 128, make = function(): Painter
		local n = fbm(506, 32)
		local pts = {}
		for i = 0, 48 do local t = i / 48; table.insert(pts, { 20 + t * 216, 64 + math.sin(t * math.pi * 3 + 0.6) * 26 - t * 8 }) end
		return function(u, v, x, y)
			local d = polyDist(pts, x + 0.5, y + 0.5)
			local wear = 0.65 + n(u, v) * 0.5
			if d < 9 then return 168, 46, 40, math.clamp(wear, 0, 1) end
			if d < 13 then return 26, 22, 22, math.clamp(wear, 0, 1) end
			-- coulures sous le trait
			local drip = (x % 37 < 3) and y > 64 and y < 64 + 40 * n(u, 0.3) and d < 40
			if drip then return 150, 40, 36, 0.7 * wear end
			return 0, 0, 0, 0
		end
	end },
	graffiti2 = { w = 256, h = 128, make = function(): Painter
		local n = fbm(607, 32)
		local loops = {}
		for i = 0, 64 do
			local t = i / 64
			table.insert(loops, { 28 + t * 200 + math.cos(t * math.pi * 8) * 14, 66 + math.sin(t * math.pi * 8) * 30 })
		end
		return function(u, v, x, y)
			local d = polyDist(loops, x + 0.5, y + 0.5)
			local wear = 0.6 + n(u, v) * 0.55
			if d < 6 then return 44, 92, 164, math.clamp(wear, 0, 1) end
			if d < 10 then return 232, 230, 220, math.clamp(wear * 0.95, 0, 1) end
			return 0, 0, 0, 0
		end
	end },
}
MapDress.DECALS = { "tache", "coulure", "fissure", "suie", "graffiti1", "graffiti2" }

local decalImg: { [string]: Content | false } = {}
local decalUp: { [string]: Content | false } = {}
function MapDress.decal(name: string): Content?
	local cache = if MeshStore.uploader then decalUp else decalImg
	local c = cache[name]
	if c ~= nil then return if c then c :: any else nil end
	-- chez le joueur, seulement une fois envoyée : une EditableImage affichée donne le damier rose et cyan de Roblox
	local d = if MeshStore.uploader or MeshStore.ids["i:m:fx:" .. name] ~= nil then DECALS[name] else nil
	local img: Content? = nil
	if d then
		img = newImage("fx:" .. name, d.w, d.h, function()
			local paint = d.make()
			local buf = buffer.create(d.w * d.h * 4)
			for y = 0, d.h - 1 do
				for x = 0, d.w - 1 do
					local r, g, b, a = paint((x + 0.5) / d.w, (y + 0.5) / d.h, x, y)
					local o = (y * d.w + x) * 4
					buffer.writeu8(buf, o, math.clamp(r, 0, 255)); buffer.writeu8(buf, o + 1, math.clamp(g, 0, 255))
					buffer.writeu8(buf, o + 2, math.clamp(b, 0, 255)); buffer.writeu8(buf, o + 3, math.clamp(a, 0, 1) * 255)
				end
				if y % 16 == 15 then task.wait() end
			end
			return buf
		end)
	end
	cache[name] = img or false
	return img
end

local function mulC(a: Color3, b: Color3): Color3 return Color3.new(a.R * b.R, a.G * b.G, a.B * b.B) end
local function cdiff(a: Color3, b: Color3): number return math.abs(a.R - b.R) + math.abs(a.G - b.G) + math.abs(a.B - b.B) end

-- ---------- textures du web sur les blocs du serveur ----------
local FACES = { Enum.NormalId.Right, Enum.NormalId.Left, Enum.NormalId.Top, Enum.NormalId.Bottom, Enum.NormalId.Back, Enum.NormalId.Front }

local function faceDims(k: number, s: Vector3): (number, number)
	if k <= 2 then return s.Z, s.Y elseif k <= 4 then return s.X, s.Z end
	return s.X, s.Y
end

-- dessin du sol du web (512 px pour 80 m : sites, zones, marquages) : translucide, le grain du matériau du sol se voit dessous
local GROUND_DRAWING = 0.4

local function addTexture(p: BasePart, face: Enum.NormalId, img: Content, color: Color3, su: number, sv: number, transp: number?): Texture
	local t = Instance.new("Texture")
	t.Face = face; t.TextureContent = img; t.Color3 = color
	t.StudsPerTileU = math.max(su, 0.01); t.StudsPerTileV = math.max(sv, 0.01)
	if transp then t.Transparency = transp end
	t.Parent = p
	return t
end

function MapDress.dressPrims(b: Build, info: any)
	local vis = b.folder:FindFirstChild("Visuals")
	if not vis then return end
	local prims = MapScene.prims(b.id)
	local mats = info.mats
	local n = 0
	for _, p in ipairs(vis:GetChildren()) do
		if not b.alive then return end
		local idx = p:GetAttribute("P")
		local pr = typeof(idx) == "number" and prims[idx] or nil
		if pr and pr.kind == 0 and p:IsA("BasePart") then
			local inst = pr.color or Color3.new(1, 1, 1)
			local main = MapScene.faceMain(pr)
			-- couleur du bloc posée par le serveur, sans sa petite variation (MapScene.vary)
			local base = if main > 0 then mulC(MapScene.color(mats[main].avg), inst) else p.Color
			for k = 1, 6 do
				local mi = pr.mats[k]
				local plane = bit32.band(pr.flags, 1) ~= 0
				if mi > 0 and (k ~= 4 or plane) then
					local m = mats[mi]
					local fw, fh = faceDims(k, pr.size)
					local tw, th = faceDims(k, pr.tile)
					local hd = MapScene.hdMaterial(m)
					local col = mulC(MapScene.color(m.avg), inst)
					if hd and hd == p.Material then
						-- motif rendu par le matériau PBR du bloc : rien à poser, sauf une face d'une autre couleur
						if cdiff(col, base) > 0.05 then
							local w = white()
							if w then addTexture(p, FACES[k], w, col, fw * U, fh * U) end
						end
					elseif m.tex then                            -- dessin du web (ou face d'un autre matériau que le bloc)
						local img = texImage(m.tex)
						if img then
							local rep = m.rep or { 1, 1 }
							local tr: number? = if m.cut then (m.a or 0) else nil
							if MapScene.isBakedShadow(m) then tr = 1 - (1 - (m.a or 0)) * 0.55
							elseif m.det and p.Material ~= Enum.Material.SmoothPlastic then tr = GROUND_DRAWING end
							addTexture(p, FACES[k], img, mulC(MapScene.color(m.c), inst), tw * U / rep[1], th * U / rep[2], tr)
						end
					else
						if cdiff(col, base) > 0.05 then         -- dessus d'un mur, corniche… d'une autre couleur que les côtés
							local w = white()
							if w then addTexture(p, FACES[k], w, col, fw * U, fh * U) end
						end
					end
					-- grain du sol répété tous les 3 m : seulement si le sol n'a pas reçu de matériau Roblox à relief
					if m.det and p.Material == Enum.Material.SmoothPlastic then
						local d = detailImage(m.det.tex, m.det.str)
						if d then addTexture(p, FACES[k], d, Color3.new(1, 1, 1), m.det.rep * U, m.det.rep * U) end
					end
				end
			end
			n += 1
			if n % 150 == 0 then task.wait() end
		end
	end
end


-- ---------- maillages du web ----------
type Geo = { nv: number, ni: number, flags: number, groups: { { number } }, lo: Vector3, ext: Vector3, pos: number, nrm: number, uv: number, col: number, idx: number, i32: boolean }

local function readGeos(buf: buffer): ({ Geo }, number, number)
	local ng, ninst = buffer.readu32(buf, 0), buffer.readu32(buf, 4)
	local o = 8
	local geos: { Geo } = table.create(ng)
	for gi = 1, ng do
		local nv, ni, fl, ngr = buffer.readu32(buf, o), buffer.readu32(buf, o + 4), buffer.readu8(buf, o + 8), buffer.readu8(buf, o + 9)
		local f = function(k: number) return buffer.readf32(buf, o + 10 + k * 4) end
		local lo, hi = Vector3.new(f(0), f(1), f(2)), Vector3.new(f(3), f(4), f(5))
		o += 34
		local groups = table.create(ngr)
		for _ = 1, ngr do
			table.insert(groups, { buffer.readu32(buf, o), buffer.readu32(buf, o + 4), buffer.readu8(buf, o + 8) })
			o += 9
		end
		local g: Geo = { nv = nv, ni = ni, flags = fl, groups = groups, lo = lo, ext = hi - lo, pos = o, nrm = 0, uv = 0, col = 0, idx = 0, i32 = nv > 65535 }
		o += nv * 6
		if bit32.band(fl, 1) ~= 0 then g.nrm = o; o += nv * 3 end
		if bit32.band(fl, 2) ~= 0 then g.uv = o; o += nv * 4 end
		if bit32.band(fl, 4) ~= 0 then g.col = o; o += nv * 3 end
		g.idx = o; o += ni * (if g.i32 then 4 else 2)
		geos[gi] = g
	end
	return geos, ninst, o
end

-- un morceau de maillage en cours de remplissage
type Chunk = { P: { Vector3 }, N: { Vector3 }, UV: { Vector2 }, C: { Color3 }, T: { number }, hasN: boolean, hasUV: boolean, hasC: boolean }
local function newChunk(): Chunk return { P = {}, N = {}, UV = {}, C = {}, T = {}, hasN = false, hasUV = false, hasC = false } end


type Look = { color: Color3, img: Content?, shadow: boolean, mat: Enum.Material, cut: boolean }
local function flush(b: Build, ch: Chunk, m: any, look: Look, key: string)
	if #ch.T == 0 or not b.alive then return end
	local lo, hi = Vector3.new(math.huge, math.huge, math.huge), Vector3.new(-math.huge, -math.huge, -math.huge)
	for _, p in ipairs(ch.P) do lo = lo:Min(p); hi = hi:Max(p) end
	local center = (lo + hi) / 2
	local ok, err = pcall(function()
		local mp, em = MeshStore.meshPart(key, function()
			local em = AssetService:CreateEditableMesh({ FixedSize = false })
			if not em then error("mémoire des maillages pleine") end
			local vid = table.create(#ch.P)
			for i, p in ipairs(ch.P) do vid[i] = em:AddVertex(p - center); if i % 10000 == 0 then task.wait() end end
			local nid, uid, cid = {}, {}, {}
			if ch.hasN then for i, nn in ipairs(ch.N) do nid[i] = em:AddNormal(nn) end end
			if ch.hasUV then for i, uv in ipairs(ch.UV) do uid[i] = em:AddUV(uv) end end
			if ch.hasC then for i, c in ipairs(ch.C) do cid[i] = em:AddColor(c, 1) end end
			local T = ch.T
			for t = 1, #T, 3 do
				local a, bb, c = T[t], T[t + 1], T[t + 2]
				local f = em:AddTriangle(vid[a], vid[bb], vid[c])
				if ch.hasN then em:SetFaceNormals(f, { nid[a], nid[bb], nid[c] })
				else
					local nn = (ch.P[bb] - ch.P[a]):Cross(ch.P[c] - ch.P[a])
					if nn.Magnitude > 1e-9 then local k = em:AddNormal(nn.Unit); em:SetFaceNormals(f, { k, k, k }) end
				end
				if ch.hasUV then em:SetFaceUVs(f, { uid[a], uid[bb], uid[c] }) end
				if ch.hasC then em:SetFaceColors(f, { cid[a], cid[bb], cid[c] }) end
				if t % 12000 == 1 and t > 1 then task.wait() end
			end
			return em
		end)
		mp.Name = "Detail"; mp.Anchored = true; mp.CanCollide = false; mp.CanQuery = false; mp.CanTouch = false; mp.Massless = true
		mp.CastShadow = look.shadow; mp.Color = look.color; mp.Material = look.mat
		if m.refl then mp.Reflectance = m.refl end
		if m.a and not look.cut then mp.Transparency = m.a end
		if look.img then
			mp.TextureContent = look.img :: Content
			if look.cut then     -- feuilles, toiles : découpe par la transparence de la texture
				local okCut = pcall(function()
					local sa = Instance.new("SurfaceAppearance")
					sa.AlphaMode = Enum.AlphaMode.Transparency
					sa.ColorMapContent = look.img :: Content
					sa.Parent = mp
				end)
				-- sans découpe, l'herbe et les toiles s'affichaient en carrés noirs : on ne les montre pas
				if not okCut then mp:Destroy(); if em then em:Destroy() end; return end
			end
		elseif look.cut then
			mp:Destroy(); if em then em:Destroy() end; return
		end
		mp.CFrame = CFrame.new(b.origin + center)
		mp.Parent = b.details
		if em then table.insert(b.meshes, em) end
	end)
	if not ok then
		if api.mesh then warn("[MapDetail] EditableMesh indisponible (" .. tostring(err) .. ") : décor détaillé en blocs simples.") end
		api.mesh = false
	end
end

-- repli sans EditableMesh : boîte englobante colorée de chaque objet
local function fallbackPart(b: Build, g: Geo, e: { number }, color: Color3, m: any)
	local x, y, z = Vector3.new(e[1], e[2], e[3]), Vector3.new(e[4], e[5], e[6]), Vector3.new(e[7], e[8], e[9])
	local size = Vector3.new(g.ext.X * x.Magnitude, g.ext.Y * y.Magnitude, g.ext.Z * z.Magnitude) * U
	if size.Magnitude < 0.25 or math.max(size.X, size.Y, size.Z) > 150 then return end
	local c = g.lo + g.ext / 2
	local wc = Vector3.new(e[10], e[11], e[12]) + x * c.X + y * c.Y + z * c.Z
	local p = Instance.new("Part")
	p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Color = color
	p.Material = MapScene.hdMaterial(m) or MapScene.material(m.rm)
	p.Size = Vector3.new(math.max(size.X, 0.05), math.max(size.Y, 0.05), math.max(size.Z, 0.05))
	local ok = pcall(function() p.CFrame = CFrame.fromMatrix(b.origin + wc * U, x.Unit, y.Unit, z.Unit) end)
	if not ok then p.CFrame = CFrame.new(b.origin + wc * U) end
	p.Parent = b.details
end

function MapDress.buildMeshes(b: Build, info: any)
	local buf = MapScene.meshBlob(b.id)
	if not buf then return end
	local geos, ninst, o = readGeos(buf)
	local mats, matlists = info.mats, info.matlists
	-- répartition des triangles par (matériau, couleur d'instance)
	type Entry = { e: { number }, g: Geo, start: number, count: number, flip: boolean, inst: Color3 }
	local buckets: { [string]: { mat: number, inst: Color3, list: { Entry }, shadow: boolean } } = {}
	local order: { string } = {}
	for i = 0, ninst - 1 do
		local r = o + i * 56
		local g = geos[buffer.readu16(buf, r) + 1]
		local ml = matlists[buffer.readu16(buf, r + 2) + 1]
		local fl = buffer.readu8(buf, r + 7)
		local inst = if bit32.band(fl, 1) ~= 0 then Color3.fromRGB(buffer.readu8(buf, r + 4), buffer.readu8(buf, r + 5), buffer.readu8(buf, r + 6)) else Color3.new(1, 1, 1)
		local e = table.create(12)
		for k = 0, 11 do e[k + 1] = buffer.readf32(buf, r + 8 + k * 4) end
		local det = e[1] * (e[5] * e[9] - e[6] * e[8]) - e[4] * (e[2] * e[9] - e[3] * e[8]) + e[7] * (e[2] * e[6] - e[3] * e[5])
		local groups = if #ml == 1 then { { 0, g.ni, 0 } } else g.groups
		if not api.mesh then
			local m0 = mats[ml[1] + 1]
			if m0 and (not m0.cut or MapScene.hdMaterial(m0)) then fallbackPart(b, g, e, mulC(MapScene.color(m0.avg), inst), m0) end
		else
			for _, gr: { number } in ipairs(groups) do
				local mi = ml[math.min(#ml, gr[3] + 1)]
				if mi and mi >= 0 then
					local key = mi .. "#" .. tintKey(inst)
					local bk = buckets[key]
					if not bk then bk = { mat = mi + 1, inst = inst, list = {}, shadow = false }; buckets[key] = bk; table.insert(order, key) end
					if bit32.band(fl, 2) ~= 0 then bk.shadow = true end
					table.insert(bk.list, { e = e, g = g, start = gr[1], count = gr[2], flip = det < 0, inst = inst })
				end
			end
		end
		if i % 200 == 199 then task.wait() end
	end
	local tinted: { [string]: Content | false } = {}
	local work = 0
	for _, key in ipairs(order) do
		if not b.alive or not api.mesh then break end
		local bk = buckets[key]
		local m = mats[bk.mat]
		local rep, off = m.rep or { 1, 1 }, m.off or { 0, 0 }
		-- texture floue remplacée par un matériau PBR (MapScene.hdMaterial) : couleur moyenne de la texture + matériau Roblox
		-- (les UV restent dans le maillage : mêmes morceaux, mêmes clés MeshStore qu'avant)
		local hd = MapScene.hdMaterial(m)
		local look: Look = { color = mulC(MapScene.color(m.avg), bk.inst), img = nil, shadow = bk.shadow and (hd ~= nil or not m.cut),
			mat = hd or MapScene.material(m.rm), cut = m.cut == true and hd == nil }
		if m.tex and not hd then look.img = tintedImage(b, tinted, m.tex, mulC(MapScene.color(m.c), bk.inst)) end
		if m.vc then look.color = bk.inst end
		-- clé stable de chaque morceau (MeshStore) : carte, matériau + teinte, numéro du morceau
		local nfl = 0
		local function fl(c: Chunk) nfl += 1; flush(b, c, m, look, "m:" .. b.id .. "#" .. key .. "#" .. nfl) end
		local ch = newChunk()
		for _, en in ipairs(bk.list) do
			local g, e = en.g, en.e
			local hasN = g.nrm ~= 0 and not m.fs
			local hasUV = g.uv ~= 0 and m.tex ~= nil
			local hasC = g.col ~= 0 and m.vc == true
			if #ch.T > 0 and (ch.hasN ~= hasN or ch.hasUV ~= hasUV or ch.hasC ~= hasC) then fl(ch); ch = newChunk() end
			ch.hasN, ch.hasUV, ch.hasC = hasN, hasUV, hasC
			local vmap: { [number]: number } = {}
			local sides = if m.ds then 2 else 1
			for t = en.start, en.start + en.count - 3, 3 do
				if #ch.P > MAXV - 3 or #ch.T / 3 > MAXT - 2 then fl(ch); ch = newChunk(); ch.hasN, ch.hasUV, ch.hasC = hasN, hasUV, hasC; vmap = {} end
				local tri = table.create(3)
				for k = 0, 2 do
					local vi = if g.i32 then buffer.readu32(buf, g.idx + (t + k) * 4) else buffer.readu16(buf, g.idx + (t + k) * 2)
					local id: number = vmap[vi] or 0
					if id == 0 then
						local po = g.pos + vi * 6
						local lx = g.lo.X + buffer.readu16(buf, po) / 65535 * g.ext.X
						local ly = g.lo.Y + buffer.readu16(buf, po + 2) / 65535 * g.ext.Y
						local lz = g.lo.Z + buffer.readu16(buf, po + 4) / 65535 * g.ext.Z
						table.insert(ch.P, Vector3.new(e[1] * lx + e[4] * ly + e[7] * lz + e[10], e[2] * lx + e[5] * ly + e[8] * lz + e[11], e[3] * lx + e[6] * ly + e[9] * lz + e[12]) * U)
						id = #ch.P
						if hasN then
							local no = g.nrm + vi * 3
							local nx, ny, nz = buffer.readi8(buf, no) / 127, buffer.readi8(buf, no + 1) / 127, buffer.readi8(buf, no + 2) / 127
							local wn = Vector3.new(e[1] * nx + e[4] * ny + e[7] * nz, e[2] * nx + e[5] * ny + e[8] * nz, e[3] * nx + e[6] * ny + e[9] * nz)
							ch.N[id] = if wn.Magnitude > 1e-6 then wn.Unit else Vector3.yAxis
						end
						if hasUV then
							local uo = g.uv + vi * 4
							local u = buffer.readi16(buf, uo) / 2048 * rep[1] + off[1]
							local v = buffer.readi16(buf, uo + 2) / 2048 * rep[2] + off[2]
							ch.UV[id] = Vector2.new(u, 1 - v)
						end
						if hasC then
							local co = g.col + vi * 3
							ch.C[id] = mulC(Color3.fromRGB(buffer.readu8(buf, co), buffer.readu8(buf, co + 1), buffer.readu8(buf, co + 2)), en.inst)
						end
						vmap[vi] = id
						work += 1
					end
					tri[k + 1] = id
				end
				local T = ch.T
				if en.flip then tri[2], tri[3] = tri[3], tri[2] end
				table.insert(T, tri[1]); table.insert(T, tri[2]); table.insert(T, tri[3])
				if sides == 2 then   -- matériau double face : on ajoute le revers (normales inversées)
					local ids = table.create(3)
					for k, id in ipairs({ tri[1], tri[3], tri[2] }) do
						table.insert(ch.P, ch.P[id]); local nid = #ch.P
						if hasN then ch.N[nid] = -(ch.N[id] :: Vector3) end
						if hasUV then ch.UV[nid] = ch.UV[id] end
						if hasC then ch.C[nid] = ch.C[id] end
						ids[k] = nid
					end
					table.insert(T, ids[1]); table.insert(T, ids[2]); table.insert(T, ids[3])
				end
				if work > 2500 then work = 0; task.wait() end
			end
		end
		fl(ch)
		task.wait()
	end
	if not api.mesh and b.alive then      -- l'API a été refusée en cours de route : on termine en blocs simples
		for _, c in ipairs((b.details :: Folder):GetChildren()) do if c.Name == "Detail" then c:Destroy() end end
		for i = 0, ninst - 1 do
			local r = o + i * 56
			local g = geos[buffer.readu16(buf, r) + 1]
			local ml = matlists[buffer.readu16(buf, r + 2) + 1]
			local m0 = mats[ml[1] + 1]
			local e = table.create(12)
			for k = 0, 11 do e[k + 1] = buffer.readf32(buf, r + 8 + k * 4) end
			if m0 and (not m0.cut or MapScene.hdMaterial(m0)) then fallbackPart(b, g, e, MapScene.color(m0.avg), m0) end
			if i % 200 == 199 then task.wait() end
		end
	end
end

-- ---------- halos des lampes (sprites additifs du web) ----------
function MapDress.buildGlows(b: Build, info: any)
	local img = glow()
	if not img or #info.glows == 0 then return end
	local anchor = Instance.new("Part")
	anchor.Name = "Halos"; anchor.Anchored = true; anchor.CanCollide = false; anchor.CanQuery = false; anchor.CanTouch = false
	anchor.Transparency = 1; anchor.Size = Vector3.new(0.2, 0.2, 0.2); anchor.CFrame = CFrame.new(b.origin)
	anchor.Parent = b.details
	for _, gl in ipairs(info.glows) do
		local at = Instance.new("Attachment")
		at.Position = Vector3.new(gl.p[1], gl.p[2], gl.p[3]) * U
		at.Parent = anchor
		local bg = Instance.new("BillboardGui")
		local s = gl.s * U
		bg.Size = UDim2.fromScale(s, s); bg.LightInfluence = 0; bg.Brightness = 1.6; bg.MaxDistance = 450; bg.Adornee = at
		local il = Instance.new("ImageLabel")
		il.Size = UDim2.fromScale(1, 1); il.BackgroundTransparency = 1; il.ImageContent = img
		il.ImageColor3 = MapScene.color(gl.c); il.ImageTransparency = 1 - math.clamp(gl.o, 0, 1) * 0.8
		il.Parent = bg
		bg.Parent = at
	end
end

-- ---------- ciel : dégradé du web (th.sky : t = 0 zénith, 0,5 horizon, 1 nadir) ----------
local function hexColor(s: string): Color3
	local n = tonumber(string.sub(s, 2), 16) or 0
	return Color3.fromRGB(bit32.rshift(n, 16), bit32.band(bit32.rshift(n, 8), 255), bit32.band(n, 255))
end
local function skyAt(stops: { any }, t: number): Color3
	local prev = stops[1]
	if t <= prev[1] then return hexColor(prev[2]) end
	for i = 2, #stops do
		local s = stops[i]
		if t <= s[1] then return hexColor(prev[2]):Lerp(hexColor(s[2]), (t - prev[1]) / math.max(1e-6, s[1] - prev[1])) end
		prev = s
	end
	return hexColor(prev[2])
end

local skyCache: { [string]: { side: Content, up: Content, dn: Content } | false } = {}
function MapDress.skyImages(id: string, stops: { any }): { side: Content, up: Content, dn: Content }?
	local c = skyCache[id]
	if c ~= nil then return if c then c :: any else nil end
	local S = 64
	local function face(kind: string): Content?
		return newImage("sky:" .. id .. ":" .. kind, S, S, function()
			local buf = buffer.create(S * S * 4)
			for y = 0, S - 1 do for x = 0, S - 1 do
				local u, v = (x + 0.5) / S * 2 - 1, (y + 0.5) / S * 2 - 1
				local el
				if kind == "side" then el = math.atan2(-v, math.sqrt(u * u + 1))
				elseif kind == "up" then el = math.atan2(1, math.sqrt(u * u + v * v))
				else el = -math.atan2(1, math.sqrt(u * u + v * v)) end
				local col = skyAt(stops, 0.5 - el / math.pi)
				local o = (y * S + x) * 4
				buffer.writeu8(buf, o, col.R * 255); buffer.writeu8(buf, o + 1, col.G * 255); buffer.writeu8(buf, o + 2, col.B * 255); buffer.writeu8(buf, o + 3, 255)
			end end
			return buf
		end)
	end
	local side, up, dn = face("side"), face("up"), face("dn")
	local r: any = if side and up and dn then { side = side, up = up, dn = dn } else false
	skyCache[id] = r
	return if r then r else nil
end

-- envoi depuis Studio : toutes les images de la carte qui ne dépendent pas des blocs construits par le serveur
function MapDress.prebuildImages(id: string)
	local info = MapScene.info(id)
	if not info then return end
	for _, m in ipairs(info.mats) do
		if m.tex then texImage(m.tex) end
		if m.det then detailImage(m.det.tex, m.det.str) end
	end
	white(); glow()
	for _, name in ipairs(MapDress.DECALS) do MapDress.decal(name) end
	if info.theme and info.theme.sky then MapDress.skyImages(id, info.theme.sky) end
end

return MapDress
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="24">
        <Properties>
          <string name="Name">MapExtras</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MapExtras (ModuleScript, client)
-- Détails de rendu ajoutés par le client à la carte où se trouve le joueur, en plus du décor du web, pour un rendu de jeu
-- réaliste (utilisé par StarterPlayerScripts/MapDetailController). Placés d'après la grille de jeu (MapData : cases
-- libres, murs, fûts, plafonds) et le thème de la carte, tirés au sort avec une graine fixe (mêmes places à chaque partie) :
--   • terrain Roblox autour de la carte, à la place du grand sol uni du web : eau animée qui reflète (Port, Labo), herbe
--     (Temple perdu, cartes hantées : herbe en 3D si Terrain.Decoration est coché dans Studio) ;
--   • au sol : flaques qui brillent (nuit, métro, cartes hantées), traînées de saleté au pied des murs, gravats, feuilles
--     mortes, congères (Station), douilles (Stand de tir) ;
--   • décalcomanies d'usure (images de MapDress.decal) : taches au sol, coulures d'eau sous le haut des murs, fissures,
--     crasse au pied des murs, graffitis abstraits sur les grands murs (pas dans le temple ni les cartes hantées) ;
--   • câbles tendus entre les toits, projecteurs muraux et lampes des halos du web qui éclairent vraiment la nuit, fûts en
--     feu (Port, Labo), brume au ras du sol (cartes hantées, Port).
-- Pièces simples, Beam, terrain, textures intégrées au client (rbxasset) et images de MapDress (halo, décalcomanies
-- « m:fx:* », envoyées par MeshUploader ; sinon dessinées en EditableImage, ou absentes si l'API est refusée). Budget : quelques centaines de pièces non collisionnables et ignorées des rayons, une trentaine de lumières
-- au plus, une seule carte habillée à la fois. Qualité basse (ombres coupées dans les réglages) : ni particules, ni ombres.
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local MapScene = require(ReplicatedStorage.Shared.MapScene)
local MapDress = require(ReplicatedStorage.Shared.MapDress)

local MapExtras = {}
local U = Config.STUDS_PER_METER
local S = Config.CELL
local CELL = S * U
local SMOKE = "rbxasset://textures/particles/smoke_main.dds"
local FIRE = "rbxasset://textures/particles/fire_main.dds"

type Build = MapDress.Build

-- réglages par thème du web (nombres = combien en poser au plus)
type Profile = { puddles: number, dirt: number, debris: number, debrisMat: Enum.Material, leaves: number, leafCols: { Color3 },
	drifts: boolean, casings: number, cables: number, lamps: number, lampCol: Color3, glowLights: number, fire: number,
	mist: boolean, grass: Color3?, stains: number, streaks: number, cracks: number, grime: number, graffiti: number, stainCol: Color3? }
local GREEN = { Color3.fromRGB(86, 112, 48), Color3.fromRGB(112, 96, 52), Color3.fromRGB(70, 92, 40), Color3.fromRGB(128, 104, 60) }
local DEAD = { Color3.fromRGB(92, 64, 36), Color3.fromRGB(120, 78, 38), Color3.fromRGB(70, 52, 34), Color3.fromRGB(140, 96, 44) }
local function P(t: { [string]: any }): Profile
	local d: { [string]: any } = { puddles = 0, dirt = 60, debris = 70, debrisMat = Enum.Material.Concrete, leaves = 0, leafCols = GREEN,
		drifts = false, casings = 0, cables = 0, lamps = 0, lampCol = Color3.fromRGB(255, 214, 160), glowLights = 0, fire = 0, mist = false,
		stains = 16, streaks = 12, cracks = 10, grime = 14, graffiti = 3 }
	for k, v in pairs(t) do d[k] = v end
	return d :: any
end
local PROFILES: { [string]: Profile } = {
	sand = P({ dirt = 70, debris = 90, debrisMat = Enum.Material.Sandstone, cables = 6, stains = 14, streaks = 8, cracks = 14, grime = 16, graffiti = 3 }),
	industrial = P({ puddles = 6, dirt = 90, debris = 110, cables = 8, stains = 24, streaks = 16, graffiti = 6, stainCol = Color3.fromRGB(26, 26, 28) }),
	snow = P({ dirt = 0, debris = 40, debrisMat = Enum.Material.Rock, drifts = true, cables = 5, stains = 6, streaks = 10, grime = 6, graffiti = 2 }),
	night = P({ puddles = 18, dirt = 90, debris = 110, cables = 10, lamps = 6, lampCol = Color3.fromRGB(255, 196, 128), glowLights = 16, fire = 2, mist = true,
		stains = 24, streaks = 18, graffiti = 6, stainCol = Color3.fromRGB(24, 24, 26) }),
	metro = P({ puddles = 14, dirt = 100, debris = 120, glowLights = 10, stains = 28, streaks = 16, grime = 24, graffiti = 10, stainCol = Color3.fromRGB(24, 24, 26) }),
	jungle = P({ puddles = 5, dirt = 60, debris = 70, debrisMat = Enum.Material.Rock, leaves = 220, grass = Color3.fromRGB(86, 120, 58),
		stains = 14, streaks = 20, cracks = 12, graffiti = 0, stainCol = Color3.fromRGB(40, 52, 30) }),
	range = P({ dirt = 60, debris = 60, casings = 90, cables = 6, stains = 14, graffiti = 2 }),
	haunt = P({ puddles = 10, dirt = 70, debris = 80, debrisMat = Enum.Material.Slate, leaves = 200, leafCols = DEAD, lamps = 4,
		lampCol = Color3.fromRGB(200, 220, 255), glowLights = 14, mist = true, grass = Color3.fromRGB(52, 64, 40),
		stains = 26, streaks = 22, cracks = 18, grime = 20, graffiti = 0 }),
	halloween = P({ puddles = 8, dirt = 70, debris = 80, debrisMat = Enum.Material.Slate, leaves = 220, leafCols = DEAD, lamps = 4,
		glowLights = 18, mist = true, grass = Color3.fromRGB(56, 62, 38), stains = 22, streaks = 20, cracks = 16, grime = 18, graffiti = 0 }),
}

-- état d'une carte habillée (terrain et éclairage global à remettre en partant)
type Saved = { regions: { { cf: CFrame, size: Vector3 } }, water: { [string]: any }?, grass: Color3?,
	emitters: { ParticleEmitter }, shadows: { Light }, conn: RBXScriptConnection? }
local saved: { [Build]: Saved } = {}

local function low(): boolean return not Lighting.GlobalShadows end

local function hash(s: string): number
	local h = 5381
	for i = 1, #s do h = (h * 33 + string.byte(s, i)) % 2147483647 end
	return h
end

local function part(parent: Instance, name: string, size: Vector3, cf: CFrame, color: Color3, mat: Enum.Material, cls: string?): BasePart
	local p = Instance.new((cls or "Part") :: any) :: BasePart
	p.Name = name; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.Massless = true
	p.CastShadow = false; p.TopSurface = Enum.SurfaceType.Smooth; p.BottomSurface = Enum.SurfaceType.Smooth
	p.Size = size; p.CFrame = cf; p.Color = color; p.Material = mat
	p.Parent = parent
	return p
end

local function darker(c: Color3, k: number): Color3 return Color3.new(c.R * k, c.G * k, c.B * k) end

-- ---------- terrain autour de la carte : eau (grand sol bleu métallique du web) ou herbe ----------
local function terrainRing(b: Build, sv: Saved, prof: Profile)
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if not terrain then return end
	local prims = MapScene.prims(b.id)
	local info = MapScene.info(b.id)
	-- grand sol extérieur du web (plan de 600 m) : le plus grand bloc
	local best, bi = 0, 0
	for i, p in ipairs(prims) do
		local a = p.size.X * p.size.Y + p.size.Y * p.size.Z + p.size.X * p.size.Z
		if p.kind == 0 and a > best then best, bi = a, i end
	end
	if bi == 0 or best < 300 * 300 then return end
	local pr = prims[bi]
	local mi = MapScene.faceMain(pr)
	local m = mi > 0 and info.mats[mi] or nil
	local water = m ~= nil and m.rm == "Metal"
	if not water and not prof.grass then return end
	-- surface du terrain un peu au-dessus du plan du web (gardé dessous : il prolonge le sol au loin, dans la brume)
	local top = pr.pos.Y * U + (if water then 0.5 else 0.4)
	local W = MapData.N * CELL
	local M = 50 * U                                  -- 50 m autour de la carte (bien moins que l'écart entre deux matchs)
	local gap = if water then 0 else 4                 -- l'herbe reste hors du sol de jeu (brins qui dépasseraient)
	local th = 8
	local y = top - th / 2
	local blocks = {
		{ -M / 2 - gap / 2, W / 2, M - gap, W + 2 * M }, { W + M / 2 + gap / 2, W / 2, M - gap, W + 2 * M },
		{ W / 2, -M / 2 - gap / 2, W + 2 * gap, M - gap }, { W / 2, W + M / 2 + gap / 2, W + 2 * gap, M - gap },
	}
	local mat = if water then Enum.Material.Water else Enum.Material.Grass
	if water then
		sv.water = { WaterColor = terrain.WaterColor, WaterTransparency = terrain.WaterTransparency, WaterReflectance = terrain.WaterReflectance,
			WaterWaveSize = terrain.WaterWaveSize, WaterWaveSpeed = terrain.WaterWaveSpeed }
		terrain.WaterColor = Color3.fromRGB(16, 40, 58); terrain.WaterTransparency = 0.25; terrain.WaterReflectance = 1
		terrain.WaterWaveSize = 0.1; terrain.WaterWaveSpeed = 5
	else
		sv.grass = terrain:GetMaterialColor(Enum.Material.Grass)
		terrain:SetMaterialColor(Enum.Material.Grass, prof.grass :: Color3)
	end
	for _, e in ipairs(blocks) do
		local cf = CFrame.new(b.origin + Vector3.new(e[1], y, e[2]))
		local size = Vector3.new(e[3], th, e[4])
		terrain:FillBlock(cf, size, mat)
		table.insert(sv.regions, { cf = cf, size = size + Vector3.new(4, 8, 4) })
	end
end

-- ---------- grille : cases libres au sol, bords de murs, hauts de murs ----------
type Cell = { cx: number, cz: number, dx: number, dz: number, h: number }
local DIRS = { { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }

local function scan(g: any): ({ Cell }, { Cell }, { Cell }, { Cell }, { Cell })
	local N = MapData.N
	local open, outdoor, edges, tops, barrels = {}, {}, {}, {}, {}
	local function solid(x: number, z: number, minH: number): boolean
		if x < 0 or z < 0 or x >= N or z >= N then return false end
		local j = z * N + x
		return g.type[j] ~= 0 and g.ramp[j] == 0 and g.h[j] >= minH
	end
	local function free(x: number, z: number): boolean
		if x < 0 or z < 0 or x >= N or z >= N then return false end
		local j = z * N + x
		return g.type[j] == 0 and g.ramp[j] == 0 and g.h[j] < 0.05
	end
	for z = 0, N - 1 do
		for x = 0, N - 1 do
			local i = z * N + x
			if free(x, z) then
				local c: Cell = { cx = x, cz = z, dx = 0, dz = 0, h = 0 }
				table.insert(open, c)
				if g.ceil[i] >= 90 then table.insert(outdoor, c) end
				for _, d in ipairs(DIRS) do
					if solid(x + d[1], z + d[2], 0.8) then table.insert(edges, { cx = x, cz = z, dx = d[1], dz = d[2], h = 0 }) end
				end
			elseif g.ramp[i] == 0 and g.type[i] == 5 and g.ceil[i] >= 90 then
				table.insert(barrels, { cx = x, cz = z, dx = 0, dz = 0, h = g.h[i] })
			elseif solid(x, z, 3) then
				-- haut d'un mur au bord d'une case libre à ciel ouvert (câbles, projecteurs)
				for _, d in ipairs(DIRS) do
					local nx, nz = x + d[1], z + d[2]
					if free(nx, nz) and g.ceil[nz * N + nx] >= 90 and g.ceil[i] >= 90 then
						table.insert(tops, { cx = x, cz = z, dx = d[1], dz = d[2], h = g.h[i] })
						break
					end
				end
			end
		end
	end
	return open, outdoor, edges, tops, barrels
end

-- ---------- décalcomanies d'usure ----------
-- Chaque décalcomanie est un Decal sur une pièce invisible très fine posée 3 cm devant le mur (ou sur le sol) : les blocs
-- du décor restent intacts. Murs : face de la case libre contre une case pleine (grille du web), hauteur du mur lue
-- dans la grille ; les graffitis seulement sur un mur continu sur trois cases (pas à cheval sur un angle ou une porte).
local function decals(folder: Instance, rng: Random, prof: Profile, g: any, edges: { Cell }, open: { Cell }, floorCol: Color3,
	at: (Cell, number, number, number) -> Vector3)
	local N = MapData.N
	local function wallH(c: Cell): number
		local x, z = c.cx + c.dx, c.cz + c.dz
		if x < 0 or z < 0 or x >= N or z >= N then return 0 end
		local j = z * N + x
		return math.min(g.h[j], g.ceil[c.cz * N + c.cx])
	end
	local function sameWall(c: Cell, k: number): boolean   -- case voisine le long du mur, libre et contre un mur aussi haut
		local px, pz = c.cx + c.dz * k, c.cz + c.dx * k
		if px < 0 or pz < 0 or px >= N or pz >= N then return false end
		local i = pz * N + px
		if g.type[i] ~= 0 or g.ramp[i] ~= 0 or g.h[i] > 0.05 then return false end
		return wallH({ cx = px, cz = pz, dx = c.dx, dz = c.dz, h = 0 }) >= wallH(c) - 0.3
	end
	local function onWall(name: string, c: Cell, w: number, h: number, y: number, along: number, col: Color3, tr: number)
		local img = MapDress.decal(name)
		if not img then return end
		local dir = Vector3.new(c.dx, 0, c.dz)
		local side = Vector3.new(c.dz, 0, c.dx)
		local pos = at(c, c.dx * (CELL / 2 - 0.1), c.dz * (CELL / 2 - 0.1), y * U) + side * along
		local p = part(folder, "Usure", Vector3.new(w * U, h * U, 0.05), CFrame.lookAt(pos, pos - dir), Color3.new(), Enum.Material.SmoothPlastic)
		p.Transparency = 1
		local d = Instance.new("Decal")
		d.Face = Enum.NormalId.Front; d.TextureContent = img; d.Color3 = col; d.Transparency = tr
		d.Parent = p
	end
	local wallCol = darker(floorCol, 0.32)
	-- coulures sous le haut des murs de plus de 2,2 m
	for _ = 1, prof.streaks do
		local c = edges[rng:NextInteger(1, math.max(1, #edges))]
		if not c then break end
		local hw = wallH(c)
		if hw >= 2.2 and hw < 40 then
			local h = math.min(hw - 0.1, rng:NextNumber(1.4, 2.8))
			local w = rng:NextNumber(0.7, 1.5)
			onWall("coulure", c, w, h, hw - 0.05 - h / 2, rng:NextNumber(-0.5, 0.5) * (S - w) * U, prof.stainCol or wallCol, rng:NextNumber(0.15, 0.4))
		end
	end
	-- crasse au pied des murs
	for _ = 1, prof.grime do
		local c = edges[rng:NextInteger(1, math.max(1, #edges))]
		if not c then break end
		if wallH(c) >= 0.8 then
			local h = rng:NextNumber(0.35, 0.7)
			onWall("suie", c, S * rng:NextNumber(0.7, 1), h, h / 2 + 0.01, 0, prof.stainCol or wallCol, rng:NextNumber(0.2, 0.45))
		end
	end
	-- fissures dans les murs
	for _ = 1, prof.cracks do
		local c = edges[rng:NextInteger(1, math.max(1, #edges))]
		if not c then break end
		local hw = wallH(c)
		if hw >= 1.6 then
			local s = rng:NextNumber(0.6, 1.3)
			onWall("fissure", c, s, s, rng:NextNumber(0.6, math.min(hw - s / 2 - 0.1, 2.6)), rng:NextNumber(-0.3, 0.3) * (S - s) * U,
				Color3.fromRGB(26, 23, 20), rng:NextNumber(0.1, 0.35))
		end
	end
	-- graffitis (peinture usée), sur un mur continu d'au moins 3 cases
	local placed, tries = 0, 0
	while placed < prof.graffiti and tries < 300 and #edges > 0 do
		tries += 1
		local c = edges[rng:NextInteger(1, #edges)]
		local hw = wallH(c)
		if hw >= 2.4 and hw < 40 and sameWall(c, 1) and sameWall(c, -1) then
			placed += 1
			local w = rng:NextNumber(1.8, 2.8)
			onWall(if rng:NextNumber() < 0.5 then "graffiti1" else "graffiti2", c, w, w / 2, rng:NextNumber(1.1, math.min(1.7, hw - w / 4 - 0.1)), 0,
				Color3.new(1, 1, 1), rng:NextNumber(0.1, 0.3))
		end
	end
	-- taches au sol
	local img = MapDress.decal("tache")
	if img then
		for _ = 1, prof.stains do
			local c = open[rng:NextInteger(1, math.max(1, #open))]
			if not c then break end
			local d = rng:NextNumber(0.7, 2) * U
			local cf = CFrame.new(at(c, rng:NextNumber(-0.4, 0.4) * CELL, rng:NextNumber(-0.4, 0.4) * CELL, 0.135)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
			local p = part(folder, "Tache", Vector3.new(d, 0.02, d * rng:NextNumber(0.6, 1)), cf, Color3.new(), Enum.Material.SmoothPlastic)
			p.Transparency = 1
			local dc = Instance.new("Decal")
			dc.Face = Enum.NormalId.Top; dc.TextureContent = img; dc.Color3 = prof.stainCol or darker(floorCol, 0.38)
			dc.Transparency = rng:NextNumber(0.2, 0.5)
			dc.Parent = p
		end
	end
end

-- ---------- construction ----------
function MapExtras.build(b: Build, info: any)
	if not b.alive or not b.details then return end
	local md = MapData[b.id]
	local themeName: string = (md and md.theme) or "sand"
	local prof = PROFILES[themeName] or PROFILES.sand
	local sv: Saved = { regions = {}, emitters = {}, shadows = {} }
	saved[b] = sv
	local folder = Instance.new("Folder"); folder.Name = "Extras"; folder.Parent = b.details
	local rng = Random.new(hash(b.id))
	local O = b.origin
	local function at(c: Cell, ox: number, oz: number, y: number): Vector3
		return O + Vector3.new((c.cx + 0.5) * CELL + ox, y, (c.cz + 0.5) * CELL + oz)
	end
	local function pick<T>(list: { T }): T? return if #list > 0 then list[rng:NextInteger(1, #list)] else nil end

	pcall(terrainRing, b, sv, prof)
	if not b.alive then return end

	local g = MapData.buildGrid(b.id)
	local open, outdoor, edges, tops, barrels = scan(g)
	-- couleur du sol de jeu (le grand plan de 80 m avec le détail du sol du web)
	local floorCol = Color3.fromRGB(120, 120, 120)
	for _, p in ipairs(MapScene.prims(b.id)) do
		local mi = MapScene.faceMain(p)
		local m = mi > 0 and info.mats[mi] or nil
		if m and m.det then floorCol = MapScene.color(m.avg); if p.color then floorCol = Color3.new(floorCol.R * p.color.R, floorCol.G * p.color.G, floorCol.B * p.color.B) end; break end
	end
	local snowy = md and md.base == "snow"

	-- flaques : disques vitreux sombres (reflets des lampes et du ciel avec l'éclairage Future)
	local wetCells = if themeName == "metro" then open else outdoor
	for _ = 1, prof.puddles do
		local c = pick(wetCells)
		if not c then break end
		local d = rng:NextNumber(0.9, 2.2) * U
		local ox, oz = rng:NextNumber(-0.5, 0.5) * U, rng:NextNumber(-0.5, 0.5) * U
		local col = darker(floorCol, 0.32)
		-- dessus des surfaces au sol (studs) : sol dessiné 0,01, calque d'ombres 0,09 (écarté par MapBuilder), saleté 0,13,
		-- flaque 0,18, petite flaque 0,23 ; à moins de 0,04 stud l'une de l'autre, elles scintillaient (z-fighting) au loin
		local p = part(folder, "Flaque", Vector3.new(0.03, d, d), CFrame.new(at(c, ox, oz, 0.165)) * CFrame.Angles(0, 0, math.pi / 2), col, Enum.Material.Glass)
		local pc = p :: Part; pc.Shape = Enum.PartType.Cylinder; p.Transparency = 0.3; p.Reflectance = 0.25
		local d2 = d * rng:NextNumber(0.45, 0.7)
		local q = part(folder, "Flaque", Vector3.new(0.03, d2, d2), CFrame.new(at(c, ox + (d - d2) * 0.45, oz + rng:NextNumber(-0.3, 0.3) * d, 0.215)) * CFrame.Angles(0, 0, math.pi / 2), col, Enum.Material.Glass)
		local qc = q :: Part; qc.Shape = Enum.PartType.Cylinder; q.Transparency = 0.3; q.Reflectance = 0.25
	end

	-- saleté au pied des murs (bande sombre translucide, terre ou béton sale) ; congères sur la neige
	local nd = 0
	for _, c in ipairs(edges) do
		if nd >= math.max(prof.dirt, if prof.drifts then 80 else 0) then break end
		if rng:NextNumber() < 0.45 then
			nd += 1
			local len = CELL * rng:NextNumber(0.55, 1)
			local along = rng:NextNumber(-1, 1) * (CELL - len) / 2
			if prof.drifts and snowy then
				-- congère : pente de neige contre le mur (face haute de la WedgePart vers le mur, côté +Z local)
				local depth, hgt = rng:NextNumber(0.6, 1.2) * U, rng:NextNumber(0.2, 0.45) * U
				local pos = at(c, c.dx * (CELL / 2 - depth / 2) + (if c.dx == 0 then along else 0), c.dz * (CELL / 2 - depth / 2) + (if c.dz == 0 then along else 0), hgt / 2)
				local dir = Vector3.new(c.dx, 0, c.dz)
				part(folder, "Congere", Vector3.new(len, hgt, depth), CFrame.lookAt(pos, pos - dir), Color3.fromRGB(236, 241, 248), Enum.Material.Snow, "WedgePart")
			elseif prof.dirt > 0 then
				local depth = rng:NextNumber(0.3, 0.7) * U
				local sx = if c.dx ~= 0 then depth else len
				local sz = if c.dz ~= 0 then depth else len
				local pos = at(c, c.dx * (CELL / 2 - depth / 2) + (if c.dx == 0 then along else 0), c.dz * (CELL / 2 - depth / 2) + (if c.dz == 0 then along else 0), 0.115)
				local mat = if themeName == "sand" or themeName == "jungle" then Enum.Material.Ground elseif themeName == "metro" or themeName == "night" or themeName == "industrial" or themeName == "range" then Enum.Material.Asphalt else Enum.Material.Mud
				local p = part(folder, "Salete", Vector3.new(sx, 0.03, sz), CFrame.new(pos), darker(floorCol, rng:NextNumber(0.45, 0.65)), mat)
				p.Transparency = rng:NextNumber(0.35, 0.55)
			end
		end
	end

	-- gravats : petits éclats contre les murs (et quelques-uns au milieu)
	for k = 1, prof.debris do
		local c = if rng:NextNumber() < 0.75 then pick(edges) else pick(open)
		if not c then break end
		local s = Vector3.new(rng:NextNumber(0.06, 0.32), rng:NextNumber(0.04, 0.2), rng:NextNumber(0.06, 0.3)) * U
		local ox = c.dx * rng:NextNumber(0.55, 0.92) * CELL / 2 + (if c.dx == 0 then rng:NextNumber(-0.45, 0.45) * CELL else 0)
		local oz = c.dz * rng:NextNumber(0.55, 0.92) * CELL / 2 + (if c.dz == 0 then rng:NextNumber(-0.45, 0.45) * CELL else 0)
		local cf = CFrame.new(at(c, ox, oz, s.Y * 0.35)) * CFrame.Angles(rng:NextNumber(-0.4, 0.4), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.4, 0.4))
		local p = part(folder, "Gravat", s, cf, darker(floorCol, rng:NextNumber(0.55, 1)), prof.debrisMat, if k % 4 == 0 then "WedgePart" else nil)
		p.CastShadow = s.Magnitude > 0.9
	end

	-- douilles du stand de tir
	for _ = 1, prof.casings do
		local c = pick(open)
		if not c then break end
		local cf = CFrame.new(at(c, rng:NextNumber(-0.45, 0.45) * CELL, rng:NextNumber(-0.45, 0.45) * CELL, 0.045)) * CFrame.Angles(0, rng:NextNumber(0, math.pi * 2), 0)
		local p = part(folder, "Douille", Vector3.new(0.26, 0.09, 0.09), cf, Color3.fromRGB(196, 150, 70), Enum.Material.Metal)
		local pc = p :: Part; pc.Shape = Enum.PartType.Cylinder; p.Reflectance = 0.15
	end

	-- feuilles mortes au sol, plus nombreuses le long des murs
	for _ = 1, prof.leaves do
		local c = if rng:NextNumber() < 0.6 then pick(edges) else pick(outdoor)
		if not c then break end
		local ox = c.dx * rng:NextNumber(0.3, 0.95) * CELL / 2 + (if c.dx == 0 then rng:NextNumber(-0.48, 0.48) * CELL else 0)
		local oz = c.dz * rng:NextNumber(0.3, 0.95) * CELL / 2 + (if c.dz == 0 then rng:NextNumber(-0.48, 0.48) * CELL else 0)
		local sz = rng:NextNumber(0.08, 0.16) * U
		local cf = CFrame.new(at(c, ox, oz, 0.05)) * CFrame.Angles(rng:NextNumber(-0.25, 0.25), rng:NextNumber(0, math.pi * 2), rng:NextNumber(-0.25, 0.25))
		part(folder, "Feuille", Vector3.new(sz, 0.02, sz * 0.7), cf, prof.leafCols[rng:NextInteger(1, #prof.leafCols)], Enum.Material.Fabric)
	end
	task.wait()
	if not b.alive then return end
	local okD, errD = pcall(function(): any decals(folder, rng, prof, g, edges, open, floorCol, at); return nil end)
	if not okD then warn("[MapDetail] décalcomanies : " .. tostring(errD)) end
	task.wait()
	if not b.alive then return end

	-- câbles entre deux hauts de murs (8 à 22 m, hauteurs proches), qui pendent un peu
	if prof.cables > 0 and #tops > 1 then
		local anchor = part(folder, "Cables", Vector3.new(0.2, 0.2, 0.2), CFrame.new(O), Color3.new(), Enum.Material.SmoothPlastic)
		anchor.Transparency = 1
		local n, tries = 0, 0
		local used: { [string]: boolean } = {}
		while n < prof.cables and tries < 400 do
			tries += 1
			local a, c = pick(tops), pick(tops)
			if a and c and a ~= c then
				local pa = at(a, a.dx * CELL * 0.5, a.dz * CELL * 0.5, a.h * U + 0.08 * U)
				local pc = at(c, c.dx * CELL * 0.5, c.dz * CELL * 0.5, c.h * U + 0.08 * U)
				local dist = (pc - pa).Magnitude / U
				local key = math.min(a.cx * 100 + a.cz, c.cx * 100 + c.cz) .. ":" .. math.max(a.cx * 100 + a.cz, c.cx * 100 + c.cz)
				if dist > 8 and dist < 22 and math.abs(a.h - c.h) < 2.5 and not used[key] then
					used[key] = true
					n += 1
					-- courbe de Bézier du Beam : les deux poignées vers le bas (axe X des attachements)
					local a0 = Instance.new("Attachment"); a0.Parent = anchor; a0.WorldCFrame = CFrame.fromMatrix(pa, Vector3.new(0, -1, 0), Vector3.new(1, 0, 0))
					local a1 = Instance.new("Attachment"); a1.Parent = anchor; a1.WorldCFrame = CFrame.fromMatrix(pc, Vector3.new(0, 1, 0), Vector3.new(1, 0, 0))
					local sag = dist * rng:NextNumber(0.04, 0.08) * U / 0.75
					local bm = Instance.new("Beam")
					bm.Attachment0 = a0; bm.Attachment1 = a1
					bm.CurveSize0 = sag; bm.CurveSize1 = sag
					bm.Width0 = 0.045 * U; bm.Width1 = 0.045 * U; bm.FaceCamera = true; bm.Segments = 16
					bm.Color = ColorSequence.new(Color3.fromRGB(22, 22, 24)); bm.LightInfluence = 1; bm.LightEmission = 0
					bm.Transparency = NumberSequence.new(0)
					bm.Parent = anchor
				end
			end
		end
	end

	-- lumières : projecteurs muraux (nuit) et lampes sous les halos du web qui n'ont pas de vraie lampe
	local lights: { Vector3 } = {}
	for _, L in ipairs(info.lights or {}) do table.insert(lights, O + Vector3.new(L.p[1], L.p[2], L.p[3]) * U) end
	local function farFrom(p: Vector3, d: number): boolean
		for _, q in ipairs(lights) do if (q - p).Magnitude < d then return false end end
		return true
	end
	local nshadow = 0
	local function shadowed(l: Light, want: boolean)
		if want and nshadow < 6 then nshadow += 1; l.Shadows = not low(); table.insert(sv.shadows, l) else l.Shadows = false end
	end
	local glowImg = MapDress.glow()
	local placed = 0
	for _ = 1, 200 do
		if placed >= prof.lamps then break end
		local c = pick(tops)
		if not c then break end
		local dir = Vector3.new(c.dx, 0, c.dz)
		local base = at(c, c.dx * (CELL / 2 + 0.12 * U), c.dz * (CELL / 2 + 0.12 * U), (c.h - 0.35) * U)
		if farFrom(base, 14 * U) then
			placed += 1
			table.insert(lights, base)
			local cf = CFrame.lookAt(base, base + dir)
			part(folder, "Projecteur", Vector3.new(0.34, 0.14, 0.26) * U, cf, Color3.fromRGB(40, 42, 46), Enum.Material.Metal)
			local bulb = part(folder, "Ampoule", Vector3.new(0.28, 0.03, 0.2) * U, cf * CFrame.new(0, -0.085 * U, 0), prof.lampCol, Enum.Material.Neon)
			local sl = Instance.new("SpotLight")
			sl.Face = Enum.NormalId.Bottom; sl.Angle = 115; sl.Range = 15 * U; sl.Brightness = 2.4; sl.Color = prof.lampCol
			shadowed(sl, true)
			sl.Parent = bulb
			if glowImg then
				local bg = Instance.new("BillboardGui")
				bg.Size = UDim2.fromScale(1.4 * U, 1.4 * U); bg.LightInfluence = 0; bg.Brightness = 1.4; bg.MaxDistance = 450; bg.Adornee = bulb
				local il = Instance.new("ImageLabel")
				il.Size = UDim2.fromScale(1, 1); il.BackgroundTransparency = 1; il.ImageContent = glowImg; il.ImageColor3 = prof.lampCol; il.ImageTransparency = 0.35
				il.Parent = bg; bg.Parent = bulb
			end
		end
	end
	if prof.glowLights > 0 and #(info.glows or {}) > 0 then
		local list = table.clone(info.glows)
		table.sort(list, function(x: any, y: any) return x.s * x.o > y.s * y.o end)
		local anchor = part(folder, "LampesHalos", Vector3.new(0.2, 0.2, 0.2), CFrame.new(O), Color3.new(), Enum.Material.SmoothPlastic)
		anchor.Transparency = 1
		local n = 0
		for _, gl in ipairs(list) do
			if n >= prof.glowLights then break end
			local pos = O + Vector3.new(gl.p[1], gl.p[2], gl.p[3]) * U
			if farFrom(pos, 3 * U) then
				n += 1
				table.insert(lights, pos)
				local att = Instance.new("Attachment"); att.Parent = anchor; att.WorldPosition = pos
				local col = MapScene.color(gl.c)
				local l: Light
				if gl.p[2] > 2.5 then          -- lampe haute (réverbère, applique) : cône vers le sol
					local sl = Instance.new("SpotLight"); sl.Face = Enum.NormalId.Bottom; sl.Angle = 120; sl.Range = math.clamp(gl.s * U * 2.2, 10, 40)
					l = sl
				else
					local pl = Instance.new("PointLight"); pl.Range = math.clamp(gl.s * U * 1.6, 6, 24)
					l = pl
				end
				l.Color = col; l.Brightness = 0.8 + math.clamp(gl.o, 0, 1) * 1.2
				shadowed(l, n <= 3)
				l.Parent = att
			end
		end
	end

	-- fûts en feu : flammes, fumée et lueur orange
	local nf = 0
	for _ = 1, 40 do
		if nf >= prof.fire then break end
		local c = pick(barrels)
		if not c then break end
		local pos = at(c, 0, 0, (c.h + 0.05) * U)
		if farFrom(pos, 10 * U) then
			nf += 1
			table.insert(lights, pos)
			local p = part(folder, "Feu", Vector3.new(0.5, 0.2, 0.5) * U, CFrame.new(pos), Color3.new(), Enum.Material.SmoothPlastic)
			p.Transparency = 1
			local fl = Instance.new("ParticleEmitter")
			fl.Name = "Flammes"; fl.Texture = FIRE; fl.Rate = 28; fl.Lifetime = NumberRange.new(0.5, 0.9)
			fl.Speed = NumberRange.new(0.6 * U, 1.2 * U); fl.SpreadAngle = Vector2.new(12, 12); fl.LightEmission = 1; fl.LightInfluence = 0
			fl.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.35 * U), NumberSequenceKeypoint.new(1, 0.08 * U) })
			fl.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.3), NumberSequenceKeypoint.new(1, 1) })
			fl.Color = ColorSequence.new(Color3.fromRGB(255, 190, 90), Color3.fromRGB(255, 80, 30))
			fl.Enabled = not low(); fl.Parent = p
			local sm = Instance.new("ParticleEmitter")
			sm.Name = "Fumee"; sm.Texture = SMOKE; sm.Rate = 5; sm.Lifetime = NumberRange.new(6, 9)
			sm.Speed = NumberRange.new(0.5 * U, 0.9 * U); sm.SpreadAngle = Vector2.new(10, 10); sm.Acceleration = Vector3.new(0.12 * U, 0, 0.05 * U)
			sm.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 0.4 * U), NumberSequenceKeypoint.new(1, 2.4 * U) })
			sm.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.1, 0.72), NumberSequenceKeypoint.new(1, 1) })
			sm.Color = ColorSequence.new(Color3.fromRGB(46, 44, 42)); sm.RotSpeed = NumberRange.new(-25, 25); sm.Rotation = NumberRange.new(0, 360)
			sm.LightInfluence = 1; sm.Enabled = not low(); sm.Parent = p
			table.insert(sv.emitters, fl); table.insert(sv.emitters, sm)
			local pl = Instance.new("PointLight")
			pl.Color = Color3.fromRGB(255, 140, 60); pl.Range = 7 * U; pl.Brightness = 2
			shadowed(pl, true)
			pl.Parent = p
		end
	end

	-- brume au ras du sol, sur toute la carte
	if prof.mist then
		local W = MapData.N * CELL
		local p = part(folder, "Brume", Vector3.new(W * 0.95, 0.4 * U, W * 0.95), CFrame.new(O + Vector3.new(W / 2, 0.35 * U, W / 2)), Color3.new(), Enum.Material.SmoothPlastic)
		p.Transparency = 1
		local e = Instance.new("ParticleEmitter")
		e.Name = "Brume"; e.Texture = SMOKE; e.Shape = Enum.ParticleEmitterShape.Box; e.ShapeStyle = Enum.ParticleEmitterShapeStyle.Volume
		e.Rate = 7; e.Lifetime = NumberRange.new(14, 20); e.Speed = NumberRange.new(0.05 * U, 0.2 * U); e.SpreadAngle = Vector2.new(180, 10)
		e.Size = NumberSequence.new({ NumberSequenceKeypoint.new(0, 3.5 * U), NumberSequenceKeypoint.new(1, 5 * U) })
		e.Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.3, 0.86), NumberSequenceKeypoint.new(0.7, 0.86), NumberSequenceKeypoint.new(1, 1) })
		local fog = info.theme and info.theme.fog
		e.Color = ColorSequence.new(if fog then Color3.new(math.min(1, fog[1] * 1.6 + 0.08), math.min(1, fog[2] * 1.6 + 0.08), math.min(1, fog[3] * 1.6 + 0.1)) else Color3.fromRGB(150, 160, 170))
		e.RotSpeed = NumberRange.new(-6, 6); e.Rotation = NumberRange.new(0, 360); e.LightInfluence = 1
		e.Enabled = not low(); e.Parent = p
		table.insert(sv.emitters, e)
	end

	-- vraies lampes du web posées par le serveur (MapBuilder) : leurs ombres suivent aussi le réglage de qualité
	local lf = b.folder:FindFirstChild("Lights")
	if lf then
		for _, l in ipairs(lf:GetDescendants()) do
			if l:IsA("Light") and l.Shadows then table.insert(sv.shadows, l); l.Shadows = not low() end
		end
	end

	-- qualité : les réglages (ombres) coupent particules et ombres des lampes
	sv.conn = Lighting:GetPropertyChangedSignal("GlobalShadows"):Connect(function()
		for _, e in ipairs(sv.emitters) do e.Enabled = not low() end
		for _, l in ipairs(sv.shadows) do l.Shadows = not low() end
	end)
end

-- remet le terrain, l'eau et la couleur de l'herbe comme avant (les pièces sont dans Details, détruit avec la carte)
function MapExtras.clear(b: Build)
	local sv = saved[b]
	if not sv then return end
	saved[b] = nil
	if sv.conn then sv.conn:Disconnect() end
	local terrain = workspace:FindFirstChildOfClass("Terrain")
	if terrain then
		for _, r in ipairs(sv.regions) do pcall(function() terrain:FillBlock(r.cf, r.size, Enum.Material.Air) end) end
		local w = sv.water
		if w then for k, v in pairs(w) do pcall(function() (terrain :: any)[k] = v end) end end
		local gc = sv.grass
		if gc then pcall(function() terrain:SetMaterialColor(Enum.Material.Grass, gc) end) end
	end
end

return MapExtras
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="25">
        <Properties>
          <string name="Name">MapScene</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MapScene (ModuleScript, client + serveur)
-- Lit le décor 3D des cartes du web exporté par tools/export_scene.js + tools/scene_to_lua.py (dossier MapScenes) :
-- matériaux, primitives (blocs, boules, cylindres : construits par le serveur, MapBuilder), maillages
-- (construits par le client, MapDetailController), textures canvas du web (palette 256 couleurs), lampes, halos, ambiance.
-- Toutes les longueurs des données sont en mètres (comme le web) : multiplier par Config.STUDS_PER_METER.
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local decode = require(ReplicatedStorage.Shared.Base64)

local MapScene = {}

export type Mat = { c: { number }, avg: { number }, rm: string, tex: string?, rep: { number }?, off: { number }?, cut: boolean?,
	a: number?, ds: boolean?, vc: boolean?, fs: boolean?, refl: number?, det: { tex: string, rep: number, str: number }? }
export type Prim = { kind: number, flags: number, pos: Vector3, size: Vector3, tile: Vector3, rot: CFrame, mats: { number }, color: Color3? }
export type Tex = { w: number, h: number, fmt: string, kind: string, avg: Color3, rgba: buffer }

local root = ReplicatedStorage.Shared:FindFirstChild("MapScenes")

local function folderOf(id: string): Instance?
	return root and root:FindFirstChild(id)
end

function MapScene.has(id: string): boolean
	local f = folderOf(id)
	return f ~= nil and f:FindFirstChild("Info") ~= nil
end

local infos: { [string]: any } = {}
function MapScene.info(id: string): any
	if infos[id] == nil then
		local f = folderOf(id)
		local m = f and f:FindFirstChild("Info")
		infos[id] = if m then (require(m :: ModuleScript) :: any) else false
	end
	return infos[id] or nil
end

-- concatène les modules base64 B<n> listés dans Info puis décode
local function blob(id: string, names: { string }): buffer?
	local f = folderOf(id)
	if not f then return nil end
	local parts = table.create(#names)
	for _, n in ipairs(names) do
		local m = f:FindFirstChild(n)
		if not m then return nil end
		table.insert(parts, require(m :: ModuleScript) :: any)
	end
	return decode(table.concat(parts))
end

local function rgb8(r: number, g: number, b: number): Color3 return Color3.fromRGB(r, g, b) end
MapScene.rgb8 = rgb8
function MapScene.color(t: { number }): Color3 return Color3.fromRGB(t[1], t[2], t[3]) end

-- ---------- primitives (62 octets chacune, voir tools/scene_to_lua.py) ----------
local primCache: { [string]: { Prim } } = {}
function MapScene.prims(id: string): { Prim }
	if primCache[id] then return primCache[id] end
	local info = MapScene.info(id)
	local list: { Prim } = {}
	local buf = info and blob(id, info.prims)
	if buf then
		local n = buffer.len(buf) // 62
		for i = 0, n - 1 do
			local o = i * 62
			local f = function(k: number) return buffer.readf32(buf, o + 2 + k * 4) end
			local q = function(k: number) return buffer.readi16(buf, o + 38 + k * 2) / 32767 end
			local mats = table.create(6)
			for k = 0, 5 do local v = buffer.readu16(buf, o + 46 + k * 2); mats[k + 1] = if v == 65535 then -1 else v + 1 end
			local flags = buffer.readu8(buf, o + 1)
			local col: Color3? = nil
			if bit32.band(flags, 4) ~= 0 then col = rgb8(buffer.readu8(buf, o + 58), buffer.readu8(buf, o + 59), buffer.readu8(buf, o + 60)) end
			list[i + 1] = { kind = buffer.readu8(buf, o), flags = flags, pos = Vector3.new(f(0), f(1), f(2)), size = Vector3.new(f(3), f(4), f(5)),
				tile = Vector3.new(f(6), f(7), f(8)), rot = CFrame.new(0, 0, 0, q(0), q(1), q(2), q(3)), mats = mats, color = col }
		end
	end
	primCache[id] = list
	return list
end

-- ---------- maillages : buffer brut (décodé par MapDetailController) ----------
function MapScene.meshBlob(id: string): buffer?
	local info = MapScene.info(id)
	return info and blob(id, info.meshes)
end

-- ---------- textures ----------
-- MapScenes/_Tex : textures réduites du web (43 à 128 px, sol 512 px) ; ServerStorage/MapTexturesHQ : les mêmes en 512 px
-- au plus (taille d'origine du web si plus petite), rangées sous le même numéro (tools/tex_hd_to_lua.py). Seul
-- MeshUploader (Studio) lit leurs pixels pour les envoyer sur Roblox ; le joueur charge l'image envoyée (MapDress), ou
-- garde la texture réduite tant qu'elle ne l'est pas (en EditableImage, 16 fois plus de pixels pèseraient trop).
local function hdFolder(): Instance?
	local ok, ss = pcall(function() return game:GetService("ServerStorage") end)
	return if ok and ss then ss:FindFirstChild("MapTexturesHQ") else nil
end

local function loadTex(hd: boolean, tid: string, texCache: { [string]: Tex | false }): Tex?
	local c = texCache[tid]
	if c ~= nil then return if c then c :: any else nil end
	local folder = if hd then hdFolder() else (root and root:FindFirstChild("_Tex"))
	local m = folder and folder:FindFirstChild(tid)
	if not m then texCache[tid] = false; return nil end
	local d = require(m :: ModuleScript) :: any
	local s = d.px :: string
	if d.parts > 1 then
		local parts = { s }
		for k = 2, d.parts do
			local more = (folder :: Instance):FindFirstChild(tid .. "_" .. k)
			if more then table.insert(parts, require(more :: ModuleScript) :: any) end
		end
		s = table.concat(parts)
	end
	local px = decode(s)
	local w, h = d.w :: number, d.h :: number
	local out = buffer.create(w * h * 4)
	if d.fmt == "g" then        -- gris (détail du sol) : canal R = gris, alpha 255
		for i = 0, w * h - 1 do
			local g = buffer.readu8(px, i)
			buffer.writeu8(out, i * 4, g); buffer.writeu8(out, i * 4 + 1, g); buffer.writeu8(out, i * 4 + 2, g); buffer.writeu8(out, i * 4 + 3, 255)
		end
	else
		local pal = decode(d.pal)
		local stride = if d.fmt == "pa" then 4 else 3
		for i = 0, w * h - 1 do
			local k = buffer.readu8(px, i) * stride
			buffer.writeu8(out, i * 4, buffer.readu8(pal, k)); buffer.writeu8(out, i * 4 + 1, buffer.readu8(pal, k + 1)); buffer.writeu8(out, i * 4 + 2, buffer.readu8(pal, k + 2))
			buffer.writeu8(out, i * 4 + 3, if stride == 4 then buffer.readu8(pal, k + 3) else 255)
		end
	end
	local t: Tex = { w = w, h = h, fmt = d.fmt, kind = d.kind, avg = rgb8(d.avg[1], d.avg[2], d.avg[3]), rgba = out }
	texCache[tid] = t
	return t
end

local texLow: { [string]: Tex | false } = {}
local texHigh: { [string]: Tex | false } = {}
function MapScene.texture(tid: string): Tex? return loadTex(false, tid, texLow) end
function MapScene.textureHD(tid: string): Tex? return loadTex(true, tid, texHigh) end
-- vrai si les pixels HD de la texture sont là (Studio, serveur ; jamais chez le joueur), sans les décoder
function MapScene.hasHD(tid: string): boolean
	local folder = hdFolder()
	return folder ~= nil and folder:FindFirstChild(tid) ~= nil
end

-- genre de texture du web (« leafbroad », « plaster »…) sans décoder les pixels
function MapScene.texKind(tid: string): string?
	local folder = root and root:FindFirstChild("_Tex")
	local m = folder and folder:FindFirstChild(tid)
	if not m then return nil end
	local d = require(m :: ModuleScript) :: any
	return if type(d) == "table" and type(d.kind) == "string" then d.kind else nil
end

-- matériau Roblox du sol d'une carte, choisi comme groundKind() du web (40c_ground.js) : son relief se voit sous la
-- texture du web, comme le relief du sol du web ; outer : grand sol extérieur sans texture
function MapScene.groundMaterial(theme: string?, base: string?, outer: boolean): Enum.Material
	if theme == "jungle" then return if outer then Enum.Material.Grass else Enum.Material.Ground end
	if base == "sand" then return Enum.Material.Sand end
	if base == "snow" then return Enum.Material.Snow end
	if base == "haunt" then return Enum.Material.Ground end
	return Enum.Material.Concrete
end

-- matériau Roblox (nom d'Enum.Material) avec repli
function MapScene.material(name: string): Enum.Material
	local ok, m = pcall(function() return (Enum.Material :: any)[name] end)
	return if ok and m then m else Enum.Material.SmoothPlastic
end

-- ---------- matériaux Roblox haute définition (PBR) à la place des textures floues du web ----------
-- Les textures canvas du web sont exportées en 43 à 128 px : posées en Texture sur des blocs de plusieurs mètres, elles
-- sont floues. Quand une texture n'est qu'un motif de surface (enduit, briques, planches, béton, tôle rouillée, tuiles…),
-- le bloc prend plutôt le matériau PBR de Roblox équivalent (relief, rugosité et reflets nets à toute distance), teinté de
-- la couleur moyenne de la texture (avg). Les textures qui portent un dessin restent posées : conteneurs marqués, caisses
-- « FRAGILE », façades avec fenêtres, rame du métro, bottes de foin, panneaux, feuillages découpés, sol avec les sites.
-- Caisses, planchers et cabanes « découpés » sur le web sont en fait opaques (94 à 100 % des pixels) : bois plein.
local HD: { [string]: string } = {
	plaster = "Plaster", crate = "WoodPlanks", stone = "Brick", plat = "Pavement", roof = "ClayRoofTiles", pillar = "Sandstone",
	conc = "Concrete", platI = "DiamondPlate", pillarI = "Concrete", wceil = "WoodPlanks", corrug = "CorrodedMetal", rock = "Rock",
	cabin = "WoodPlanks", snowb = "Snow", wdeck = "WoodPlanks", deck = "WoodPlanks", pole = "Wood", bark = "Wood", brick = "Brick",
	tomb = "Slate", shelf = "WoodPlanks", barrel = "Metal",
}
local hdCache: { [string]: Enum.Material | false } = {}
-- matériau PBR qui remplace la texture du web de ce matériau ; nil : pas de texture, ou une texture à dessin gardée
function MapScene.hdMaterial(m: Mat): Enum.Material?
	local tid = m.tex
	if not tid then return nil end
	local c = hdCache[tid]
	if c == nil then
		local k = MapScene.texKind(tid)
		local name = if k then HD[k] else nil
		local mat: Enum.Material | false = if name then MapScene.material(name) else false
		hdCache[tid] = mat
		c = mat
	end
	if c == false or c == nil then return nil end
	return c :: any
end

-- calque d'ombres cuites du web (texture noire découpée de 128 px posée sur tout le sol) : très flou, et l'éclairage
-- Future de Roblox fait déjà les vraies ombres ; on l'éclaircit
function MapScene.isBakedShadow(m: Mat): boolean
	return m.cut == true and m.tex ~= nil and m.avg[1] + m.avg[2] + m.avg[3] < 6 and MapScene.texKind(m.tex :: string) == "misc"
end

-- bloc uni du web en plastique lisse : matériau d'après sa couleur ; nil : inchangé. Mesuré sur les 10 cartes : surtout
-- les chaperons et socles des murs (gris -> béton, beige des cartes de sable -> grès) et les poutres (brun foncé -> bois)
function MapScene.guessMaterial(c: Color3): Enum.Material?
	local h, s, v = c:ToHSV()
	if s < 0.16 and v > 0.18 and v < 0.85 then return Enum.Material.Concrete end
	if h > 0.03 and h < 0.12 and s > 0.45 and v > 0.12 and v < 0.45 then return Enum.Material.Wood end
	if h > 0.07 and h < 0.14 and s > 0.2 and s < 0.5 and v > 0.4 then return Enum.Material.Sandstone end
	return nil
end

-- matériau principal d'un bloc (première face non vide, dans l'ordre des côtés puis dessus et dessous)
function MapScene.faceMain(p: Prim): number
	for _, k in ipairs({ 1, 2, 5, 6, 3, 4 }) do if p.mats[k] > 0 then return p.mats[k] end end
	return -1
end

-- légère variation de teinte d'un bloc (n : numéro stable) : deux murs voisins ne sont jamais exactement pareils
function MapScene.vary(c: Color3, n: number): Color3
	local k = 1 + ((n * 7919) % 101 / 101 - 0.5) * 0.07
	return Color3.new(math.clamp(c.R * k, 0, 1), math.clamp(c.G * k, 0, 1), math.clamp(c.B * k, 0, 1))
end

return MapScene
]]></string>
        </Properties>
      </Item>
