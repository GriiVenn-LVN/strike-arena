		{ m = "glass", p = "static", c = { -0.5700, 2.3200, -3.0700 }, s = { 1.4259, 1.4255, 0.0200 }, r = { 0.71534, 0.69878, -0.00000, -0.68728, 0.70357, -0.18065, -0.12624, 0.12923, 0.98355 } },
