      <Item class="ModuleScript" referent="222">
        <Properties>
          <string name="Name">Mastery</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Mastery (ModuleScript, client + serveur)
-- Maîtrise d'arme façon Call of Duty : chaque arme (sauf le couteau) a ses défis de maîtrise, qui débloquent des camos
-- animés pour CETTE arme. Les camos sont dessinés par Shared/SkinPaint (cartes 512 px « i:mc:<camo> » envoyées par
-- MeshUploader, dessin en direct en attendant) et se posent comme les camos animés de la boutique (attribut Camo_<arme>).
--   Or            : 100 éliminations et 30 tirs à la tête avec l'arme
--   Diamant       : l'Or, puis 300 éliminations et 120 tirs à la tête avec l'arme
--   Matière noire : le Diamant sur l'arme ET sur 5 armes en tout
-- Les compteurs viennent de CareerService (profile.career[arme] = { k, hs }, comptés côté serveur à chaque élimination).
local Mastery = {}

export type Tier = { id: string, camo: string, name: string, color: Color3, kills: number, hs: number, needDiamonds: number? }

Mastery.TIERS = {
	{ id = "gold", camo = "m_gold", name = "Or", color = Color3.fromRGB(255, 196, 58), kills = 100, hs = 30 },
	{ id = "diamond", camo = "m_diamond", name = "Diamant", color = Color3.fromRGB(150, 225, 255), kills = 300, hs = 120 },
	{ id = "dark", camo = "m_dark", name = "Matière noire", color = Color3.fromRGB(190, 110, 255), kills = 300, hs = 120, needDiamonds = 5 },
} :: { Tier }

-- camos de maîtrise : même forme que SkinInfo.ANIM (nom, couleur des pièces secondaires, finition) ; SkinPaint les ajoute
Mastery.CAMOS = {
	m_gold = { name = "Or de maîtrise", a = "#5a3c08", fin = "chrome" },
	m_diamond = { name = "Diamant", a = "#1a3a52", fin = "chrome" },
	m_dark = { name = "Matière noire", a = "#0a0614", fin = "gloss" },
} :: { [string]: { name: string, a: string, fin: string } }

-- armes concernées : toutes celles qui tirent (Config.WEAPONS sans le couteau)
function Mastery.eligible(weapons: { [string]: any }, key: string): boolean
	local w = weapons[key]
	return w ~= nil and not w.melee
end

-- niveau atteint sur une arme : 0 = rien, 1 = Or, 2 = Diamant, 3 = Matière noire
-- rec = { k, hs } de l'arme ; diamonds = nombre d'armes au Diamant (toutes armes)
function Mastery.level(rec: any, diamonds: number): number
	local k = if typeof(rec) == "table" then tonumber(rec.k) or 0 else 0
	local hs = if typeof(rec) == "table" then tonumber(rec.hs) or 0 else 0
	local lvl = 0
	for i, t in ipairs(Mastery.TIERS) do
		if k >= t.kills and hs >= t.hs and (t.needDiamonds == nil or diamonds >= t.needDiamonds) then lvl = i else break end
	end
	return lvl
end

-- nombre d'armes au Diamant (sert à la Matière noire)
function Mastery.diamonds(career: any): number
	local n = 0
	if typeof(career) ~= "table" then return 0 end
	local d = Mastery.TIERS[2]
	for _, rec in pairs(career) do
		if typeof(rec) == "table" and (tonumber(rec.k) or 0) >= d.kills and (tonumber(rec.hs) or 0) >= d.hs then n += 1 end
	end
	return n
end

-- camo de maîtrise débloqué sur cette arme ?
function Mastery.camoOpen(career: any, key: string, camo: string): boolean
	local rec = typeof(career) == "table" and career[key] or nil
	local lvl = Mastery.level(rec, Mastery.diamonds(career))
	for i, t in ipairs(Mastery.TIERS) do
		if t.camo == camo then return lvl >= i end
	end
	return false
end

-- prochain objectif d'une arme (texte court pour le Profil), nil si tout est fait
function Mastery.nextGoal(rec: any, diamonds: number): (Tier?, number, number)
	local lvl = Mastery.level(rec, diamonds)
	local t = Mastery.TIERS[lvl + 1]
	if not t then return nil, 1, 1 end
	local k = if typeof(rec) == "table" then tonumber(rec.k) or 0 else 0
	local hs = if typeof(rec) == "table" then tonumber(rec.hs) or 0 else 0
	return t, math.clamp(k / t.kills, 0, 1), math.clamp(hs / t.hs, 0, 1)
end

return Mastery
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="223">
        <Properties>
          <string name="Name">Medals</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Medals (ModuleScript, client + serveur)
-- Médailles de fin de partie du jeu web (src/8G_medals.js MEDALS) : nom, icône, XP gagnée en fin de partie.
local Medals = {}

export type Medal = { id: string, n: string, ic: string, xp: number }

Medals.ORDER = { "first", "revenge", "long", "knife", "nade", "air", "clutchhp", "save", "collat", "ace", "s5", "s10", "assist",
	"double", "triple", "fury", "pointblank", "buzzkill", "comeback", "slide" }
Medals.LIST = {
	first = { id = "first", n = "Premier sang", ic = "🔴", xp = 20 },
	revenge = { id = "revenge", n = "Vengeance", ic = "😤", xp = 15 },
	long = { id = "long", n = "Tir lointain", ic = "🎯", xp = 15 },
	knife = { id = "knife", n = "Humiliation", ic = "🔪", xp = 20 },
	nade = { id = "nade", n = "Grenadier", ic = "💥", xp = 10 },
	air = { id = "air", n = "Acrobate", ic = "🤸", xp = 15 },
	clutchhp = { id = "clutchhp", n = "Sur le fil", ic = "❤️", xp = 15 },
	save = { id = "save", n = "Sauveur", ic = "🛡️", xp = 15 },
	collat = { id = "collat", n = "Doublé", ic = "⚡", xp = 25 },
	ace = { id = "ace", n = "As", ic = "🃏", xp = 50 },
	s5 = { id = "s5", n = "Inarrêtable", ic = "🔥", xp = 25 },
	s10 = { id = "s10", n = "Légende", ic = "👑", xp = 60 },
	assist = { id = "assist", n = "Assistance", ic = "🤝", xp = 15 },
	-- médailles « à la Call of Duty » ajoutées au port Roblox (MedalService)
	double = { id = "double", n = "Double élimination", ic = "✌️", xp = 15 },
	triple = { id = "triple", n = "Triplé", ic = "🔱", xp = 30 },
	fury = { id = "fury", n = "Furie", ic = "🌪️", xp = 50 },
	pointblank = { id = "pointblank", n = "Bout portant", ic = "💢", xp = 10 },
	buzzkill = { id = "buzzkill", n = "Rabat-joie", ic = "🧯", xp = 20 },
	comeback = { id = "comeback", n = "Retour en force", ic = "🔁", xp = 20 },
	slide = { id = "slide", n = "Glissade mortelle", ic = "🏂", xp = 15 },
} :: { [string]: Medal }

-- seuils du web (mètres / secondes / dégâts)
Medals.LONG_M = 38          -- tir lointain : plus de 38 m
Medals.ASSIST_DMG = 25      -- assistance : au moins 25 dégâts sur la victime…
Medals.ASSIST_T = 8         -- … dans les 8 dernières secondes
Medals.CLUTCH_HP = 20       -- sur le fil : 20 PV ou moins
Medals.SAVE_T = 2           -- sauveur : l'allié visé a été touché il y a moins de 2 s
Medals.COLLAT_T = 0.2       -- doublé : deux éliminations à moins de 0,2 s avec la même arme
Medals.MULTI_T = 4          -- double / triplé / furie : éliminations à moins de 4 s l'une de l'autre (2, 3, 4 et plus)
Medals.POINT_M = 3          -- bout portant : à moins de 3 m (hors couteau)
Medals.BUZZ_STREAK = 3      -- rabat-joie : l'adversaire éliminé avait une série de 3 éliminations ou plus
Medals.COMEBACK_D = 3       -- retour en force : une élimination après 3 morts de suite

return Medals
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="224">
        <Properties>
          <string name="Name">MenuConfig</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/MenuConfig (ModuleScript, client + serveur)
-- Textes et listes du menu principal, repris du jeu web : nouveautés (src/87d_lobby.js NEWS), libellés des défis
-- (src/62_meta.js MPOOL, src/8O_defis.js WPOOL), titres de profil (Profil > Style), liste des touches (Réglages > Touches),
-- liste des options et leur nettoyage (Menu/Options côté client, OptionsService côté serveur).
local M = {}

-- Nouveautés de l'accueil ; go = où mène un clic (onglet du menu)
-- version des nouveautés : la fenêtre « Quoi de neuf » (LaunchNews) s'ouvre une fois par version et par joueur
M.NEWS_VERSION = "n9"
M.NEWS = {
	{ id = "n_reroll", ic = "🔄", t = "Défis renouvelables", d = "Un défi du jour ne te plaît pas ? Bouton CHANGER : 1 fois gratuit par jour, puis 60 pièces. Nouveau défi d'arme chaque jour." },
	{ id = "n_mastery", ic = "🥇", t = "Maîtrise d'arme : Or, Diamant, Matière noire", d = "Éliminations et tirs à la tête avec une arme débloquent ses camos animés de maîtrise. Profil › Statistiques.", go = "stats" },
	{ id = "n_card", ic = "🪪", t = "Carte de joueur", d = "Bannière et emblème à débloquer, visibles par tes adversaires dans la kill-cam. Profil › Pseudo et titre.", go = "style" },
	{ id = "n_medals", ic = "🔱", t = "7 nouvelles médailles", d = "Double élimination, Triplé, Furie, Bout portant, Rabat-joie, Retour en force et Glissade mortelle." },
	{ id = "n_train", ic = "⏱", t = "Entraînement : temps de réaction", d = "Le stand de tir mesure ta réaction sur les cibles surgissantes et garde tes records.", go = "mode:train" },
	{ id = "n_rewards", ic = "🎁", t = "Récompenses et passe de combat", d = "Bilan détaillé en fin de partie, calendrier de 7 jours, XP ×2 le week-end et nouveau passe de combat." },
	{ id = "n_gunfight", ic = "🔫", t = "Nouveaux modes : Gunfight et Survolté", d = "Gunfight : 2 contre 2, mêmes armes pour tous. Survolté : élimine toutes les 30 s ou explose !", go = "mode:gunfight" },
	{ id = "n_lobby", ic = "🏠", t = "Nouvel accueil", d = "Défis, nouveautés et récompenses dès l'ouverture du jeu." },
	{ id = "n_online", ic = "🌐", t = "Parties en ligne", d = "JOUER te met avec les autres joueurs du serveur. Les bots complètent s'il en manque.", go = "play" },
	{ id = "n_friends", ic = "👥", t = "Jouer avec des amis, en un écran", d = "Crée un groupe, invite tes amis, lance la partie.", go = "friends" },
	{ id = "n_tab", ic = "📋", t = "Nouveau tableau des scores", d = "Maintiens Tab en partie : score, chrono, MVP en direct." },
	{ id = "n_perk", ic = "🍹", t = "Boissons d'atout et caisses animées", d = "Nouvelles animations d'ouverture et de boisson.", go = "boxes" },
	{ id = "n_csgo", ic = "🔪", t = "Skins façon CS:GO et couteaux", d = "Nouvelles finitions d'armes et couteaux à collectionner.", go = "arms" },
	{ id = "n_camo", ic = "✨", t = "Camos animés", d = "Des camouflages qui bougent, exclusifs.", go = "arms" },
	{ id = "n_modes", ic = "🏳", t = "Domination et Infecté", d = "Deux nouveaux modes : tiens A, B, C ou survis aux infectés.", go = "mode:dom" },
	{ id = "n_kc", ic = "🎥", t = "Kill-cam du tueur", d = "Revois comment tu t'es fait éliminer." },
}

-- Libellés des défis ({t} = objectif)
M.MISSIONS = {
	kills = "Élimine {t} adversaires", hs = "Fais {t} headshots", win = "Gagne {t} partie", matches = "Joue {t} parties",
	plant = "Pose ou désamorce la bombe {t} fois", nade = "Élimine {t} adversaires avec une grenade", knife = "Élimine {t} adversaire au couteau",
	dmg = "Inflige {t} dégâts",
	-- src/8O_defis.js : par type d'arme, par mode, Zombies, Infecté (RewardService.MISSION_POOL)
	k_shotgun = "Élimine {t} adversaires au fusil à pompe", k_sniper = "Élimine {t} adversaires au fusil de précision",
	k_smg = "Élimine {t} adversaires au pistolet-mitrailleur", k_pistol = "Élimine {t} adversaires au pistolet",
	k_rifle = "Élimine {t} adversaires au fusil d'assaut", w_duel = "Gagne {t} Duel", w_dom = "Gagne {t} partie de Domination",
	w_gg = "Gagne {t} Course aux armes", z_wave = "Survis à {t} manches de Zombies", inf_surv = "Termine {t} partie d'Infecté sans être infecté",
	kcTag = "Ramasse {t} plaques en Élimination confirmée",
	w_gunfight = "Gagne {t} Gunfight", w_survolte = "Gagne {t} partie de Survolté",
	-- défis renouvelables du port Roblox (RewardService.MISSION_POOL) ; kw_<arme> : voir missionText
	md_assist = "Fais {t} assistances", md_long = "Réussis {t} tirs lointains (plus de 38 m)", md_double = "Fais {t} doubles éliminations",
	md_revenge = "Venge-toi {t} fois de ton tueur", md_first = "Fais le premier sang {t} fois", md_slide = "Élimine {t} adversaires en glissade",
	md_air = "Élimine {t} adversaires en plein saut", md_pointblank = "Élimine {t} adversaires à bout portant",
	md_buzzkill = "Arrête {t} séries adverses (Rabat-joie)", slide = "Fais {t} glissades en partie", climb = "Escalade {t} rebords en partie",
	hs_sniper = "Fais {t} headshots au fusil de précision", hs_pistol = "Fais {t} headshots au pistolet", hs_rifle = "Fais {t} headshots au fusil d'assaut",
	site_a = "Pose la bombe {t} fois sur le site A", site_b = "Pose la bombe {t} fois sur le site B",
	w_tdm = "Gagne {t} Match à mort par équipe", w_ffa = "Gagne {t} Match à mort", w_koth = "Gagne {t} Capture de zone",
	w_ctf = "Gagne {t} Capture du drapeau", w_kc = "Gagne {t} Élimination confirmée", w_bomb = "Gagne {t} partie de Compétitif",
}
M.WEEKLY = {
	kills = "Élimine {t} adversaires", hs = "Fais {t} headshots", win = "Gagne {t} parties", matches = "Joue {t} parties",
	knife = "Élimine {t} adversaires au couteau", dmg = "Inflige {t} dégâts",
	k_sniper = "Élimine {t} adversaires au fusil de précision", k_shotgun = "Élimine {t} adversaires au fusil à pompe",
	w_duel = "Gagne {t} Duels", w_dom = "Gagne {t} parties de Domination", z_wave = "Survis à {t} manches de Zombies",
	inf_surv = "Termine {t} parties d'Infecté sans être infecté",
	md_assist = "Fais {t} assistances", md_double = "Fais {t} doubles éliminations", md_slide = "Élimine {t} adversaires en glissade",
	climb = "Escalade {t} rebords en partie",
}
function M.missionText(id: string, target: number, weekly: boolean?): string
	local t = (if weekly then M.WEEKLY[id] else M.MISSIONS[id]) or M.MISSIONS[id]
	if not t and string.sub(id, 1, 3) == "kw_" then   -- défi d'arme du jour
		local w = require(script.Parent.Config).WEAPONS[string.sub(id, 4)]
		t = "Élimine {t} adversaires avec : " .. (if w then w.name else string.sub(id, 4))
	end
	t = t or id
	return (string.gsub(t, "{t}", tostring(target)))
end

-- Titres de profil débloqués par le niveau (Profil > Style du web) ; les titres de fidélité viennent de LoyaltyConfig.TITLES
M.TITLES = {
	{ id = "recrue", n = "Recrue", lvl = 1 },
	{ id = "lynx", n = "Œil de lynx", lvl = 3 },
	{ id = "ace", n = "As de l'arène", lvl = 5 },
	{ id = "artificier", n = "Artificier", lvl = 7 },
	{ id = "fantome", n = "Fantôme", lvl = 9 },
	{ id = "legende", n = "Légende vivante", lvl = 12 },
}

-- Commandes du jeu Roblox (Réglages > Touches) : clavier, manette
M.KEYS = {
	{ "Avancer / reculer / côtés", "W A S D (Z Q S D)", "Stick gauche" },
	{ "Sauter", "Espace", "A" },
	{ "Sprint", "Maj gauche", "L3" },
	{ "S'accroupir / glissade", "C ou Ctrl gauche", "B" },
	{ "Tirer", "Clic gauche", "RT" },
	{ "Viser (ADS) / lunette", "Clic droit", "LT" },
	{ "Recharger", "R", "X" },
	{ "Poser / désamorcer la bombe (maintenir)", "E", "X" },
	{ "Arme principale / pistolet / couteau", "1 / 2 / 3", "—" },
	{ "Arme suivante", "Molette", "Y" },
	{ "Inspecter l'arme", "V", "Croix haut" },
	{ "Choisir ses armes", "B", "Croix gauche" },
	{ "Danse / emote", "T", "—" },
	{ "Spray", "J", "—" },
	{ "Mode photo", "F4", "—" },
	{ "Tableau des scores", "Tab (maintenir)", "Select" },
	{ "Libérer la souris", "M", "Start" },
	{ "Menu principal (lobby) / pause (en partie)", "P ou Échap", "Croix bas" },
	{ "Passer la kill-cam", "Espace / clic", "A" },
}

-- Onglets des Réglages (menu principal et pause) : nom affiché et phrase d'aide. La clé reste le nom utilisé par
-- Menu/Options (O.SUBS) ; « Viseur » s'affiche « Point de visée » pour ne pas le confondre avec Arsenal › Viseurs.
M.SETTINGS_TABS = {
	{ id = "Général", n = "Général", help = "Qualité de l'image, sensibilité, champ de vision, compteurs FPS et ping." },
	{ id = "Viseur", n = "Point de visée", help = "La forme et la couleur du repère au centre de l'écran." },
	{ id = "Son", n = "Son", help = "Le volume général et celui de chaque type de son." },
	{ id = "Touches", n = "Touches", help = "Toutes les commandes, au clavier et à la manette." },
	{ id = "Accessibilité", n = "Accessibilité", help = "Couleurs pour daltoniens, sous-titres des sons, taille de l'interface." },
}
function M.settingsTab(id: string): { id: string, n: string, help: string }?
	for _, t in ipairs(M.SETTINGS_TABS) do if t.id == id then return t end end
	return nil
end

-- ---------- Options (Réglages du menu et panneau Réglages de la pause) ----------
-- Même liste côté client (Menu/Options) et côté serveur (OptionsService, qui borne tout avant de l'enregistrer).
-- { "num", min, max, défaut } · { "int", min, max, défaut } · { "bool", défaut } · { "enum", { valeurs }, défaut }
M.OPTIONS = ({
	fov = { "num", 60, 110, 70 }, sens = { "num", 0.1, 4, 1 }, aimSens = { "num", 0.2, 2, 1 },
	quality = { "int", 1, 3, 3 },
	realGuns = { "bool", true },           -- armes réalistes (AK, M4, AWP, Desert Eagle) sans skin, comme cfg.realGuns du web
	invertY = { "bool", false }, showFps = { "bool", false }, showPing = { "bool", false },
	-- viseur (cfg.xh du web : couleur XHCOL, forme)
	xhColor = { "int", 1, 8, 2 }, xhStyle = { "enum", { "dot", "cross", "circle", "none" }, "dot" },
	-- volumes : vol = général (0,7 = niveau d'origine, comme le curseur du web), les autres multiplient leur groupe (1 = origine)
	vol = { "num", 0, 1, 0.7 }, volWeapons = { "num", 0, 2, 1 }, volSteps = { "num", 0, 2, 1 }, volUi = { "num", 0, 2, 1 },
	volAmbient = { "num", 0, 2, 1 }, volMusic = { "num", 0, 2, 1 },
} :: { [string]: { any } })
-- curseur de volume -> groupe de Shared/Sfx (Sfx.setVolume) -> libellé
M.VOLUME_GROUPS = { { "volWeapons", "weapons", "ARMES" }, { "volSteps", "steps", "PAS" }, { "volUi", "ui", "INTERFACE" },
	{ "volAmbient", "ambient", "AMBIANCE" }, { "volMusic", "music", "MUSIQUE" } }
-- couleurs du viseur (XHCOL de src/85_menu.js) et formes
M.XH_COLORS = { 0x3dffa8, 0xffffff, 0x27e8ff, 0xffe14a, 0xff3b3b, 0xff58d6, 0x8a6bff, 0xff9a2a }
M.XH_STYLES = { { "dot", "Point" }, { "cross", "Croix" }, { "circle", "Cercle" }, { "none", "Aucun" } }
-- accessibilité (AccessibilityController, attribut « Access ») : gardée dans le profil avec les options
M.ACCESS = ({
	colorblind = { "enum", { "none", "deut", "prot", "trit" }, "none" }, subtitles = { "bool", false },
	hudScale = { "num", 0.7, 1.4, 1 }, shake = { "num", 0, 1, 1 },
} :: { [string]: { any } })

local function cleanOne(r: { any }, v: any): any
	local kind = r[1]
	if kind == "num" or kind == "int" then
		if typeof(v) ~= "number" or v ~= v then return r[4] end
		local x = math.clamp(v, r[2], r[3])
		return if kind == "int" then math.floor(x + 0.5) else x
	elseif kind == "bool" then
		return if typeof(v) == "boolean" then v else r[2]
	elseif kind == "enum" then
		return if typeof(v) == "string" and table.find(r[2], v) then v else r[3]
	end
	return nil
end
-- options reçues (client ou profil) -> table propre : seulement les clés connues, bornées, valeur par défaut sinon
function M.cleanOptions(data: any): { [string]: any }
	local src = if typeof(data) == "table" then data else {}
	local out: { [string]: any } = {}
	for k, r in pairs(M.OPTIONS) do out[k] = cleanOne(r, src[k]) end
	local acc = if typeof(src.access) == "table" then src.access else {}
	local a: { [string]: any } = {}
	for k, r in pairs(M.ACCESS) do a[k] = cleanOne(r, acc[k]) end
	-- sensibilité par arme (AccessibilityController) : 40 armes au plus, noms courts
	local ws: { [string]: number } = {}
	local n = 0
	if typeof(acc.weaponSens) == "table" then
		for w, v in pairs(acc.weaponSens) do
			if n >= 40 then break end
			if typeof(w) == "string" and #w <= 24 and typeof(v) == "number" and v == v then ws[w] = math.clamp(v, 0.2, 3); n += 1 end
		end
	end
	a.weaponSens = ws
	out.access = a
	return out
end

return M
]]></string>
        </Properties>
      </Item>
