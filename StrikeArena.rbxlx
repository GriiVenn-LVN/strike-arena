	[29] = { name = "Matrice", tex = "matrix", fin = "gloss", a = "#03140a", b = nil, tint = nil, glow = true },  -- web 28
	[30] = { name = "Sakura", tex = "sakura", fin = "paint", a = "#8a3a58", b = nil, tint = nil, glow = false },  -- web 29
