        <Properties>
          <string name="Name">WeaponInfo</string>
          <string name="Source"><![CDATA[-- Généré par tools/export_weapons_lua.py : dimensions des armes du jeu web, en mètres.
-- muzzle = bout du canon (z), left = main gauche, sight = hauteur de la ligne de visée, la poignée est en (0, 0, 0).
return {
	ak = { len = 0.880, muzzle = -0.5653, sight = 0.0910, left = { 0.0000, 0.0150, -0.2537 }, min = { -0.0176, -0.2050, 0.3147 }, max = { 0.0343, 0.0949, -0.5653 } },
	aug = { len = 0.720, muzzle = -0.3250, sight = 0.1440, left = { 0.0000, 0.0300, -0.1480 }, min = { -0.0452, -0.1400, 0.3950 }, max = { 0.0281, 0.1500, -0.3250 } },
	awp = { len = 1.300, muzzle = -0.9554, sight = 0.0786, left = { 0.0000, 0.0150, -0.4300 }, min = { -0.0277, -0.0870, 0.3446 }, max = { 0.0519, 0.1538, -0.9554 } },
	deagle = { len = 0.270, muzzle = -0.1883, sight = 0.0570, left = { 0.0000, 0.0000, -0.0000 }, min = { -0.0202, -0.0923, 0.0817 }, max = { 0.0202, 0.0584, -0.1883 } },
	famas = { len = 0.760, muzzle = -0.3962, sight = 0.1265, left = { 0.0000, 0.0162, -0.1777 }, min = { -0.0215, -0.1207, 0.3638 }, max = { 0.0215, 0.1393, -0.3962 } },
	fiveseven = { len = 0.208, muzzle = -0.1847, sight = 0.0590, left = { 0.0000, 0.0000, -0.0000 }, min = { -0.0165, -0.0872, 0.0233 }, max = { 0.0165, 0.0615, -0.1847 } },
	galil = { len = 0.970, muzzle = -0.6419, sight = 0.0690, left = { 0.0000, 0.0150, -0.2903 }, min = { -0.0324, -0.0984, 0.3281 }, max = { 0.0414, 0.0710, -0.6419 } },
	glock = { len = 0.190, muzzle = -0.1227, sight = 0.0500, left = { 0.0000, 0.0000, -0.0000 }, min = { -0.0144, -0.0800, 0.0673 }, max = { 0.0144, 0.0515, -0.1227 } },
	m249 = { len = 1.040, muzzle = -0.5773, sight = 0.1510, left = { 0.0000, 0.0328, -0.2610 }, min = { -0.1012, -0.1187, 0.4627 }, max = { 0.1082, 0.1858, -0.5773 } },
	m4 = { len = 0.840, muzzle = -0.5665, sight = 0.0960, left = { 0.0000, 0.0150, -0.2550 }, min = { -0.0339, -0.1242, 0.2735 }, max = { 0.0508, 0.1003, -0.5665 } },
	mac10 = { len = 0.280, muzzle = -0.1631, sight = 0.0820, left = { 0.0000, 0.0000, -0.0000 }, min = { -0.0217, -0.1298, 0.1169 }, max = { 0.0217, 0.0849, -0.1631 } },
