	[33] = { name = "Étoilé", tex = "stars", fin = "paint", a = "#0a1233", b = nil, tint = nil, glow = false },  -- web 32
	[34] = { name = "Hologramme", tex = "holo", fin = "chrome", a = "#2a2a3a", b = nil, tint = nil, glow = false },  -- web 33
