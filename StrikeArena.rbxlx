      <Item class="ModuleScript" referent="235">
        <Properties>
          <string name="Name">PhotoMode</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/PhotoMode (ModuleScript, côté client)
-- Mode photo du jeu web (src/8Z_photo.js) : caméra libre, interface masquée, ton soldat visible, 7 filtres
-- (Aucun, Noir et blanc, Sépia, Cinéma + bandes noires, Éclatant, Nocturne, Rétro + vignette), zoom et inclinaison,
-- capture (CaptureService : l'image va dans les captures Roblox du joueur).
-- Commandes : ZQSD / WASD ou flèches pour bouger, glisser la souris pour regarder, Espace / C pour monter / descendre,
-- Maj = plus vite, molette = zoom, Entrée = capturer, H = masquer les commandes, Échap = retour.
-- Sur Roblox la partie ne se fige pas (multijoueur) : en match, la caméra reste à 8 m de ton soldat au plus et ne
-- traverse pas les murs (sinon ce serait un moyen d'espionner l'adversaire).
-- API : PhotoMode.enter(), PhotoMode.exit(), PhotoMode.toggle(), PhotoMode.active(). Touche provisoire : F4
-- (PhotoController) en attendant le bouton du menu pause.
local ContextActionService = game:GetService("ContextActionService")
local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local UserInputService = game:GetService("UserInputService")
local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local S = require(ReplicatedStorage.Shared.ClientState)

local PhotoMode = {}

local player = Players.LocalPlayer
local U = 3.571   -- studs par mètre (Config.STUDS_PER_METER)
local MATCH_RADIUS = 8 * U

local FILTERS: { { n: string, cc: { [string]: any }?, bars: boolean?, vig: boolean? } } = {
	{ n = "Aucun" },
	{ n = "Noir et blanc", cc = { Saturation = -1, Contrast = 0.25, Brightness = 0.05 } },
	{ n = "Sépia", cc = { Saturation = -0.75, Contrast = 0.1, Brightness = 0.05, TintColor = Color3.fromRGB(255, 226, 184) } },
	{ n = "Cinéma", cc = { Saturation = -0.18, Contrast = 0.18, Brightness = -0.05 }, bars = true },
	{ n = "Éclatant", cc = { Saturation = 0.7, Contrast = 0.12 } },
	{ n = "Nocturne", cc = { Saturation = -0.45, Contrast = 0.3, Brightness = -0.2, TintColor = Color3.fromRGB(150, 190, 255) } },
	{ n = "Rétro", cc = { Saturation = 0.4, Contrast = -0.08, Brightness = 0.08, TintColor = Color3.fromRGB(255, 226, 196) }, vig = true },
}
PhotoMode.FILTERS = FILTERS

type State = { on: boolean, pos: Vector3, yaw: number, pit: number, roll: number, fov: number, filter: number, drag: boolean, bare: boolean,
	keys: { [Enum.KeyCode]: boolean }, hidden: { ScreenGui }, prevType: Enum.CameraType, prevSubject: Instance?, prevFov: number }
local PH: State = { on = false, pos = Vector3.zero, yaw = 0, pit = 0, roll = 0, fov = 60, filter = 1, drag = false, bare = false, keys = {}, hidden = {},
	prevType = Enum.CameraType.Custom, prevSubject = nil, prevFov = 70 }

local function make(class: string, props: { [string]: any }, parent: Instance?): any
	local o = Instance.new(class)
	if o:IsA("GuiObject") then (o :: any).BorderSizePixel = 0 end
	for k, v in pairs(props) do (o :: any)[k] = v end
	if parent then o.Parent = parent end
	return o
end

-- ---------- interface ----------
local gui: ScreenGui? = nil
local ui: { [string]: any } = {}
local cc: ColorCorrectionEffect? = nil
local function build(): ScreenGui
	if gui and gui.Parent then return gui end
	local g = make("ScreenGui", { Name = "PhotoMode", IgnoreGuiInset = true, ResetOnSpawn = false, DisplayOrder = 90, Enabled = false,
		ZIndexBehavior = Enum.ZIndexBehavior.Sibling }, player:WaitForChild("PlayerGui"))
	ui.top = make("Frame", { Size = UDim2.new(1, 0, 0.11, 0), BackgroundColor3 = Color3.new(), Visible = false }, g)
	ui.bot = make("Frame", { AnchorPoint = Vector2.new(0, 1), Position = UDim2.fromScale(0, 1), Size = UDim2.new(1, 0, 0.11, 0), BackgroundColor3 = Color3.new(), Visible = false }, g)
	ui.vig = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, Visible = false }, g)
	make("UIStroke", { Color = Color3.fromRGB(20, 8, 0), Thickness = 140, Transparency = 0.4, ApplyStrokeMode = Enum.ApplyStrokeMode.Border }, ui.vig)
	ui.flash = make("Frame", { Size = UDim2.fromScale(1, 1), BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 1, ZIndex = 5 }, g)
	ui.sign = make("TextLabel", { AnchorPoint = Vector2.new(1, 1), Position = UDim2.new(1, -24, 1, -20), Size = UDim2.fromOffset(400, 22), BackgroundTransparency = 1,
		Font = Enum.Font.GothamBlack, TextSize = 18, TextColor3 = Color3.new(1, 1, 1), TextTransparency = 0.25, TextStrokeTransparency = 0.5,
		TextXAlignment = Enum.TextXAlignment.Right, Text = "STRIKE ARENA", ZIndex = 3 }, g)
	local ctl = make("Frame", { Name = "Controls", Size = UDim2.fromScale(1, 1), BackgroundTransparency = 1, ZIndex = 4 }, g)
	ui.ctl = ctl
	make("TextButton", { Size = UDim2.fromOffset(1, 1), BackgroundTransparency = 1, Text = "", Modal = true }, ctl)   -- libère la souris
	make("TextLabel", { Position = UDim2.fromOffset(18, 14), Size = UDim2.fromOffset(300, 24), BackgroundTransparency = 1, Font = Enum.Font.GothamBlack, TextSize = 18,
		TextColor3 = Color3.fromRGB(255, 210, 58), TextXAlignment = Enum.TextXAlignment.Left, Text = "📷 MODE PHOTO", ZIndex = 4 }, ctl)
	make("TextLabel", { AnchorPoint = Vector2.new(0.5, 0), Position = UDim2.new(0.5, 0, 0, 44), Size = UDim2.new(1, -40, 0, 18), BackgroundTransparency = 1, Font = Enum.Font.Gotham,
		TextSize = 12, TextColor3 = Color3.fromRGB(200, 210, 230), TextStrokeTransparency = 0.6, ZIndex = 4,
		Text = "ZQSD / flèches : bouger · Glisser : regarder · Espace / C : monter / descendre · Maj : vite · Molette : zoom · Entrée : capturer · H : masquer · Échap : retour" }, ctl)
	local bar = make("Frame", { AnchorPoint = Vector2.new(0.5, 1), Position = UDim2.new(0.5, 0, 1, -16), Size = UDim2.fromOffset(820, 84), BackgroundColor3 = Color3.fromRGB(15, 23, 38),
		BackgroundTransparency = 0.15, ZIndex = 4 }, ctl)
	make("UICorner", { CornerRadius = UDim.new(0, 8) }, bar)
	make("UISizeConstraint", { MaxSize = Vector2.new(820, 84) }, bar)
	local fl = make("Frame", { Position = UDim2.fromOffset(10, 8), Size = UDim2.new(1, -20, 0, 28), BackgroundTransparency = 1, ZIndex = 4 }, bar)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 5) }, fl)
	ui.fbtn = {}
	for i, f in ipairs(FILTERS) do
		local b = make("TextButton", { Size = UDim2.fromOffset(0, 26), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = Color3.fromRGB(24, 35, 56), Font = Enum.Font.GothamBold,
			TextSize = 12, TextColor3 = Color3.new(1, 1, 1), Text = f.n, ZIndex = 4 }, fl)
		make("UIPadding", { PaddingLeft = UDim.new(0, 8), PaddingRight = UDim.new(0, 8) }, b)
		make("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
		b.Activated:Connect(function() PhotoMode.setFilter(i) end)
		ui.fbtn[i] = b
	end
	local row = make("Frame", { Position = UDim2.fromOffset(10, 44), Size = UDim2.new(1, -20, 0, 30), BackgroundTransparency = 1, ZIndex = 4 }, bar)
	make("UIListLayout", { FillDirection = Enum.FillDirection.Horizontal, Padding = UDim.new(0, 8), VerticalAlignment = Enum.VerticalAlignment.Center }, row)
	local function stepper(label: string, get: () -> string, minus: () -> (), plus: () -> ())
		local f = make("Frame", { Size = UDim2.fromOffset(170, 28), BackgroundTransparency = 1, ZIndex = 4 }, row)
		local l = make("TextLabel", { Size = UDim2.fromOffset(110, 28), BackgroundTransparency = 1, Font = Enum.Font.GothamBold, TextSize = 12, TextColor3 = Color3.fromRGB(141, 160, 189),
			TextXAlignment = Enum.TextXAlignment.Left, Text = label, ZIndex = 4 }, f)
		local function upd() l.Text = label .. " " .. get() end
		for j, s in ipairs({ "-", "+" }) do
			local b = make("TextButton", { Position = UDim2.fromOffset(110 + (j - 1) * 30, 1), Size = UDim2.fromOffset(26, 26), BackgroundColor3 = Color3.fromRGB(24, 35, 56),
				Font = Enum.Font.GothamBold, TextSize = 16, TextColor3 = Color3.new(1, 1, 1), Text = s, ZIndex = 4 }, f)
			make("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
			b.Activated:Connect(function() if j == 1 then minus() else plus() end; upd() end)
		end
		upd()
		return upd
	end
	ui.updFov = stepper("ZOOM", function() return tostring(math.floor(PH.fov)) end, function() PH.fov = math.clamp(PH.fov + 5, 15, 100) end, function() PH.fov = math.clamp(PH.fov - 5, 15, 100) end)
	ui.updRoll = stepper("INCLINAISON", function() return tostring(math.floor(math.deg(PH.roll) + 0.5)) .. "°" end,
		function() PH.roll = math.clamp(PH.roll - math.rad(5), math.rad(-30), math.rad(30)) end, function() PH.roll = math.clamp(PH.roll + math.rad(5), math.rad(-30), math.rad(30)) end)
	local function button(txt: string, gold: boolean, cb: () -> ())
		local b = make("TextButton", { Size = UDim2.fromOffset(0, 28), AutomaticSize = Enum.AutomaticSize.X, BackgroundColor3 = if gold then Color3.fromRGB(255, 210, 58) else Color3.fromRGB(24, 35, 56),
			Font = Enum.Font.GothamBlack, TextSize = 12, TextColor3 = if gold then Color3.fromRGB(15, 23, 38) else Color3.new(1, 1, 1), Text = txt, ZIndex = 4 }, row)
		make("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }, b)
		make("UICorner", { CornerRadius = UDim.new(0, 5) }, b)
		b.Activated:Connect(cb)
	end
	button("MASQUER", false, function() PhotoMode.toggleBare() end)
	button("📸 CAPTURER", true, function() PhotoMode.capture() end)
	button("RETOUR", false, function() PhotoMode.exit() end)
	gui = g
	return g
end

function PhotoMode.setFilter(i: number)
	PH.filter = math.clamp(i, 1, #FILTERS)
	local f = FILTERS[PH.filter]
	if cc then cc:Destroy(); cc = nil end
	if f.cc and PH.on then
		local e = Instance.new("ColorCorrectionEffect"); e.Name = "PhotoFilter"
		for k, v in pairs(f.cc) do (e :: any)[k] = v end
		e.Parent = Lighting
		cc = e
	end
	ui.top.Visible = f.bars == true; ui.bot.Visible = f.bars == true; ui.vig.Visible = f.vig == true
	ui.sign.Position = if f.bars then UDim2.new(1, -24, 0.89, -14) else UDim2.new(1, -24, 1, -20)
	for j, b in pairs(ui.fbtn) do
		b.BackgroundColor3 = if j == PH.filter then Color3.fromRGB(255, 210, 58) else Color3.fromRGB(24, 35, 56)
		b.TextColor3 = if j == PH.filter then Color3.fromRGB(15, 23, 38) else Color3.new(1, 1, 1)
	end
end
function PhotoMode.toggleBare()
	PH.bare = not PH.bare
	if ui.ctl then ui.ctl.Visible = not PH.bare end
end
function PhotoMode.active(): boolean return PH.on end

-- capture : les commandes disparaissent le temps de la photo, puis Roblox propose d'enregistrer l'image
function PhotoMode.capture()
	if not PH.on then return end
	local wasBare = PH.bare
	if ui.ctl then ui.ctl.Visible = false end
	task.wait()
	local ok = pcall(function()
		local CaptureService = game:GetService("CaptureService") :: any
		CaptureService:CaptureScreenshot(function(contentId: any)
			pcall(function() CaptureService:PromptSaveCapturesToGallery({ contentId }, function() end) end)
		end)
	end)
	task.wait(0.1)
	if ui.ctl and PH.on then ui.ctl.Visible = not wasBare end
	ui.flash.BackgroundTransparency = 0.15
	TweenService:Create(ui.flash, TweenInfo.new(0.5), { BackgroundTransparency = 1 }):Play()
	if not ok then warn("[PhotoMode] capture indisponible ici") end
end

-- ---------- entrées : on prend les touches de déplacement, de tir et de saut au jeu ----------
local MOVE_KEYS = { Enum.KeyCode.W, Enum.KeyCode.A, Enum.KeyCode.S, Enum.KeyCode.D, Enum.KeyCode.Z, Enum.KeyCode.Q, Enum.KeyCode.Up, Enum.KeyCode.Down,
	Enum.KeyCode.Left, Enum.KeyCode.Right, Enum.KeyCode.Space, Enum.KeyCode.C, Enum.KeyCode.LeftControl, Enum.KeyCode.LeftShift, Enum.KeyCode.RightShift,
	Enum.KeyCode.Return, Enum.KeyCode.KeypadEnter, Enum.KeyCode.Escape, Enum.KeyCode.H, Enum.KeyCode.R, Enum.KeyCode.E, Enum.KeyCode.G, Enum.KeyCode.F }
local function sink(_: string, st: Enum.UserInputState, input: InputObject): Enum.ContextActionResult
	local k = input.KeyCode
	if st == Enum.UserInputState.Begin then
		PH.keys[k] = true
		if k == Enum.KeyCode.Escape then task.defer(PhotoMode.exit)
		elseif k == Enum.KeyCode.Return or k == Enum.KeyCode.KeypadEnter then task.spawn(PhotoMode.capture)
		elseif k == Enum.KeyCode.H then PhotoMode.toggleBare() end
	elseif st == Enum.UserInputState.End or st == Enum.UserInputState.Cancel then
		PH.keys[k] = nil
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		PH.drag = st == Enum.UserInputState.Begin
	elseif input.UserInputType == Enum.UserInputType.MouseWheel then
		PH.fov = math.clamp(PH.fov + (if input.Position.Z > 0 then -3 else 3), 15, 100)
		if ui.updFov then ui.updFov() end
	end
	return Enum.ContextActionResult.Sink
end

local conns: { RBXScriptConnection } = {}
local function rootOf(): BasePart?
	local ch = player.Character
	return ch and ch:FindFirstChild("HumanoidRootPart") :: BasePart?
end
local rayParams = RaycastParams.new()
rayParams.FilterType = Enum.RaycastFilterType.Exclude

local function step(dt: number)
	local camera = workspace.CurrentCamera
	local k = PH.keys
	local sp = (if k[Enum.KeyCode.LeftShift] or k[Enum.KeyCode.RightShift] then 14 else 4.5) * U * math.min(dt, 0.05)
	local f, s, u = 0, 0, 0
	if k[Enum.KeyCode.W] or k[Enum.KeyCode.Z] or k[Enum.KeyCode.Up] then f += 1 end
	if k[Enum.KeyCode.S] or k[Enum.KeyCode.Down] then f -= 1 end
	if k[Enum.KeyCode.D] or k[Enum.KeyCode.Right] then s += 1 end
	if k[Enum.KeyCode.A] or k[Enum.KeyCode.Q] or k[Enum.KeyCode.Left] then s -= 1 end
	if k[Enum.KeyCode.Space] then u += 1 end
	if k[Enum.KeyCode.C] or k[Enum.KeyCode.LeftControl] then u -= 1 end
	local rot = CFrame.fromEulerAnglesYXZ(PH.pit, PH.yaw, 0)
	local want = PH.pos + (rot.LookVector * f + rot.RightVector * s + Vector3.new(0, u, 0)) * sp
	-- en match : pas plus loin que MATCH_RADIUS de son soldat, et jamais à travers un mur
	local root = rootOf()
	if root and player:GetAttribute("Zone") == "match" then
		local head = root.Position + Vector3.new(0, 2, 0)
		local off = want - head
		if off.Magnitude > MATCH_RADIUS then want = head + off.Unit * MATCH_RADIUS end
		local ex: { Instance } = { camera }
		if player.Character then table.insert(ex, player.Character) end
		rayParams.FilterDescendantsInstances = ex
		local hit = workspace:Raycast(head, want - head, rayParams)
		if hit then want = hit.Position - (want - head).Unit * 0.6 end
	end
	PH.pos = want
	camera.CameraType = Enum.CameraType.Scriptable
	camera.CFrame = CFrame.new(PH.pos) * CFrame.fromEulerAnglesYXZ(PH.pit, PH.yaw, PH.roll)
	camera.FieldOfView = PH.fov
	-- ton soldat est visible sur les photos
	local ch = player.Character
	if ch then for _, d in ipairs(ch:GetDescendants()) do if d:IsA("BasePart") then d.LocalTransparencyModifier = 0 end end end
end

function PhotoMode.enter()
	if PH.on then return end
	-- kill-cam, arrivée, spectateur ou soldat mort : la caméra appartient déjà à une autre scène
	-- (on en garderait le type Scriptable au retour, caméra bloquée)
	local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
	if S.kc ~= nil or not hum or hum.Health <= 0 then return end
	local camera = workspace.CurrentCamera
	if camera.CameraType == Enum.CameraType.Scriptable then return end
	local g = build()
	PH.on = true; PH.keys = {}; PH.drag = false; PH.roll = 0; PH.bare = false
	PH.prevType = camera.CameraType; PH.prevSubject = camera.CameraSubject; PH.prevFov = camera.FieldOfView
	PH.pos = camera.CFrame.Position
	local rx, ry = camera.CFrame:ToEulerAnglesYXZ()
	PH.pit, PH.yaw = rx, ry
	PH.fov = math.clamp(math.floor(camera.FieldOfView + 0.5), 15, 100)
	-- on cache les autres interfaces
	PH.hidden = {}
	for _, sg in ipairs((player:WaitForChild("PlayerGui")):GetChildren()) do
		if sg:IsA("ScreenGui") and sg ~= g and sg.Enabled then sg.Enabled = false; table.insert(PH.hidden, sg) end
	end
	g.Enabled = true
	ui.ctl.Visible = true
	ui.sign.Text = "STRIKE ARENA" .. (function()
		local m = player:GetAttribute("MatchMap")
		return if typeof(m) == "string" and m ~= "" then " · " .. string.upper(m) else ""
	end)()
	PhotoMode.setFilter(PH.filter)
	ui.updFov(); ui.updRoll()
	player:SetAttribute("UiOpen", true)
	ContextActionService:BindActionAtPriority("PhotoModeInput", sink, false, Enum.ContextActionPriority.High.Value + 50,
		Enum.UserInputType.MouseButton1, Enum.UserInputType.MouseButton2, Enum.UserInputType.MouseWheel, table.unpack(MOVE_KEYS))
	table.insert(conns, UserInputService.InputChanged:Connect(function(input: InputObject)
		if PH.drag and input.UserInputType == Enum.UserInputType.MouseMovement then
			local sc = 0.0042 * (PH.fov / 60)
			PH.yaw -= input.Delta.X * sc
			PH.pit = math.clamp(PH.pit - input.Delta.Y * sc, -1.5, 1.5)
		end
	end))
	RunService:BindToRenderStep("PhotoMode", Enum.RenderPriority.Last.Value, step)
	table.insert(conns, player.CharacterRemoving:Connect(function() task.defer(PhotoMode.exit) end))
	-- mort : on sort tout de suite, avant que la kill-cam ne prenne la caméra
	table.insert(conns, hum.Died:Connect(function() task.defer(PhotoMode.exit) end))
end

function PhotoMode.exit()
	if not PH.on then return end
	PH.on = false
	local camera = workspace.CurrentCamera
	pcall(function() RunService:UnbindFromRenderStep("PhotoMode") end)
	ContextActionService:UnbindAction("PhotoModeInput")
	for _, c in ipairs(conns) do c:Disconnect() end
	conns = {}
	if cc then cc:Destroy(); cc = nil end
	for _, sg in ipairs(PH.hidden) do if sg.Parent then sg.Enabled = true end end
	PH.hidden = {}
	if gui then gui.Enabled = false end
	camera.CameraType = PH.prevType
	if PH.prevSubject and PH.prevSubject.Parent then camera.CameraSubject = PH.prevSubject end
	camera.FieldOfView = PH.prevFov
	player:SetAttribute("UiOpen", nil)
end

function PhotoMode.toggle() if PH.on then PhotoMode.exit() else PhotoMode.enter() end end

return PhotoMode
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="236">
        <Properties>
          <string name="Name">PlayerCard</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/PlayerCard (ModuleScript, client + serveur)
-- Carte de joueur façon Call of Duty : une bannière (dégradé) + un emblème, choisis dans Profil › Pseudo et titre,
-- affichés dans la kill-cam (la carte du tueur) et dans l'écran d'accueil « Quoi de neuf ».
-- Tout se débloque en jouant (niveau, succès, médailles, maîtrise d'arme) ; la bannière et l'emblème Premium demandent
-- le Premium (LoyaltyService). Le serveur (CareerService) vérifie le déblocage avant d'équiper et recopie le choix dans
-- l'attribut « Card » du joueur (« banniere|embleme »).
local PlayerCard = {}

-- vue : ce qu'il faut savoir du profil pour les déblocages (construite par CareerService.cardView, envoyée au menu)
export type View = { level: number, ach: { [string]: any }, medals: { [string]: number }, gold: number, diamonds: number, dark: number,
	vip: boolean, rankBest: number, pumpkins: number }
-- need : { lvl = niveau } | { ach = succès } | { medal = id, n = nombre } | { gold = n } | { diamonds = n } | { dark = n } | { vip = true }
--        | { rank = division } | { pumpkins = n }
export type Banner = { id: string, n: string, a: Color3, b: Color3, need: { [string]: any }, fx: string? }
export type Emblem = { id: string, n: string, ic: string, need: { [string]: any } }

local function rgb(h: number): Color3
	return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255))
end

PlayerCard.BANNERS = {
	{ id = "recrue", n = "Recrue", a = rgb(0x1e2a42), b = rgb(0x0b111c), need = { lvl = 1 } },
	{ id = "crepuscule", n = "Crépuscule", a = rgb(0xff6b5a), b = rgb(0x3a1650), need = { lvl = 5 } },
	{ id = "neon", n = "Néon", a = rgb(0x21e6c1), b = rgb(0x3a4bff), need = { lvl = 10 } },
	{ id = "jungle", n = "Jungle", a = rgb(0x4f8a2a), b = rgb(0x0e2410), need = { lvl = 15 } },
	{ id = "braise", n = "Braise", a = rgb(0xffb938), b = rgb(0x8a1a0a), need = { lvl = 20 } },
	{ id = "abysse", n = "Abysse", a = rgb(0x0a5a8a), b = rgb(0x020a1a), need = { lvl = 30 } },
	{ id = "tetes", n = "Chasseur de têtes", a = rgb(0xff4655), b = rgb(0x1a0406), need = { ach = "hs50" } },
	{ id = "centurion", n = "Centurion", a = rgb(0xc0c8d8), b = rgb(0x2a3040), need = { ach = "k100" } },
	{ id = "colline", n = "Roi de la colline", a = rgb(0x35e0c0), b = rgb(0x0a2a26), need = { ach = "koth" } },
	{ id = "triple", n = "Triplé", a = rgb(0xffd23a), b = rgb(0x5a2bd6), need = { medal = "triple", n = 1 } },
	{ id = "furie", n = "Furie", a = rgb(0xff2bd6), b = rgb(0x1a0420), need = { medal = "fury", n = 1 } },
	{ id = "or", n = "Maître d'armes", a = rgb(0xffd23a), b = rgb(0x6a4a10), need = { gold = 1 }, fx = "shine" },
	{ id = "diamant", n = "Diamant", a = rgb(0xbfe8ff), b = rgb(0x1a3a52), need = { diamonds = 1 }, fx = "shine" },
	{ id = "noire", n = "Matière noire", a = rgb(0xc77dff), b = rgb(0x07051a), need = { dark = 1 }, fx = "shine" },
	{ id = "rang_or", n = "Rang Or", a = rgb(0xffc53a), b = rgb(0x2a1a00), need = { rank = 6 } },
	{ id = "citrouille", n = "Nuit d'Halloween", a = rgb(0xff8a2a), b = rgb(0x2a1a4a), need = { pumpkins = 25 } },
	{ id = "premium", n = "Premium", a = rgb(0xffd23a), b = rgb(0xff5f48), need = { vip = true }, fx = "shine" },
} :: { Banner }

PlayerCard.EMBLEMS = {
	{ id = "cible", n = "Cible", ic = "🎯", need = { lvl = 1 } },
	{ id = "crane", n = "Crâne", ic = "💀", need = { lvl = 3 } },
	{ id = "loup", n = "Loup", ic = "🐺", need = { lvl = 8 } },
	{ id = "aigle", n = "Aigle", ic = "🦅", need = { lvl = 12 } },
	{ id = "dragon", n = "Dragon", ic = "🐉", need = { lvl = 25 } },
	{ id = "lame", n = "Lame", ic = "🔪", need = { medal = "knife", n = 10 } },
	{ id = "sang", n = "Premier sang", ic = "🔴", need = { medal = "first", n = 10 } },
	{ id = "main", n = "Équipier", ic = "🤝", need = { medal = "assist", n = 25 } },
	{ id = "bouclier", n = "Sauveur", ic = "🛡️", need = { medal = "save", n = 10 } },
	{ id = "eclair", n = "Furie", ic = "⚡", need = { medal = "fury", n = 1 } },
	{ id = "glisse", n = "Glisseur", ic = "🏂", need = { medal = "slide", n = 10 } },
	{ id = "couronne", n = "Légende", ic = "👑", need = { medal = "s10", n = 1 } },
	{ id = "medaille", n = "Maître d'armes", ic = "🥇", need = { gold = 1 } },
	{ id = "gemme", n = "Diamant", ic = "💎", need = { diamonds = 1 } },
	{ id = "galaxie", n = "Matière noire", ic = "🌌", need = { dark = 1 } },
	{ id = "potiron", n = "Citrouille", ic = "🎃", need = { pumpkins = 50 } },
	{ id = "etoile", n = "Premium", ic = "⭐", need = { vip = true } },
} :: { Emblem }

function PlayerCard.banner(id: string?): Banner
	for _, b in ipairs(PlayerCard.BANNERS) do if b.id == id then return b end end
	return PlayerCard.BANNERS[1]
end
function PlayerCard.emblem(id: string?): Emblem
	for _, e in ipairs(PlayerCard.EMBLEMS) do if e.id == id then return e end end
	return PlayerCard.EMBLEMS[1]
end
function PlayerCard.findBanner(id: string): Banner?
	for _, b in ipairs(PlayerCard.BANNERS) do if b.id == id then return b end end
	return nil
end
function PlayerCard.findEmblem(id: string): Emblem?
	for _, e in ipairs(PlayerCard.EMBLEMS) do if e.id == id then return e end end
	return nil
end

-- condition remplie ? (même règle côté client pour l'affichage et côté serveur pour la vérification)
function PlayerCard.open(need: { [string]: any }, v: View): boolean
	if need.lvl then return v.level >= need.lvl end
	if need.ach then return v.ach[need.ach] ~= nil end
	if need.medal then return (v.medals[need.medal] or 0) >= (need.n or 1) end
	if need.gold then return v.gold >= need.gold end
	if need.diamonds then return v.diamonds >= need.diamonds end
	if need.dark then return v.dark >= need.dark end
	if need.vip then return v.vip end
	if need.rank then return v.rankBest >= need.rank end
	if need.pumpkins then return v.pumpkins >= need.pumpkins end
	return false
end

-- texte de la condition (verrou dans le menu)
local MEDAL_N: { [string]: string } = { triple = "Triplé", fury = "Furie", knife = "Humiliation", first = "Premier sang", assist = "Assistance",
	save = "Sauveur", slide = "Glissade mortelle", s10 = "Légende" }
function PlayerCard.needText(need: { [string]: any }): string
	if need.lvl then return "Niveau " .. need.lvl end
	if need.ach then return "Succès à débloquer" end
	if need.medal then return "Médaille « " .. (MEDAL_N[need.medal] or need.medal) .. " » ×" .. (need.n or 1) end
	if need.gold then return "Maîtrise Or sur une arme" end
	if need.diamonds then return "Maîtrise Diamant sur une arme" end
	if need.dark then return "Maîtrise Matière noire" end
	if need.vip then return "Premium" end
	if need.rank then return "Rang Or atteint" end
	if need.pumpkins then return need.pumpkins .. " citrouilles" end
	return "Verrouillé"
end

-- « banniere|embleme » <-> ids
function PlayerCard.decode(s: any): (string, string)
	if typeof(s) ~= "string" then return "recrue", "cible" end
	local b, e = string.match(s, "^([%w_]+)|([%w_]+)$")
	return b or "recrue", e or "cible"
end

-- dessine une carte (Frame) : bannière en dégradé, emblème dans un rond, nom, titre et niveau
-- opts = { banner, emblem, name, title?, level?, size? (largeur, 300 par défaut) }
function PlayerCard.render(parent: Instance?, opts: { [string]: any }): Frame
	local TweenService = game:GetService("TweenService")
	local W = opts.size or 300
	local H = math.floor(W * 0.24)
	local b = PlayerCard.banner(opts.banner)
	local e = PlayerCard.emblem(opts.emblem)
	local function make(class: string, props: { [string]: any }, p: Instance?): any
		local o: any = Instance.new(class)
		if o:IsA("GuiObject") then o.BorderSizePixel = 0 end
		for k, v in pairs(props) do o[k] = v end
		if p then o.Parent = p end
		return o
	end
	local f = make("Frame", { Name = "PlayerCard", Size = UDim2.fromOffset(W, H), BackgroundColor3 = Color3.new(1, 1, 1), ClipsDescendants = true }, parent)
	make("UICorner", { CornerRadius = UDim.new(0, 6) }, f)
	make("UIGradient", { Color = ColorSequence.new(b.a, b.b), Rotation = 20 }, f)
	make("UIStroke", { Color = b.a:Lerp(Color3.new(1, 1, 1), 0.4), Thickness = 1, Transparency = 0.45 }, f)
	-- rayures discrètes (bannières COD)
	for i = 0, 5 do
		make("Frame", { AnchorPoint = Vector2.new(0.5, 0.5), Position = UDim2.new(0.55 + i * 0.09, 0, 0.5, 0), Size = UDim2.new(0, math.max(2, W // 60), 2.2, 0),
			Rotation = 25, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0.9 }, f)
	end
	local s = H - 10
	local em = make("TextLabel", { Name = "Emblem", Position = UDim2.fromOffset(5, 5), Size = UDim2.fromOffset(s, s), BackgroundColor3 = Color3.new(0, 0, 0),
		BackgroundTransparency = 0.55, Text = e.ic, TextScaled = true, Font = Enum.Font.GothamBold, TextColor3 = Color3.new(1, 1, 1) }, f)
	make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, em)
	make("UIStroke", { Color = b.a, Thickness = 2, Transparency = 0.2 }, em)
	make("UIPadding", { PaddingTop = UDim.new(0.14, 0), PaddingBottom = UDim.new(0.14, 0), PaddingLeft = UDim.new(0.14, 0), PaddingRight = UDim.new(0.14, 0) }, em)
	local x = s + 14
	local nameT = tostring(opts.name or "")
	make("TextLabel", { Name = "CardName", Position = UDim2.fromOffset(x, math.floor(H * 0.12)), Size = UDim2.new(1, -x - 50, 0, math.floor(H * 0.42)), BackgroundTransparency = 1,
		Text = nameT, Font = Enum.Font.GothamBlack, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.new(1, 1, 1),
		TextStrokeTransparency = 0.6 }, f)
	local sub = if typeof(opts.title) == "string" and opts.title ~= "" then opts.title else b.n
	make("TextLabel", { Name = "CardTitle", Position = UDim2.fromOffset(x, math.floor(H * 0.58)), Size = UDim2.new(1, -x - 50, 0, math.floor(H * 0.28)), BackgroundTransparency = 1,
		Text = string.upper(sub), Font = Enum.Font.GothamBold, TextScaled = true, TextXAlignment = Enum.TextXAlignment.Left, TextColor3 = Color3.fromRGB(255, 230, 160),
		TextTransparency = 0.05 }, f)
	if typeof(opts.level) == "number" then
		local lv = make("TextLabel", { Name = "CardLevel", AnchorPoint = Vector2.new(1, 0.5), Position = UDim2.new(1, -8, 0.5, 0), Size = UDim2.fromOffset(math.floor(H * 0.6), math.floor(H * 0.6)),
			BackgroundColor3 = Color3.fromRGB(255, 196, 58), Text = tostring(opts.level), Font = Enum.Font.GothamBlack, TextScaled = true, TextColor3 = Color3.fromRGB(42, 26, 0) }, f)
		make("UICorner", { CornerRadius = UDim.new(0.5, 0) }, lv)
		make("UIPadding", { PaddingTop = UDim.new(0.18, 0), PaddingBottom = UDim.new(0.18, 0) }, lv)
	end
	-- bannières rares : un reflet passe en boucle (comme les cartes rares du menu)
	if b.fx == "shine" then
		local band = make("Frame", { Name = "Sheen", AnchorPoint = Vector2.new(0, 0.5), Position = UDim2.fromScale(-0.5, 0.5), Size = UDim2.fromScale(0.3, 2),
			Rotation = 18, BackgroundColor3 = Color3.new(1, 1, 1), BackgroundTransparency = 0 }, f)
		make("UIGradient", { Transparency = NumberSequence.new({ NumberSequenceKeypoint.new(0, 1), NumberSequenceKeypoint.new(0.5, 0.7), NumberSequenceKeypoint.new(1, 1) }) }, band)
		TweenService:Create(band, TweenInfo.new(1.8, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut, -1, false, 2.2), { Position = UDim2.fromScale(1.2, 0.5) }):Play()
	end
	return f
end

return PlayerCard
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="237">
        <Properties>
          <string name="Name">ProductIds</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ProductIds (ModuleScript)
-- LE SEUL fichier à remplir pour activer les achats en Robux.
-- Pour chaque ligne : Creator Hub (create.roblox.com) → ton expérience → Monétisation → Produits pour développeurs
-- → « Créer un produit » avec le MÊME nom et le MÊME prix, puis colle ici le numéro du produit (ID).
-- Tant qu'un numéro vaut 0, le bouton correspondant affiche « Bientôt disponible » (rien n'est vendu).
-- Les passes de jeu (gp_…) se créent ailleurs : Monétisation → Passes (Game Passes) → « Créer un passe », puis colle son ID.
return {
	-- Offre unique : pack de départ (Developer Product)
	pack_starter = 0,   -- Pack de départ · 99 R$ (1 500 pièces, 2 caisses Premium, 5 boosts d'XP, titre Pionnier)
	-- Passes de jeu (Game Pass, achetés une fois)
	gp_xp2 = 0,         -- XP ×2 pour toujours · 299 R$
	-- Robux : pièces, caisses, passe de combat
	pass_premium = 0,   -- Passe de combat Premium · 399 R$
	coins_s = 0,        -- 300 pièces · 49 R$
	coins_m = 0,        -- 900 pièces · 129 R$
	coins_l = 0,        -- 2 200 pièces · 299 R$
	coins_xl = 0,       -- 5 500 pièces · 699 R$
	boxes_prem1 = 0,    -- 1 Caisse Premium · 79 R$
	boxes_prem5 = 0,    -- 5 Caisses Premium · 349 R$
	-- Exclusifs : camos animés
	camo_plasma = 0,    -- Camo animé Plasma · 299 R$
	camo_magma = 0,     -- Camo animé Magma vivant · 349 R$
	camo_code = 0,      -- Camo animé Code vivant · 249 R$
	camo_nebula = 0,    -- Camo animé Nébuleuse · 399 R$
	camo_prism = 0,     -- Camo animé Prisme · 449 R$
	camo_storm = 0,     -- Camo animé Tempête électrique · 349 R$
	camo_bundle = 0,    -- Collection des 6 camos animés · 1 299 R$
	-- Abonnement Premium
	vip_30 = 0,         -- Premium 30 jours · 349 R$
	vip_90 = 0,         -- Premium 90 jours · 899 R$
	-- Effets d'élimination
	killfx_lightning = 0, -- Coup de foudre · 149 R$
	killfx_ice = 0,       -- Statue de glace · 199 R$
	killfx_blackhole = 0, -- Trou noir · 299 R$
}
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="238">
        <Properties>
          <string name="Name">ReticleGui</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ReticleGui (ModuleScript, côté client)
-- Dessin d'un réticule en cadres d'interface : copie de drawReticle() du web (src/64c_sights.js).
-- Sert pour la lunette plein écran, l'aperçu Arsenal › Viseurs et la lentille des viseurs 3D (SurfaceGui).
-- draw(parent, cx, cy, R, forme, "#couleur", big) : big = réticule de lunette plein écran (R = rayon de la lunette).
local R = {}

local function hex(c: string): Color3
	local ok, col = pcall(Color3.fromHex, c)
	return if ok then col else Color3.new(1, 0, 0)
end
R.hex = hex

function R.draw(parent: GuiObject, cx: number, cy: number, Rr: number, sh: string, colHex: string, big: boolean, z: number?)
	local col = hex(colHex)
	local lw = if big then 2 else math.max(2, Rr * .07)
	local zi = z or 5
	local function dot(r: number)
		local f = Instance.new("Frame"); f.AnchorPoint = Vector2.new(.5, .5); f.Position = UDim2.fromOffset(cx, cy)
		f.Size = UDim2.fromOffset(r * 2, r * 2); f.BackgroundColor3 = col; f.BorderSizePixel = 0; f.ZIndex = zi
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = f
		f.Parent = parent
	end
	local function dotAt(x: number, y: number, r: number)
		local f = Instance.new("Frame"); f.AnchorPoint = Vector2.new(.5, .5); f.Position = UDim2.fromOffset(x, y)
		f.Size = UDim2.fromOffset(r * 2, r * 2); f.BackgroundColor3 = col; f.BorderSizePixel = 0; f.ZIndex = zi
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = f
		f.Parent = parent
	end
	local function line(x1: number, y1: number, x2: number, y2: number, w: number?)
		local dx, dy = x2 - x1, y2 - y1
		local L = math.sqrt(dx * dx + dy * dy)
		local f = Instance.new("Frame"); f.AnchorPoint = Vector2.new(.5, .5); f.Position = UDim2.fromOffset((x1 + x2) / 2, (y1 + y2) / 2)
		local t = w or lw
		f.Size = UDim2.fromOffset(L + t, t); f.Rotation = math.deg(math.atan2(dy, dx)); f.BackgroundColor3 = col; f.BorderSizePixel = 0; f.ZIndex = zi
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = f       -- bouts arrondis (lineCap = round)
		f.Parent = parent
	end
	local function ring(r: number, w: number)
		local f = Instance.new("Frame"); f.AnchorPoint = Vector2.new(.5, .5); f.Position = UDim2.fromOffset(cx, cy)
		f.Size = UDim2.fromOffset(r * 2, r * 2); f.BackgroundTransparency = 1; f.ZIndex = zi
		local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(1, 0); c.Parent = f
		local s = Instance.new("UIStroke"); s.Thickness = w; s.Color = col; s.Parent = f
		f.Parent = parent
	end
	if sh == "dot" then dot(if big then math.max(3, Rr * .012) else Rr * .14)
	elseif sh == "circle" then
		ring(Rr * (if big then .14 else .72), lw); dot(if big then math.max(2.5, Rr * .009) else Rr * .09)
	elseif sh == "cross" then
		local g, e = Rr * (if big then .025 else .16), Rr * (if big then 1 else .9)
		line(cx - e, cy, cx - g, cy); line(cx + g, cy, cx + e, cy); line(cx, cy - e, cx, cy - g); line(cx, cy + g, cx, cy + e)
		dot(if big then 2 else lw * .7 / 2 + .5)
	elseif sh == "chevron" then
		local s = Rr * (if big then .07 else .38)
		local thin = if big then lw else lw * .6
		local e = Rr * (if big then 1 else .95)
		line(cx - s, cy + s * .85, cx, cy); line(cx, cy, cx + s, cy + s * .85)
		line(cx, cy + s * 1.4, cx, cy + e, thin)
		line(cx - e, cy, cx - s * 1.5, cy, thin); line(cx + s * 1.5, cy, cx + e, cy, thin)
	elseif sh == "duplex" then
		local t, a, e = lw * (if big then 3 else 2.2), Rr * .4, Rr
		local thin = if big then 1.3 else lw * .6
		line(cx - e, cy, cx - a, cy, t); line(cx + a, cy, cx + e, cy, t); line(cx, cy + a, cx, cy + e, t); line(cx, cy - e, cx, cy - a, t)
		line(cx - a, cy, cx + a, cy, thin); line(cx, cy - a, cx, cy + a, thin)
	elseif sh == "mildot" then
		local e, th = Rr, if big then 1.3 else lw * .6
		line(cx - e, cy, cx + e, cy, th); line(cx, cy - e, cx, cy + e, th)
		local st, r = Rr * .13, if big then math.max(2.5, Rr * .01) else Rr * .04
		for i = 1, 4 do
			for _, d in ipairs({ { 1, 0 }, { -1, 0 }, { 0, 1 }, { 0, -1 } }) do dotAt(cx + d[1] * st * i, cy + d[2] * st * i, r) end
		end
	end
end

-- efface ce qu'un précédent draw a posé dans parent (les cadres sans nom)
function R.clear(parent: Instance)
	for _, c in ipairs(parent:GetChildren()) do if c:IsA("Frame") and c.Name == "Frame" then c:Destroy() end end
end

return R
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="239">
        <Properties>
          <string name="Name">Sfx</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/Sfx (ModuleScript, côté client)
-- Joue un son. Les vrais sons du jeu web sont rangés dans UN seul fichier audio (« planche », SoundSheet.lua) :
-- dès que ModeConfig.SOUND_SHEET contient son numéro, chaque son en est un extrait (Sound.PlaybackRegion).
-- Tant qu'il vaut 0, on garde les sons fournis avec Roblox (champ id de ModeConfig.SOUNDS).
--
-- Mixage (comme le jeu web : égaliseur, compresseur, réverbération) : chaque son passe par un groupe (SoundGroup)
-- de SoundService, avec ses effets :
--   "weapons" tirs, explosions, manipulations d'arme (égaliseur + compresseur + réverbération du lieu)
--   "steps"   pas, sauts, glissades (égaliseur + réverbération plus légère)
--   "ui"      touches, achats, annonces de manche (égaliseur + compresseur léger, pas de réverbération)
--   "ambient" fonds sonores des cartes (baisse tout seul pendant les tirs proches)
--   "music"   musique (rien ne la joue encore)
-- "master" est le groupe SoundService.Master (le même que celui du menu) : il règle aussi les sons sans groupe.
--
-- API des volumes (pour le menu d'options) :
--   Sfx.setVolume(groupName: string, v: number)   -- groupName : "master", "weapons", "steps", "ui", "ambient", "music"
--                                                 -- v : multiplicateur, 1 = niveau d'origine, borné entre 0 et 2
--   Sfx.getVolume(groupName: string): number      -- valeur réglée (1 par défaut, 0 pour un nom inconnu)
--   Sfx.GROUPS                                    -- la liste des six noms, dans l'ordre ci-dessus
-- Les valeurs ne sont pas sauvegardées ici : le menu les garde et les remet au démarrage.
--
-- Autres fonctions :
--   Sfx.play(def, at?, vol?)        -- def = entrée de ModeConfig.SOUNDS ({ id, volume, pitch, sheet, group?, rate? })
--                                   -- ou nom d'un son de la planche ("magout"…) ; at = position du son dans le monde
--   Sfx.step(surface, at?, vol?)    -- un pas sur "sand", "grass", "snow", "stone", "wood" ou "metal" (ModeConfig.SOUNDS.STEPS)
--   Sfx.setAcoustics(name)          -- réverbération du lieu (ModeConfig.SOUNDS.ACOUSTICS), appelé par AmbienceController
--   Sfx.muffle(sec, k?)             -- oreilles bouchées (aigus coupés) pendant sec secondes, k = force 0..1
--   Sfx.group(groupName)            -- le SoundGroup d'un groupe (nil côté serveur)
--   Sfx.reloadStep(cat, step, at?, vol?) -- étape de recharge : cat = catégorie d'arme ("pistol", "rifle"…),
--                                   -- step = "out" (chargeur sorti), "in" (chargeur inséré), "bolt" (culasse, pompe
--                                   -- ou verrou selon l'arme), "shell" (cartouche glissée une à une)
--   Sfx.bulletPass(from, to)        -- balle d'un autre tireur : claquement supersonique si elle passe près de la caméra
--   Sfx.impact(from, to)            -- bruit d'impact au bout d'une trajectoire, selon le matériau touché
--   Sfx.foley(kind, at?, vol?)      -- bruits du corps : "climb", "land", "slide", "jump", "cloth", "gear"
--   Sfx.setGround(surface)          -- sol sous le joueur (AmbienceController), pour les douilles qui tombent
--
-- Planche réaliste (ModeConfig.SOUND_SHEET_2, positions dans SoundSheet2.lua, faite par tools/render_sounds_real.js) :
-- quand son numéro est mis, les tirs passent en couches (détonation + mécanique + queue dehors / dedans + tir lointain
-- grave et retardé à la vitesse du son), douilles selon le sol, pas selon le matériau avec tissu et équipement,
-- recharge, impacts, touché confirmé, sifflement d'oreille. Tant qu'il vaut 0, tout reste sur la première planche.
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local SoundService = game:GetService("SoundService")
local RunService = game:GetService("RunService")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local ModeConfig = require(ReplicatedStorage.Shared.ModeConfig)
local Sheet = require(ReplicatedStorage.Shared.SoundSheet)
local Sheet2: { [string]: { number } } = require(ReplicatedStorage.Shared.SoundSheet2) :: any

local Sfx = {}
local BASE = 0.7          -- volume du fusil d'assaut ; les autres sons gardent leur écart de volume du web
local M = 3.571           -- studs par mètre (Config.STUDS_PER_METER)
local SOUNDS: any = ModeConfig.SOUNDS
local SHEET2: number = (ModeConfig :: any).SOUND_SHEET_2 or 0
local ID2 = "rbxassetid://" .. SHEET2

Sfx.GROUPS = { "master", "weapons", "steps", "ui", "ambient", "music" }

-- ---------- classement des sons ----------
local FIRE = { pistol = true, smg = true, rifle = true, lmg = true, sniper = true, shotgun = true }
local GROUP_OF: { [string]: string } = {
	pistol = "weapons", smg = "weapons", rifle = "weapons", lmg = "weapons", sniper = "weapons", shotgun = "weapons",
	knife = "weapons", knifehit = "weapons", reload = "weapons", magout = "weapons", magin = "weapons", rack = "weapons",
	shellin = "weapons", bolt = "weapons", pump = "weapons", draw = "weapons", click = "weapons", shell = "weapons",
	boom = "weapons", bang = "weapons", pop = "weapons", beep = "weapons",
	jump = "steps", slide = "steps", land = "steps",
	hit = "ui", hs = "ui", kill = "ui", dmg = "ui", shield = "ui", shieldbreak = "ui", pickup = "ui", buy = "ui",
	deny = "ui", win = "ui", lose = "ui", round = "ui", tick = "ui", heal = "ui", ui = "ui",
}
-- portée des sons placés dans le monde (mètres) : plein volume jusqu'à min, silence à max
local RANGE: { [string]: { number } } = {
	fire = { 6, 120 }, boom = { 12, 180 }, bang = { 8, 120 }, pop = { 4, 70 }, beep = { 3, 45 },
	steps = { 1.5, 28 }, handling = { 1.5, 25 }, knife = { 2, 30 }, default = { 3, 80 },
}
local HANDLING = { reload = true, magout = true, magin = true, rack = true, shellin = true, bolt = true, pump = true, draw = true, click = true, shell = true }
-- queue de tir (grondement qui suit le coup, comme gunShot() du web) : durée relative, volume
local TAIL: { [string]: { number } } = {
	pistol = { 0.45, 0.3 }, smg = { 0.35, 0.24 }, rifle = { 0.75, 0.34 }, lmg = { 0.8, 0.36 }, sniper = { 1.4, 0.45 }, shotgun = { 1.1, 0.42 },
}

-- ---------- groupes et effets ----------
type Fx = { group: SoundGroup, eq: EqualizerSoundEffect?, reverb: ReverbSoundEffect?, mix: any }
local fx: { [string]: Fx } = {}
local master: SoundGroup? = nil
local VOL: { [string]: number } = { master = 1, weapons = 1, steps = 1, ui = 1, ambient = 1, music = 1 }
local acoustic: any = SOUNDS.ACOUSTICS and SOUNDS.ACOUSTICS.lobby or {}
local ready = false

local function applyVolumes()
	if master then master.Volume = VOL.master end
	for name, f in pairs(fx) do
		f.group.Volume = (f.mix.vol or 1) * VOL[name] * VOL.master
	end
end

local function makeGroup(name: string): Fx
	local mix = (SOUNDS.MIX and SOUNDS.MIX[name]) or { vol = 1, low = 0, mid = 0, high = 0 }
	local gname = "Sfx_" .. name
	local old = SoundService:FindFirstChild(gname)
	if old then old:Destroy() end
	local g = Instance.new("SoundGroup"); g.Name = gname
	local f: Fx = { group = g, mix = mix }
	local eq = Instance.new("EqualizerSoundEffect")
	eq.LowGain = mix.low or 0; eq.MidGain = mix.mid or 0; eq.HighGain = mix.high or 0; eq.Priority = 3; eq.Parent = g
	f.eq = eq
	if name == "weapons" or name == "ui" then
		local c = Instance.new("CompressorSoundEffect")
		if name == "weapons" then c.Threshold = -14; c.Ratio = 6; c.Attack = 0.003; c.Release = 0.2
		else c.Threshold = -18; c.Ratio = 3; c.Attack = 0.005; c.Release = 0.15 end
		c.Priority = 2; c.Parent = g
	end
	if name == "weapons" or name == "steps" then
		local r = Instance.new("ReverbSoundEffect"); r.Priority = 1; r.Parent = g
		f.reverb = r
	end
	g.Parent = SoundService
	return f
end

local function setReverb(r: ReverbSoundEffect, p: any, wetOffset: number, t: number)
	local goal = {
		DecayTime = math.clamp(p.decay or 1, 0.1, 20), Density = math.clamp(p.density or 0.7, 0, 1),
		Diffusion = math.clamp(p.diffusion or 0.6, 0, 1), DryLevel = p.dry or 0, WetLevel = (p.wet or -14) + wetOffset,
	}
	if t <= 0 then
		r.DecayTime = goal.DecayTime; r.Density = goal.Density; r.Diffusion = goal.Diffusion; r.DryLevel = goal.DryLevel; r.WetLevel = goal.WetLevel
	else
		TweenService:Create(r, TweenInfo.new(t, Enum.EasingStyle.Sine), goal):Play()
	end
end

-- crée les groupes au premier son (côté client seulement)
local function ensure(): boolean
	if ready then return true end
	if not RunService:IsClient() then return false end
	ready = true
	local m = SoundService:FindFirstChild("Master")
	if m and m:IsA("SoundGroup") then master = m
	else
		local g = Instance.new("SoundGroup"); g.Name = "Master"; g.Parent = SoundService; master = g
	end
	for _, name in ipairs({ "weapons", "steps", "ui", "ambient", "music" }) do fx[name] = makeGroup(name) end
	-- l'ambiance et la musique baissent d'elles-mêmes quand les armes sont fortes (compresseur déclenché par les armes)
	for _, name in ipairs({ "ambient", "music" }) do
		local c = Instance.new("CompressorSoundEffect")
		c.SideChain = fx.weapons.group; c.Threshold = -32; c.Ratio = 4; c.Attack = 0.01; c.Release = 0.6; c.Priority = 2
		c.Parent = fx[name].group
	end
	for name, f in pairs(fx) do
		if f.reverb then setReverb(f.reverb, acoustic, if name == "steps" then -4 else 0, 0) end
	end
	applyVolumes()
	return true
end

function Sfx.group(name: string): SoundGroup?
	if name == "master" then ensure(); return master end
	if not ensure() then return nil end
	local f = fx[name]
	return f and f.group
end

function Sfx.setVolume(name: string, v: number)
	if VOL[name] == nil or typeof(v) ~= "number" or v ~= v then return end
	VOL[name] = math.clamp(v, 0, 2)
	if ensure() then applyVolumes() end
end

function Sfx.getVolume(name: string): number
	return VOL[name] or 0
end

-- réverbération du lieu (nom d'une entrée de ModeConfig.SOUNDS.ACOUSTICS)
function Sfx.setAcoustics(name: string)
	local p = SOUNDS.ACOUSTICS and SOUNDS.ACOUSTICS[name]
	if not p or p == acoustic then return end
	acoustic = p
	if not ensure() then return end
	for gname, f in pairs(fx) do
		if f.reverb then setReverb(f.reverb, p, if gname == "steps" then -4 else 0, 0.8) end
	end
end

function Sfx.isIndoor(): boolean return acoustic.indoor == true end

-- son de la planche réaliste (défini plus bas, après emit)
type L2 = { at: Vector3?, range: { number }?, delay: number?, group: string?, high: number?, mid: number?, low: number?,
	var: number?, rate: number?, echo: any? }
local layer: (base: string, vol: number, p: L2?) -> Sound?

-- oreilles bouchées après une explosion ou un flash : les aigus reviennent peu à peu (tinnitus() du web),
-- avec un sifflement d'oreille quand c'est fort (planche réaliste)
local muffleTweens: { Tween } = {}
function Sfx.muffle(sec: number, k: number?)
	if not ensure() then return end
	local s = math.clamp(k or 1, 0, 1)
	for _, tw in ipairs(muffleTweens) do tw:Cancel() end
	table.clear(muffleTweens)
	if s > 0.45 then layer("ring", 0.9 * s, { group = "master", var = 0.015 }) end
	for _, f in pairs(fx) do
		local eq = f.eq
		if eq then
			eq.HighGain = (f.mix.high or 0) - 34 * s; eq.MidGain = (f.mix.mid or 0) - 12 * s
			local tw = TweenService:Create(eq, TweenInfo.new(math.max(0.1, sec), Enum.EasingStyle.Quad, Enum.EasingDirection.In),
				{ HighGain = f.mix.high or 0, MidGain = f.mix.mid or 0 })
			tw:Play(); table.insert(muffleTweens, tw)
		end
	end
end

-- ---------- lecture ----------
local function listener(): Vector3?
	local cam = workspace.CurrentCamera
	return cam and cam.CFrame.Position
end

local lastRate: { [string]: number } = {}
-- hauteur au hasard autour de 1 (± var), jamais deux fois presque la même d'affilée pour un même son
local function vary(key: string, var: number): number
	local r = 1 + (math.random() * 2 - 1) * var
	local prev = lastRate[key]
	if prev and math.abs(r - prev) < var * 0.3 then r = 1 + (if r > prev then 1 else -1) * var * (0.4 + math.random() * 0.6) end
	lastRate[key] = r
	return r
end

type Opts = { id: string, region: { number }?, volume: number, speed: number, group: string?, at: Vector3?,
	range: { number }?, high: number?, mid: number?, low: number?, delay: number?, echo: any?, len: number }

local function emit(o: Opts): Sound
	local s = Instance.new("Sound")
	s.SoundId = o.id
	local region = o.region
	if region then
		s.PlaybackRegionsEnabled = true
		s.PlaybackRegion = NumberRange.new(region[1], region[1] + region[2])
	end
	s.Volume = o.volume; s.PlaybackSpeed = o.speed
	local f = o.group and fx[o.group]
	if f then s.SoundGroup = f.group elseif master then s.SoundGroup = master end
	if o.high or o.mid or o.low then
		local eq = Instance.new("EqualizerSoundEffect")
		eq.HighGain = o.high or 0; eq.MidGain = o.mid or 0; eq.LowGain = o.low or 0; eq.Parent = s
	end
	if o.echo then
		local e = Instance.new("EchoSoundEffect")
		e.Delay = math.clamp(o.echo.delay or 0.25, 0.01, 1); e.Feedback = math.clamp(o.echo.feedback or 0.3, 0, 0.9)
		e.DryLevel = 0; e.WetLevel = o.echo.wet or -10; e.Parent = s
	end
	local life = o.len / math.max(0.05, o.speed) + (o.delay or 0) + (if o.echo then 2 else 1) + (acoustic.decay or 1) * 0.5
	local holder: Instance = s
	if o.at then
		local rg = o.range or RANGE.default
		s.RollOffMode = Enum.RollOffMode.InverseTapered
		s.RollOffMinDistance = rg[1] * M; s.RollOffMaxDistance = rg[2] * M
		local a = Instance.new("Attachment"); a.WorldPosition = o.at; a.Parent = workspace.Terrain
		s.Parent = a; holder = a
	else
		s.Parent = SoundService
	end
	if o.delay and o.delay > 0.005 then
		task.delay(o.delay, function() if s.Parent then s:Play() end end)
	else
		s:Play()
	end
	Debris:AddItem(holder, math.max(4, life))
	return s
end

-- ---------- planche réaliste (SoundSheet2) ----------
-- variantes : « rifle#1 », « rifle#2 »… sont tirées au hasard, jamais deux fois la même d'affilée
local VARIANTS: { [string]: { string } } = {}
for key in pairs(Sheet2) do
	local base = string.match(key, "^(.-)#%d+$") or key
	local list = VARIANTS[base] or {}
	VARIANTS[base] = list
	table.insert(list, key)
end
for _, list in pairs(VARIANTS) do table.sort(list) end
local lastPick: { [string]: string } = {}
local function pick(base: string): string?
	local list = VARIANTS[base]
	if not list then return nil end
	local key = list[math.random(1, #list)]
	if #list > 1 and key == lastPick[base] then key = list[(table.find(list, key) :: number) % #list + 1] end
	lastPick[base] = key
	return key
end
local function distTo(at: Vector3): number
	local L = listener()
	return if L then (at - L).Magnitude / M else 0
end

layer = function(base: string, vol: number, p: L2?): Sound?
	if SHEET2 == 0 then return nil end
	local key = pick(base)
	local region = key and Sheet2[key]
	if not region or not ensure() then return nil end
	local q: L2 = p or {}
	local o: Opts = { id = ID2, region = region, len = region[2], volume = BASE * region[3] * vol * (0.92 + math.random() * 0.16),
		speed = (q.rate or 1) * vary(base, q.var or 0.04), group = q.group or "weapons", at = q.at, range = q.range,
		delay = q.delay, high = q.high, mid = q.mid, low = q.low, echo = q.echo }
	if q.at then
		o.range = o.range or RANGE.default
		-- sons lointains plus sourds (l'air garde les graves)
		local d = distTo(q.at)
		if d > 30 and not q.high then local k = math.clamp((d - 30) / 70, 0, 1); o.high = -20 * k; o.mid = -6 * k end
	end
	return emit(o)
end

-- sol sous le joueur (pour les douilles) -> type de sol des douilles
local ground = "stone"
local BRASS: { [string]: string } = { stone = "hard", metal = "metal", wood = "wood", sand = "soft", grass = "soft", snow = "soft" }
function Sfx.setGround(surface: string) if BRASS[surface] then ground = surface end end

-- armes « lourdes » : queue et tir lointain plus graves, culasse plus massive
local HEAVY = { rifle = true, lmg = true, sniper = true, shotgun = true }
local MECH: { [string]: string } = { pistol = "mech_light", smg = "mech_light", rifle = "mech_heavy", lmg = "mech_heavy" }
-- éjection de la douille après le coup (pompe et verrou : après la manœuvre)
local CASING_DELAY: { [string]: number } = { shotgun = 0.75, sniper = 0.85 }
local lastCasing = 0

-- tir en couches : détonation proche, mécanique, queue (dehors : grondement et échos ; dedans : salle), tir lointain
-- grave quand on s'éloigne ; tout arrive avec le retard du son (343 m/s). vol < 0,5 = silencieux (pas de claquement).
local function shot(name: string, at: Vector3?, vol: number): Sound?
	local d = if at then distTo(at) else 0
	local supp = vol < 0.5
	local heavy = HEAVY[name] == true
	local indoor = acoustic.indoor == true
	local delay = if at then math.min(d / 343, 1.6) else 0
	local near = if at then math.clamp(1 - (d - 25) / 70, 0, 1) else 1
	local far = if at then math.clamp((d - 18) / 45, 0, 1) else 0
	local main: Sound? = nil
	if near > 0 then
		main = layer(name, vol * near, { at = at, range = RANGE.fire, delay = delay, var = 0.05,
			high = if supp then -12 else nil, low = if supp then -3 else nil })
		local mech = MECH[name]
		if mech and d < 18 then layer(mech, (if supp then 1.4 else 1) * (1 - d / 18), { at = at, range = RANGE.handling, delay = delay + 0.012 }) end
	end
	if far > 0 and not (supp and d > 50) then
		local m = layer(if heavy then "far_heavy" else "far_light", (if supp then vol * 2 else vol) * far, { at = at, range = { 30, 700 },
			delay = delay, var = 0.07, high = -4 - 16 * math.clamp((d - 40) / 260, 0, 1), mid = -2 })
		main = main or m
	end
	local tail = (if indoor then "tail_in_" else "tail_out_") .. (if heavy then "heavy" else "light")
	layer(tail, vol * (if supp then 0.3 else 1) * (1 + 0.6 * math.clamp(d / 90, 0, 1)), { at = at, range = { 20, 500 },
		delay = delay + 0.015, var = 0.06, high = if indoor then -3 else nil })
	-- douille qui tombe : la nôtre, ou celle d'un tireur tout proche
	if (not at or d < 14) and os.clock() - lastCasing > 0.06 then
		lastCasing = os.clock()
		local brass = if name == "shotgun" then "brass_hull" else "brass_" .. (BRASS[ground] or "hard")
		local cAt = if at then at - Vector3.new(0, 4, 0) else nil
		layer(brass, if at then 0.9 else 0.6, { at = cAt, range = RANGE.handling, group = "steps",
			delay = (CASING_DELAY[name] or 0.38) + math.random() * 0.22, var = 0.08 })
	end
	return main
end

-- bruits du corps (escalade, réception, glissade, saut, tissu, équipement)
local FOLEY1: { [string]: { any } } = { climb = { "land", 0.6 }, land = { "land", 1 }, slide = { "slide", 1 }, jump = { "jump", 1 } }
function Sfx.foley(kind: string, at: Vector3?, vol: number?): Sound?
	local v = vol or 1
	if SHEET2 == 0 then
		local f = FOLEY1[kind]
		return if f then Sfx.play(f[1], at, v * f[2]) else nil
	end
	local p: L2 = { at = at, range = RANGE.steps, group = "steps" }
	local function extra(base: string, k: number, dl: number?)
		layer(base, v * k, { at = at, range = RANGE.steps, group = "steps", delay = dl })
	end
	if kind == "climb" then
		local s = layer("climb", v, p); extra("gear", 0.6, 0.15); return s
	elseif kind == "land" then
		local s = layer("land_heavy", v, p); extra("gear", 0.7, 0.03); extra("cloth", 0.5); return s
	elseif kind == "slide" then
		local s = layer("slide_rub", v, p); extra("cloth", 0.7, 0.05); extra("gear", 0.5, 0.1); return s
	elseif kind == "jump" then
		local s = layer("scuff", v * 0.8, p); extra("cloth", 0.6, 0.02); return s
	end
	return layer(kind, v, p)
end

-- étape de recharge, calée par le viewmodel sur la durée de recharge de l'arme
local RL_FALLBACK: { [string]: string } = { out = "magout", ["in"] = "magin", shell = "shellin" }
function Sfx.reloadStep(cat: string, step: string, at: Vector3?, vol: number?): Sound?
	local v = vol or 0.8
	local heavy = cat == "rifle" or cat == "lmg" or cat == "sniper"
	if SHEET2 == 0 then
		local n = if step == "bolt" or step == "pump" then (if cat == "shotgun" then "pump" elseif cat == "sniper" then "bolt" else "rack")
			else RL_FALLBACK[step]
		return if n then Sfx.play(n, at, v) else nil
	end
	local base = if step == "out" then (if heavy then "rl_out_heavy" else "rl_out_light")
		elseif step == "in" then (if heavy then "rl_in_heavy" else "rl_in_light")
		elseif step == "shell" then "rl_shell"
		elseif cat == "shotgun" then "rl_pump"
		elseif cat == "sniper" then "rl_bolt_sniper"
		else (if heavy then "rl_bolt_heavy" else "rl_bolt_light")
	local s = layer(base, v, { at = at, range = RANGE.handling, var = 0.05 })
	-- la main va chercher le chargeur : tissu et poches
	if step == "out" then layer("cloth", v * 0.5, { at = at, range = RANGE.handling, group = "steps", delay = 0.12 }) end
	if step == "in" and not at then layer("gear", v * 0.35, { group = "steps", delay = 0.05 }) end
	return s
end

-- balle d'un autre tireur qui passe près de la caméra : claquement (supersonique) ou sifflement (pistolet, PM)
local lastCrack = 0
function Sfx.bulletPass(from: Vector3, to: Vector3, cat: string?)
	if SHEET2 == 0 then return end
	local L = listener()
	if not L then return end
	local seg = to - from
	local len = seg.Magnitude
	if len < 1 then return end
	local dir = seg / len
	local along = math.clamp((L - from):Dot(dir), 0, len)
	if along < 3 * M then return end                  -- c'est nous qui tirons (ou presque)
	local closest = from + dir * along
	local miss = (L - closest).Magnitude / M
	if miss > 5 or os.clock() - lastCrack < 0.05 then return end
	lastCrack = os.clock()
	local k = 1 - miss / 5
	local sub = cat == "pistol" or cat == "smg"
	layer(if sub then "whiz" else "crack", 0.5 + 0.7 * k, { at = closest, range = { 1, 12 }, var = 0.08 })
end

-- impact au bout d'une trajectoire : matériau sous le point touché (chair si c'est un personnage)
local IMPACT: { [string]: string } = {
	Metal = "metal", CorrodedMetal = "metal", DiamondPlate = "metal", Foil = "metal",
	Wood = "wood", WoodPlanks = "wood",
	Sand = "dirt", Ground = "dirt", Mud = "dirt", Grass = "dirt", LeafyGrass = "dirt", Snow = "dirt", Salt = "dirt", Fabric = "dirt",
}
local impactParams = RaycastParams.new(); impactParams.FilterType = Enum.RaycastFilterType.Exclude
local impactCount, impactT = 0, 0
function Sfx.impact(from: Vector3, to: Vector3)
	if SHEET2 == 0 then return end
	local seg = to - from
	if seg.Magnitude < 1 then return end
	local d = distTo(to)
	if d > 45 then return end
	-- 6 impacts par dixième de seconde au plus (rafales de pompe)
	local t = os.clock()
	if t - impactT > 0.1 then impactT = t; impactCount = 0 end
	if impactCount >= 6 then return end
	impactCount += 1
	local dir = seg.Unit
	local me = game:GetService("Players").LocalPlayer
	impactParams.FilterDescendantsInstances = if me and me.Character then { me.Character } else {}
	local r = workspace:Raycast(to - dir * 1.5, dir * 3, impactParams)
	if not r then return end
	local inst = r.Instance
	local model = inst:FindFirstAncestorOfClass("Model")
	local mat = if model and model:FindFirstChildOfClass("Humanoid") then "flesh" else IMPACT[r.Material.Name] or "concrete"
	layer("imp_" .. mat, if mat == "flesh" then 0.8 else 1, { at = r.Position, range = { 2, 45 }, var = 0.07, delay = d / 343 })
	if (mat == "metal" or mat == "concrete") and math.random() < 0.1 then
		layer("ricochet", 0.6, { at = r.Position, range = { 3, 60 }, var = 0.12, delay = d / 343 + 0.01 })
	end
end

-- sons de la première planche remplacés par la planche réaliste
local UPGRADE: { [string]: string } = { hit = "hit_body", hs = "hit_head", kill = "hit_kill",
	magout = "rl_out_heavy", magin = "rl_in_heavy", rack = "rl_bolt_heavy", bolt = "rl_bolt_sniper", pump = "rl_pump", shellin = "rl_shell" }
local FOLEY_OF = { land = true, slide = true, jump = true }

-- def = entrée de ModeConfig.SOUNDS ({ id, volume, pitch, sheet }) ou nom d'un son de la planche ("magout"…)
function Sfx.play(def: any, at: Vector3?, vol: number?): Sound?
	if typeof(def) == "string" then def = SOUNDS[def] or { sheet = def } end
	if type(def) ~= "table" then return nil end
	ensure()
	local name: string? = if typeof(def.sheet) == "string" then def.sheet else nil
	if SHEET2 ~= 0 and RunService:IsClient() then
		local v = (vol or 1) * (def.gain or 1)
		if def == SOUNDS.empty then return layer("dryfire", v, { at = at, range = RANGE.handling }) end
		if name and FIRE[name] then return shot(name, at, v) end
		if name and FOLEY_OF[name] then return Sfx.foley(name, at, v) end
		if name and UPGRADE[name] then
			return layer(UPGRADE[name], v, { at = at, group = GROUP_OF[name], range = if at then RANGE.handling else nil })
		end
		if at and name == "boom" then
			local d = distTo(at)
			local s = layer(if d > 70 then "boom_far" else "boom_near", v, { at = at, range = RANGE.boom, delay = math.min(d / 343, 1.6), var = 0.06 })
			if not (acoustic.indoor == true) then
				layer("tail_out_heavy", v * 1.3, { at = at, range = { 20, 600 }, delay = math.min(d / 343, 1.6) + 0.05, rate = 0.8 })
			end
			if d < 9 then Sfx.muffle(1.4, 1 - d / 9 * 0.6) end
			return s
		end
	end
	local region = name and Sheet[name]
	local useSheet = ModeConfig.SOUND_SHEET ~= 0 and region ~= nil
	local o: Opts
	if useSheet and region and name then
		o = { id = "rbxassetid://" .. ModeConfig.SOUND_SHEET, region = region, len = region[2],
			volume = BASE * region[3] * (vol or 1) * (def.gain or 1) * (0.94 + math.random() * 0.12),
			speed = (def.rate or 1) * vary(name, def.var or 0.04) }
	elseif typeof(def.id) == "string" and def.id ~= "" then
		o = { id = def.id, len = 3, volume = (def.volume or 0.6) * (vol or 1) * (0.94 + math.random() * 0.12),
			speed = (def.pitch or 1) * vary(def.id, 0.05) }
	else
		return nil
	end
	local fire = name ~= nil and FIRE[name] == true
	o.group = def.group or (name and GROUP_OF[name]) or (if at then "weapons" else "ui")
	o.at = at
	local d = 0
	if at then
		local L = listener()
		d = if L then (at - L).Magnitude / M else 0
		o.range = if fire then RANGE.fire elseif name and RANGE[name] then RANGE[name]
			elseif o.group == "steps" then RANGE.steps elseif name and HANDLING[name] then RANGE.handling
			elseif name == "knife" or name == "knifehit" then RANGE.knife else RANGE.default
		-- sons lointains plus sourds (l'air garde les graves)
		if d > 30 then local k = math.clamp((d - 30) / 70, 0, 1); o.high = -20 * k; o.mid = -6 * k end
	end
	local s = emit(o)
	if fire and useSheet and region and name then
		-- queue du tir : le même coup, plus grave et plus long, filtré ; plus présente de loin ;
		-- dehors elle revient en écho, dedans elle est plus courte, plus claire et plus forte
		local T = TAIL[name] or TAIL.rifle
		local indoor = acoustic.indoor == true
		local far = 1 + math.clamp(d / 60, 0, 1.2)
		local rate = (if indoor then 0.72 else 0.5 + 0.1 / T[1]) * vary(name .. "_tail", 0.05)
		emit({
			id = o.id, region = region, len = region[2], group = "weapons", at = at,
			volume = BASE * region[3] * (vol or 1) * T[2] * far * (if indoor then 1.3 else 1),
			speed = math.clamp(rate, 0.35, 0.85),
			high = if indoor then -14 else -24 - 6 * math.clamp(d / 100, 0, 1), mid = if indoor then -4 else -8, low = 2,
			range = if at then { 15, 260 } else nil,
			delay = 0.03 + (if at then d / 343 * 0.5 else 0),
			echo = if indoor then nil else acoustic.echo,
		})
	end
	-- explosion ou flash tout près : oreilles bouchées
	if at and (name == "bang" or name == "boom") then
		local near = if name == "bang" then 18 else 9
		if d < near then Sfx.muffle(if name == "bang" then 2.6 else 1.4, 1 - d / near * 0.6) end
	end
	return s
end

-- un pas (couches de ModeConfig.SOUNDS.STEPS) ; vol comme sfx('step') du web
-- sprint = pas de course : plus fort, porte plus loin, raclement de semelle et équipement qui s'entrechoque
local STEP_GAIN = 0.6
function Sfx.step(surface: string, at: Vector3?, vol: number?, sprint: boolean?)
	local steps = SOUNDS.STEPS
	local layers = steps and (steps[surface] or steps.sand)
	if not layers then return end
	local v = (vol or 0.3) * (0.88 + math.random() * 0.24)
	if SHEET2 ~= 0 and VARIANTS["step_" .. surface] then
		local rg = if sprint then { 2, 36 } else RANGE.steps
		local k = v * STEP_GAIN * (if sprint then 1.2 else 1)
		layer("step_" .. surface, k, { at = at, range = rg, group = "steps", var = 0.07 })
		if sprint and math.random() < 0.45 then layer("scuff", k * 0.7, { at = at, range = rg, group = "steps", delay = 0.03 }) end
		if math.random() < (if sprint then 0.5 else 0.12) then layer("gear", k * 0.6, { at = at, range = rg, group = "steps", delay = 0.04 }) end
		if math.random() < (if sprint then 0.35 else 0.18) then layer("cloth", k * 0.7, { at = at, range = rg, group = "steps" }) end
		return
	end
	for _, L in ipairs(layers) do
		local region = Sheet[L.sheet]
		if region and ModeConfig.SOUND_SHEET ~= 0 then
			if not ensure() then return end
			local o: Opts = { id = "rbxassetid://" .. ModeConfig.SOUND_SHEET, region = region, len = region[2],
				volume = BASE * region[3] * (L.vol or 1) * v, speed = (L.rate or 1) * vary("step_" .. surface, 0.07),
				group = "steps", at = at, range = RANGE.steps, delay = L.delay }
			emit(o)
		end
	end
end

return Sfx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="240">
        <Properties>
          <string name="Name">ShopCatalog</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ShopCatalog (ModuleScript)
-- Catalogue de la boutique, partagé client + serveur : le client l'affiche, le serveur s'en sert pour vérifier chaque achat.
-- Armes, skins, viseurs et tenues s'achètent avec les pièces gagnées en jouant (lentement : voir Config.xpNeeded et RewardService).
-- Les Robux achètent des pièces, des caisses, le passe Premium, et les EXCLUSIFS (camos animés) qu'on ne peut obtenir qu'en payant.
local Config = require(script.Parent.Config)
local X = require(script.Parent.ConfigExtra)
local LoyaltyConfig = require(script.Parent.LoyaltyConfig)
local KillFxConfig = require(script.Parent.KillFxConfig)

local Catalog = {}

-- ---------- Prix ----------
Catalog.PRICE_BY_RARITY = { 0, 800, 2000, 5000 }  -- commun (gratuit), rare, épique, légendaire (~35 pièces gagnées par partie)
Catalog.OFFER_DISCOUNT = 0.25                     -- -25 % sur les offres du jour
Catalog.FEATURED_DISCOUNT = 0.4                   -- -40 % sur l'offre vedette du jour (un objet épique ou légendaire)

-- Armes disponibles dès le départ ; les autres se débloquent une fois pour toutes avec des pièces
Catalog.STARTER_WEAPONS = { knife = true, glock = true, usp = true, p250 = true, mac10 = true, nova = true, galil = true, famas = true }

function Catalog.weaponPrice(key: string): number
	if Catalog.STARTER_WEAPONS[key] then return 0 end
	local w = Config.WEAPONS[key]
	return math.max(500, math.floor(w.price * 0.6 / 50 + 0.5) * 50)   -- ex. AK-47 (2700 $ en partie) -> 1600 pièces
end

-- Onglets dans l'ordre d'affichage
Catalog.TABS = {
	{ id = "featured", name = "À la une 🔥" },
	{ id = "weapons", name = "Armes" },
	{ id = "skins", name = "Skins" },
	{ id = "sights", name = "Viseurs" },
	{ id = "style", name = "Tenues & style" },
	{ id = "killfx", name = "Effets 💥" },
	{ id = "premium", name = "Premium ⭐" },
	{ id = "exclusive", name = "Exclusifs ✨" },
	{ id = "robux", name = "Pièces 💰" },
}

-- Présentation des lots de pièces (onglet « Pièces ») : étiquette et bonus calculé par rapport au plus petit lot
Catalog.BUNDLE_TAGS = { coins_m = "POPULAIRE", coins_xl = "MEILLEURE VALEUR" } :: { [string]: string }

-- Pack de départ (offre unique par compte, comme les « Starter Packs » de Fortnite / COD) : Developer Product à 99 R$,
-- crédité dans ShopService.ProcessReceipt ; après l'achat il disparaît de la boutique (profile.purchases.pack_starter).
-- Valeur ~4× un lot de pièces : 1 500 pièces, 2 caisses Premium, 5 boosts d'XP (+50 % sur 5 parties), titre « Pionnier ».
Catalog.STARTER = { id = "pack_starter", robux = 99, name = "Pack de départ", coins = 1500, box = "prem", boxes = 2, boost = 5, title = "starter",
	lines = { "1 500 pièces", "2 caisses Premium", "5 boosts d'XP (+50 %)", "Titre « 🎖 Pionnier »" } }

-- Passe de jeu (Game Pass, acheté une fois pour toutes) : XP ×2 en fin de partie. Les pièces ne sont pas doublées.
-- Vérifié par ShopService (UserOwnsGamePassAsync) qui pose l'attribut PassXp2 lu par RewardService.
Catalog.GAMEPASSES = {
	{ id = "gp_xp2", name = "XP ×2 pour toujours", robux = 299, attr = "PassXp2", desc = "Double l'XP de base de chaque partie (niveaux et passe de combat plus rapides). Les pièces ne sont pas doublées." },
}

-- ---------- Liste des objets ----------
-- Chaque objet : id unique, tab, kind, name, rarity (1..4), price (pièces) ou robux + productId, champs propres au kind.
local items: { any } = {}
local byId: { [string]: any } = {}
local function add(it)
	table.insert(items, it)
	byId[it.id] = it
end

-- Armes (ordre du tableau Config.WEAPONS pas garanti : on trie par prix en partie)
local weaponKeys = {}
for key in pairs(Config.WEAPONS) do table.insert(weaponKeys, key) end
table.sort(weaponKeys, function(a, b)
	local pa, pb = Config.WEAPONS[a].price, Config.WEAPONS[b].price
	if pa == pb then return a < b end
	return pa < pb
end)
Catalog.WEAPON_KEYS = weaponKeys
for _, key in ipairs(weaponKeys) do
	local price = Catalog.weaponPrice(key)
	add({ id = "weapon_" .. key, tab = "weapons", kind = "weapon", weapon = key, name = Config.WEAPONS[key].name,
		rarity = if price == 0 then 1 elseif price < 1000 then 2 elseif price < 1800 then 3 else 4, price = price })
end

-- Skins : un objet par couple arme + skin (les skins communs sont déjà gratuits pour toutes les armes)
for _, key in ipairs(weaponKeys) do
	if not Config.WEAPONS[key].melee then
		for i, skin in ipairs(Config.SKINS) do
			if skin.rarity > 1 then
				add({ id = "skin_" .. key .. "_" .. i, tab = "skins", kind = "skin", weapon = key, skin = i,
					name = skin.name .. " · " .. Config.WEAPONS[key].name, rarity = skin.rarity, price = Catalog.PRICE_BY_RARITY[skin.rarity],
					event = (skin :: any).ev })      -- event : récompense d'événement, ne s'achète pas (ShopService refuse)
			end
		end
	end
end

-- Viseurs : modèle d'optique + réticule (définis dans ConfigExtra.SIGHTS / RETICLES)
for _, s in ipairs(X.SIGHTS) do
	add({ id = "sight_" .. s.id, tab = "sights", kind = "sight", sight = s.id, name = s.name, rarity = s.rarity, price = Catalog.PRICE_BY_RARITY[s.rarity] })
end
for _, r in ipairs(X.RETICLES) do
	add({ id = "reticle_" .. r.id, tab = "sights", kind = "reticle", reticle = r.id, name = "Réticule " .. r.name, rarity = r.rarity, price = Catalog.PRICE_BY_RARITY[r.rarity] })
end

-- Tenues de soldat, traînées de balle, titres de profil
for i, o in ipairs(Config.OUTFITS) do
	add({ id = "outfit_" .. i, tab = "style", kind = "outfit", outfit = i, name = o.name, rarity = o.rarity, price = Catalog.PRICE_BY_RARITY[o.rarity], event = (o :: any).ev })
end
local TRAIL_NAMES = { cyan = "Cyan", red = "Rouge", lime = "Citron vert", gold = "Or", violet = "Violet", rainbow = "Arc-en-ciel" }
for _, t in ipairs(X.TRAILS) do
	if t ~= "" then
		local rarity = if t == "rainbow" then 4 elseif t == "gold" then 3 else 2
		add({ id = "trail_" .. t, tab = "style", kind = "trail", trail = t, name = "Traînée " .. (TRAIL_NAMES[t] or t), rarity = rarity, price = Catalog.PRICE_BY_RARITY[rarity] })
	end
end
add({ id = "title_pack", tab = "style", kind = "misc", name = "Pack de titres de profil", rarity = 2, price = 800 })

-- Effets d'élimination (KillFxConfig) : pièces, Robux, ou seulement via un code promo / le groupe Roblox
for _, fx in ipairs(KillFxConfig.LIST) do
	add({ id = "killfx_" .. fx.id, tab = "killfx", kind = "killfx", fx = fx.id, name = fx.name, rarity = fx.rarity, source = fx.source,
		price = if fx.source == "coins" then fx.price else 0, robux = fx.robux, productId = fx.productId or 0, event = if fx.source == "event" then "hw" else nil })
end

-- Robux (Developer Products) : renseigne productId après création dans le Creator Hub (0 = désactivé)
for _, it in ipairs(X.SHOP) do
	if it.kind == "devproduct" then
		add({ id = it.id, tab = "robux", kind = "devproduct", name = it.name, rarity = 1, robux = it.robux, productId = it.productId,
			coins = it.coins, box = it.box, boxes = it.boxes, premium = it.premium })
	end
end

-- Pack de départ (offre unique) et passes de jeu : onglet « À la une »
do
	local st = Catalog.STARTER
	add({ id = st.id, tab = "featured", kind = "devproduct", name = st.name, rarity = 5, robux = st.robux, productId = 0,
		coins = st.coins, box = st.box, boxes = st.boxes, boost = st.boost, title = st.title, once = true })
	for _, g in ipairs(Catalog.GAMEPASSES) do
		add({ id = g.id, tab = "featured", kind = "gamepass", name = g.name, rarity = 5, robux = g.robux, passId = 0, attr = g.attr, desc = g.desc })
	end
end

-- Exclusifs (Robux uniquement, permanents) : camos animés, ou lot de plusieurs camos
for _, it in ipairs(X.EXCLUSIVES) do
	add({ id = it.id, tab = "exclusive", kind = "exclusive", name = it.name, rarity = 5, robux = it.robux, productId = it.productId,
		camos = it.camos or { it.camo }, camo = it.camo })
end

-- Abonnement Premium (Robux, jours cumulables) : couleur de pseudo, +20 % XP et pièces, cadeau quotidien. Voir LoyaltyConfig.VIP.
for _, o in ipairs(LoyaltyConfig.VIP.offers) do
	add({ id = o.id, tab = "premium", kind = "vip", name = o.name, rarity = 5, robux = o.robux, productId = o.productId, days = o.days, best = o.best })
end

-- numéros des produits Robux : ProductIds.lua (un seul fichier à remplir) passe avant les valeurs des fichiers de config
do
	local ids = require(script.Parent.ProductIds) :: { [string]: number }
	for _, it in ipairs(items) do
		local n = ids[it.id]
		if n and n > 0 then
			if it.kind == "gamepass" then it.passId = n else it.productId = n end
		end
	end
end

Catalog.ITEMS = items
function Catalog.get(id: string): any
	return byId[id]
end

-- ---------- Possession ----------
-- Inventaire du profil (voir DataService) : inv.weapons, inv.skins[arme], inv.outfits, inv.sights, inv.reticles, inv.misc
function Catalog.owns(profile: any, it: any): boolean
	if it.once then return profile.purchases ~= nil and profile.purchases[it.id] == true end   -- pack de départ : une seule fois
	if it.kind == "devproduct" or it.kind == "vip" or it.kind == "gamepass" then return false end   -- se rachète (jours cumulables) ; passe : vérifié par Roblox
	local inv = profile.inv
	if it.kind == "exclusive" then
		for _, c in ipairs(it.camos) do
			if not table.find(inv.exclusive or {}, c) then return false end
		end
		return true
	end
	if it.kind == "killfx" then return it.fx == "none" or table.find(inv.killfx or {}, it.fx) ~= nil end
	if it.price == 0 then return true end
	if it.kind == "weapon" then return table.find(inv.weapons or {}, it.weapon) ~= nil end
	if it.kind == "skin" then return table.find(inv.skins[it.weapon] or {}, it.skin) ~= nil end
	if it.kind == "outfit" then return table.find(inv.outfits or {}, it.outfit) ~= nil end
	if it.kind == "sight" then return table.find(inv.sights or {}, it.sight) ~= nil end
	if it.kind == "reticle" then return table.find(inv.reticles or {}, it.reticle) ~= nil end
	return table.find(inv.misc or {}, it.id) ~= nil
end

-- À utiliser par le futur menu d'achat en partie : une arme non débloquée ne doit pas y être proposée
function Catalog.ownsWeapon(profile: any, key: string): boolean
	local it = byId["weapon_" .. key]
	return it ~= nil and Catalog.owns(profile, it)
end

-- ---------- Offres du jour ----------
-- Même tirage côté client et serveur grâce à la graine = jour UTC. Une offre n'est jamais une arme de départ ni un objet gratuit.
function Catalog.today(): number
	return math.floor(os.time() / 86400)
end

local offersCache: { day: number, ids: { string } } = { day = -1, ids = {} }
function Catalog.dailyOffers(day: number): { string }
	if offersCache.day == day then return offersCache.ids end
	local rng = Random.new(day * 7919 + 17)
	local picked = {}
	-- jamais un objet d'événement (il ne s'achète pas : ShopService le refuse)
	local function buyable(it: any): boolean return (it.price or 0) > 0 and not it.event end
	for _, tab in ipairs({ "weapons", "skins", "sights", "style" }) do   -- une offre par onglet
		local pool = {}
		for _, it in ipairs(items) do
			if it.tab == tab and buyable(it) then table.insert(pool, it.id) end
		end
		if #pool > 0 then table.insert(picked, pool[rng:NextInteger(1, #pool)]) end
	end
	-- 5e offre = offre vedette (-40 %) : un objet épique ou légendaire, toutes catégories
	local pool = {}
	for _, it in ipairs(items) do
		if buyable(it) and (it.rarity or 0) >= 3 and it.tab ~= "featured" and not table.find(picked, it.id) then table.insert(pool, it.id) end
	end
	if #pool > 0 then table.insert(picked, pool[rng:NextInteger(1, #pool)]) end
	offersCache = { day = day, ids = picked }
	return picked
end

-- offre vedette du jour : la 5e de dailyOffers
function Catalog.featuredOffer(day: number): string?
	return Catalog.dailyOffers(day)[5]
end
function Catalog.discountFor(it: any, day: number): number
	local i = table.find(Catalog.dailyOffers(day), it.id)
	if not i then return 0 end
	return if i == 5 then Catalog.FEATURED_DISCOUNT else Catalog.OFFER_DISCOUNT
end
function Catalog.priceFor(it: any, day: number): number
	local d = Catalog.discountFor(it, day)
	if d > 0 then return math.floor(it.price * (1 - d) / 10 + 0.5) * 10 end
	return it.price
end

return Catalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="241">
        <Properties>
          <string name="Name">ShotFx</string>
          <string name="Source"><![CDATA[--!strict
-- ReplicatedStorage/Shared/ShotFx (ModuleScript, côté client)
-- Effets de tir du jeu web (src/50_fx.js, src/51_fx2.js, src/60_game.js, src/67_immersion.js), avec les mêmes
-- valeurs (m, m/s, s) passées en studs :
--   ShotFx.tracer(from, to, col?)       balle traçante qui voyage vraiment (420 m/s) : tête blanche brillante et traînée
--                                       qui s'efface (4,5 m ; 6 m et plus épaisse avec une traînée de couleur),
--                                       épaisseur constante à l'écran (plus large au loin)
--   ShotFx.impact(from, to)             au bout de la trajectoire : sur un décor, éclair + étincelles (deux fois plus
--                                       sur le métal) + poussière et éclats à la couleur du sol + trou de balle ;
--                                       sur un personnage, sang (gerbe + brume, plus fort à la tête) ou étincelles
--                                       bleues s'il a encore du bouclier
--   ShotFx.muzzle(pos, dir, big)        flamme de bouche en étoile des autres tireurs (0,5 m, 0,8 m au pompe et au
--                                       fusil de précision) et petite fumée
--   ShotFx.shell(pos, right)            douille de laiton qui saute à droite, tourne, rebondit deux fois et reste 2,4 s
--   ShotFx.ownShell(vmPos)              la nôtre, lancée depuis la fenêtre d'éjection du viewmodel
--   ShotFx.stain(pos)                   taches de sang au sol à la mort
--   ShotFx.explosion(pos, scale)        boule de feu, fumée sombre et débris en plus de l'explosion des grenades
--   ShotFx.trailColor(player)           couleur de la traînée cosmétique équipée (attribut Trail), nil = standard
-- Les trous et les taches partagent 160 décalques (anneau, comme le web). Graphismes bas (ombres coupées) :
-- particules au quart, comme cfg.fx = 0 du web. Option « Effets de sang » : S.opt.gore = false les coupe.
local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Config = require(ReplicatedStorage.Shared.Config)
local MapData = require(ReplicatedStorage.Shared.MapData)
local S = require(ReplicatedStorage.Shared.ClientState)

local ShotFx = {}
local U = Config.STUDS_PER_METER
local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

local function rgb(h: number): Color3 return Color3.fromRGB(bit32.rshift(h, 16), bit32.band(bit32.rshift(h, 8), 255), bit32.band(h, 255)) end
local function rand(a: number, b: number): number return a + math.random() * (b - a) end
local function low(): boolean return not Lighting.GlobalShadows end
local function fxMul(): number return if low() then 0.25 else 1 end
local function gore(): boolean return (S.opt :: any).gore ~= false end

-- dégradé rond du web (glowTex), déjà envoyé (MeshStore « glow ») : particules et décalques
local glowTex: Content? = nil
do
	local ok, MapDress = pcall(require, ReplicatedStorage.Shared.MapDress)
	if ok and MapDress then
		local ok2, c = pcall((MapDress :: any).glow)
		if ok2 then glowTex = c end
	end
end
local STAR = "rbxasset://textures/particles/sparkles_main.dds"

local folder = Instance.new("Folder"); folder.Name = "EffetsTirs"; folder.Parent = workspace
local host = Instance.new("Part")
host.Name = "Emetteurs"; host.Anchored = true; host.CanCollide = false; host.CanQuery = false; host.CanTouch = false
host.CastShadow = false; host.Transparency = 1; host.Size = Vector3.new(0.2, 0.2, 0.2); host.CFrame = CFrame.new(0, -500, 0)
host.Parent = folder

-- ---------- particules (PSys du web) ----------
-- une source par sorte d'effet : on la place au point d'impact, orientée, puis Emit(n) ; les grains vivent dans le monde
local function nseq(pts: { { number } }): NumberSequence
	local k = {}
	for _, p in ipairs(pts) do table.insert(k, NumberSequenceKeypoint.new(p[1], p[2], p[3] or 0)) end
	return NumberSequence.new(k)
end
-- fondu du web : montée sur les 12 premiers % puis (1 - t)^1,3
local function fade(a0: number): NumberSequence
	return nseq({ { 0, 1 }, { 0.12, 1 - a0 }, { 0.4, 1 - a0 * 0.62 }, { 0.7, 1 - a0 * 0.21 }, { 1, 1 } })
end
type Kind = { att: Attachment, pe: ParticleEmitter }
local kinds: { [string]: Kind } = {}
-- d = { life = {a, b}, size = {s0, s1}, speed = {a, b}, color, alpha, grav, drag, spread, glow, star, lit, rot }
local function kind(name: string, d: { [string]: any }): Kind
	local k = kinds[name]
	if k then return k end
	local att = Instance.new("Attachment"); att.Name = name; att.Parent = host
	local pe = Instance.new("ParticleEmitter")
	pe.Name = name; pe.Enabled = false; pe.Rate = 0
	if d.star then pe.Texture = STAR elseif glowTex then pe.TextureContent = glowTex :: Content end
	pe.Lifetime = NumberRange.new(d.life[1], d.life[2])
	pe.Size = nseq({ { 0, d.size[1] * U }, { 1, d.size[2] * U } })
	pe.Speed = NumberRange.new(d.speed[1] * U, d.speed[2] * U)
	pe.Color = ColorSequence.new(d.color :: Color3)
	pe.Transparency = d.trans or fade(d.alpha or 1)
	pe.Acceleration = Vector3.new(0, -(d.grav or 0) * U, 0)
	pe.Drag = d.drag or 0
	pe.EmissionDirection = Enum.NormalId.Front
	pe.SpreadAngle = Vector2.new(d.spread or 60, d.spread or 60)
	pe.LightEmission = if d.lit then 0 else 1
	pe.LightInfluence = if d.lit then 1 else 0
	pe.Rotation = NumberRange.new(0, if d.rot then 360 else 0)
	pe.ZOffset = d.z or 0
	pe.Parent = att
	local nk: Kind = { att = att, pe = pe }
	kinds[name] = nk
	return nk
end
local function emit(k: Kind, pos: Vector3, dir: Vector3, n: number)
	if n <= 0 then return end
	local d = if dir.Magnitude > 1e-3 then dir.Unit else Vector3.yAxis
	local up = if math.abs(d.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	k.att.WorldCFrame = CFrame.lookAt(pos, pos + d, up)
	k.pe:Emit(math.max(1, math.round(n)))
end

-- étincelles du web (fxA additives : 1 / 0,82 / 0,45)
local function sparkKind(): Kind
	return kind("Etincelles", { life = { 0.12, 0.35 }, size = { 0.045, 0.015 }, speed = { 2, 6 }, color = Color3.new(1, 0.82, 0.45),
		grav = 10, drag = 0.4, spread = 70 })
end
-- couleurs de la poussière selon le sol (impactFX du web) ; bois en plus, que Roblox sait reconnaître
local DUST: { [string]: Color3 } = { snow = Color3.new(0.95, 0.97, 1), sand = Color3.new(0.82, 0.7, 0.52), metal = Color3.new(0.5, 0.5, 0.52),
	wood = Color3.new(0.55, 0.43, 0.3), stone = Color3.new(0.62, 0.6, 0.56) }
local function dustKind(surf: string): Kind
	return kind("Poussiere_" .. surf, { life = { 0.5, 1.1 }, size = { 0.06, 0.32 }, speed = { 0.4, 1.6 }, color = DUST[surf], alpha = 0.5,
		grav = -0.15, drag = 1.8, spread = 55, lit = true, rot = true })
end
local function chipKind(surf: string): Kind
	local c = DUST[surf]
	return kind("Eclats_" .. surf, { life = { 0.4, 0.8 }, size = { 0.035, 0.03 }, speed = { 2, 4 }, color = Color3.new(c.R * 0.6, c.G * 0.6, c.B * 0.6),
		trans = nseq({ { 0, 0 }, { 0.75, 0 }, { 1, 1 } }), grav = 14, drag = 0.2, spread = 65, lit = true })
end
local function flashKind(name: string, size: number, life: number): Kind
	return kind(name, { life = { life, life }, size = { size, size * 1.6 }, speed = { 0, 0 }, color = Color3.new(1, 0.86, 0.6),
		trans = nseq({ { 0, 0 }, { 1, 1 } }), star = name ~= "Eclair", rot = true, z = 0.3 })
end

-- ---------- sol touché ----------
local MAT: { [string]: string } = {
	Metal = "metal", CorrodedMetal = "metal", DiamondPlate = "metal", Foil = "metal",
	Wood = "wood", WoodPlanks = "wood", Sand = "sand", Sandstone = "sand", Snow = "snow", Ice = "snow", Glacier = "snow",
}
local BASE: { [string]: string } = { industrial = "metal", snow = "snow", sand = "sand" }
-- Les blocs de collision des cartes sont invisibles et lisses : on prend alors le sol de la carte (MAP.base du web)
local function surfaceOf(inst: Instance, mat: Enum.Material): string
	local m = MAT[mat.Name]
	if m and inst:IsA("BasePart") and inst.Transparency < 0.9 then return m end
	local f: Instance? = inst.Parent
	while f and f ~= workspace do
		local id = f:GetAttribute("MapId")
		if typeof(id) == "string" then
			local md = MapData[id]
			return md and BASE[md.base] or "stone"
		end
		f = f.Parent
	end
	return m or "stone"
end

-- ---------- décalques : trous de balle et taches de sang (160, en anneau) ----------
local decals: { { p: Part, d: Instance? } } = {}
local dIdx = 0
local function nextDecal(): { p: Part, d: Instance? }
	dIdx = dIdx % 160 + 1
	local e = decals[dIdx]
	if e then return e end
	local p = Instance.new("Part")
	p.Name = "Decalque"; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false; p.CastShadow = false
	p.Material = Enum.Material.SmoothPlastic
	local d: Instance? = nil
	if glowTex then
		p.Transparency = 1
		local dc = Instance.new("Decal"); dc.Face = Enum.NormalId.Front; dc.TextureContent = glowTex :: Content; dc.Parent = p
		d = dc
	else
		-- repli sans la texture : petit disque sombre
		p.Shape = Enum.PartType.Cylinder
	end
	p.Parent = folder
	local ne = { p = p, d = d }
	decals[dIdx] = ne
	return ne
end
local function putDecal(pos: Vector3, normal: Vector3, size: number, color: Color3, alpha: number)
	local e = nextDecal()
	local up = if math.abs(normal.Y) > 0.99 then Vector3.xAxis else Vector3.yAxis
	local cf = CFrame.lookAt(pos + normal * 0.012, pos + normal * 2, up) * CFrame.Angles(0, 0, rand(0, math.pi * 2))
	if e.d then
		e.p.Size = Vector3.new(size, size, 0.02); e.p.CFrame = cf
		local dc = (e.d :: any) :: Decal
		dc.Color3 = color; dc.Transparency = 1 - alpha
	else
		e.p.Size = Vector3.new(0.01, size * 0.6, size * 0.6); e.p.CFrame = cf * CFrame.Angles(0, math.pi / 2, 0)
		e.p.Color = color; e.p.Transparency = 1 - alpha * 0.9
	end
end

-- ---------- balles traçantes (FX2.streaks du web, 56) ----------
type Streak = { a0: Attachment, a1: Attachment, beam: Beam, on: boolean, o: Vector3, dir: Vector3, L: number, d: number,
	len: number, w: number, fade: number, speed: number }
local streaks: { Streak } = {}
local sIdx = 0
local seqCache: { [string]: ColorSequence } = {}
-- dégradé du web (tête blanche -> 255,240,200 -> 255,190,90 -> 255,150,40) multiplié par la teinte de la balle
local function streakColors(tint: Color3): ColorSequence
	local key = tint:ToHex()
	local c = seqCache[key]
	if c then return c end
	local function m(r: number, g: number, b: number): Color3 return Color3.new(r * tint.R, g * tint.G, b * tint.B) end
	local nc = ColorSequence.new({ ColorSequenceKeypoint.new(0, m(1, 1, 1)), ColorSequenceKeypoint.new(0.06, m(1, 0.94, 0.78)),
		ColorSequenceKeypoint.new(0.35, m(1, 0.75, 0.35)), ColorSequenceKeypoint.new(1, m(1, 0.59, 0.16)) })
	seqCache[key] = nc
	return nc
end
local function streakAlpha(k: number): NumberSequence
	return nseq({ { 0, 1 - k }, { 0.06, 1 - 0.95 * k }, { 0.35, 1 - 0.45 * k }, { 1, 1 } })
end
local ALPHA1 = streakAlpha(1)
local DEFAULT_TINT = rgb(0xffd28a)

function ShotFx.tracer(from: Vector3, to: Vector3, col: Color3?)
	local seg = to - from
	local L = seg.Magnitude / U
	if L < 0.5 then return end
	sIdx = sIdx % 56 + 1
	local s = streaks[sIdx]
	if not s then
		local a0 = Instance.new("Attachment"); a0.Parent = host
		local a1 = Instance.new("Attachment"); a1.Parent = host
		local b = Instance.new("Beam")
		b.Attachment0 = a0; b.Attachment1 = a1; b.FaceCamera = true; b.Segments = 1
		b.LightEmission = 1; b.LightInfluence = 0; b.Brightness = 2.5; b.Enabled = false
		b.Parent = host
		s = { a0 = a0, a1 = a1, beam = b, on = false, o = from, dir = Vector3.zAxis, L = 0, d = 0, len = 0, w = 0, fade = 0, speed = 0 }
		streaks[sIdx] = s
	end
	local st = s :: Streak
	st.on = true; st.o = from; st.dir = seg.Unit; st.L = L; st.d = 0; st.fade = 0; st.speed = 420
	st.len = math.min(L, if col then 6 else 4.5); st.w = if col then 0.03 else 0.018
	st.beam.Color = streakColors(col or DEFAULT_TINT)
	st.beam.Transparency = ALPHA1
	st.beam.Enabled = false            -- allumé à la première image, une fois placé
end

-- couleur de la traînée cosmétique (TRAILS de src/64_extras.js)
local TRAILS: { [string]: number } = { cyan = 0x55e6ff, red = 0xff4655, lime = 0x9dff5a, gold = 0xffc933, violet = 0xb36bff }
function ShotFx.trailColor(p: Player?): Color3?
	local t = p and p:GetAttribute("Trail")
	if typeof(t) ~= "string" or t == "" then return nil end
	if t == "rainbow" then return Color3.fromHSV((os.clock() * 1.7) % 1, 0.8, 1) end
	local h = TRAILS[t]
	return if h then rgb(h) else nil
end

-- ---------- impacts ----------
local params = RaycastParams.new(); params.FilterType = Enum.RaycastFilterType.Exclude
local impT, impN = 0, 0
local function humanoidModel(inst: Instance): Model?
	local m = inst:FindFirstAncestorOfClass("Model")
	while m do
		if m:FindFirstChildOfClass("Humanoid") then return m end
		m = m:FindFirstAncestorOfClass("Model")
	end
	return nil
end

function ShotFx.impact(from: Vector3, to: Vector3)
	local seg = to - from
	if seg.Magnitude < 1 then return end
	if (to - camera.CFrame.Position).Magnitude > 260 then return end
	-- 12 impacts par dixième de seconde au plus (rafales de pompe à plusieurs)
	local t = os.clock()
	if t - impT > 0.1 then impT = t; impN = 0 end
	if impN >= 12 then return end
	impN += 1
	local dir = seg.Unit
	params.FilterDescendantsInstances = if player.Character then { folder, camera, player.Character } else { folder, camera }
	local r = workspace:Raycast(to - dir * 1.5, dir * 3, params)
	if not r then return end
	local pos, n = r.Position, r.Normal
	local back = -dir                              -- les éclats repartent vers le tireur
	local model = humanoidModel(r.Instance)
	local mul = fxMul()
	if model then
		local sh = model:GetAttribute("Shield")
		if typeof(sh) == "number" and sh > 0 then
			-- bodyHitFX du web, bouclier : étincelles bleues
			emit(kind("Bouclier", { life = { 0.15, 0.35 }, size = { 0.07, 0.02 }, speed = { 1.5, 4 }, color = Color3.new(0.3, 0.8, 1),
				grav = 4, drag = 0.6, spread = 70 }), pos, back, 10)
			return
		end
		if not gore() then return end
		local hs = string.find(r.Instance.Name, "Head") ~= nil
		-- gerbe de sang (fxBlood : 4, 7 à la tête) et brume qui traverse (bodyHitFX : 5, 10 à la tête)
		emit(kind(if hs then "SangGros" else "Sang", { life = { 0.35, 0.7 }, size = if hs then { 0.09, 0.2 } else { 0.06, 0.12 },
			speed = { 1, 3.5 }, color = Color3.new(0.62, 0.04, 0.05), alpha = 0.9, grav = 9, drag = 1.2, spread = 55, lit = true }),
			pos, back, (if hs then 7 else 4) * mul)
		emit(kind(if hs then "BrumeTete" else "Brume", { life = { 0.25, 0.5 }, size = if hs then { 0.05, 0.4 } else { 0.05, 0.28 },
			speed = { 0.5, 2 }, color = Color3.new(0.55, 0.03, 0.04), alpha = 0.75, grav = 2, drag = 1.5, spread = 40, lit = true, rot = true }),
			pos, dir, if hs then 10 else 5)
		return
	end
	local surf = surfaceOf(r.Instance, r.Material)
	local at = pos + n * 0.05 * U
	emit(flashKind("Eclair", 0.35, 0.06), at, n, 1)
	emit(sparkKind(), at, back + n, (if surf == "metal" then 10 else 5) * mul)
	emit(dustKind(surf), at, back * 0.6 + n * 0.8, 5 * mul)
	emit(chipKind(surf), at, back + n + Vector3.new(0, 0.6, 0), 4 * mul)
	-- trou de balle : sur le décor fixe seulement
	local inst = r.Instance
	if inst:IsA("Terrain") or (inst:IsA("BasePart") and inst.Anchored) then
		putDecal(pos, n, rand(0.16, 0.22) * U, Color3.fromRGB(12, 9, 5), 0.95)
	end
end

-- ---------- flamme de bouche des autres tireurs ----------
function ShotFx.muzzle(pos: Vector3, dir: Vector3, big: boolean)
	if (pos - camera.CFrame.Position).Magnitude > 300 then return end
	emit(flashKind(if big then "FlammeGrosse" else "Flamme", if big then 0.8 else 0.5, 0.05), pos, dir, 1)
	emit(kind("FumeeBouche", { life = { 0.5, 0.9 }, size = { 0.05, 0.28 }, speed = { 0.6, 1 }, color = Color3.new(0.75, 0.75, 0.75), alpha = 0.26,
		grav = -0.1, drag = 1.6, spread = 15, lit = true, rot = true }), pos, dir + Vector3.new(0, 0.25, 0), 1)
end

-- ---------- douilles (48, comme le web) ----------
type Shell = { p: Part, on: boolean, pos: Vector3, v: Vector3, rx: number, rz: number, wx: number, wz: number, ry: number, t: number, bounced: number, rest: boolean }
local shells: { Shell } = {}
local shIdx = 0
local BRASS = rgb(0xd4a73a)
local shellParams = RaycastParams.new(); shellParams.FilterType = Enum.RaycastFilterType.Exclude
function ShotFx.shell(pos: Vector3, right: Vector3)
	if low() then return end                       -- cfg.fx = 0 du web : pas de douilles
	shIdx = shIdx % 48 + 1
	local s = shells[shIdx]
	if not s then
		local p = Instance.new("Part")
		p.Name = "Douille"; p.Shape = Enum.PartType.Cylinder; p.Anchored = true; p.CanCollide = false; p.CanQuery = false; p.CanTouch = false
		p.CastShadow = false; p.Color = BRASS; p.Material = Enum.Material.Metal; p.Reflectance = 0.15
		p.Size = Vector3.new(0.03 * U, 0.012 * U, 0.012 * U); p.Transparency = 1; p.Parent = folder
		s = { p = p, on = false, pos = pos, v = Vector3.zero, rx = 0, rz = 0, wx = 0, wz = 0, ry = 0, t = 0, bounced = 0, rest = false }
		shells[shIdx] = s
	end
	local sh = s :: Shell
	local r = Vector3.new(right.X, 0, right.Z)
	r = if r.Magnitude > 1e-3 then r.Unit else Vector3.xAxis
	local sp = rand(1.6, 2.6)
	sh.on = true; sh.rest = false; sh.pos = pos; sh.t = 2.4; sh.bounced = 0
	sh.v = (r * sp + Vector3.new(rand(-0.3, 0.3), rand(1.6, 2.6), rand(-0.3, 0.3))) * U
	sh.wx = rand(-14, 14); sh.wz = rand(-14, 14); sh.rx = rand(0, 6); sh.rz = rand(0, 6); sh.ry = math.atan2(r.X, r.Z)
	sh.p.Transparency = 0
end
-- notre douille : la fenêtre d'éjection du viewmodel (en mètres, collé à la caméra) ramenée à l'échelle du monde
function ShotFx.ownShell(vmPos: Vector3)
	local cf = camera.CFrame
	ShotFx.shell(cf.Position + (vmPos - cf.Position) * U, cf.RightVector)
end

-- ---------- taches de sang à la mort (stain du web : 6 taches de 0,25 à 0,55 m) ----------
local downParams = RaycastParams.new(); downParams.FilterType = Enum.RaycastFilterType.Exclude
function ShotFx.stain(pos: Vector3, ignore: Instance?)
	if not gore() then return end
	downParams.FilterDescendantsInstances = if ignore then { folder, camera, ignore } else { folder, camera }
	for _ = 1, 6 do
		local o = pos + Vector3.new(rand(-0.5, 0.5) * U, 0, rand(-0.5, 0.5) * U)
		local r = workspace:Raycast(o + Vector3.new(0, 1.5 * U, 0), Vector3.new(0, -4 * U, 0), downParams)
		if r and not humanoidModel(r.Instance) then putDecal(r.Position, r.Normal, rand(0.25, 0.55) * U, Color3.fromRGB(115, 10, 13), 0.8) end
	end
end

-- ---------- explosion : ce que l'explosion Roblox n'a pas (fxExplosion du web) ----------
function ShotFx.explosion(pos: Vector3, scale: number)
	local mul = fxMul()
	local up = Vector3.yAxis
	emit(kind("BouleDeFeu", { life = { 0.4, 0.8 }, size = { 1.2 * scale, 2.8 * scale }, speed = { 1, 5 * scale }, color = Color3.new(1, 0.55, 0.15),
		alpha = 0.95, grav = -0.5, drag = 2, spread = 50, rot = true }), pos + up * 0.3 * U, up, 16 * mul)
	emit(kind("FumeeNoire", { life = { 1.2, 2.6 }, size = { 1, 3.6 * scale }, speed = { 0.5, 4 * scale }, color = Color3.new(0.25, 0.23, 0.22),
		alpha = 0.7, grav = -0.4, drag = 1.2, spread = 70, lit = true, rot = true }), pos + up * 0.4 * U, up, 26 * mul)
	emit(kind("Debris", { life = { 0.5, 1 }, size = { 0.12, 0.2 }, speed = { 3, 10 }, color = Color3.new(0.55, 0.5, 0.45),
		trans = nseq({ { 0, 0.1 }, { 0.8, 0.1 }, { 1, 1 } }), grav = 12, drag = 0.3, spread = 75, lit = true }), pos + up * 0.2 * U, up, 20 * mul)
end

-- ---------- animation ----------
RunService.RenderStepped:Connect(function(dt: number)
	local camPos = camera.CFrame.Position
	for _, s in ipairs(streaks) do
		if not s.on then continue end
		s.d += s.speed * dt
		local k = 1
		if s.d >= s.L then
			s.d = s.L; s.fade += dt
			if s.fade > 0.05 then s.on = false; s.beam.Enabled = false; continue end
			k = 1 - s.fade / 0.05
			s.beam.Transparency = streakAlpha(k)
		end
		local head = s.o + s.dir * s.d * U
		local len = math.min(s.len, s.d)
		s.a0.WorldPosition = head
		s.a1.WorldPosition = head - s.dir * math.max(0.05, len) * U
		local cd = math.max(1, (head - camPos).Magnitude / U)
		local w = s.w * math.min(3, 0.6 + cd * 0.06) * U
		s.beam.Width0 = w; s.beam.Width1 = w
		s.beam.Enabled = true
	end
	local active = false
	for _, s in ipairs(shells) do
		if not s.on then continue end
		active = true
		s.t -= dt
		if s.t <= 0 then s.on = false; s.p.Transparency = 1; continue end
		if not s.rest then
			s.v -= Vector3.new(0, 14 * U * dt, 0)
			local step = s.v * dt
			local r = workspace:Raycast(s.pos, step + step.Unit * 0.02, shellParams)
			if r and not humanoidModel(r.Instance) then
				s.pos = r.Position + r.Normal * 0.006 * U
				if math.abs(s.v.Y) > 1 * U and s.bounced < 2 then
					s.v = Vector3.new(s.v.X * 0.5, -s.v.Y * 0.35, s.v.Z * 0.5); s.bounced += 1
				else
					s.rest = true; s.v = Vector3.zero
				end
			else
				s.pos += step
			end
			s.rx += s.wx * dt; s.rz += s.wz * dt
		end
		-- au repos, la douille est couchée (axe du cylindre à l'horizontale)
		s.p.CFrame = if s.rest then CFrame.new(s.pos + Vector3.new(0, 0.006 * U, 0)) * CFrame.Angles(0, s.ry + s.rx, 0)
			else CFrame.new(s.pos) * CFrame.Angles(s.rx, s.ry, s.rz)
	end
	if active then
		-- les douilles ne touchent pas les personnages ni les effets
		local ex: { Instance } = { folder, camera }
		for _, p in ipairs(Players:GetPlayers()) do if p.Character then table.insert(ex, p.Character) end end
		shellParams.FilterDescendantsInstances = ex
	end
end)

return ShotFx
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="242">
        <Properties>
          <string name="Name">SkinInfo</string>
          <string name="Source"><![CDATA[-- Généré par tools/skins_to_lua.py depuis les skins du jeu web : ne pas modifier à la main.
-- SkinInfo.SKINS[n] suit Config.SKINS ; tex = image de SkinTextures ; fin = finition ; a = couleur des pièces secondaires ;
-- b = couleur unie (skin sans peinture) ; glow = skin lumineux. SkinInfo.ANIM = camos animés (exclusifs Robux).
local SkinInfo = {}
SkinInfo.SKINS = {
	[1] = { name = "Défaut", tex = nil, fin = nil, a = nil, b = nil, tint = nil, glow = false },  -- web 0
	[2] = { name = "Noir mat", tex = nil, fin = "matte", a = "#0c0d0f", b = "#202327", tint = nil, glow = false },  -- web 1
	[3] = { name = "Or royal", tex = "goldleaf", fin = "chrome", a = "#6a4a10", b = nil, tint = nil, glow = false },  -- web 2
