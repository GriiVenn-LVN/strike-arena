{
  "name": "StrikeArena",
  "tree": {
    "$className": "DataModel",
    "Workspace": {
      "$className": "Workspace",
      "$properties": { "StreamingEnabled": false }
    },
    "Players": {
      "$className": "Players",
      "$properties": { "CharacterAutoLoads": false }
    },
    "ReplicatedStorage": {
      "$className": "ReplicatedStorage",
      "Shared": { "$path": "ReplicatedStorage/Shared" }
    },
    "ServerScriptService": {
      "$className": "ServerScriptService",
      "$path": "ServerScriptService"
    },
    "StarterPlayer": {
      "$className": "StarterPlayer",
      "StarterPlayerScripts": { "$path": "StarterPlayer/StarterPlayerScripts" }
    }
  }
}
